					Outcomes = { { Chance = 0.5, Stats = { Reputation = 10, Popularity = 8 }, Flags = { "Councillor" }, Story = "They won by a landslide!" }, { Chance = 0.5, Stats = { Happiness = -4, Reputation = 3 }, Story = "They lost narrowly, but earned a lot of respect." } } } },
			{ Id = "Volunteer", Text = "Volunteer behind the scenes", Description = "Quiet impact.",
				Effects = { Stats = { Reputation = 5, Relationships = 4 }, Story = "{name} volunteered every weekend." } },
			{ Id = "Decline", Text = "Politely decline", Description = "Not for you.",
				Effects = { Stats = { Happiness = 1 }, Story = "{name} declined politely." } },
		},
	},
	{
		Id = "M_Parents", Stage = 5, Icon = "👵", Title = "Ageing Parents",
		Description = "Your parents are getting frail and need more help.",
		Once = true,
		Choices = {
			{ Id = "MoveIn", Text = "Move them in with you", Description = "Family looks after family.",
				Effects = { Stats = { Relationships = 8, Happiness = -2, Health = -2 }, Bond = { Parent = 15 }, Traits = { Kind = 1 }, Story = "{name} moved their parents in." } },
			{ Id = "Care", Text = "Pay for professional care", Requires = { MinMoney = 20000 }, LockHint = "Requires $20,000", Description = "The best support money can buy.",
				Effects = { Money = -20000, Stats = { Relationships = 4 }, Bond = { Parent = 6 }, Story = "{name} paid for excellent care for their parents." } },
			{ Id = "Visit", Text = "Visit every week", Description = "Stay close.",
				Effects = { Stats = { Relationships = 5 }, Bond = { Parent = 10 }, Story = "{name} visited their parents every Sunday." } },
		},
	},
	{
		Id = "M_Marriage", Stage = 5, Icon = "💞", Title = "A Rough Patch",
		Description = "After many years together, you and your spouse feel more like flatmates than partners.",
		Once = true, Requires = { Married = true },
		Choices = {
			{ Id = "Counsel", Text = "Try couples counselling", Description = "Work on it together.",
				Effects = { Money = -1500, Stats = { Relationships = 8, Happiness = 5 }, Bond = { Partner = 18 }, Story = "{name} and their spouse went to counselling and fell in love all over again." } },
			{ Id = "Gesture", Text = "Plan a surprise getaway", Description = "Rekindle the spark.",
				Effects = { Money = -3000, Stats = { Happiness = 7, Relationships = 5 }, Bond = { Partner = 14 }, Story = "{name} planned a surprise trip to where it all began." } },
			{ Id = "Space", Text = "Give each other space", Description = "Time heals.",
				Effects = { Stats = { Happiness = 1 }, Bond = { Partner = -4 }, Story = "{name} and their spouse gave each other room to breathe." } },
			{ Id = "Divorce", Text = "Get divorced", Description = "Start a new chapter.",
				Effects = { Married = false, Partner = false, MoneyPercent = -0.3, Stats = { Happiness = -6, Relationships = -5 }, Flags = { "Divorced" }, Story = "{name} and their spouse divorced. It was hard on everyone." } },
		},
	},
	{
		Id = "M_Commitment", Stage = 5, Icon = "💒", Title = "Finally Tie the Knot?",
		Description = "You and your partner have been together for ages. Do you want to make it official?",
		Once = true, Requires = { Partner = true, Married = false },
		Choices = {
			{ Id = "Marry", Text = "Get married", Description = "Better late than never.",
				Effects = { Married = true, Money = -5000, Stats = { Happiness = 9, Relationships = 6 }, Story = "{name} finally got married, surrounded by family and friends." } },
			{ Id = "Stay", Text = "Stay as you are", Description = "You don't need a piece of paper.",
				Effects = { Stats = { Relationships = 3 }, Story = "{name} and their partner were happy as they were." } },
			{ Id = "Part", Text = "Part ways", Description = "You've grown apart.",
				Effects = { Partner = false, Stats = { Happiness = -5 }, Story = "{name} and their partner went their separate ways." } },
		},
	},
	{
		Id = "M_LateLove", Stage = 5, Icon = "🍷", Title = "Love Later in Life",
		Description = "A friend wants to introduce you to someone. 'You two would get on brilliantly.'",
		Once = true, Requires = { Partner = false },
		Choices = {
			{ Id = "Meet", Text = "Meet them", Description = "Why not?",
				Effects = { Story = "{name} agreed to meet them.",
					Outcomes = { { Chance = 0.6, Partner = true, Stats = { Happiness = 9, Relationships = 6 }, Story = "They talked until the restaurant closed." } } } },
			{ Id = "Old", Text = "Look up your first love", Requires = { AnyFlags = { "FirstLove", "TeenSweethearts" } }, LockHint = "Requires a teenage romance", Description = "What if…?",
				Effects = { Stats = { Happiness = 3 }, Story = "{name} looked up their first love.",
					Outcomes = { { Chance = 0.5, Partner = true, Stats = { Happiness = 10 }, Flags = { "Rekindled" }, Story = "They were single too. Some stories take decades to finish." } } } },
			{ Id = "Free", Text = "Enjoy your independence", Description = "Life is full already.",
				Effects = { Stats = { Happiness = 4 }, Flags = { "HappilySingle" }, Story = "{name} was perfectly content on their own." } },
		},
	},
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">Retirement</string>
              <string name="Source"><![CDATA[--[[
	Retirement scenarios (Stage 6, ages 61–85)
	Bringing the life to its close: rest, family, giving back and looking back.
	The final decision completes the life (Phase 5 adds the Final Life Reveal).
]]

return {
	{
		Id = "R_Retire", Stage = 6, Icon = "🏖️", Title = "Time to Retire?",
		Description = "You've reached retirement age. Colleagues are planning your leaving party, if you want one.",
		Priority = 10, Once = true, Requires = { NotFlags = { "Retired" } },
		Choices = {
			{ Id = "Retire", Text = "Retire and enjoy it", Description = "Sleep in. Forever.",
				Effects = { Retire = true, Stats = { Happiness = 8, Health = 3 }, Story = "{name} retired with a party, a card signed by everyone, and a very long lie-in." } },
			{ Id = "Consult", Text = "Retire, but consult part-time", Requires = { HasCareer = true }, LockHint = "Requires a career", Description = "Keep a foot in the door.",
				Effects = { Retire = true, Money = 30000, Stats = { Happiness = 5, Reputation = 3 }, Story = "{name} retired but kept consulting a few days a month." } },
			{ Id = "Keep", Text = "Keep working full time", Requires = { HasCareer = true }, LockHint = "Requires a career", Description = "Work keeps you young.",
				Effects = { Stats = { Career = 5, Health = -4, Happiness = -1 }, Flags = { "WorkedOn" }, Story = "{name} kept working. Retirement could wait." } },
			{ Id = "Volunteer", Text = "Retire and volunteer", Description = "Give back.",
				Effects = { Retire = true, Stats = { Reputation = 6, Happiness = 6 }, Traits = { Kind = 1 }, Story = "{name} retired and began volunteering at a local charity." } },
			{ Id = "Seaside", Text = "Retire to the seaside", Description = "Fresh air and fish and chips.",
				Effects = { Retire = true, Stats = { Happiness = 7, Health = 4, Relationships = -2 }, Story = "{name} retired to a cottage by the sea." } },
		},
	},
	{
		Id = "R_StillWorking", Stage = 6, Icon = "⏰", Title = "One Last Project",
		Description = "You're still working, and still good at it. But your body is telling you to slow down.",
		Once = true, Weight = 3, Requires = { Flags = { "WorkedOn" }, HasCareer = true },
		Choices = {
			{ Id = "Retire", Text = "Finally retire", Description = "You've earned it.",
				Effects = { Retire = true, Stats = { Happiness = 8, Health = 4 }, Story = "{name} finally retired, decades of work behind them." } },
			{ Id = "Legacy", Text = "Finish one legendary project", Description = "Go out on top.",
				Effects = { Promote = 1, Stats = { Reputation = 8, Health = -4 }, Story = "{name} finished one last legendary project before stepping down." } },
			{ Id = "Forever", Text = "Never retire", Description = "Work is life.",
				Effects = { Stats = { Career = 4, Health = -6, Relationships = -3 }, Story = "{name} declared they would never retire." } },
		},
	},
	{
		Id = "R_Travel", Stage = 6, Icon = "🌍", Title = "See the World",
		Description = "You finally have the time. Where to?",
		Once = true,
		Choices = {
			{ Id = "Cruise", Text = "A world cruise", Requires = { MinMoney = 20000 }, LockHint = "Requires $20,000", Description = "Ninety days at sea.",
				Effects = { Money = -20000, Stats = { Happiness = 10, Relationships = 3 }, Story = "{name} sailed around the world on a grand cruise." } },
			{ Id = "Family", Text = "Visit family and friends", Description = "A tour of loved ones.",
				Effects = { Money = -2000, Stats = { Relationships = 8, Happiness = 6 }, Bond = { All = 6 }, Story = "{name} visited everyone they loved, one by one." } },
			{ Id = "Road", Text = "A road trip in a campervan", Description = "Freedom on four wheels.",
				Effects = { Money = -4000, Stats = { Happiness = 8, Health = 2 }, Traits = { Adventurous = 1 }, Story = "{name} bought a campervan and drove wherever the road went." } },
			{ Id = "Home", Text = "Stay home and enjoy it", Description = "Home is the best place.",
				Effects = { Stats = { Happiness = 3 }, Story = "{name} preferred their own garden to any beach." } },
		},
	},
	{
		Id = "R_Grandkids", Stage = 6, Icon = "👨‍👩‍👧‍👦", Title = "The Grandchildren",
		Description = "Your house is full of grandchildren every weekend.",
		Once = true, Weight = 2, Requires = { MinChildren = 1 },
		Choices = {
			{ Id = "Babysit", Text = "Babysit every week", Description = "Stories, snacks, adventures.",
				Effects = { Stats = { Relationships = 9, Happiness = 7, Health = -1 }, Bond = { Child = 10 }, Flags = { "Grandparent" }, Story = "{name} became everyone's favourite grandparent." } },
			{ Id = "Fund", Text = "Pay for their education", Requires = { MinMoney = 20000 }, LockHint = "Requires $20,000", Description = "Invest in their future.",
				Effects = { Money = -20000, Stats = { Relationships = 6, Reputation = 4 }, Flags = { "Grandparent" }, Story = "{name} set up education funds for every grandchild." } },
			{ Id = "Spoil", Text = "Spoil them rotten", Description = "That's what grandparents are for.",
				Effects = { Money = -3000, Stats = { Happiness = 8, Relationships = 5 }, Flags = { "Grandparent" }, Story = "{name} spoiled their grandchildren shamelessly." } },
			{ Id = "Holiday", Text = "Take the whole family on holiday", Requires = { MinMoney = 10000 }, LockHint = "Requires $10,000", Description = "Three generations, one villa.",
				Effects = { Money = -10000, Stats = { Relationships = 10, Happiness = 8 }, Bond = { Child = 12, Partner = 8 }, Flags = { "Grandparent" }, Story = "{name} took the whole family on a holiday nobody would forget." } },
		},
	},
	{
		Id = "R_Giving", Stage = 6, Icon = "🎁", Title = "Giving Back",
		Description = "You've been fortunate. You'd like to make a difference with what you have.",
		Once = true, Weight = 1.5, Requires = { MinMoney = 50000 },
		Choices = {
			{ Id = "Donate", Text = "Make a big donation", Description = "To a cause close to your heart.",
				Effects = { Money = -40000, Stats = { Reputation = 9, Happiness = 6 }, Flags = { "Philanthropist" }, Story = "{name} made a large donation to a cause close to their heart." } },
			{ Id = "Foundation", Text = "Set up a foundation", Requires = { MinMoney = 1000000 }, LockHint = "Requires $1,000,000", Description = "A legacy that lasts.",
				Effects = { Money = -500000, Stats = { Reputation = 15, Happiness = 8, Popularity = 6 }, Flags = { "Foundation", "Philanthropist" }, Story = "{name} set up a foundation in their name that would help people for generations." } },
			{ Id = "Family", Text = "Help your family financially", Description = "Charity begins at home.",
				Effects = { Money = -30000, Stats = { Relationships = 9, Happiness = 4 }, Story = "{name} helped their family pay off debts and buy homes." } },
			{ Id = "Keep", Text = "Keep it for a rainy day", Description = "You never know.",
				Effects = { Stats = { Happiness = 1 }, Story = "{name} kept their money safe." } },
		},
	},
	{
		Id = "R_Hobby", Stage = 6, Icon = "🌻", Title = "Golden Years",
		Description = "Days are yours to fill. What will you spend them on?",
		Once = true,
		Choices = {
			{ Id = "Garden", Text = "Grow a prize-winning garden", Description = "Roses, tomatoes, peace.",
				Effects = { Stats = { Happiness = 6, Health = 4 }, Story = "{name}'s garden won the village show three years running." } },
			{ Id = "Paint", Text = "Take up painting", Description = "Never too late.",
				Effects = { Stats = { Happiness = 6, Intelligence = 2 }, Traits = { Creative = 1 }, Story = "{name} took up painting. Their seascapes sold at the local gallery." } },
			{ Id = "Chess", Text = "Enter the senior chess championship", Requires = { Flags = { "ChessClub" } }, LockHint = "Requires a childhood in chess club", Description = "Back to the board.",
				Effects = { Stats = { Intelligence = 5, Reputation = 6, Happiness = 7 }, Flags = { "ChessChampion" }, Story = "Sixty years after chess club, {name} became the national senior chess champion." } },
			{ Id = "Language", Text = "Learn a new language", Description = "Keep the mind sharp.",
				Effects = { Stats = { Intelligence = 6, Happiness = 3 }, Story = "{name} learned Italian and finally read their favourite novel in the original." } },
		},
	},
	{
		Id = "R_Health", Stage = 6, Icon = "🚶", Title = "Staying Well",
		Description = "Your knees creak and your doctor wants to see you more often.",
		Once = true,
		Choices = {
			{ Id = "Active", Text = "Stay active every day", Description = "Walks, swims, dancing.",
				Effects = { Stats = { Health = 8, Happiness = 4 }, Story = "{name} walked five miles every morning, rain or shine." } },
			{ Id = "Rest", Text = "Take it easy", Description = "You've earned rest.",
				Effects = { Stats = { Happiness = 3, Health = -2 }, Story = "{name} took life slowly." } },
			{ Id = "Club", Text = "Join a seniors' sports club", Description = "Bowls and banter.",
				Effects = { Stats = { Health = 5, Relationships = 5 }, Story = "{name} joined the local bowls club and made a dozen new friends." } },
			{ Id = "Ignore", Text = "Ignore the doctor", Description = "You know your body.",
				Effects = { Story = "{name} ignored their doctor.",
					Outcomes = { { Chance = 0.5, Stats = { Health = -12 }, Story = "It caught up with them." } } } },
		},
	},
	{
		Id = "R_Friends", Stage = 6, Icon = "☕", Title = "Old Friends",
		Description = "Your oldest friends want to meet up. Some of you haven't seen each other in years.",
		Once = true,
		Choices = {
			{ Id = "Reunion", Text = "Organise a big reunion", Description = "Get everyone together.",
				Effects = { Stats = { Relationships = 9, Happiness = 8 }, Bond = { Friend = 12, BestFriend = 12 }, Friends = 1, Story = "{name} organised a reunion. They laughed about the old days until midnight." } },
			{ Id = "Weekly", Text = "Start a weekly coffee group", Description = "Little and often.",
				Effects = { Stats = { Relationships = 6, Happiness = 5 }, Bond = { Friend = 8 }, Friends = 2, Story = "{name} started a Tuesday coffee group that met for years." } },
			{ Id = "Solitude", Text = "Enjoy your own company", Description = "Peace and quiet.",
				Effects = { Stats = { Happiness = 2, Relationships = -3 }, Story = "{name} preferred a quiet life." } },
		},
	},
	{
		Id = "R_Legacy", Stage = 6, Icon = "📜", Title = "Your Legacy",
		Description = "You're writing your will. What do you want to leave behind?",
		Once = true, Requires = { MinAge = 70 },
		Choices = {
			{ Id = "Family", Text = "Everything to family", Description = "Look after the ones you love.",
				Effects = { Stats = { Relationships = 6, Happiness = 3 }, Flags = { "FamilyLegacy" }, Story = "{name} left everything to their family." } },
			{ Id = "Charity", Text = "Most of it to charity", Description = "Help strangers you'll never meet.",
				Effects = { Stats = { Reputation = 8, Happiness = 4 }, Flags = { "CharityLegacy" }, Story = "{name} left most of their estate to charity." } },
			{ Id = "Mentor", Text = "Spend your time mentoring young people", Description = "Wisdom is the best gift.",
				Effects = { Stats = { Reputation = 6, Relationships = 6, Happiness = 5 }, Flags = { "Mentor" }, Story = "{name} mentored dozens of young people, passing on everything they'd learned." } },
			{ Id = "Spend", Text = "Spend it all and enjoy life", Description = "You can't take it with you.",
				Effects = { MoneyPercent = -0.5, Stats = { Happiness = 10 }, Story = "{name} decided to spend it all on adventures." } },
		},
	},
	{
		Id = "R_LookingBack", Stage = 6, Icon = "🌅", Title = "Looking Back",
		Description = "Sitting on the porch at sunset, you think about the life you've lived.",
		Priority = 5, Once = true, Requires = { MinAge = 75 },
		Choices = {
			{ Id = "Memoir", Text = "Write your memoir", Description = "Every chapter of it.",
				Effects = { Stats = { Happiness = 6, Reputation = 3 }, Flags = { "Memoir" }, Story = "{name} wrote down their whole life story, every triumph and every mistake." } },
			{ Id = "Party", Text = "Throw a big celebration of life", Description = "Everyone you love, one room.",
				Effects = { Stats = { Relationships = 8, Happiness = 9 }, Bond = { All = 8 }, Story = "{name} gathered everyone they loved for one last big party." } },
			{ Id = "Peace", Text = "Make peace with your regrets", Description = "Let it all go.",
				Effects = { Stats = { Happiness = 8 }, ClearFlags = { "Regret" }, Story = "{name} made peace with the roads not taken." } },
			{ Id = "Content", Text = "Smile quietly", Description = "It was a good life.",
				Effects = { Stats = { Happiness = 5 }, Story = "{name} smiled. It had been a good life." } },
		},
	},
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">Teen</string>
              <string name="Source"><![CDATA[--[[
	Teenage Years scenarios (Stage 2, ages 13–18)
	Reads childhood flags (Gamer, Athlete, MusicTalent, Rebellious...) and sets
	the plan flags young adulthood branches on: PlanUniTop, PlanUni, PlanWork,
	PlanApprentice, PlanGap, plus GoodGrades, STEM, Arts, BusinessStudies...
]]

return {
	{
		Id = "T_NewSchool", Stage = 2, Icon = "🏫", Title = "New School, New You",
		Description = "Secondary school is huge. In the canteen, every table is a different tribe. Where do you sit?",
		Priority = 10, Once = true,
		Choices = {
			{ Id = "Popular", Text = "With the popular crowd", Description = "Loud, confident, always at the centre of things.",
				Effects = { Stats = { Popularity = 8, Happiness = 3, Intelligence = -2 }, Traits = { Social = 1 }, Flags = { "CrowdPopular" }, Friends = 2, Story = "{name} slid onto the popular table like they'd always belonged there." } },
			{ Id = "Study", Text = "With the study group", Description = "They swap notes and quiz each other at lunch.",
				Effects = { Stats = { Intelligence = 7, Reputation = 2, Popularity = -2 }, Traits = { Studious = 1 }, Flags = { "CrowdStudy" }, Friends = 1, Story = "{name} joined the study group, and their grades started climbing." } },
			{ Id = "Sporty", Text = "With the sports team", Description = "Muddy boots and big appetites.",
				Effects = { Stats = { Health = 6, Popularity = 4 }, Traits = { Athletic = 1 }, Flags = { "CrowdSporty", "TeamPlayer" }, Friends = 1, Story = "{name} sat with the sports lot and was training with them by Friday." } },
			{ Id = "Arts", Text = "With the creative kids", Description = "Sketchbooks, band patches, big ideas.",
				Effects = { Stats = { Happiness = 5, Intelligence = 2 }, Traits = { Creative = 1 }, Flags = { "CrowdArts", "Creative" }, Friends = 1, Story = "{name} found their people among the artists and musicians." } },
			{ Id = "Esports", Text = "Start an esports club", Description = "Gather the best gamers in school.",
				Requires = { AnyFlags = { "Gamer", "CompetitiveGamer" } }, LockHint = "Requires a gaming background",
				Effects = { Stats = { Popularity = 5, Happiness = 5, Health = -2 }, Flags = { "Esports" }, Friends = 2, Story = "{name} founded the school's first esports club. Thirty people signed up on day one." } },
		},
	},
	{
		Id = "T_Exams", Stage = 2, Icon = "📝", Title = "Exam Season",
		Description = "Big exams in three weeks. Your friends are planning a trip to the beach the weekend before.",
		Once = true,
		Choices = {
			{ Id = "Hard", Text = "Study every day", Description = "Flashcards, past papers, early nights.",
				Effects = { Stats = { Intelligence = 8, Happiness = -3, Relationships = -1 }, Traits = { Studious = 1 }, Flags = { "GoodGrades" }, Story = "{name} studied relentlessly and aced the exams." } },
			{ Id = "Balance", Text = "Study, but keep a balance", Description = "Work hard, rest well.",
				Effects = { Stats = { Intelligence = 5, Happiness = 2, Health = 2 }, Story = "{name} found a rhythm of study and rest, and did well." } },
			{ Id = "Cram", Text = "Cram the night before", Description = "Works for some people…",
				Effects = { Stats = { Health = -3, Happiness = 2 }, Story = "{name} stayed up all night cramming.",
					Outcomes = { { Chance = 0.45, Stats = { Intelligence = 4 }, Flags = { "GoodGrades" }, Story = "Somehow, it worked!" }, { Chance = 0.55, Stats = { Intelligence = -3, Happiness = -4 }, Flags = { "PoorGrades" }, Story = "Their mind went blank in the exam hall." } } } },
			{ Id = "Beach", Text = "Go to the beach", Description = "You can't revise in the sun.",
				Effects = { Stats = { Happiness = 6, Relationships = 4, Intelligence = -5 }, Flags = { "PoorGrades" }, Story = "{name} had the best weekend of the year, and the worst results." } },
			{ Id = "Cheat", Text = "Write answers on your arm", Description = "What could go wrong?",
				Effects = { Stats = {}, Story = "{name} hid notes up their sleeve.",
					Outcomes = { { Chance = 0.5, Stats = { Reputation = -12, Happiness = -6 }, Flags = { "Cheater", "PoorGrades" }, Story = "An examiner spotted it. Disqualified, and the whole school knew by lunch." }, { Chance = 0.5, Stats = { Intelligence = 1, Reputation = -2 }, Flags = { "Cheater" }, Story = "They got away with it, but felt uneasy for weeks." } } } },
		},
	},
	{
		Id = "T_PartTime", Stage = 2, Icon = "☕", Title = "Part-Time Job",
		Description = "A sign in the café window: 'Weekend staff wanted'. Some of your friends already have jobs.",
		Once = true, Requires = { MinAge = 14 },
		Choices = {
			{ Id = "Cafe", Text = "Apply at the café", Description = "Steady pay, early Saturdays.",
				Effects = { Money = 400, Stats = { Happiness = -1, Reputation = 3 }, Traits = { Ambitious = 1 }, Flags = { "PartTimeJob" }, Story = "{name} got the café job and learned to make a mean hot chocolate." } },
			{ Id = "Babysit", Text = "Babysit for neighbours", Description = "Good money if the kids behave.",
				Effects = { Money = 300, Stats = { Relationships = 3, Reputation = 3 }, Traits = { Kind = 1 }, Flags = { "PartTimeJob" }, Story = "{name} became the most trusted babysitter on the street." } },
			{ Id = "Online", Text = "Sell things online", Description = "Flip old stuff for profit.",
				Requires = { AnyFlags = { "YoungEntrepreneur", "Saver" } }, LockHint = "Requires an early head for business",
				Effects = { Money = 1200, Stats = { Intelligence = 3 }, Traits = { Ambitious = 1 }, Flags = { "TeenHustler", "PartTimeJob" }, Story = "{name} turned car-boot finds into a thriving online shop." } },
			{ Id = "School", Text = "Focus on school instead", Description = "Money can wait.",
				Effects = { Stats = { Intelligence = 4, Happiness = 1 }, Story = "{name} skipped the job and put the time into schoolwork." } },
		},
	},
	{
		Id = "T_Party", Stage = 2, Icon = "🎉", Title = "The Big Party",
		Description = "Everyone's talking about Saturday's party. Your parents said you had to be home by eleven.",
		Once = true,
		Choices = {
			{ Id = "Life", Text = "Be the life of the party", Description = "Dance on the table. Metaphorically.",
				Effects = { Stats = { Popularity = 8, Happiness = 5, Health = -2 }, Traits = { Social = 1 }, Story = "{name} was the star of the night.",
					Outcomes = { { Chance = 0.35, Stats = { Relationships = -5, Reputation = -3 }, Bond = { Parent = -6 }, Story = "They got home at two in the morning. Grounded for a month." } } } },
			{ Id = "Early", Text = "Go, but leave on time", Description = "Best of both worlds.",
				Effects = { Stats = { Popularity = 3, Relationships = 3, Reputation = 2 }, Story = "{name} had a great time and was home by eleven." } },
			{ Id = "Home", Text = "Stay home", Description = "Parties aren't your thing.",
				Effects = { Stats = { Intelligence = 3, Popularity = -4, Happiness = -1 }, Story = "{name} stayed in and missed the stories everyone told on Monday." } },
			{ Id = "Host", Text = "Throw your own party", Description = "Your parents are away this weekend…",
				Effects = { Stats = { Popularity = 6 }, Traits = { Rebellious = 1 }, Story = "{name} threw a party while their parents were away.",
					Outcomes = { { Chance = 0.5, Stats = { Popularity = 6, Happiness = 5 }, Flags = { "LegendaryParty" }, Story = "It was legendary, and they cleaned up before anyone found out." }, { Chance = 0.5, Money = -200, Stats = { Relationships = -8, Reputation = -5 }, Bond = { Parent = -10 }, Story = "Someone broke a window. Their parents came home early." } } } },
		},
	},
	{
		Id = "T_Crush", Stage = 2, Icon = "💌", Title = "A Crush",
		Description = "There's someone in your class you can't stop thinking about. They smiled at you today.",
		Once = true, Requires = { MinAge = 14 },
		Choices = {
