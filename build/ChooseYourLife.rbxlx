		Choices = {
			{ Id = "Play", Text = "Go to the school play", Description = "They'll only be little once.",
				Effects = { Bond = { Child = 12, Partner = 4 }, Stats = { Happiness = 5, Career = -4 }, Story = "{name} sat in the front row and cheered loudest of all." } },
			{ Id = "Work", Text = "Do the presentation", Description = "Your career needs this.",
				Effects = { Bond = { Child = -10, Partner = -4 }, Stats = { Career = 6 }, Story = "{name} nailed the presentation, but missed the play.",
					Outcomes = { { Chance = 0.4, Promote = 1, Story = "It earned them a promotion." } } } },
			{ Id = "Both", Text = "Video call into the presentation from the hall", Description = "Try to do both.",
				Effects = { Bond = { Child = 4 }, Stats = { Career = 1, Health = -2 }, Story = "{name} presented from a school corridor during the interval." } },
		},
	},
	{
		Id = "W_Police", Stages = { YOUNG, ADULT, MID }, Icon = "🚓", Title = "The Long Night Shift",
