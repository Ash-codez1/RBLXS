          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">MiddleAge</string>
              <string name="Source"><![CDATA[--[[
	Middle Age scenarios (Stage 5, ages 41–60)
	Long-term consequences: businesses, families, health, old regrets, dreams.
]]

return {
	{
		Id = "M_Business", Stage = 5, Icon = "🏢", Title = "Your Company's Future",
		Description = "Your business has grown. Investors are circling and competitors are watching.",
		Once = true, Weight = 3, Requires = { Careers = { "Entrepreneur", "BusinessOwner", "RealEstate" } },
		Choices = {
			{ Id = "Expand", Text = "Expand worldwide", Description = "Go big.",
				Effects = { Stats = { Career = 5, Health = -4 }, Traits = { Ambitious = 1 }, Story = "{name} took the business global.",
					Outcomes = { { Chance = 0.45, Promote = 2, Money = 1500000, Stats = { Reputation = 8 }, Flags = { "Tycoon" }, Story = "It conquered new markets. {name} became a tycoon." }, { Chance = 0.35, MoneyPercent = -0.4, Stats = { Happiness = -8 }, Story = "Expansion went badly wrong and cost a fortune." } } } },
			{ Id = "Sell", Text = "Sell the company", Description = "Cash out.",
				Effects = { Career = "None", Money = 600000, Stats = { Happiness = 6, Health = 3 }, Flags = { "SoldCompany" }, Story = "{name} sold the company for $600,000." } },
			{ Id = "Steady", Text = "Keep it steady and profitable", Description = "Slow growth, good sleep.",
				Effects = { Money = 50000, Stats = { Happiness = 4 }, Story = "{name} kept the business steady and profitable." } },
			{ Id = "Staff", Text = "Hand shares to your staff", Requires = { MinMoney = 20000 }, LockHint = "Requires $20,000", Description = "Share the success.",
				Effects = { Money = -20000, Stats = { Reputation = 10, Relationships = 6 }, Traits = { Kind = 1 }, Story = "{name} gave every employee a share of the company." } },
		},
	},
	{
		Id = "M_TeenKids", Stage = 5, Icon = "🧑‍🎓", Title = "Raising Teenagers",
		Description = "Your kids are teenagers now: moody, brilliant and constantly asking for money.",
		Once = true, Weight = 1.5, Requires = { MinChildren = 1 },
		Choices = {
			{ Id = "Support", Text = "Be their biggest supporter", Description = "Every match, every show.",
				Effects = { Stats = { Relationships = 8, Happiness = 4, Career = -2 }, Bond = { Child = 12 }, Story = "{name} never missed a single game or school show." } },
			{ Id = "Strict", Text = "Set strict rules", Description = "Discipline builds character.",
				Effects = { Stats = { Reputation = 2, Relationships = -4 }, Bond = { Child = -8 }, Story = "{name} ran a strict household." } },
			{ Id = "Fund", Text = "Save for their university", Requires = { MinMoney = 30000 }, LockHint = "Requires $30,000", Description = "Give them a head start.",
				Effects = { Money = -30000, Stats = { Relationships = 6, Happiness = 3 }, Bond = { Child = 8 }, Flags = { "FundedKids" }, Story = "{name} paid for their children's university." } },
			{ Id = "Free", Text = "Let them find their own way", Description = "Trust them.",
				Effects = { Stats = { Relationships = 3, Happiness = 2 }, Story = "{name} trusted their kids to find their own way." } },
		},
	},
	{
		Id = "M_MakeAmends", Stage = 5, Icon = "🕊️", Title = "Old Wounds",
		Description = "You still think about someone you hurt or lost touch with years ago.",
		Once = true, Weight = 1.5,
		Boost = { Flags = { WasBully = 3, Cheater = 2, Record = 2 }, Stats = { Relationships = { Max = 45, Multiplier = 2 } } },
		Choices = {
			{ Id = "Apologise", Text = "Find them and apologise", Description = "It's never too late.",
				Effects = { Stats = { Relationships = 7, Happiness = 6, Reputation = 3 }, Traits = { Kind = 1 }, Flags = { "MadePeace" }, Friends = 1, Story = "{name} tracked them down and apologised. They both cried. Years later, they were friends." } },
			{ Id = "Family", Text = "Reconnect with estranged family", Description = "Blood is thicker than water.",
				Effects = { Stats = { Relationships = 8, Happiness = 4 }, Bond = { Sibling = 15, Parent = 10 }, Story = "{name} called a relative they hadn't spoken to in twenty years." } },
			{ Id = "Letter", Text = "Write a letter you'll never send", Description = "Let it go privately.",
				Effects = { Stats = { Happiness = 4 }, Story = "{name} wrote it all down and finally let it go." } },
			{ Id = "Leave", Text = "Leave the past in the past", Description = "Some doors stay closed.",
				Effects = { Stats = { Happiness = -1 }, Story = "{name} left the past where it was." } },
		},
	},
	{
		Id = "M_Dream", Stage = 5, Icon = "🌈", Title = "That Old Dream",
		Description = "Remember the thing you always wanted to do? You're running out of 'one day's.",
		Once = true, Weight = 2, Requires = { AnyFlags = { "IgnoredTalent", "WritingTalent", "MusicTalent", "Traveller", "Adventurous", "Published", "LateBloomer", "Creative", "Explorer" } },
		Choices = {
			{ Id = "Novel", Text = "Write the novel", Description = "Finally.",
				Effects = { Stats = { Happiness = 6, Intelligence = 3 }, Story = "{name} wrote the novel they'd been planning for decades.",
					Outcomes = { { Chance = 0.3, Money = 250000, Stats = { Popularity = 10, Reputation = 6 }, Flags = { "Bestseller" }, Story = "It became a bestseller!" } } } },
			{ Id = "Music", Text = "Record the album", Requires = { AnyFlags = { "MusicTalent", "LateBloomer", "Band", "Songwriter" } }, LockHint = "Requires a musical talent", Description = "Your songs, at last.",
				Effects = { Money = -5000, Stats = { Happiness = 9, Popularity = 5 }, Flags = { "Album" }, Story = "{name} recorded an album of the songs they'd carried for years." } },
			{ Id = "Sail", Text = "Sail around the world", Requires = { MinMoney = 40000 }, LockHint = "Requires $40,000", Description = "Wind, waves, freedom.",
				Effects = { Money = -40000, Stats = { Happiness = 12, Health = 4 }, Flags = { "Sailor" }, Story = "{name} sailed around the world. It took eighteen months and it was everything." } },
			{ Id = "Later", Text = "Maybe next year", Description = "There's always next year.",
				Effects = { Stats = { Happiness = -4 }, Flags = { "Regret" }, Story = "{name} put the dream off again." } },
		},
