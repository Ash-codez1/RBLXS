			{ Id = "Teach", Text = "Retrain as a teacher", Requires = { MinEducation = "School" }, LockHint = "Requires school qualifications", Description = "Share what you know.",
				Effects = { Career = "Teacher", Education = "University", Money = -5000, Stats = { Reputation = 5, Happiness = 4 }, Story = "{name} went back to college and retrained as a teacher." } },
			{ Id = "Retail", Text = "Take a steady job", Description = "Keep things simple.",
				Effects = { Career = "ShopAssistant", Stats = { Career = 2 }, Story = "{name} took a steady job." } },
			{ Id = "Retire", Text = "Retire early", Description = "Live simply.",
				Effects = { Retire = true, Stats = { Happiness = 3 }, Story = "{name} retired early and lived simply." } },
		},
	},
	{
