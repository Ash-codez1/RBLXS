	},
	{
		Id = "R_LookingBack", Stage = 6, Icon = "🌅", Title = "Looking Back",
		Description = "Sitting on the porch at sunset, you think about the life you've lived.",
		Priority = 5, Once = true, Requires = { MinAge = 75 },
		Choices = {
			{ Id = "Memoir", Text = "Write your memoir", Description = "Every chapter of it.",
				Effects = { Stats = { Happiness = 6, Reputation = 3 }, Flags = { "Memoir" }, Story = "{name} wrote down their whole life story, every triumph and every mistake." } },
			{ Id = "Party", Text = "Throw a big celebration of life", Description = "Everyone you love, one room.",
				Effects = { Stats = { Relationships = 8, Happiness = 9 }, Bond = { All = 8 }, Story = "{name} gathered everyone they loved for one last big party." } },
			{ Id = "Peace", Text = "Make peace with your regrets", Description = "Let it all go.",
				Effects = { Stats = { Happiness = 8 }, ClearFlags = { "Regret" }, Story = "{name} made peace with the roads not taken." } },
			{ Id = "Content", Text = "Smile quietly", Description = "It was a good life.",
				Effects = { Stats = { Happiness = 5 }, Story = "{name} smiled. It had been a good life." } },
		},
	},
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">Teen</string>
              <string name="Source"><![CDATA[--[[
	Teenage Years scenarios (Stage 2, ages 13–18)
	Reads childhood flags (Gamer, Athlete, MusicTalent, Rebellious...) and sets
	the plan flags young adulthood branches on: PlanUniTop, PlanUni, PlanWork,
	PlanApprentice, PlanGap, plus GoodGrades, STEM, Arts, BusinessStudies...
]]

return {
	{
		Id = "T_NewSchool", Stage = 2, Icon = "🏫", Title = "New School, New You",
		Description = "Secondary school is huge. In the canteen, every table is a different tribe. Where do you sit?",
		Priority = 10, Once = true,
		Choices = {
			{ Id = "Popular", Text = "With the popular crowd", Description = "Loud, confident, always at the centre of things.",
				Effects = { Stats = { Popularity = 8, Happiness = 3, Intelligence = -2 }, Traits = { Social = 1 }, Flags = { "CrowdPopular" }, Friends = 2, Story = "{name} slid onto the popular table like they'd always belonged there." } },
			{ Id = "Study", Text = "With the study group", Description = "They swap notes and quiz each other at lunch.",
				Effects = { Stats = { Intelligence = 7, Reputation = 2, Popularity = -2 }, Traits = { Studious = 1 }, Flags = { "CrowdStudy" }, Friends = 1, Story = "{name} joined the study group, and their grades started climbing." } },
			{ Id = "Sporty", Text = "With the sports team", Description = "Muddy boots and big appetites.",
				Effects = { Stats = { Health = 6, Popularity = 4 }, Traits = { Athletic = 1 }, Flags = { "CrowdSporty", "TeamPlayer" }, Friends = 1, Story = "{name} sat with the sports lot and was training with them by Friday." } },
			{ Id = "Arts", Text = "With the creative kids", Description = "Sketchbooks, band patches, big ideas.",
				Effects = { Stats = { Happiness = 5, Intelligence = 2 }, Traits = { Creative = 1 }, Flags = { "CrowdArts", "Creative" }, Friends = 1, Story = "{name} found their people among the artists and musicians." } },
			{ Id = "Esports", Text = "Start an esports club", Description = "Gather the best gamers in school.",
				Requires = { AnyFlags = { "Gamer", "CompetitiveGamer" } }, LockHint = "Requires a gaming background",
				Effects = { Stats = { Popularity = 5, Happiness = 5, Health = -2 }, Flags = { "Esports" }, Friends = 2, Story = "{name} founded the school's first esports club. Thirty people signed up on day one." } },
		},
	},
	{
		Id = "T_Exams", Stage = 2, Icon = "📝", Title = "Exam Season",
		Description = "Big exams in three weeks. Your friends are planning a trip to the beach the weekend before.",
		Once = true,
		Choices = {
			{ Id = "Hard", Text = "Study every day", Description = "Flashcards, past papers, early nights.",
				Effects = { Stats = { Intelligence = 8, Happiness = -3, Relationships = -1 }, Traits = { Studious = 1 }, Flags = { "GoodGrades" }, Story = "{name} studied relentlessly and aced the exams." } },
			{ Id = "Balance", Text = "Study, but keep a balance", Description = "Work hard, rest well.",
				Effects = { Stats = { Intelligence = 5, Happiness = 2, Health = 2 }, Story = "{name} found a rhythm of study and rest, and did well." } },
			{ Id = "Cram", Text = "Cram the night before", Description = "Works for some people…",
				Effects = { Stats = { Health = -3, Happiness = 2 }, Story = "{name} stayed up all night cramming.",
					Outcomes = { { Chance = 0.45, Stats = { Intelligence = 4 }, Flags = { "GoodGrades" }, Story = "Somehow, it worked!" }, { Chance = 0.55, Stats = { Intelligence = -3, Happiness = -4 }, Flags = { "PoorGrades" }, Story = "Their mind went blank in the exam hall." } } } },
			{ Id = "Beach", Text = "Go to the beach", Description = "You can't revise in the sun.",
				Effects = { Stats = { Happiness = 6, Relationships = 4, Intelligence = -5 }, Flags = { "PoorGrades" }, Story = "{name} had the best weekend of the year, and the worst results." } },
			{ Id = "Cheat", Text = "Write answers on your arm", Description = "What could go wrong?",
				Effects = { Stats = {}, Story = "{name} hid notes up their sleeve.",
					Outcomes = { { Chance = 0.5, Stats = { Reputation = -12, Happiness = -6 }, Flags = { "Cheater", "PoorGrades" }, Story = "An examiner spotted it. Disqualified, and the whole school knew by lunch." }, { Chance = 0.5, Stats = { Intelligence = 1, Reputation = -2 }, Flags = { "Cheater" }, Story = "They got away with it, but felt uneasy for weeks." } } } },
		},
	},
	{
		Id = "T_PartTime", Stage = 2, Icon = "☕", Title = "Part-Time Job",
		Description = "A sign in the café window: 'Weekend staff wanted'. Some of your friends already have jobs.",
		Once = true, Requires = { MinAge = 14 },
		Choices = {
			{ Id = "Cafe", Text = "Apply at the café", Description = "Steady pay, early Saturdays.",
				Effects = { Money = 400, Stats = { Happiness = -1, Reputation = 3 }, Traits = { Ambitious = 1 }, Flags = { "PartTimeJob" }, Story = "{name} got the café job and learned to make a mean hot chocolate." } },
			{ Id = "Babysit", Text = "Babysit for neighbours", Description = "Good money if the kids behave.",
				Effects = { Money = 300, Stats = { Relationships = 3, Reputation = 3 }, Traits = { Kind = 1 }, Flags = { "PartTimeJob" }, Story = "{name} became the most trusted babysitter on the street." } },
			{ Id = "Online", Text = "Sell things online", Description = "Flip old stuff for profit.",
				Requires = { AnyFlags = { "YoungEntrepreneur", "Saver" } }, LockHint = "Requires an early head for business",
				Effects = { Money = 1200, Stats = { Intelligence = 3 }, Traits = { Ambitious = 1 }, Flags = { "TeenHustler", "PartTimeJob" }, Story = "{name} turned car-boot finds into a thriving online shop." } },
			{ Id = "School", Text = "Focus on school instead", Description = "Money can wait.",
				Effects = { Stats = { Intelligence = 4, Happiness = 1 }, Story = "{name} skipped the job and put the time into schoolwork." } },
		},
	},
	{
		Id = "T_Party", Stage = 2, Icon = "🎉", Title = "The Big Party",
		Description = "Everyone's talking about Saturday's party. Your parents said you had to be home by eleven.",
		Once = true,
		Choices = {
			{ Id = "Life", Text = "Be the life of the party", Description = "Dance on the table. Metaphorically.",
				Effects = { Stats = { Popularity = 8, Happiness = 5, Health = -2 }, Traits = { Social = 1 }, Story = "{name} was the star of the night.",
					Outcomes = { { Chance = 0.35, Stats = { Relationships = -5, Reputation = -3 }, Bond = { Parent = -6 }, Story = "They got home at two in the morning. Grounded for a month." } } } },
			{ Id = "Early", Text = "Go, but leave on time", Description = "Best of both worlds.",
				Effects = { Stats = { Popularity = 3, Relationships = 3, Reputation = 2 }, Story = "{name} had a great time and was home by eleven." } },
			{ Id = "Home", Text = "Stay home", Description = "Parties aren't your thing.",
				Effects = { Stats = { Intelligence = 3, Popularity = -4, Happiness = -1 }, Story = "{name} stayed in and missed the stories everyone told on Monday." } },
			{ Id = "Host", Text = "Throw your own party", Description = "Your parents are away this weekend…",
				Effects = { Stats = { Popularity = 6 }, Traits = { Rebellious = 1 }, Story = "{name} threw a party while their parents were away.",
					Outcomes = { { Chance = 0.5, Stats = { Popularity = 6, Happiness = 5 }, Flags = { "LegendaryParty" }, Story = "It was legendary, and they cleaned up before anyone found out." }, { Chance = 0.5, Money = -200, Stats = { Relationships = -8, Reputation = -5 }, Bond = { Parent = -10 }, Story = "Someone broke a window. Their parents came home early." } } } },
		},
	},
	{
		Id = "T_Crush", Stage = 2, Icon = "💌", Title = "A Crush",
		Description = "There's someone in your class you can't stop thinking about. They smiled at you today.",
		Once = true, Requires = { MinAge = 14 },
		Choices = {
			{ Id = "Ask", Text = "Ask them out", Description = "Heart pounding.",
				Effects = { Stats = { Happiness = 1 }, Traits = { Brave = 1 }, Story = "{name} took a deep breath and asked.",
					Outcomes = { { Chance = 0.55, Stats = { Happiness = 8, Relationships = 5 }, Flags = { "FirstLove" }, Story = "They said yes!" }, { Chance = 0.45, Stats = { Happiness = -6, Popularity = -1 }, Story = "They said they 'just wanted to be friends'. Ouch." } } } },
			{ Id = "Song", Text = "Write them a song", Description = "Let the music do the talking.",
				Requires = { Flags = { "MusicTalent" } }, LockHint = "Requires a musical talent",
				Effects = { Stats = { Happiness = 9, Popularity = 6, Relationships = 5 }, Flags = { "FirstLove", "Songwriter" }, Story = "{name} played them a song they'd written. It worked." } },
			{ Id = "Friends", Text = "Become good friends first", Description = "Slow and steady.",
				Effects = { Stats = { Relationships = 6, Happiness = 2 }, Friends = 1, Story = "{name} became close friends with them instead." } },
			{ Id = "Ignore", Text = "Focus on school", Description = "No distractions.",
				Effects = { Stats = { Intelligence = 3, Happiness = -2 }, Story = "{name} buried the feeling and buried themselves in books." } },
		},
	},
	{
		Id = "T_Talent", Stage = 2, Icon = "🌠", Title = "Getting Noticed",
		Description = "That thing you've always been good at? People are starting to notice.",
		Once = true, Weight = 2.5,
		Requires = { AnyFlags = { "MusicTalent", "WritingTalent", "TechTalent", "Athlete", "Songwriter" } },
		Choices = {
			{ Id = "Band", Text = "Form a band", Requires = { AnyFlags = { "MusicTalent", "Songwriter" } }, LockHint = "Requires a musical talent", Description = "Garage rehearsals, local gigs.",
				Effects = { Stats = { Popularity = 7, Happiness = 6 }, Flags = { "Band" }, Story = "{name} started a band. Their first gig had 40 people dancing." } },
			{ Id = "Write", Text = "Enter a national writing contest", Requires = { Flags = { "WritingTalent" } }, LockHint = "Requires a writing talent", Description = "Your story against the country.",
				Effects = { Stats = { Intelligence = 4, Reputation = 5 }, Story = "{name} entered a national contest.",
					Outcomes = { { Chance = 0.4, Stats = { Popularity = 6, Happiness = 6 }, Flags = { "Published" }, Story = "They won, and their story was published!" } } } },
			{ Id = "App", Text = "Build and release an app", Requires = { Flags = { "TechTalent" } }, LockHint = "Requires a tech talent", Description = "Code all summer.",
				Effects = { Stats = { Intelligence = 6 }, Flags = { "AppBuilder" }, Story = "{name} coded all summer and released their first app.",
					Outcomes = { { Chance = 0.3, Money = 3000, Stats = { Popularity = 5 }, Flags = { "AppHit" }, Story = "It hit the top 100 chart!" } } } },
			{ Id = "Trials", Text = "Go to county sports trials", Requires = { Flags = { "Athlete" } }, LockHint = "Requires an athletic background", Description = "The next level.",
				Effects = { Stats = { Health = 6, Popularity = 4 }, Story = "{name} trained hard for the county trials.",
					Outcomes = { { Chance = 0.5, Stats = { Happiness = 6 }, Flags = { "Scouted" }, Story = "They were selected, and a pro academy took notice." } } } },
			{ Id = "Hobby", Text = "Keep it as a hobby", Description = "No pressure, just fun.",
				Effects = { Stats = { Happiness = 4, Health = 1 }, Story = "{name} kept their talent as something just for fun." } },
		},
	},
	{
		Id = "T_Online", Stage = 2, Icon = "📱", Title = "Going Online",
		Description = "Your friends say you'd be great at making videos. Your phone has a good camera…",
		Once = true, Weight = 1.5,
		Requires = { AnyFlags = { "StreamerSeed", "Performer", "CompetitiveGamer", "Outgoing", "CrowdPopular", "Esports" } },
		Boost = { Flags = { StreamerSeed = 3 } },
		Choices = {
			{ Id = "Channel", Text = "Start a channel", Description = "Post a few videos a week.",
				Effects = { Stats = { Popularity = 5, Happiness = 3, Intelligence = -1 }, Flags = { "ChannelStarted" }, Story = "{name} started a channel and posted their first video." } },
			{ Id = "Daily", Text = "Post every single day", Description = "All in.",
				Effects = { Stats = { Popularity = 6, Health = -3, Intelligence = -3 }, Flags = { "ChannelStarted" }, Story = "{name} posted every day without fail.",
					Outcomes = { { Chance = 0.3, Stats = { Popularity = 8 }, Flags = { "TeenFamous" }, Story = "Their follower count hit 100,000." } } } },
			{ Id = "Private", Text = "Keep your accounts private", Description = "Only real friends.",
				Effects = { Stats = { Relationships = 3, Happiness = 2 }, Story = "{name} kept their online life small and private." } },
			{ Id = "Delete", Text = "Delete social media", Description = "Peace and quiet.",
				Effects = { Stats = { Happiness = 5, Health = 2, Popularity = -4 }, Story = "{name} deleted every app and slept better than ever." } },
		},
	},
	{
		Id = "T_WrongCrowd", Stage = 2, Icon = "🕶️", Title = "The Wrong Crowd",
		Description = "Some older kids have a 'money-making scheme' and want you in. It doesn't sound legal.",
		Once = true, Weight = 1.5,
		Requires = { AnyFlags = { "Rebellious", "WasBully", "LegendaryParty", "Cheater" } },
		Choices = {
			{ Id = "Join", Text = "Join them", Description = "Easy money.",
				Effects = { Money = 500, Stats = { Popularity = 3 }, Traits = { Rebellious = 1 }, Story = "{name} joined the scheme.",
					Outcomes = { { Chance = 0.45, Money = -500, Stats = { Reputation = -15, Relationships = -6, Happiness = -6 }, Flags = { "Record" }, Story = "They were caught. It went on their record." } } } },
			{ Id = "Talk", Text = "Talk them out of it", Description = "Not worth it.",
				Effects = { Stats = { Reputation = 5, Popularity = -2 }, Traits = { Brave = 1 }, Story = "{name} talked the group out of the whole thing." } },
			{ Id = "Walk", Text = "Walk away", Description = "Not your problem.",
				Effects = { Stats = { Reputation = 2 }, Story = "{name} walked away and never looked back." } },
			{ Id = "Tell", Text = "Tell a teacher", Description = "Someone could get hurt.",
				Effects = { Stats = { Reputation = 6, Popularity = -5 }, Traits = { Kind = 1 }, Story = "{name} reported it. Some people called them a snitch; others quietly thanked them." } },
		},
	},
	{
		Id = "T_Volunteer", Stage = 2, Icon = "🤲", Title = "Volunteering Week",
		Description = "School wants every student to volunteer for a week. Where will you go?",
		Once = true,
		Choices = {
			{ Id = "Animals", Text = "Animal shelter", Description = "Puppies. Obviously.",
				Effects = { Stats = { Happiness = 6, Reputation = 3 }, Traits = { Kind = 1 }, Flags = { "AnimalLover" }, Story = "{name} spent a week at the animal shelter and cried when it ended." } },
			{ Id = "Hospital", Text = "Local hospital", Description = "See what doctors really do.",
				Effects = { Stats = { Intelligence = 5, Reputation = 3 }, Flags = { "MedicalInterest" }, Story = "{name} shadowed nurses and doctors and was fascinated." } },
			{ Id = "Coach", Text = "Coach little kids' football", Description = "Organised chaos.",
				Effects = { Stats = { Relationships = 4, Health = 3, Reputation = 3 }, Flags = { "Leader" }, Story = "{name} coached a team of seven-year-olds to their first win." } },
			{ Id = "Office", Text = "A law firm's office", Description = "Suits and paperwork.",
				Effects = { Stats = { Intelligence = 4, Career = 3 }, Flags = { "LawInterest" }, Story = "{name} spent the week filing at a law firm and sat in on a real court case." } },
			{ Id = "Skip", Text = "Find a way to skip it", Description = "A week off!",
				Effects = { Stats = { Happiness = 3, Reputation = -4 }, Story = "{name} 'forgot' to sign up and had a week off." } },
		},
	},
	{
		Id = "T_Subjects", Stage = 2, Icon = "📚", Title = "Choose Your Subjects",
		Description = "Time to pick the subjects you'll study for your final years. This could shape your whole career.",
		Once = true, Requires = { MinAge = 15 }, Weight = 3,
		Choices = {
			{ Id = "STEM", Text = "Sciences and maths", Description = "Lab coats and equations.",
				Effects = { Stats = { Intelligence = 6, Happiness = -1 }, Flags = { "STEM" }, Story = "{name} chose sciences and maths." } },
			{ Id = "Arts", Text = "Arts and humanities", Description = "History, literature, art.",
				Effects = { Stats = { Intelligence = 3, Happiness = 4 }, Flags = { "Arts" }, Story = "{name} chose arts and humanities." } },
			{ Id = "Business", Text = "Business and economics", Description = "Learn how money works.",
				Effects = { Stats = { Intelligence = 4, Career = 3 }, Traits = { Ambitious = 1 }, Flags = { "BusinessStudies" }, Story = "{name} chose business and economics." } },
			{ Id = "Sport", Text = "Sport and PE", Description = "Train like a pro.",
				Effects = { Stats = { Health = 6, Happiness = 2 }, Flags = { "SportsStudies" }, Story = "{name} chose sport-focused subjects." } },
			{ Id = "Easy", Text = "Whatever looks easiest", Description = "Less work, more fun.",
				Effects = { Stats = { Happiness = 4, Intelligence = -3 }, Story = "{name} picked the easiest subjects they could find." } },
		},
	},
	{
		Id = "T_Family", Stage = 2, Icon = "🏠", Title = "Tough Times at Home",
		Description = "Money is tight at home and your parents are stressed. The atmosphere is heavy.",
		Once = true, Weight = 0.8,
		Choices = {
			{ Id = "Help", Text = "Help out around the house", Description = "Cook, clean, look after siblings.",
				Effects = { Stats = { Relationships = 6, Reputation = 3, Happiness = -1 }, Bond = { Parent = 10, Sibling = 6 }, Traits = { Kind = 1 }, Story = "{name} stepped up at home, and the family grew closer." } },
			{ Id = "Job", Text = "Get a job to help pay bills", Description = "Grow up fast.",
				Effects = { Money = 300, Stats = { Relationships = 4, Intelligence = -2 }, Traits = { Ambitious = 1 }, Flags = { "PartTimeJob" }, Story = "{name} took a job and handed half their pay to their parents." } },
			{ Id = "Escape", Text = "Spend all your time at friends' houses", Description = "Out of sight, out of mind.",
				Effects = { Stats = { Popularity = 3, Relationships = -5 }, Bond = { Parent = -8, Friend = 4 }, Story = "{name} stayed away from home as much as possible." } },
			{ Id = "Talk", Text = "Sit down and talk with them", Description = "Clear the air.",
				Effects = { Stats = { Relationships = 7, Happiness = 2 }, Bond = { Parent = 12 }, Story = "{name} had an honest talk with their parents. Everyone felt lighter." } },
		},
	},
	{
		Id = "T_Driving", Stage = 2, Icon = "🚗", Title = "Learning to Drive",
		Description = "You're old enough to learn to drive. Lessons are expensive, but freedom is priceless.",
		Once = true, Requires = { MinAge = 16 },
		Choices = {
			{ Id = "Lessons", Text = "Pay for proper lessons", Description = "Do it right.",
				Effects = { Money = -300, Stats = { Happiness = 4, Reputation = 2 }, Flags = { "CanDrive" }, Story = "{name} passed their driving test first time." } },
			{ Id = "Parent", Text = "Learn with a parent", Description = "Free, but stressful.",
				Effects = { Stats = { Relationships = 2, Happiness = 1 }, Story = "{name} learned to drive with a parent gripping the dashboard.",
					Outcomes = { { Chance = 0.6, Flags = { "CanDrive" }, Story = "They passed!" }, { Chance = 0.4, Stats = { Happiness = -3 }, Story = "They failed the test twice." } } } },
			{ Id = "Bike", Text = "Stick to your bike", Description = "Cheaper and healthier.",
				Effects = { Stats = { Health = 4 }, Story = "{name} decided a bike was all they needed." } },
		},
	},
	{
		Id = "T_Future", Stage = 2, Icon = "🧭", Title = "What Comes Next?",
		Description = "School is nearly over. Teachers keep asking about your plans. What's your next step?",
		Once = true, Priority = 5, Requires = { MinAge = 17 },
		Choices = {
			{ Id = "TopUni", Text = "Apply to a top university", Description = "Competitive, prestigious.",
				Requires = { MinStats = { Intelligence = 62 } }, LockHint = "Requires Intelligence 62+",
				Effects = { Education = "School", Stats = { Intelligence = 3, Happiness = 3, Reputation = 4 }, Flags = { "PlanUniTop", "PlanUni" }, Story = "{name} was accepted into a top university!" } },
			{ Id = "Uni", Text = "Apply to a local university", Description = "Close to home, a solid degree.",
				Requires = { MinStats = { Intelligence = 42 } }, LockHint = "Requires Intelligence 42+",
				Effects = { Education = "School", Stats = { Intelligence = 2, Happiness = 2 }, Flags = { "PlanUni" }, Story = "{name} got a place at the local university." } },
			{ Id = "Apprentice", Text = "Start an apprenticeship", Description = "Earn while you learn a trade.",
				Effects = { Education = "School", Stats = { Career = 4, Intelligence = 1 }, Flags = { "PlanApprentice" }, Story = "{name} signed up for an apprenticeship." } },
			{ Id = "Work", Text = "Go straight into work", Description = "Start earning now.",
				Effects = { Education = "School", Money = 500, Stats = { Career = 3 }, Flags = { "PlanWork" }, Story = "{name} decided to start working straight after school." } },
			{ Id = "Gap", Text = "Take a gap year to travel", Description = "See the world first.",
				Effects = { Education = "School", Stats = { Happiness = 5 }, Traits = { Adventurous = 1 }, Flags = { "PlanGap" }, Story = "{name} decided to take a gap year and travel." } },
		},
	},
	{
		Id = "T_Prom", Stage = 2, Icon = "🪩", Title = "End-of-School Dance",
		Description = "The final dance before everyone goes their separate ways.",
		Once = true, Requires = { MinAge = 17 },
		Choices = {
			{ Id = "Friends", Text = "Go with your friends", Description = "Squad goals.",
				Effects = { Stats = { Relationships = 5, Happiness = 5 }, Bond = { Friend = 6, BestFriend = 6 }, Story = "{name} danced all night with their best friends." } },
			{ Id = "Date", Text = "Go with your first love", Requires = { Flags = { "FirstLove" } }, LockHint = "Requires a teenage romance", Description = "Just like the movies.",
				Effects = { Stats = { Happiness = 8, Relationships = 5 }, Flags = { "TeenSweethearts" }, Story = "{name} and their first love were the couple of the night." } },
			{ Id = "Organise", Text = "Organise the whole event", Description = "Make it unforgettable.",
				Effects = { Stats = { Reputation = 6, Popularity = 4, Health = -2 }, Flags = { "Leader" }, Story = "{name} organised the dance. People talked about it for years." } },
			{ Id = "Skip", Text = "Skip it", Description = "Not your scene.",
				Effects = { Stats = { Happiness = -1 }, Story = "{name} skipped the dance and watched films at home." } },
		},
	},
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">YoungAdult</string>
              <string name="Source"><![CDATA[--[[
	Young Adulthood scenarios (Stage 3, ages 19–25)
	Turns teenage plans into a path (university, apprenticeship, work, travel)
	and offers the big career choices. Career scenarios are tried in priority
	order (professional → creative → business → service); "keep exploring"
	moves on to the next one. Choosing a career sets CareerChosen.
]]

return {
	{
		Id = "Y_FirstStep", Stage = 3, Icon = "🚪", Title = "Your First Big Step",
		Description = "School is behind you. Today your adult life actually begins.",
		Priority = 10, Once = true,
		Choices = {
			{ Id = "Uni", Text = "Start university", Description = "Lectures, halls, freedom.", Requires = { Flags = { "PlanUni" } }, LockHint = "Requires a university place",
				Effects = { Stats = { Intelligence = 5, Happiness = 4, Relationships = 3 }, Flags = { "AtUni", "StudentLoan" }, Loan = { Kind = "Student", Amount = 27000 }, Friends = 1, Story = "{name} moved into student halls and started university." } },
			{ Id = "Apprentice", Text = "Begin your apprenticeship", Description = "Learn a trade from the pros.", Requires = { Flags = { "PlanApprentice" } }, LockHint = "Requires an apprenticeship place",
				Effects = { Career = "Tradesperson", Stats = { Career = 5, Health = 2 }, Story = "{name} started an electrical apprenticeship and loved working with their hands." } },
			{ Id = "Job", Text = "Start your first full-time job", Description = "A steady wage at last.", Requires = { Flags = { "PlanWork" } }, LockHint = "Requires a plan to start working",
				Effects = { Career = "ShopAssistant", Money = 800, Stats = { Career = 4 }, Story = "{name} started full-time at a busy department store." } },
			{ Id = "Travel", Text = "Set off travelling", Description = "Backpack, passport, no plan.", Requires = { Flags = { "PlanGap" } }, LockHint = "Requires a gap-year plan",
