	},
	{
		Id = "G_Volunteer", Icon = "🧱", Title = "Volunteer Week",
		Description = "A charity is looking for groups to volunteer for a week.",
		Requires = { MinAge = 14 },
		Choices = {
			{ Id = "Build", Text = "Build homes", Description = "Hammers and hard hats.",
				Effects = { Stats = { Reputation = 7, Health = 2 }, Traits = { Kind = 1 }, Story = "{name} and friends helped build homes for families in need." } },
			{ Id = "Animals", Text = "Animal rescue", Description = "Puppies need you.",
				Effects = { Stats = { Happiness = 6, Reputation = 4 }, Traits = { Kind = 1 }, Story = "{name} and friends spent a week at an animal rescue centre." } },
			{ Id = "Teach", Text = "Teach younger kids", Description = "Pass it on.",
				Effects = { Stats = { Reputation = 5, Intelligence = 2 }, Story = "{name} and friends ran a summer school for younger kids." } },
			{ Id = "Skip", Text = "Not this time", Description = "Busy week.",
				Effects = { Stats = { Reputation = -1 }, Story = "{name}'s group sat this one out." } },
		},
	},
	{
		Id = "G_Reunion", Icon = "🥳", Title = "The Big Reunion",
		Description = "It's been years. Time for a reunion with the whole gang.",
		Requires = { MinAge = 30 },
		Choices = {
			{ Id = "Party", Text = "Throw a huge party", Description = "Like old times.",
				Effects = { Money = -300, Stats = { Relationships = 8, Happiness = 6 }, Bond = { Friend = 6, BestFriend = 6 }, Story = "{name}'s reunion party went on until 4am." } },
			{ Id = "Dinner", Text = "A quiet dinner", Description = "Proper catch-ups.",
				Effects = { Stats = { Relationships = 6, Happiness = 4 }, Story = "{name} and friends talked for hours over dinner." } },
			{ Id = "Karaoke", Text = "Karaoke night", Description = "Questionable singing guaranteed.",
				Effects = { Stats = { Happiness = 7, Popularity = 3 }, Story = "{name}'s group murdered every song on the karaoke list." } },
		},
	},
}
]]></string>
