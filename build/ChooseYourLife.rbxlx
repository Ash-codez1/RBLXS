      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config  (ReplicatedStorage.Shared.Config)
	Game-wide constants shared by server and client.
	Nothing in here is secret: the client can read it, but only the server acts on it.
]]

local Config = {}

Config.GameName = "CHOOSE YOUR LIFE"
Config.Version = "0.1.0"

-- ===== Data =====
Config.DataStoreName = "ChooseYourLife_PlayerData_v1"
Config.DataKeyPrefix = "Player_"
Config.AutosaveInterval = 60 -- seconds between automatic saves
Config.SessionLockExpiry = 30 * 60 -- a lock older than this is treated as abandoned (server crash)
Config.LoadRetries = 5
Config.LoadRetryDelay = 6 -- seconds; multiplied by attempt number
Config.SaveRetries = 4
Config.MaxLifeHistory = 30 -- completed-life summaries kept per player
Config.MaxStoryEntries = 120 -- story log entries kept in the active life
Config.MaxProcessedReceipts = 50 -- dev-product receipts remembered to block duplicates
Config.SaveSlotCount = 3

-- ===== Stats =====
Config.StatMin = 0
Config.StatMax = 100
Config.StatStart = 50

-- ===== Economy =====
Config.StartingCoins = 100 -- meta currency (shop), persists across lives
Config.StartingMoney = 0 -- in-life money, resets every new life

-- ===== Life simulation =====
Config.EventChance = 0.28 -- chance of a random life event after each decision
Config.TwistChance = 0.22 -- chance of a twist at each stage's Life Reveal

-- ===== Multiplayer =====
Config.CityEventInterval = 480 -- seconds between server-wide city events (90 in Studio)
Config.CityEventJoinSeconds = 45
Config.CityEventMinPlayers = 2 -- with an active life (1 in Studio, so solo testing works)

-- ===== Networking =====
-- Default token-bucket limits for remotes (requests per second, burst size).
Config.DefaultRateLimit = { Rate = 4, Burst = 8 }

-- ===== Replication =====
Config.ReplicationThrottle = 0.15 -- min seconds between data pushes to a client

-- ===== Credits (shown on the Credits screen; edit freely) =====
Config.Credits = {
	{ Heading = "Created by", Lines = { "The CHOOSE YOUR LIFE team" } },
	{ Heading = "Game design & development", Lines = { "Built in Roblox Studio with Luau" } },
	{ Heading = "Special thanks", Lines = { "Everyone who played, tested and shared their lives with friends" } },
}

-- ===== Loading tips =====
Config.LoadingTips = {
	"Every choice shapes your future. There are no wrong answers, only different lives.",
	"Locked choices hint at hidden paths. Make different decisions to unlock them!",
	"Traits you build as a child make similar choices pay off more later in life.",
	"You have three save slots, so try living three completely different lives.",
	"Some outcomes are risky. Look for the 🎲 on a choice.",
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="3">
        <Properties>
          <string name="Name">Data</string>
        </Properties>
        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">Assets</string>
            <string name="Source"><![CDATA[--[[
	Assets  (ReplicatedStorage.Shared.Data.Assets)
	Big purchases a life can make through choices (homes, cars...). They count
	toward net worth, so they raise the Wealth stat. In-life only: these are
	separate from the cosmetic shop items bought with Coins (Phase 7).
]]

local Assets = {}

Assets.Info = {
	Apartment = { Title = "Apartment", Icon = "🏢", Value = 60000, Kind = "Home" },
	House = { Title = "Family House", Icon = "🏡", Value = 260000, Kind = "Home" },
	Mansion = { Title = "Mansion", Icon = "🏰", Value = 2500000, Kind = "Home" },
	HolidayHome = { Title = "Holiday Home", Icon = "🏝️", Value = 400000, Kind = "Home" },
	Car = { Title = "Car", Icon = "🚗", Value = 18000, Kind = "Vehicle" },
	SportsCar = { Title = "Sports Car", Icon = "🏎️", Value = 180000, Kind = "Vehicle" },
	Yacht = { Title = "Yacht", Icon = "🛥️", Value = 1500000, Kind = "Vehicle" },
}

function Assets.IsValid(id: any): boolean
	return type(id) == "string" and Assets.Info[id] ~= nil
end

function Assets.TotalValue(owned: { [string]: any }): number
	local total = 0
	for id in pairs(owned) do
		local info = Assets.Info[id]
		if info then
			total += info.Value
		end
	end
	return total
end

return Assets
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">Careers</string>
            <string name="Source"><![CDATA[--[[
	Careers  (ReplicatedStorage.Shared.Data.Careers)
	Every career a life can have. Shared so the client can show titles; only the
	server assigns careers (through choice/event Effects) and pays salaries.

	Each career has 5 levels. Salary at level L = Salary × (1 + 0.3 × (L − 1)).
	Special careers (Astronaut, ProGamer) are only reachable through rare
	branches.
]]

local Careers = {}

Careers.MaxLevel = 5

Careers.Info = {
	Doctor = { Icon = "🩺", Salary = 90000, Category = "Medical", Levels = { "Junior Doctor", "Doctor", "Senior Doctor", "Consultant", "Chief of Medicine" } },
	Lawyer = { Icon = "⚖️", Salary = 80000, Category = "Law", Levels = { "Junior Lawyer", "Associate", "Senior Associate", "Partner", "Senior Partner" } },
	PoliceOfficer = { Icon = "👮", Salary = 38000, Category = "Public Service", Levels = { "Constable", "Sergeant", "Inspector", "Chief Inspector", "Commissioner" } },
	Teacher = { Icon = "🍎", Salary = 36000, Category = "Education", Levels = { "Trainee Teacher", "Teacher", "Head of Department", "Deputy Head", "Headteacher" } },
	Athlete = { Icon = "🏅", Salary = 70000, Category = "Sport", Levels = { "Rookie", "Professional Athlete", "Star Player", "Team Captain", "Sporting Legend" } },
	Singer = { Icon = "🎤", Salary = 45000, Category = "Entertainment", Levels = { "Open-Mic Singer", "Signed Artist", "Chart Star", "Headliner", "Pop Icon" } },
	Actor = { Icon = "🎬", Salary = 40000, Category = "Entertainment", Levels = { "Extra", "Supporting Actor", "Lead Actor", "Film Star", "Screen Legend" } },
	Influencer = { Icon = "📸", Salary = 30000, Category = "Media", Levels = { "Micro-Influencer", "Influencer", "Brand Partner", "Mega-Influencer", "Internet Icon" } },
	YouTuber = { Icon = "▶️", Salary = 28000, Category = "Media", Levels = { "Small Creator", "Rising Creator", "Partnered Creator", "Top Creator", "Platform Legend" } },
	Entrepreneur = { Icon = "🚀", Salary = 45000, Category = "Business", Levels = { "Founder", "Startup CEO", "Scale-up CEO", "Tycoon", "Mogul" } },
	BusinessOwner = { Icon = "🏪", Salary = 42000, Category = "Business", Levels = { "Shop Owner", "Business Owner", "Chain Owner", "Regional Boss", "Business Magnate" } },
	Chef = { Icon = "👨‍🍳", Salary = 32000, Category = "Food", Levels = { "Line Cook", "Chef", "Sous Chef", "Head Chef", "Celebrity Chef" } },
	Engineer = { Icon = "⚙️", Salary = 55000, Category = "Technology", Levels = { "Graduate Engineer", "Engineer", "Senior Engineer", "Lead Engineer", "Chief Engineer" } },
	Scientist = { Icon = "🔬", Salary = 52000, Category = "Science", Levels = { "Research Assistant", "Scientist", "Senior Scientist", "Lab Director", "Renowned Professor" } },
	Musician = { Icon = "🎸", Salary = 30000, Category = "Entertainment", Levels = { "Busker", "Session Musician", "Band Member", "Touring Musician", "Rock Legend" } },
	Artist = { Icon = "🎨", Salary = 26000, Category = "Arts", Levels = { "Struggling Artist", "Exhibiting Artist", "Gallery Artist", "Renowned Artist", "Master Artist" } },
	RealEstate = { Icon = "🏘️", Salary = 50000, Category = "Business", Levels = { "Estate Agent", "Property Investor", "Property Developer", "Property Mogul", "Real Estate Tycoon" } },
	Tradesperson = { Icon = "🔧", Salary = 32000, Category = "Trades", Levels = { "Apprentice", "Electrician", "Senior Electrician", "Contractor", "Firm Owner" } },
	ShopAssistant = { Icon = "🛒", Salary = 22000, Category = "Retail", Levels = { "Shop Assistant", "Supervisor", "Assistant Manager", "Store Manager", "Area Manager" } },
	-- Special careers
	Astronaut = { Icon = "🚀", Salary = 120000, Category = "Special", Special = true, Levels = { "Astronaut Candidate", "Astronaut", "Mission Specialist", "Mission Commander", "Space Legend" } },
	ProGamer = { Icon = "🎮", Salary = 40000, Category = "Special", Special = true, Levels = { "Amateur Pro", "Pro Gamer", "Team Captain", "World Champion", "Esports Legend" } },
}

-- Education levels, lowest to highest.
Careers.Education = { "None", "School", "University", "Masters" }
Careers.EducationRank = { None = 0, School = 1, University = 2, Masters = 3 }
Careers.EducationNames = { None = "None", School = "School Graduate", University = "University Degree", Masters = "Master's Degree" }

function Careers.IsValid(id: any): boolean
	return type(id) == "string" and (id == "None" or Careers.Info[id] ~= nil)
end

function Careers.SalaryAt(id: string, level: number): number
	local info = Careers.Info[id]
	if not info then
		return 0
	end
	return math.floor(info.Salary * (1 + 0.3 * (math.clamp(level, 1, Careers.MaxLevel) - 1)))
end

function Careers.TitleAt(id: string, level: number): string
	local info = Careers.Info[id]
	if not info then
		return "Unemployed"
	end
	return info.Levels[math.clamp(level, 1, Careers.MaxLevel)]
end

return Careers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">DataTemplate</string>
            <string name="Source"><![CDATA[--[[
	DataTemplate  (ReplicatedStorage.Shared.Data.DataTemplate)
	The saved-data schema, new-life factory and version migrations.

	Shape of a saved profile (all keys are strings so it is DataStore-safe):

	Profile
	├─ Version            schema version, see DataTemplate.CurrentVersion
	├─ Coins              meta currency spent in the shop (persists across lives)
	├─ ActiveSlot         "Slot1" | "Slot2" | "Slot3"
	├─ Slots              { Slot1 = Life | false, ... }  (false = empty slot)
	├─ LifeHistory        array of completed-life summaries (capped)
	├─ Inventory          { Owned = { [itemId] = true }, Equipped = { [category] = itemId } }
	├─ Achievements       { [achievementId] = unlockUnixTime }
	├─ Collectibles       { [collectibleId] = true }
	├─ Daily              login streak / daily reward state
	├─ Challenges         daily + weekly challenge progress
	├─ Lifetime           totals across every life (for profiles + leaderboards)
	├─ Settings           client preferences (validated on the server)
	├─ Privacy            what friends may see in comparisons
	├─ Tutorial           onboarding progress
	└─ ProcessedReceipts  recent developer-product receipt ids (duplicate guard)
]]

local Config = require(script.Parent.Parent.Config)
local StatDefinitions = require(script.Parent.StatDefinitions)
local TableUtil = require(script.Parent.Parent.Util.TableUtil)
local StatMath = require(script.Parent.Parent.Util.StatMath)
local People = require(script.Parent.Parent.Util.People)

local DataTemplate = {}

DataTemplate.CurrentVersion = 2

DataTemplate.SlotIds = {}
for i = 1, Config.SaveSlotCount do
	table.insert(DataTemplate.SlotIds, "Slot" .. i)
end

DataTemplate.DefaultSettings = {
	MusicVolume = 0.5, -- 0..1
	SfxVolume = 0.7, -- 0..1
	Graphics = "Auto", -- "Auto" | "Low" | "High"
	UIScale = 1, -- 0.75..1.25
	CameraSensitivity = 1, -- 0.2..2
	Notifications = true,
	ReduceAnimations = false,
}

DataTemplate.DefaultPrivacy = {
	ShareStats = "Friends", -- "Everyone" | "Friends" | "Nobody"
	ShareReveals = "Friends",
	ShareHistory = "Friends",
}

local profileTemplate = {
	Version = DataTemplate.CurrentVersion,
	Coins = Config.StartingCoins,
	ActiveSlot = "Slot1",
	Slots = {},
	LifeHistory = {},
	Inventory = { Owned = {}, Equipped = {} },
	Achievements = {},
	Collectibles = {},
	Daily = { LastClaimDay = 0, Streak = 0, BestStreak = 0 },
	Challenges = { DailyDay = 0, Daily = {}, WeeklyWeek = 0, Weekly = {} },
	Lifetime = {
		LivesStarted = 0,
		LivesCompleted = 0,
		DecisionsMade = 0,
		CoinsEarned = 0,
		HighestNetWorth = 0,
		RareEventsSeen = 0,
		FirstJoin = 0,
	},
	Settings = DataTemplate.DefaultSettings,
	Privacy = DataTemplate.DefaultPrivacy,
	Tutorial = { Completed = false, Step = 0 },
	ProcessedReceipts = {},
}
for _, slotId in ipairs(DataTemplate.SlotIds) do
	profileTemplate.Slots[slotId] = false
end

function DataTemplate.NewProfile()
	local profile = TableUtil.DeepCopy(profileTemplate)
	profile.Lifetime.FirstJoin = os.time()
	return profile
end

--[[
	A single life. Lives inside Profile.Slots[slotId].
	`Seed` drives this life's random events so results are reproducible for
	debugging; the server owns it and never trusts a client-supplied seed.
]]
function DataTemplate.NewLife(name: string, seed: number)
	local stats = {}
	for _, statName in ipairs(StatDefinitions.Order) do
		stats[statName] = Config.StatStart
	end
	-- Wealth is always derived from net worth (see StatMath.WealthFromNetWorth).
	stats.Wealth = StatMath.WealthFromNetWorth(Config.StartingMoney)

	local life = {
		Name = name,
		Seed = seed,
		StartedAt = os.time(),
		Age = 5,
		Stage = 1,
		ScenarioIndex = 0, -- scenarios completed in the current stage
		Stats = stats,
		Money = Config.StartingMoney,
		Assets = {}, -- { [assetId] = true } houses, cars bought in-life
		Career = { Id = "None", Level = 0, YearsInRole = 0 },
		PeakSalary = 0, -- highest yearly salary reached (sets the retirement pension)
		PeakCareerLevel = 0, -- highest career level ever reached (1–5)
		BestCareer = false, -- { Id, Level } best career ever held
		HistoryId = false, -- LifeHistory id once this life is completed
		Education = "None",
		Relationships = { Partner = false, Married = false, Children = 0, Friends = 0 },
		Traits = {}, -- { [traitId] = strength } personality built from choices
		Flags = {}, -- { [flagId] = true } story branches unlocked by decisions
		Decisions = {}, -- array of { Scenario, Choice, Age, Stage }
		Story = {}, -- array of short story lines for Life History
		Events = {}, -- array of random-event ids that happened
		Seen = {}, -- { [scenarioId] = true } scenarios already played this life
		Reveals = {}, -- array of Life Reveal snapshots per stage
		CurrentScenario = false, -- the scenario the server is waiting on, or false
		Completed = false,
		-- Phase 4: people, lifestyle and finances
		People = {}, -- array of Person (see Shared/Util/People)
		NextPersonId = 1,
		Focus = "Balanced", -- lifestyle focus (see Shared/Data/Lifestyle)
		Investments = 0, -- invested money (grows/shrinks with the market each year)
		Loans = {}, -- array of { Kind = "Student"|"Mortgage", Balance, Rate, Payment }
		ActionTurn = -1, -- decision count when ActionsUsed was last reset
		ActionsUsed = 0, -- People/Finance actions used since the last decision
		Shared = {}, -- moments shared with other players: { Title, Icon, With = {names}, Age } (capped)
	}
	-- Everyone starts with two parents.
	local rng = Random.new(seed % 2147483646 + 1)
	People.Add(life, "Parent", rng)
	People.Add(life, "Parent", rng)
	return life
end

--[[
	Migrations: Migrations[n] upgrades a profile from version n to n + 1.
	Add a new function whenever CurrentVersion is bumped; never edit old ones.
]]
DataTemplate.Migrations = {
	-- v1 → v2: lives gained named People, Focus, Investments and Loans.
	-- Build People from the old counters so existing partners/children keep existing.
	[1] = function(profile)
		for _, life in pairs(profile.Slots or {}) do
			if type(life) == "table" and life.People == nil then
				local rel = life.Relationships or { Partner = false, Married = false, Children = 0, Friends = 0 }
				local counts = { Partner = rel.Partner, Married = rel.Married, Children = rel.Children or 0, Friends = rel.Friends or 0 }
				life.Relationships = rel
				life.People = {}
				life.NextPersonId = 1
				life.Age = life.Age or 30
				life.Name = life.Name or "You"
				local rng = Random.new(((life.Seed or 1) % 2147483646) + 1)
				People.Add(life, "Parent", rng)
				People.Add(life, "Parent", rng)
				if counts.Partner then
					local partner = People.Add(life, "Partner", rng)
					partner.Married = counts.Married == true
				end
				for _ = 1, math.min(counts.Children, 12) do
					local child = People.Add(life, "Child", rng)
					child.BornAge = math.max(0, life.Age - 5)
				end
				for _ = 1, math.min(counts.Friends, People.MaxFriends) do
					People.Add(life, "Friend", rng)
				end
				People.Sync(life)
			end
		end
	end,
}

--[[
	Brings any loaded profile up to date:
	  1. run migrations from its version to CurrentVersion
	  2. fill any keys added to the template since it was saved
	Returns the profile (mutated in place) or nil + reason if unusable.
]]
function DataTemplate.Upgrade(profile: any)
	if type(profile) ~= "table" then
		return nil, "profile is not a table"
	end
	local version = tonumber(profile.Version) or 1
	if version > DataTemplate.CurrentVersion then
		-- Saved by a newer server build. Refuse rather than corrupt it.
		return nil, ("profile version %d is newer than server version %d"):format(version, DataTemplate.CurrentVersion)
	end
	while version < DataTemplate.CurrentVersion do
		local migrate = DataTemplate.Migrations[version]
		if not migrate then
			return nil, "missing migration for version " .. version
		end
		migrate(profile)
		version += 1
		profile.Version = version
	end
	TableUtil.Reconcile(profile, profileTemplate)

	-- Reconcile active lives too, so lives saved before new fields existed keep working.
	local lifeTemplate = DataTemplate.NewLife("", 0)
	for _, slotId in ipairs(DataTemplate.SlotIds) do
		local life = profile.Slots[slotId]
		if type(life) == "table" then
			TableUtil.Reconcile(life, lifeTemplate)
		elseif life ~= false then
			profile.Slots[slotId] = false
		end
	end
	if profile.Slots[profile.ActiveSlot] == nil then
		profile.ActiveSlot = DataTemplate.SlotIds[1]
	end
	return profile
end

return DataTemplate
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">LifeStages</string>
            <string name="Source"><![CDATA[--[[
	LifeStages  (ReplicatedStorage.Shared.Data.LifeStages)
	The six major life stages. A stage ends with a Life Reveal (Phase 5).
	ScenariosPerStage is how many decisions a player makes before the stage's reveal.
]]

local LifeStages = {}

LifeStages.List = {
	{ Id = 1, Key = "Childhood", DisplayName = "Childhood", MinAge = 5, MaxAge = 12, ScenariosPerStage = 6, Color = Color3.fromRGB(255, 196, 87) },
	{ Id = 2, Key = "Teen", DisplayName = "Teenage Years", MinAge = 13, MaxAge = 18, ScenariosPerStage = 7, Color = Color3.fromRGB(255, 120, 170) },
	{ Id = 3, Key = "YoungAdult", DisplayName = "Young Adulthood", MinAge = 19, MaxAge = 25, ScenariosPerStage = 7, Color = Color3.fromRGB(110, 170, 255) },
	{ Id = 4, Key = "Adult", DisplayName = "Adulthood", MinAge = 26, MaxAge = 40, ScenariosPerStage = 7, Color = Color3.fromRGB(90, 210, 150) },
	{ Id = 5, Key = "MiddleAge", DisplayName = "Middle Age", MinAge = 41, MaxAge = 60, ScenariosPerStage = 6, Color = Color3.fromRGB(190, 130, 255) },
	{ Id = 6, Key = "Retirement", DisplayName = "Retirement", MinAge = 61, MaxAge = 85, ScenariosPerStage = 5, Color = Color3.fromRGB(240, 170, 110) },
}

LifeStages.Count = #LifeStages.List

function LifeStages.Get(id: number)
	return LifeStages.List[id]
end

-- Returns the stage containing `age`, clamped to the first/last stage.
function LifeStages.ForAge(age: number)
	for _, stage in ipairs(LifeStages.List) do
		if age <= stage.MaxAge then
			return stage
		end
	end
	return LifeStages.List[#LifeStages.List]
end

--[[
	Age the player should be after completing `scenarioIndex` (1-based) of `stageId`.
	Ages advance evenly across the stage so the final scenario lands on MaxAge.
]]
function LifeStages.AgeAfterScenario(stageId: number, scenarioIndex: number): number
	local stage = LifeStages.List[stageId]
	local span = stage.MaxAge - stage.MinAge
	local fraction = math.clamp(scenarioIndex / stage.ScenariosPerStage, 0, 1)
	return stage.MinAge + math.floor(span * fraction + 0.5)
end

return LifeStages
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Lifestyle</string>
            <string name="Source"><![CDATA[--[[
	Lifestyle  (ReplicatedStorage.Shared.Data.Lifestyle)
	The player's lifestyle focus: what they prioritise as the years pass.
	Chosen any time from the HUD (🎯). Applied by the server every simulated
	year (Lib/Yearly); shared so the client can describe each option.

	PerYear: stat changes per year. BondDecay: change to yearly bond decay
	(negative = bonds grow). SavingsBonus adds to the savings rate.
	PromotionMultiplier scales the automatic promotion chance.
	Under 19, "Career" focus means schoolwork and boosts Intelligence instead.
]]

local Lifestyle = {}

Lifestyle.Order = { "Balanced", "Career", "Family", "Health", "Social", "Money" }

Lifestyle.Info = {
	Balanced = {
		Icon = "⚖️", Title = "Balanced", Description = "A bit of everything. Steady and content.",
		PerYear = { Happiness = 0.3, Health = 0.2 },
	},
	Career = {
		Icon = "💼", Title = "Career / School", Description = "Work hard and climb faster. Relationships and health suffer a little.",
		PerYear = { Career = 1.5, Health = -0.4 }, YouthPerYear = { Intelligence = 1.2, Happiness = -0.2 },
		BondDecay = { All = 1 }, PromotionMultiplier = 1.6,
	},
	Family = {
		Icon = "🏡", Title = "Family", Description = "Put loved ones first. Family bonds grow stronger; career slows.",
		PerYear = { Happiness = 0.4, Career = -0.5 },
		BondDecay = { Partner = -3, Child = -3, Parent = -3, Sibling = -3 }, PromotionMultiplier = 0.7,
	},
	Health = {
		Icon = "💪", Title = "Health", Description = "Exercise, sleep, eat well. Health improves every year.",
		PerYear = { Health = 1.5, Happiness = 0.2 },
	},
	Social = {
		Icon = "🎉", Title = "Social Life", Description = "Friends, parties, networking. Friendships and popularity grow.",
		PerYear = { Popularity = 1, Happiness = 0.3, Intelligence = -0.2 },
		BondDecay = { Friend = -4, BestFriend = -4 },
	},
	Money = {
		Icon = "💰", Title = "Save Money", Description = "Live frugally and save much more. Life is a bit less fun.",
		PerYear = { Happiness = -0.4 }, SavingsBonus = 0.08, MinAge = 16,
	},
}

function Lifestyle.IsValid(id: any): boolean
	return type(id) == "string" and Lifestyle.Info[id] ~= nil
end

function Lifestyle.Available(id: string, age: number): boolean
	local info = Lifestyle.Info[id]
	return info ~= nil and age >= (info.MinAge or 0)
end

return Lifestyle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">NamePool</string>
            <string name="Source"><![CDATA[--[[
	NamePool  (ReplicatedStorage.Shared.Data.NamePool)
	Pre-approved names for the "Randomise" button on the new-life screen.
	(Typed names are still run through Roblox text filtering on the server.)
]]

return {
	"Alex", "Sam", "Jordan", "Riley", "Taylor", "Morgan", "Casey", "Jamie", "Avery", "Quinn",
	"Charlie", "Robin", "Skyler", "Rowan", "Harper", "Elliot", "Reese", "Emerson", "Finley", "Hayden",
	"Amara", "Leo", "Maya", "Noah", "Zara", "Kai", "Isla", "Omar", "Priya", "Mateo",
	"Aisha", "Theo", "Lina", "Ezra", "Nia", "Ravi", "Sofia", "Jin", "Freya", "Malik",
	"Ivy", "Arlo", "Yara", "Felix", "Mila", "Hugo", "Layla", "Oscar", "Esme", "Tariq",
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">SoundIds</string>
            <string name="Source"><![CDATA[--[[
	SoundIds  (ReplicatedStorage.Shared.Data.SoundIds)
	Audio asset ids used by AudioController. Fill these in with sounds from the
	Creator Store (Toolbox → Audio) that you have permission to use, e.g.
	Click = "rbxassetid://1234567890". Empty entries are skipped silently, so the
	game runs fine before audio is added.
]]

return {
	-- UI
	Click = "",
	Select = "",
	Confirm = "",
	Locked = "",
	Positive = "",
	Negative = "",
	AgeUp = "",
	StageComplete = "",
	Notify = "",
	-- Music (looped)
	MenuMusic = "",
	GameMusic = "",
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">StatDefinitions</string>
            <string name="Source"><![CDATA[--[[
	StatDefinitions  (ReplicatedStorage.Shared.Data.StatDefinitions)
	The eight life statistics. Order here is the display order in the UI.
	Every stat is a number clamped to [Config.StatMin, Config.StatMax].
]]

local StatDefinitions = {}

StatDefinitions.Order = {
	"Happiness",
	"Wealth",
	"Intelligence",
	"Health",
	"Popularity",
	"Relationships",
	"Reputation",
	"Career",
}

StatDefinitions.Info = {
	Happiness = { DisplayName = "Happiness", Icon = "😊", Color = Color3.fromRGB(255, 200, 60), Description = "How content you feel with your life." },
	Wealth = { DisplayName = "Wealth", Icon = "💰", Color = Color3.fromRGB(80, 200, 120), Description = "Your financial security and assets." },
	Intelligence = { DisplayName = "Intelligence", Icon = "🧠", Color = Color3.fromRGB(90, 150, 255), Description = "Knowledge, skills and education." },
	Health = { DisplayName = "Health", Icon = "❤️", Color = Color3.fromRGB(240, 80, 90), Description = "Physical and mental wellbeing." },
	Popularity = { DisplayName = "Popularity", Icon = "⭐", Color = Color3.fromRGB(255, 120, 200), Description = "How well-known and liked you are." },
	Relationships = { DisplayName = "Relationships", Icon = "🤝", Color = Color3.fromRGB(255, 150, 90), Description = "The strength of your bonds with others." },
	Reputation = { DisplayName = "Reputation", Icon = "🏅", Color = Color3.fromRGB(170, 120, 255), Description = "How trustworthy and respected you are." },
	Career = { DisplayName = "Career Success", Icon = "💼", Color = Color3.fromRGB(70, 200, 220), Description = "How far you've progressed professionally." },
}

local valid = {}
for _, name in ipairs(StatDefinitions.Order) do
	valid[name] = true
end

function StatDefinitions.IsValid(name: any): boolean
	return type(name) == "string" and valid[name] == true
end

return StatDefinitions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Traits</string>
            <string name="Source"><![CDATA[--[[
	Traits  (ReplicatedStorage.Shared.Data.Traits)
	Personality traits are built up by choices (life.Traits[id] = strength 1..MaxStrength).
	Each point of strength boosts (or reduces) future GAINS in the listed stats,
	so who you became early in life shapes how later choices pay off.
	Shared so the client can display them; the server alone applies them.
]]

local Traits = {}

Traits.MaxStrength = 5

Traits.Info = {
	Social = { DisplayName = "Social", Icon = "🗣️", Description = "Makes friends easily.", Bonus = { Popularity = 0.05, Relationships = 0.05 } },
	Studious = { DisplayName = "Studious", Icon = "📚", Description = "Loves to learn.", Bonus = { Intelligence = 0.06 } },
	Shy = { DisplayName = "Shy", Icon = "🙈", Description = "Thoughtful, but quiet in crowds.", Bonus = { Popularity = -0.05, Intelligence = 0.03 } },
	Playful = { DisplayName = "Playful", Icon = "🎮", Description = "Finds fun in everything.", Bonus = { Happiness = 0.05 } },
	Creative = { DisplayName = "Creative", Icon = "🎨", Description = "Full of ideas.", Bonus = { Happiness = 0.03, Intelligence = 0.03 } },
	Athletic = { DisplayName = "Athletic", Icon = "🏃", Description = "Strong and energetic.", Bonus = { Health = 0.06 } },
	Kind = { DisplayName = "Kind", Icon = "💛", Description = "Looks out for others.", Bonus = { Reputation = 0.05, Relationships = 0.04 } },
	Rebellious = { DisplayName = "Rebellious", Icon = "😈", Description = "Rules are made to be broken.", Bonus = { Popularity = 0.04, Reputation = -0.05 } },
	Thrifty = { DisplayName = "Thrifty", Icon = "🐷", Description = "Careful with money.", Bonus = { Wealth = 0.06 } },
	Ambitious = { DisplayName = "Ambitious", Icon = "🚀", Description = "Always aiming higher.", Bonus = { Career = 0.06, Wealth = 0.03 } },
	Adventurous = { DisplayName = "Adventurous", Icon = "🧭", Description = "Seeks new experiences.", Bonus = { Happiness = 0.04 } },
	Charismatic = { DisplayName = "Charismatic", Icon = "✨", Description = "Lights up a room.", Bonus = { Popularity = 0.06 } },
	Brave = { DisplayName = "Brave", Icon = "🦁", Description = "Faces fears head-on.", Bonus = { Reputation = 0.04, Health = 0.02 } },
}

function Traits.IsValid(id: any): boolean
	return type(id) == "string" and Traits.Info[id] ~= nil
end

--[[
	Gain multipliers for a life's traits: { Stat = multiplier }.
	multiplier = 1 + Σ(bonus × strength), clamped to [0.6, 1.5].
]]
function Traits.GainMultipliers(lifeTraits: { [string]: number }): { [string]: number }
	local totals = {}
	for id, strength in pairs(lifeTraits) do
		local info = Traits.Info[id]
		if info then
			for stat, bonus in pairs(info.Bonus) do
				totals[stat] = (totals[stat] or 0) + bonus * math.min(strength, Traits.MaxStrength)
			end
		end
	end
	local result = {}
	for stat, total in pairs(totals) do
		result[stat] = math.clamp(1 + total, 0.6, 1.5)
	end
	return result
end

return Traits
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[--[[
	Net  (ReplicatedStorage.Shared.Net)  — ModuleScript with children
	  RemoteDefinitions

	Server:  Net.Init()  creates ReplicatedStorage.Remotes from RemoteDefinitions.
	         Net.Handle(name, fn)       binds a RemoteFunction (rate-limited, pcall-wrapped)
	         Net.Listen(name, fn)       binds a client->server RemoteEvent (same protections)
	         Net.Fire(name, player, ...) / Net.FireAll(name, ...)
	Client:  Net.Invoke(name, ...)  -> ok, result
	         Net.OnEvent(name, fn)

	Handler convention: every RemoteFunction handler returns `true, payload` on
	success or `false, reasonString` on rejection, so the client always checks
	the first value. Net itself returns `false, "RateLimited" / "ServerError" /
	"NetworkError"` using the same convention.

	Security model: the client may *ask*; the server validates every argument,
	applies rate limits and decides. Handlers never receive a trusted value from
	the client except the Player object Roblox supplies.
]]

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(script.Parent.Config)
local Definitions = require(script.RemoteDefinitions)

local IS_SERVER = RunService:IsServer()
local FOLDER_NAME = "Remotes"

local Net = {}
Net.Definitions = Definitions

local folder: Folder? = nil
local remotes: { [string]: Instance } = {}

-- ===== Rate limiting (server only) =====
-- buckets[player][remoteName] = { tokens, last }
local buckets: { [Player]: { [string]: { tokens: number, last: number } } } = {}

local function allow(player: Player, name: string, limit): boolean
	limit = limit or Config.DefaultRateLimit
	local perPlayer = buckets[player]
	if not perPlayer then
		perPlayer = {}
		buckets[player] = perPlayer
	end
	local now = os.clock()
	local bucket = perPlayer[name]
	if not bucket then
		bucket = { tokens = limit.Burst, last = now }
		perPlayer[name] = bucket
	end
	bucket.tokens = math.min(limit.Burst, bucket.tokens + (now - bucket.last) * limit.Rate)
	bucket.last = now
	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

local function getRemote(name: string): Instance
	local remote = remotes[name]
	if remote then
		return remote
	end
	assert(not IS_SERVER, "Net: unknown remote '" .. name .. "' (add it to RemoteDefinitions)")
	folder = folder or ReplicatedStorage:WaitForChild(FOLDER_NAME)
	remote = (folder :: Folder):WaitForChild(name, 30)
	assert(remote, "Net: timed out waiting for remote '" .. name .. "'")
	remotes[name] = remote
	return remote
end

-- ===== Server API =====
function Net.Init()
	assert(IS_SERVER, "Net.Init is server-only")
	if folder then
		return
	end
	local newFolder = Instance.new("Folder")
	newFolder.Name = FOLDER_NAME
	for name in pairs(Definitions.Events) do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = newFolder
		remotes[name] = remote
	end
	for name in pairs(Definitions.Functions) do
		local remote = Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = newFolder
		remotes[name] = remote
	end
	newFolder.Parent = ReplicatedStorage
	folder = newFolder

	game:GetService("Players").PlayerRemoving:Connect(function(player)
		buckets[player] = nil
	end)
end

-- Binds a RemoteFunction. handler(player, ...) -> result. Errors become (false, "error").
function Net.Handle(name: string, handler: (Player, ...any) -> any)
	assert(IS_SERVER, "Net.Handle is server-only")
	local definition = Definitions.Functions[name]
	assert(definition, "Net.Handle: '" .. name .. "' is not a RemoteFunction")
	local remote = getRemote(name) :: RemoteFunction
	remote.OnServerInvoke = function(player, ...)
		if not allow(player, name, definition.RateLimit) then
			return false, "RateLimited"
		end
		local results = table.pack(pcall(handler, player, ...))
		if not results[1] then
			warn(("[Net] %s handler error for %s: %s"):format(name, player.Name, tostring(results[2])))
			return false, "ServerError"
		end
		return table.unpack(results, 2, results.n)
	end
end

-- Binds a client->server RemoteEvent with the same protections as Handle.
function Net.Listen(name: string, handler: (Player, ...any) -> ())
	assert(IS_SERVER, "Net.Listen is server-only")
	local definition = Definitions.Events[name]
	assert(definition, "Net.Listen: '" .. name .. "' is not a RemoteEvent")
	local remote = getRemote(name) :: RemoteEvent
	remote.OnServerEvent:Connect(function(player, ...)
		if not allow(player, name, definition.RateLimit) then
			return
		end
		local ok, err = pcall(handler, player, ...)
		if not ok then
			warn(("[Net] %s listener error for %s: %s"):format(name, player.Name, tostring(err)))
		end
	end)
end

function Net.Fire(name: string, player: Player, ...)
	assert(IS_SERVER, "Net.Fire is server-only");
	(getRemote(name) :: RemoteEvent):FireClient(player, ...)
end

function Net.FireAll(name: string, ...)
	assert(IS_SERVER, "Net.FireAll is server-only");
	(getRemote(name) :: RemoteEvent):FireAllClients(...)
end

-- ===== Client API =====
-- Returns ok, ...results. ok is false if the server rejected or errored.
function Net.Invoke(name: string, ...)
	assert(not IS_SERVER, "Net.Invoke is client-only")
	local remote = getRemote(name) :: RemoteFunction
	local results = table.pack(pcall(remote.InvokeServer, remote, ...))
	if not results[1] then
		return false, "NetworkError"
	end
	return table.unpack(results, 2, results.n)
end

function Net.OnEvent(name: string, handler: (...any) -> ())
	assert(not IS_SERVER, "Net.OnEvent is client-only")
	return (getRemote(name) :: RemoteEvent).OnClientEvent:Connect(handler)
end

-- Client->server fire (only for events declared with a RateLimit).
function Net.Send(name: string, ...)
	assert(not IS_SERVER, "Net.Send is client-only");
	(getRemote(name) :: RemoteEvent):FireServer(...)
end

-- Exposed for unit tests.
Net._allow = allow

return Net
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">RemoteDefinitions</string>
            <string name="Source"><![CDATA[--[[
	RemoteDefinitions  (ReplicatedStorage.Shared.Net.RemoteDefinitions)
	Single source of truth for every remote in the game. The server creates
	them at startup inside ReplicatedStorage.Remotes; the client only waits for them.

	Direction legend:
	  C->S  client requests something from the server (always validated server-side)
	  S->C  server pushes state to the client
	RateLimit is { Rate = requests/second, Burst = max stored tokens } for C->S remotes.
]]

return {
	Events = {
		-- Data replication (S->C): full sanitized snapshot of the player's own profile.
		DataSnapshot = {},
		-- Notifications / toasts (S->C): { Title, Text, Kind }
		Notify = {},
		-- Generic gameplay signals (S->C) other systems push, e.g. "LifeReveal", "StageChanged".
		GameEvent = {},

		-- ===== Life Circles (PartyService), all S->C =====
		PartyUpdate = {}, -- circle state, or false when not in a circle
		PartyInviteReceived = {}, -- { InviteId, FromUserId, FromName, Seconds }
		GroupEvent = {}, -- a group decision to vote on
		GroupVote = {}, -- live vote tally
		GroupEventResult = {}, -- what the group chose and what it meant for YOUR life
		GroupReveal = {}, -- a group Life Reveal session
		-- ===== City events (CityEventService), S->C =====
		CityEvent = {}, -- a server-wide invitation
		CityEventSummary = {}, -- how many people joined
	},

	Functions = {
		-- C->S: returns the caller's snapshot once their data has loaded.
		GetData = { RateLimit = { Rate = 1, Burst = 3 } },
		-- C->S: save client preferences. Args: settingsTable
		UpdateSettings = { RateLimit = { Rate = 2, Burst = 4 } },
		-- C->S: change who may see your stats/reveals/history. Args: privacyTable
		UpdatePrivacy = { RateLimit = { Rate = 2, Burst = 4 } },

		-- ===== Life (LifeService) =====
		-- C->S: (slotId, name, overwrite) start a new life in a save slot.
		StartNewLife = { RateLimit = { Rate = 0.5, Burst = 2 } },
		-- C->S: (slotId) make an existing life the active one.
		ContinueLife = { RateLimit = { Rate = 1, Burst = 3 } },
		-- C->S: (slotId) permanently clear a save slot.
		DeleteLife = { RateLimit = { Rate = 0.5, Burst = 2 } },
		-- C->S: () -> scenario payload for the active life (same scenario until answered).
		GetScenario = { RateLimit = { Rate = 2, Burst = 4 } },
		-- C->S: (scenarioId, choiceId) -> outcome. The server computes every consequence.
		MakeChoice = { RateLimit = { Rate = 2, Burst = 3 } },

		-- ===== People, lifestyle & money (LifeService → Lib/Actions) =====
		-- C->S: (personId, "Time"|"Gift"|"Talk")
		Interact = { RateLimit = { Rate = 3, Burst = 5 } },
		-- C->S: ("Friend"|"Love") try to meet someone new
		MeetPeople = { RateLimit = { Rate = 2, Burst = 4 } },
		-- C->S: (focusId) lifestyle focus
		SetFocus = { RateLimit = { Rate = 2, Burst = 4 } },
		-- C->S: (amount) move cash into / out of investments
		Invest = { RateLimit = { Rate = 3, Burst = 5 } },
		Withdraw = { RateLimit = { Rate = 3, Burst = 5 } },
		-- C->S: (loanIndex, amount) pay a loan down early
		RepayLoan = { RateLimit = { Rate = 3, Burst = 5 } },

		-- ===== Life Reveal (RevealService) =====
		-- C->S: () -> cards for every player in the server (privacy-filtered)
		GetLifeCards = { RateLimit = { Rate = 1, Burst = 3 } },

		-- ===== Life Circles (PartyService) =====
		PartyInvite = { RateLimit = { Rate = 1, Burst = 4 } }, -- (targetUserId)
		PartyRespond = { RateLimit = { Rate = 2, Burst = 4 } }, -- (inviteId, accept)
		PartyLeave = { RateLimit = { Rate = 1, Burst = 3 } },
		PartyKick = { RateLimit = { Rate = 1, Burst = 3 } }, -- (userId)
		PartyStartEvent = { RateLimit = { Rate = 0.5, Burst = 2 } },
		PartyVote = { RateLimit = { Rate = 3, Burst = 6 } }, -- (eventId, choiceId)
		PartyStartReveal = { RateLimit = { Rate = 0.5, Burst = 2 } },
		GetPartyState = { RateLimit = { Rate = 1, Burst = 3 } },
		JoinFriendServer = { RateLimit = { Rate = 0.2, Burst = 2 } }, -- (placeId, jobId)
		-- ===== City events (CityEventService) =====
		CityEventRespond = { RateLimit = { Rate = 1, Burst = 3 } }, -- (eventId, join)
	},
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="15">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Budget</string>
            <string name="Source"><![CDATA[--[[
	Budget  (ReplicatedStorage.Shared.Util.Budget)
	One year of a life's money, broken down line by line. Pure and shared:
	the server uses it to advance years (Lib/Yearly); the client shows the
	same numbers in the Money panel, so what you see is what happens.
]]

local Careers = require(script.Parent.Parent.Data.Careers)
local Assets = require(script.Parent.Parent.Data.Assets)
local Lifestyle = require(script.Parent.Parent.Data.Lifestyle)

local Budget = {}

Budget.BaseSavingsRate = 0.15
Budget.ThriftyBonus = 0.03 -- per Thrifty trait strength
Budget.PartTimeIncome = 2500
Budget.UnemployedCost = 6000
Budget.ChildCost = 3500 -- per child under 18
Budget.RentCost = 4000 -- adults without a home of their own
Budget.PensionShare = 0.4 -- of peak salary

function Budget.OwnsHome(life): boolean
	return life.Assets.Apartment or life.Assets.House or life.Assets.Mansion or false
end

function Budget.ChildrenUnder18(life): number
	local count = 0
	for _, person in ipairs(life.People or {}) do
		if person.Role == "Child" and life.Age - person.BornAge < 18 then
			count += 1
		end
	end
	return count
end

function Budget.SavingsRate(life): number
	local focus = Lifestyle.Info[life.Focus or "Balanced"]
	return Budget.BaseSavingsRate + Budget.ThriftyBonus * math.min(life.Traits.Thrifty or 0, 5) + ((focus and focus.SavingsBonus) or 0)
end

function Budget.TotalDebt(life): number
	local total = 0
	for _, loan in ipairs(life.Loans or {}) do
		total += loan.Balance
	end
	return total
end

function Budget.NetWorth(life): number
	return life.Money + (life.Investments or 0) + Assets.TotalValue(life.Assets) - Budget.TotalDebt(life)
end

--[[
	Returns the year's lines (positive = money in, negative = out) and Net.
	Loan payments are listed separately because Yearly pays them from cash.
]]
function Budget.Breakdown(life, age: number?)
	age = age or life.Age
	local lines = {}
	local rate = Budget.SavingsRate(life)
	local salary = 0
	if life.Flags.Retired then
		salary = (life.PeakSalary or 0) * Budget.PensionShare
		lines.Pension = math.floor(salary * rate)
	elseif life.Career.Id ~= "None" then
		salary = Careers.SalaryAt(life.Career.Id, life.Career.Level)
		lines.Salary = math.floor(salary * rate)
	elseif (age :: number) >= 19 then
		lines.Unemployed = -Budget.UnemployedCost
	end
	if (age :: number) < 19 and life.Flags.PartTimeJob then
		lines.PartTime = Budget.PartTimeIncome
	end
	if (age :: number) >= 19 and not Budget.OwnsHome(life) then
		lines.Rent = -Budget.RentCost
	end
	local kids = Budget.ChildrenUnder18(life)
	if kids > 0 then
		lines.Children = -Budget.ChildCost * kids
	end
	local loanPayments = 0
	for _, loan in ipairs(life.Loans or {}) do
		loanPayments += math.min(loan.Payment, math.ceil(loan.Balance * (1 + loan.Rate)))
	end
	if loanPayments > 0 then
		lines.Loans = -loanPayments
	end
	local net = 0
	for _, amount in pairs(lines) do
		net += amount
	end
	return { Lines = lines, Net = net, GrossSalary = salary, SavingsRate = rate }
end

-- Fixed yearly repayment for a loan (standard amortisation).
function Budget.LoanPayment(amount: number, rate: number, years: number): number
	if rate <= 0 then
		return math.ceil(amount / years)
	end
	return math.ceil(amount * rate / (1 - (1 + rate) ^ -years))
end

return Budget
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Endings</string>
            <string name="Source"><![CDATA[--[[
	Endings  (ReplicatedStorage.Shared.Util.Endings)
	Every finished life earns an ending title, decided from what actually
	happened (flags, career, money, family, stats, and how its predictions
	changed). The first matching ending in the list wins, so rarer endings
	come first. Shared so the client can show the list in Life History.
]]

local Budget = require(script.Parent.Budget)
local Futures = require(script.Parent.Futures)
local StatMath = require(script.Parent.StatMath)
local Careers = require(script.Parent.Parent.Data.Careers)

local Endings = {}

local function best(life)
	return life.BestCareer or { Id = "None", Level = 0 }
end

local function flag(life, ...)
	for _, f in ipairs({ ... }) do
		if life.Flags[f] then
			return true
		end
	end
	return false
end

local function everStruggled(life): boolean
	for _, reveal in ipairs(life.Reveals or {}) do
		if reveal.Predictions and (reveal.Predictions.Struggling or 0) >= 50 then
			return true
		end
	end
	return false
end

-- { Id, Title, Icon, Line, Coins, Check(life, ctx) }  ctx = { NetWorth, Outcomes, Overall }
Endings.List = {
	{ Id = "SpaceExplorer", Title = "The Space Explorer", Icon = "🚀", Coins = 60, Line = "{name} looked back at Earth from the stars.",
		Check = function(life)
			return flag(life, "Astronaut")
		end },
	{ Id = "NobelMind", Title = "The Nobel Mind", Icon = "🏆", Coins = 60, Line = "{name}'s discovery changed how the world understands itself.",
		Check = function(life)
			return flag(life, "NobelPrize")
		end },
	{ Id = "Billionaire", Title = "The Billionaire", Icon = "💎", Coins = 60, Line = "{name} built a fortune most people can't imagine.",
		Check = function(_, ctx)
			return ctx.NetWorth >= 1e9
		end },
	{ Id = "LuckyOne", Title = "The Lucky One", Icon = "🎰", Coins = 40, Line = "One ticket. Every number. {name}'s life was never the same.",
		Check = function(life)
			return flag(life, "LotteryWinner")
		end },
	{ Id = "Tycoon", Title = "The Tycoon", Icon = "🏙️", Coins = 50, Line = "{name} built an empire from a single idea.",
		Check = function(life)
			local b = best(life)
			return flag(life, "Tycoon") or ((b.Id == "Entrepreneur" or b.Id == "BusinessOwner" or b.Id == "RealEstate") and b.Level >= 5)
		end },
	{ Id = "SportingLegend", Title = "The Sporting Legend", Icon = "🏅", Coins = 50, Line = "Crowds still chant {name}'s name.",
		Check = function(life)
			local b = best(life)
			return flag(life, "Champion", "WorldChampion") or ((b.Id == "Athlete" or b.Id == "ProGamer") and b.Level >= 5)
		end },
	{ Id = "Celebrity", Title = "The Celebrity", Icon = "🌟", Coins = 45, Line = "Everyone knew {name}'s name, and many knew their songs, films or videos by heart.",
		Check = function(life)
			return flag(life, "Celebrity") and life.Stats.Popularity >= 75
		end },
	{ Id = "MultiMillionaire", Title = "The Multi-Millionaire", Icon = "💰", Coins = 45, Line = "{name} turned smart choices into serious wealth.",
		Check = function(_, ctx)
			return ctx.NetWorth >= 5e6
		end },
	{ Id = "FamilyLegend", Title = "The Family Legend", Icon = "👨‍👩‍👧‍👦", Coins = 45, Line = "{name}'s family will tell their stories for generations.",
		Check = function(life, ctx)
			return ctx.Outcomes.Family and life.Relationships.Children >= 2
		end },
	{ Id = "Philanthropist", Title = "The Philanthropist", Icon = "🎁", Coins = 45, Line = "{name} gave more than they ever took.",
		Check = function(life)
			return flag(life, "Foundation") or (flag(life, "Philanthropist") and life.Stats.Reputation >= 75)
		end },
	{ Id = "Genius", Title = "The Genius", Icon = "🧠", Coins = 40, Line = "{name}'s mind was a universe of its own.",
		Check = function(life)
			return life.Stats.Intelligence >= 82
		end },
	{ Id = "Healer", Title = "The Healer", Icon = "🩺", Coins = 40, Line = "Thousands of people are alive because of {name}.",
		Check = function(life)
			local b = best(life)
			return b.Id == "Doctor" and b.Level >= 4
		end },
	{ Id = "Adventurer", Title = "The Adventurer", Icon = "🧭", Coins = 35, Line = "{name} saw more of the world than most people dream of.",
		Check = function(life)
			return flag(life, "Sailor", "Nomad") or ((life.Traits.Adventurous or 0) >= 3 and flag(life, "LivedAbroad", "Traveller"))
		end },
	{ Id = "SelfMadeMillionaire", Title = "The Self-Made Millionaire", Icon = "💵", Coins = 40, Line = "No degree, no head start. Just {name}, and a lot of good decisions.",
		Check = function(life, ctx)
			return ctx.NetWorth >= 1e6 and (Careers.EducationRank[life.Education] or 0) < 2
		end },
	{ Id = "Millionaire", Title = "The Millionaire", Icon = "💰", Coins = 35, Line = "{name} built a seven-figure life.",
		Check = function(_, ctx)
			return ctx.NetWorth >= 1e6
		end },
	{ Id = "ComebackKid", Title = "The Comeback Kid", Icon = "🔥", Coins = 40, Line = "Everyone thought {name}'s story was heading for hard times. They wrote a different ending.",
		Check = function(life, ctx)
			return everStruggled(life) and not ctx.Outcomes.Struggling and ctx.Overall >= 58
		end },
	{ Id = "SelfMadeSuccess", Title = "The Self-Made Success", Icon = "💼", Coins = 40, Line = "No degree, no shortcuts. {name} climbed all the way to the top of their field.",
		Check = function(life, ctx)
			return ctx.Outcomes.Career and (Careers.EducationRank[life.Education] or 0) < 2
		end },
	{ Id = "HighFlyer", Title = "The High Flyer", Icon = "🛫", Coins = 35, Line = "{name} rose to the very top of their profession.",
		Check = function(_, ctx)
			return ctx.Outcomes.Career
		end },
	{ Id = "Beloved", Title = "The Beloved", Icon = "💞", Coins = 35, Line = "{name} was surrounded by love until the very end.",
		Check = function(life)
			return life.Stats.Relationships >= 70 and life.Stats.Happiness >= 70
		end },
	{ Id = "FreeSpirit", Title = "The Free Spirit", Icon = "🕊️", Coins = 30, Line = "{name} lived by their own rules, and loved every minute.",
		Check = function(life, ctx)
			return flag(life, "HappilySingle", "Nomad") and ctx.Outcomes.Content
		end },
	{ Id = "UnknownLegend", Title = "The Unknown Legend", Icon = "✨", Coins = 35, Line = "No headlines, no statues, just a truly great life, quietly lived.",
		Check = function(_, ctx)
			return ctx.Overall >= 66
		end },
	{ Id = "UnluckyOne", Title = "The Unlucky One", Icon = "🌧️", Coins = 25, Line = "Life threw everything at {name}. They kept getting back up.",
		Check = function(life, ctx)
			return ctx.Outcomes.Struggling and flag(life, "LostFortune", "LaidOff", "BurnedInvestor", "Divorced", "FailedStartup")
		end },
	{ Id = "Survivor", Title = "The Survivor", Icon = "🌱", Coins = 25, Line = "It wasn't easy. But {name} made it through, on their own terms.",
		Check = function(_, ctx)
			return ctx.Outcomes.Struggling
		end },
	{ Id = "QuietLife", Title = "The Quiet Life", Icon = "🏡", Coins = 30, Line = "{name} found happiness in the small, everyday things.",
		Check = function()
			return true
		end },
}

Endings.ById = {}
for _, ending in ipairs(Endings.List) do
	Endings.ById[ending.Id] = ending
end

function Endings.Context(life)
	return {
		NetWorth = Budget.NetWorth(life),
		Outcomes = Futures.Evaluate(life),
		Overall = StatMath.Overall(life.Stats),
	}
end

function Endings.Determine(life)
	local ctx = Endings.Context(life)
	for _, ending in ipairs(Endings.List) do
		if ending.Check(life, ctx) then
			return ending, ctx
		end
	end
	return Endings.List[#Endings.List], ctx
end

return Endings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Format</string>
            <string name="Source"><![CDATA[--[[
	Format  (ReplicatedStorage.Shared.Util.Format)
	Display formatting for numbers and money. Pure functions.
]]

local Format = {}

-- 1234567 -> "1,234,567"
function Format.Commas(n: number): string
	local negative = n < 0
	local s = tostring(math.floor(math.abs(n) + 0.5))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return (if negative then "-" else "") .. out
end

-- Money: "$950", "$12,500", "$1.25M", "$3.4B"
function Format.Money(n: number): string
	local sign = if n < 0 then "-" else ""
	local a = math.abs(n)
	if a >= 1e9 then
		return ("%s$%.2fB"):format(sign, a / 1e9)
	elseif a >= 1e6 then
		return ("%s$%.2fM"):format(sign, a / 1e6)
	end
	return sign .. "$" .. Format.Commas(a)
end

-- Signed delta with one decimal place, dropping ".0": "+3", "-1.5"
function Format.Signed(n: number): string
	local rounded = math.floor(math.abs(n) * 10 + 0.5) / 10
	local text = if rounded % 1 == 0 then tostring(math.floor(rounded)) else ("%.1f"):format(rounded)
	return (if n < 0 then "-" else "+") .. text
end

return Format
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Futures</string>
            <string name="Source"><![CDATA[--[[
	Futures  (ReplicatedStorage.Shared.Util.Futures)
	The prediction engine behind LIFE REVEAL.

	Futures.Predict(life) -> { [futureId] = percent 1..99 }
	  Estimates how likely each possible future is BY THE END OF THIS LIFE,
	  from the life's actual state: stats and their recent trajectory, money,
	  investments, property and debt, career and level, education, partner,
	  children and bonds, traits, flags, lifestyle focus and age.
	  Predictions sharpen as life goes on (less time left to change things).
	  Shared and pure: the server stores reveal snapshots; the client shows
	  live odds in the 🔮 Future panel using the same maths.

	Futures.Evaluate(life) -> { [futureId] = true/false }
	  What actually came true. Used by the final reveal, and by the test
	  suite to check that predictions are genuinely predictive.

	Futures.Headline(predictions) -> headline, warning?
	Futures.Archetype(predictions) -> "Luxury" | "Family" | "Fame" | ...
]]

local Budget = require(script.Parent.Budget)
local Careers = require(script.Parent.Parent.Data.Careers)
local Lifestyle = require(script.Parent.Parent.Data.Lifestyle)

local Futures = {}

Futures.FinalAge = 85

Futures.Info = {
	Millionaire = { Icon = "💰", Title = "Millionaire", Archetype = "Luxury", Positive = true, Headline = "Your decisions suggest you could become a millionaire." },
	Career = { Icon = "💼", Title = "Top of your field", Archetype = "Career", Positive = true, Headline = "You're on track for a hugely successful career." },
	Family = { Icon = "👨‍👩‍👧", Title = "Happy family", Archetype = "Family", Positive = true, Headline = "Your future suggests a warm, happy family life." },
	Fame = { Icon = "🌟", Title = "Famous", Archetype = "Fame", Positive = true, Headline = "You're on the path to becoming a famous celebrity." },
	Genius = { Icon = "🧠", Title = "Brilliant mind", Archetype = "Genius", Positive = true, Headline = "Your mind could take you to extraordinary places." },
	Healthy = { Icon = "💪", Title = "Long, healthy life", Archetype = "Health", Positive = true, Headline = "You're on course for a long and healthy life." },
	Respected = { Icon = "🏅", Title = "Widely respected", Archetype = "Hero", Positive = true, Headline = "People are going to look up to you." },
	Content = { Icon = "😊", Title = "Truly happy", Archetype = "Content", Positive = true, Headline = "Your choices point towards a genuinely happy life." },
	Adventurer = { Icon = "🧭", Title = "Adventurer", Archetype = "Adventure", Positive = true, Headline = "A life of adventure is calling you." },
	Struggling = { Icon = "🌧️", Title = "Hard times", Archetype = "Difficult", Positive = false, Headline = "Your financial decisions could put your future at risk." },
	Lonely = { Icon = "🪑", Title = "Lonely later life", Archetype = "Lonely", Positive = false, Headline = "You could end up lonely if you're not careful." },
}

-- What each future means at age 85 (tuned so each is meaningful, not a given).
Futures.Thresholds = {
	Millionaire = 1e6, -- net worth
	CareerLevel = 5, -- peak career level
	FamilyBond = 50, -- average bond with partner + children
	Fame = 80,
	Genius = 75,
	Healthy = 50,
	Respected = 78,
	Content = 85,
	StrugglingWorth = 75000,
	StrugglingHappiness = 55,
	LonelyRelationships = 45,
}

Futures.Order = { "Millionaire", "Career", "Family", "Fame", "Genius", "Healthy", "Respected", "Content", "Adventurer", "Struggling", "Lonely" }

local ADVENTURE_FLAGS = { "Traveller", "LivedAbroad", "Sailor", "Nomad", "Astronaut" }
local WILDCARD_FLAGS = { "StartupFounder", "Tycoon", "Celebrity", "BigExit", "Inventor", "AppHit", "Bestseller", "WorldChampion" }
local STAR_CAREERS = { Singer = true, Actor = true, Musician = true, Influencer = true, YouTuber = true, Athlete = true, ProGamer = true, Astronaut = true }

-- ===== What actually happened =====
local function partnerAndChildrenBond(life): number?
	local total, count = 0, 0
	for _, person in ipairs(life.People or {}) do
		if person.Role == "Partner" or person.Role == "Child" then
			total += person.Bond
			count += 1
		end
	end
	return if count > 0 then total / count else nil
end

local function anyFlag(life, flags): boolean
	for _, flag in ipairs(flags) do
		if life.Flags[flag] then
			return true
		end
	end
	return false
end

function Futures.Evaluate(life)
	local s = life.Stats
	local netWorth = Budget.NetWorth(life)
	local rel = life.Relationships
	local familyBond = partnerAndChildrenBond(life)
	local t = Futures.Thresholds
	return {
		Millionaire = netWorth >= t.Millionaire,
		Career = (life.PeakCareerLevel or 0) >= t.CareerLevel,
		Family = rel.Partner and rel.Children >= 1 and (familyBond or 0) >= t.FamilyBond,
		Fame = s.Popularity >= t.Fame or life.Flags.Celebrity == true,
		Genius = s.Intelligence >= t.Genius,
		Healthy = s.Health >= t.Healthy,
		Respected = s.Reputation >= t.Respected,
		Content = s.Happiness >= t.Content,
		Adventurer = (life.Traits.Adventurous or 0) >= 2 or anyFlag(life, ADVENTURE_FLAGS),
		Struggling = netWorth < t.StrugglingWorth or s.Happiness < t.StrugglingHappiness,
		Lonely = not rel.Partner and rel.Friends <= 1 and s.Relationships < t.LonelyRelationships,
	}
end

-- ===== Prediction helpers =====
local function logistic(x: number): number
	return 1 / (1 + math.exp(-x))
end

local function progressOf(life): number
	return math.clamp((life.Age - 5) / (Futures.FinalAge - 5), 0, 1)
end

-- Per-year stat drift since the previous reveal (dampened), or 0.
local function drift(life, stat: string): number
	local last = life.Reveals and life.Reveals[#life.Reveals]
	if not last or not last.Stats or not last.Age or last.Age >= life.Age then
		return 0
	end
	return (life.Stats[stat] - (last.Stats[stat] or life.Stats[stat])) / (life.Age - last.Age)
end

-- Health lost to ageing between now and 85 (mirrors Lib/Yearly).
local function ageingLoss(age: number): number
	local loss = 0
	for y = age, Futures.FinalAge - 1 do
		if y >= 70 then
			loss += 0.8
		elseif y >= 55 then
			loss += 0.4
		end
	end
	return loss
end

-- Projected final value of a stat: current + dampened trajectory + focus.
local function project(life, stat: string, extra: number?): number
	local yearsLeft = math.max(0, Futures.FinalAge - life.Age)
	local focus = Lifestyle.Info[life.Focus or "Balanced"]
	local perYear = (focus and focus.PerYear and focus.PerYear[stat]) or 0
	local value = life.Stats[stat] + drift(life, stat) * math.min(yearsLeft, 20) * 0.35 + perYear * math.min(yearsLeft, 30) * 0.4 + (extra or 0)
	return math.clamp(value, 0, 100)
end

-- P(final stat ≥ threshold): uncertainty shrinks as life progresses.
local function chanceAbove(life, projected: number, threshold: number): number
	local spread = 4 + 14 * (1 - progressOf(life))
	return logistic((projected - threshold) / spread)
end

-- Rough estimate of final net worth.
function Futures.ProjectNetWorth(life): number
	local age = life.Age
	local netWorth = Budget.NetWorth(life)
	local yearsLeft = math.max(0, Futures.FinalAge - age)
	local rate = Budget.SavingsRate(life)
	local workYears = math.max(0, 65 - math.max(age, 22))
	local annual
	if life.Flags.Retired then
		annual = Budget.Breakdown(life).Net
		workYears = yearsLeft
	elseif life.Career.Id ~= "None" and Careers.Info[life.Career.Id] then
		local level = life.Career.Level
		local expectedLevel = math.min(Careers.MaxLevel, level + workYears / 12)
		local salary = Careers.SalaryAt(life.Career.Id, (level + expectedLevel) / 2)
		annual = salary * rate - Budget.RentCost * 0.5
	else
		local potential = 18000 + 500 * life.Stats.Intelligence + 250 * life.Stats.Career + (if (Careers.EducationRank[life.Education] or 0) >= 2 then 20000 else 0)
		annual = potential * rate * (if age < 22 then 1 else 0.6) - Budget.RentCost * 0.6
	end
	local pensionYears = math.max(0, Futures.FinalAge - math.max(age, 65))
	local pension = (life.PeakSalary or 0) * Budget.PensionShare * rate
	local projected = netWorth + annual * workYears + (if life.Flags.Retired then 0 else pension * pensionYears)
	projected += (life.Investments or 0) * ((1.05 ^ math.min(yearsLeft, 40)) - 1)
	if anyFlag(life, WILDCARD_FLAGS) then
		projected *= 1.6
	end
	return projected
end

local function moneyChance(life, projected: number, target: number): number
	local sharpness = 1.2 + 3.5 * progressOf(life)
	return logistic((math.log10(math.max(projected, 1)) - math.log10(target)) * sharpness * 2.3)
end

-- ===== Predict =====
--[[
	Raw model probabilities (0..1) before calibration. Exposed so the
	calibration tool can fit Futures.Calibration from simulated lives.
]]
function Futures.Raw(life)
	local s = life.Stats
	local age = life.Age
	local progress = progressOf(life)
	local rel = life.Relationships
	local p = {}

	-- Money
	local projectedWorth = Futures.ProjectNetWorth(life)
	p.Millionaire = moneyChance(life, projectedWorth, Futures.Thresholds.Millionaire)
	local brokeChance = 1 - moneyChance(life, projectedWorth, Futures.Thresholds.StrugglingWorth)

	-- Career
	local peak = life.PeakCareerLevel or 0
	local t = Futures.Thresholds
	if peak >= t.CareerLevel then
		p.Career = 0.98
	elseif age < 22 and life.Career.Id == "None" then
		local edge = (s.Intelligence - 55) / 15 + (s.Career - 50) / 20 + 0.3 * (life.Traits.Ambitious or 0)
		if anyFlag(life, { "GoodGrades", "Honours", "FirstClass", "Scholarship" }) then
			edge += 0.5
		end
		p.Career = logistic(edge - 0.6)
	else
		local workYears = math.max(0, 65 - age)
		local focus = Lifestyle.Info[life.Focus or "Balanced"]
		local pace = (0.07 + math.max(0, s.Career - 45) / 500) * ((focus and focus.PromotionMultiplier) or 1)
		local level = if life.Career.Id ~= "None" then life.Career.Level else 0
		local projectedLevel = level + workYears * pace + (if level == 0 and workYears > 0 then -0.5 else 0)
		p.Career = logistic((projectedLevel - (t.CareerLevel - 0.5)) * (1.4 + 2 * progress))
	end

	-- Family
	local familyBond = partnerAndChildrenBond(life)
	local fam
	if age < 22 and not rel.Partner then
		fam = (s.Relationships - 50) / 18 + 0.15 * ((life.Traits.Kind or 0) + (life.Traits.Social or 0)) - 0.9
	else
		fam = -1.4
		if rel.Partner then
			fam += 1.3
		else
			fam -= math.max(0, age - 30) / 10
		end
		if rel.Married then
			fam += 0.5
		end
		if rel.Children >= 1 then
			fam += 1.3
		elseif age >= 45 then
			fam -= 2.5
		end
		if familyBond then
			-- Bonds fade over the decades unless maintained: project them forward.
			local yearsLeft = math.max(0, Futures.FinalAge - age)
			local projectedBond = familyBond - yearsLeft * 0.45
			fam += (projectedBond - t.FamilyBond) / 15
		end
		fam *= 1 + progress
	end
	p.Family = logistic(fam)

	-- Fame
	if life.Flags.Celebrity then
		p.Fame = 0.97
	else
		local boost = 0
		if STAR_CAREERS[life.Career.Id] then
			boost += 6 + 3 * life.Career.Level
		end
		if anyFlag(life, { "TeenFamous", "ChannelStarted", "StageStar", "StreamerSeed" }) then
			boost += 4
		end
		p.Fame = chanceAbove(life, project(life, "Popularity", boost), t.Fame)
	end

	p.Genius = chanceAbove(life, project(life, "Intelligence"), t.Genius)
	p.Healthy = chanceAbove(life, project(life, "Health", -ageingLoss(age) * 0.85), t.Healthy)
	p.Respected = chanceAbove(life, project(life, "Reputation", 4 * (1 - progress)), t.Respected)
	local projectedHappiness = project(life, "Happiness", 4)
	p.Content = chanceAbove(life, projectedHappiness, t.Content)

	-- Adventure: can only be gained, never lost.
	if (life.Traits.Adventurous or 0) >= 2 or anyFlag(life, ADVENTURE_FLAGS) then
		p.Adventurer = 0.97
	else
		p.Adventurer = logistic(1.1 * (life.Traits.Adventurous or 0) - 1.6 + 1.2 * (1 - progress) - 1.5 * progress)
	end

	-- Risks
	local unhappyChance = 1 - chanceAbove(life, projectedHappiness, t.StrugglingHappiness)
	p.Struggling = 1 - (1 - brokeChance) * (1 - unhappyChance)
	local lonely = -1.2
	if not rel.Partner then
		lonely += 0.6 + math.max(0, age - 30) / 25
	else
		lonely -= 1.2
	end
	lonely += (1 - math.min(rel.Friends, 4) / 2) * 0.8 + (t.LonelyRelationships - s.Relationships) / 15
	p.Lonely = logistic(lonely * (0.8 + progress))

	return p
end

--[[
	Calibration (Platt scaling with an age term), fitted by
	tests/tools/calibrate.luau --fit on simulated lives and checked on a
	separate, unseen set of lives by the test suite:
	    P = logistic(A + B × logit(raw) + C × progress)
	Re-run the fitter after big balance or content changes.
]]
Futures.Calibration = {
	Millionaire = { 0.282, 0.802, -2.901 },
	Career = { 0.343, 0.303, -3.433 },
	Family = { -2.505, 0.712, 0.299 },
	Fame = { 1.289, 1.647, -3.191 },
	Genius = { 0.729, 3.992, -2.043 },
	Healthy = { -0.204, 0.973, -0.941 },
	Respected = { 2.522, 2.555, -3.029 },
	Content = { -0.013, 0.940, -0.852 },
	Adventurer = { 0.572, 1.507, -2.094 },
	Struggling = { -1.345, 0.761, 1.918 },
	Lonely = { -2.767, 0.447, -0.779 },
}

local function logit(prob: number): number
	prob = math.clamp(prob, 0.001, 0.999)
	return math.log(prob / (1 - prob))
end
Futures.Logit = logit
Futures.Logistic = logistic

function Futures.Predict(life)
	local raw = Futures.Raw(life)
	local progress = progressOf(life)
	local result = {}
	for id, prob in pairs(raw) do
		local cal = Futures.Calibration[id]
		local value = prob
		if cal and prob < 0.97 then -- certainties (e.g. already famous) stay certain
			value = logistic(cal[1] + cal[2] * logit(prob) + cal[3] * progress)
		end
		result[id] = math.clamp(math.floor(value * 100 + 0.5), 1, 99)
	end
	return result
end

function Futures.Progress(life): number
	return progressOf(life)
end

-- Sorted list: { { Id, Pct, Icon, Title, Positive } } best first (positives), then risks.
function Futures.Sorted(predictions)
	local positives, risks = {}, {}
	for _, id in ipairs(Futures.Order) do
		local info = Futures.Info[id]
		local entry = { Id = id, Pct = predictions[id] or 0, Icon = info.Icon, Title = info.Title, Positive = info.Positive }
		table.insert(if info.Positive then positives else risks, entry)
	end
	table.sort(positives, function(a, b)
		return a.Pct > b.Pct
	end)
	table.sort(risks, function(a, b)
		return a.Pct > b.Pct
	end)
	return positives, risks
end

function Futures.Headline(predictions): (string, string?)
	local positives, risks = Futures.Sorted(predictions)
	local best, risk = positives[1], risks[1]
	local headline
	if best.Pct >= 55 then
		headline = Futures.Info[best.Id].Headline
	else
		headline = "Your future is uncertain. One major decision could change everything."
	end
	local warning = nil
	if risk.Pct >= 45 then
		warning = Futures.Info[risk.Id].Headline
		if risk.Id == "Struggling" and (predictions.Millionaire or 0) >= 40 then
			warning = "Money could be fine, but your happiness needs looking after."
		end
	end
	return headline, warning
end

function Futures.Archetype(predictions): string
	local positives, risks = Futures.Sorted(predictions)
	if risks[1].Pct >= 55 and risks[1].Pct >= positives[1].Pct then
		return Futures.Info[risks[1].Id].Archetype
	end
	return Futures.Info[positives[1].Id].Archetype
end

return Futures
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">People</string>
            <string name="Source"><![CDATA[--[[
	People  (ReplicatedStorage.Shared.Util.People)
	The named people in a life: parents, siblings, partner, children, friends.
	Each person has a Bond (0–100) that fades if neglected and grows through
	time together. Bonds feed Happiness and the Relationships stat every year,
	and very weak bonds cause relationship problems (see Lib/Yearly).

	Person = { Id, Name, Role, Bond, BornAge (the life's age when they were born/met), Married? }
	Roles: Parent, Sibling, Partner, Ex, Child, Friend, BestFriend

	Pure functions shared by server (authoritative) and client (display).
	`life.Relationships` (Partner/Married/Children/Friends) is kept in sync for
	Requires checks via People.Sync.
]]

local NamePool = require(script.Parent.Parent.Data.NamePool)

local People = {}

People.MaxFriends = 6
People.ActionsPerTurn = 2

People.Roles = {
	Parent = { Label = "Parent", Icon = "🧑‍🍼", Decay = 1, Weight = 1, StartBond = 70 },
	Sibling = { Label = "Sibling", Icon = "🧒", Decay = 1.2, Weight = 0.7, StartBond = 60 },
	Partner = { Label = "Partner", Icon = "❤️", Decay = 1, MarriedDecay = 0.6, Weight = 2.5, StartBond = 65 },
	Ex = { Label = "Ex", Icon = "💔", Decay = 0, Weight = 0, StartBond = 20 },
	Child = { Label = "Child", Icon = "👶", Decay = 0.8, Weight = 1.2, StartBond = 75 },
	BestFriend = { Label = "Best Friend", Icon = "🫶", Decay = 1.2, Weight = 1.2, StartBond = 75 },
	Friend = { Label = "Friend", Icon = "🙂", Decay = 2, Weight = 0.5, StartBond = 55 },
}

function People.IsRole(role: any): boolean
	return type(role) == "string" and People.Roles[role] ~= nil
end

function People.ByRole(life, role: string)
	local list = {}
	for _, person in ipairs(life.People) do
		if person.Role == role then
			table.insert(list, person)
		end
	end
	return list
end

function People.Find(life, id: any)
	for _, person in ipairs(life.People) do
		if person.Id == id then
			return person
		end
	end
	return nil
end

function People.Partner(life)
	return People.ByRole(life, "Partner")[1]
end

function People.AgeOf(life, person): number?
	if person.Role == "Child" then
		return life.Age - person.BornAge
	end
	return nil
end

-- Picks a name not already used in this life.
local function pickName(life, rng): string
	local used = { [life.Name] = true }
	for _, person in ipairs(life.People) do
		used[person.Name] = true
	end
	for _ = 1, 20 do
		local name = NamePool[rng:NextInteger(1, #NamePool)]
		if not used[name] then
			return name
		end
	end
	return NamePool[rng:NextInteger(1, #NamePool)]
end

function People.Add(life, role: string, rng, bond: number?)
	life.NextPersonId = (life.NextPersonId or 1)
	local person = {
		Id = "p" .. life.NextPersonId,
		Name = pickName(life, rng),
		Role = role,
		Bond = bond or People.Roles[role].StartBond,
		BornAge = life.Age,
	}
	life.NextPersonId += 1
	table.insert(life.People, person)
	People.Sync(life)
	return person
end

--[[
	Adds someone with a fixed name, e.g. a real friend's character after a
	group event. `playerUserId` links them to that player so they are only
	added once. Returns the person, or nil if already present / no room.
]]
function People.AddNamed(life, role: string, name: string, playerUserId: number?, bond: number?)
	if playerUserId then
		for _, person in ipairs(life.People) do
			if person.PlayerUserId == playerUserId then
				return nil
			end
		end
	end
	if (role == "Friend" or role == "BestFriend") and life.Relationships.Friends >= People.MaxFriends then
		return nil
	end
	life.NextPersonId = (life.NextPersonId or 1)
	local person = {
		Id = "p" .. life.NextPersonId,
		Name = name,
		Role = role,
		Bond = bond or People.Roles[role].StartBond,
		BornAge = life.Age,
		PlayerUserId = playerUserId,
	}
	life.NextPersonId += 1
	table.insert(life.People, person)
	People.Sync(life)
	return person
end

function People.Remove(life, person)
	local index = table.find(life.People, person)
	if index then
		table.remove(life.People, index)
	end
	People.Sync(life)
end

function People.ChangeBond(person, delta: number): number
	local before = person.Bond
	person.Bond = math.clamp(math.floor((person.Bond + delta) * 10 + 0.5) / 10, 0, 100)
	return person.Bond - before
end

-- Keeps the summary counters in life.Relationships in step with People.
function People.Sync(life)
	local rel = life.Relationships
	local partner = People.Partner(life)
	rel.Partner = partner ~= nil
	rel.Married = partner ~= nil and partner.Married == true
	rel.Children = #People.ByRole(life, "Child")
	rel.Friends = #People.ByRole(life, "Friend") + #People.ByRole(life, "BestFriend")
end

--[[
	Weighted average bond of the people who matter most (partner, children,
	best friend, parents, siblings, friends). nil when the life has nobody.
]]
function People.CloseBond(life): number?
	local total, weight = 0, 0
	for _, person in ipairs(life.People) do
		local info = People.Roles[person.Role]
		if info and info.Weight > 0 then
			total += person.Bond * info.Weight
			weight += info.Weight
		end
	end
	if weight == 0 then
		return nil
	end
	return total / weight
end

-- Gift cost grows with age (a toy at 8, a nice dinner at 40).
function People.GiftCost(life): number
	if life.Age < 13 then
		return 10
	elseif life.Age < 19 then
		return 40
	end
	return 300
end

return People
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Signal</string>
            <string name="Source"><![CDATA[--[[
	Signal  (ReplicatedStorage.Shared.Util.Signal)
	Minimal pure-Luau event: Connect / Once / Fire / Wait / DisconnectAll.
	Handlers run in their own thread so one erroring handler cannot break others.
]]

local Signal = {}
Signal.__index = Signal

export type Connection = { Disconnect: (self: Connection) -> (), Connected: boolean }

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(handler: (...any) -> ())
	local connection = { Connected = true }
	local handlers = self._handlers
	function connection.Disconnect(c)
		if not c.Connected then
			return
		end
		c.Connected = false
		local index = table.find(handlers, c)
		if index then
			table.remove(handlers, index)
		end
	end
	connection._fn = handler
	table.insert(handlers, connection)
	return connection
end

function Signal:Once(handler: (...any) -> ())
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		handler(...)
	end)
	return connection
end

function Signal:Fire(...)
	-- Copy so handlers may disconnect while we iterate.
	local snapshot = table.clone(self._handlers)
	for _, connection in ipairs(snapshot) do
		if connection.Connected then
			task.spawn(connection._fn, ...)
		end
	end
end

function Signal:Wait()
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:DisconnectAll()
	for _, connection in ipairs(table.clone(self._handlers)) do
		connection:Disconnect()
	end
end

return Signal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">StatMath</string>
            <string name="Source"><![CDATA[--[[
	StatMath  (ReplicatedStorage.Shared.Util.StatMath)
	Pure stat arithmetic shared by the server (authoritative) and the client
	(consequence previews). Contains no game state.
]]

local Config = require(script.Parent.Parent.Config)
local StatDefinitions = require(script.Parent.Parent.Data.StatDefinitions)

local StatMath = {}

function StatMath.Clamp(value: number): number
	return math.clamp(value, Config.StatMin, Config.StatMax)
end

--[[
	Diminishing returns: gains are smaller near the top of the scale and losses
	are smaller near the bottom, so stats rarely sit pinned at 0 or 100 and
	earlier choices keep mattering.
	  effective = delta * (room / 50) clamped to [0.35, 1.25]
]]
function StatMath.Scale(current: number, delta: number): number
	if delta == 0 then
		return 0
	end
	local room = if delta > 0 then Config.StatMax - current else current - Config.StatMin
	local factor = math.clamp(room / 50, 0.35, 1.25)
	return delta * factor
end

--[[
	Applies `deltas` ({ StatName = number }) to a copy of `stats`.
	Unknown stat names and non-finite numbers are ignored.
	Returns newStats, applied (the real change per stat after scaling + clamping).
]]
function StatMath.Apply(stats: { [string]: number }, deltas: { [string]: number }, multipliers: { [string]: number }?)
	local result = table.clone(stats)
	local applied = {}
	for name, delta in pairs(deltas) do
		if StatDefinitions.IsValid(name) and type(delta) == "number" and delta == delta and math.abs(delta) ~= math.huge then
			local m = multipliers and multipliers[name] or 1
			local current = result[name] or Config.StatStart
			local nextValue = StatMath.Clamp(current + StatMath.Scale(current, delta * m))
			nextValue = math.floor(nextValue * 10 + 0.5) / 10 -- one decimal place
			applied[name] = nextValue - current
			result[name] = nextValue
		end
	end
	return result, applied
end

-- Average of all eight stats; used by Life Reveal and endings.
function StatMath.Overall(stats: { [string]: number }): number
	local total = 0
	for _, name in ipairs(StatDefinitions.Order) do
		total += stats[name] or Config.StatStart
	end
	return total / #StatDefinitions.Order
end

--[[
	Maps net worth (in-life money + assets) to the 0-100 Wealth stat on a log
	scale: $0 -> 0, $10k -> 50, $1M -> 75, $100M+ -> 100.
]]
function StatMath.WealthFromNetWorth(netWorth: number): number
	if netWorth <= 0 then
		return 0
	end
	return StatMath.Clamp(math.log10(netWorth + 1) * 12.5)
end

return StatMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">TableUtil</string>
            <string name="Source"><![CDATA[--[[
	TableUtil  (ReplicatedStorage.Shared.Util.TableUtil)
	Pure helpers for working with plain data tables.
]]

local TableUtil = {}

-- Deep-copies plain data. Metatables are not copied (data tables never use them).
function TableUtil.DeepCopy<T>(value: T): T
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in pairs(value :: any) do
		copy[TableUtil.DeepCopy(k)] = TableUtil.DeepCopy(v)
	end
	return (copy :: any) :: T
end

--[[
	Fills keys that exist in `template` but are missing (nil) in `target`.
	Existing values are never overwritten. Recurses into nested dictionaries
	only when both sides are tables. Returns `target` for chaining.
	Array-like template entries are NOT merged element-by-element (an empty
	template array means "starts empty", not "must contain these").
]]
function TableUtil.Reconcile(target: { [any]: any }, template: { [any]: any })
	for k, templateValue in pairs(template) do
		local current = target[k]
		if current == nil then
			target[k] = TableUtil.DeepCopy(templateValue)
		elseif type(current) == "table" and type(templateValue) == "table" and not TableUtil.IsArray(templateValue) then
			TableUtil.Reconcile(current, templateValue)
		end
	end
	return target
end

-- True for {} and for tables whose keys are exactly 1..n.
function TableUtil.IsArray(t: { [any]: any }): boolean
	local count = 0
	for _ in pairs(t) do
		count += 1
	end
	return count == #t
end

function TableUtil.Count(t: { [any]: any }): number
	local n = 0
	for _ in pairs(t) do
		n += 1
	end
	return n
end

-- Keeps only the last `max` entries of an array, in place.
function TableUtil.TrimArray(t: { any }, max: number)
	local excess = #t - max
	if excess > 0 then
		table.move(t, excess + 1, #t, 1)
		for i = #t, #t - excess + 1, -1 do
			t[i] = nil
		end
	end
	return t
end

--[[
	Checks that a value can be stored in a DataStore: only strings, numbers
	(finite), booleans and tables with either all-string keys or array keys.
	Returns ok, problemPath.
]]
function TableUtil.IsSerializable(value: any, path: string?): (boolean, string?)
	local here = path or "root"
	local kind = type(value)
	if kind == "number" then
		if value ~= value or value == math.huge or value == -math.huge then
			return false, here .. " (non-finite number)"
		end
		return true
	elseif kind == "string" or kind == "boolean" or kind == "nil" then
		return true
	elseif kind ~= "table" then
		return false, here .. " (" .. kind .. ")"
	end

	if getmetatable(value) ~= nil then
		return false, here .. " (has metatable)"
	end

	local isArray = TableUtil.IsArray(value)
	for k, v in pairs(value) do
		if not isArray and type(k) ~= "string" then
			return false, here .. " (mixed/non-string key " .. tostring(k) .. ")"
		end
		local ok, problem = TableUtil.IsSerializable(v, here .. "." .. tostring(k))
		if not ok then
			return false, problem
		end
	end
	return true
end

return TableUtil
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="24">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="25">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Folder" referent="26">
