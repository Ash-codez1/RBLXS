					Outcomes = { { Chance = 0.5, Promote = 1, Story = "The arrest earned them a promotion." } } } },
			{ Id = "Undercover", Text = "Go undercover", Description = "Dangerous, but fast.",
				Effects = { Stats = { Health = -4 }, Traits = { Brave = 1 }, Story = "{name} went undercover for three tense weeks.",
					Outcomes = { { Chance = 0.6, Promote = 1, Stats = { Reputation = 8, Popularity = 4 }, Flags = { "Detective" }, Story = "They cracked the case and were made a detective." }, { Chance = 0.4, Stats = { Health = -8, Happiness = -4 }, Story = "Their cover was blown. They were lucky to get out." } } } },
			{ Id = "Community", Text = "Patrol and talk to locals", Description = "Prevention over arrests.",
				Effects = { Stats = { Reputation = 7, Relationships = 4 }, Friends = 1, Story = "{name} got to know every shopkeeper on the street. The break-ins stopped." } },
