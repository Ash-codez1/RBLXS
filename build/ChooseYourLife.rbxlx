          <Item class="ModuleScript" referent="33">
            <Properties>
              <string name="Name">LifeAndWork</string>
              <string name="Source"><![CDATA[--[[
	Life & Work scenarios (multi-stage)
	ServerScriptService.Server.Content.Scenarios.LifeAndWork

	Career-specific dilemmas (one for every career) and relationship moments
	that can happen in several stages. They use `Stages = { ... }` instead of
	`Stage`, and Requires on career, people and bonds, so they only appear when
	they fit the life being lived.
]]

local YOUNG, ADULT, MID, OLD = 3, 4, 5, 6

return {
	-- ===================== CAREERS =====================
	{
		Id = "W_Headhunted", Stages = { YOUNG, ADULT, MID }, Icon = "📞", Title = "A Rival Comes Calling",
		Description = "A recruiter from a rival company calls. They know your work, and they want you.",
		Once = true, Requires = { HasCareer = true, MinCareerLevel = 2 },
		Choices = {
			{ Id = "Accept", Text = "Take the new job", Description = "Bigger title, bigger pay.",
				Effects = { Promote = 1, Money = 4000, Stats = { Career = 4, Relationships = -2 }, Story = "{name} jumped ship to a rival, one level up." } },
			{ Id = "Leverage", Text = "Use it to negotiate a raise", Description = "Play your cards right.",
				Effects = { Stats = { Career = 2 }, Story = "{name} told their boss about the offer.",
					Outcomes = { { Chance = 0.55, Promote = 1, Story = "Their boss matched it with a promotion." }, { Chance = 0.45, Stats = { Reputation = -4, Happiness = -3 }, Story = "Their boss called the bluff. Awkward." } } } },
			{ Id = "Loyal", Text = "Stay loyal", Description = "You like where you are.",
				Effects = { Stats = { Reputation = 5, Happiness = 2 }, Story = "{name} turned the offer down. Their team never forgot it." } },
		},
	},
	{
		Id = "W_MissedMoments", Stages = { ADULT, MID }, Icon = "⏳", Title = "Work or Family?",
		Description = "A huge work presentation is on the same evening as your child's school play.",
