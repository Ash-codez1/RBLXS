          <string name="Name">Content</string>
        </Properties>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">CityEvents</string>
            <string name="Source"><![CDATA[--[[
	City events  (ServerScriptService.Server.Content.CityEvents)
	Server-wide shared events (Services/CityEventService). Every few minutes
	the whole server gets the same invitation; each player chooses to join or
	skip, and effects apply to their own life only. Requires is per player.
	Outcomes (if any) are rolled once for the city, so everyone who joins
	shares the same result.
]]

return {
	{ Id = "CE_Festival", Icon = "🎪", Title = "City Festival", Description = "Music, food stalls and fireworks fill the city centre tonight!",
		JoinText = "Go to the festival", SkipText = "Stay in",
		Effects = { Stats = { Happiness = 5, Relationships = 3 }, Story = "{name} danced at the city festival under the fireworks." } },
	{ Id = "CE_Marathon", Icon = "🏃", Title = "The City Marathon", Description = "Thousands are lining up for the annual city marathon.",
		Requires = { MinAge = 12 }, JoinText = "Run it", SkipText = "Watch from the sidelines",
		Effects = { Stats = { Health = 6, Reputation = 2, Happiness = 2 }, Story = "{name} ran the city marathon and crossed the finish line." } },
	{ Id = "CE_Heatwave", Icon = "☀️", Title = "Heatwave!", Description = "It's the hottest day of the year. The whole city heads to the parks and pools.",
		JoinText = "Head to the lido", SkipText = "Stay cool indoors",
		Effects = { Stats = { Happiness = 4, Health = 2 }, Story = "{name} spent the heatwave splashing in the city lido." } },
	{ Id = "CE_Market", Icon = "📈", Title = "Market Frenzy", Description = "Everyone in the city is talking about a stock that's shooting up.",
		Requires = { MinAge = 18, MinMoney = 2000 }, JoinText = "Buy in ($1,000)", SkipText = "Ignore the hype",
		Effects = { Money = -1000, Story = "{name} joined the market frenzy.",
			Outcomes = { { Chance = 0.5, Money = 2600, Story = "The stock soared. Profit!" }, { Chance = 0.5, Story = "The bubble burst the next day." } } } },
	{ Id = "CE_Cleanup", Icon = "🧹", Title = "Great City Clean-Up", Description = "Volunteers are cleaning up parks and beaches across the city.",
		JoinText = "Volunteer", SkipText = "Not today",
		Effects = { Stats = { Reputation = 5, Health = 1 }, Traits = { Kind = 1 }, Story = "{name} helped clean up the city's parks." } },
	{ Id = "CE_Quiz", Icon = "❓", Title = "City Quiz Night", Description = "The biggest pub quiz in the city, live on local TV!",
		Requires = { MinAge = 10 }, JoinText = "Enter the quiz", SkipText = "Skip it",
		Effects = { Stats = { Intelligence = 2 }, Story = "{name} entered the city quiz night.",
			Outcomes = { { Chance = 0.3, Stats = { Popularity = 6, Intelligence = 3 }, Story = "And won it on live TV!" } } } },
	{ Id = "CE_Concert", Icon = "🎤", Title = "Free Concert in the Park", Description = "A superstar is playing a surprise free concert in the city park!",
		JoinText = "Go!", SkipText = "Crowds aren't my thing",
		Effects = { Stats = { Happiness = 7, Popularity = 2 }, Story = "{name} sang along at a surprise free concert in the park." } },
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Events</string>
            <string name="Source"><![CDATA[--[[
	Random life events  (ServerScriptService.Server.Content.Events)
	Unexpected things that can happen after any decision (see Lib/RandomEvents).
	Fields: Id, Title, Icon, Rarity (Common|Uncommon|Rare|Legendary),
	Stages (list), Requires?, Boost?, Once? (default true), Effects (Consequences format).
	Several events set flags that unlock special scenarios later (hidden branches).
]]

local KID, TEEN, YOUNG, ADULT, MID, OLD = 1, 2, 3, 4, 5, 6

return {
	-- ===== Childhood =====
	{ Id = "E_FoundMoney", Title = "Lucky Find", Icon = "💵", Rarity = "Common", Stages = { KID, TEEN },
		Effects = { Money = 20, Stats = { Happiness = 4 }, Story = "{name} found a $20 note on the pavement. Nobody claimed it." } },
	{ Id = "E_BrokenArm", Title = "Ouch!", Icon = "🩹", Rarity = "Common", Stages = { KID, TEEN },
		Effects = { Stats = { Health = -7, Popularity = 3 }, Story = "{name} fell off a climbing frame and broke an arm. Everyone signed the cast." } },
	{ Id = "E_ArtPrize", Title = "Prize Winner", Icon = "🏆", Rarity = "Uncommon", Stages = { KID }, Requires = { AnyFlags = { "Creative", "WritingTalent", "MusicTalent" } },
		Effects = { Stats = { Happiness = 6, Reputation = 5 }, Flags = { "AwardWinner" }, Story = "{name}'s work won first prize in a regional young creators' competition!" } },
	{ Id = "E_NewSibling", Title = "A New Sibling", Icon = "🍼", Rarity = "Uncommon", Stages = { KID },
		Effects = { Stats = { Relationships = 5, Happiness = 2 }, Flags = { "HasSibling" }, Meet = "Sibling", Story = "The family grew: {name} became a big sibling." } },
	{ Id = "E_PuppyKid", Title = "A Furry Friend", Icon = "🐶", Rarity = "Common", Stages = { KID },
		Effects = { Stats = { Happiness = 7, Health = 2 }, Flags = { "ChildhoodPet" }, Story = "The family adopted a scruffy puppy who followed {name} everywhere." } },

	-- ===== Teenage years =====
	{ Id = "E_Scholarship", Title = "Scholarship Offer", Icon = "🎓", Rarity = "Rare", Stages = { TEEN }, Requires = { MinStats = { Intelligence = 62 } },
		Boost = { Flags = { GoodGrades = 3 } },
		Effects = { Money = 8000, Stats = { Happiness = 6, Reputation = 6 }, Flags = { "Scholarship" }, Story = "Out of nowhere, a letter: {name} had been awarded a scholarship for their grades!" } },
	{ Id = "E_TalentScout", Title = "Talent Scout", Icon = "🔭", Rarity = "Rare", Stages = { TEEN }, Requires = { AnyFlags = { "Athlete", "SportsStudies", "TeamPlayer" } },
		Effects = { Stats = { Popularity = 6, Happiness = 5 }, Flags = { "Scouted" }, Story = "A professional scout watched {name} play and asked for their contact details." } },
	{ Id = "E_ViralVideo", Title = "Gone Viral!", Icon = "📈", Rarity = "Rare", Stages = { TEEN, YOUNG }, Requires = { AnyFlags = { "ChannelStarted", "StreamerSeed" } },
		Effects = { Stats = { Popularity = 10, Happiness = 4 }, Flags = { "TeenFamous" }, Story = "One of {name}'s videos exploded overnight: two million views and counting." } },
	{ Id = "E_SportsInjury", Title = "Injury Setback", Icon = "🦵", Rarity = "Uncommon", Stages = { TEEN, YOUNG }, Requires = { AnyFlags = { "Athlete", "Scouted" } },
		Effects = { Stats = { Health = -8, Happiness = -5 }, Flags = { "OldInjury" }, Story = "{name} tore a ligament mid-match and spent months recovering." } },
	{ Id = "E_BestFriendMoves", Title = "Goodbye, Best Friend", Icon = "👋", Rarity = "Common", Stages = { TEEN },
		Effects = { Stats = { Relationships = -4, Happiness = -4 }, Bond = { BestFriend = -15, Friend = -8 }, Story = "{name}'s best friend moved to another country. They promised to video call every week." } },

	-- ===== Young adulthood =====
	{ Id = "E_Inheritance", Title = "An Unexpected Inheritance", Icon = "📜", Rarity = "Rare", Stages = { YOUNG, ADULT, MID },
		Boost = { Stats = { Relationships = { Min = 65, Multiplier = 2 } } },
		Effects = { Money = 60000, Stats = { Happiness = 3 }, Story = "A distant great-aunt {name} had visited every summer left them $60,000 in her will.",
			Outcomes = { { Chance = 0.2, Money = 240000, Story = "And a house by the sea, which sold for another $240,000!" } } } },
	{ Id = "E_LostWallet", Title = "Wallet Gone", Icon = "👛", Rarity = "Common", Stages = { YOUNG, ADULT },
		Effects = { Money = -300, Stats = { Happiness = -3 }, Story = "{name} lost their wallet on the bus. Cards cancelled, $300 gone." } },
	{ Id = "E_Mentor", Title = "A Mentor Appears", Icon = "🧑‍🏫", Rarity = "Uncommon", Stages = { YOUNG, ADULT }, Requires = { HasCareer = true },
		Effects = { Stats = { Career = 8, Intelligence = 3 }, Flags = { "Mentored" }, Story = "A senior figure in {name}'s field took them under their wing." } },
	{ Id = "E_CarCrash", Title = "Car Accident", Icon = "🚑", Rarity = "Uncommon", Stages = { YOUNG, ADULT, MID },
		Effects = { Stats = { Health = -10, Happiness = -4 }, Money = -2000, Story = "{name} was in a car accident. Bruised and shaken, but alive." } },
	{ Id = "E_LifeChangingMeeting", Title = "A Life-Changing Meeting", Icon = "✨", Rarity = "Uncommon", Stages = { YOUNG, ADULT }, Requires = { Partner = false },
		Effects = { Partner = true, Stats = { Happiness = 9, Relationships = 8 }, Flags = { "SoulMate" }, Story = "A spilled coffee, an apology, a three-hour conversation. {name} had met someone special." } },
	{ Id = "E_SpaceAgency", Title = "The Space Agency Calls", Icon = "🛰️", Rarity = "Legendary", Stages = { YOUNG, ADULT }, Requires = { Careers = { "Scientist", "Engineer" }, MinStats = { Intelligence = 70 } },
		Effects = { Stats = { Happiness = 8, Reputation = 6 }, Flags = { "SpaceInvite" }, Story = "An email arrived from the national space agency. They wanted {name} to apply to the astronaut programme." } },

	-- ===== Adulthood / middle age =====
	{ Id = "E_LoseJob", Title = "Laid Off", Icon = "📦", Rarity = "Uncommon", Stages = { ADULT, MID }, Requires = { HasCareer = true },
		Boost = { Stats = { Career = { Max = 40, Multiplier = 2.5 } } },
		Effects = { Career = "None", Stats = { Happiness = -9, Career = -10 }, Flags = { "LaidOff" }, Story = "Budget cuts. {name} packed their desk into a cardboard box." } },
	{ Id = "E_Bonus", Title = "Surprise Bonus", Icon = "💰", Rarity = "Common", Stages = { ADULT, MID }, Requires = { HasCareer = true },
		Effects = { Money = 8000, Stats = { Happiness = 4, Career = 2 }, Story = "A great year at work earned {name} an $8,000 bonus." } },
	{ Id = "E_SurprisePromotion", Title = "Unexpected Promotion", Icon = "📈", Rarity = "Uncommon", Stages = { YOUNG, ADULT, MID }, Requires = { HasCareer = true },
		Boost = { Stats = { Career = { Min = 60, Multiplier = 2 } } },
		Effects = { Promote = 1, Stats = { Happiness = 5 }, Story = "{name}'s boss called them in and offered a promotion on the spot." } },
	{ Id = "E_BusinessBoom", Title = "Business Boom", Icon = "🚀", Rarity = "Rare", Stages = { ADULT, MID }, Requires = { Careers = { "Entrepreneur", "BusinessOwner", "RealEstate" } },
		Effects = { Money = 500000, Promote = 1, Stats = { Happiness = 8, Reputation = 5 }, Flags = { "BigExit" }, Story = "{name}'s company landed a massive deal. Overnight, they were half a million dollars richer." } },
	{ Id = "E_BadInvestment", Title = "Terrible Investment", Icon = "📉", Rarity = "Uncommon", Stages = { ADULT, MID }, Requires = { MinMoney = 20000 },
		Effects = { MoneyPercent = -0.35, Stats = { Happiness = -7 }, Flags = { "BurnedInvestor" }, Story = "A 'can't-lose' investment lost. {name} watched a third of their savings vanish." } },
	{ Id = "E_Famous", Title = "Overnight Celebrity", Icon = "🌟", Rarity = "Rare", Stages = { YOUNG, ADULT, MID }, Requires = { MinStats = { Popularity = 72 } },
		Effects = { Stats = { Popularity = 12, Happiness = 4, Health = -2 }, Flags = { "Celebrity" }, Story = "A TV appearance turned {name} into a household name. Strangers asked for selfies." } },
	{ Id = "E_Twins", Title = "Double Surprise", Icon = "👶👶", Rarity = "Rare", Stages = { ADULT }, Requires = { Married = true, MaxChildren = 2 },
		Effects = { Children = 2, Stats = { Happiness = 8, Health = -4 }, Story = "Twins! {name}'s family doubled in a single day." } },
	{ Id = "E_LateBloomer", Title = "Extraordinary Talent", Icon = "💎", Rarity = "Legendary", Stages = { ADULT, MID },
		Effects = { Stats = { Happiness = 12, Popularity = 10 }, Flags = { "LateBloomer" }, Story = "At a friend's party, {name} picked up an instrument for the first time and played like a virtuoso. A record producer was in the room." } },
	{ Id = "E_Burglary", Title = "Break-In", Icon = "🚨", Rarity = "Common", Stages = { ADULT, MID }, Requires = { MinMoney = 5000 },
		Effects = { Money = -3000, Stats = { Happiness = -5 }, Story = "Burglars broke into {name}'s home while they were away." } },
	{ Id = "E_Lottery", Title = "JACKPOT!", Icon = "🎰", Rarity = "Legendary", Stages = { YOUNG, ADULT, MID, OLD },
		Effects = { Money = 5000000, Stats = { Happiness = 15 }, Flags = { "LotteryWinner" }, Story = "{name} checked an old lottery ticket on a whim. Every number matched. FIVE MILLION DOLLARS." } },
	{ Id = "E_FortuneLost", Title = "Fortune Lost", Icon = "🌪️", Rarity = "Rare", Stages = { ADULT, MID }, Requires = { MinMoney = 300000 },
		Effects = { MoneyPercent = -0.6, Stats = { Happiness = -10, Reputation = -4 }, Flags = { "LostFortune" }, Story = "A market crash and a crooked advisor wiped out most of {name}'s fortune." } },
	{ Id = "E_HealthScare", Title = "Health Scare", Icon = "🏥", Rarity = "Uncommon", Stages = { MID, OLD },
		Boost = { Stats = { Health = { Max = 40, Multiplier = 2.5 } } },
		Effects = { Stats = { Health = -10, Happiness = -5 }, Flags = { "HealthScare" }, Story = "A routine check-up found something worrying. {name} spent weeks in and out of hospital." } },
	{ Id = "E_Reunion", Title = "Old Friend Returns", Icon = "🤗", Rarity = "Common", Stages = { ADULT, MID, OLD },
		Effects = { Stats = { Relationships = 6, Happiness = 5 }, Meet = "Friend", Story = "An old school friend tracked {name} down online. They picked up exactly where they left off." } },

	-- ===== People, work & money (Phase 4) =====
	{ Id = "E_PartnerNeglected", Title = "Feeling Neglected", Icon = "💬", Rarity = "Common", Stages = { YOUNG, ADULT, MID, OLD }, Requires = { Partner = true, MaxBond = { Partner = 35 } },
		Effects = { Bond = { Partner = -6 }, Stats = { Happiness = -5 }, Story = "{name}'s partner said they feel invisible lately. It stung, because it was true." } },
	{ Id = "E_FriendMovesAway", Title = "A Friend Moves Away", Icon = "📦", Rarity = "Common", Stages = { TEEN, YOUNG, ADULT, MID }, Requires = { MinFriends = 2 },
		Effects = { Friends = -1, Stats = { Happiness = -3 }, Story = "One of {name}'s friends moved to the other side of the world." } },
	{ Id = "E_ChildAward", Title = "Proud Parent", Icon = "🥇", Rarity = "Uncommon", Stages = { ADULT, MID }, Requires = { MinChildren = 1 },
		Effects = { Bond = { Child = 8 }, Stats = { Happiness = 7 }, Story = "{name}'s child won an award at school. They cried in the audience." } },
	{ Id = "E_PayRise", Title = "Pay Rise", Icon = "💵", Rarity = "Common", Stages = { YOUNG, ADULT, MID }, Requires = { HasCareer = true },
		Effects = { Money = 3000, Stats = { Happiness = 3, Career = 3 }, Story = "{name}'s hard work was rewarded with a pay rise." } },
	{ Id = "E_CareerAward", Title = "Employee of the Year", Icon = "🏅", Rarity = "Uncommon", Stages = { YOUNG, ADULT, MID }, Requires = { HasCareer = true, MinStats = { Career = 55 } },
		Effects = { Stats = { Reputation = 6, Career = 5, Happiness = 4 }, Story = "{name} was named employee of the year." } },
	{ Id = "E_MarketBoom", Title = "Market Boom", Icon = "📈", Rarity = "Uncommon", Stages = { YOUNG, ADULT, MID, OLD }, Requires = { MinInvestments = 5000 },
		Effects = { InvestPercent = 0.4, Stats = { Happiness = 4 }, Story = "Stock markets soared and {name}'s investments jumped." } },
	{ Id = "E_MarketCrash", Title = "Market Crash", Icon = "💥", Rarity = "Uncommon", Stages = { YOUNG, ADULT, MID, OLD }, Requires = { MinInvestments = 5000 },
		Effects = { InvestPercent = -0.35, Stats = { Happiness = -5 }, Story = "A global crash hit the markets. {name}'s investments took a beating." } },
	{ Id = "E_SiblingNews", Title = "Big News From Your Sibling", Icon = "📣", Rarity = "Common", Stages = { YOUNG, ADULT, MID }, Requires = { HasRole = { "Sibling" } },
		Effects = { Bond = { Sibling = 8 }, Stats = { Happiness = 4 }, Story = "{name}'s sibling called with amazing news, and wanted {name} to be the first to know." } },
	{ Id = "E_ExReturns", Title = "An Old Flame", Icon = "🔥", Rarity = "Uncommon", Stages = { ADULT, MID }, Requires = { HasRole = { "Ex" }, Partner = false },
		Effects = { Reunite = true, Stats = { Happiness = 7 }, Story = "{name} bumped into an ex. Years had passed, and this time it felt right." } },

	-- ===== Retirement =====
	{ Id = "E_Grandchild", Title = "A Grandchild!", Icon = "👶", Rarity = "Common", Stages = { MID, OLD }, Requires = { MinChildren = 1 },
		Effects = { Stats = { Happiness = 10, Relationships = 6 }, Flags = { "Grandparent" }, Story = "{name} held their first grandchild and cried happy tears." } },
	{ Id = "E_Award", Title = "Lifetime Achievement Award", Icon = "🏆", Rarity = "Rare", Stages = { MID, OLD }, Requires = { MinStats = { Reputation = 70 } },
		Effects = { Stats = { Happiness = 8, Reputation = 8, Popularity = 6 }, Flags = { "LifetimeAward" }, Story = "{name} received a lifetime achievement award in front of a standing ovation." } },
	{ Id = "E_OldLetter", Title = "A Letter from the Past", Icon = "✉️", Rarity = "Common", Stages = { OLD },
		Effects = { Stats = { Happiness = 5, Relationships = 3 }, Story = "{name} found a letter they'd written to their future self at age ten. They laughed until they cried." } },
	{ Id = "E_Fall", Title = "A Nasty Fall", Icon = "🦯", Rarity = "Uncommon", Stages = { OLD },
		Effects = { Stats = { Health = -8, Happiness = -3 }, Story = "{name} slipped on the stairs and needed a long recovery." } },
	{ Id = "E_Viral80", Title = "Internet Grandparent", Icon = "📱", Rarity = "Rare", Stages = { OLD },
		Effects = { Stats = { Popularity = 12, Happiness = 8 }, Flags = { "ViralSenior" }, Story = "A video of {name} dancing at a family party went viral. Millions now call them 'the coolest grandparent alive'." } },
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">GroupScenarios</string>
            <string name="Source"><![CDATA[--[[
	Group scenarios  (ServerScriptService.Server.Content.GroupScenarios)
	Decisions a Life Circle (party) makes together by voting (Services/PartyService).

	• Requires (scenario and choice) must pass for EVERY member, so a choice
	  that costs $5,000 is only open if everyone can afford it.
	• The winning choice's Effects are applied to each member's own life,
	  independently (their own stats, traits and money).
	• Chance Outcomes are rolled ONCE for the whole group: friends who start a
	  business together share its fate.
	Group events don't use up a decision or change anyone's age.
]]

return {
	{
		Id = "G_DayOut", Icon = "🎡", Title = "A Day Out Together",
		Description = "Your whole crew has a free day. Where are you going?",
		Weight = 1.2,
		Choices = {
			{ Id = "ThemePark", Text = "Theme park", Description = "Rollercoasters and candyfloss.",
				Effects = { Money = -40, Stats = { Happiness = 6, Relationships = 4 }, Story = "{name} and friends screamed their way round the theme park." } },
			{ Id = "Museum", Text = "Science museum", Description = "Dinosaurs and space rockets.",
				Effects = { Stats = { Intelligence = 5, Relationships = 3 }, Story = "{name} and friends spent the day at the science museum." } },
			{ Id = "Beach", Text = "The beach", Description = "Sun, sea and sandcastles.",
				Effects = { Stats = { Health = 4, Happiness = 5, Relationships = 3 }, Story = "{name} and friends had a perfect day at the beach." } },
			{ Id = "Games", Text = "Gaming marathon", Description = "Snacks. Controllers. Glory.",
				Effects = { Stats = { Happiness = 6, Relationships = 4, Health = -2 }, Story = "{name} and friends played games until sunrise." } },
		},
	},
	{
		Id = "G_Sleepover", Icon = "🛏️", Title = "The Sleepover",
		Description = "Everyone's staying over tonight! Sleeping bags, snacks and a torch.",
		Requires = { MaxAge = 15 },
		Choices = {
			{ Id = "Fort", Text = "Build a giant pillow fort", Description = "The best fort ever built.",
				Effects = { Stats = { Happiness = 6, Relationships = 4 }, Traits = { Creative = 1 }, Story = "{name} and friends built a pillow fort the size of the living room." } },
			{ Id = "Movie", Text = "Movie marathon", Description = "Popcorn till midnight.",
				Effects = { Stats = { Happiness = 5, Relationships = 3, Health = -1 }, Story = "{name} and friends watched films until they fell asleep." } },
			{ Id = "Stories", Text = "Torch-light stories", Description = "Spooky, silly or both.",
				Effects = { Stats = { Relationships = 6, Intelligence = 1 }, Story = "{name} and friends told stories by torch-light." } },
			{ Id = "Sleep", Text = "Actually go to sleep on time", Description = "The grown-ups will be impressed.",
				Effects = { Stats = { Health = 3, Reputation = 2 }, Bond = { Parent = 3 }, Story = "{name}'s sleepover went to bed on time. A miracle." } },
		},
	},
	{
		Id = "G_Playground", Icon = "🛝", Title = "Playground Adventure",
		Description = "The whole gang is at the park. What's the game today?",
		Requires = { MaxAge = 12 },
		Choices = {
			{ Id = "Tag", Text = "A huge game of tag", Description = "You're it!",
				Effects = { Stats = { Health = 5, Happiness = 4, Relationships = 3 }, Story = "{name} and friends played tag until they collapsed laughing." } },
			{ Id = "Pirates", Text = "Pirates on the climbing frame", Description = "Arrr!",
				Effects = { Stats = { Happiness = 5 }, Traits = { Creative = 1 }, Story = "{name} and friends turned the climbing frame into a pirate ship." } },
			{ Id = "Bugs", Text = "Hunt for bugs and beetles", Description = "Nature detectives.",
				Effects = { Stats = { Intelligence = 4, Happiness = 3 }, Story = "{name} and friends found eleven kinds of beetle." } },
		},
	},
	{
		Id = "G_EscapeRoom", Icon = "🔐", Title = "Escape Room Challenge",
		Description = "Sixty minutes. One locked room. Can your group get out?",
		Requires = { MinAge = 8 },
		Choices = {
			{ Id = "Team", Text = "Work as a team", Description = "Everyone shares every clue.",
				Effects = { Stats = { Relationships = 5 }, Story = "{name}'s group worked through every clue together.",
					Outcomes = { { Chance = 0.65, Stats = { Intelligence = 4, Happiness = 5 }, Story = "They escaped with two minutes to spare!" } } } },
			{ Id = "Leader", Text = "Let the smartest one lead", Description = "Follow the genius.",
				Effects = { Stats = { Intelligence = 3 }, Story = "{name}'s group followed their cleverest member.",
					Outcomes = { { Chance = 0.5, Stats = { Happiness = 5 }, Story = "Out in record time!" }, { Chance = 0.5, Stats = { Relationships = -3 }, Story = "Some people felt left out. They didn't escape." } } } },
			{ Id = "Rush", Text = "Smash through as fast as possible", Description = "Speed over thinking.",
				Effects = { Stats = { Happiness = 3 }, Story = "{name}'s group tore through the room at top speed.",
					Outcomes = { { Chance = 0.3, Stats = { Popularity = 5 }, Story = "Somehow they set the venue's speed record!" }, { Chance = 0.7, Stats = { Happiness = -2 }, Story = "They missed the final clue and the time ran out." } } } },
		},
	},
	{
		Id = "G_TalentShow", Icon = "🎙️", Title = "Talent Show",
		Description = "There's a talent show this weekend. Should your group enter together?",
		Requires = { MaxAge = 30 },
		Choices = {
			{ Id = "Sing", Text = "Sing a song together", Description = "Harmonies!",
				Effects = { Stats = { Popularity = 3, Happiness = 3 }, Story = "{name}'s group sang together on stage.",
					Outcomes = { { Chance = 0.35, Stats = { Popularity = 8, Happiness = 6 }, Flags = { "StageStar" }, Story = "They won first prize!" } } } },
			{ Id = "Comedy", Text = "Perform a comedy sketch", Description = "Make them laugh.",
				Effects = { Stats = { Popularity = 5, Happiness = 4 }, Story = "{name}'s group had the whole audience in stitches." } },
			{ Id = "Dance", Text = "Do a dance routine", Description = "Choreographed chaos.",
				Effects = { Stats = { Health = 3, Popularity = 4 }, Story = "{name}'s group danced their hearts out." } },
			{ Id = "Watch", Text = "Just watch and cheer", Description = "Front row seats.",
				Effects = { Stats = { Happiness = 2, Relationships = 3 }, Story = "{name}'s group cheered everyone on from the front row." } },
		},
	},
	{
		Id = "G_Band", Icon = "🎸", Title = "Start a Band Together",
		Description = "Someone found an old drum kit. You could start a band…",
		Requires = { MinAge = 12 },
		Choices = {
			{ Id = "Rock", Text = "A loud rock band", Description = "Guitars up to eleven.",
				Effects = { Stats = { Happiness = 5, Popularity = 3 }, Flags = { "Band" }, Story = "{name} formed a rock band with friends.",
					Outcomes = { { Chance = 0.25, Stats = { Popularity = 8 }, Flags = { "LocalLegends" }, Story = "Their first gig went viral locally!" } } } },
			{ Id = "Pop", Text = "A pop group", Description = "Catchy choruses, matching outfits.",
				Effects = { Stats = { Popularity = 5, Happiness = 3 }, Flags = { "Band" }, Story = "{name} formed a pop group with friends." } },
			{ Id = "Jam", Text = "Just jam for fun", Description = "No pressure.",
				Effects = { Stats = { Happiness = 6, Relationships = 4 }, Story = "{name} and friends jammed every weekend just for fun." } },
			{ Id = "No", Text = "Nobody can play anything", Description = "Be realistic.",
				Effects = { Stats = { Happiness = 1 }, Story = "{name}'s group decided music wasn't their thing." } },
		},
	},
	{
		Id = "G_Camping", Icon = "⛺", Title = "Camping Trip",
		Description = "Tents, a campfire and no Wi-Fi for three days.",
		Requires = { MinAge = 8 },
		Choices = {
			{ Id = "Hike", Text = "Hike to the summit", Description = "Big views, sore legs.",
				Effects = { Stats = { Health = 6, Happiness = 3 }, Traits = { Adventurous = 1 }, Story = "{name} and friends hiked to the summit at sunrise." } },
			{ Id = "Lake", Text = "Swim and fish at the lake", Description = "Relax by the water.",
				Effects = { Stats = { Happiness = 5, Health = 3 }, Story = "{name} and friends spent lazy days by the lake." } },
			{ Id = "Stories", Text = "Ghost stories all night", Description = "Who'll scream first?",
				Effects = { Stats = { Relationships = 6, Happiness = 4, Health = -1 }, Story = "{name} and friends told ghost stories until dawn." } },
			{ Id = "Cancel", Text = "Cancel: it might rain", Description = "Stay dry.",
				Effects = { Stats = { Happiness = -2 }, Story = "{name}'s group cancelled the trip. It was sunny all weekend." } },
		},
	},
	{
		Id = "G_SchoolProject", Icon = "🧪", Title = "Group Project",
		Description = "Your group has to make a project together for school.",
		Requires = { MaxAge = 18 },
		Choices = {
			{ Id = "Science", Text = "A science fair volcano", Description = "Baking soda and ambition.",
				Effects = { Stats = { Intelligence = 4 }, Story = "{name}'s group built an erupting volcano.",
					Outcomes = { { Chance = 0.4, Stats = { Intelligence = 4, Reputation = 4 }, Story = "It won the science fair!" } } } },
			{ Id = "Film", Text = "Make a short film", Description = "Lights, camera, action.",
				Effects = { Stats = { Popularity = 4, Happiness = 4 }, Traits = { Creative = 1 }, Story = "{name}'s group made a short film the whole class loved." } },
			{ Id = "Last", Text = "Leave it to the last minute", Description = "It'll be fine.",
				Effects = { Stats = { Happiness = 2 }, Story = "{name}'s group left it to the night before.",
					Outcomes = { { Chance = 0.5, Stats = { Intelligence = -3, Reputation = -2 }, Story = "It was not fine." } } } },
		},
	},
	{
		Id = "G_Charity", Icon = "🎗️", Title = "Charity Challenge",
		Description = "A local charity needs fundraisers. Your group wants to help.",
		Requires = { MinAge = 10 },
		Choices = {
			{ Id = "Run", Text = "A sponsored run", Description = "Run for a cause.",
				Effects = { Stats = { Health = 5, Reputation = 5 }, Traits = { Kind = 1 }, Story = "{name} and friends ran 10k for charity." } },
			{ Id = "Bake", Text = "A bake sale", Description = "Cakes for good.",
				Effects = { Stats = { Reputation = 4, Happiness = 3 }, Story = "{name}'s group's bake sale sold out in an hour." } },
			{ Id = "Gala", Text = "Host a fancy gala", Requires = { MinAge = 21 }, LockHint = "Everyone must be 21+", Description = "Black tie, big donations.",
				Effects = { Money = -300, Stats = { Reputation = 8, Popularity = 4 }, Story = "{name}'s group hosted a gala that raised thousands." } },
			{ Id = "Skip", Text = "Maybe another time", Description = "Too busy.",
				Effects = { Stats = { Reputation = -2 }, Story = "{name}'s group didn't take part." } },
		},
	},
	{
		Id = "G_Business", Icon = "🤝", Title = "Start a Business Together",
		Description = "Your group has an idea. Everyone would put in money and share the risk.",
		Requires = { MinAge = 19 },
		Choices = {
			{ Id = "FoodTruck", Text = "A food truck", Requires = { MinMoney = 2000 }, LockHint = "Everyone needs $2,000", Description = "Street food, split four ways.",
				Effects = { Money = -2000, Stats = { Happiness = 3 }, Story = "{name} and friends launched a food truck together.",
					Outcomes = { { Chance = 0.55, Money = 9000, Stats = { Happiness = 4, Career = 3 }, Story = "Queues round the block! Everyone made a profit." }, { Chance = 0.45, Stats = { Happiness = -3 }, Story = "It never quite took off." } } } },
			{ Id = "Startup", Text = "A tech startup", Requires = { MinMoney = 10000 }, LockHint = "Everyone needs $10,000", Description = "Moonshot.",
				Effects = { Money = -10000, Stats = { Career = 3 }, Traits = { Ambitious = 1 }, Story = "{name} and friends founded a startup together.",
					Outcomes = { { Chance = 0.3, Money = 90000, Stats = { Reputation = 6, Happiness = 6 }, Flags = { "StartupFounder" }, Story = "A huge company bought it. They all got rich!" }, { Chance = 0.7, Stats = { Happiness = -5 }, Story = "The money ran out." } } } },
			{ Id = "Cafe", Text = "A cosy café", Requires = { MinMoney = 4000 }, LockHint = "Everyone needs $4,000", Description = "Good coffee, good vibes.",
				Effects = { Money = -4000, Stats = { Happiness = 4, Relationships = 3 }, Story = "{name} and friends opened a café together.",
					Outcomes = { { Chance = 0.5, Money = 11000, Story = "It became the neighbourhood's favourite spot." } } } },
			{ Id = "No", Text = "Too risky. Stay friends, not partners", Description = "Protect the friendship.",
				Effects = { Stats = { Relationships = 3 }, Story = "{name}'s group decided not to mix money and friendship." } },
		},
	},
	{
		Id = "G_RoadTrip", Icon = "🚐", Title = "Road Trip!",
		Description = "One van, one playlist, a long open road.",
		Requires = { MinAge = 18 },
		Choices = {
			{ Id = "Coast", Text = "The coast road", Description = "Cliffs and sunsets.",
				Effects = { Money = -500, Stats = { Happiness = 7, Relationships = 4 }, Story = "{name} and friends drove the coast road with the windows down." } },
			{ Id = "Festivals", Text = "Festival hopping", Description = "Music every night.",
				Effects = { Money = -700, Stats = { Popularity = 5, Happiness = 6, Health = -2 }, Story = "{name} and friends danced at three festivals in a week." } },
			{ Id = "Parks", Text = "National parks", Description = "Mountains, canyons, stars.",
				Effects = { Money = -400, Stats = { Health = 5, Happiness = 5 }, Traits = { Adventurous = 1 }, Story = "{name} and friends camped under the stars in national parks." } },
			{ Id = "Stay", Text = "Stay home and save money", Description = "Next year.",
				Effects = { Money = 200, Stats = { Happiness = -2 }, Story = "{name}'s group stayed home." } },
		},
	},
	{
		Id = "G_Holiday", Icon = "🏝️", Title = "Holiday Together",
		Description = "The group chat has decided: you're all going away together.",
		Requires = { MinAge = 18 },
		Choices = {
			{ Id = "Resort", Text = "Beach resort", Requires = { MinMoney = 2000 }, LockHint = "Everyone needs $2,000", Description = "Pools and sunshine.",
				Effects = { Money = -2000, Stats = { Happiness = 9, Health = 3, Relationships = 4 }, Story = "{name} and friends spent a blissful week at a beach resort." } },
			{ Id = "City", Text = "City break", Requires = { MinMoney = 1200 }, LockHint = "Everyone needs $1,200", Description = "Culture and cafés.",
				Effects = { Money = -1200, Stats = { Intelligence = 3, Happiness = 6 }, Story = "{name} and friends explored a beautiful old city." } },
			{ Id = "Trek", Text = "Adventure trek", Description = "Backpacks and blisters.",
				Effects = { Money = -600, Stats = { Health = 7, Happiness = 4 }, Traits = { Adventurous = 1 }, Story = "{name} and friends trekked through the mountains." } },
			{ Id = "Staycation", Text = "Staycation", Description = "Cheap and cheerful.",
				Effects = { Stats = { Happiness = 3, Relationships = 3 }, Story = "{name} and friends had a staycation full of board games." } },
		},
	},
	{
		Id = "G_Invest", Icon = "📊", Title = "A Hot Investment Tip",
		Description = "Someone in the group heard about a 'can't-miss' investment.",
		Requires = { MinAge = 21, MinMoney = 6000 },
		Choices = {
			{ Id = "Pool", Text = "Everyone puts in $5,000", Description = "Go big together.",
				Effects = { Money = -5000, Story = "{name}'s group pooled their money into the tip.",
					Outcomes = { { Chance = 0.45, Money = 16000, Stats = { Happiness = 6 }, Story = "It paid off, big time!" }, { Chance = 0.55, Stats = { Happiness = -6 }, Story = "It was a dud. The money was gone." } } } },
			{ Id = "Little", Text = "Just put in a little", Description = "$1,000 each.",
				Effects = { Money = -1000, Story = "{name}'s group put a little in.",
					Outcomes = { { Chance = 0.6, Money = 2500, Story = "A tidy profit." } } } },
			{ Id = "Ignore", Text = "Sounds like a scam", Description = "Walk away.",
				Effects = { Stats = { Intelligence = 2 }, Story = "{name}'s group smelled a scam and walked away." } },
