        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Twists</string>
            <string name="Source"><![CDATA[--[[
	Life Reveal twists  (ServerScriptService.Server.Content.Twists)
	"Even if a future looks predictable, anything can happen."
	At the end of a stage, Lib/Reveal may roll a twist (Config.TwistChance):
	  • Setback: if one future looks very likely (60%+), a twist that works
	    against it (Counters lists which futures it can upset)
	  • Rescue: if a risk (Hard times / Lonely) looks likely, a twist that helps
	  • Surprise: otherwise, an unexpected turn
	Twists apply real effects (Consequences format) and the reveal shows the
	odds before and after. Each twist happens at most once per life.
]]

local KID, TEEN, YOUNG, ADULT, MID = 1, 2, 3, 4, 5

return {
	-- ===== Setbacks =====
	{ Id = "TW_Crash", Kind = "Setback", Icon = "📉", Title = "The Crash", Stages = { YOUNG, ADULT, MID }, Counters = { "Millionaire" }, Requires = { MinMoney = 20000 },
		Effects = { MoneyPercent = -0.5, InvestPercent = -0.5, Stats = { Happiness = -8 }, Story = "Out of nowhere, a global financial crash wiped out half of everything {name} had saved." } },
	{ Id = "TW_Scandal", Kind = "Setback", Icon = "📰", Title = "Scandal at Work", Stages = { YOUNG, ADULT, MID }, Counters = { "Career", "Respected" }, Requires = { HasCareer = true },
		Effects = { Promote = -1, Stats = { Career = -12, Reputation = -10 }, Story = "A colleague's lie dragged {name} into a workplace scandal. It took years to clear their name." } },
	{ Id = "TW_Illness", Kind = "Setback", Icon = "🏥", Title = "A Serious Illness", Stages = { TEEN, YOUNG, ADULT, MID }, Counters = { "Healthy", "Content", "Genius" },
		Effects = { Stats = { Health = -18, Happiness = -6 }, Story = "{name} fell seriously ill. Recovery was long and slow." } },
	{ Id = "TW_Heartbreak", Kind = "Setback", Icon = "💔", Title = "Heartbreak", Stages = { YOUNG, ADULT, MID }, Counters = { "Family", "Content" }, Requires = { Partner = true },
		Effects = { Partner = false, Stats = { Happiness = -10 }, Story = "Without warning, {name}'s partner left. Everything they'd planned together was gone." } },
	{ Id = "TW_FameFades", Kind = "Setback", Icon = "🕯️", Title = "Yesterday's News", Stages = { TEEN, YOUNG, ADULT, MID }, Counters = { "Fame" }, Requires = { MinStats = { Popularity = 55 } },
		Effects = { Stats = { Popularity = -18, Happiness = -5 }, Story = "The spotlight moved on. Almost overnight, nobody was talking about {name} any more." } },
	{ Id = "TW_FallOut", Kind = "Setback", Icon = "🌪️", Title = "A Bitter Falling-Out", Stages = { TEEN, YOUNG, ADULT, MID }, Counters = { "Respected", "Family", "Adventurer" },
		Effects = { Bond = { All = -15 }, Stats = { Reputation = -6, Relationships = -8 }, Story = "A misunderstanding spiralled into a falling-out that split {name}'s circle in two." } },

	-- ===== Rescues =====
	{ Id = "TW_Inheritance", Kind = "Rescue", Icon = "📜", Title = "A Secret Inheritance", Stages = { YOUNG, ADULT, MID }, Counters = { "Struggling" },
		Effects = { Money = 150000, Stats = { Happiness = 8 }, Story = "A letter from a lawyer: a relative {name} had never met had left them $150,000." } },
	{ Id = "TW_Partnership", Kind = "Rescue", Icon = "🤝", Title = "The Offer of a Lifetime", Stages = { YOUNG, ADULT, MID }, Counters = { "Struggling" }, Requires = { HasCareer = false },
		Effects = { Career = "BusinessOwner", Promote = 1, Money = 20000, Stats = { Happiness = 8, Career = 8 }, Story = "An old friend offered {name} a partnership in their thriving business. Life turned around overnight." } },
	{ Id = "TW_NewCircle", Kind = "Rescue", Icon = "🎊", Title = "A New Circle", Stages = { TEEN, YOUNG, ADULT, MID }, Counters = { "Lonely", "Struggling" },
		Effects = { Friends = 3, Meet = "BestFriend", Stats = { Happiness = 10, Relationships = 10 }, Story = "A chance invitation led {name} into a warm, welcoming group of new friends." } },
	{ Id = "TW_SecondChance", Kind = "Rescue", Icon = "💌", Title = "A Second Chance at Love", Stages = { YOUNG, ADULT, MID }, Counters = { "Lonely" }, Requires = { Partner = false },
		Effects = { Partner = true, Stats = { Happiness = 10, Relationships = 8 }, Story = "Just when {name} had stopped looking, love found them." } },

	-- ===== Surprises =====
	{ Id = "TW_Prodigy", Kind = "Surprise", Icon = "🎹", Title = "An Extraordinary Talent", Stages = { KID, TEEN }, Counters = {},
		Effects = { Flags = { "MusicTalent", "Prodigy" }, Stats = { Intelligence = 6, Popularity = 6, Happiness = 6 }, Story = "An ordinary afternoon, a borrowed piano, and {name} played like they'd practised for years. A prodigy." } },
	{ Id = "TW_BigIdea", Kind = "Surprise", Icon = "💡", Title = "The Big Idea", Stages = { TEEN, YOUNG, ADULT, MID }, Counters = {},
		Effects = { Flags = { "BigIdea" }, Stats = { Intelligence = 6, Career = 8 }, Traits = { Ambitious = 1 }, Story = "At 3am, {name} sat up in bed with an idea that would change the direction of their life." } },
	{ Id = "TW_HiddenTalent", Kind = "Surprise", Icon = "💎", Title = "A Hidden Gift", Stages = { YOUNG, ADULT, MID }, Counters = {},
		Effects = { Flags = { "LateBloomer" }, Stats = { Popularity = 10, Happiness = 8 }, Story = "{name} discovered a gift they never knew they had, and people couldn't stop talking about it." } },
	{ Id = "TW_Windfall", Kind = "Surprise", Icon = "🍀", Title = "A Lucky Break", Stages = { TEEN, YOUNG, ADULT, MID }, Counters = {},
		Effects = { Money = 40000, Stats = { Happiness = 6 }, Story = "A forgotten investment of {name}'s grandparent's turned out to be worth $40,000." } },
	{ Id = "TW_Sibling", Kind = "Surprise", Icon = "🧬", Title = "A Long-Lost Sibling", Stages = { YOUNG, ADULT, MID }, Counters = {},
		Effects = { Meet = "Sibling", Stats = { Relationships = 6, Happiness = 6 }, Story = "A DNA test revealed {name} had a sibling they'd never known. They met, and it felt like they always had." } },
	{ Id = "TW_Mentor", Kind = "Surprise", Icon = "🦉", Title = "An Unexpected Mentor", Stages = { KID, TEEN, YOUNG }, Counters = {},
		Effects = { Stats = { Intelligence = 6, Reputation = 4, Career = 4 }, Traits = { Studious = 1 }, Story = "A brilliant retired professor took an interest in {name} and changed how they saw the world." } },
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="39">
        <Properties>
          <string name="Name">Lib</string>
        </Properties>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Actions</string>
            <string name="Source"><![CDATA[--[[
	Actions  (ServerScriptService.Server.Lib.Actions)
	Things a player can do between decisions, from the People, Lifestyle and
	Money panels. Every function validates its input, mutates `life` in place
	and returns ok, result | reason. LifeService wraps them in remotes and
	DataService.Update.

	People actions (limited to People.ActionsPerTurn per decision):
	  Interact(personId, "Time" | "Gift" | "Talk")
	  Meet("Friend" | "Love")
	Free actions:
	  SetFocus(focusId)
	  Invest(amount), Withdraw(amount), RepayLoan(index, amount)   (age 18+)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local People = require(Shared.Util.People)
local Lifestyle = require(Shared.Data.Lifestyle)
local Format = require(Shared.Util.Format)
local Consequences = require(script.Parent.Consequences)

local Actions = {}

Actions.MinFinanceAge = 18
Actions.MinLoveAge = 18

function Actions.ActionsLeft(life): number
	if life.ActionTurn ~= #life.Decisions then
		return People.ActionsPerTurn
	end
	return math.max(0, People.ActionsPerTurn - life.ActionsUsed)
end

local function useAction(life)
	if life.ActionTurn ~= #life.Decisions then
		life.ActionTurn = #life.Decisions
		life.ActionsUsed = 0
	end
	life.ActionsUsed += 1
end

local function finish(life, summary, text: string)
	Consequences.SyncWealth(life)
	return true, {
		Text = text,
		Applied = summary.Applied,
		BondChanges = summary.BondChanges,
		LifeChanges = summary.LifeChanges,
		ActionsLeft = Actions.ActionsLeft(life),
	}
end

function Actions.Interact(life, personId: string, action: string, rng)
	if life.Completed then
		return false, "NoLife"
	end
	local person = People.Find(life, personId)
	if not person then
		return false, "NoSuchPerson"
	end
	if action ~= "Time" and action ~= "Gift" and action ~= "Talk" then
		return false, "BadAction"
	end
	if person.Role == "Ex" and action ~= "Talk" then
		return false, "BadAction"
	end
	if Actions.ActionsLeft(life) <= 0 then
		return false, "NoActionsLeft"
	end
	local summary = Consequences.NewSummary(rng)
	local text
	if action == "Time" then
		Consequences.ChangeBond(person, 7, summary)
		Consequences.AddStats(life, { Happiness = 1 }, summary, false)
		text = "You spent quality time with " .. person.Name .. "."
	elseif action == "Gift" then
		local cost = People.GiftCost(life)
		if life.Money < cost then
			return false, "NotEnoughMoney"
		end
		life.Money -= cost
		summary.MoneyDelta -= cost
		Consequences.ChangeBond(person, 10, summary)
		text = ("You gave %s a gift (%s). They loved it!"):format(person.Name, Format.Money(cost))
	else
		local deep = rng:NextNumber() < 0.25
		Consequences.ChangeBond(person, if deep then 9 else 4, summary)
		Consequences.AddStats(life, { Relationships = 1 }, summary, false)
		text = if deep then ("You and %s had a heart-to-heart that brought you much closer."):format(person.Name) else ("You had a good talk with %s."):format(person.Name)
	end
	useAction(life)
	return finish(life, summary, text)
end

function Actions.Meet(life, kind: string, rng)
	if life.Completed then
		return false, "NoLife"
	end
	if kind ~= "Friend" and kind ~= "Love" then
		return false, "BadAction"
	end
	if Actions.ActionsLeft(life) <= 0 then
		return false, "NoActionsLeft"
	end
	local summary = Consequences.NewSummary(rng)
	local text
	if kind == "Friend" then
		if life.Relationships.Friends >= People.MaxFriends then
			return false, "TooManyFriends"
		end
		local chance = 0.35 + life.Stats.Popularity / 200
		if rng:NextNumber() < chance then
			local friend = People.Add(life, "Friend", rng)
			table.insert(summary.LifeChanges, "🙂 New friend: " .. friend.Name)
			text = "You hit it off with " .. friend.Name .. "!"
		else
			text = "You put yourself out there, but nobody clicked this time."
		end
	else
		if life.Age < Actions.MinLoveAge then
			return false, "TooYoung"
		end
		if People.Partner(life) then
			return false, "AlreadyTaken"
		end
		local chance = 0.25 + (life.Stats.Popularity + life.Stats.Happiness) / 400
		if rng:NextNumber() < chance then
			local partner = People.Add(life, "Partner", rng)
			table.insert(summary.LifeChanges, "❤️ In a relationship with " .. partner.Name)
			Consequences.AddStats(life, { Happiness = 5 }, summary, false)
			text = ("You met %s. Sparks flew!"):format(partner.Name)
		else
			Consequences.AddStats(life, { Happiness = -1 }, summary, false)
			text = "A few dates, but no spark. Maybe next time."
		end
	end
	useAction(life)
	return finish(life, summary, text)
end

function Actions.SetFocus(life, focusId: string)
	if not Lifestyle.IsValid(focusId) then
		return false, "BadFocus"
	end
	if not Lifestyle.Available(focusId, life.Age) then
		return false, "TooYoung"
	end
	life.Focus = focusId
	return true, { Focus = focusId }
end

local function checkAmount(amount: any, max: number): number?
	if type(amount) ~= "number" or amount ~= amount or amount % 1 ~= 0 or amount < 1 or amount > max then
		return nil
	end
	return amount
end

function Actions.Invest(life, amount: any)
	if life.Age < Actions.MinFinanceAge then
		return false, "TooYoung"
	end
	local value = checkAmount(amount, life.Money)
	if not value then
		return false, "BadAmount"
	end
	life.Money -= value
	life.Investments = (life.Investments or 0) + value
	Consequences.SyncWealth(life)
	return true, { Money = life.Money, Investments = life.Investments }
end

function Actions.Withdraw(life, amount: any)
	if life.Age < Actions.MinFinanceAge then
		return false, "TooYoung"
	end
	local value = checkAmount(amount, life.Investments or 0)
	if not value then
		return false, "BadAmount"
	end
	life.Investments -= value
	life.Money += value
	Consequences.SyncWealth(life)
	return true, { Money = life.Money, Investments = life.Investments }
end

function Actions.RepayLoan(life, index: any, amount: any)
	if type(index) ~= "number" or index % 1 ~= 0 then
		return false, "BadLoan"
	end
	local loan = life.Loans[index]
	if not loan then
		return false, "BadLoan"
	end
	local value = checkAmount(amount, math.min(life.Money, loan.Balance))
	if not value then
		return false, "BadAmount"
	end
	life.Money -= value
	loan.Balance -= value
	local paidOff = loan.Balance <= 0
	if paidOff then
		table.remove(life.Loans, index)
	end
	Consequences.SyncWealth(life)
	return true, { Money = life.Money, PaidOff = paidOff }
end

return Actions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Conditions</string>
            <string name="Source"><![CDATA[--[[
	Conditions  (ServerScriptService.Server.Lib.Conditions)
	Evaluates a `Requires` table against a life. Used by scenarios and by
	individual choices, which is how earlier decisions unlock (or close off)
	later branches.

	Requires = {
		Flags      = { "A", "B" },    -- all must be set
		AnyFlags   = { "A", "B" },    -- at least one must be set
		NotFlags   = { "C" },         -- none may be set
		MinStats   = { Intelligence = 60 },
		MaxStats   = { Health = 30 },
		MinTraits  = { Studious = 2 },
		MinMoney   = 1000,
		MinAge     = 7,  MaxAge = 10,
		-- life situation
		HasCareer  = true | false,
		Careers    = { "Doctor", "Lawyer" },  -- current career is one of these
		NotCareers = { "ShopAssistant" },
		MinCareerLevel = 3,
		MinEducation = "University",          -- None < School < University < Masters
		MaxEducation = "School",
		Partner    = true | false,
		Married    = true | false,
		MinChildren = 1, MaxChildren = 0,
		Assets     = { "House" },             -- owns all of these
		AnyAssets  = { "House", "Mansion" },
		NotAssets  = { "Mansion" },
		-- people & finances
		HasRole    = { "BestFriend" },        -- has someone in each of these roles
		NotRole    = { "Partner" },
		MinBond    = { Partner = 40 },         -- best bond among people in that role
		MaxBond    = { Partner = 30 },         -- (role must exist for MaxBond to pass)
		MinFriends = 2, MaxFriends = 0,
		HasLoan    = "Mortgage", NoLoans = true,
		MinInvestments = 10000,
		Focus      = { "Career", "Money" },
	}
	Every field is optional; nil or {} always passes.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Careers = require(ReplicatedStorage:WaitForChild("Shared").Data.Careers)
local People = require(ReplicatedStorage:WaitForChild("Shared").Util.People)

local Conditions = {}

local function hasCareer(life): boolean
	return life.Career.Id ~= "None" and Careers.Info[life.Career.Id] ~= nil
end
Conditions.HasCareer = hasCareer

function Conditions.Check(life, requires): boolean
	if not requires then
		return true
	end
	local flags = life.Flags
	if requires.Flags then
		for _, flag in ipairs(requires.Flags) do
			if not flags[flag] then
				return false
			end
		end
	end
	if requires.AnyFlags then
		local any = false
		for _, flag in ipairs(requires.AnyFlags) do
			if flags[flag] then
				any = true
				break
			end
		end
		if not any then
			return false
		end
	end
	if requires.NotFlags then
		for _, flag in ipairs(requires.NotFlags) do
			if flags[flag] then
				return false
			end
		end
	end
	if requires.MinStats then
		for stat, min in pairs(requires.MinStats) do
			if (life.Stats[stat] or 0) < min then
				return false
			end
		end
	end
	if requires.MaxStats then
		for stat, max in pairs(requires.MaxStats) do
			if (life.Stats[stat] or 0) > max then
				return false
			end
		end
	end
	if requires.MinTraits then
		for trait, min in pairs(requires.MinTraits) do
			if (life.Traits[trait] or 0) < min then
				return false
			end
		end
	end
	if requires.MinMoney and life.Money < requires.MinMoney then
		return false
	end
	if requires.MinAge and life.Age < requires.MinAge then
		return false
	end
	if requires.MaxAge and life.Age > requires.MaxAge then
		return false
	end
	if requires.HasCareer ~= nil and hasCareer(life) ~= requires.HasCareer then
		return false
	end
	if requires.Careers and not table.find(requires.Careers, life.Career.Id) then
		return false
	end
	if requires.NotCareers and table.find(requires.NotCareers, life.Career.Id) then
		return false
	end
	if requires.MinCareerLevel and (not hasCareer(life) or life.Career.Level < requires.MinCareerLevel) then
		return false
	end
	local educationRank = Careers.EducationRank[life.Education] or 0
	if requires.MinEducation and educationRank < Careers.EducationRank[requires.MinEducation] then
		return false
	end
	if requires.MaxEducation and educationRank > Careers.EducationRank[requires.MaxEducation] then
		return false
	end
	local rel = life.Relationships
	if requires.Partner ~= nil and (rel.Partner == true) ~= requires.Partner then
		return false
	end
	if requires.Married ~= nil and (rel.Married == true) ~= requires.Married then
		return false
	end
	if requires.MinChildren and rel.Children < requires.MinChildren then
		return false
	end
	if requires.MaxChildren and rel.Children > requires.MaxChildren then
		return false
	end
	if requires.Assets then
		for _, asset in ipairs(requires.Assets) do
			if not life.Assets[asset] then
				return false
			end
		end
	end
	if requires.AnyAssets then
		local any = false
		for _, asset in ipairs(requires.AnyAssets) do
			if life.Assets[asset] then
				any = true
				break
			end
		end
		if not any then
			return false
		end
	end
	if requires.NotAssets then
		for _, asset in ipairs(requires.NotAssets) do
			if life.Assets[asset] then
				return false
			end
		end
	end
	if requires.HasRole then
		for _, role in ipairs(requires.HasRole) do
			if #People.ByRole(life, role) == 0 then
				return false
			end
		end
	end
	if requires.NotRole then
		for _, role in ipairs(requires.NotRole) do
			if #People.ByRole(life, role) > 0 then
				return false
			end
		end
	end
	local function bestBond(role)
		local best = nil
		for _, person in ipairs(People.ByRole(life, role)) do
			best = math.max(best or 0, person.Bond)
		end
		return best
	end
	if requires.MinBond then
		for role, min in pairs(requires.MinBond) do
			local bond = bestBond(role)
			if not bond or bond < min then
				return false
			end
		end
	end
	if requires.MaxBond then
		for role, max in pairs(requires.MaxBond) do
			local bond = bestBond(role)
			if not bond or bond > max then
				return false
			end
		end
	end
	if requires.MinFriends and rel.Friends < requires.MinFriends then
		return false
	end
	if requires.MaxFriends and rel.Friends > requires.MaxFriends then
		return false
	end
	if requires.HasLoan then
		local found = false
		for _, loan in ipairs(life.Loans) do
			if loan.Kind == requires.HasLoan then
				found = true
			end
		end
		if not found then
			return false
		end
	end
	if requires.NoLoans and #life.Loans > 0 then
		return false
	end
	if requires.MinInvestments and (life.Investments or 0) < requires.MinInvestments then
		return false
	end
	if requires.Focus and not table.find(requires.Focus, life.Focus) then
		return false
	end
	return true
end

return Conditions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">Consequences</string>
            <string name="Source"><![CDATA[--[[
	Consequences  (ServerScriptService.Server.Lib.Consequences)
	Applies an Effects table (from a choice or a random event) to a life IN
	PLACE and returns a summary for the client. LifeService calls it inside
	DataService.Update so a whole decision is applied atomically.

	Effects = {
		-- immediate
		Stats        = { Intelligence = 6, Happiness = -2 },  -- Wealth is derived; don't set it
		Money        = 50,              -- flat change
		MoneyPercent = -0.3,            -- change by a share of current money (e.g. a crash)
		-- long-term
		Flags        = { "StudiedEarly" }, ClearFlags = { "Shy" },
		Traits       = { Studious = 1 },
		Career       = "Doctor" | "None", -- start a new career at level 1 (or lose your job)
		Promote      = 1,               -- move up career levels
		Retire       = true,            -- stop working; pension from PeakSalary
		Education    = "University",    -- raised only if higher than current
		Partner      = true | false,    Married = true | false,   -- creates/ends named people
		Children     = 1,               Friends = 2,
		Meet         = "BestFriend",    -- a new person in a role (BestFriend promotes your closest friend)
		Bond         = { Partner = 8, Child = 5, Friend = 3, Parent = 4, BestFriend = 6, Sibling = 3, All = 2 },
		Loan         = { Kind = "Mortgage", Amount = 208000, Years = 25, Rate = 0.04 },
		RepayLoan    = { Kind = "Student", Amount = 1500 },
		InvestPercent = 0.25,           -- grow/shrink invested money
		Farewell     = "Parent",        -- someone in that role passes away (gently, late in life)
		Reunite      = true,            -- get back together with an ex (if single)
		Assets       = { "House" },     RemoveAssets = { "Apartment" },
		Story        = "Text. {name} is replaced.",
		Outcomes     = { { Chance = 0.3, ...any of the above... }, ... },  -- at most one triggers
	}
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local StatMath = require(Shared.Util.StatMath)
local TableUtil = require(Shared.Util.TableUtil)
local Traits = require(Shared.Data.Traits)
local Careers = require(Shared.Data.Careers)
local Assets = require(Shared.Data.Assets)
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local People = require(Shared.Util.People)
local Budget = require(Shared.Util.Budget)

local Consequences = {}

local function personalise(text: string?, life): string?
	if not text then
		return nil
	end
	return (text:gsub("{name}", life.Name))
end

function Consequences.NetWorth(life): number
	return Budget.NetWorth(life)
end

function Consequences.SyncWealth(life)
	life.Stats.Wealth = StatMath.WealthFromNetWorth(math.max(0, Consequences.NetWorth(life)))
end

Consequences.LoanKinds = { Student = { Rate = 0.03, Years = 15, Title = "Student loan" }, Mortgage = { Rate = 0.04, Years = 25, Title = "Mortgage" } }

-- Records a bond change for the outcome card (merged per person).
local function noteBond(summary, person, delta: number)
	if math.abs(delta) < 0.05 then
		return
	end
	for _, entry in ipairs(summary.BondChanges) do
		if entry.Id == person.Id then
			entry.Delta += delta
			return
		end
	end
	table.insert(summary.BondChanges, { Id = person.Id, Name = person.Name, Role = person.Role, Delta = delta })
end
Consequences.NoteBond = noteBond

function Consequences.ChangeBond(person, delta: number, summary)
	noteBond(summary, person, People.ChangeBond(person, delta))
end

-- Ends the current relationship: partner becomes an Ex.
function Consequences.EndRelationship(life, summary, text: string?)
	local partner = People.Partner(life)
	if not partner then
		return
	end
	local wasMarried = partner.Married == true
	partner.Role = "Ex"
	partner.Married = nil
	partner.Bond = math.min(partner.Bond, 25)
	People.Sync(life)
	table.insert(summary.LifeChanges, text or ((if wasMarried then "📄 Divorced from " else "💔 Broke up with ") .. partner.Name))
end

local function addStats(life, deltas, summary, useTraits: boolean)
	local multipliers = if useTraits then Traits.GainMultipliers(life.Traits) else {}
	local scaled = {}
	for stat, delta in pairs(deltas) do
		if stat ~= "Wealth" then
			scaled[stat] = if delta > 0 then delta * (multipliers[stat] or 1) else delta
		end
	end
	local newStats, applied = StatMath.Apply(life.Stats, scaled)
	life.Stats = newStats
	for stat, change in pairs(applied) do
		summary.Applied[stat] = (summary.Applied[stat] or 0) + change
	end
end
Consequences.AddStats = addStats

local function changeMoney(life, amount: number, summary)
	local before = life.Money
	life.Money = math.max(0, math.floor(life.Money + amount))
	summary.MoneyDelta += life.Money - before
end

local function setCareer(life, careerId: string, summary)
	if careerId == "None" then
		if life.Career.Id ~= "None" then
			table.insert(summary.LifeChanges, "💼 Left job as " .. Careers.TitleAt(life.Career.Id, life.Career.Level))
		end
		life.Career = { Id = "None", Level = 0, YearsInRole = 0 }
		return
	end
	if not Careers.Info[careerId] or life.Career.Id == careerId then
		return
	end
	life.Career = { Id = careerId, Level = 1, YearsInRole = 0 }
	life.Flags["Was_" .. careerId] = true
	life.PeakCareerLevel = math.max(life.PeakCareerLevel or 0, 1)
	Consequences.TrackBestCareer(life)
	life.PeakSalary = math.max(life.PeakSalary or 0, Careers.SalaryAt(careerId, 1))
	table.insert(summary.LifeChanges, Careers.Info[careerId].Icon .. " New career: " .. Careers.TitleAt(careerId, 1))
end

-- Remembers the best career this life ever had (for endings and Life History).
function Consequences.TrackBestCareer(life)
	local current = life.Career
	if current.Id == "None" then
		return
	end
	local bestCareer = life.BestCareer
	if not bestCareer or current.Level > bestCareer.Level or (current.Level == bestCareer.Level and Careers.SalaryAt(current.Id, current.Level) > Careers.SalaryAt(bestCareer.Id, bestCareer.Level)) then
		life.BestCareer = { Id = current.Id, Level = current.Level }
	end
end

-- Career Success needed for the top levels: 62+ for level 4, 80+ for level 5.
function Consequences.MaxLevelForCareerStat(careerStat: number): number
	if careerStat >= 80 then
		return 5
	elseif careerStat >= 62 then
		return 4
	end
	return 3
end

function Consequences.Promote(life, levels: number, summary)
	local career = life.Career
	if career.Id == "None" or not Careers.Info[career.Id] then
		return false
	end
	local newLevel = math.clamp(career.Level + levels, 1, Careers.MaxLevel)
	if newLevel == career.Level then
		return false
	end
	local up = newLevel > career.Level
	-- The top roles need a strong track record (Career Success stat).
	if up then
		local cap = Consequences.MaxLevelForCareerStat(life.Stats.Career)
		if newLevel > cap then
			if cap <= career.Level then
				table.insert(summary.LifeChanges, ("📋 Not quite ready to be %s yet: build your Career Success"):format(Careers.TitleAt(career.Id, career.Level + 1)))
				addStats(life, { Career = 3 }, summary, false)
				return false
			end
			newLevel = cap
		end
	end
	career.Level = newLevel
	career.YearsInRole = 0
	life.PeakCareerLevel = math.max(life.PeakCareerLevel or 0, newLevel)
	Consequences.TrackBestCareer(life)
	life.PeakSalary = math.max(life.PeakSalary or 0, Careers.SalaryAt(career.Id, newLevel))
	table.insert(summary.LifeChanges, (if up then "📈 Promoted to " else "📉 Demoted to ") .. Careers.TitleAt(career.Id, newLevel))
	addStats(life, { Career = if up then 6 else -6 }, summary, false)
	return true
end

-- Applies one Effects-shaped table (base effects or a single outcome).
local function applyBlock(life, block, summary)
	if block.Stats then
		addStats(life, block.Stats, summary, true)
	end
	if type(block.Money) == "number" and block.Money ~= 0 then
		changeMoney(life, block.Money, summary)
	end
	if type(block.MoneyPercent) == "number" and block.MoneyPercent ~= 0 then
		changeMoney(life, life.Money * block.MoneyPercent, summary)
	end
	if block.Flags then
		for _, flag in ipairs(block.Flags) do
			if not life.Flags[flag] then
				life.Flags[flag] = true
				table.insert(summary.FlagsAdded, flag)
			end
		end
	end
	if block.ClearFlags then
		for _, flag in ipairs(block.ClearFlags) do
			life.Flags[flag] = nil
		end
	end
	if block.Traits then
		for trait, change in pairs(block.Traits) do
			if Traits.IsValid(trait) then
				local before = life.Traits[trait] or 0
				local after = math.clamp(before + change, 0, Traits.MaxStrength)
				life.Traits[trait] = if after > 0 then after else nil
				if before == 0 and after > 0 then
					table.insert(summary.TraitsGained, trait)
				end
			end
		end
	end
	if block.Retire then
		if not life.Flags.Retired then
			life.Flags.Retired = true
			if life.Career.Id ~= "None" then
				table.insert(summary.LifeChanges, "🏖️ Retired as " .. Careers.TitleAt(life.Career.Id, life.Career.Level))
			else
				table.insert(summary.LifeChanges, "🏖️ Retired")
			end
			life.Career = { Id = "None", Level = 0, YearsInRole = 0 }
		end
	end
	if type(block.Career) == "string" then
		setCareer(life, block.Career, summary)
	end
	if type(block.Promote) == "number" and block.Promote ~= 0 then
		Consequences.Promote(life, block.Promote, summary)
	end
	if type(block.Education) == "string" and Careers.EducationRank[block.Education] then
		if Careers.EducationRank[block.Education] > (Careers.EducationRank[life.Education] or 0) then
			life.Education = block.Education
			if Careers.EducationRank[block.Education] >= 2 then
				table.insert(summary.LifeChanges, "🎓 Earned a " .. Careers.EducationNames[block.Education])
			end
		end
	end
	local rng = summary._rng
	if block.Reunite and not People.Partner(life) then
		local ex = People.ByRole(life, "Ex")[1]
		if ex then
			ex.Role = "Partner"
			ex.Bond = math.max(ex.Bond, 60)
			People.Sync(life)
			table.insert(summary.LifeChanges, "❤️ Back together with " .. ex.Name)
		end
	end
	if block.Partner ~= nil then
		local partner = People.Partner(life)
		if block.Partner == true and not partner then
			partner = People.Add(life, "Partner", rng)
			table.insert(summary.LifeChanges, "❤️ In a relationship with " .. partner.Name)
		elseif block.Partner == false and partner then
			Consequences.EndRelationship(life, summary)
		end
	end
	if block.Married ~= nil then
		local partner = People.Partner(life)
		if block.Married == true then
			if not partner then
				partner = People.Add(life, "Partner", rng)
			end
			if not partner.Married then
				partner.Married = true
				People.ChangeBond(partner, 10)
				table.insert(summary.LifeChanges, "💍 Married " .. partner.Name)
			end
		elseif partner and partner.Married then
			Consequences.EndRelationship(life, summary)
		end
		People.Sync(life)
	end
	if type(block.Children) == "number" and block.Children > 0 then
		local names = {}
		for _ = 1, math.min(block.Children, 12 - life.Relationships.Children) do
			table.insert(names, People.Add(life, "Child", rng).Name)
		end
		if #names == 1 then
			table.insert(summary.LifeChanges, "👶 Welcome, " .. names[1] .. "!")
		elseif #names > 1 then
			table.insert(summary.LifeChanges, "👶 Welcome, " .. table.concat(names, " & ") .. "!")
		end
	end
	if type(block.Friends) == "number" and block.Friends ~= 0 then
		if block.Friends > 0 then
			for _ = 1, block.Friends do
				if life.Relationships.Friends >= People.MaxFriends then
					break
				end
				local friend = People.Add(life, "Friend", rng)
				table.insert(summary.LifeChanges, "🙂 New friend: " .. friend.Name)
			end
		else
			for _ = 1, -block.Friends do
				local friends = People.ByRole(life, "Friend")
				table.sort(friends, function(a, b)
					return a.Bond < b.Bond
				end)
				if friends[1] then
					table.insert(summary.LifeChanges, "👋 Lost touch with " .. friends[1].Name)
					People.Remove(life, friends[1])
				end
			end
		end
	end
	if block.Meet == "BestFriend" and #People.ByRole(life, "BestFriend") == 0 then
		local friends = People.ByRole(life, "Friend")
		table.sort(friends, function(a, b)
			return a.Bond > b.Bond
		end)
		local best = friends[1] or People.Add(life, "Friend", rng)
		best.Role = "BestFriend"
		People.ChangeBond(best, 15)
		People.Sync(life)
		table.insert(summary.LifeChanges, "🫶 " .. best.Name .. " is now your best friend")
	elseif block.Meet == "Sibling" then
		local sibling = People.Add(life, "Sibling", rng)
		sibling.BornAge = life.Age
		table.insert(summary.LifeChanges, "🧒 A new sibling: " .. sibling.Name)
	elseif block.Meet == "Friend" and life.Relationships.Friends < People.MaxFriends then
		local friend = People.Add(life, "Friend", rng)
		table.insert(summary.LifeChanges, "🙂 New friend: " .. friend.Name)
	end
	if type(block.InvestPercent) == "number" and (life.Investments or 0) > 0 then
		local before = life.Investments
		life.Investments = math.max(0, math.floor(before * (1 + block.InvestPercent)))
		local change = life.Investments - before
		table.insert(summary.LifeChanges, ("%s Investments %s%s"):format(if change >= 0 then "📈" else "📉", if change >= 0 then "+" else "", Format.Money(change)))
	end
	if type(block.Farewell) == "string" then
		local person = People.ByRole(life, block.Farewell)[1]
		if person then
			People.Remove(life, person)
			table.insert(summary.LifeChanges, "🕊️ Said goodbye to " .. person.Name)
		end
	end
	if type(block.Bond) == "table" then
		for _, person in ipairs(life.People) do
			local delta = (block.Bond[person.Role] or 0) + (if person.Role ~= "Ex" then (block.Bond.All or 0) else 0)
			if delta ~= 0 then
				Consequences.ChangeBond(person, delta, summary)
			end
		end
	end
	if type(block.Loan) == "table" and Consequences.LoanKinds[block.Loan.Kind] then
		local kind = Consequences.LoanKinds[block.Loan.Kind]
		local rate = block.Loan.Rate or kind.Rate
		local years = block.Loan.Years or kind.Years
		table.insert(life.Loans, { Kind = block.Loan.Kind, Balance = block.Loan.Amount, Rate = rate, Payment = Budget.LoanPayment(block.Loan.Amount, rate, years) })
		table.insert(summary.LifeChanges, "🏦 " .. kind.Title .. ": " .. Format.Money(block.Loan.Amount))
	end
	if type(block.RepayLoan) == "table" then
		for i, loan in ipairs(life.Loans) do
			if loan.Kind == block.RepayLoan.Kind then
				local paid = math.min(loan.Balance, block.RepayLoan.Amount, life.Money)
				loan.Balance -= paid
				changeMoney(life, -paid, summary)
				if loan.Balance <= 0 then
					table.remove(life.Loans, i)
					table.insert(summary.LifeChanges, "🎉 Paid off your " .. string.lower(Consequences.LoanKinds[loan.Kind].Title))
				end
				break
			end
		end
	end
	if block.Assets then
		for _, id in ipairs(block.Assets) do
			if Assets.Info[id] and not life.Assets[id] then
				life.Assets[id] = true
				table.insert(summary.LifeChanges, Assets.Info[id].Icon .. " Bought: " .. Assets.Info[id].Title)
			end
		end
	end
	if block.RemoveAssets then
		for _, id in ipairs(block.RemoveAssets) do
			if life.Assets[id] then
				life.Assets[id] = nil
				table.insert(summary.LifeChanges, Assets.Info[id].Icon .. " Sold: " .. Assets.Info[id].Title)
			end
		end
	end
	local story = personalise(block.Story, life)
	if story then
		table.insert(summary.StoryParts, story)
	end
end

function Consequences.NewSummary(rng)
	return {
		_rng = rng,
		BondChanges = {},
		Applied = {},
		MoneyDelta = 0,
		FlagsAdded = {},
		TraitsGained = {},
		LifeChanges = {},
		StoryParts = {},
		OutcomeTriggered = false,
	}
end

--[[
	Applies effects (and possibly one chance Outcome) to `life`.
	Returns summary = { Applied, MoneyDelta, FlagsAdded, TraitsGained, LifeChanges, Story, OutcomeTriggered }
]]
-- Rolls which chance Outcome (if any) happens: returns its index, or 0 for none.
function Consequences.RollOutcome(effects, rng): number
	if not effects.Outcomes then
		return 0
	end
	local roll = rng:NextNumber()
	local cumulative = 0
	for index, outcome in ipairs(effects.Outcomes) do
		cumulative += outcome.Chance
		if roll < cumulative then
			return index
		end
	end
	return 0
end

--[[
	`forcedOutcome` (optional) decides the chance Outcome instead of rolling:
	group decisions roll once and pass the same index to every member, so
	friends who start a business together share the same fate, while each
	life still applies the effects to its own stats and money.
]]
function Consequences.Apply(life, effects, rng, logStory: boolean?, forcedOutcome: number?)
	local summary = Consequences.NewSummary(rng)
	applyBlock(life, effects, summary)

	if effects.Outcomes then
		local index = if forcedOutcome ~= nil then forcedOutcome else Consequences.RollOutcome(effects, rng)
		local outcome = effects.Outcomes[index]
		if outcome then
			applyBlock(life, outcome, summary)
			summary.OutcomeTriggered = true
		end
	end

	Consequences.SyncWealth(life)
	summary.Story = table.concat(summary.StoryParts, " ")
	summary.StoryParts = nil
	summary._rng = nil
	if logStory ~= false and summary.Story ~= "" then
		table.insert(life.Story, { Age = life.Age, Text = summary.Story })
		TableUtil.TrimArray(life.Story, Config.MaxStoryEntries)
	end
	return summary
end

--[[
	Consequence preview for the decision cards: direction + size of each base
	stat effect, never exact numbers, and never what chance Outcomes do.
	Returns { { Stat, Dir = 1|-1, Size = 1..3 } ... }, moneyDir, risky, tags
	`tags` are short hints for big life changes ("💼 New career", "🏠 Home").
]]
function Consequences.Preview(effects)
	local preview = {}
	if effects.Stats then
		for stat, delta in pairs(effects.Stats) do
			if delta ~= 0 and stat ~= "Wealth" then
				local size = if math.abs(delta) <= 4 then 1 elseif math.abs(delta) <= 8 then 2 else 3
				table.insert(preview, { Stat = stat, Dir = if delta > 0 then 1 else -1, Size = size })
			end
		end
	end
	table.sort(preview, function(a, b)
		if a.Dir ~= b.Dir then
			return a.Dir > b.Dir
		end
		if a.Size ~= b.Size then
			return a.Size > b.Size
		end
		return a.Stat < b.Stat
	end)
	local money = (effects.Money or 0) + (if effects.MoneyPercent then effects.MoneyPercent * 1e6 else 0)
	local moneyDir = if money > 0 then 1 elseif money < 0 then -1 else 0

	local tags = {}
	if type(effects.Career) == "string" and effects.Career ~= "None" and Careers.Info[effects.Career] then
		table.insert(tags, Careers.Info[effects.Career].Icon .. " " .. Careers.TitleAt(effects.Career, 1))
	elseif effects.Career == "None" then
		table.insert(tags, "💼 Leave job")
	end
	if effects.Promote and effects.Promote > 0 then
		table.insert(tags, "📈 Promotion")
	end
	if effects.Education then
		table.insert(tags, "🎓 " .. (Careers.EducationNames[effects.Education] or effects.Education))
	end
	if effects.Married then
		table.insert(tags, "💍 Marriage")
	elseif effects.Partner == true then
		table.insert(tags, "❤️ Romance")
	end
	if effects.Children and effects.Children > 0 then
		table.insert(tags, "👶 Family")
	end
	if effects.Assets then
		for _, id in ipairs(effects.Assets) do
			if Assets.Info[id] then
				table.insert(tags, Assets.Info[id].Icon .. " " .. Assets.Info[id].Title)
			end
		end
	end
	if effects.Retire then
		table.insert(tags, "🏖️ Retire")
	end
	if type(effects.Loan) == "table" then
		table.insert(tags, "🏦 Loan " .. Format.Money(effects.Loan.Amount))
	end
	if type(effects.Bond) == "table" then
		local up, down = false, false
		for _, delta in pairs(effects.Bond) do
			if delta > 0 then
				up = true
			elseif delta < 0 then
				down = true
			end
		end
		if up then
			table.insert(tags, "💞 Closer bonds")
		end
		if down then
			table.insert(tags, "💔 Strained bonds")
		end
	end
	if type(effects.Money) == "number" and math.abs(effects.Money) >= 1000 then
		table.insert(tags, (if effects.Money > 0 then "+" else "") .. Format.Money(effects.Money))
	end
	return preview, moneyDir, effects.Outcomes ~= nil, tags
end

return Consequences
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">MockDataStore</string>
            <string name="Source"><![CDATA[--[[
	MockDataStore  (ServerScriptService.Server.Lib.MockDataStore)
	In-memory stand-in with the same method signatures as a GlobalDataStore.
	DataService uses it automatically when DataStores are unavailable
	(Studio with "Enable Studio Access to API Services" off, or unit tests).
	Data is lost when the server stops.
]]

local MockDataStore = {}
MockDataStore.__index = MockDataStore

local function deepCopy(v)
	if type(v) ~= "table" then
		return v
	end
	local c = {}
	for k, x in pairs(v) do
		c[k] = deepCopy(x)
	end
	return c
end

function MockDataStore.new()
	return setmetatable({ _data = {} }, MockDataStore)
end

function MockDataStore:GetAsync(key: string)
	return deepCopy(self._data[key])
end

function MockDataStore:SetAsync(key: string, value: any)
	self._data[key] = deepCopy(value)
end

function MockDataStore:UpdateAsync(key: string, transform: (any) -> any)
	local result = transform(deepCopy(self._data[key]))
	if result ~= nil then
		self._data[key] = deepCopy(result)
	end
	return deepCopy(result)
end

function MockDataStore:RemoveAsync(key: string)
	local old = self._data[key]
	self._data[key] = nil
	return old
end

return MockDataStore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">RandomEvents</string>
            <string name="Source"><![CDATA[--[[
	RandomEvents  (ServerScriptService.Server.Lib.RandomEvents)
	Rolls for an unexpected life event after each decision.

	  1. A base chance (Config.EventChance) decides whether anything happens.
	  2. Eligible events = right stage, Requires pass, not already had (Once).
	     So events respect the player's circumstances (you can't lose a job you
	     don't have, inherit a fortune twice, etc.).
	  3. Weighted pick by rarity × Boost (e.g. inheritances favour people with
	     strong Relationships).
	Legendary events are extremely rare: roughly one life in a few hundred.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)

local Conditions = require(script.Parent.Conditions)
local ScenarioPicker = require(script.Parent.ScenarioPicker)

local RandomEvents = {}

RandomEvents.RarityWeight = {
	Common = 10,
	Uncommon = 4,
	Rare = 1.2,
	Legendary = 0.12,
}

local function hadEvent(life, id: string): boolean
	return table.find(life.Events, id) ~= nil
end

function RandomEvents.Eligible(life, pool)
	local list = {}
	for _, event in ipairs(pool) do
		if table.find(event.Stages, life.Stage) and not (event.Once ~= false and hadEvent(life, event.Id)) and Conditions.Check(life, event.Requires) then
			table.insert(list, event)
		end
	end
	return list
end

function RandomEvents.Roll(life, pool, rng)
	if rng:NextNumber() >= Config.EventChance then
		return nil
	end
	local eligible = RandomEvents.Eligible(life, pool)
	if #eligible == 0 then
		return nil
	end
	local weights, total = {}, 0
	for i, event in ipairs(eligible) do
		weights[i] = ScenarioPicker.Weight(event, life, RandomEvents.RarityWeight[event.Rarity] or 1)
		total += weights[i]
	end
	local roll = rng:NextNumber() * total
	for i, event in ipairs(eligible) do
		roll -= weights[i]
		if roll <= 0 then
			return event
		end
	end
	return eligible[#eligible]
end

return RandomEvents
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Reveal</string>
            <string name="Source"><![CDATA[--[[
	Reveal  (ServerScriptService.Server.Lib.Reveal)
	Builds LIFE REVEAL moments from a life's real state.

	Reveal.Stage(life, completedStage, rng) -> payload
	  End-of-stage reveal: predictions (Shared/Util/Futures), headline and
	  warning, cinematic archetype, who-you-became highlights, how the odds
	  moved since the last reveal, and maybe a TWIST that really changes the
	  life (Content/Twists) with odds before → after. Also writes the
	  predictions into the stage's life.Reveals snapshot.

	Reveal.Final(life, nextId) -> historyEntry
	  The final reveal / Life History entry: ending title, achievements,
	  greatest moments, biggest mistakes, key decisions, family, wealth,
	  career, stats, which futures came true, and the prediction journey.

	Reveal.Card(life) -> shareable summary for comparing with other players.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Futures = require(Shared.Util.Futures)
local Endings = require(Shared.Util.Endings)
local Budget = require(Shared.Util.Budget)
local People = require(Shared.Util.People)
local StatMath = require(Shared.Util.StatMath)
local StatDefinitions = require(Shared.Data.StatDefinitions)
local LifeStages = require(Shared.Data.LifeStages)
local Careers = require(Shared.Data.Careers)
local Traits = require(Shared.Data.Traits)
local Assets = require(Shared.Data.Assets)
local Config = require(Shared.Config)

local Conditions = require(script.Parent.Conditions)
local Consequences = require(script.Parent.Consequences)
local Content = script.Parent.Parent.Content
local Scenarios = require(Content.Scenarios)
local Twists = require(Content.Twists)

local Reveal = {}

Reveal.Twists = Twists
Reveal.TwistById = {}
for _, twist in ipairs(Twists) do
	Reveal.TwistById[twist.Id] = twist
end

Reveal.AchievementFlags = {
	Astronaut = "🚀 Went to space",
	SpaceHero = "🛰️ Saved a space mission",
	NobelPrize = "🏆 Won the world's top science prize",
	LotteryWinner = "🎰 Won the lottery",
	Celebrity = "🌟 Became a celebrity",
	Tycoon = "🏙️ Built a business empire",
	Champion = "🏅 Won a championship",
	WorldChampion = "🎮 Became world champion",
	Bestseller = "📚 Wrote a bestseller",
	Published = "✍️ Got published",
	Album = "💿 Recorded an album",
	AwardWinner = "🏆 Won a major award",
	LifetimeAward = "🎖️ Received a lifetime achievement award",
	Foundation = "🎁 Set up a charitable foundation",
	Philanthropist = "💝 Gave generously to charity",
	MiracleDoctor = "🩺 Performed a 'miracle' operation",
	PeoplesLawyer = "⚖️ Won a landmark case for a family in need",
	StarChef = "⭐ Earned a five-star review",
	Inventor = "💡 Patented an invention",
	Councillor = "🗳️ Was elected to the council",
	SavedPark = "🌳 Saved the local park",
	ChessChampion = "♟️ Became senior chess champion",
	Marathoner = "🏃 Ran a marathon",
	Sailor = "⛵ Sailed around the world",
	Honours = "🎓 Graduated with top honours",
	AppHit = "📱 Made a chart-topping app",
	Detective = "🕵️ Became a detective",
	LifeChangingTeacher = "🍎 Changed a student's life",
	Grandparent = "👶 Became a grandparent",
	ViralSenior = "📱 Became the internet's favourite grandparent",
	Prodigy = "🎹 Was a child prodigy",
}

local function round(n: number): number
	return math.floor(n + 0.5)
end

local function topPredictions(predictions, count: number)
	local positives = Futures.Sorted(predictions)
	local top = {}
	for i = 1, math.min(count, #positives) do
		table.insert(top, { Id = positives[i].Id, Pct = positives[i].Pct })
	end
	return top
end

-- Decides which kind of twist fits the current predictions.
local function pickTwist(life, predictions, rng, completedStage: number)
	local positives, risks = Futures.Sorted(predictions)
	local kind, counter
	if risks[1].Pct >= 45 then
		kind, counter = "Rescue", risks[1].Id
	elseif positives[1].Pct >= 60 then
		kind, counter = "Setback", positives[1].Id
	else
		kind = "Surprise"
	end
	local function candidates(wantKind, wantCounter)
		local list = {}
		for _, twist in ipairs(Twists) do
			if twist.Kind == wantKind and table.find(twist.Stages, completedStage) and not table.find(life.Events, twist.Id) and Conditions.Check(life, twist.Requires) then
				if not wantCounter or table.find(twist.Counters, wantCounter) then
					table.insert(list, twist)
				end
			end
		end
		return list
	end
	local list = candidates(kind, counter)
	if #list == 0 then
		list = candidates("Surprise", nil)
	end
	if #list == 0 then
		return nil
	end
	return list[rng:NextInteger(1, #list)]
end

-- Short "who you became" lines for the reveal.
local function becameHighlights(life)
	local lines = {}
	local traitList = {}
	for id, strength in pairs(life.Traits) do
		table.insert(traitList, { Id = id, Strength = strength })
	end
	table.sort(traitList, function(a, b)
		return a.Strength > b.Strength
	end)
	for i = 1, math.min(3, #traitList) do
		local info = Traits.Info[traitList[i].Id]
		if info then
			table.insert(lines, info.Icon .. " " .. info.DisplayName)
		end
	end
	-- Strongest and weakest stats.
	local order = table.clone(StatDefinitions.Order)
	table.sort(order, function(a, b)
		return life.Stats[a] > life.Stats[b]
	end)
	local strongest = StatDefinitions.Info[order[1]]
	table.insert(lines, ("%s Strongest: %s (%d)"):format(strongest.Icon, strongest.DisplayName, round(life.Stats[order[1]])))
	return lines
end

function Reveal.Stage(life, completedStage: number, rng)
	local record = life.Reveals[#life.Reveals]
	local previous = life.Reveals[#life.Reveals - 1]
	local before = Futures.Predict(life)
	local payload = {
		Stage = completedStage,
		StageName = LifeStages.Get(completedStage).DisplayName,
		NextStageName = if completedStage < LifeStages.Count then LifeStages.Get(completedStage + 1).DisplayName else nil,
		Age = life.Age,
		Became = becameHighlights(life),
		Previous = previous and previous.Predictions or nil,
	}

	local predictions = before
	if completedStage < LifeStages.Count and rng:NextNumber() < Config.TwistChance then
		local twist = pickTwist(life, before, rng, completedStage)
		if twist then
			local summary = Consequences.Apply(life, twist.Effects, rng)
			table.insert(life.Events, twist.Id)
			summary.Applied.Wealth = nil
			predictions = Futures.Predict(life)
			payload.Twist = {
				Id = twist.Id,
				Kind = twist.Kind,
				Icon = twist.Icon,
				Title = twist.Title,
				Story = summary.Story,
				Applied = summary.Applied,
				MoneyDelta = summary.MoneyDelta,
				LifeChanges = summary.LifeChanges,
				BondChanges = summary.BondChanges,
				Before = before,
			}
			if record then
				record.Stats = table.clone(life.Stats) -- a twist isn't a "trend"
				record.Money = life.Money
				record.Twist = twist.Id
			end
		end
	end

	local headline, warning = Futures.Headline(predictions)
	payload.Predictions = predictions
	payload.Headline = headline
	payload.Warning = warning
	payload.Archetype = Futures.Archetype(predictions)
	if record then
		record.Predictions = predictions
		record.Headline = headline
		record.Archetype = payload.Archetype
	end
	return payload
end

-- ===== Final reveal =====
local function decisionText(d): string
	if d.X and d.T then
		return ("Age %d: %s (%s)"):format(d.Age, d.X, d.T)
	end
	return ("Age %d: a choice that mattered"):format(d.Age)
end

function Reveal.Final(life, nextId: number)
	local ending, ctx = Endings.Determine(life)
	local outcomes = ctx.Outcomes
	local decisions = {}
	for _, d in ipairs(life.Decisions) do
		table.insert(decisions, d)
	end

	-- Key decisions: the most consequential choices, in life order.
	table.sort(decisions, function(a, b)
		return (a.I or 0) > (b.I or 0)
	end)
	local key = {}
	for i = 1, math.min(5, #decisions) do
		local d = decisions[i]
		table.insert(key, { Age = d.Age, Title = d.T or "", Choice = d.X or "" })
	end
	table.sort(key, function(a, b)
		return a.Age < b.Age
	end)

	-- Greatest moments and biggest mistakes by how good/bad they were.
	table.sort(decisions, function(a, b)
		return (a.G or 0) > (b.G or 0)
	end)
	local moments, mistakes = {}, {}
	for i = 1, math.min(3, #decisions) do
		if (decisions[i].G or 0) >= 6 then
			table.insert(moments, decisionText(decisions[i]))
		end
	end
	for i = #decisions, math.max(1, #decisions - 2), -1 do
		if (decisions[i].G or 0) <= -4 then
			table.insert(mistakes, decisionText(decisions[i]))
		end
	end
	for _, eventId in ipairs(life.Events) do
		local event = Scenarios.EventById[eventId]
		local twist = Reveal.TwistById[eventId]
		if event and (event.Rarity == "Rare" or event.Rarity == "Legendary") and #moments < 6 then
			table.insert(moments, event.Icon .. " " .. event.Title)
		elseif twist and twist.Kind ~= "Setback" and #moments < 6 then
			table.insert(moments, twist.Icon .. " " .. twist.Title)
		end
	end

	-- Moments shared with friends (group events in a Life Circle).
	for i = #(life.Shared or {}), 1, -1 do
		local shared = life.Shared[i]
		if #moments >= 7 then
			break
		end
		table.insert(moments, ("%s With %s: %s"):format(shared.Icon or "🤝", table.concat(shared.With or {}, " & "), shared.Title))
	end

	-- Achievements.
	local achievements = {}
	if outcomes.Millionaire then
		table.insert(achievements, "💰 Became a millionaire")
	end
	if outcomes.Career then
		table.insert(achievements, "💼 Reached the top of their field")
	end
	if (Careers.EducationRank[life.Education] or 0) >= 2 then
		table.insert(achievements, "🎓 Earned a " .. Careers.EducationNames[life.Education])
	end
	if life.Assets.House or life.Assets.Mansion or life.Assets.Apartment then
		table.insert(achievements, "🏠 Owned their own home")
	end
	for flagId, text in pairs(Reveal.AchievementFlags) do
		if life.Flags[flagId] then
			table.insert(achievements, text)
		end
	end
	table.sort(achievements)

	-- Family.
	local partner = People.Partner(life)
	local children = {}
	for _, child in ipairs(People.ByRole(life, "Child")) do
		table.insert(children, child.Name)
	end
	local bestFriend = People.ByRole(life, "BestFriend")[1]

	-- Prediction journey across the stages.
	local journey = {}
	for _, r in ipairs(life.Reveals) do
		if r.Predictions then
			table.insert(journey, { Stage = r.Stage, Age = r.Age, Top = topPredictions(r.Predictions, 3), Headline = r.Headline, Twist = r.Twist })
		end
	end

	local came = {}
	for _, id in ipairs(Futures.Order) do
		if outcomes[id] then
			table.insert(came, id)
		end
	end

	local stats = {}
	for _, statName in ipairs(StatDefinitions.Order) do
		stats[statName] = round(life.Stats[statName])
	end
	local bestCareer = life.BestCareer
	local overall = ctx.Overall
	local coins = math.floor(40 + overall + 5 * #came + (ending.Coins or 30))

	return {
		Id = nextId,
		Name = life.Name,
		Ending = { Id = ending.Id, Title = ending.Title, Icon = ending.Icon, Line = (ending.Line:gsub("{name}", life.Name)) },
		Age = life.Age,
		CompletedAt = os.time(),
		NetWorth = math.floor(ctx.NetWorth),
		Money = life.Money,
		Overall = round(overall),
		Stats = stats,
		Career = if bestCareer then Careers.TitleAt(bestCareer.Id, bestCareer.Level) else "No career",
		CareerId = if bestCareer then bestCareer.Id else "None",
		Education = Careers.EducationNames[life.Education] or "None",
		Partner = if partner then { Name = partner.Name, Married = partner.Married == true, Bond = round(partner.Bond) } else false,
		Children = children,
		BestFriend = if bestFriend then bestFriend.Name else false,
		Achievements = achievements,
		Moments = moments,
		Mistakes = mistakes,
		KeyDecisions = key,
		Journey = journey,
		CameTrue = came,
		DecisionCount = #life.Decisions,
		Coins = coins,
	}
end

-- ===== Shareable card for comparisons =====
function Reveal.Card(life, includeStats: boolean)
	local predictions = Futures.Predict(life)
	local headline = Futures.Headline(predictions)
	local card = {
		LifeName = life.Name,
		Age = life.Age,
		StageName = LifeStages.Get(life.Stage).DisplayName,
		Completed = life.Completed,
		Career = if life.Career.Id ~= "None" and Careers.Info[life.Career.Id] then Careers.TitleAt(life.Career.Id, life.Career.Level) elseif life.Flags.Retired then "Retired" else "—",
		Predictions = predictions,
		Headline = headline,
		Archetype = Futures.Archetype(predictions),
		Married = life.Relationships.Married,
		Children = life.Relationships.Children,
	}
	if includeStats then
		card.Stats = {}
		for _, statName in ipairs(StatDefinitions.Order) do
			card.Stats[statName] = round(life.Stats[statName])
		end
		card.NetWorth = math.floor(Budget.NetWorth(life))
		card.Overall = round(StatMath.Overall(life.Stats))
		-- Show off your lifestyle: homes, cars and more.
		local owned = {}
		for id in pairs(life.Assets) do
			local asset = Assets.Info[id]
			if asset then
				table.insert(owned, asset.Icon .. " " .. asset.Title)
			end
		end
		table.sort(owned)
		card.Assets = owned
	end
	return card
end

return Reveal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">ScenarioPicker</string>
            <string name="Source"><![CDATA[--[[
	ScenarioPicker  (ServerScriptService.Server.Lib.ScenarioPicker)
	Chooses the next scenario for a life from a stage's pool.

	Rules, in order:
	  1. Only scenarios for the life's current stage (Stage, or any of Stages)
	     whose Requires pass.
	  2. Scenarios marked Once are skipped if already seen this life.
	  3. If any eligible scenario has a Priority, the highest Priority wins
	     (used for "first day of school"-style openers).
	  4. Otherwise a weighted random pick. Weight = scenario.Weight (default 1)
	     × Boost multipliers for matching flags/traits, so earlier decisions make
	     related situations more likely. Recently seen repeatables are down-weighted.
]]

local Conditions = require(script.Parent.Conditions)

local ScenarioPicker = {}

--[[
	Weight for a scenario or random event:
	  base × Boost.Flags[flag] (if set) × Boost.Traits (scaled by strength)
	       × Boost.Stats[stat].Multiplier (if stat ≥ Min, or ≤ Max)
	Seen repeatable scenarios are down-weighted.
]]
function ScenarioPicker.Weight(entry, life, base: number): number
	local weight = base
	local boost = entry.Boost
	if boost then
		if boost.Flags then
			for flag, multiplier in pairs(boost.Flags) do
				if life.Flags[flag] then
					weight *= multiplier
				end
			end
		end
		if boost.Traits then
			for trait, multiplier in pairs(boost.Traits) do
				local strength = life.Traits[trait]
				if strength then
					weight *= 1 + (multiplier - 1) * math.min(strength, 3) / 3
				end
			end
		end
		if boost.Stats then
			for stat, rule in pairs(boost.Stats) do
				local value = life.Stats[stat] or 0
				if (rule.Min and value >= rule.Min) or (rule.Max and value <= rule.Max) then
					weight *= rule.Multiplier
				end
			end
		end
	end
	if life.Seen[entry.Id] then
		weight *= 0.25
	end
	return weight
end

local function weightFor(scenario, life): number
	return ScenarioPicker.Weight(scenario, life, scenario.Weight or 1)
end

function ScenarioPicker.Eligible(life, pool)
	local eligible = {}
	for _, scenario in ipairs(pool) do
		local stageMatch = scenario.Stage == life.Stage or (scenario.Stages ~= nil and table.find(scenario.Stages, life.Stage) ~= nil)
		if stageMatch and not (scenario.Once and life.Seen[scenario.Id]) and Conditions.Check(life, scenario.Requires) then
			table.insert(eligible, scenario)
		end
	end
	return eligible
end

function ScenarioPicker.Pick(life, pool, rng)
	local eligible = ScenarioPicker.Eligible(life, pool)
	if #eligible == 0 then
		return nil
	end

	local best, bestPriority = nil, -math.huge
	for _, scenario in ipairs(eligible) do
		if scenario.Priority and scenario.Priority > bestPriority then
			best, bestPriority = scenario, scenario.Priority
		end
	end
	if best then
		return best
	end

	local total = 0
	local weights = {}
	for i, scenario in ipairs(eligible) do
		weights[i] = weightFor(scenario, life)
		total += weights[i]
	end
	local roll = rng:NextNumber() * total
	for i, scenario in ipairs(eligible) do
		roll -= weights[i]
		if roll <= 0 then
			return scenario
		end
	end
	return eligible[#eligible]
end

return ScenarioPicker
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">SessionLock</string>
            <string name="Source"><![CDATA[--[[
	SessionLock  (ServerScriptService.Server.Lib.SessionLock)
	Pure transform functions used inside DataStore:UpdateAsync so only one
	server can own a player's data at a time (prevents item/coin duplication
	when a player hops servers quickly).

	Stored record shape:  { Data = profile, Lock = { JobId = string, Time = unix } | nil }
]]

local SessionLock = {}

SessionLock.Result = {
	Acquired = "Acquired",
	Locked = "Locked", -- another live server owns it; caller should retry
}

--[[
	Attempt to claim `record` for `jobId`.
	Returns newRecord (to write, or nil to cancel the write), result.
	A lock older than `expiry` seconds is considered abandoned and is taken over.
]]
function SessionLock.Acquire(record: any, jobId: string, now: number, expiry: number)
	if type(record) ~= "table" then
		record = { Data = nil, Lock = nil }
	end
	local lock = record.Lock
	if type(lock) == "table" and lock.JobId ~= jobId and type(lock.Time) == "number" and now - lock.Time < expiry then
		return nil, SessionLock.Result.Locked
	end
	record.Lock = { JobId = jobId, Time = now }
	return record, SessionLock.Result.Acquired
end

--[[
	Write `data` back. If `release` the lock is cleared, otherwise refreshed.
	Returns nil (cancel write) if a different server has taken the lock, so a
	stale server can never overwrite newer data.
]]
function SessionLock.Write(record: any, jobId: string, data: any, now: number, release: boolean)
	if type(record) == "table" and type(record.Lock) == "table" and record.Lock.JobId ~= jobId then
		return nil, "LockStolen"
	end
	local newRecord = { Data = data, Lock = nil }
	if not release then
		newRecord.Lock = { JobId = jobId, Time = now }
	end
	return newRecord, "Written"
end

return SessionLock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">Validate</string>
            <string name="Source"><![CDATA[--[[
	Validate  (ServerScriptService.Server.Lib.Validate)
	Argument checks for anything arriving from a client. Each function returns
	the sanitized value or nil if invalid. Never trust client types or ranges.
]]

local Validate = {}

function Validate.Number(value: any, min: number, max: number): number?
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return nil
	end
	if value < min or value > max then
		return nil
	end
	return value
end

function Validate.Integer(value: any, min: number, max: number): number?
	local n = Validate.Number(value, min, max)
	if n and n % 1 == 0 then
		return n
	end
	return nil
end

function Validate.String(value: any, maxLength: number): string?
	if type(value) ~= "string" or #value == 0 or #value > maxLength or not utf8.len(value) then
		return nil
	end
	return value
end

function Validate.Boolean(value: any): boolean?
	if type(value) == "boolean" then
		return value
	end
	return nil
end

function Validate.OneOf(value: any, options: { any }): any
	if table.find(options, value) then
		return value
	end
	return nil
end

-- Identifiers used for scenario/choice/item ids: letters, digits, underscore.
function Validate.Id(value: any, maxLength: number?): string?
	local s = Validate.String(value, maxLength or 64)
	if s and s:match("^[%w_]+$") then
		return s
	end
	return nil
end

--[[
	Validates a partial settings table against a schema:
	schema[key] = { Kind = "Number"|"Boolean"|"OneOf", Min, Max, Options }
	Unknown keys are dropped. Returns a new table with only valid entries.
]]
function Validate.Partial(input: any, schema: { [string]: any }): { [string]: any }
	local out = {}
	if type(input) ~= "table" then
		return out
	end
	for key, rule in pairs(schema) do
		local raw = input[key]
		if raw ~= nil then
			local value
			if rule.Kind == "Number" then
				value = Validate.Number(raw, rule.Min, rule.Max)
			elseif rule.Kind == "Boolean" then
				value = Validate.Boolean(raw)
			elseif rule.Kind == "OneOf" then
				value = Validate.OneOf(raw, rule.Options)
			end
			if value ~= nil then
				out[key] = value
			end
		end
	end
	return out
end

return Validate
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Yearly</string>
            <string name="Source"><![CDATA[--[[
	Yearly  (ServerScriptService.Server.Lib.Yearly)
	What happens to a life as years pass between decisions. For each year:
	  • money: the budget from Shared/Util/Budget (salary savings, pension, rent,
	    unemployment, children under 18, loan repayments)
	  • investments: a market return (usually +, sometimes a crash)
	  • career: years in role; strong performers may be promoted automatically
	    (more likely with a Career focus)
	  • lifestyle focus: small stat changes each year (Shared/Data/Lifestyle)
	  • people: bonds fade unless maintained; close bonds lift Happiness and
	    pull the Relationships stat toward them; loneliness hurts; a very weak
	    partner bond can end the relationship
	  • ageing: Health slowly declines after 55, faster after 70
	Called by LifeService inside the decision update, with the life's seeded RNG.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Careers = require(Shared.Data.Careers)
local Lifestyle = require(Shared.Data.Lifestyle)
local Budget = require(Shared.Util.Budget)
local People = require(Shared.Util.People)
local Format = require(Shared.Util.Format)
local Consequences = require(script.Parent.Consequences)

local Yearly = {}

-- Re-exported for tests and tuning.
Yearly.BaseSavingsRate = Budget.BaseSavingsRate
Yearly.RentCost = Budget.RentCost
Yearly.ChildCost = Budget.ChildCost
Yearly.PensionShare = Budget.PensionShare
Yearly.AutoPromoteYears = 6
Yearly.AutoPromoteMinCareer = 60
Yearly.AutoPromoteChance = 0.25
Yearly.MarketReturn = 0.045
Yearly.MarketSwing = 0.22
Yearly.CrashChance = 0.06
Yearly.NeglectBond = 15 -- partner bond below this risks a break-up
Yearly.NeglectChance = 0.25

local function payLoans(life, summary)
	local paidTotal = 0
	for i = #life.Loans, 1, -1 do
		local loan = life.Loans[i]
		local owed = math.ceil(loan.Balance * (1 + loan.Rate))
		local due = math.min(loan.Payment, owed)
		local paid = math.min(due, life.Money)
		life.Money -= paid
		paidTotal += paid
		loan.Balance = owed - paid
		if loan.Balance <= 0 then
			table.remove(life.Loans, i)
			table.insert(summary.LifeChanges, "🎉 Paid off your " .. string.lower(Consequences.LoanKinds[loan.Kind].Title))
		end
	end
	return paidTotal
end

local function growInvestments(life, rng, summary): number
	if (life.Investments or 0) <= 0 then
		return 0
	end
	local r
	if rng:NextNumber() < Yearly.CrashChance then
		r = -0.3
	else
		r = Yearly.MarketReturn + (rng:NextNumber() - 0.5) * Yearly.MarketSwing
	end
	local before = life.Investments
	life.Investments = math.max(0, math.floor(before * (1 + r)))
	if r == -0.3 then
		table.insert(summary.LifeChanges, "📉 Market crash! Investments fell 30%")
	end
	return life.Investments - before
end

local function tendPeople(life, focus, summary, rng)
	for _, person in ipairs(life.People) do
		local info = People.Roles[person.Role]
		if info and info.Decay > 0 then
			local decay = if person.Married and info.MarriedDecay then info.MarriedDecay else info.Decay
			if focus.BondDecay then
				decay += (focus.BondDecay[person.Role] or 0) + (focus.BondDecay.All or 0)
			end
			People.ChangeBond(person, -decay) -- gradual drift: visible in the People panel, not as chips
		end
	end
	local partner = People.Partner(life)
	if partner and partner.Bond < Yearly.NeglectBond and rng:NextNumber() < Yearly.NeglectChance then
		local married = partner.Married
		Consequences.EndRelationship(life, summary, ("💔 You and %s drifted apart%s"):format(partner.Name, if married then " and divorced" else ""))
		Consequences.AddStats(life, { Happiness = -8 }, summary, false)
		if married then
			local before = life.Money
			life.Money = math.floor(life.Money * 0.75)
			summary.MoneyDelta += life.Money - before
		end
	end
end

local function relationshipMood(life, summary)
	local close = People.CloseBond(life)
	local deltas = {}
	if close then
		deltas.Happiness = (close - 50) / 50 * 0.8
		deltas.Relationships = (close - life.Stats.Relationships) * 0.12
	end
	local hasSomeone = People.Partner(life) ~= nil or life.Relationships.Friends > 0
	if life.Age >= 25 and not hasSomeone then
		deltas.Happiness = (deltas.Happiness or 0) - 0.5
	end
	if next(deltas) then
		Consequences.AddStats(life, deltas, summary, false)
	end
end

--[[
	Advances `years` years starting at `startAge`. Mutates life and adds to
	`summary` (a Consequences summary). Returns { Years, Income, Investment }.
]]
function Yearly.Advance(life, startAge: number, years: number, rng, summary)
	local income, investment = 0, 0
	local healthLoss = 0
	local focusTotals = {}
	local focus = Lifestyle.Info[life.Focus] or Lifestyle.Info.Balanced
	local savedAge = life.Age
	for i = 0, years - 1 do
		local age = startAge + i
		life.Age = age -- budget and people depend on the age during that year
		local before = life.Money
		local budget = Budget.Breakdown(life, age)
		local net = budget.Net - (budget.Lines.Loans or 0) -- loans paid separately below
		life.Money = math.max(0, math.floor(life.Money + net))
		payLoans(life, summary)
		income += life.Money - before
		investment += growInvestments(life, rng, summary)

		local career = life.Career
		if career.Id ~= "None" then
			career.YearsInRole += 1
			if career.YearsInRole >= Yearly.AutoPromoteYears and career.Level < Careers.MaxLevel and life.Stats.Career >= Yearly.AutoPromoteMinCareer then
				if rng:NextNumber() < Yearly.AutoPromoteChance * (focus.PromotionMultiplier or 1) then
					Consequences.Promote(life, 1, summary)
				end
			end
		end

		local perYear = if age < 19 and focus.YouthPerYear then focus.YouthPerYear else focus.PerYear
		for stat, delta in pairs(perYear or {}) do
			if not (stat == "Career" and age < 19) then
				focusTotals[stat] = (focusTotals[stat] or 0) + delta
			end
		end
		tendPeople(life, focus, summary, rng)
		relationshipMood(life, summary)

		if age >= 70 then
			healthLoss += 0.8
		elseif age >= 55 then
			healthLoss += 0.4
		end
	end
	life.Age = savedAge
	if healthLoss > 0 then
		focusTotals.Health = (focusTotals.Health or 0) - healthLoss
	end
	if next(focusTotals) then
		Consequences.AddStats(life, focusTotals, summary, false)
	end
	summary.MoneyDelta += income
	if investment ~= 0 then
		table.insert(summary.LifeChanges, ("%s Investments %s%s"):format(if investment > 0 then "📈" else "📉", if investment > 0 then "+" else "", Format.Money(investment)))
	end
	Consequences.SyncWealth(life)
	return { Years = years, Income = income, Investment = investment }
end

return Yearly
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="50">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Main  (ServerScriptService.Server.Main)  — Script
	Server bootstrap. Steps:
	  1. Net.Init() creates every RemoteEvent/RemoteFunction.
	  2. Require every ModuleScript in Services, sorted by .Priority.
	  3. Call Init() on each in order. Init must not yield; it may connect to
	     other services' Signals (e.g. DataService.ProfileLoaded).
	  4. Call Start() on each in its own thread (may yield, may use other services).
	A service that errors is reported but does not stop the others from starting.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))
Net.Init()

local services = {}
for _, module in ipairs(script.Parent.Services:GetChildren()) do
	if module:IsA("ModuleScript") then
		local ok, service = pcall(require, module)
		if ok and type(service) == "table" then
			service.Name = service.Name or module.Name
			table.insert(services, service)
		else
			warn("[Server] Failed to load service " .. module.Name .. ": " .. tostring(service))
		end
	end
end

table.sort(services, function(a, b)
	return (a.Priority or 100) < (b.Priority or 100)
end)

for _, service in ipairs(services) do
	if service.Init then
		local ok, err = pcall(service.Init)
		if not ok then
			warn("[Server] " .. service.Name .. ".Init failed: " .. tostring(err))
		end
	end
end

for _, service in ipairs(services) do
	if service.Start then
		task.spawn(function()
			local ok, err = pcall(service.Start)
			if not ok then
				warn("[Server] " .. service.Name .. ".Start failed: " .. tostring(err))
			end
		end)
	end
end

print(("[Server] CHOOSE YOUR LIFE started with %d services"):format(#services))
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="51">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">CityEventService</string>
            <string name="Source"><![CDATA[--[[
	CityEventService  (ServerScriptService.Server.Services.CityEventService)
	Shared, server-wide events (Content/CityEvents): every few minutes the
	whole server gets the same invitation, such as a festival, the marathon
	or a free concert. Each player chooses to join or skip within the time
	limit. Joining applies the effects to that player's own life; chance
	outcomes are rolled once for the whole city, so everyone who joins
	shares the same result. A summary ("12 people joined!") follows.

	CityEventRespond(eventId, join) -> true, result | false, reason
	CityEventService.Trigger(eventId?) starts one now (tests / admin tools).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Config = require(Shared.Config)

local Server = script.Parent.Parent
local Conditions = require(Server.Lib.Conditions)
local Consequences = require(Server.Lib.Consequences)
local Scenarios = require(Server.Content.Scenarios)

local DataService = require(script.Parent.DataService)

local CityEventService = {}
CityEventService.Priority = 37

local current = nil
local lastId = nil
local counter = 0
local rng = Random.new()

local function activeLife(player: Player)
	local life = DataService.GetActiveLife(player)
	if life and not life.Completed then
		return life
	end
	return nil
end

local function interval(): number
	return if RunService:IsStudio() then 90 else Config.CityEventInterval
end

local function minPlayers(): number
	return if RunService:IsStudio() then 1 else Config.CityEventMinPlayers
end

local function finish(event)
	if current ~= event then
		return
	end
	current = nil
	local joined, invited = 0, 0
	for _, response in pairs(event.Responses) do
		if response == "Join" then
			joined += 1
		end
	end
	for _ in pairs(event.Invited) do
		invited += 1
	end
	Net.FireAll("CityEventSummary", { EventId = event.Id, Icon = event.Def.Icon, Title = event.Def.Title, Joined = joined, Invited = invited })
end

function CityEventService.Current()
	return current
end

function CityEventService.Trigger(eventId: string?)
	if current then
		return false, "EventActive"
	end
	local pool = {}
	for _, def in ipairs(Scenarios.City) do
		if (not eventId or def.Id == eventId) and def.Id ~= lastId then
			table.insert(pool, def)
		end
	end
	if eventId and #pool == 0 then
		pool = { Scenarios.CityById[eventId] }
	end
	local def = pool[rng:NextInteger(1, #pool)]
	if not def then
		return false, "NoEvent"
	end
	counter += 1
	lastId = def.Id
	local event = {
		Id = counter,
		Def = def,
		OutcomeIndex = Consequences.RollOutcome(def.Effects, rng), -- the same for the whole city
		Responses = {},
		Invited = {},
		Deadline = os.clock() + Config.CityEventJoinSeconds,
	}
	current = event
	for _, player in ipairs(Players:GetPlayers()) do
		local life = activeLife(player)
		if life then
			local eligible = Conditions.Check(life, def.Requires)
			event.Invited[player] = eligible
			Net.Fire("CityEvent", player, {
				EventId = event.Id,
				Icon = def.Icon,
				Title = def.Title,
				Description = def.Description,
				JoinText = def.JoinText,
				SkipText = def.SkipText,
				Seconds = Config.CityEventJoinSeconds,
				Eligible = eligible,
			})
		end
	end
	task.delay(Config.CityEventJoinSeconds, function()
		finish(event)
	end)
	return true, { EventId = event.Id, Id = def.Id }
end

function CityEventService.Respond(player: Player, eventId: any, join: any)
	local event = current
	if not event or event.Id ~= eventId then
		return false, "NoEvent"
	end
	if event.Invited[player] == nil then
		return false, "NotInvited"
	end
	if event.Responses[player] then
		return false, "AlreadyResponded"
	end
	if join ~= true then
		event.Responses[player] = "Skip"
		return true, { Joined = false }
	end
	if not event.Invited[player] then
		return false, "NotEligible"
	end
	local result
	DataService.Update(player, function(d)
		local life = d.Slots[d.ActiveSlot]
		if type(life) ~= "table" or life.Completed then
			return
		end
		local lifeRng = Random.new((life.Seed + #life.Decisions * 17 + event.Id * 13) % 2147483646 + 1)
		local summary = Consequences.Apply(life, event.Def.Effects, lifeRng, true, event.OutcomeIndex)
		summary.Applied.Wealth = nil
		result = {
			Joined = true,
			Icon = event.Def.Icon,
			Title = event.Def.Title,
			Story = summary.Story,
			Applied = summary.Applied,
			MoneyDelta = summary.MoneyDelta,
			LifeChanges = summary.LifeChanges,
			TraitsGained = summary.TraitsGained,
			Lucky = event.OutcomeIndex > 0,
		}
	end)
	if not result then
		return false, "NoLife"
	end
	event.Responses[player] = "Join"
	return true, result
end

function CityEventService.Init() end

function CityEventService.Start()
	Net.Handle("CityEventRespond", CityEventService.Respond)
	task.spawn(function()
		while true do
			task.wait(interval())
			local active = 0
			for _, player in ipairs(Players:GetPlayers()) do
				if activeLife(player) then
					active += 1
				end
			end
			if active >= minPlayers() and not current then
				CityEventService.Trigger()
			end
		end
	end)
end

return CityEventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--[[
	DataService  (ServerScriptService.Server.Services.DataService)
	Owns every player's saved profile on this server.

	• Loads with a session lock (Lib/SessionLock) inside UpdateAsync so two
	  servers can never both write the same player's data (anti-duplication).
	• Retries loads/saves with backoff; kicks with a friendly message rather
	  than letting a player play on unsaved/blank data.
	• Autosaves every Config.AutosaveInterval (this also refreshes the lock),
	  saves + releases on leave, and flushes everything in BindToClose.
	• Validates that data is DataStore-serializable before writing.
	• Replicates a sanitized snapshot to the owning client only (throttled).
	• Falls back to an in-memory MockDataStore in Studio when API access is off.

	Other services must change data ONLY through DataService.Update(player, fn).
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local DataTemplate = require(Shared.Data.DataTemplate)
local TableUtil = require(Shared.Util.TableUtil)
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Net)

local Lib = script.Parent.Parent.Lib
local SessionLock = require(Lib.SessionLock)
local MockDataStore = require(Lib.MockDataStore)

local DataService = {}
DataService.Priority = 0 -- initialised first; everything else depends on it

DataService.ProfileLoaded = Signal.new() -- (player, data)
DataService.ProfileReleasing = Signal.new() -- (player, data) fired before the final save
DataService.UsingMockStore = false

local JOB_ID = if game.JobId ~= "" then game.JobId else "Studio_" .. HttpService:GenerateGUID(false)

type Entry = {
	Data: any,
	Saving: boolean,
	Releasing: boolean,
	LockLost: boolean,
	ReplicationQueued: boolean,
	SentHistoryKey: string?,
}

local store: any = nil
local entries: { [Player]: Entry } = {}
local loading: { [Player]: boolean } = {}
local activeSaves = 0
local shuttingDown = false

local function keyFor(player: Player): string
	return Config.DataKeyPrefix .. player.UserId
end

local function chooseStore()
	local realStore
	local ok, err = pcall(function()
		realStore = DataStoreService:GetDataStore(Config.DataStoreName)
		if RunService:IsStudio() then
			realStore:GetAsync("__studio_probe")
		end
	end)
	if ok then
		return realStore, false
	end
	warn("[DataService] DataStores unavailable (" .. tostring(err) .. "). Using in-memory MockDataStore: progress will NOT persist.")
	return MockDataStore.new(), true
end

local function waitForBudget(requestType: Enum.DataStoreRequestType)
	if DataService.UsingMockStore then
		return
	end
	local deadline = os.clock() + 10
	while DataStoreService:GetRequestBudgetForRequestType(requestType) < 1 and os.clock() < deadline do
		task.wait(0.5)
	end
end

-- ===== Load =====
local function loadData(player: Player): (any, string?)
	local key = keyFor(player)
	for attempt = 1, Config.LoadRetries do
		local status, loadedRecord
		waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
		local ok, err = pcall(function()
			store:UpdateAsync(key, function(record)
				local newRecord, result = SessionLock.Acquire(record, JOB_ID, os.time(), Config.SessionLockExpiry)
				status = result
				loadedRecord = newRecord
				return newRecord
			end)
		end)

		if ok and status == SessionLock.Result.Acquired then
			local data = loadedRecord.Data
			if data == nil then
				data = DataTemplate.NewProfile()
			end
			local upgraded, reason = DataTemplate.Upgrade(data)
			if not upgraded then
				return nil, reason
			end
			return upgraded
		end

		if not ok then
			warn(("[DataService] Load attempt %d for %s failed: %s"):format(attempt, player.Name, tostring(err)))
		else
			warn(("[DataService] %s's data is locked by another server (attempt %d)"):format(player.Name, attempt))
		end
		if player.Parent == nil then
			return nil, "PlayerLeft"
		end
		task.wait(Config.LoadRetryDelay * attempt)
	end
	return nil, "Could not load data after " .. Config.LoadRetries .. " attempts"
end

-- ===== Save =====
-- Returns true when the write is confirmed.
local function writeData(player: Player, data: any, release: boolean): (boolean, string?)
	local serializable, problem = TableUtil.IsSerializable(data)
	if not serializable then
		warn("[DataService] Refusing to save unserializable data for " .. player.Name .. ": " .. tostring(problem))
		return false, "Unserializable"
	end
	local payload = TableUtil.DeepCopy(data)
	local key = keyFor(player)

	for attempt = 1, Config.SaveRetries do
		local status
		waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
		local ok, err = pcall(function()
			store:UpdateAsync(key, function(record)
				local newRecord, result = SessionLock.Write(record, JOB_ID, payload, os.time(), release)
				status = result
				return newRecord
			end)
		end)
		if ok and status == "Written" then
			return true
		elseif ok and status == "LockStolen" then
			return false, "LockStolen"
		end
		warn(("[DataService] Save attempt %d for %s failed: %s"):format(attempt, player.Name, tostring(err)))
		if attempt < Config.SaveRetries then
			task.wait(2 ^ attempt)
		end
	end
	return false, "SaveFailed"
end

local function saveEntry(player: Player, release: boolean): boolean
	local entry = entries[player]
	if not entry or entry.LockLost then
		return false
	end
	while entry.Saving do
		task.wait()
	end
	entry.Saving = true
	activeSaves += 1
	local ok, reason = writeData(player, entry.Data, release)
	activeSaves -= 1
	entry.Saving = false

	if reason == "LockStolen" then
		entry.LockLost = true
		warn("[DataService] Another server took " .. player.Name .. "'s data; this server will stop saving it.")
		if player.Parent then
			player:Kick("Your game was opened on another server. Please rejoin.")
		end
	end
	return ok
end

-- ===== Replication =====
-- What the owning client is allowed to see. Server-only fields are stripped.
local function historyKey(data): string
	local history = data.LifeHistory or {}
	local last = history[#history]
	return #history .. ":" .. tostring(last and last.Id or 0)
end

--[[
	When `omitHistory` is true, LifeHistory (up to ~75 KB) is left out and
	`HistoryUnchanged = true` is set instead; the client keeps its copy.
	This keeps the frequent pushes after every decision small.
]]
function DataService.Snapshot(player: Player, omitHistory: boolean?)
	local entry = entries[player]
	if not entry then
		return nil
	end
	local snapshot = {}
	for key, value in pairs(entry.Data) do
		if key ~= "ProcessedReceipts" and not (omitHistory and key == "LifeHistory") then
			snapshot[key] = TableUtil.DeepCopy(value)
		end
	end
	if omitHistory then
		snapshot.HistoryUnchanged = true
	end
	for _, slotId in ipairs(DataTemplate.SlotIds) do
		local life = snapshot.Slots[slotId]
		if type(life) == "table" then
			life.Seed = nil -- never reveal the RNG seed
		end
	end
	return snapshot
end

local function replicate(player: Player)
	local entry = entries[player]
	if not entry or entry.ReplicationQueued then
		return
	end
	entry.ReplicationQueued = true
	task.delay(Config.ReplicationThrottle, function()
		entry.ReplicationQueued = false
		if entries[player] == entry and player.Parent then
			local key = historyKey(entry.Data)
			local omit = entry.SentHistoryKey == key
			entry.SentHistoryKey = key
			Net.Fire("DataSnapshot", player, DataService.Snapshot(player, omit))
		end
	end)
end

-- ===== Public API =====
function DataService.IsLoaded(player: Player): boolean
	return entries[player] ~= nil
end

-- Read-only access. Do NOT mutate the returned table; use Update.
function DataService.Get(player: Player)
	local entry = entries[player]
	return entry and entry.Data
end

function DataService.WaitForData(player: Player, timeout: number?)
	local deadline = os.clock() + (timeout or 30)
	while not entries[player] and player.Parent and os.clock() < deadline do
		task.wait(0.1)
	end
	return DataService.Get(player)
end

--[[
	The only way to change saved data. `mutator(data)` edits in place.
	Returns true + mutator's return value, or false if data isn't loaded.
	The mutator must not yield.
]]
function DataService.Update(player: Player, mutator: (any) -> any)
	local entry = entries[player]
	if not entry or entry.Releasing then
		return false
	end
	local result = mutator(entry.Data)
	replicate(player)
	return true, result
end

-- The life in the player's active save slot, or nil if that slot is empty.
function DataService.GetActiveLife(player: Player)
	local data = DataService.Get(player)
	if not data then
		return nil
	end
	local life = data.Slots[data.ActiveSlot]
	return if type(life) == "table" then life else nil
end

function DataService.SaveNow(player: Player): boolean
	return saveEntry(player, false)
end

-- ===== Lifecycle =====
local function onPlayerAdded(player: Player)
	if loading[player] or entries[player] then
		return
	end
	loading[player] = true
	local data, reason = loadData(player)
	loading[player] = nil

	if not data then
		if reason ~= "PlayerLeft" and player.Parent then
			warn("[DataService] Failed to load " .. player.Name .. ": " .. tostring(reason))
			player:Kick("We couldn't load your life safely (" .. tostring(reason) .. "). Please rejoin in a moment.")
		end
		return
	end

	local entry: Entry = { Data = data, Saving = false, Releasing = false, LockLost = false, ReplicationQueued = false }
	entries[player] = entry

	if player.Parent == nil then
		-- Left while loading: release the lock we just took.
		entry.Releasing = true
		saveEntry(player, true)
		entries[player] = nil
		return
	end

	DataService.ProfileLoaded:Fire(player, data)
	replicate(player)
end

local function onPlayerRemoving(player: Player)
	local entry = entries[player]
	if not entry or entry.Releasing then
		return
	end
	DataService.ProfileReleasing:Fire(player, entry.Data)
	task.wait() -- let ProfileReleasing handlers (deferred) run their final edits
	entry.Releasing = true
	saveEntry(player, true)
	entries[player] = nil
end

local function onClose()
	shuttingDown = true
	local pending = 0
	for player in pairs(entries) do
		pending += 1
		task.spawn(function()
			onPlayerRemoving(player)
			pending -= 1
		end)
	end
	local deadline = os.clock() + 25
	while (pending > 0 or activeSaves > 0) and os.clock() < deadline do
		task.wait(0.1)
	end
end

function DataService.Init()
	local chosen, isMock = chooseStore()
	store = chosen
	DataService.UsingMockStore = isMock
end

function DataService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end
	game:BindToClose(onClose)

	Net.Handle("GetData", function(player)
		local data = DataService.WaitForData(player, 30)
		if not data then
			return false, "NotLoaded"
		end
		local entry = entries[player]
		if entry then
			entry.SentHistoryKey = historyKey(entry.Data)
		end
		return true, DataService.Snapshot(player)
	end)

	task.spawn(function()
		while not shuttingDown do
			task.wait(Config.AutosaveInterval)
			for player, entry in pairs(entries) do
				if not entry.Releasing then
					task.spawn(saveEntry, player, false)
				end
			end
		end
	end)
end

-- Exposed for tests only.
DataService._setStore = function(s, isMock)
	store = s
	DataService.UsingMockStore = isMock
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">LifeService</string>
            <string name="Source"><![CDATA[--[[
	LifeService  (ServerScriptService.Server.Services.LifeService)
	The authoritative life loop: save slots, starting/continuing lives,
	serving scenarios and resolving choices.

	Flow (client asks, server decides):
	  StartNewLife(slot, name, overwrite) -> true, slotId
	  ContinueLife(slot)                  -> true, slotId
	  DeleteLife(slot)                    -> true
	  GetScenario()                       -> true, scenarioPayload | false, reason
	  MakeChoice(scenarioId, choiceId)    -> true, outcome | false, reason

	Anti-exploit:
	  • The scenario being answered is stored in the save (life.CurrentScenario),
	    so a client can only answer the scenario it was given, once.
	  • Rejoining returns the same scenario (no rerolling bad situations).
	  • Randomness comes from a per-life server seed + decision count, so
	    leaving and rejoining can't reroll a chance outcome either.
	  • Locked choices are re-checked on the server.
	  • Names are length-checked and passed through Roblox text filtering.

	Signals for other systems:
	  LifeService.ChoiceMade(player, scenarioId, choiceId, summary)
	  LifeService.StageCompleted(player, stageId, life)    -- Phase 5 Life Reveal hooks here
	  LifeService.LifeCompleted(player, life)              -- Phase 5 final reveal hooks here
	  LifeService.LifeStarted(player, slotId, life)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local LifeStages = require(Shared.Data.LifeStages)
local DataTemplate = require(Shared.Data.DataTemplate)
local TableUtil = require(Shared.Util.TableUtil)
local Config = require(Shared.Config)

local Server = script.Parent.Parent
local Validate = require(Server.Lib.Validate)
local Conditions = require(Server.Lib.Conditions)
local Consequences = require(Server.Lib.Consequences)
local ScenarioPicker = require(Server.Lib.ScenarioPicker)
local RandomEvents = require(Server.Lib.RandomEvents)
local Yearly = require(Server.Lib.Yearly)
local Actions = require(Server.Lib.Actions)
local Reveal = require(Server.Lib.Reveal)
local Scenarios = require(Server.Content.Scenarios)

local DataService = require(script.Parent.DataService)
local StatService = require(script.Parent.StatService)

local LifeService = {}
LifeService.Priority = 30

LifeService.ChoiceMade = Signal.new()
LifeService.StageCompleted = Signal.new()
LifeService.LifeCompleted = Signal.new()
LifeService.LifeStarted = Signal.new()

local NAME_MIN, NAME_MAX = 2, 20

-- ===== Helpers =====
local function rngFor(life, salt: number)
	-- Deterministic per life + progress: same state always gives the same roll.
	return Random.new((life.Seed + #life.Decisions * 7919 + salt * 104729) % 2147483647)
end

local function activeLife(data)
	local life = data.Slots[data.ActiveSlot]
	return if type(life) == "table" then life else nil
end

local function cleanName(raw: any): string?
	if type(raw) ~= "string" then
		return nil
	end
	local name = raw:gsub("%c", ""):gsub("%s+", " "):match("^%s*(.-)%s*$")
	local length = utf8.len(name)
	if not length or length < NAME_MIN or length > NAME_MAX then
		return nil
	end
	return name
end

-- Roblox requires user-typed text shown to others to be filtered.
local function filterName(name: string, player: Player): string?
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(name, player.UserId, Enum.TextFilterContext.PublicChat)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	if not ok then
		if RunService:IsStudio() then
			-- Studio (especially unpublished places) may not offer filtering.
			-- Allow the name so testing works; live servers always reject.
			warn("[LifeService] Text filtering is unavailable in Studio, so the name is allowed for testing only: " .. tostring(result))
			return name
		end
		warn("[LifeService] Text filter unavailable: " .. tostring(result))
		return nil
	end
	if result ~= name then
		return nil -- something was censored; ask for a different name
	end
	return result
end

-- What the client is allowed to know about a scenario.
function LifeService.ToClient(scenario, life)
	local choices = {}
	for index, choice in ipairs(scenario.Choices) do
		local unlocked = Conditions.Check(life, choice.Requires)
		local preview, moneyDir, risky, tags = Consequences.Preview(choice.Effects)
		table.insert(choices, {
			Id = choice.Id,
			Index = index,
			Text = choice.Text,
			Description = choice.Description,
			Locked = not unlocked,
			LockHint = if unlocked then nil else (choice.LockHint or "Locked"),
			Mystery = choice.Mystery == true,
			Preview = if choice.Mystery then {} else preview,
			MoneyDir = if choice.Mystery then 0 else moneyDir,
			Risky = risky,
			Tags = if choice.Mystery or not unlocked then {} else tags,
		})
	end
	local stage = LifeStages.Get(life.Stage)
	return {
		Id = scenario.Id,
		Icon = scenario.Icon or "✨",
		Title = scenario.Title,
		Description = (scenario.Description:gsub("{name}", life.Name)),
		Age = life.Age,
		Stage = life.Stage,
		StageName = stage.DisplayName,
		ScenarioNumber = life.ScenarioIndex + 1,
		ScenariosInStage = stage.ScenariosPerStage,
		Choices = choices,
	}
end

-- ===== Remote handlers =====
local function startNewLife(player: Player, slotArg: any, nameArg: any, overwriteArg: any)
	local slotId = Validate.OneOf(slotArg, DataTemplate.SlotIds)
	if not slotId then
		return false, "BadSlot"
	end
	local data = DataService.Get(player)
	if not data then
		return false, "NotLoaded"
	end
	if type(data.Slots[slotId]) == "table" and overwriteArg ~= true then
		return false, "SlotInUse"
	end
	local name = cleanName(nameArg)
	if not name then
		return false, "BadName"
	end
	name = filterName(name, player) -- yields
	if not name then
		return false, "NameFiltered"
	end

	local seed = Random.new():NextInteger(1, 2147483646)
	local life = DataTemplate.NewLife(name, seed)
	local ok = DataService.Update(player, function(d)
		d.Slots[slotId] = life
		d.ActiveSlot = slotId
		d.Lifetime.LivesStarted += 1
	end)
	if not ok then
		return false, "NotLoaded"
	end
	LifeService.LifeStarted:Fire(player, slotId, life)
	return true, slotId
end

local function continueLife(player: Player, slotArg: any)
	local slotId = Validate.OneOf(slotArg, DataTemplate.SlotIds)
	if not slotId then
		return false, "BadSlot"
	end
	local data = DataService.Get(player)
	if not data then
		return false, "NotLoaded"
	end
	if type(data.Slots[slotId]) ~= "table" then
		return false, "EmptySlot"
	end
	DataService.Update(player, function(d)
		d.ActiveSlot = slotId
	end)
	return true, slotId
end

local function deleteLife(player: Player, slotArg: any)
	local slotId = Validate.OneOf(slotArg, DataTemplate.SlotIds)
	if not slotId then
		return false, "BadSlot"
	end
	local ok = DataService.Update(player, function(d)
		d.Slots[slotId] = false
	end)
	return ok, if ok then slotId else "NotLoaded"
end

function LifeService.GetScenario(player: Player)
	local data = DataService.Get(player)
	if not data then
		return false, "NotLoaded"
	end
	local life = activeLife(data)
	if not life then
		return false, "NoLife"
	end
	if life.Completed then
		return false, "LifeComplete"
	end

	local scenario = if life.CurrentScenario then Scenarios.ById[life.CurrentScenario] else nil
	if not scenario then
		scenario = ScenarioPicker.Pick(life, Scenarios.All, rngFor(life, 1))
		if not scenario then
			return false, "StageNotAvailable"
		end
		DataService.Update(player, function(d)
			local l = activeLife(d)
			if l then
				l.CurrentScenario = scenario.Id
			end
		end)
	end
	return true, LifeService.ToClient(scenario, life)
end

function LifeService.MakeChoice(player: Player, scenarioArg: any, choiceArg: any)
	local scenarioId = Validate.Id(scenarioArg)
	local choiceId = Validate.Id(choiceArg)
	if not scenarioId or not choiceId then
		return false, "BadArgs"
	end
	local data = DataService.Get(player)
	if not data then
		return false, "NotLoaded"
	end
	local life = activeLife(data)
	if not life or life.Completed then
		return false, "NoLife"
	end
	if life.CurrentScenario ~= scenarioId then
		return false, "WrongScenario"
	end
	local scenario = Scenarios.ById[scenarioId]
	local choice = scenario and scenario.ChoiceById[choiceId]
	if not choice then
		return false, "BadChoice"
	end
	if not Conditions.Check(life, choice.Requires) then
		return false, "ChoiceLocked"
	end

	local outcome
	local stageCompleted, lifeCompleted = nil, false
	DataService.Update(player, function(d)
		local l = activeLife(d)
		local prevAge, prevStage = l.Age, l.Stage
		local wealthStart = l.Stats.Wealth

		-- 1. The choice itself.
		local summary = Consequences.Apply(l, choice.Effects, rngFor(l, 2))
		-- How much this decision mattered (I) and how well it went (G), for the final reveal.
		local impact, goodness = 4 * #summary.LifeChanges, 0
		for stat, delta in pairs(summary.Applied) do
			if stat ~= "Wealth" then
				impact += math.abs(delta)
				goodness += delta
			end
		end
		if math.abs(summary.MoneyDelta) >= 10000 then
			impact += 5
			goodness += if summary.MoneyDelta > 0 then 3 else -3
		end
		table.insert(l.Decisions, {
			S = scenarioId,
			C = choiceId,
			Age = prevAge,
			Stage = prevStage,
			T = scenario.Title,
			X = choice.Text,
			I = math.floor(impact * 10 + 0.5) / 10,
			G = math.floor(goodness * 10 + 0.5) / 10,
		})
		l.Seen[scenarioId] = true
		l.CurrentScenario = false
		l.ScenarioIndex += 1
		d.Lifetime.DecisionsMade += 1

		-- 2. Time passes: ageing, income, career years.
		local stage = LifeStages.Get(l.Stage)
		local newAge = LifeStages.AgeAfterScenario(l.Stage, l.ScenarioIndex)
		if l.ScenarioIndex >= stage.ScenariosPerStage then
			stageCompleted = l.Stage
			if l.Stage < LifeStages.Count then
				newAge = LifeStages.Get(l.Stage + 1).MinAge
			end
		end
		local years = math.max(0, newAge - prevAge)
		local yearly = Yearly.Advance(l, prevAge, years, rngFor(l, 5), summary)
		l.Age = newAge

		-- 3. Maybe something unexpected happens.
		local eventPayload = nil
		local event = RandomEvents.Roll(l, Scenarios.Events, rngFor(l, 3))
		if event then
			local eventSummary = Consequences.Apply(l, event.Effects, rngFor(l, 4))
			table.insert(l.Events, event.Id)
			if event.Rarity == "Rare" or event.Rarity == "Legendary" then
				d.Lifetime.RareEventsSeen += 1
			end
			eventSummary.Applied.Wealth = nil
			eventPayload = {
				Id = event.Id,
				Title = event.Title,
				Icon = event.Icon,
				Rarity = event.Rarity,
				Story = eventSummary.Story,
				Applied = eventSummary.Applied,
				MoneyDelta = eventSummary.MoneyDelta,
				TraitsGained = eventSummary.TraitsGained,
				LifeChanges = eventSummary.LifeChanges,
				BondChanges = eventSummary.BondChanges,
				Lucky = eventSummary.OutcomeTriggered,
			}
		end

		-- 4. Stage bookkeeping + LIFE REVEAL.
		local revealPayload, finalEntry = nil, nil
		if stageCompleted then
			table.insert(l.Reveals, { Stage = stageCompleted, Age = l.Age, Stats = table.clone(l.Stats), Money = l.Money, Time = os.time() })
			if l.Stage < LifeStages.Count then
				l.Stage += 1
				l.ScenarioIndex = 0
				revealPayload = Reveal.Stage(l, stageCompleted, rngFor(l, 6))
			else
				l.Completed = true
				lifeCompleted = true
				d.Lifetime.LivesCompleted += 1
				Consequences.SyncWealth(l)
				finalEntry = Reveal.Final(l, d.Lifetime.LivesCompleted)
				l.HistoryId = finalEntry.Id
				table.insert(d.LifeHistory, finalEntry)
				TableUtil.TrimArray(d.LifeHistory, Config.MaxLifeHistory)
				d.Coins += finalEntry.Coins
				d.Lifetime.CoinsEarned += finalEntry.Coins
			end
		end

		Consequences.SyncWealth(l)
		local wealthChange = l.Stats.Wealth - wealthStart
		summary.Applied.Wealth = if math.abs(wealthChange) >= 0.05 then wealthChange else nil
		d.Lifetime.HighestNetWorth = math.max(d.Lifetime.HighestNetWorth, Consequences.NetWorth(l))

		outcome = {
			ScenarioId = scenarioId,
			ChoiceId = choiceId,
			Story = summary.Story,
			Applied = summary.Applied,
			MoneyDelta = summary.MoneyDelta - yearly.Income,
			Income = yearly.Income,
			Years = yearly.Years,
			Money = l.Money,
			Lucky = summary.OutcomeTriggered,
			TraitsGained = summary.TraitsGained,
			LifeChanges = summary.LifeChanges,
			BondChanges = summary.BondChanges,
			Investment = yearly.Investment,
			Event = eventPayload,
			Reveal = revealPayload,
			Final = finalEntry,
			PrevAge = prevAge,
			Age = l.Age,
			PrevStage = prevStage,
			Stage = l.Stage,
			StageName = LifeStages.Get(l.Stage).DisplayName,
			StageCompleted = stageCompleted ~= nil,
			CompletedStageName = if stageCompleted then LifeStages.Get(stageCompleted).DisplayName else nil,
			LifeCompleted = lifeCompleted,
			NextStageAvailable = lifeCompleted or Scenarios.CountForStage(l.Stage) > 0,
		}
	end)

	StatService.StatsChanged:Fire(player, outcome.Applied, "Choice:" .. scenarioId)
	LifeService.ChoiceMade:Fire(player, scenarioId, choiceId, outcome)
	if stageCompleted then
		LifeService.StageCompleted:Fire(player, stageCompleted, life)
	end
	if lifeCompleted then
		LifeService.LifeCompleted:Fire(player, life)
	end
	return true, TableUtil.DeepCopy(outcome)
end

--[[
	Runs one Lib/Actions function on the active life inside DataService.Update.
	Actions get their own RNG stream keyed by decision count + actions used,
	so results can't be rerolled by retrying.
]]
local function runAction(player: Player, fn, ...)
	local data = DataService.Get(player)
	if not data then
		return false, "NotLoaded"
	end
	local life = activeLife(data)
	if not life or life.Completed then
		return false, "NoLife"
	end
	local args = table.pack(...)
	local ok, result
	DataService.Update(player, function(d)
		local l = activeLife(d)
		local salt = 10 + (if l.ActionTurn == #l.Decisions then l.ActionsUsed else 0)
		-- Append the RNG as the last argument. (A table.unpack in the middle of
		-- an argument list would be cut down to its first value.)
		args[args.n + 1] = rngFor(l, salt)
		ok, result = fn(l, table.unpack(args, 1, args.n + 1))
	end)
	return ok, if type(result) == "table" then TableUtil.DeepCopy(result) else result
end

function LifeService.Interact(player: Player, personId: any, action: any)
	local id = Validate.Id(personId, 16)
	local kind = Validate.OneOf(action, { "Time", "Gift", "Talk" })
	if not id or not kind then
		return false, "BadArgs"
	end
	return runAction(player, Actions.Interact, id, kind)
end

function LifeService.MeetPeople(player: Player, kind: any)
	local k = Validate.OneOf(kind, { "Friend", "Love" })
	if not k then
		return false, "BadArgs"
	end
	return runAction(player, Actions.Meet, k)
end

function LifeService.SetFocus(player: Player, focus: any)
	local id = Validate.Id(focus, 16)
	if not id then
		return false, "BadArgs"
	end
	return runAction(player, function(life, f)
		return Actions.SetFocus(life, f)
	end, id)
end

function LifeService.Invest(player: Player, amount: any)
	return runAction(player, function(life, a)
		return Actions.Invest(life, a)
	end, amount)
end

function LifeService.Withdraw(player: Player, amount: any)
	return runAction(player, function(life, a)
		return Actions.Withdraw(life, a)
	end, amount)
end

function LifeService.RepayLoan(player: Player, index: any, amount: any)
	return runAction(player, function(life, i, a)
		return Actions.RepayLoan(life, i, a)
	end, index, amount)
end

function LifeService.Init()
	if #Scenarios.Issues > 0 then
		warn(("[LifeService] %d content issue(s) found; see warnings above"):format(#Scenarios.Issues))
	end
end

function LifeService.Start()
	Net.Handle("StartNewLife", startNewLife)
	Net.Handle("ContinueLife", continueLife)
	Net.Handle("DeleteLife", deleteLife)
	Net.Handle("GetScenario", LifeService.GetScenario)
	Net.Handle("MakeChoice", LifeService.MakeChoice)
	Net.Handle("Interact", LifeService.Interact)
	Net.Handle("MeetPeople", LifeService.MeetPeople)
	Net.Handle("SetFocus", LifeService.SetFocus)
	Net.Handle("Invest", LifeService.Invest)
	Net.Handle("Withdraw", LifeService.Withdraw)
	Net.Handle("RepayLoan", LifeService.RepayLoan)
end

return LifeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">PartyService</string>
            <string name="Source"><![CDATA[--[[
	PartyService  (ServerScriptService.Server.Services.PartyService)
	"Life Circles": play with friends while every life stays independent.

	Circles (parties) of up to 4 players in the same server:
	  PartyInvite(targetUserId) · PartyRespond(inviteId, accept) · PartyLeave() · PartyKick(userId)
	  Invites expire; the leader role passes on if the leader leaves; a circle
	  of one dissolves.

	Group events (PartyStartEvent → PartyVote):
	  The server picks a group scenario every member qualifies for
	  (Content/GroupScenarios), everyone votes, and the majority wins (ties and
	  no-shows are settled fairly at random). Chance outcomes are rolled ONCE
	  for the group (shared fate), but the effects are applied to each
	  member's OWN life with their own stats, traits and money. Nothing a
	  friend does ever writes to your life except through a vote you were
	  part of. Group events don't use a decision or change anyone's age.
	  Each member's life also gains the others as named friends and records
	  the shared moment (it appears in the Final Reveal).

	Group Life Reveal (PartyStartReveal): everyone watches each member's
	predicted futures, then a "most likely to…" board. Privacy settings
	still apply; circle members count as friends.

	JoinFriendServer(placeId, jobId): teleport to a friend's server of this
	experience (the client finds friends with Player:GetFriendsOnline).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local People = require(Shared.Util.People)
local Futures = require(Shared.Util.Futures)
local TableUtil = require(Shared.Util.TableUtil)
local LifeStages = require(Shared.Data.LifeStages)
local Careers = require(Shared.Data.Careers)

local Server = script.Parent.Parent
local Conditions = require(Server.Lib.Conditions)
local Consequences = require(Server.Lib.Consequences)
local Scenarios = require(Server.Content.Scenarios)

local DataService = require(script.Parent.DataService)
local RevealService = require(script.Parent.RevealService)

local PartyService = {}
PartyService.Priority = 36

PartyService.MaxMembers = 4
PartyService.InviteSeconds = 45
PartyService.VoteSeconds = 40
PartyService.EventCooldown = 90
PartyService.RevealCooldown = 45
PartyService.MaxSharedMoments = 10

PartyService.EventResolved = Signal.new() -- (party, scenario, choiceId, outcomeIndex)

local parties = {}
local partyOf: { [Player]: any } = {}
local invites = {}
local counters = { Party = 0, Invite = 0, Event = 0, Reveal = 0 }
local rng = Random.new()

-- ===== Helpers =====
local function now(): number
	return os.clock()
end

local function findPlayer(userId: any): Player?
	if type(userId) ~= "number" or userId ~= userId or userId % 1 ~= 0 then
		return nil
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p.UserId == userId then
			return p
		end
	end
	return nil
end

local function displayName(player: Player): string
	return player.DisplayName or player.Name
end

local function activeLife(player: Player)
	local life = DataService.GetActiveLife(player)
	if life and not life.Completed then
		return life
	end
	return nil
end

function PartyService.PartyOf(player: Player)
	return partyOf[player]
end

function PartyService.SameParty(a: Player, b: Player): boolean
	return partyOf[a] ~= nil and partyOf[a] == partyOf[b]
end

local function memberInfo(party, player: Player)
	local info = { UserId = player.UserId, DisplayName = displayName(player), IsLeader = party.Leader == player }
	local life = DataService.GetActiveLife(player)
	if life then
		info.LifeName = life.Name
		info.Age = life.Age
		info.StageName = LifeStages.Get(life.Stage).DisplayName
		info.Completed = life.Completed
		info.Career = if life.Career.Id ~= "None" and Careers.Info[life.Career.Id] then Careers.TitleAt(life.Career.Id, life.Career.Level) elseif life.Flags.Retired then "Retired" else nil
	end
	return info
end

function PartyService.State(party)
	local members = {}
	for _, member in ipairs(party.Members) do
		table.insert(members, memberInfo(party, member))
	end
	return {
		Id = party.Id,
		LeaderUserId = party.Leader.UserId,
		Members = members,
		MaxMembers = PartyService.MaxMembers,
		EventActive = party.Event ~= nil,
		EventCooldown = math.max(0, math.ceil(PartyService.EventCooldown - (now() - party.LastEventAt))),
		RevealCooldown = math.max(0, math.ceil(PartyService.RevealCooldown - (now() - party.LastRevealAt))),
	}
end

local function broadcast(party)
	local state = PartyService.State(party)
	for _, member in ipairs(party.Members) do
		Net.Fire("PartyUpdate", member, state)
	end
end

local function notify(player: Player, text: string, kind: string?)
	Net.Fire("Notify", player, { Title = "🤝 Life Circle", Text = text, Kind = kind or "Info" })
end

-- ===== Circle membership =====
local resolveEvent

local function removeFromParty(player: Player, reason: string?)
	local party = partyOf[player]
	if not party then
		return
	end
	partyOf[player] = nil
	local index = table.find(party.Members, player)
	if index then
		table.remove(party.Members, index)
	end
	if player.Parent then
		Net.Fire("PartyUpdate", player, false)
	end
	if #party.Members <= 1 then
		-- A circle of one dissolves.
		for _, last in ipairs(party.Members) do
			partyOf[last] = nil
			Net.Fire("PartyUpdate", last, false)
			notify(last, "Your Life Circle has ended.")
		end
		party.Members = {}
		party.Event = nil
		parties[party.Id] = nil
		return
	end
	if party.Leader == player then
		party.Leader = party.Members[1]
	end
	for _, member in ipairs(party.Members) do
		notify(member, displayName(player) .. (if reason == "Kicked" then " was removed from the circle." else " left the circle."))
	end
	-- A leaving voter no longer counts; finish the vote if everyone left has voted.
	local event = party.Event
	if event then
		event.Votes[player] = nil
		local stillVoting = false
		for _, voter in ipairs(event.Voters) do
			if partyOf[voter] == party and event.Votes[voter] == nil then
				stillVoting = true
			end
		end
		if not stillVoting then
			resolveEvent(party)
		end
	end
	broadcast(party)
end

function PartyService.Invite(player: Player, targetUserId: any)
	local target = findPlayer(targetUserId)
	if not target then
		return false, "NotHere"
	end
	if target == player then
		return false, "Self"
	end
	if not DataService.IsLoaded(player) or not DataService.IsLoaded(target) then
		return false, "NotLoaded"
	end
	local party = partyOf[player]
	if party and table.find(party.Members, target) then
		return false, "AlreadyMember"
	end
	if party and #party.Members >= PartyService.MaxMembers then
		return false, "PartyFull"
	end
	for _, invite in pairs(invites) do
		if invite.From == player and invite.To == target and invite.Expires > now() then
			return false, "AlreadyInvited"
		end
	end
	counters.Invite += 1
	local id = "inv" .. counters.Invite
	invites[id] = { Id = id, From = player, To = target, Expires = now() + PartyService.InviteSeconds }
	Net.Fire("PartyInviteReceived", target, { InviteId = id, FromUserId = player.UserId, FromName = displayName(player), Seconds = PartyService.InviteSeconds })
	return true, { InviteId = id }
end

function PartyService.Respond(player: Player, inviteId: any, accept: any)
	if type(inviteId) ~= "string" then
		return false, "BadArgs"
	end
	local invite = invites[inviteId]
	if not invite or invite.To ~= player then
		return false, "NoInvite"
	end
	invites[inviteId] = nil
	if invite.Expires < now() then
		return false, "Expired"
	end
	local from = invite.From
	if not from.Parent then
		return false, "NotHere"
	end
	if accept ~= true then
		notify(from, displayName(player) .. " declined your invite.")
		return true, { Joined = false }
	end
	local party = partyOf[from]
	if party and #party.Members >= PartyService.MaxMembers then
		return false, "PartyFull"
	end
	if partyOf[player] and partyOf[player] ~= party then
		removeFromParty(player)
	end
	if not party then
		counters.Party += 1
		party = { Id = "circle" .. counters.Party, Leader = from, Members = { from }, LastEventAt = -math.huge, LastRevealAt = -math.huge, Recent = {} }
		parties[party.Id] = party
		partyOf[from] = party
	end
	if not table.find(party.Members, player) then
		table.insert(party.Members, player)
	end
	partyOf[player] = party
	for _, member in ipairs(party.Members) do
		if member ~= player then
			notify(member, displayName(player) .. " joined your Life Circle!", "Success")
		end
	end
	broadcast(party)
	return true, { Joined = true, PartyId = party.Id }
end

function PartyService.Leave(player: Player)
	if not partyOf[player] then
		return false, "NoParty"
	end
	removeFromParty(player)
	return true
end

function PartyService.Kick(player: Player, userId: any)
	local party = partyOf[player]
	if not party then
		return false, "NoParty"
	end
	if party.Leader ~= player then
		return false, "NotLeader"
	end
	local target = findPlayer(userId)
	if not target or target == player or partyOf[target] ~= party then
		return false, "NotMember"
	end
	removeFromParty(target, "Kicked")
	if target.Parent then
		notify(target, "You were removed from the Life Circle.", "Warning")
	end
	return true
end

-- ===== Group events =====
local function lockedFor(lives, requires): boolean
	for _, life in ipairs(lives) do
		if not Conditions.Check(life, requires) then
			return true
		end
	end
	return false
end

function PartyService.EligibleScenarios(lives)
	local list = {}
	for _, scenario in ipairs(Scenarios.Group) do
		if not lockedFor(lives, scenario.Requires) then
			local open = 0
			for _, choice in ipairs(scenario.Choices) do
				if not lockedFor(lives, choice.Requires) then
					open += 1
				end
			end
			if open >= 2 then
				table.insert(list, scenario)
			end
		end
	end
	return list
end

function PartyService.StartEvent(player: Player, forcedScenarioId: string?)
	local party = partyOf[player]
	if not party then
		return false, "NoParty"
	end
	if party.Event then
		return false, "EventActive"
	end
	local wait = PartyService.EventCooldown - (now() - party.LastEventAt)
	if wait > 0 then
		return false, "Cooldown", math.ceil(wait)
	end
	local lives = {}
	for _, member in ipairs(party.Members) do
		local life = activeLife(member)
		if not life then
			return false, "NotEveryoneReady", displayName(member)
		end
		table.insert(lives, life)
	end
	local eligible = PartyService.EligibleScenarios(lives)
	local scenario
	if forcedScenarioId then
		scenario = Scenarios.GroupById[forcedScenarioId]
		if not scenario or not table.find(eligible, scenario) then
			return false, "NotEligible"
		end
	else
		local total, weights = 0, {}
		for i, s in ipairs(eligible) do
			weights[i] = (s.Weight or 1) * (if table.find(party.Recent, s.Id) then 0.15 else 1)
			total += weights[i]
		end
		local roll = rng:NextNumber() * total
		for i, s in ipairs(eligible) do
			roll -= weights[i]
			if roll <= 0 then
				scenario = s
				break
			end
		end
		scenario = scenario or eligible[#eligible]
	end
	if not scenario then
		return false, "NoEvent"
	end
	counters.Event += 1
	local event = {
		Id = counters.Event,
		Scenario = scenario,
		Voters = table.clone(party.Members),
		Votes = {},
		Locked = {},
		StartedBy = player,
	}
	local choices = {}
	for index, choice in ipairs(scenario.Choices) do
		local locked = lockedFor(lives, choice.Requires)
		event.Locked[choice.Id] = locked
		local preview, moneyDir, risky, tags = Consequences.Preview(choice.Effects)
		table.insert(choices, {
			Id = choice.Id,
			Index = index,
			Text = choice.Text,
			Description = choice.Description,
			Locked = locked,
			LockHint = if locked then (choice.LockHint or "Not everyone can do this") else nil,
			Preview = preview,
			MoneyDir = moneyDir,
			Risky = risky,
			Tags = tags,
		})
	end
	local names = {}
	for _, member in ipairs(party.Members) do
		table.insert(names, displayName(member))
	end
	party.Event = event
	local payload = {
		EventId = event.Id,
		Icon = scenario.Icon,
		Title = scenario.Title,
		Description = scenario.Description,
		Choices = choices,
		Seconds = PartyService.VoteSeconds,
		Members = names,
		StartedBy = displayName(player),
	}
	for _, member in ipairs(party.Members) do
		Net.Fire("GroupEvent", member, payload)
	end
	broadcast(party)
	task.delay(PartyService.VoteSeconds, function()
		if party.Event == event then
			resolveEvent(party)
		end
	end)
	return true, { EventId = event.Id, ScenarioId = scenario.Id }
end

function PartyService.Vote(player: Player, eventId: any, choiceId: any)
	local party = partyOf[player]
	local event = party and party.Event
	if not event or event.Id ~= eventId then
		return false, "NoEvent"
	end
	if not table.find(event.Voters, player) then
		return false, "NotInEvent"
	end
	if type(choiceId) ~= "string" or not event.Scenario.ChoiceById[choiceId] then
		return false, "BadChoice"
	end
	if event.Locked[choiceId] then
		return false, "ChoiceLocked"
	end
	event.Votes[player] = choiceId
	local votes = {}
	for voter, choice in pairs(event.Votes) do
		votes[tostring(voter.UserId)] = choice
	end
	for _, member in ipairs(party.Members) do
		Net.Fire("GroupVote", member, { EventId = event.Id, Votes = votes })
	end
	local everyone = true
	for _, voter in ipairs(event.Voters) do
		if partyOf[voter] == party and event.Votes[voter] == nil then
			everyone = false
		end
	end
	if everyone then
		task.defer(function()
			if party.Event == event then
				resolveEvent(party)
			end
		end)
	end
	return true
end

function resolveEvent(party)
	local event = party.Event
	if not event then
		return
	end
	party.Event = nil
	party.LastEventAt = now()
	table.insert(party.Recent, event.Scenario.Id)
	if #party.Recent > 4 then
		table.remove(party.Recent, 1)
	end
	local scenario = event.Scenario

	-- Count votes from voters still in the circle.
	local tally, best, top = {}, 0, {}
	local voteMap = {}
	for voter, choiceId in pairs(event.Votes) do
		if partyOf[voter] == party then
			tally[choiceId] = (tally[choiceId] or 0) + 1
			voteMap[tostring(voter.UserId)] = choiceId
		end
	end
	for choiceId, count in pairs(tally) do
		if count > best then
			best, top = count, { choiceId }
		elseif count == best then
			table.insert(top, choiceId)
		end
	end
	local noVotes = #top == 0
	if noVotes then
		for _, choice in ipairs(scenario.Choices) do
			if not event.Locked[choice.Id] then
				table.insert(top, choice.Id)
			end
		end
	end
	table.sort(top)
	local choiceId = top[rng:NextInteger(1, #top)]
	local choice = scenario.ChoiceById[choiceId]
	local outcomeIndex = Consequences.RollOutcome(choice.Effects, rng) -- shared fate

	local members = table.clone(party.Members)
	local lifeNames = {}
	for _, member in ipairs(members) do
		local life = DataService.GetActiveLife(member)
		lifeNames[member] = if life then life.Name else displayName(member)
	end
	for _, member in ipairs(members) do
		local result
		DataService.Update(member, function(d)
			local life = d.Slots[d.ActiveSlot]
			if type(life) ~= "table" or life.Completed then
				return
			end
			local memberRng = Random.new((life.Seed + #life.Decisions * 31 + event.Id * 7) % 2147483646 + 1)
			local summary = Consequences.Apply(life, choice.Effects, memberRng, true, outcomeIndex)
			-- Friends in real life become friends in each other's lives.
			local others = {}
			for _, other in ipairs(members) do
				if other ~= member then
					table.insert(others, lifeNames[other])
					local existing = nil
					for _, person in ipairs(life.People) do
						if person.PlayerUserId == other.UserId then
							existing = person
						end
					end
					if existing then
						Consequences.ChangeBond(existing, 5, summary)
					else
						local added = People.AddNamed(life, "Friend", lifeNames[other], other.UserId, 70)
						if added then
							table.insert(summary.LifeChanges, ("🤝 %s (%s) is now in your People"):format(added.Name, displayName(other)))
						end
					end
				end
			end
			life.Shared = life.Shared or {}
			table.insert(life.Shared, { Title = scenario.Title, Icon = scenario.Icon, With = others, Age = life.Age })
			TableUtil.TrimArray(life.Shared, PartyService.MaxSharedMoments)
			Consequences.SyncWealth(life)
			summary.Applied.Wealth = nil
			result = {
				EventId = event.Id,
				Icon = scenario.Icon,
				Title = scenario.Title,
				ChoiceId = choiceId,
				ChoiceText = choice.Text,
				Tally = tally,
				Votes = voteMap,
				NoVotes = noVotes,
				Tie = not noVotes and #top > 1,
				Lucky = outcomeIndex > 0,
				Story = summary.Story,
				Applied = summary.Applied,
				MoneyDelta = summary.MoneyDelta,
				LifeChanges = summary.LifeChanges,
				TraitsGained = summary.TraitsGained,
				BondChanges = summary.BondChanges,
			}
		end)
		if result and member.Parent then
			Net.Fire("GroupEventResult", member, result)
		end
	end
	PartyService.EventResolved:Fire(party, scenario, choiceId, outcomeIndex)
	if parties[party.Id] then
		broadcast(party)
	end
end

-- ===== Group Life Reveal =====
local function superlatives(cards)
	local list = {}
	for _, id in ipairs(Futures.Order) do
		local info = Futures.Info[id]
		if info.Positive then
			local best = nil
			for _, c in ipairs(cards) do
				if c.Card and (not best or c.Card.Predictions[id] > best.Card.Predictions[id]) then
					best = c
				end
			end
			if best and best.Card.Predictions[id] >= 15 then
				table.insert(list, { Id = id, UserId = best.UserId, DisplayName = best.DisplayName, LifeName = best.Card.LifeName, Pct = best.Card.Predictions[id] })
			end
		end
	end
	table.sort(list, function(a, b)
		return a.Pct > b.Pct
	end)
	return list
end

function PartyService.StartReveal(player: Player)
	local party = partyOf[player]
	if not party then
		return false, "NoParty"
	end
	local wait = PartyService.RevealCooldown - (now() - party.LastRevealAt)
	if wait > 0 then
		return false, "Cooldown", math.ceil(wait)
	end
	party.LastRevealAt = now()
	counters.Reveal += 1
	for _, viewer in ipairs(party.Members) do
		local cards = {}
		for _, target in ipairs(party.Members) do
			local card = RevealService.CardFor(viewer, target)
			if card then
				table.insert(cards, card)
			end
		end
		Net.Fire("GroupReveal", viewer, {
			SessionId = counters.Reveal,
			StartedBy = displayName(player),
			Cards = cards,
			Superlatives = superlatives(cards),
		})
	end
	broadcast(party)
	return true
end

-- ===== Joining friends in other servers =====
local function looksLikeJobId(value: any): boolean
	return type(value) == "string" and #value <= 64 and value:match("^[%w%-]+$") ~= nil
end

function PartyService.JoinFriendServer(player: Player, placeId: any, jobId: any)
	if placeId ~= game.PlaceId or not looksLikeJobId(jobId) then
		return false, "BadServer"
	end
	if jobId == game.JobId then
		return false, "SameServer"
	end
	local ok, err = pcall(function()
		TeleportService:TeleportToPlaceInstance(placeId, jobId, player)
	end)
	if not ok then
		return false, "TeleportFailed: " .. tostring(err)
	end
	return true
end

-- ===== Lifecycle =====
function PartyService.Init()
	RevealService.ExtraFriendCheck = PartyService.SameParty
end

function PartyService.Start()
	Net.Handle("PartyInvite", PartyService.Invite)
	Net.Handle("PartyRespond", PartyService.Respond)
	Net.Handle("PartyLeave", PartyService.Leave)
	Net.Handle("PartyKick", PartyService.Kick)
	Net.Handle("PartyStartEvent", function(player)
		return PartyService.StartEvent(player)
	end)
	Net.Handle("PartyVote", PartyService.Vote)
	Net.Handle("PartyStartReveal", PartyService.StartReveal)
	Net.Handle("JoinFriendServer", PartyService.JoinFriendServer)
	Net.Handle("GetPartyState", function(player)
		local party = partyOf[player]
		return true, if party then PartyService.State(party) else false
	end)
	Players.PlayerRemoving:Connect(function(player)
		removeFromParty(player)
		for id, invite in pairs(invites) do
			if invite.From == player or invite.To == player then
				invites[id] = nil
			end
		end
	end)
	-- Tidy expired invites.
	task.spawn(function()
		while true do
			task.wait(30)
			for id, invite in pairs(invites) do
				if invite.Expires < now() then
					invites[id] = nil
				end
			end
		end
	end)
end

return PartyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">RevealService</string>
            <string name="Source"><![CDATA[--[[
	RevealService  (ServerScriptService.Server.Services.RevealService)
	Friends' Life Reveals: lets players compare predicted futures with
	others in the same server, respecting each player's privacy settings
	(Settings → Privacy):
	  ShareReveals  who may see your predicted futures at all
	  ShareStats    who may also see your exact stats and net worth
	  ShareHistory  who may see the endings of your past lives
	Each is Everyone / Friends / Nobody. "Friends" uses Roblox friendships.

	Remote: GetLifeCards() -> true, { card per player in the server }
	(Group reveal sessions arrive with multiplayer in Phase 6.)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("Shared").Net)

local DataService = require(script.Parent.DataService)
local SettingsService = require(script.Parent.SettingsService)
local Reveal = require(script.Parent.Parent.Lib.Reveal)

local RevealService = {}
RevealService.Priority = 35
RevealService.FriendCacheSeconds = 300

local friendCache: { [string]: { Value: boolean, Time: number } } = {}

-- Set by PartyService: members of the same Life Circle count as friends.
RevealService.ExtraFriendCheck = nil :: ((Player, Player) -> boolean)?

function RevealService.AreFriends(a: Player, b: Player): boolean
	if a == b then
		return true
	end
	local low, high = math.min(a.UserId, b.UserId), math.max(a.UserId, b.UserId)
	local key = low .. ":" .. high
	local cached = friendCache[key]
	if cached and os.clock() - cached.Time < RevealService.FriendCacheSeconds then
		return cached.Value
	end
	local ok, result = pcall(function()
		return a:IsFriendsWith(b.UserId)
	end)
	local value = ok and result == true
	friendCache[key] = { Value = value, Time = os.clock() }
	return value
end

function RevealService.CardFor(viewer: Player, target: Player)
	local data = DataService.Get(target)
	if not data then
		return nil
	end
	local partyFriend = RevealService.ExtraFriendCheck ~= nil and RevealService.ExtraFriendCheck(viewer, target)
	local relation = if viewer == target then "Self" elseif partyFriend or RevealService.AreFriends(viewer, target) then "Friend" else "Stranger"
	local entry = {
		UserId = target.UserId,
		DisplayName = target.DisplayName or target.Name,
		IsYou = relation == "Self",
		IsFriend = relation == "Friend",
	}
	if SettingsService.CanView(target, "ShareHistory", relation) then
		local endings = {}
		for i = #data.LifeHistory, math.max(1, #data.LifeHistory - 2), -1 do
			local h = data.LifeHistory[i]
			table.insert(endings, { Icon = h.Ending.Icon, Title = h.Ending.Title, Name = h.Name })
		end
		entry.Endings = endings
	end
	if not SettingsService.CanView(target, "ShareReveals", relation) then
		entry.Hidden = true
		return entry
	end
	local life = data.Slots[data.ActiveSlot]
	if type(life) ~= "table" then
		entry.NoLife = true
		return entry
	end
	entry.Card = Reveal.Card(life, SettingsService.CanView(target, "ShareStats", relation))
	return entry
end

function RevealService.CardsFor(viewer: Player)
	local cards = {}
	for _, target in ipairs(Players:GetPlayers()) do
		local card = RevealService.CardFor(viewer, target)
		if card then
			table.insert(cards, card)
		end
	end
	table.sort(cards, function(a, b)
		if a.IsYou ~= b.IsYou then
			return a.IsYou
		end
		if a.IsFriend ~= b.IsFriend then
			return a.IsFriend
		end
		return a.DisplayName < b.DisplayName
	end)
	return cards
end

function RevealService.Init() end

function RevealService.Start()
	Net.Handle("GetLifeCards", function(player)
		if not DataService.IsLoaded(player) then
			return false, "NotLoaded"
		end
		return true, RevealService.CardsFor(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		for key in pairs(friendCache) do
			if key:find(tostring(player.UserId), 1, true) then
				friendCache[key] = nil
			end
		end
	end)
end

return RevealService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">SettingsService</string>
            <string name="Source"><![CDATA[--[[
	SettingsService  (ServerScriptService.Server.Services.SettingsService)
	Saves client preferences and privacy choices. Every field is validated
	against a schema; unknown keys and out-of-range values are dropped.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local DataService = require(script.Parent.DataService)
local Validate = require(script.Parent.Parent.Lib.Validate)

local SettingsService = {}
SettingsService.Priority = 20

local SHARE_OPTIONS = { "Everyone", "Friends", "Nobody" }

SettingsService.SettingsSchema = {
	MusicVolume = { Kind = "Number", Min = 0, Max = 1 },
	SfxVolume = { Kind = "Number", Min = 0, Max = 1 },
	Graphics = { Kind = "OneOf", Options = { "Auto", "Low", "High" } },
	UIScale = { Kind = "Number", Min = 0.75, Max = 1.25 },
	CameraSensitivity = { Kind = "Number", Min = 0.2, Max = 2 },
	Notifications = { Kind = "Boolean" },
	ReduceAnimations = { Kind = "Boolean" },
}

SettingsService.PrivacySchema = {
	ShareStats = { Kind = "OneOf", Options = SHARE_OPTIONS },
	ShareReveals = { Kind = "OneOf", Options = SHARE_OPTIONS },
	ShareHistory = { Kind = "OneOf", Options = SHARE_OPTIONS },
}

local function applyPartial(player: Player, field: string, input: any, schema)
	local clean = Validate.Partial(input, schema)
	if next(clean) == nil then
		return false, "NothingValid"
	end
	local ok = DataService.Update(player, function(data)
		for key, value in pairs(clean) do
			data[field][key] = value
		end
	end)
	if not ok then
		return false, "NotLoaded"
	end
	return true, clean
end

-- Used by multiplayer systems (Phase 6) before revealing someone's stats.
-- relation: "Self" | "Friend" | "Stranger"
function SettingsService.CanView(owner: Player, field: string, relation: string): boolean
	if relation == "Self" then
		return true
	end
	local data = DataService.Get(owner)
	if not data then
		return false
	end
	local level = data.Privacy[field]
	if level == "Everyone" then
		return true
	elseif level == "Friends" then
		return relation == "Friend"
	end
	return false
end

function SettingsService.Init() end

function SettingsService.Start()
	Net.Handle("UpdateSettings", function(player, input)
		return applyPartial(player, "Settings", input, SettingsService.SettingsSchema)
	end)
	Net.Handle("UpdatePrivacy", function(player, input)
		return applyPartial(player, "Privacy", input, SettingsService.PrivacySchema)
	end)
end

return SettingsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">StatService</string>
            <string name="Source"><![CDATA[--[[
	StatService  (ServerScriptService.Server.Services.StatService)
	Authoritative stat changes for the active life. Decision, event, career and
	relationship systems (later phases) call StatService.Apply; nothing on the
	client can change stats directly.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local StatMath = require(Shared.Util.StatMath)
local Signal = require(Shared.Util.Signal)

local DataService = require(script.Parent.DataService)

local StatService = {}
StatService.Priority = 10

StatService.StatsChanged = Signal.new() -- (player, applied, reason)

--[[
	Applies deltas to the active life. `multipliers` lets traits amplify or dampen
	specific stats (e.g. a "Resilient" trait halves Health losses).
	Returns the actually-applied deltas, or nil if the player has no active life.
]]
function StatService.Apply(player: Player, deltas: { [string]: number }, reason: string, multipliers: { [string]: number }?)
	local applied
	local ok = DataService.Update(player, function(data)
		local life = data.Slots[data.ActiveSlot]
		if type(life) ~= "table" or life.Completed then
			return
		end
		local newStats
		newStats, applied = StatMath.Apply(life.Stats, deltas, multipliers)
		life.Stats = newStats
	end)
	if ok and applied then
		StatService.StatsChanged:Fire(player, applied, reason)
		return applied
	end
	return nil
end

function StatService.Get(player: Player): { [string]: number }?
	local life = DataService.GetActiveLife(player)
	return life and table.clone(life.Stats)
end

-- Recomputes the Wealth stat from money + asset value (called by economy systems).
function StatService.SyncWealth(player: Player, netWorth: number)
	DataService.Update(player, function(data)
		local life = data.Slots[data.ActiveSlot]
		if type(life) == "table" then
			life.Stats.Wealth = StatMath.WealthFromNetWorth(netWorth)
		end
	end)
end

function StatService.Init() end
function StatService.Start() end

return StatService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="59">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="60">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="61">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="62">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--[[
	AudioController  (StarterPlayerScripts.Client.Controllers.AudioController)
	Creates Music and SFX SoundGroups (driven by the volume settings), plays UI
	sound effects and switches background music per screen.
	Asset ids live in Shared.Data.SoundIds; empty ids are skipped.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local SoundIds = require(ReplicatedStorage:WaitForChild("Shared").Data.SoundIds)
local Components = require(script.Parent.Parent:WaitForChild("UILib").Components)

local AudioController = {}
AudioController.Priority = 2

local musicGroup: SoundGroup
local sfxGroup: SoundGroup
local sfxCache: { [string]: Sound } = {}
local currentMusic: Sound? = nil
local currentMusicName: string? = nil

local MUSIC_FOR_SCREEN = {
	Menu = "MenuMusic",
	SlotSelect = "MenuMusic",
	NameEntry = "MenuMusic",
	Settings = nil, -- keep whatever is playing
	Credits = "MenuMusic",
	Game = "GameMusic",
}

local function makeSound(name: string, group: SoundGroup, looped: boolean): Sound?
	local id = SoundIds[name]
	if type(id) ~= "string" or id == "" then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = id
	sound.Looped = looped
	sound.SoundGroup = group
	sound.Parent = group
	return sound
end

function AudioController.Play(name: string)
	local sound = sfxCache[name]
	if sound == nil then
		sound = makeSound(name, sfxGroup, false)
		sfxCache[name] = sound or (false :: any)
	end
	if sound then
		sound.TimePosition = 0
		sound:Play()
	end
end

function AudioController.PlayMusic(name: string?)
	if name == currentMusicName then
		return
	end
	currentMusicName = name
	if currentMusic then
		currentMusic:Stop()
		currentMusic:Destroy()
		currentMusic = nil
	end
	if name then
		currentMusic = makeSound(name, musicGroup, true)
		if currentMusic then
			currentMusic:Play()
		end
	end
end

function AudioController.SetVolumes(music: number, sfx: number)
	musicGroup.Volume = math.clamp(music, 0, 1)
	sfxGroup.Volume = math.clamp(sfx, 0, 1)
end

function AudioController.Init()
	musicGroup = Instance.new("SoundGroup")
	musicGroup.Name = "CYL_Music"
	musicGroup.Parent = SoundService
	sfxGroup = Instance.new("SoundGroup")
	sfxGroup.Name = "CYL_SFX"
	sfxGroup.Parent = SoundService
	Components.OnClickSound = function()
		AudioController.Play("Click")
	end
end

function AudioController.Start()
	local UIController = require(script.Parent.UIController)
	UIController.ScreenChanged:Connect(function(screen)
		local track = MUSIC_FOR_SCREEN[screen]
		if track then
			AudioController.PlayMusic(track)
		end
	end)
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">ControlsController</string>
              <string name="Source"><![CDATA[--[[
	ControlsController  (StarterPlayerScripts.Client.Controllers.ControlsController)
	Until the 3D world arrives (Phase 8) the game is played through its menus,
	so the default character controls are switched off: no walking with WASD
	behind the UI, and no touch thumbstick / jump button covering the decision
	cards on phones and tablets.
	ControlsController.SetEnabled(true) turns them back on (world mode).
]]

local Players = game:GetService("Players")

local ControlsController = {}
ControlsController.Priority = 6

local controls = nil
local wantEnabled = false

function ControlsController.SetEnabled(enabled: boolean)
	wantEnabled = enabled
	if controls then
		if enabled then
			controls:Enable()
		else
			controls:Disable()
		end
	end
end

function ControlsController.Init() end

function ControlsController.Start()
	-- PlayerModule is Roblox's default control script inside PlayerScripts.
	local ok, module = pcall(function()
		local playerScripts = Players.LocalPlayer:WaitForChild("PlayerScripts", 15)
		local playerModule = playerScripts and playerScripts:WaitForChild("PlayerModule", 15)
		return playerModule and require(playerModule)
	end)
	if ok and module then
		controls = module:GetControls()
		ControlsController.SetEnabled(wantEnabled)
	end
end

return ControlsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">DataController</string>
              <string name="Source"><![CDATA[--[[
	DataController  (StarterPlayerScripts.Client.Controllers.DataController)
	Holds the local player's latest data snapshot sent by the server.
	The client copy is DISPLAY-ONLY: changing it changes nothing on the server.

	DataController.Changed:Connect(function(data) ... end)
	DataController.Get()            -> data or nil
	DataController.WaitForData()    -> data (yields until first snapshot)
	DataController.GetActiveLife()  -> life table or nil
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)

local DataController = {}
DataController.Priority = 0

DataController.Changed = Signal.new() -- (data)
DataController.Loaded = Signal.new() -- () fired once

local current = nil

local function set(data)
	if type(data) ~= "table" then
		return
	end
	-- The server leaves Life History out of updates when it hasn't changed.
	if data.HistoryUnchanged then
		data.HistoryUnchanged = nil
		data.LifeHistory = if current then current.LifeHistory else {}
	end
	local first = current == nil
	current = data
	DataController.Changed:Fire(data)
	if first then
		DataController.Loaded:Fire()
	end
end

function DataController.Get()
	return current
end

function DataController.WaitForData()
	if current then
		return current
	end
	DataController.Loaded:Wait()
	return current
end

function DataController.GetActiveLife()
	if not current then
		return nil
	end
	local life = current.Slots[current.ActiveSlot]
	return if type(life) == "table" then life else nil
end

function DataController.Init() end

function DataController.Start()
	Net.OnEvent("DataSnapshot", set)
	-- Also ask directly, in case the first push arrived before we connected.
	for attempt = 1, 5 do
		if current then
			return
		end
		local ok, data = Net.Invoke("GetData")
		if ok then
			set(data)
			return
		end
		task.wait(attempt)
	end
	if not current then
		warn("[DataController] Could not fetch data from server")
	end
end

return DataController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">DecisionController</string>
              <string name="Source"><![CDATA[--[[
	DecisionController  (StarterPlayerScripts.Client.Controllers.DecisionController)
	Draws scenarios inside the Game screen and drives the decision loop:

	  GetScenario → choice cards → select (highlight + confirm bar) → confirm
	  → MakeChoice → outcome card (story, stat changes, traits) → Continue
	  → age-up / stage-complete transition → next scenario

	Input: click/tap a card to select, tap again or press Confirm to lock it in.
	Keyboard 1–5 selects, Enter confirms / continues. Gamepad: D-pad + A, B to cancel.
	Locked choices show their unlock hint, so players know hidden paths exist.

	The client never decides outcomes; it only sends (scenarioId, choiceId).
]]

local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Format = require(Shared.Util.Format)
local LifeStages = require(Shared.Data.LifeStages)
local StatDefinitions = require(Shared.Data.StatDefinitions)
local Traits = require(Shared.Data.Traits)
local Careers = require(Shared.Data.Careers)
local StatMath = require(Shared.Util.StatMath)
local People = require(Shared.Util.People)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Anim = require(UILib.Anim)
local Components = require(UILib.Components)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local HUDController = require(script.Parent.HUDController)
local AudioController = require(script.Parent.AudioController)
local NotificationController = require(script.Parent.NotificationController)
local RevealController = require(script.Parent.RevealController)

local DecisionController = {}
DecisionController.Priority = 45

local content: Frame
local view: Frame? = nil
local mode = "Idle" -- Idle | Loading | Scenario | Outcome | Transition | Message
local scenario = nil
local selected = nil
local outcome = nil
local pendingEvent = nil -- event waiting to be shown after the outcome
local shownEvent = nil -- event card currently on screen
local busy = false
local cards: { [string]: TextButton } = {}
local confirmBar: Frame? = nil
local continueButton: GuiButton? = nil
local requestToken = 0

-- Invokes the server, waiting and retrying briefly if we were rate-limited
-- (e.g. very fast tapping), so the player never sees a spurious error.
local function invoke(name: string, ...)
	local ok, result
	for attempt = 1, 4 do
		ok, result = Net.Invoke(name, ...)
		if ok or result ~= "RateLimited" then
			break
		end
		task.wait(0.4 * attempt)
	end
	return ok, result
end

-- ===== View helpers =====
-- Views are plain Frames (not CanvasGroups): the Game screen is already a
-- CanvasGroup, and nesting them costs texture memory on mobile. Entry motion
-- comes from Anim.Pop on each view's main elements instead.
local function newView(): Frame
	if view then
		view:Destroy()
	end
	cards = {}
	confirmBar = nil
	continueButton = nil
	local v = Create("Frame", { Name = "View", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = content })
	view = v
	return v
end

local function previewText(choice): string
	if choice.Mystery then
		return "❓ <font color=\"" .. Theme.Hex.Dim .. "\">Unknown outcome</font>"
	end
	local parts = {}
	for _, p in ipairs(choice.Preview) do
		local info = StatDefinitions.Info[p.Stat]
		if info then
			local arrows = string.rep(if p.Dir > 0 then "▲" else "▼", p.Size)
			local color = if p.Dir > 0 then Theme.Hex.Positive else Theme.Hex.Negative
			table.insert(parts, ("%s<font color=\"%s\">%s</font>"):format(info.Icon, color, arrows))
		end
	end
	if choice.MoneyDir ~= 0 then
		table.insert(parts, ("💰<font color=\"%s\">%s</font>"):format(if choice.MoneyDir > 0 then Theme.Hex.Positive else Theme.Hex.Negative, if choice.MoneyDir > 0 then "▲" else "▼"))
	end
	if choice.Risky then
		table.insert(parts, "🎲<font color=\"" .. Theme.Hex.Gold .. "\">Risky</font>")
	end
	return table.concat(parts, "   ")
end

local function centeredPanel(parent: Instance, width: number)
	local panel = Components.Panel({
		Size = UDim2.fromOffset(width, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Padding = 26,
		Parent = parent,
	})
	Create.List(Enum.FillDirection.Vertical, 14, Enum.HorizontalAlignment.Center).Parent = panel
	return panel
end

local function messageView(icon: string, title: string, body: string, buttons: { any })
	mode = "Message"
	local v = newView()
	local width = math.min(640, UIController.GetVirtualSize().X - 32)
	local panel = centeredPanel(v, width)
	Create.Label({ Text = icon, TextSize = 60, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 66), LayoutOrder = 1, Parent = panel })
	Create.Label({ Text = title, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = panel })
	Create.Label({ Text = body, TextColor3 = Theme.Color.TextDim, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = panel })
	local row = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 56), LayoutOrder = 4, Parent = panel })
	Create.List(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center).Parent = row
	local w = math.floor((width - 52 - 12 * (#buttons - 1)) / #buttons)
	local first
	for i, b in ipairs(buttons) do
		local button = Components.Button({ Text = b.Text, Icon = b.Icon, Style = b.Style or "Primary", Size = UDim2.fromOffset(math.min(w, 280), 56), LayoutOrder = i, Parent = row, OnClick = b.OnClick })
		first = first or button
	end
	Anim.Pop(panel, 0.92)
	UIController.Focus(first)
end

local function toMenu()
	UIController.Show("Menu")
end

local function showUnavailable()
	local life = DataController.GetActiveLife()
	local name = if life then life.Name else "Your"
	local stage = if life then LifeStages.Get(life.Stage).DisplayName else "next chapter"
	messageView(
		"📖",
		"To be continued…",
		("%s's %s haven't been written yet. Your life is saved at age %d, so you can pick up right here when new life stages arrive."):format(name, stage, if life then life.Age else 0),
		{
			{ Text = "Main Menu", Icon = "🏠", Style = "Secondary", OnClick = toMenu },
			{ Text = "Another Life", Icon = "✨", OnClick = function()
				UIController.Show("SlotSelect", "New")
			end },
		}
	)
end

local function showLifeComplete()
	local life = DataController.GetActiveLife()
	local body = "Every choice made this story yours."
	if life then
		local career = if life.Flags.Retired then "a well-earned retirement" elseif life.Career.Id ~= "None" then "life as " .. Careers.TitleAt(life.Career.Id, life.Career.Level) else "a life of their own design"
		body = ("%s lived to %d and ended with %s, %s in the bank, and overall life score %d/100. Every choice made this story yours."):format(
			life.Name,
			life.Age,
			career,
			Format.Money(life.Money),
			math.floor(StatMath.Overall(life.Stats) + 0.5)
		)
	end
	messageView("🌅", "A Life Complete", body, {
		{ Text = "Main Menu", Icon = "🏠", Style = "Secondary", OnClick = toMenu },
		{ Text = "Life History", Icon = "📜", Style = "Accent", OnClick = function()
			UIController.Show("LifeHistory")
		end },
		{ Text = "Live Again", Icon = "✨", OnClick = function()
			UIController.Show("SlotSelect", "New")
		end },
	})
end

local function showError(reason: any)
	messageView("⚠️", "Hmm, that didn't work", "We couldn't load your next decision (" .. tostring(reason) .. "). Your progress is safe.", {
		{ Text = "Main Menu", Icon = "🏠", Style = "Secondary", OnClick = toMenu },
		{ Text = "Try Again", Icon = "🔄", OnClick = function()
			DecisionController.Next()
		end },
	})
end

local function showLoading()
	mode = "Loading"
	local v = newView()
	Create.Label({
		Text = "✨ Thinking about your life…",
		FontFace = Theme.Font.Bold,
		TextColor3 = Theme.Color.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.new(1, -40, 0, 40),
		Parent = v,
	})
end

-- ===== Scenario =====
local renderScenario

local function setCardHighlight(card: TextButton, state: string)
	local stroke = card:FindFirstChildOfClass("UIStroke")
	local dim = card:FindFirstChild("Dim") :: Frame
	local scale = Anim.Scale(card)
	if state == "Selected" then
		if stroke then
			stroke.Color = Theme.Color.Primary
			stroke.Thickness = 3
			stroke.Transparency = 0
		end
		Anim.Tween(dim, { BackgroundTransparency = 1 }, 0.15)
		Anim.Tween(scale, { Scale = 1.03 }, 0.2, Enum.EasingStyle.Back)
	elseif state == "Dimmed" then
		if stroke then
			stroke.Color = Theme.Color.Stroke
			stroke.Thickness = 1.5
			stroke.Transparency = 0.35
		end
		Anim.Tween(dim, { BackgroundTransparency = 0.5 }, 0.15)
		Anim.Tween(scale, { Scale = 0.97 }, 0.2)
	else
		if stroke then
			stroke.Color = Theme.Color.Stroke
			stroke.Thickness = 1.5
			stroke.Transparency = 0.35
		end
		Anim.Tween(dim, { BackgroundTransparency = 1 }, 0.15)
		Anim.Tween(scale, { Scale = 1 }, 0.2)
	end
end

local confirmChoice

local function clearSelection()
	selected = nil
	for _, card in pairs(cards) do
		setCardHighlight(card, "Normal")
	end
	if confirmBar then
		confirmBar.Visible = false
	end
end

local function selectChoice(choice)
	if busy or mode ~= "Scenario" then
		return
	end
	local card = cards[choice.Id]
	if choice.Locked then
		AudioController.Play("Locked")
		if card then
			Anim.Shake(card)
		end
		NotificationController.Notify({ Title = "Locked choice", Text = "🔒 " .. (choice.LockHint or "Not available yet"), Kind = "Warning", Duration = 3 })
		return
	end
	if selected == choice then
		confirmChoice()
		return
	end
	selected = choice
	AudioController.Play("Select")
	for id, c in pairs(cards) do
		setCardHighlight(c, if id == choice.Id then "Selected" else "Dimmed")
	end
	if confirmBar then
		local label = confirmBar:FindFirstChild("Choice") :: TextLabel
		label.Text = "You chose: <b>" .. choice.Text .. "</b>"
		confirmBar.Visible = true
		Anim.Pop(confirmBar, 0.9, 0.25)
		UIController.Focus(confirmBar:FindFirstChild("Confirm", true) :: GuiObject)
	end
end

local function buildCard(parent: Instance, choice, wide: boolean)
	local card = Create("TextButton", {
		Name = choice.Id,
		Text = "",
		AutoButtonColor = false,
		Selectable = true,
		BackgroundColor3 = Theme.Color.Surface,
		BackgroundTransparency = if choice.Locked then 0.45 else 0.02,
		Size = if wide then UDim2.new() else UDim2.new(1, 0, 0, 0),
		AutomaticSize = if wide then Enum.AutomaticSize.None else Enum.AutomaticSize.Y,
		LayoutOrder = choice.Index,
		Parent = parent,
	}, { Create.Corner(Theme.Radius), Create.Stroke() })

	-- Body holds the laid-out content; Dim sits on top and isn't part of the layout.
	local body = Create("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Size = if wide then UDim2.fromScale(1, 1) else UDim2.new(1, 0, 0, 0),
		AutomaticSize = if wide then Enum.AutomaticSize.None else Enum.AutomaticSize.Y,
		Parent = card,
	}, { Create.Padding(16) })
	Create.List(Enum.FillDirection.Vertical, 8).Parent = body

	local top = Create("Frame", { Name = "Top", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 32), LayoutOrder = 1, Parent = body })
	local badge = Create("Frame", { Name = "Badge", BackgroundColor3 = Theme.Color.SurfaceHigher, Size = UDim2.fromOffset(32, 32), Parent = top }, { Create.Corner(Theme.RadiusPill) })
	Create.Label({ Text = if choice.Locked then "🔒" else tostring(choice.Index), FontFace = Theme.Font.Heavy, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = badge })
	if choice.Risky and not choice.Locked then
		local chip = Components.Chip({ Text = "🎲 Risky", Height = 28, TextSize = 14, Color = Theme.Color.SurfaceHigher, Parent = top })
		chip.AnchorPoint = Vector2.new(1, 0)
		chip.Position = UDim2.fromScale(1, 0)
	end

	local textTransparency = if choice.Locked then 0.45 else 0
	Create.Label({ Name = "Text", Text = choice.Text, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H3, TextTransparency = textTransparency, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = body })
	Create.Label({
		Name = "Description",
		Text = if choice.Locked then "🔒 " .. (choice.LockHint or "Locked") else (choice.Description or ""),
		TextSize = Theme.TextSize.Small,
		TextColor3 = if choice.Locked then Theme.Color.Warning else Theme.Color.TextDim,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 3,
		Parent = body,
	})
	if not choice.Locked then
		Create.Label({ Name = "Preview", Text = previewText(choice), RichText = true, FontFace = Theme.Font.Bold, TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, Parent = body })
		if choice.Tags and #choice.Tags > 0 then
			Create.Label({ Name = "Tags", Text = table.concat(choice.Tags, "  ·  "), FontFace = Theme.Font.Bold, TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.Gold, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 5, Parent = body })
		end
	end
	-- Dim overlay used when another card is selected.
	Create("Frame", { Name = "Dim", BackgroundColor3 = Theme.Color.Black, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = card }, { Create.Corner(Theme.Radius) })

	local stroke = card:FindFirstChildOfClass("UIStroke")
	card.SelectionGained:Connect(function()
		if selected ~= choice and stroke then
			stroke.Color = Theme.Color.Gold
			stroke.Thickness = 2.5
		end
	end)
	card.SelectionLost:Connect(function()
		if selected ~= choice and stroke then
			stroke.Color = Theme.Color.Stroke
			stroke.Thickness = 1.5
		end
	end)
	card.Activated:Connect(function()
		selectChoice(choice)
	end)
	cards[choice.Id] = card
	return card
end

function renderScenario(animateIn: boolean?)
	mode = "Scenario"
	local v = newView()
	local vs = UIController.GetVirtualSize()
	local narrow = UIController.IsNarrow()
	local width = math.min(1180, vs.X - 32)

	local scroll = Create("ScrollingFrame", {
		Name = "Scroll",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Color.Stroke,
		Selectable = false,
		Parent = v,
	})
	Create.List(Enum.FillDirection.Vertical, 18, Enum.HorizontalAlignment.Center).Parent = scroll
	Create.Padding(6, 16, if narrow then 150 else 110, 16).Parent = scroll

	-- Header: icon, title, age/stage line, description.
	local header = Create("Frame", { Name = "Header", BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = scroll })
	Create.List(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center).Parent = header
	local stage = LifeStages.Get(scenario.Stage)
	Create.Label({
		Text = ("AGE %d  ·  %s  ·  DECISION %d OF %d"):format(scenario.Age, string.upper(scenario.StageName), scenario.ScenarioNumber, scenario.ScenariosInStage),
		FontFace = Theme.Font.Heavy,
		TextSize = Theme.TextSize.Tiny,
		TextColor3 = stage.Color,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 18),
		LayoutOrder = 1,
		Parent = header,
	})
	Create.Label({
		Name = "Title",
		Text = scenario.Icon .. "  " .. scenario.Title,
		FontFace = Theme.Font.Heavy,
		TextSize = if narrow then 34 else Theme.TextSize.H1 + 4,
		TextXAlignment = Enum.TextXAlignment.Center,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		Parent = header,
	})
	local description = Create.Label({
		Text = scenario.Description,
		TextColor3 = Theme.Color.TextDim,
		TextSize = if narrow then Theme.TextSize.Body else 22,
		TextXAlignment = Enum.TextXAlignment.Center,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 3,
		Parent = header,
	})
	Create("UISizeConstraint", { MaxSize = Vector2.new(820, math.huge) }).Parent = description

	-- Choice cards: a responsive grid on wide screens, a list on narrow ones.
	local choicesFrame = Create("Frame", { Name = "Choices", BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = scroll })
	local count = #scenario.Choices
	if narrow then
		Create.List(Enum.FillDirection.Vertical, 12, Enum.HorizontalAlignment.Center).Parent = choicesFrame
	else
		local gap = 16
		local columns = math.clamp(math.floor((width + gap) / (210 + gap)), 1, count)
		if count == 4 and columns == 3 then
			columns = 2
		end
		local cellWidth = math.floor((width - gap * (columns - 1)) / columns)
		Create("UIGridLayout", {
			CellSize = UDim2.fromOffset(cellWidth, if columns >= 4 then 250 else 210),
			CellPadding = UDim2.fromOffset(gap, gap),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = choicesFrame,
		})
	end
	local firstOpen
	for i, choice in ipairs(scenario.Choices) do
		local card = buildCard(choicesFrame, choice, not narrow)
		if not choice.Locked and not firstOpen then
			firstOpen = card
		end
		if animateIn ~= false then
			Anim.Pop(card, 0.85, 0.3 + i * 0.06)
		end
	end

	-- Confirm bar pinned to the bottom of the content area.
	local barWidth = math.min(700, vs.X - 32)
	local bar = Components.Panel({
		Name = "ConfirmBar",
		Size = UDim2.fromOffset(barWidth, if narrow then 126 else 80),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Color = Theme.Color.SurfaceHigh,
		Padding = 12,
		Parent = v,
	})
	bar.ZIndex = 10
	bar.Visible = false
	Create.Label({
		Name = "Choice",
		RichText = true,
		Text = "",
		TextSize = Theme.TextSize.Body,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = narrow,
		Size = if narrow then UDim2.new(1, 0, 0, 44) else UDim2.new(1, -300, 1, 0),
		Parent = bar,
	})
	local buttons = Create("Frame", {
		Name = "Buttons",
		BackgroundTransparency = 1,
		Size = if narrow then UDim2.new(1, 0, 0, 54) else UDim2.new(0, 290, 1, 0),
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Parent = bar,
	})
	Create.List(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center).Parent = buttons
	Components.Button({ Name = "Cancel", Text = "✕", Style = "Ghost", Size = UDim2.fromOffset(56, 54), LayoutOrder = 1, Parent = buttons, OnClick = function()
		clearSelection()
		UIController.Focus(firstOpen)
	end })
	Components.Button({ Name = "Confirm", Text = "Confirm", Icon = "✓", Style = "Primary", Size = if narrow then UDim2.new(1, -66, 0, 54) else UDim2.fromOffset(220, 54), LayoutOrder = 2, Parent = buttons, OnClick = function()
		confirmChoice()
	end })
	confirmBar = bar

	if selected then
		local keep = selected
		selected = nil
		selectChoice(keep)
	else
		UIController.Focus(firstOpen)
	end
end

-- ===== Outcome =====
local renderOutcome
local renderEvent
local advance

-- Adds change chips (stats, money, life changes, traits) to `parent`.
local function addChangeChips(parent: Instance, result, animateIn: boolean?, extra: { { Text: string, Color: Color3? } }?)
	local changeList = Create.List(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center)
	changeList.Wraps = true
	changeList.Parent = parent
	local order = 0
	local function addChip(text: string, color: Color3?)
		order += 1
		local chip = Components.Chip({ Text = text, Height = 38, TextColor = color, LayoutOrder = order, Parent = parent })
		if animateIn ~= false then
			Anim.Pop(chip, 0.6, 0.35 + order * 0.05)
		end
	end
	for _, text in ipairs(result.LifeChanges or {}) do
		addChip(text, Theme.Color.Gold)
	end
	local list = {}
	for stat, delta in pairs(result.Applied or {}) do
		if math.abs(delta) >= 0.05 then
			table.insert(list, { Stat = stat, Delta = delta })
		end
	end
	table.sort(list, function(a, b)
		return math.abs(a.Delta) > math.abs(b.Delta)
	end)
	for _, change in ipairs(list) do
		local info = StatDefinitions.Info[change.Stat]
		if info then
			addChip(("%s %s %s"):format(info.Icon, info.DisplayName, Format.Signed(change.Delta)), if change.Delta > 0 then Theme.Color.Positive else Theme.Color.Negative)
		end
	end
	if result.MoneyDelta and result.MoneyDelta ~= 0 then
		addChip("💰 " .. (if result.MoneyDelta > 0 then "+" else "") .. Format.Money(result.MoneyDelta), if result.MoneyDelta > 0 then Theme.Color.Positive else Theme.Color.Negative)
	end
	for _, change in ipairs(result.BondChanges or {}) do
		if math.abs(change.Delta) >= 1 then
			local role = People.Roles[change.Role]
			addChip(("%s %s %s"):format(if role then role.Icon else "👤", change.Name, Format.Signed(change.Delta)), if change.Delta > 0 then Theme.Color.Positive else Theme.Color.Negative)
		end
	end
	for _, item in ipairs(extra or {}) do
		addChip(item.Text, item.Color)
	end
	for _, traitId in ipairs(result.TraitsGained or {}) do
		local info = Traits.Info[traitId]
		if info then
			addChip("New trait: " .. info.Icon .. " " .. info.DisplayName, Theme.Color.Gold)
		end
	end
	if order == 0 then
		addChip("No big changes… for now.", Theme.Color.TextDim)
	end
end

function renderOutcome(animateIn: boolean?)
	mode = "Outcome"
	local v = newView()
	local vs = UIController.GetVirtualSize()
	local width = math.min(760, vs.X - 32)

	local scroll = Create("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		Selectable = false,
		Parent = v,
	})
	local list = Create.List(Enum.FillDirection.Vertical, 0, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	list.Parent = scroll
	Create.Padding(10, 16, 20, 16).Parent = scroll

	local panel = Components.Panel({ Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, Padding = 26, Parent = scroll })
	Create.List(Enum.FillDirection.Vertical, 14, Enum.HorizontalAlignment.Center).Parent = panel

	Create.Label({ Text = "WHAT HAPPENED", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.Primary, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 1, Parent = panel })
	if outcome.Lucky then
		Components.Chip({ Text = "🎲 Twist of fate!", Color = Theme.Color.SurfaceHigher, TextColor = Theme.Color.Gold, LayoutOrder = 2, Parent = panel })
	end
	local story = Create.Label({
		Name = "Story",
		Text = if outcome.Story ~= "" then outcome.Story else "Life goes on.",
		FontFace = Theme.Font.Medium,
		TextSize = Theme.TextSize.H3,
		TextXAlignment = Enum.TextXAlignment.Center,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 3,
		Parent = panel,
	})
	if animateIn ~= false and not Anim.Reduced then
		-- Typewriter reveal.
		story.MaxVisibleGraphemes = 0
		local total = utf8.len(story.Text) or #story.Text
		task.spawn(function()
			local shown = 0
			while shown < total and story.Parent do
				shown = math.min(total, shown + 3)
				story.MaxVisibleGraphemes = shown
				task.wait(1 / 60)
			end
			story.MaxVisibleGraphemes = -1
		end)
	end

	local changes = Create("Frame", { Name = "Changes", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, Parent = panel })
	local extra = {}
	if outcome.Years and outcome.Years > 0 and outcome.Income ~= 0 then
		if outcome.Income > 0 then
			table.insert(extra, { Text = ("💵 Earned %s over %d yr%s"):format(Format.Money(outcome.Income), outcome.Years, if outcome.Years == 1 then "" else "s"), Color = Theme.Color.Positive })
		else
			table.insert(extra, { Text = ("💸 Living costs %s over %d yr%s"):format(Format.Money(-outcome.Income), outcome.Years, if outcome.Years == 1 then "" else "s"), Color = Theme.Color.Negative })
		end
	end
	addChangeChips(changes, outcome, animateIn, extra)

	if outcome.StageCompleted then
		Create.Label({ Text = "🏁 " .. outcome.CompletedStageName .. " complete!", FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Gold, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 5, Parent = panel })
	elseif outcome.Age ~= outcome.PrevAge then
		Create.Label({ Text = "🎂 Next: age " .. outcome.Age, FontFace = Theme.Font.Bold, TextColor3 = Theme.Color.TextDim, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 5, Parent = panel })
	end

	continueButton = Components.Button({
		Name = "Continue",
		Text = "Continue",
		Icon = "▶",
		Style = "Primary",
		Size = UDim2.fromOffset(math.min(320, width - 52), 60),
		LayoutOrder = 6,
		Parent = panel,
		OnClick = function()
			advance()
		end,
	})
	if animateIn ~= false then
		Anim.Pop(panel, 0.9)
	end
	UIController.Focus(continueButton)
end

-- ===== Random life event =====
local RARITY_STYLE = {
	Common = { Label = "LIFE EVENT", Color = Theme.Color.Accent },
	Uncommon = { Label = "UNCOMMON EVENT", Color = Theme.Color.Positive },
	Rare = { Label = "✨ RARE EVENT ✨", Color = Theme.Color.AccentAlt },
	Legendary = { Label = "🌟 LEGENDARY EVENT 🌟", Color = Theme.Color.Gold },
}

function renderEvent(event, animateIn: boolean?)
	mode = "Event"
	local v = newView()
	local style = RARITY_STYLE[event.Rarity] or RARITY_STYLE.Common
	local width = math.min(720, UIController.GetVirtualSize().X - 32)
	local scroll = Create("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		Selectable = false,
		Parent = v,
	})
	Create.List(Enum.FillDirection.Vertical, 0, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center).Parent = scroll
	Create.Padding(10, 16, 20, 16).Parent = scroll
	local panel = Components.Panel({ Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, Padding = 26, Parent = scroll })
	local stroke = panel:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = style.Color
		stroke.Thickness = if event.Rarity == "Legendary" then 4 else 2.5
		stroke.Transparency = 0
	end
	Create.List(Enum.FillDirection.Vertical, 12, Enum.HorizontalAlignment.Center).Parent = panel
	Create.Label({ Text = style.Label, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.Small, TextColor3 = style.Color, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 1, Parent = panel })
	local icon = Create.Label({ Text = event.Icon, TextSize = 64, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 72), LayoutOrder = 2, Parent = panel })
	Create.Label({ Text = event.Title, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = panel })
	Create.Label({ Text = event.Story, TextSize = Theme.TextSize.H3, TextColor3 = Theme.Color.TextDim, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, Parent = panel })
	local changes = Create("Frame", { Name = "Changes", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 5, Parent = panel })
	addChangeChips(changes, event, animateIn)
	continueButton = Components.Button({
		Name = "Continue",
		Text = "Continue",
		Icon = "▶",
		Style = if event.Rarity == "Legendary" then "Primary" else "Accent",
		Size = UDim2.fromOffset(math.min(320, width - 52), 60),
		LayoutOrder = 6,
		Parent = panel,
		OnClick = function()
			advance()
		end,
	})
	if animateIn ~= false then
		Anim.Pop(panel, 0.8, 0.45)
		Anim.Pop(icon, 0.4, 0.6)
	end
	AudioController.Play(if event.Rarity == "Rare" or event.Rarity == "Legendary" then "StageComplete" else "Notify")
	UIController.Focus(continueButton)
end

-- ===== Transitions =====
local function transition(big: string, small: string, color: Color3, hold: number)
	mode = "Transition"
	local v = newView()
	v.BackgroundColor3 = Theme.Color.Background
	v.BackgroundTransparency = 0.2
	local skip = false
	local skipper = Create("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Selectable = false, Parent = v })
	skipper.Activated:Connect(function()
		skip = true
	end)
	local bigLabel = Create.Label({
		Text = big,
		FontFace = Theme.Font.Heavy,
		TextSize = if UIController.IsNarrow() then 52 else 76,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.new(1, -40, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = v,
	})
	Create.Label({
		Text = small,
		FontFace = Theme.Font.Bold,
		TextSize = Theme.TextSize.H3,
		TextColor3 = Theme.Color.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.56),
		Size = UDim2.new(1, -40, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = v,
	})
	Anim.Pop(bigLabel, 0.6, 0.5)
	local elapsed = 0
	local total = if Anim.Reduced then math.min(hold, 0.8) else hold
	while elapsed < total and not skip and view == v do
		elapsed += task.wait()
	end
end

function advance()
	if busy or not outcome then
		return
	end
	if pendingEvent then
		shownEvent = pendingEvent
		pendingEvent = nil
		renderEvent(shownEvent, true)
		return
	end
	busy = true
	shownEvent = nil
	local o = outcome
	local finalAction = nil
	if o.Reveal then
		-- LIFE REVEAL at the end of every stage.
		mode = "Reveal"
		newView()
		RevealController.PlayStage(o.Reveal)
	elseif o.LifeCompleted and o.Final then
		mode = "Reveal"
		newView()
		finalAction = RevealController.PlayFinal(o.Final)
	elseif o.StageCompleted then
		AudioController.Play("StageComplete")
		local nextStage = LifeStages.Get(o.Stage)
		local subtitle = if o.LifeCompleted then "Your story is complete." else ("%s begin · Age %d"):format(o.StageName, o.Age)
		transition("🏁 " .. o.CompletedStageName .. " complete!", subtitle, nextStage.Color, 2.6)
	elseif o.Age ~= o.PrevAge then
		AudioController.Play("AgeUp")
		transition("🎂 Age " .. o.Age, "", Theme.Color.Gold, 1.3)
	end
	busy = false
	outcome = nil
	if finalAction == "Again" then
		UIController.Show("SlotSelect", "New")
		return
	elseif finalAction == "History" then
		UIController.Show("LifeHistory")
		return
	end
	if UIController.Current() ~= "Game" then
		return
	end
	if o.LifeCompleted then
		showLifeComplete()
	elseif not o.NextStageAvailable then
		showUnavailable()
	else
		DecisionController.Next()
	end
end

function confirmChoice()
	if busy or mode ~= "Scenario" or not selected or not scenario then
		return
	end
	busy = true
	local choice = selected
	AudioController.Play("Confirm")
	for id, card in pairs(cards) do
		card.Active = false
		if id ~= choice.Id then
			Anim.Tween(card:FindFirstChild("Dim"), { BackgroundTransparency = 0.25 }, 0.2)
		end
	end
	if confirmBar then
		confirmBar.Visible = false
	end
	local selectedCard = cards[choice.Id]
	if selectedCard then
		Anim.Tween(Anim.Scale(selectedCard), { Scale = 1.08 }, 0.25, Enum.EasingStyle.Back)
	end

	local ok, result = invoke("MakeChoice", scenario.Id, choice.Id)
	busy = false
	if not ok then
		if result == "WrongScenario" or result == "NoLife" or result == "ChoiceLocked" then
			-- Our view was out of date (e.g. money was spent in the Money panel).
			DecisionController.Next()
		else
			NotificationController.Notify({ Title = "Couldn't make that choice", Text = tostring(result), Kind = "Error" })
			selected = nil
			renderScenario(false)
		end
		return
	end
	AudioController.Play(if (result.Applied.Happiness or 0) >= 0 then "Positive" else "Negative")
	task.wait(if Anim.Reduced then 0 else 0.3)
	outcome = result
	pendingEvent = result.Event
	scenario = nil
	selected = nil
	if UIController.Current() == "Game" then
		renderOutcome(true)
	end
end

-- ===== Loop =====
function DecisionController.Next()
	requestToken += 1
	local token = requestToken
	showLoading()
	local ok, payload = invoke("GetScenario")
	if token ~= requestToken or UIController.Current() ~= "Game" then
		return
	end
	if ok then
		scenario = payload
		selected = nil
		renderScenario(true)
	elseif payload == "NoLife" then
		UIController.Show("Menu")
	elseif payload == "StageNotAvailable" then
		showUnavailable()
	elseif payload == "LifeComplete" then
		showLifeComplete()
	else
		showError(payload)
	end
end

-- Re-fetches the current scenario so locked/unlocked choices reflect the
-- latest money, people and stats (called after People/Money panel actions).
function DecisionController.Refresh()
	if mode ~= "Scenario" or busy or not scenario then
		return
	end
	local keep = selected and selected.Id
	local ok, payload = invoke("GetScenario")
	if ok and mode == "Scenario" and UIController.Current() == "Game" then
		scenario = payload
		selected = nil
		renderScenario(false)
		if keep then
			for _, choice in ipairs(payload.Choices) do
				if choice.Id == keep and not choice.Locked then
					selectChoice(choice)
				end
			end
		end
	end
end

function DecisionController.GetMode(): string
	return mode
end

local KEY_INDEX = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.Five] = 5,
}

function DecisionController.Init()
	content = HUDController.Content :: Frame
end

function DecisionController.Start()
	HUDController.Opened:Connect(function()
		-- Returning mid-way restores exactly where the player was.
		if outcome and shownEvent then
			renderEvent(shownEvent, false)
		elseif outcome then
			renderOutcome(false)
		else
			DecisionController.Next()
		end
	end)
	HUDController.Closed:Connect(function()
		requestToken += 1
		mode = "Idle"
		ContextActionService:UnbindAction("CYL_CancelChoice")
	end)
	UIController.LayoutChanged:Connect(function()
		if UIController.Current() ~= "Game" then
			return
		end
		if mode == "Scenario" and scenario then
			renderScenario(false)
		elseif mode == "Outcome" and outcome then
			renderOutcome(false)
		elseif mode == "Event" and shownEvent then
			renderEvent(shownEvent, false)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or UIController.Current() ~= "Game" or UIController.IsModalOpen() then
			return
		end
		local index = KEY_INDEX[input.KeyCode]
		if index and mode == "Scenario" and scenario and scenario.Choices[index] then
			selectChoice(scenario.Choices[index])
		elseif input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter then
			if mode == "Scenario" and selected then
				confirmChoice()
			elseif mode == "Outcome" or mode == "Event" then
				advance()
			end
		end
	end)

	-- Gamepad B clears a selection instead of leaving the game screen.
	HUDController.Opened:Connect(function()
		ContextActionService:BindAction("CYL_CancelChoice", function(_, state)
			if state == Enum.UserInputState.Begin and mode == "Scenario" and selected then
				clearSelection()
				return Enum.ContextActionResult.Sink
			end
			return Enum.ContextActionResult.Pass
		end, false, Enum.KeyCode.ButtonB)
	end)
end

return DecisionController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">FinanceController</string>
              <string name="Source"><![CDATA[--[[
	FinanceController  (StarterPlayerScripts.Client.Controllers.FinanceController)
	The 💰 Money panel: net worth, this year's budget (from Shared/Util/Budget,
	the exact maths the server uses), investments and loans.
	Invest / withdraw / repay are validated by the server (Lib/Actions).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Budget = require(Shared.Util.Budget)
local Format = require(Shared.Util.Format)
local Assets = require(Shared.Data.Assets)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Components = require(UILib.Components)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local HUDController = require(script.Parent.HUDController)
local NotificationController = require(script.Parent.NotificationController)
local DecisionController = require(script.Parent.DecisionController)

local FinanceController = {}
FinanceController.Priority = 44
FinanceController.MinAge = 18

local LINE_LABELS = {
	Salary = "💼 Salary savings",
	Pension = "🏖️ Pension",
	PartTime = "☕ Part-time job",
	Rent = "🏠 Rent",
	Children = "👶 Raising children",
	Loans = "🏦 Loan repayments",
	Unemployed = "📭 Living costs (no job)",
}
local LINE_ORDER = { "Salary", "Pension", "PartTime", "Rent", "Children", "Loans", "Unemployed" }

local handle = nil
local busy = false
local render

local function act(remote: string, ...)
	if busy then
		return
	end
	busy = true
	local ok, result = Net.Invoke(remote, ...)
	busy = false
	if ok then
		NotificationController.Notify({ Title = "💰 Money", Text = if result.PaidOff then "Loan paid off! 🎉" else "Done.", Kind = "Success", Duration = 2 })
		DecisionController.Refresh()
	else
		NotificationController.Notify({ Title = "Not now", Text = tostring(result), Kind = "Warning", Duration = 3 })
	end
	task.wait(0.25)
	if handle and handle.IsOpen() then
		render()
	end
end

local function row(parent, order: number, left: string, right: string, color: Color3?, bold: boolean?)
	local frame = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = order, Parent = parent })
	Create.Label({ Text = left, Size = UDim2.new(0.65, 0, 1, 0), FontFace = if bold then Theme.Font.Heavy else Theme.Font.Medium, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, Parent = frame })
	Create.Label({ Text = right, Size = UDim2.new(0.35, 0, 1, 0), Position = UDim2.fromScale(0.65, 0), TextXAlignment = Enum.TextXAlignment.Right, FontFace = Theme.Font.Heavy, TextColor3 = color or Theme.Color.Text, TextWrapped = false, Parent = frame })
	return frame
end

local function section(parent, order: number, title: string)
	Create.Label({ Text = title, TextSize = Theme.TextSize.Tiny, FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Primary, Size = UDim2.new(1, 0, 0, 24), TextYAlignment = Enum.TextYAlignment.Bottom, LayoutOrder = order, Parent = parent })
end

local function buttonRow(parent, order: number, buttons)
	local frame = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, Parent = parent })
	local list = Create.List(Enum.FillDirection.Horizontal, 8)
	list.Wraps = true
	list.Parent = frame
	for i, b in ipairs(buttons) do
		local button = Components.Button({ Name = b.Name, Text = b.Text, Style = b.Style or "Secondary", Size = UDim2.fromOffset(b.Width or 150, 46), TextSize = 17, LayoutOrder = i, Parent = frame, OnClick = b.OnClick })
		if b.Disabled then
			Components.SetDisabled(button, true)
		end
	end
end

local function amountButtons(prefix: string, remote: string, pool: number, style: string)
	local list = {}
	for _, share in ipairs({ 0.1, 0.25, 0.5, 1 }) do
		local amount = math.floor(pool * share)
		table.insert(list, {
			Name = prefix .. tostring(math.floor(share * 100)),
			Text = (if share == 1 then "All " else ("%d%% "):format(share * 100)) .. Format.Money(amount),
			Style = style,
			Width = 170,
			Disabled = amount < 1,
			OnClick = function()
				act(remote, amount)
			end,
		})
	end
	return list
end

function render()
	local life = DataController.GetActiveLife()
	if not handle or not life then
		return
	end
	handle.Clear()
	local scroll = handle.Scroll
	local netWorth = Budget.NetWorth(life)
	handle.Subtitle.Text = "Net worth " .. Format.Money(netWorth)

	section(scroll, 1, "WHAT YOU HAVE")
	row(scroll, 2, "💵 Cash", Format.Money(life.Money))
	row(scroll, 3, "📈 Investments", Format.Money(life.Investments or 0))
	local order = 4
	for id in pairs(life.Assets) do
		local info = Assets.Info[id]
		if info then
			row(scroll, order, info.Icon .. " " .. info.Title, Format.Money(info.Value))
			order += 1
		end
	end
	for _, loan in ipairs(life.Loans) do
		row(scroll, order, "🏦 " .. (if loan.Kind == "Mortgage" then "Mortgage" else "Student loan"), "-" .. Format.Money(loan.Balance), Theme.Color.Negative)
		order += 1
	end
	row(scroll, 19, "Net worth", Format.Money(netWorth), if netWorth >= 0 then Theme.Color.Positive else Theme.Color.Negative, true)

	section(scroll, 20, "EACH YEAR")
	local budget = Budget.Breakdown(life)
	local lineOrder = 21
	for _, key in ipairs(LINE_ORDER) do
		local amount = budget.Lines[key]
		if amount then
			row(scroll, lineOrder, LINE_LABELS[key], (if amount > 0 then "+" else "") .. Format.Money(amount), if amount >= 0 then Theme.Color.Positive else Theme.Color.Negative)
			lineOrder += 1
		end
	end
	if budget.GrossSalary > 0 then
		Create.Label({
			Text = ("You save %d%% of %s/yr. A 'Save Money' lifestyle or the Thrifty trait raises this."):format(math.floor(budget.SavingsRate * 100 + 0.5), Format.Money(budget.GrossSalary)),
			TextSize = Theme.TextSize.Tiny,
			TextColor3 = Theme.Color.TextFaint,
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 38,
			Parent = scroll,
		})
	end
	row(scroll, 39, "Per year", (if budget.Net >= 0 then "+" else "") .. Format.Money(budget.Net), if budget.Net >= 0 then Theme.Color.Positive else Theme.Color.Negative, true)

	section(scroll, 40, "INVESTING")
	if life.Age < FinanceController.MinAge then
		Create.Label({ Text = ("Investing unlocks at age %d."):format(FinanceController.MinAge), TextColor3 = Theme.Color.TextDim, LayoutOrder = 41, Parent = scroll })
	else
		Create.Label({ Text = "Investments grow about 6% a year on average, but markets swing, and sometimes crash.", TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 41, Parent = scroll })
		Create.Label({ Text = "Invest from cash:", FontFace = Theme.Font.Bold, LayoutOrder = 42, Parent = scroll })
		buttonRow(scroll, 43, amountButtons("Invest", "Invest", life.Money, "Positive"))
		Create.Label({ Text = "Withdraw to cash:", FontFace = Theme.Font.Bold, LayoutOrder = 44, Parent = scroll })
		buttonRow(scroll, 45, amountButtons("Withdraw", "Withdraw", life.Investments or 0, "Secondary"))
	end

	if #life.Loans > 0 then
		section(scroll, 50, "LOANS")
		for i, loan in ipairs(life.Loans) do
			local name = if loan.Kind == "Mortgage" then "Mortgage" else "Student loan"
			Create.Label({ Text = ("%s · %s left · %s/yr · %.1f%% interest"):format(name, Format.Money(loan.Balance), Format.Money(loan.Payment), loan.Rate * 100), LayoutOrder = 50 + i * 2, AutomaticSize = Enum.AutomaticSize.Y, Parent = scroll })
			local payable = math.min(life.Money, loan.Balance)
			buttonRow(scroll, 51 + i * 2, {
				{ Name = "Repay" .. i .. "Quarter", Text = "Pay " .. Format.Money(math.floor(payable * 0.25)), Width = 180, Disabled = math.floor(payable * 0.25) < 1, OnClick = function()
					act("RepayLoan", i, math.floor(payable * 0.25))
				end },
				{ Name = "Repay" .. i .. "Max", Text = (if payable >= loan.Balance then "Pay it all off " else "Pay ") .. Format.Money(payable), Style = "Primary", Width = 220, Disabled = payable < 1, OnClick = function()
					act("RepayLoan", i, payable)
				end },
			})
		end
	end
end

function FinanceController.Open()
	if not DataController.GetActiveLife() then
		return
	end
	handle = UIController.OpenPanel({ Name = "MoneyModal", Title = "💰  Money", Width = 720, OnClose = function()
		handle = nil
	end })
	render()
end

function FinanceController.Init()
	HUDController.AddAction({ Id = "Money", Icon = "💰", Order = 30, OnClick = FinanceController.Open })
end

function FinanceController.Start()
	DataController.Changed:Connect(function()
		if handle and handle.IsOpen() and not busy then
			render()
		end
	end)
end

return FinanceController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">FriendsController</string>
              <string name="Source"><![CDATA[--[[
	FriendsController  (StarterPlayerScripts.Client.Controllers.FriendsController)
	The "Play With Friends" screen (main menu, and 🤝 in the game HUD):
	  • YOUR LIFE CIRCLE: members, group decision, group reveal, leave/remove
	  • PLAYERS IN THIS SERVER: invite them to your circle, compare futures
	  • INVITE ROBLOX FRIENDS: the Roblox invite prompt
	  • FRIENDS PLAYING ELSEWHERE: join their server
	Every life stays independent; see PartyService for the rules.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Components = require(UILib.Components)
local Layout = require(UILib.Layout)

local UIController = require(script.Parent.UIController)
local HUDController = require(script.Parent.HUDController)
local NotificationController = require(script.Parent.NotificationController)
local PartyController = require(script.Parent.PartyController)
local FutureController = require(script.Parent.FutureController)

local FriendsController = {}
FriendsController.Priority = 50

local frame: CanvasGroup
local elsewhere = nil -- cached list of friends in other servers
local busy = false

local function heading(parent, text: string, order: number)
	Create.Label({ Text = text, TextSize = Theme.TextSize.Tiny, FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Primary, Size = UDim2.new(1, 0, 0, 28), TextYAlignment = Enum.TextYAlignment.Bottom, LayoutOrder = order, Parent = parent })
end

local function act(remote: string, ...)
	if busy then
		return false
	end
	busy = true
	local results = table.pack(Net.Invoke(remote, ...))
	busy = false
	if not results[1] then
		local extra = if results[3] then (" (%ss)"):format(tostring(results[3])) else ""
		NotificationController.Notify({ Title = "🤝 Life Circle", Text = PartyController.ErrorText(results[2]) .. extra, Kind = "Warning" })
	end
	return results[1], results[2]
end

local function row(parent, order: number, title: string, subtitle: string, buttons)
	local frameRow = Create("Frame", { Name = "Row" .. order, BackgroundColor3 = Theme.Color.SurfaceHigh, BackgroundTransparency = 0.15, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, Parent = parent }, { Create.Corner(Theme.RadiusSmall), Create.Padding(10, 14) })
	Create.List(Enum.FillDirection.Vertical, 6).Parent = frameRow
	Create.Label({ Text = title, FontFace = Theme.Font.Heavy, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = frameRow })
	if subtitle ~= "" then
		Create.Label({ Text = subtitle, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = frameRow })
	end
	if buttons and #buttons > 0 then
		local bar = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = frameRow })
		local list = Create.List(Enum.FillDirection.Horizontal, 8)
		list.Wraps = true
		list.Parent = bar
		for i, b in ipairs(buttons) do
			local button = Components.Button({ Name = b.Name, Text = b.Text, Icon = b.Icon, Style = b.Style or "Secondary", Size = UDim2.fromOffset(b.Width or 170, 44), TextSize = 17, LayoutOrder = i, Parent = bar, OnClick = b.OnClick })
			if b.Disabled then
				Components.SetDisabled(button, true)
			end
		end
	end
	return frameRow
end

local render

local function inCircle(userId: number): boolean
	local state = PartyController.Get()
	if not state then
		return false
	end
	for _, m in ipairs(state.Members) do
		if m.UserId == userId then
			return true
		end
	end
	return false
end

local function memberSummary(m): string
	if not m.LifeName then
		return "No life yet"
	end
	return ("%s · age %d · %s%s"):format(m.LifeName, m.Age, m.StageName, if m.Career then " · " .. m.Career else "") .. (if m.Completed then " · life complete" else "")
end

local function findFriendsElsewhere()
	elsewhere = "loading"
	task.spawn(function()
		local ok, friends = pcall(function()
			return Players.LocalPlayer:GetFriendsOnline(50)
		end)
		local list = {}
		if ok and type(friends) == "table" then
			for _, f in ipairs(friends) do
				-- LocationType 4 = playing an experience; GameId is that server's JobId.
				if f.LocationType == 4 and f.PlaceId == game.PlaceId and f.GameId and f.GameId ~= game.JobId then
					table.insert(list, f)
				end
			end
		end
		elsewhere = list
		if UIController.Current() == "Friends" then
			render()
		end
	end)
end

function render()
	Create.Clear(frame, true)
	Layout.Header(frame, "Play With Friends", function()
		UIController.Back()
	end)
	local scroll = Layout.Scroll(frame)
	local width = math.min(760, UIController.GetVirtualSize().X - 32)
	local column = Layout.Column(scroll, width)
	local state = PartyController.Get()
	local me = Players.LocalPlayer

	-- Circle
	heading(column, "🤝 YOUR LIFE CIRCLE" .. (if state then ("  (%d/%d)"):format(#state.Members, state.MaxMembers) else ""), 1)
	if not state then
		Create.Label({ Text = "You're not in a circle yet. Invite someone below. In a circle you make group decisions together, compare futures and watch Group Life Reveals. Every life stays your own.", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = column })
	else
		local leader = PartyController.IsLeader()
		for i, m in ipairs(state.Members) do
			local buttons = {}
			if m.UserId ~= me.UserId then
				table.insert(buttons, { Name = "Compare" .. m.UserId, Text = "Compare", Icon = "⚖️", Width = 150, OnClick = function()
					FutureController.OpenCompareWith(m.UserId)
				end })
				if leader then
					table.insert(buttons, { Name = "Remove" .. m.UserId, Text = "Remove", Width = 130, OnClick = function()
						local confirmed = UIController.Confirm({ Title = "Remove " .. m.DisplayName .. "?", Text = "They'll leave your Life Circle.", ConfirmText = "Remove", Danger = true })
						if confirmed then
							act("PartyKick", m.UserId)
						end
					end })
				end
			end
			row(column, 2 + i, (if m.IsLeader then "👑 " else "") .. m.DisplayName .. (if m.UserId == me.UserId then " (you)" else ""), memberSummary(m), buttons)
		end
		local eventText = if state.EventActive then "Deciding…" elseif state.EventCooldown > 0 then ("Group decision (%ds)"):format(state.EventCooldown) else "Group decision"
		row(column, 10, "Do something together", "Start a group decision for everyone to vote on, or watch everyone's futures in a Group Life Reveal.", {
			{ Name = "StartGroupEvent", Text = eventText, Icon = "🎲", Style = "Primary", Width = 250, Disabled = state.EventActive, OnClick = function()
				act("PartyStartEvent")
			end },
			{ Name = "StartGroupReveal", Text = if state.RevealCooldown > 0 then ("Group reveal (%ds)"):format(state.RevealCooldown) else "Group reveal", Icon = "🔮", Style = "Accent", Width = 230, OnClick = function()
				act("PartyStartReveal")
			end },
			{ Name = "LeaveCircle", Text = "Leave", Icon = "🚪", Width = 130, OnClick = function()
				act("PartyLeave")
			end },
		})
	end

	-- Players here
	heading(column, "👥 PLAYERS IN THIS SERVER", 20)
	local others = 0
	for i, p in ipairs(Players:GetPlayers()) do
		if p ~= me then
			others += 1
			local already = inCircle(p.UserId)
			local full = state and #state.Members >= state.MaxMembers
			row(column, 20 + i, p.DisplayName or p.Name, if already then "In your circle" else "", {
				{ Name = "Invite" .. p.UserId, Text = if already then "In circle" else "Invite", Icon = "🤝", Style = "Primary", Width = 160, Disabled = already or full, OnClick = function()
					local ok = act("PartyInvite", p.UserId)
					if ok then
						NotificationController.Notify({ Title = "🤝 Invite sent", Text = (p.DisplayName or p.Name) .. " has 45 seconds to accept.", Kind = "Success", Duration = 3 })
					end
				end },
				{ Name = "CompareP" .. p.UserId, Text = "Compare", Icon = "⚖️", Width = 150, OnClick = function()
					FutureController.OpenCompareWith(p.UserId)
				end },
			})
		end
	end
	if others == 0 then
		Create.Label({ Text = "Nobody else is in this server yet.", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 21, Parent = column })
	end

	-- Invite Roblox friends
	heading(column, "📨 INVITE YOUR ROBLOX FRIENDS", 60)
	row(column, 61, "Bring your friends into this server", "They'll get a Roblox invite to join you here.", {
		{ Name = "InviteFriends", Text = "Invite friends", Icon = "📨", Style = "Accent", Width = 220, OnClick = function()
			local ok = pcall(function()
				local SocialService = game:GetService("SocialService")
				if SocialService:CanSendGameInviteAsync(Players.LocalPlayer) then
					SocialService:PromptGameInvite(Players.LocalPlayer)
				else
					error("cannot invite")
				end
			end)
			if not ok then
				NotificationController.Notify({ Title = "Invites unavailable", Text = "Roblox invites only work in a published game, not in Studio.", Kind = "Warning" })
			end
		end },
	})

	-- Friends elsewhere
	heading(column, "🌍 FRIENDS PLAYING IN OTHER SERVERS", 70)
	if elsewhere == nil then
		findFriendsElsewhere()
	end
	if elsewhere == "loading" then
		Create.Label({ Text = "Looking for friends…", TextColor3 = Theme.Color.TextDim, LayoutOrder = 71, Parent = column })
	elseif type(elsewhere) == "table" and #elsewhere == 0 then
		Create.Label({ Text = "No friends are playing CHOOSE YOUR LIFE in other servers right now.", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 71, Parent = column })
	elseif type(elsewhere) == "table" then
		for i, f in ipairs(elsewhere) do
			row(column, 71 + i, f.DisplayName or f.UserName or "Friend", "Playing in another server", {
				{ Name = "Join" .. tostring(f.VisitorId), Text = "Join their server", Icon = "🚀", Style = "Primary", Width = 240, OnClick = function()
					local ok = act("JoinFriendServer", f.PlaceId, f.GameId)
					if ok then
						NotificationController.Notify({ Title = "🚀 Joining…", Text = "Teleporting you to " .. (f.DisplayName or "your friend") .. "'s server.", Kind = "Info" })
					end
				end },
			})
		end
	end
	Components.Button({ Name = "RefreshFriends", Text = "Refresh", Icon = "🔄", Style = "Ghost", Size = UDim2.fromOffset(160, 44), LayoutOrder = 99, Parent = column, OnClick = function()
		elsewhere = nil
		render()
	end })
end

function FriendsController.Init()
	frame = UIController.NewScreen("Friends", { Back = true, OnOpen = function()
		elsewhere = nil
		render()
	end })
	HUDController.AddAction({ Id = "Circle", Icon = "🤝", Order = 8, OnClick = function()
		UIController.Show("Friends")
	end })
end

function FriendsController.Start()
	PartyController.Changed:Connect(function()
		if UIController.Current() == "Friends" then
			render()
		end
	end)
	for _, signal in ipairs({ Players.PlayerAdded, Players.PlayerRemoving }) do
		signal:Connect(function()
			task.defer(function()
				if UIController.Current() == "Friends" then
					render()
				end
			end)
		end)
	end
	UIController.LayoutChanged:Connect(function()
		if UIController.Current() == "Friends" then
			render()
		end
	end)
end

return FriendsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">FutureController</string>
              <string name="Source"><![CDATA[--[[
	FutureController  (StarterPlayerScripts.Client.Controllers.FutureController)
	The 🔮 Future panel:
	  • live odds for every possible future, recalculated from your current
	    life with the same model the server uses (Shared/Util/Futures)
	  • how your predicted future has changed at each Life Reveal so far
	  • compare predicted futures with other players in this server
	    (privacy-respecting; RevealService)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Futures = require(Shared.Util.Futures)
local Format = require(Shared.Util.Format)
local LifeStages = require(Shared.Data.LifeStages)
local StatDefinitions = require(Shared.Data.StatDefinitions)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Components = require(UILib.Components)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local HUDController = require(script.Parent.HUDController)
local NotificationController = require(script.Parent.NotificationController)

local FutureController = {}
FutureController.Priority = 47

local handle = nil

local function bar(parent, order: number, icon: string, title: string, pct: number, positive: boolean, extra: string?)
	local row = Create("Frame", { Name = title, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = order, Parent = parent })
	Create.Label({ Text = icon .. "  " .. title .. (extra or ""), RichText = true, FontFace = Theme.Font.Bold, Size = UDim2.new(0.75, 0, 0, 22), TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
	Create.Label({ Name = "Pct", Text = pct .. "%", FontFace = Theme.Font.Heavy, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(0.25, 0, 0, 22), Position = UDim2.fromScale(0.75, 0), Parent = row })
	local track = Create("Frame", { BackgroundColor3 = Theme.Color.Background, Size = UDim2.new(1, 0, 0, 10), Position = UDim2.fromOffset(0, 26), Parent = row }, { Create.Corner(Theme.RadiusPill) })
	local color = if positive then (if pct >= 60 then Theme.Color.Positive elseif pct >= 35 then Theme.Color.Warning else Theme.Color.Accent) else Theme.Color.Negative
	Create("Frame", { BackgroundColor3 = color, Size = UDim2.fromScale(pct / 100, 1), Parent = track }, { Create.Corner(Theme.RadiusPill) })
end

local function heading(parent, text: string, order: number)
	Create.Label({ Text = text, TextSize = Theme.TextSize.Tiny, FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Primary, Size = UDim2.new(1, 0, 0, 24), TextYAlignment = Enum.TextYAlignment.Bottom, LayoutOrder = order, Parent = parent })
end

local renderCompare

local function render()
	local life = DataController.GetActiveLife()
	if not handle or not life then
		return
	end
	handle.Clear()
	local scroll = handle.Scroll
	local predictions = Futures.Predict(life)
	local headline, warning = Futures.Headline(predictions)
	handle.Subtitle.Text = "Live odds · they change with every choice you make"
	Create.Label({ Text = headline, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H3, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = scroll })
	if warning then
		Create.Label({ Text = "⚠️ " .. warning, TextColor3 = Theme.Color.Warning, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = scroll })
	end
	local last = life.Reveals[#life.Reveals]
	local positives, risks = Futures.Sorted(predictions)
	heading(scroll, "POSSIBLE FUTURES", 3)
	for i, entry in ipairs(positives) do
		local extra = nil
		if last and last.Predictions and last.Predictions[entry.Id] then
			local diff = entry.Pct - last.Predictions[entry.Id]
			if math.abs(diff) >= 3 then
				extra = ("  <font color=\"%s\">%s%d</font>"):format(if diff > 0 then Theme.Hex.Positive else Theme.Hex.Negative, if diff > 0 then "▲" else "▼", math.abs(diff))
			end
		end
		bar(scroll, 3 + i, entry.Icon, entry.Title, entry.Pct, true, extra)
	end
	heading(scroll, "RISKS", 30)
	for i, entry in ipairs(risks) do
		bar(scroll, 30 + i, entry.Icon, entry.Title, entry.Pct, false)
	end

	local journey = {}
	for _, r in ipairs(life.Reveals) do
		if r.Predictions then
			table.insert(journey, r)
		end
	end
	if #journey > 0 then
		heading(scroll, "HOW YOUR FUTURE HAS CHANGED", 50)
		for i, r in ipairs(journey) do
			local top = Futures.Sorted(r.Predictions)
			local parts = {}
			for j = 1, math.min(3, #top) do
				table.insert(parts, ("%s %d%%"):format(top[j].Icon, top[j].Pct))
			end
			Create.Label({
				Text = ("<b>After %s (age %d):</b>  %s%s"):format(LifeStages.Get(r.Stage).DisplayName, r.Age, table.concat(parts, "   "), if r.Twist then "   ⚡ twist!" else ""),
				RichText = true,
				TextSize = Theme.TextSize.Small,
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = 50 + i,
				Parent = scroll,
			})
		end
	end
	Create.Label({ Text = "💡 These are estimates, not destiny. The future is never completely decided.", TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextFaint, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 80, Parent = scroll })
	Components.Button({ Name = "Compare", Text = "Compare with players here", Icon = "⚖️", Style = "Accent", Size = UDim2.new(1, 0, 0, 52), LayoutOrder = 90, Parent = scroll, OnClick = function()
		renderCompare()
	end })
end

local function compareView(me, them)
	handle.Clear()
	local scroll = handle.Scroll
	handle.Subtitle.Text = "You vs " .. them.DisplayName
	local mine, theirs = me.Card, them.Card
	Create.Label({ Text = ("%s (%s, %d)   vs   %s (%s, %d)"):format(mine.LifeName, mine.StageName, mine.Age, theirs.LifeName, theirs.StageName, theirs.Age), FontFace = Theme.Font.Heavy, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = scroll })
	Create.Label({ Text = ("💼 %s   vs   💼 %s"):format(mine.Career, theirs.Career), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = scroll })
	heading(scroll, "PREDICTED FUTURES (YOU · THEM)", 3)
	for i, id in ipairs(Futures.Order) do
		local info = Futures.Info[id]
		local a, b = mine.Predictions[id] or 0, theirs.Predictions[id] or 0
		local winner = if math.abs(a - b) < 5 then "🤝" elseif (a > b) == info.Positive then "⬅️" else "➡️"
		Create.Label({ Text = ("%s %s   <b>%d%%</b>  %s  <b>%d%%</b>"):format(info.Icon, info.Title, a, winner, b), RichText = true, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3 + i, Parent = scroll })
	end
	if mine.Stats and theirs.Stats then
		heading(scroll, "STATS", 40)
		for i, statName in ipairs(StatDefinitions.Order) do
			local info = StatDefinitions.Info[statName]
			Create.Label({ Text = ("%s %s   %d  vs  %d"):format(info.Icon, info.DisplayName, mine.Stats[statName], theirs.Stats[statName]), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 40 + i, Parent = scroll })
		end
		Create.Label({ Text = ("💰 Net worth   %s  vs  %s"):format(Format.Money(mine.NetWorth), Format.Money(theirs.NetWorth)), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 60, Parent = scroll })
		heading(scroll, "LIFESTYLE: HOMES & CARS", 61)
		local function owned(card)
			return if card.Assets and #card.Assets > 0 then table.concat(card.Assets, ", ") else "Nothing yet"
		end
		Create.Label({ Text = "You: " .. owned(mine), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 62, Parent = scroll })
		Create.Label({ Text = them.DisplayName .. ": " .. owned(theirs), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 63, Parent = scroll })
	elseif not theirs.Stats then
		Create.Label({ Text = "🔒 " .. them.DisplayName .. " keeps their exact stats private.", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 40, Parent = scroll })
	end
	Components.Button({ Name = "BackToList", Text = "Back", Icon = "‹", Style = "Secondary", Size = UDim2.new(1, 0, 0, 50), LayoutOrder = 99, Parent = scroll, OnClick = function()
		renderCompare()
	end })
end

function renderCompare()
	if not handle then
		return
	end
	handle.Clear()
	handle.Subtitle.Text = "Loading players…"
	local ok, cards = Net.Invoke("GetLifeCards")
	if not handle or not handle.IsOpen() then
		return
	end
	handle.Clear()
	local scroll = handle.Scroll
	if not ok then
		NotificationController.Notify({ Title = "Couldn't load players", Text = tostring(cards), Kind = "Warning" })
		render()
		return
	end
	handle.Subtitle.Text = "Players in this server · respects everyone's privacy settings"
	local me = nil
	for _, c in ipairs(cards) do
		if c.IsYou then
			me = c
		end
	end
	local others = 0
	for i, c in ipairs(cards) do
		if not c.IsYou then
			others += 1
			local panel = Components.Panel({ Name = "Player" .. c.UserId, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Padding = 14, LayoutOrder = i, Parent = scroll, Color = Theme.Color.SurfaceHigh })
			Create.List(Enum.FillDirection.Vertical, 4).Parent = panel
			Create.Label({ Text = c.DisplayName .. (if c.IsFriend then "  · 🤝 Friend" else ""), FontFace = Theme.Font.Heavy, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = panel })
			if c.Hidden then
				Create.Label({ Text = "🔒 Keeps their future private.", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = panel })
			elseif c.NoLife then
				Create.Label({ Text = "Between lives right now.", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = panel })
			else
				local card = c.Card
				local top = Futures.Sorted(card.Predictions)
				Create.Label({ Text = ("%s · age %d · %s · %s"):format(card.LifeName, card.Age, card.StageName, card.Career), TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = panel })
				Create.Label({ Text = ("%s %s %d%%   %s %s %d%%"):format(top[1].Icon, top[1].Title, top[1].Pct, top[2].Icon, top[2].Title, top[2].Pct), FontFace = Theme.Font.Bold, TextColor3 = Theme.Color.Gold, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = panel })
				if me and me.Card then
					Components.Button({ Name = "CompareWith", Text = "Compare", Icon = "⚖️", Style = "Accent", Size = UDim2.fromOffset(180, 44), LayoutOrder = 5, Parent = panel, OnClick = function()
						compareView(me, c)
					end })
				end
			end
			if c.Endings and #c.Endings > 0 then
				local titles = {}
				for _, e in ipairs(c.Endings) do
					table.insert(titles, e.Icon .. " " .. e.Title)
				end
				Create.Label({ Text = "Past lives: " .. table.concat(titles, ", "), TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, Parent = panel })
			end
		end
	end
	if others == 0 then
		Create.Label({ Text = "Nobody else is here yet. Invite a friend to compare futures!", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = scroll })
	end
	Components.Button({ Name = "BackToFuture", Text = "Back to my future", Icon = "‹", Style = "Secondary", Size = UDim2.new(1, 0, 0, 50), LayoutOrder = 999, Parent = scroll, OnClick = render })
end

function FutureController.Open()
	if not DataController.GetActiveLife() then
		return
	end
	handle = UIController.OpenPanel({ Name = "FutureModal", Title = "🔮  Your Future", Width = 760, OnClose = function()
		handle = nil
	end })
	render()
end

FutureController.OpenCompare = function()
	FutureController.Open()
	renderCompare()
end

-- Opens a side-by-side comparison with one player (from Play With Friends).
function FutureController.OpenCompareWith(userId: number)
	if not DataController.GetActiveLife() then
		NotificationController.Notify({ Title = "Start a life first", Text = "You need a life in progress to compare futures.", Kind = "Info" })
		return
	end
	handle = UIController.OpenPanel({ Name = "FutureModal", Title = "⚖️  Compare Futures", Width = 760, OnClose = function()
		handle = nil
	end })
	handle.Subtitle.Text = "Loading…"
	local ok, cards = Net.Invoke("GetLifeCards")
	if not handle or not handle.IsOpen() then
		return
	end
	local me, them = nil, nil
	if ok then
		for _, c in ipairs(cards) do
			if c.IsYou then
				me = c
			elseif c.UserId == userId then
				them = c
			end
		end
	end
	if me and me.Card and them and them.Card then
		compareView(me, them)
	else
		handle.Clear()
		handle.Subtitle.Text = ""
		local reason = if not ok then tostring(cards) elseif not them then "That player isn't here any more." elseif them.NoLife then them.DisplayName .. " is between lives right now." else "🔒 " .. them.DisplayName .. " keeps their future private."
		Create.Label({ Text = reason, TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = handle.Scroll })
	end
end

function FutureController.Init()
	HUDController.AddAction({ Id = "Future", Icon = "🔮", Order = 5, OnClick = FutureController.Open })
end

function FutureController.Start() end

return FutureController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">GraphicsController</string>
              <string name="Source"><![CDATA[--[[
	GraphicsController  (StarterPlayerScripts.Client.Controllers.GraphicsController)
	Applies the Graphics setting (Auto / Low / High) on this client only.
	Roblox doesn't let games change the engine's quality level, so this
	controls what the game itself adds: shadows, post-processing effects
	(Bloom, SunRays, DepthOfField, Blur) and decorative UI motion.
	World systems (Phase 8) read GraphicsController.IsLow() before spawning
	optional decoration such as extra NPCs or particles.

	Auto = Low on touch-only devices (phones/tablets), High elsewhere.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Signal = require(ReplicatedStorage:WaitForChild("Shared").Util.Signal)

local GraphicsController = {}
GraphicsController.Priority = 3
GraphicsController.Changed = Signal.new() -- (resolvedMode: "Low" | "High")

local resolved = "High"
local originalShadows = nil

function GraphicsController.Resolve(mode: string): string
	if mode == "Low" or mode == "High" then
		return mode
	end
	local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled and not UserInputService.GamepadEnabled
	return if touchOnly then "Low" else "High"
end

function GraphicsController.Apply(mode: string)
	resolved = GraphicsController.Resolve(mode)
	local low = resolved == "Low"
	if originalShadows == nil then
		originalShadows = Lighting.GlobalShadows
	end
	Lighting.GlobalShadows = if low then false else originalShadows
	for _, effect in ipairs(Lighting:GetChildren()) do
		if effect:IsA("PostEffect") and not effect:IsA("ColorCorrectionEffect") then
			effect.Enabled = not low
		end
	end
	local UIController = require(script.Parent.UIController)
	UIController.SetDecorations(not low)
	GraphicsController.Changed:Fire(resolved)
end

function GraphicsController.IsLow(): boolean
	return resolved == "Low"
end

function GraphicsController.Init() end
function GraphicsController.Start() end

return GraphicsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[--[[
	HUDController  (StarterPlayerScripts.Client.Controllers.HUDController)
	The "Game" screen: a HUD bar (name, age, life stage, stage progress, money,
	happiness, health, occupation) above a content area where
	DecisionController draws scenarios. Also the full Stats panel.

	HUDController.Content         Frame for gameplay UI below the HUD
	HUDController.Opened / Closed Signals when the Game screen opens/closes
	HUDController.OpenStats()     shows the statistics panel
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Util.Signal)
local Format = require(Shared.Util.Format)
local LifeStages = require(Shared.Data.LifeStages)
local StatDefinitions = require(Shared.Data.StatDefinitions)
local Traits = require(Shared.Data.Traits)
local StatMath = require(Shared.Util.StatMath)
local Careers = require(Shared.Data.Careers)
local Assets = require(Shared.Data.Assets)
local Budget = require(Shared.Util.Budget)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Anim = require(UILib.Anim)
local Components = require(UILib.Components)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)

local HUDController = {}
HUDController.Priority = 40
HUDController.Opened = Signal.new()
HUDController.Closed = Signal.new()
HUDController.Content = nil :: Frame?

local gameFrame: CanvasGroup
local hud: Frame
local refs: { [string]: any } = {}
local actions: { { Id: string, Icon: string, Order: number, OnClick: () -> () } } = {}

--[[
	Adds an icon button to the HUD (People, Lifestyle, Money, Stats...).
	Call from a controller's Init. Buttons are named by Id.
]]
function HUDController.AddAction(action)
	table.insert(actions, action)
	table.sort(actions, function(a, b)
		return a.Order < b.Order
	end)
end

function HUDController.Occupation(life): string
	if life.Career and life.Career.Id ~= "None" and Careers.Info[life.Career.Id] then
		return Careers.TitleAt(life.Career.Id, life.Career.Level)
	end
	if life.Flags.Retired then
		return "Retired"
	elseif life.Flags.AtUni then
		return "University Student"
	elseif life.Age <= 11 then
		return "Primary School Pupil"
	elseif life.Age <= 18 then
		return "Secondary School Student"
	end
	return "Unemployed"
end

local COMPACT_WIDTH = 1260
local function hudHeight(): number
	return if UIController.GetVirtualSize().X < COMPACT_WIDTH then 118 else 74
end

local function actionBar(parent)
	local width = #actions * 50 + math.max(0, #actions - 1) * 8
	local bar = Create("Frame", { Name = "Actions", BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 50), AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Parent = parent })
	Create.List(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right).Parent = bar
	for i, action in ipairs(actions) do
		Components.Button({ Name = action.Id, Text = action.Icon, Style = if i == #actions then "Accent" else "Secondary", Size = UDim2.fromOffset(50, 50), TextSize = 24, LayoutOrder = i, Parent = bar, OnClick = action.OnClick })
	end
	return width
end

local function identityBlock(parent, width: number, order: number)
	local frame = Create("Frame", { Name = "Identity", BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 50), LayoutOrder = order, Parent = parent })
	refs.Name = Create.Label({ Name = "Name", FontFace = Theme.Font.Heavy, TextSize = 22, Size = UDim2.new(1, 0, 0, 26), TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = frame })
	refs.Sub = Create.Label({ Name = "Sub", TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.TextDim, Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 26), TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = frame })
	return frame
end

local function render()
	Create.Clear(hud, true)
	refs = {}
	local size = UIController.GetVirtualSize()
	local compact = size.X < COMPACT_WIDTH
	local height = hudHeight()

	hud.Size = UDim2.new(1, -24, 0, height)
	local content = HUDController.Content :: Frame
	content.Position = UDim2.fromOffset(0, height + 18)
	content.Size = UDim2.new(1, 0, 1, -(height + 18))

	Create.Corner(Theme.Radius).Parent = hud
	Create.Stroke().Parent = hud
	Create.Padding(10, 12, 14, 12).Parent = hud

	-- Thin stage-progress bar along the bottom edge.
	local track = Create("Frame", { Name = "Progress", BackgroundColor3 = Theme.Color.Background, Size = UDim2.new(1, 0, 0, 5), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 8), Parent = hud }, { Create.Corner(Theme.RadiusPill) })
	refs.ProgressFill = Create("Frame", { Name = "Fill", BackgroundColor3 = Theme.Color.Primary, Size = UDim2.fromScale(0, 1), Parent = track }, { Create.Corner(Theme.RadiusPill) })

	local function menuButton(parent, order)
		return Components.Button({ Name = "Menu", Text = "≡", Style = "Secondary", Size = UDim2.fromOffset(50, 50), TextSize = 28, LayoutOrder = order, Parent = parent, OnClick = function()
			UIController.Show("Menu")
		end })
	end
	local function chip(parent, key, order)
		refs[key] = Components.Chip({ Text = "", Height = 40, LayoutOrder = order, Parent = parent })
		refs[key].Name = key
	end
	local function bar(parent, statName, width, order)
		local info = StatDefinitions.Info[statName]
		refs[statName] = Components.StatBar({ Name = statName, Icon = info.Icon, DisplayName = info.DisplayName, Color = info.Color, Compact = true, Size = UDim2.fromOffset(width, 40), LayoutOrder = order, Parent = parent })
	end

	if not compact then
		local row = Create("Frame", { Name = "Row", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = hud })
		Create.List(Enum.FillDirection.Horizontal, 14, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center).Parent = row
		-- Widths budgeted for 1260+ virtual px: 50 + 220 + ~140 + 120 + 120 + ~250 + gaps + 224 (actions)
		menuButton(row, 1)
		identityBlock(row, 220, 2)
		chip(row, "Money", 3)
		bar(row, "Happiness", 120, 4)
		bar(row, "Health", 120, 5)
		chip(row, "Occupation", 6)
		actionBar(hud)
	else
		local top = Create("Frame", { Name = "Top", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 50), Parent = hud })
		menuButton(top, 1).Position = UDim2.fromOffset(0, 0)
		local barWidth = actionBar(top)
		local identity = identityBlock(top, size.X - 24 - 24 - 50 - barWidth - 28, 2)
		identity.Position = UDim2.fromOffset(64, 0)

		local bottom = Create("Frame", { Name = "Bottom", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 42), Position = UDim2.fromOffset(0, 56), Parent = hud })
		Create.List(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center).Parent = bottom
		chip(bottom, "Money", 1)
		local statWidth = if size.X < 700 then 110 else 140
		bar(bottom, "Happiness", statWidth, 2)
		bar(bottom, "Health", statWidth, 3)
		if size.X >= 760 then
			chip(bottom, "Occupation", 4)
		end
	end
end

local lastLife = nil
local function update(animate: boolean?)
	local life = DataController.GetActiveLife()
	if not life or not refs.Name then
		return
	end
	local stage = LifeStages.Get(life.Stage)
	refs.Name.Text = life.Name
	refs.Sub.Text = ("Age %d · %s · %d/%d"):format(life.Age, stage.DisplayName, math.min(life.ScenarioIndex + 1, stage.ScenariosPerStage), stage.ScenariosPerStage)
	refs.ProgressFill.BackgroundColor3 = stage.Color
	local progress = UDim2.fromScale(life.ScenarioIndex / stage.ScenariosPerStage, 1)
	if animate then
		Anim.Tween(refs.ProgressFill, { Size = progress }, 0.6)
	else
		refs.ProgressFill.Size = progress
	end
	refs.Money:FindFirstChild("Label").Text = "💰 " .. Format.Money(life.Money)
	if refs.Occupation then
		refs.Occupation:FindFirstChild("Label").Text = "💼 " .. HUDController.Occupation(life)
	end
	refs.Happiness.Set(life.Stats.Happiness, animate)
	refs.Health.Set(life.Stats.Health, animate)
	if animate and lastLife and lastLife.Money ~= life.Money then
		Anim.Pop(refs.Money, 1.2, 0.4)
	end
	lastLife = { Money = life.Money }
end

-- ===== Stats panel =====
function HUDController.CloseStats()
	local panel = UIController.CurrentPanel()
	if panel and panel.Root.Name == "StatsModal" then
		panel.Close()
	end
end

function HUDController.OpenStats()
	local life = DataController.GetActiveLife()
	if not life then
		return
	end
	local narrow = UIController.IsNarrow()
	local stage = LifeStages.Get(life.Stage)
	local handle = UIController.OpenPanel({
		Name = "StatsModal",
		Title = "📊  " .. life.Name .. "'s Life",
		Subtitle = ("Age %d · %s · Overall %d / 100 · %s"):format(life.Age, stage.DisplayName, math.floor(StatMath.Overall(life.Stats) + 0.5), Format.Money(life.Money)),
	})
	local scroll = handle.Scroll

	local grid = Create("Frame", { Name = "Stats", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = scroll })
	Create("UIGridLayout", { CellSize = if narrow then UDim2.new(1, 0, 0, 84) else UDim2.new(0.5, -10, 0, 84), CellPadding = UDim2.fromOffset(20, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	for i, statName in ipairs(StatDefinitions.Order) do
		local info = StatDefinitions.Info[statName]
		local cell = Create("Frame", { Name = statName, BackgroundTransparency = 1, LayoutOrder = i, Parent = grid })
		local bar = Components.StatBar({ Name = "Bar", Icon = info.Icon, DisplayName = info.DisplayName, Color = info.Color, Value = 0, Parent = cell })
		bar.Set(life.Stats[statName], true)
		Create.Label({ Text = info.Description, TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextFaint, Position = UDim2.fromOffset(0, 60), Size = UDim2.new(1, 0, 0, 20), Parent = cell })
	end

	Create.Label({ Text = "PERSONALITY", TextSize = Theme.TextSize.Tiny, FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Primary, LayoutOrder = 2, Parent = scroll })
	local traitRow = Create("Frame", { Name = "Traits", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = scroll })
	Create("UIGridLayout", { CellSize = if narrow then UDim2.new(1, 0, 0, 40) else UDim2.new(0.5, -10, 0, 40), CellPadding = UDim2.fromOffset(20, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = traitRow })
	local traitList = {}
	for id, strength in pairs(life.Traits) do
		table.insert(traitList, { Id = id, Strength = strength })
	end
	table.sort(traitList, function(a, b)
		return a.Strength > b.Strength
	end)
	if #traitList == 0 then
		Create.Label({ Text = "Your choices will shape your personality.", TextColor3 = Theme.Color.TextDim, LayoutOrder = 1, Parent = traitRow })
	end
	for i, trait in ipairs(traitList) do
		local info = Traits.Info[trait.Id]
		if info then
			local dots = string.rep("●", trait.Strength) .. string.rep("○", Traits.MaxStrength - trait.Strength)
			local chipFrame = Components.Chip({ Text = ("%s %s  <font color=\"%s\">%s</font>"):format(info.Icon, info.DisplayName, Theme.Hex.Gold, dots), Height = 40, LayoutOrder = i, Parent = traitRow })
			chipFrame.AutomaticSize = Enum.AutomaticSize.None
		end
	end

	Create.Label({ Text = "LIFE", TextSize = Theme.TextSize.Tiny, FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Primary, LayoutOrder = 10, Parent = scroll })
	local rel = life.Relationships
	local relationship = if rel.Married then "Married" elseif rel.Partner then "In a relationship" else "Single"
	local owned = {}
	for id in pairs(life.Assets) do
		local info = Assets.Info[id]
		if info then
			table.insert(owned, info.Icon .. " " .. info.Title)
		end
	end
	table.sort(owned)
	local career = HUDController.Occupation(life)
	if life.Career.Id ~= "None" then
		career ..= (" · %s/yr"):format(Format.Money(Careers.SalaryAt(life.Career.Id, life.Career.Level)))
	end
	local facts = {
		"💼  " .. career,
		"🎓  " .. (Careers.EducationNames[life.Education] or "None"),
		"❤️  " .. relationship .. (if rel.Children > 0 then ("  ·  👶 %d %s"):format(rel.Children, if rel.Children == 1 then "child" else "children") else ""),
		"🏠  " .. (if #owned > 0 then table.concat(owned, ", ") else "No property yet"),
		"💰  Net worth " .. Format.Money(Budget.NetWorth(life)),
	}
	for i, fact in ipairs(facts) do
		Create.Label({ Text = fact, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 10 + i, Parent = scroll })
	end

	Create.Label({
		Text = ("📝 %d decisions made this life"):format(#life.Decisions),
		TextColor3 = Theme.Color.TextDim,
		TextSize = Theme.TextSize.Small,
		LayoutOrder = 20,
		Parent = scroll,
	})
	return handle
end

-- ===== Lifecycle =====
function HUDController.Init()
	HUDController.AddAction({ Id = "Stats", Icon = "📊", Order = 100, OnClick = HUDController.OpenStats })
	gameFrame = UIController.NewScreen("Game", {
		OnOpen = function()
			render()
			update(false)
			HUDController.Opened:Fire()
		end,
		OnClose = function()
			UIController.ClosePanel()
			HUDController.Closed:Fire()
		end,
	})
	HUDController.Content = Create("Frame", { Name = "Content", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = gameFrame })
	hud = Create("Frame", {
		Name = "HUD",
		BackgroundColor3 = Theme.Color.Surface,
		BackgroundTransparency = 0.1,
		Position = UDim2.fromOffset(12, 10),
		Size = UDim2.new(1, -24, 0, 74),
		Parent = gameFrame,
	})
end

function HUDController.Start()
	DataController.Changed:Connect(function()
		if UIController.Current() == "Game" then
			update(true)
		end
	end)
	UIController.LayoutChanged:Connect(function()
		if UIController.Current() == "Game" then
			render()
			update(false)
		end
	end)
end

return HUDController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">LifeHistoryController</string>
              <string name="Source"><![CDATA[--[[
	LifeHistoryController  (StarterPlayerScripts.Client.Controllers.LifeHistoryController)
	The 📜 Life History screen (appears on the main menu automatically).
	  • every completed life (newest first) with its ending title
	  • a detail view: career, wealth, family, achievements, moments,
	    regrets, key decisions and how the predictions played out
	  • replay any life's Final Reveal
	  • compare two lives side by side: "What if I had chosen differently?"
	Data: profile.LifeHistory (written by the server at the end of each life).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Futures = require(Shared.Util.Futures)
local Format = require(Shared.Util.Format)
local StatDefinitions = require(Shared.Data.StatDefinitions)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Components = require(UILib.Components)
local Layout = require(UILib.Layout)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local RevealController = require(script.Parent.RevealController)

local LifeHistoryController = {}
LifeHistoryController.Priority = 48

local frame: CanvasGroup

local function history()
	local data = DataController.Get()
	local list = {}
	if data then
		for i = #data.LifeHistory, 1, -1 do
			table.insert(list, data.LifeHistory[i])
		end
	end
	return list
end

function LifeHistoryController.Find(id: number)
	for _, entry in ipairs(history()) do
		if entry.Id == id then
			return entry
		end
	end
	return nil
end

local function summaryLine(entry): string
	return ("Lived to %d · %s · %s"):format(entry.Age, entry.Career, Format.Money(entry.NetWorth))
end

local function familyLine(entry): string
	local parts = {}
	if entry.Partner then
		table.insert(parts, (if entry.Partner.Married then "💍 " else "❤️ ") .. entry.Partner.Name)
	end
	if #entry.Children > 0 then
		table.insert(parts, ("👶 %d %s"):format(#entry.Children, if #entry.Children == 1 then "child" else "children"))
	end
	return if #parts > 0 then table.concat(parts, "  ·  ") else "🕊️ Single"
end

local function heading(parent, text: string, order: number)
	Create.Label({ Text = text, TextSize = Theme.TextSize.Tiny, FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Primary, Size = UDim2.new(1, 0, 0, 24), TextYAlignment = Enum.TextYAlignment.Bottom, LayoutOrder = order, Parent = parent })
end

local function lines(parent, list, order: number)
	for i, text in ipairs(list) do
		Create.Label({ Text = text, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order + i, Parent = parent })
	end
end

local openDetail

local function openCompare(a, b)
	local handle = UIController.OpenPanel({ Name = "CompareLivesModal", Title = "⚖️  " .. a.Name .. " vs " .. b.Name, Width = 860 })
	handle.Subtitle.Text = "Different choices. Different lives."
	local scroll = handle.Scroll
	local function row(order, label, left, right)
		local r = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, Parent = scroll })
		Create.Label({ Text = label, TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.Small, Size = UDim2.new(0.24, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = r })
		Create.Label({ Text = left, FontFace = Theme.Font.Bold, Size = UDim2.new(0.38, -8, 0, 0), Position = UDim2.fromScale(0.24, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = r })
		Create.Label({ Text = right, FontFace = Theme.Font.Bold, Size = UDim2.new(0.38, -8, 0, 0), Position = UDim2.fromScale(0.62, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = r })
	end
	row(1, "", a.Name, b.Name)
	row(2, "Ending", a.Ending.Icon .. " " .. a.Ending.Title, b.Ending.Icon .. " " .. b.Ending.Title)
	row(3, "Career", a.Career, b.Career)
	row(4, "Education", a.Education, b.Education)
	row(5, "Net worth", Format.Money(a.NetWorth), Format.Money(b.NetWorth))
	row(6, "Family", familyLine(a), familyLine(b))
	row(7, "Life score", a.Overall .. " / 100", b.Overall .. " / 100")
	for i, statName in ipairs(StatDefinitions.Order) do
		local info = StatDefinitions.Info[statName]
		local x, y = a.Stats[statName], b.Stats[statName]
		row(10 + i, info.Icon .. " " .. info.DisplayName, tostring(x) .. (if x > y + 4 then " ⭐" else ""), tostring(y) .. (if y > x + 4 then " ⭐" else ""))
	end
	local function came(entry)
		local names = {}
		for _, id in ipairs(entry.CameTrue) do
			if Futures.Info[id] and Futures.Info[id].Positive then
				table.insert(names, Futures.Info[id].Icon)
			end
		end
		return if #names > 0 then table.concat(names, " ") else "—"
	end
	row(30, "Futures that came true", came(a), came(b))
	local function firstChoice(entry)
		local d = entry.KeyDecisions[1]
		return if d then ("Age %d: %s"):format(d.Age, d.Choice) else "—"
	end
	row(31, "A defining choice", firstChoice(a), firstChoice(b))
	Components.Button({ Name = "BackToLife", Text = "Back to " .. a.Name, Icon = "‹", Style = "Secondary", Size = UDim2.new(1, 0, 0, 50), LayoutOrder = 99, Parent = scroll, OnClick = function()
		openDetail(a)
	end })
end

local function pickCompare(entry)
	local handle = UIController.OpenPanel({ Name = "PickLifeModal", Title = "⚖️  Compare " .. entry.Name .. " with…", Width = 640 })
	local scroll = handle.Scroll
	local count = 0
	for i, other in ipairs(history()) do
		if other.Id ~= entry.Id then
			count += 1
			Components.Button({ Name = "Pick" .. other.Id, Text = ("%s %s: %s"):format(other.Ending.Icon, other.Name, other.Ending.Title), Style = "Secondary", Size = UDim2.new(1, 0, 0, 52), TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = i, Parent = scroll, OnClick = function()
				openCompare(entry, other)
			end })
		end
	end
	if count == 0 then
		Create.Label({ Text = "Complete another life to compare them!", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, Parent = scroll })
	end
end

function openDetail(entry)
	local handle = UIController.OpenPanel({ Name = "LifeDetailModal", Title = entry.Ending.Icon .. "  " .. entry.Name .. ": " .. entry.Ending.Title, Width = 820 })
	handle.Subtitle.Text = summaryLine(entry)
	local scroll = handle.Scroll
	local buttons = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 52), LayoutOrder = 0, Parent = scroll })
	Create.List(Enum.FillDirection.Horizontal, 10).Parent = buttons
	Components.Button({ Name = "Replay", Text = "Replay reveal", Icon = "▶", Style = "Primary", Size = UDim2.fromOffset(220, 50), TextSize = 18, LayoutOrder = 1, Parent = buttons, OnClick = function()
		UIController.ClosePanel()
		LifeHistoryController.Replay(entry)
	end })
	Components.Button({ Name = "CompareLives", Text = "Compare", Icon = "⚖️", Style = "Accent", Size = UDim2.fromOffset(180, 50), TextSize = 18, LayoutOrder = 2, Parent = buttons, OnClick = function()
		pickCompare(entry)
	end })
	Create.Label({ Text = "“" .. entry.Ending.Line .. "”", FontFace = Theme.Font.Bold, TextColor3 = Theme.Color.Gold, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = scroll })
	heading(scroll, "LIFE", 2)
	lines(scroll, {
		"💼 " .. entry.Career .. "   ·   🎓 " .. entry.Education,
		"💰 Net worth " .. Format.Money(entry.NetWorth) .. "   ·   Life score " .. entry.Overall .. "/100",
		familyLine(entry) .. (if entry.BestFriend then "   ·   🫶 " .. entry.BestFriend else ""),
	}, 2)
	heading(scroll, "ACHIEVEMENTS", 10)
	lines(scroll, if #entry.Achievements > 0 then entry.Achievements else { "—" }, 10)
	heading(scroll, "GREATEST MOMENTS", 30)
	lines(scroll, if #entry.Moments > 0 then entry.Moments else { "—" }, 30)
	heading(scroll, "BIGGEST REGRETS", 40)
	lines(scroll, if #entry.Mistakes > 0 then entry.Mistakes else { "None worth mentioning." }, 40)
	heading(scroll, "KEY DECISIONS", 50)
	local decisionLines = {}
	for _, d in ipairs(entry.KeyDecisions) do
		table.insert(decisionLines, ("Age %d: %s (%s)"):format(d.Age, d.Choice, d.Title))
	end
	lines(scroll, decisionLines, 50)
	heading(scroll, "PREDICTIONS VS REALITY", 60)
	local came = {}
	for _, id in ipairs(entry.CameTrue) do
		came[id] = true
	end
	local journeyLines = {}
	for _, j in ipairs(entry.Journey) do
		local parts = {}
		for _, top in ipairs(j.Top) do
			table.insert(parts, ("%s %d%%%s"):format(Futures.Info[top.Id].Icon, top.Pct, if came[top.Id] then "✅" else ""))
		end
		table.insert(journeyLines, ("At %d: %s%s"):format(j.Age, table.concat(parts, "  "), if j.Twist then "  ⚡" else ""))
	end
	lines(scroll, journeyLines, 60)
end

function LifeHistoryController.Replay(entry)
	task.spawn(function()
		local action = RevealController.PlayFinal(entry, { Replay = true })
		if action == "Again" then
			UIController.Show("SlotSelect", "New")
		end
	end)
end

local function render()
	Create.Clear(frame, true)
	Layout.Header(frame, "Life History", function()
		UIController.Back()
	end)
	local scroll = Layout.Scroll(frame)
	local width = math.min(760, UIController.GetVirtualSize().X - 32)
	local list = history()
	local data = DataController.Get()
	Create.Label({
		Text = ("%d %s lived · 🪙 %d coins"):format(#list, if #list == 1 then "life" else "lives", data and data.Coins or 0),
		TextColor3 = Theme.Color.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromOffset(width, 24),
		LayoutOrder = 0,
		Parent = scroll,
	})
	if #list == 0 then
		local empty = Components.Panel({ Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, Padding = 24, LayoutOrder = 1, Parent = scroll })
		Create.Label({ Text = "📜 No completed lives yet.\nLive a whole life to age 85 to see its story, ending and Final Reveal here.", TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, Parent = empty })
		return
	end
	for i, entry in ipairs(list) do
		local card = Create("TextButton", {
			Name = "Life" .. entry.Id,
			Text = "",
			AutoButtonColor = false,
			Selectable = true,
			BackgroundColor3 = Theme.Color.Surface,
			Size = UDim2.fromOffset(width, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = i,
			Parent = scroll,
		}, { Create.Corner(Theme.Radius), Create.Stroke(), Create.Padding(14, 18) })
		Create.List(Enum.FillDirection.Vertical, 4).Parent = card
		Create.Label({ Text = entry.Ending.Icon .. "  " .. entry.Ending.Title, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H3, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = card })
		Create.Label({ Text = entry.Name .. " · " .. summaryLine(entry), TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = card })
		Create.Label({ Text = familyLine(entry), TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = card })
		card.Activated:Connect(function()
			if Components.OnClickSound then
				Components.OnClickSound()
			end
			openDetail(entry)
		end)
	end
end

function LifeHistoryController.Init()
	frame = UIController.NewScreen("LifeHistory", { Back = true, OnOpen = render })
end

function LifeHistoryController.Start()
	DataController.Changed:Connect(function()
		if UIController.Current() == "LifeHistory" then
			render()
		end
	end)
	UIController.LayoutChanged:Connect(function()
		if UIController.Current() == "LifeHistory" then
			render()
		end
	end)
end

return LifeHistoryController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="73">
            <Properties>
              <string name="Name">LifestyleController</string>
              <string name="Source"><![CDATA[--[[
	LifestyleController  (StarterPlayerScripts.Client.Controllers.LifestyleController)
	The 🎯 Lifestyle panel: choose what this life prioritises as the years
	pass (Shared/Data/Lifestyle). Free to change at any time; the server
	applies the focus every simulated year.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Lifestyle = require(Shared.Data.Lifestyle)
local StatDefinitions = require(Shared.Data.StatDefinitions)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Components = require(UILib.Components)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local HUDController = require(script.Parent.HUDController)
local NotificationController = require(script.Parent.NotificationController)

local LifestyleController = {}
LifestyleController.Priority = 43

local handle = nil
local busy = false

local function effectText(info, age: number): string
	local parts = {}
	local perYear = if age < 19 and info.YouthPerYear then info.YouthPerYear else info.PerYear
	for stat, delta in pairs(perYear or {}) do
		local stat_info = StatDefinitions.Info[stat]
		if stat_info and not (stat == "Career" and age < 19) then
			table.insert(parts, ("%s%s"):format(stat_info.Icon, if delta > 0 then "▲" else "▼"))
		end
	end
	if info.SavingsBonus then
		table.insert(parts, "💰 saves more")
	end
	if info.BondDecay then
		local grows = false
		for _, v in pairs(info.BondDecay) do
			grows = grows or v < 0
		end
		table.insert(parts, if grows then "💞 bonds grow" else "💔 bonds fade faster")
	end
	if info.PromotionMultiplier then
		table.insert(parts, if info.PromotionMultiplier > 1 then "📈 faster promotions" else "📉 slower promotions")
	end
	table.sort(parts)
	return table.concat(parts, "   ")
end

local function render()
	local life = DataController.GetActiveLife()
	if not handle or not life then
		return
	end
	handle.Clear()
	local current = Lifestyle.Info[life.Focus] or Lifestyle.Info.Balanced
	handle.Subtitle.Text = "Current focus: " .. current.Icon .. " " .. current.Title .. " · applies every year that passes"
	for i, id in ipairs(Lifestyle.Order) do
		local info = Lifestyle.Info[id]
		local available = Lifestyle.Available(id, life.Age)
		local selected = life.Focus == id
		local card = Create("TextButton", {
			Name = id,
			Text = "",
			AutoButtonColor = false,
			Selectable = true,
			BackgroundColor3 = if selected then Theme.Color.SurfaceHigher else Theme.Color.SurfaceHigh,
			BackgroundTransparency = if available then 0.05 else 0.5,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = i,
			Parent = handle.Scroll,
		}, { Create.Corner(Theme.RadiusSmall), Create.Stroke(if selected then Theme.Color.Primary else Theme.Color.Stroke, if selected then 3 else 1.5, if selected then 0 else 0.4), Create.Padding(12, 16) })
		Create.List(Enum.FillDirection.Vertical, 4).Parent = card
		Create.Label({ Text = info.Icon .. "  " .. info.Title .. (if selected then "   ✓ CURRENT" else ""), FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H3, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = card })
		Create.Label({ Text = if available then info.Description else ("Available from age %d."):format(info.MinAge or 0), TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = card })
		Create.Label({ Text = effectText(info, life.Age), FontFace = Theme.Font.Bold, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.Gold, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = card })
		card.Activated:Connect(function()
			if busy or selected or not available then
				return
			end
			if Components.OnClickSound then
				Components.OnClickSound()
			end
			busy = true
			local ok, result = Net.Invoke("SetFocus", id)
			busy = false
			if ok then
				NotificationController.Notify({ Title = "🎯 Lifestyle", Text = "Focus set to " .. info.Title .. ".", Kind = "Success", Duration = 2.5 })
			else
				NotificationController.Notify({ Title = "Not now", Text = tostring(result), Kind = "Warning", Duration = 3 })
			end
			task.wait(0.25)
			if handle and handle.IsOpen() then
				render()
			end
		end)
	end
end

function LifestyleController.Open()
	if not DataController.GetActiveLife() then
		return
	end
	handle = UIController.OpenPanel({ Name = "LifestyleModal", Title = "🎯  Lifestyle Focus", Width = 700, OnClose = function()
		handle = nil
	end })
	render()
end

function LifestyleController.Init()
	HUDController.AddAction({ Id = "Lifestyle", Icon = "🎯", Order = 20, OnClick = LifestyleController.Open })
end

function LifestyleController.Start()
	DataController.Changed:Connect(function()
		if handle and handle.IsOpen() and not busy then
			render()
		end
	end)
end

return LifestyleController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="74">
            <Properties>
              <string name="Name">LoadingController</string>
              <string name="Source"><![CDATA[--[[
	LoadingController  (StarterPlayerScripts.Client.Controllers.LoadingController)
	Full-screen loading screen shown from the moment the client starts until
	the player's data has arrived, then hands over to the main menu.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)
local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Anim = require(UILib.Anim)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)

local LoadingController = {}
LoadingController.Priority = 4
LoadingController.Done = false

local gui: ScreenGui
local group: CanvasGroup
local status: TextLabel

function LoadingController.Init()
	gui = Create("ScreenGui", {
		Name = "CYL_Loading",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ScreenInsets = Enum.ScreenInsets.None,
		DisplayOrder = 100,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	group = Create("CanvasGroup", {
		Name = "Loading",
		BackgroundColor3 = Theme.Color.White,
		Size = UDim2.fromScale(1, 1),
		Parent = gui,
	}, { Create.Gradient(Theme.Gradient.Backdrop, 120) })

	local center = Create("Frame", {
		Name = "Center",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.9, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = group,
	}, { Create.List(Enum.FillDirection.Vertical, 16, Enum.HorizontalAlignment.Center) })
	Create("UISizeConstraint", { MaxSize = Vector2.new(720, math.huge) }).Parent = center

	local title = Create.Label({
		Name = "Title",
		Text = Config.GameName,
		FontFace = Theme.Font.Heavy,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 80),
		LayoutOrder = 1,
		Parent = center,
	})
	Create("UITextSizeConstraint", { MaxTextSize = 72 }).Parent = title
	Create.Gradient(Theme.Gradient.Title).Parent = title

	-- Spinner: a ring (UIStroke) with a gradient that rotates.
	local ring = Create("Frame", {
		Name = "Spinner",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(54, 54),
		LayoutOrder = 2,
		Parent = center,
	}, { Create.Corner(Theme.RadiusPill) })
	local stroke = Create.Stroke(Theme.Color.White, 5, 0)
	stroke.Parent = ring
	local spinGradient = Create("UIGradient", {
		Color = Theme.Gradient.Primary,
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.6, 0.2), NumberSequenceKeypoint.new(1, 1) }),
		Parent = stroke,
	})
	task.spawn(function()
		while gui.Parent and not LoadingController.Done do
			spinGradient.Rotation = (spinGradient.Rotation + 6) % 360
			task.wait(1 / 30)
		end
	end)

	status = Create.Label({
		Name = "Status",
		Text = "Loading your life…",
		FontFace = Theme.Font.Bold,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 3,
		Parent = center,
	})
	local tip = Create.Label({
		Name = "Tip",
		Text = "💡 " .. Config.LoadingTips[math.random(1, #Config.LoadingTips)],
		TextColor3 = Theme.Color.TextDim,
		TextSize = Theme.TextSize.Small,
		TextXAlignment = Enum.TextXAlignment.Center,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 4,
		Parent = center,
	})
	task.spawn(function()
		local i = 1
		while gui.Parent and not LoadingController.Done do
			task.wait(4)
			i = i % #Config.LoadingTips + 1
			tip.Text = "💡 " .. Config.LoadingTips[i]
		end
	end)
end

function LoadingController.Start()
	task.delay(20, function()
		if not LoadingController.Done then
			status.Text = "Still loading… if this takes much longer, try rejoining."
		end
	end)
	DataController.WaitForData()
	LoadingController.Done = true
	status.Text = "Ready!"
	UIController.Show("Menu")
	task.wait(0.3)
	Anim.Fade(group, false, 0.5)
	task.wait(0.6)
	gui:Destroy()
end

return LoadingController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="75">
            <Properties>
              <string name="Name">MenuController</string>
              <string name="Source"><![CDATA[--[[
	MenuController  (StarterPlayerScripts.Client.Controllers.MenuController)
	Screens: Menu, SlotSelect, NameEntry, Credits.

	The main menu shows every feature whose screen exists. Later phases register
	their screens (Shop, Achievements, Leaderboards, LifeHistory, Friends) and
	their buttons appear automatically, so no button ever leads nowhere.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Config = require(Shared.Config)
local LifeStages = require(Shared.Data.LifeStages)
local StatDefinitions = require(Shared.Data.StatDefinitions)
local DataTemplate = require(Shared.Data.DataTemplate)
local NamePool = require(Shared.Data.NamePool)
local Format = require(Shared.Util.Format)
local Careers = require(Shared.Data.Careers)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Anim = require(UILib.Anim)
local Components = require(UILib.Components)
local Layout = require(UILib.Layout)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local NotificationController = require(script.Parent.NotificationController)

local MenuController = {}
MenuController.Priority = 30

local menuFrame, slotFrame, nameFrame, creditsFrame
local slotMode = "Continue" -- "Continue" | "New"
local busy = false

local ERRORS = {
	BadName = "Names must be 2–20 characters.",
	NameFiltered = "That name isn't allowed. Please try another!",
	SlotInUse = "That slot already has a life in it.",
	RateLimited = "Slow down a moment, then try again.",
	NotLoaded = "Your data is still loading. Try again in a second.",
	EmptySlot = "That save slot is empty.",
}
local function errorText(reason: any): string
	return ERRORS[reason] or "Something went wrong. Please try again."
end

-- ===== Helpers =====
local function lifeSummary(life): string
	if life.Completed then
		return "✅ Life complete · Age " .. life.Age
	end
	local stage = LifeStages.Get(life.Stage)
	local text = ("Age %d · %s"):format(life.Age, stage.DisplayName)
	if life.Career and life.Career.Id ~= "None" and Careers.Info[life.Career.Id] then
		text ..= " · " .. Careers.TitleAt(life.Career.Id, life.Career.Level)
	end
	return text
end

local function statLine(life): string
	local s = life.Stats
	return ("😊 %d   ❤️ %d   🧠 %d   💰 %s"):format(math.floor(s.Happiness + 0.5), math.floor(s.Health + 0.5), math.floor(s.Intelligence + 0.5), Format.Money(life.Money))
end

local function firstEmptySlot(data): string?
	for _, slotId in ipairs(DataTemplate.SlotIds) do
		if data.Slots[slotId] == false then
			return slotId
		end
	end
	return nil
end

local function hasAnyLife(data): boolean
	for _, slotId in ipairs(DataTemplate.SlotIds) do
		if type(data.Slots[slotId]) == "table" then
			return true
		end
	end
	return false
end

function MenuController.ContinueSlot(slotId: string)
	if busy then
		return
	end
	busy = true
	local ok, reason = Net.Invoke("ContinueLife", slotId)
	busy = false
	if ok then
		UIController.Show("Game")
	else
		NotificationController.Notify({ Title = "Couldn't continue", Text = errorText(reason), Kind = "Error" })
	end
end

local function quickPlay()
	local data = DataController.Get()
	if not data then
		return
	end
	local life = DataController.GetActiveLife()
	if life and not life.Completed then
		MenuController.ContinueSlot(data.ActiveSlot)
		return
	end
	local empty = firstEmptySlot(data)
	if empty then
		UIController.Show("NameEntry", empty, false)
	else
		UIController.Show("SlotSelect", "New")
	end
end

-- ===== Main menu =====
local MENU_ITEMS = {
	{ Text = "Play With Friends", Icon = "👥", Screen = "Friends" },
	{ Text = "Continue Life", Icon = "⏯️", Action = function()
		UIController.Show("SlotSelect", "Continue")
	end, NeedsLife = true },
	{ Text = "New Life", Icon = "✨", Action = function()
		UIController.Show("SlotSelect", "New")
	end },
	{ Text = "Shop", Icon = "🛍️", Screen = "Shop" },
	{ Text = "Achievements", Icon = "🏆", Screen = "Achievements" },
	{ Text = "Leaderboards", Icon = "📈", Screen = "Leaderboards" },
	{ Text = "Life History", Icon = "📜", Screen = "LifeHistory" },
	{ Text = "Settings", Icon = "⚙️", Screen = "Settings" },
	{ Text = "Credits", Icon = "🎬", Screen = "Credits" },
}

local playButton
local function buildLifeCard(parent, width: number, life, layoutOrder: number)
	local card = Components.Panel({
		Name = "LifeCard",
		Size = UDim2.fromOffset(width, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Padding = 20,
		LayoutOrder = layoutOrder,
		Parent = parent,
	})
	Create.List(Enum.FillDirection.Vertical, 10).Parent = card
	Create.Label({
		Text = if life then "CURRENT LIFE" else "WELCOME",
		TextSize = Theme.TextSize.Tiny,
		FontFace = Theme.Font.Heavy,
		TextColor3 = Theme.Color.Primary,
		Size = UDim2.new(1, 0, 0, 18),
		LayoutOrder = 1,
		Parent = card,
	})
	if not life then
		Create.Label({
			Text = "Your story hasn't started yet.",
			FontFace = Theme.Font.Heavy,
			TextSize = Theme.TextSize.H2,
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 2,
			Parent = card,
		})
		Create.Label({
			Text = "Start as a five-year-old, make choices that shape who you become, and discover how your life turns out.",
			TextColor3 = Theme.Color.TextDim,
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 3,
			Parent = card,
		})
		return card
	end
	Create.Label({
		Text = life.Name,
		FontFace = Theme.Font.Heavy,
		TextSize = Theme.TextSize.H1,
		Size = UDim2.new(1, 0, 0, 44),
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
		LayoutOrder = 2,
		Parent = card,
	})
	Create.Label({ Text = lifeSummary(life), TextColor3 = Theme.Color.TextDim, LayoutOrder = 3, Parent = card })
	local stage = LifeStages.Get(life.Stage)
	local progress = Components.StatBar({
		Name = "StageProgress",
		Icon = "🧭",
		DisplayName = stage.DisplayName .. " progress",
		Color = stage.Color,
		Value = if life.Completed then 100 else life.ScenarioIndex / stage.ScenariosPerStage * 100,
		LayoutOrder = 4,
		Parent = card,
	})
	progress.Instance:FindFirstChild("Value").Visible = false
	local grid = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 5, Parent = card })
	Create("UIGridLayout", { CellSize = UDim2.new(0.5, -6, 0, 40), CellPadding = UDim2.fromOffset(12, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	for i, statName in ipairs({ "Happiness", "Health", "Intelligence", "Popularity" }) do
		local info = StatDefinitions.Info[statName]
		Components.StatBar({ Name = statName, Icon = info.Icon, DisplayName = info.DisplayName, Color = info.Color, Value = life.Stats[statName], Compact = true, LayoutOrder = i, Parent = grid })
	end
	Create.Label({ Text = "💰  " .. Format.Money(life.Money), FontFace = Theme.Font.Bold, LayoutOrder = 6, Parent = card })
	return card
end

local function renderMenu()
	Create.Clear(menuFrame, true)
	local data = DataController.Get()
	local life = DataController.GetActiveLife()
	local size = UIController.GetVirtualSize()
	local narrow = UIController.IsNarrow()

	local scroll = Layout.Scroll(menuFrame, { Size = UDim2.fromScale(1, 1), Position = UDim2.new() })
	local list = scroll:FindFirstChildOfClass("UIListLayout")
	local columnWidth = math.min(if narrow then 460 else 420, size.X - 40)

	local container
	if narrow then
		container = scroll
	else
		list.VerticalAlignment = Enum.VerticalAlignment.Center
		container = Create("Frame", {
			Name = "Split",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Parent = scroll,
		})
		Create.List(Enum.FillDirection.Horizontal, 60, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center).Parent = container
	end

	local left = Layout.Column(container, columnWidth, { LayoutOrder = 1 })
	local title = Create.Label({
		Name = "Title",
		Text = Config.GameName,
		FontFace = Theme.Font.Heavy,
		TextSize = if narrow then 48 else Theme.TextSize.Hero,
		TextXAlignment = if narrow then Enum.TextXAlignment.Center else Enum.TextXAlignment.Left,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		Parent = left,
	})
	Create.Gradient(Theme.Gradient.Title).Parent = title
	Create.Label({
		Text = "Every choice shapes your future.",
		TextColor3 = Theme.Color.TextDim,
		TextXAlignment = title.TextXAlignment,
		LayoutOrder = 2,
		Parent = left,
	})

	if narrow then
		buildLifeCard(left, columnWidth, life, 3)
	end

	local playText = if life and not life.Completed then "Play as " .. life.Name else "Play"
	playButton = Components.Button({
		Name = "Play",
		Text = playText,
		Icon = "▶",
		Style = "Primary",
		Size = UDim2.new(1, 0, 0, 66),
		TextSize = 26,
		LayoutOrder = 4,
		Parent = left,
		OnClick = quickPlay,
	})

	local grid = Create("Frame", { Name = "Buttons", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 5, Parent = left })
	Create("UIGridLayout", { CellSize = UDim2.new(0.5, -6, 0, 54), CellPadding = UDim2.fromOffset(12, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	local order = 0
	for _, item in ipairs(MENU_ITEMS) do
		if item.Screen and not UIController.HasScreen(item.Screen) then
			continue
		end
		order += 1
		local button = Components.Button({
			Text = item.Text,
			Icon = item.Icon,
			Style = "Secondary",
			TextSize = 19,
			LayoutOrder = order,
			Parent = grid,
			OnClick = item.Action or function()
				UIController.Show(item.Screen)
			end,
		})
		if item.NeedsLife and not hasAnyLife(data) then
			Components.SetDisabled(button, true)
		end
	end

	if not narrow then
		buildLifeCard(container, math.min(440, size.X - columnWidth - 140), life, 2)
	end

	Create.Label({
		Name = "Coins",
		Text = ("🪙 %d coins · %d %s lived"):format(data.Coins, #data.LifeHistory, if #data.LifeHistory == 1 then "life" else "lives"),
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Color.Gold,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 98,
		Parent = scroll,
	})
	Create.Label({
		Name = "Version",
		Text = "v" .. Config.Version,
		TextSize = Theme.TextSize.Tiny,
		TextColor3 = Theme.Color.TextFaint,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 99,
		Parent = scroll,
	})
	Anim.Pop(left, 0.96)
end

-- ===== Save slots =====
local function slotCard(parent, slotId: string, index: number, life, width: number, height: number)
	local card = Components.Panel({
		Name = slotId,
		Size = UDim2.fromOffset(width, height),
		Padding = 18,
		LayoutOrder = index,
		Parent = parent,
	})
	local info = Create("Frame", { Name = "Info", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -64), Parent = card })
	Create.List(Enum.FillDirection.Vertical, 8).Parent = info
	Create.Label({ Text = "SLOT " .. index, TextSize = Theme.TextSize.Tiny, FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Primary, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 1, Parent = info })

	-- Action buttons pinned to the bottom of the card.
	local actions = Create("Frame", {
		Name = "Actions",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 54),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Parent = card,
	})
	Create.List(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left).Parent = actions
	local firstButton

	if life then
		Create.Label({ Text = life.Name, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H2, Size = UDim2.new(1, 0, 0, 36), TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, LayoutOrder = 2, Parent = info })
		Create.Label({ Text = lifeSummary(life), TextColor3 = Theme.Color.TextDim, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 3, Parent = info })
		Create.Label({ Text = statLine(life), TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, Parent = info })

		if slotMode == "Continue" then
			firstButton = Components.Button({
				Name = if life.Completed then "ViewReveal" else "Continue",
				Text = if life.Completed then "View Final Reveal" else "Continue",
				Icon = if life.Completed then "🔮" else "▶",
				Style = if life.Completed then "Accent" else "Primary",
				Size = UDim2.new(1, -64, 1, 0),
				LayoutOrder = 1,
				Parent = actions,
				OnClick = function()
					if life.Completed then
						local LifeHistoryController = require(script.Parent.LifeHistoryController)
						local entry = life.HistoryId and LifeHistoryController.Find(life.HistoryId)
						if entry then
							LifeHistoryController.Replay(entry)
						else
							UIController.Show("LifeHistory")
						end
					else
						MenuController.ContinueSlot(slotId)
					end
				end,
			})
		else
			firstButton = Components.Button({
				Text = "Replace",
				Icon = "✨",
				Style = "Accent",
				Size = UDim2.new(1, -64, 1, 0),
				LayoutOrder = 1,
				Parent = actions,
				OnClick = function()
					local confirmed = UIController.Confirm({
						Title = "Replace " .. life.Name .. "?",
						Text = "Starting a new life here will permanently erase " .. life.Name .. "'s life (" .. lifeSummary(life) .. ").",
						ConfirmText = "Replace",
						Danger = true,
					})
					if confirmed then
						UIController.Show("NameEntry", slotId, true)
					end
				end,
			})
		end
		Components.Button({
			Name = "Delete",
			Text = "🗑",
			Style = "Ghost",
			Size = UDim2.fromOffset(54, 54),
			LayoutOrder = 2,
			Parent = actions,
			OnClick = function()
				local confirmed = UIController.Confirm({
					Title = "Delete " .. life.Name .. "?",
					Text = "This life will be gone forever. This can't be undone.",
					ConfirmText = "Delete",
					Danger = true,
				})
				if confirmed then
					local ok, reason = Net.Invoke("DeleteLife", slotId)
					if not ok then
						NotificationController.Notify({ Title = "Couldn't delete", Text = errorText(reason), Kind = "Error" })
					end
				end
			end,
		})
	else
		Create.Label({ Text = "Empty Slot", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H2, TextColor3 = Theme.Color.TextDim, Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 2, Parent = info })
		Create.Label({ Text = "A blank page. Who will you be?", TextColor3 = Theme.Color.TextFaint, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = info })
		firstButton = Components.Button({
			Text = "Start New Life",
			Icon = "✨",
			Style = "Primary",
			Size = UDim2.new(1, 0, 1, 0),
			LayoutOrder = 1,
			Parent = actions,
			OnClick = function()
				UIController.Show("NameEntry", slotId, false)
			end,
		})
	end
	return card, firstButton
end

local function renderSlots()
	Create.Clear(slotFrame, true)
	local data = DataController.Get()
	if not data then
		return
	end
	Layout.Header(slotFrame, if slotMode == "Continue" then "Continue a Life" else "Start a New Life", function()
		UIController.Back()
	end)
	local narrow = UIController.IsNarrow()
	local size = UIController.GetVirtualSize()
	local scroll = Layout.Scroll(slotFrame)
	local row = scroll
	local width, height
	if narrow then
		width, height = math.min(520, size.X - 32), 230
	else
		width, height = math.min(340, math.floor((size.X - 120) / 3)), 300
		row = Create("Frame", { Name = "Row", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, height), Parent = scroll })
		Create.List(Enum.FillDirection.Horizontal, 20, Enum.HorizontalAlignment.Center).Parent = row
		scroll:FindFirstChildOfClass("UIListLayout").VerticalAlignment = Enum.VerticalAlignment.Center
	end
	local focus
	for index, slotId in ipairs(DataTemplate.SlotIds) do
		local life = data.Slots[slotId]
		local card, button = slotCard(row, slotId, index, if type(life) == "table" then life else nil, width, height)
		focus = focus or button
		Anim.Pop(card, 0.92, 0.3 + index * 0.05)
	end
	UIController.Focus(focus)
end

-- ===== Name entry =====
local pendingSlot, pendingOverwrite = "Slot1", false

local function renderNameEntry()
	Create.Clear(nameFrame, true)
	Layout.Header(nameFrame, "", function()
		UIController.Back()
	end)
	local size = UIController.GetVirtualSize()
	local width = math.min(580, size.X - 32)
	local panel = Components.Panel({
		Name = "NamePanel",
		Size = UDim2.fromOffset(width, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 20),
		Padding = 26,
		Parent = nameFrame,
	})
	Create.List(Enum.FillDirection.Vertical, 14, Enum.HorizontalAlignment.Center).Parent = panel
	Create.Label({ Text = "👶", TextSize = 54, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 60), LayoutOrder = 1, Parent = panel })
	Create.Label({ Text = "Who will you become?", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = panel })
	Create.Label({ Text = "Choose a name for your new life. You'll start at age 5.", TextColor3 = Theme.Color.TextDim, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = panel })

	local box = Create("TextBox", {
		Name = "NameBox",
		Text = NamePool[math.random(1, #NamePool)],
		PlaceholderText = "Type a name…",
		PlaceholderColor3 = Theme.Color.TextFaint,
		ClearTextOnFocus = false,
		FontFace = Theme.Font.Bold,
		TextSize = 28,
		TextColor3 = Theme.Color.Text,
		BackgroundColor3 = Theme.Color.Background,
		Size = UDim2.new(1, 0, 0, 64),
		LayoutOrder = 4,
		Parent = panel,
	}, { Create.Corner(Theme.RadiusSmall), Create.Stroke(Theme.Color.Stroke, 2, 0.2) })
	local counter = Create.Label({ Text = "", TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextFaint, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 5, Parent = panel })
	local errorLabel = Create.Label({ Text = "", TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.Negative, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 6, Parent = panel })

	local function refreshCounter()
		-- Keep to 20 characters as the player types.
		local length = utf8.len(box.Text) or #box.Text
		if length > 20 then
			box.Text = box.Text:sub(1, utf8.offset(box.Text, 21) - 1)
			length = 20
		end
		counter.Text = length .. " / 20"
	end
	box:GetPropertyChangedSignal("Text"):Connect(refreshCounter)
	refreshCounter()

	local row = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 58), LayoutOrder = 7, Parent = panel })
	Create.List(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center).Parent = row
	local half = math.floor((width - 52 - 12) / 2)
	Components.Button({
		Text = "Random",
		Icon = "🎲",
		Style = "Secondary",
		Size = UDim2.fromOffset(half, 58),
		LayoutOrder = 1,
		Parent = row,
		OnClick = function()
			box.Text = NamePool[math.random(1, #NamePool)]
			errorLabel.Text = ""
		end,
	})
	local startButton
	local function submit()
		if busy then
			return
		end
		busy = true
		Components.SetDisabled(startButton, true)
		errorLabel.Text = ""
		local ok, result = Net.Invoke("StartNewLife", pendingSlot, box.Text, pendingOverwrite)
		busy = false
		Components.SetDisabled(startButton, false)
		if ok then
			UIController.Show("Game")
		else
			errorLabel.Text = errorText(result)
			Anim.Shake(panel)
		end
	end
	startButton = Components.Button({
		Text = "Start Life",
		Icon = "▶",
		Style = "Primary",
		Size = UDim2.fromOffset(half, 58),
		LayoutOrder = 2,
		Parent = row,
		OnClick = submit,
	})
	box.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			submit()
		end
	end)
	Anim.Pop(panel, 0.92)
	UIController.Focus(startButton)
end

-- ===== Credits =====
local function renderCredits()
	Create.Clear(creditsFrame, true)
	Layout.Header(creditsFrame, "Credits", function()
		UIController.Back()
	end)
	local scroll = Layout.Scroll(creditsFrame)
	local width = math.min(640, UIController.GetVirtualSize().X - 32)
	local column = Layout.Column(scroll, width)
	Create.Label({ Text = Config.GameName, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 0, Parent = column })
	for i, section in ipairs(Config.Credits) do
		local panel = Components.Panel({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Padding = 18, LayoutOrder = i, Parent = column })
		Create.List(Enum.FillDirection.Vertical, 6).Parent = panel
		Create.Label({ Text = section.Heading, FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Primary, TextSize = Theme.TextSize.Small, LayoutOrder = 0, Parent = panel })
		for j, line in ipairs(section.Lines) do
			Create.Label({ Text = line, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = j, Parent = panel })
		end
	end
	Create.Label({ Text = "Version " .. Config.Version, TextColor3 = Theme.Color.TextFaint, TextSize = Theme.TextSize.Small, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 100, Parent = column })
end

-- ===== Lifecycle =====
function MenuController.Init()
	menuFrame = UIController.NewScreen("Menu", {
		OnOpen = renderMenu,
		DefaultFocus = function()
			return playButton
		end,
	})
	slotFrame = UIController.NewScreen("SlotSelect", {
		Back = "Menu",
		OnOpen = function(mode)
			slotMode = mode or slotMode
			renderSlots()
		end,
	})
	nameFrame = UIController.NewScreen("NameEntry", {
		Back = true,
		OnOpen = function(slotId, overwrite)
			pendingSlot = slotId or pendingSlot
			pendingOverwrite = overwrite == true
			renderNameEntry()
		end,
	})
	creditsFrame = UIController.NewScreen("Credits", { Back = true, OnOpen = renderCredits })
end

function MenuController.Start()
	UIController.LayoutChanged:Connect(function()
		local screen = UIController.Current()
		if screen == "Menu" then
			renderMenu()
		elseif screen == "SlotSelect" then
			renderSlots()
		elseif screen == "Credits" then
			renderCredits()
		end
		-- NameEntry is not re-rendered on resize so typed text isn't lost.
	end)
	DataController.Changed:Connect(function()
		local screen = UIController.Current()
		if screen == "SlotSelect" then
			renderSlots()
		end
	end)
end

return MenuController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="76">
            <Properties>
              <string name="Name">NotificationController</string>
              <string name="Source"><![CDATA[--[[
	NotificationController  (StarterPlayerScripts.Client.Controllers.NotificationController)
	Toast notifications (top-right, or top-centre on narrow screens).
	  NotificationController.Notify({ Title, Text, Kind = "Info"|"Success"|"Warning"|"Error"|"Important", Duration })
	Server pushes arrive on the "Notify" remote. When the player turns
	Notifications off, only "Important" and "Error" toasts are shown.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("Shared").Net)
local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Anim = require(UILib.Anim)

local UIController = require(script.Parent.UIController)
local SettingsController = require(script.Parent.SettingsController)
local AudioController = require(script.Parent.AudioController)

local NotificationController = {}
NotificationController.Priority = 20

local KINDS = {
	Info = { Icon = "ℹ️", Color = Theme.Color.Accent },
	Success = { Icon = "✅", Color = Theme.Color.Positive },
	Warning = { Icon = "⚠️", Color = Theme.Color.Warning },
	Error = { Icon = "⛔", Color = Theme.Color.Negative },
	Important = { Icon = "⭐", Color = Theme.Color.Gold },
}

local stack: Frame
local order = 0

local function layout()
	local narrow = UIController.IsNarrow()
	stack.AnchorPoint = if narrow then Vector2.new(0.5, 0) else Vector2.new(1, 0)
	stack.Position = if narrow then UDim2.new(0.5, 0, 0, 12) else UDim2.new(1, -16, 0, 84)
	stack.Size = UDim2.fromOffset(math.min(360, UIController.GetVirtualSize().X - 24), 0)
end

function NotificationController.Notify(options: { [string]: any })
	local kind = KINDS[options.Kind or "Info"] or KINDS.Info
	local critical = options.Kind == "Important" or options.Kind == "Error"
	if not critical and not SettingsController.Get("Notifications") then
		return
	end
	order += 1
	local toast = Create("CanvasGroup", {
		Name = "Toast",
		BackgroundColor3 = Theme.Color.Surface,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order,
		Parent = stack,
	}, { Create.Corner(Theme.RadiusSmall), Create.Stroke(kind.Color, 2, 0.2), Create.Padding(12, 14) })
	Create.List(Enum.FillDirection.Vertical, 2).Parent = toast
	Create.Label({
		Text = kind.Icon .. "  " .. tostring(options.Title or ""),
		FontFace = Theme.Font.Bold,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		Parent = toast,
	})
	if options.Text and options.Text ~= "" then
		Create.Label({
			Text = tostring(options.Text),
			TextSize = Theme.TextSize.Small,
			TextColor3 = Theme.Color.TextDim,
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 2,
			Parent = toast,
		})
	end
	AudioController.Play("Notify")
	Anim.Fade(toast, true, 0.2)
	task.delay(options.Duration or 4, function()
		Anim.Fade(toast, false, 0.3)
		task.wait(0.35)
		toast:Destroy()
	end)
	-- Keep at most 4 on screen.
	local toasts = {}
	for _, child in ipairs(stack:GetChildren()) do
		if child:IsA("CanvasGroup") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 4 then
		toasts[1]:Destroy()
	end
end

function NotificationController.Init()
	stack = Create("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 40,
		Parent = UIController.GetOverlay(),
	})
	Create.List(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right).Parent = stack
	layout()
	UIController.LayoutChanged:Connect(layout)
end

function NotificationController.Start()
	Net.OnEvent("Notify", function(payload)
		if type(payload) == "table" then
			NotificationController.Notify(payload)
		end
	end)
end

return NotificationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="77">
            <Properties>
              <string name="Name">PartyController</string>
              <string name="Source"><![CDATA[--[[
	PartyController  (StarterPlayerScripts.Client.Controllers.PartyController)
	Client side of Life Circles and city events (server: PartyService,
	CityEventService).
	  • keeps the current circle state (PartyController.Get / .Changed)
	  • shows circle invites with Join / No thanks
	  • opens the group-decision vote panel, live tally and countdown, then
	    what the group chose and what it meant for YOUR life
	  • plays Group Life Reveals (RevealController.PlayGroup)
	  • shows city-event invitations with Join / Skip, and a summary
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Format = require(Shared.Util.Format)
local StatDefinitions = require(Shared.Data.StatDefinitions)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Anim = require(UILib.Anim)
local Components = require(UILib.Components)

local UIController = require(script.Parent.UIController)
local NotificationController = require(script.Parent.NotificationController)
local AudioController = require(script.Parent.AudioController)
local RevealController = require(script.Parent.RevealController)

local PartyController = {}
PartyController.Priority = 49
PartyController.Changed = Signal.new() -- (state or false)

local state = false
local promptStack: Frame
local vote = nil -- { Payload, Handle, Votes, MyVote, Deadline }

local ERRORS = {
	NotHere = "That player isn't in this server any more.",
	PartyFull = "That circle is full (4 players max).",
	AlreadyInvited = "You've already invited them.",
	AlreadyMember = "They're already in your circle.",
	Expired = "That invite has expired.",
	NoInvite = "That invite is no longer valid.",
	Cooldown = "Give it a moment before the next one.",
	EventActive = "Your circle is already deciding something.",
	NotEveryoneReady = "Everyone in the circle needs a life in progress.",
	NoParty = "You're not in a circle.",
	NotLeader = "Only the circle leader can do that.",
	ChoiceLocked = "Not everyone in the circle can do that one.",
	NotEligible = "You can't join this one.",
	RateLimited = "Slow down a moment.",
}
function PartyController.ErrorText(reason: any): string
	return ERRORS[reason] or tostring(reason)
end

function PartyController.Get()
	return state
end

function PartyController.MyUserId(): number
	return Players.LocalPlayer.UserId
end

function PartyController.IsLeader(): boolean
	return state ~= false and state.LeaderUserId == PartyController.MyUserId()
end

local function setState(newState)
	state = newState or false
	PartyController.Changed:Fire(state)
end

-- ===== Small prompt cards (invites, city events) =====
local function promptCard(name: string, title: string, body: string, seconds: number, buttons)
	local card = Create("CanvasGroup", {
		Name = name,
		BackgroundColor3 = Theme.Color.Surface,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = promptStack,
	}, { Create.Corner(Theme.Radius), Create.Stroke(Theme.Color.Gold, 2, 0.1), Create.Padding(14, 16) })
	Create.List(Enum.FillDirection.Vertical, 8).Parent = card
	Create.Label({ Text = title, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H3, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = card })
	Create.Label({ Text = body, TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = card })
	local timer = Create.Label({ Name = "Timer", Text = "", TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextFaint, LayoutOrder = 3, Parent = card })
	local row = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 4, Parent = card })
	Create.List(Enum.FillDirection.Horizontal, 10).Parent = row
	local done = false
	local function close()
		if done then
			return
		end
		done = true
		Anim.Fade(card, false, 0.2)
		task.delay(0.3, function()
			card:Destroy()
		end)
	end
	for i, b in ipairs(buttons) do
		Components.Button({ Name = b.Name, Text = b.Text, Style = b.Style or (if i == 1 then "Primary" else "Secondary"), Size = UDim2.fromOffset(b.Width or 170, 46), TextSize = 18, LayoutOrder = i, Parent = row, OnClick = function()
			if done then
				return
			end
			close()
			if b.OnClick then
				task.spawn(b.OnClick)
			end
		end })
	end
	Anim.Fade(card, true, 0.2)
	AudioController.Play("Notify")
	task.spawn(function()
		local deadline = os.clock() + seconds
		while not done and os.clock() < deadline do
			timer.Text = ("%ds left"):format(math.ceil(deadline - os.clock()))
			task.wait(0.5)
		end
		close()
	end)
	return card
end

local function onInvite(invite)
	promptCard("Invite" .. invite.InviteId, "🤝 " .. invite.FromName .. " invited you", "Join their Life Circle to make group decisions, compare futures and watch Group Life Reveals together. Your own life stays yours.", invite.Seconds or 45, {
		{ Name = "AcceptInvite", Text = "Join", OnClick = function()
			local ok, result = Net.Invoke("PartyRespond", invite.InviteId, true)
			if ok then
				NotificationController.Notify({ Title = "🤝 Life Circle", Text = "You joined " .. invite.FromName .. "'s circle!", Kind = "Success" })
			else
				NotificationController.Notify({ Title = "Couldn't join", Text = PartyController.ErrorText(result), Kind = "Warning" })
			end
		end },
		{ Name = "DeclineInvite", Text = "No thanks", OnClick = function()
			Net.Invoke("PartyRespond", invite.InviteId, false)
		end },
	})
end

-- ===== Group decisions =====
local function previewText(choice): string
	local parts = {}
	for _, p in ipairs(choice.Preview or {}) do
		local info = StatDefinitions.Info[p.Stat]
		if info then
			table.insert(parts, ("%s<font color=\"%s\">%s</font>"):format(info.Icon, if p.Dir > 0 then Theme.Hex.Positive else Theme.Hex.Negative, string.rep(if p.Dir > 0 then "▲" else "▼", p.Size)))
		end
	end
	if choice.Risky then
		table.insert(parts, "🎲<font color=\"" .. Theme.Hex.Gold .. "\">Risky</font>")
	end
	for _, tag in ipairs(choice.Tags or {}) do
		table.insert(parts, "<font color=\"" .. Theme.Hex.Gold .. "\">" .. tag .. "</font>")
	end
	return table.concat(parts, "   ")
end

local function nameFor(userId: string): string
	if state then
		for _, m in ipairs(state.Members) do
			if tostring(m.UserId) == userId then
				return m.DisplayName
			end
		end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if tostring(p.UserId) == userId then
			return p.DisplayName or p.Name
		end
	end
	return "Someone"
end

local renderVote
function renderVote()
	if not vote or not vote.Handle or not vote.Handle.IsOpen() then
		return
	end
	local payload = vote.Payload
	local handle = vote.Handle
	handle.Clear()
	local scroll = handle.Scroll
	Create.Label({ Text = payload.Description, TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = scroll })
	Create.Label({ Text = "Everyone votes. The majority decides, and each of you lives with the result in your own life.", TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextFaint, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = scroll })
	local votersByChoice = {}
	for userId, choiceId in pairs(vote.Votes) do
		votersByChoice[choiceId] = votersByChoice[choiceId] or {}
		table.insert(votersByChoice[choiceId], nameFor(userId))
	end
	for i, choice in ipairs(payload.Choices) do
		local mine = vote.MyVote == choice.Id
		local card = Create("TextButton", {
			Name = "Vote" .. choice.Id,
			Text = "",
			AutoButtonColor = false,
			Selectable = not choice.Locked,
			BackgroundColor3 = if mine then Theme.Color.SurfaceHigher else Theme.Color.SurfaceHigh,
			BackgroundTransparency = if choice.Locked then 0.5 else 0.05,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 10 + i,
			Parent = scroll,
		}, { Create.Corner(Theme.RadiusSmall), Create.Stroke(if mine then Theme.Color.Primary else Theme.Color.Stroke, if mine then 3 else 1.5, if mine then 0 else 0.4), Create.Padding(12, 14) })
		Create.List(Enum.FillDirection.Vertical, 4).Parent = card
		Create.Label({ Text = (if choice.Locked then "🔒 " elseif mine then "✅ " else "") .. choice.Text, FontFace = Theme.Font.Heavy, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = card })
		Create.Label({ Text = if choice.Locked then (choice.LockHint or "Locked") else choice.Description, TextSize = Theme.TextSize.Small, TextColor3 = if choice.Locked then Theme.Color.Warning else Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = card })
		if not choice.Locked then
			Create.Label({ Text = previewText(choice), RichText = true, TextSize = Theme.TextSize.Small, FontFace = Theme.Font.Bold, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = card })
		end
		local voters = votersByChoice[choice.Id]
		if voters then
			Create.Label({ Name = "Voters", Text = ("🗳️ %d: %s"):format(#voters, table.concat(voters, ", ")), TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.Gold, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, Parent = card })
		end
		card.Activated:Connect(function()
			if choice.Locked then
				NotificationController.Notify({ Title = "Locked", Text = choice.LockHint or "Not everyone can do this.", Kind = "Warning", Duration = 2.5 })
				return
			end
			if Components.OnClickSound then
				Components.OnClickSound()
			end
			vote.MyVote = choice.Id
			renderVote()
			local ok, result = Net.Invoke("PartyVote", payload.EventId, choice.Id)
			if not ok then
				NotificationController.Notify({ Title = "Vote not counted", Text = PartyController.ErrorText(result), Kind = "Warning" })
			end
		end)
	end
end

local function onGroupEvent(payload)
	vote = { Payload = payload, Votes = {}, MyVote = nil, Deadline = os.clock() + (payload.Seconds or 40) }
	local handle = UIController.OpenPanel({ Name = "GroupEventModal", Title = payload.Icon .. "  Group Decision: " .. payload.Title, Width = 760 })
	vote.Handle = handle
	AudioController.Play("Notify")
	renderVote()
	local current = vote
	task.spawn(function()
		while vote == current and handle.IsOpen() and not current.Result do
			local left = math.max(0, math.ceil(current.Deadline - os.clock()))
			handle.Subtitle.Text = ("Vote now · %ds left · started by %s"):format(left, payload.StartedBy)
			task.wait(0.5)
		end
	end)
end

local function onGroupVote(update)
	if vote and vote.Payload.EventId == update.EventId then
		vote.Votes = update.Votes
		renderVote()
	end
end

local function changeLines(result)
	local parts = {}
	for _, text in ipairs(result.LifeChanges or {}) do
		table.insert(parts, text)
	end
	for stat, delta in pairs(result.Applied or {}) do
		local info = StatDefinitions.Info[stat]
		if info and math.abs(delta) >= 0.5 then
			table.insert(parts, info.Icon .. " " .. Format.Signed(delta))
		end
	end
	if result.MoneyDelta and result.MoneyDelta ~= 0 then
		table.insert(parts, "💰 " .. (if result.MoneyDelta > 0 then "+" else "") .. Format.Money(result.MoneyDelta))
	end
	return parts
end

local function onGroupResult(result)
	local handle = if vote and vote.Payload.EventId == result.EventId and vote.Handle.IsOpen() then vote.Handle else nil
	if vote and vote.Payload.EventId == result.EventId then
		vote.Result = result
	end
	if not handle then
		handle = UIController.OpenPanel({ Name = "GroupEventModal", Title = result.Icon .. "  Group Decision: " .. result.Title, Width = 760 })
	end
	handle.Clear()
	local scroll = handle.Scroll
	local chosenText = result.ChoiceText
	local count = result.Tally and result.Tally[result.ChoiceId] or 0
	handle.Subtitle.Text = if result.NoVotes then "Nobody voted, so fate decided" elseif result.Tie then "It was a tie, settled by chance" else ("Decided by %d vote%s"):format(count, if count == 1 then "" else "s")
	Create.Label({ Name = "Chosen", Text = "The group chose: " .. chosenText, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H2, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = scroll })
	if result.Lucky then
		Components.Chip({ Text = "🎲 Fate stepped in!", TextColor = Theme.Color.Gold, LayoutOrder = 2, Parent = scroll })
	end
	Create.Label({ Name = "Story", Text = result.Story, TextSize = Theme.TextSize.H3, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = scroll })
	local lines = changeLines(result)
	if #lines > 0 then
		Create.Label({ Text = "For your life:  " .. table.concat(lines, "   "), FontFace = Theme.Font.Bold, TextColor3 = Theme.Color.Gold, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, Parent = scroll })
	end
	Components.Button({ Name = "CloseGroupResult", Text = "Nice!", Icon = "👍", Style = "Primary", Size = UDim2.new(1, 0, 0, 52), LayoutOrder = 10, Parent = scroll, OnClick = function()
		UIController.ClosePanel()
	end })
	AudioController.Play("Positive")
end

-- ===== City events =====
local function onCityEvent(event)
	if not event.Eligible then
		promptCard("City" .. event.EventId, event.Icon .. " " .. event.Title, event.Description .. "\n(You can't join this one right now.)", event.Seconds or 45, {
			{ Name = "CityOk", Text = "OK", Style = "Secondary" },
		})
		return
	end
	promptCard("City" .. event.EventId, event.Icon .. " " .. event.Title, event.Description, event.Seconds or 45, {
		{ Name = "CityJoin", Text = event.JoinText, Width = 220, OnClick = function()
			local ok, result = Net.Invoke("CityEventRespond", event.EventId, true)
			if ok and result.Joined then
				local lines = changeLines(result)
				NotificationController.Notify({ Title = event.Icon .. " " .. event.Title, Text = result.Story .. (if #lines > 0 then "  " .. table.concat(lines, "  ") else ""), Kind = "Success", Duration = 6 })
			elseif not ok then
				NotificationController.Notify({ Title = "Couldn't join", Text = PartyController.ErrorText(result), Kind = "Warning" })
			end
		end },
		{ Name = "CitySkip", Text = event.SkipText, Width = 220, OnClick = function()
			Net.Invoke("CityEventRespond", event.EventId, false)
		end },
	})
end

local function onCitySummary(summary)
	if summary.Invited and summary.Invited > 1 then
		NotificationController.Notify({ Title = summary.Icon .. " " .. summary.Title, Text = ("%d of %d people in this server joined in."):format(summary.Joined, summary.Invited), Kind = "Info", Duration = 4 })
	end
end

-- ===== Lifecycle =====
function PartyController.Init()
	promptStack = Create("Frame", {
		Name = "Prompts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.fromOffset(math.min(460, UIController.GetVirtualSize().X - 24), 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 45,
		Parent = UIController.GetOverlay(),
	})
	Create.List(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center).Parent = promptStack
	UIController.LayoutChanged:Connect(function()
		promptStack.Size = UDim2.fromOffset(math.min(460, UIController.GetVirtualSize().X - 24), 0)
	end)
end

function PartyController.Start()
	Net.OnEvent("PartyUpdate", setState)
	Net.OnEvent("PartyInviteReceived", onInvite)
	Net.OnEvent("GroupEvent", onGroupEvent)
	Net.OnEvent("GroupVote", onGroupVote)
	Net.OnEvent("GroupEventResult", onGroupResult)
	Net.OnEvent("GroupReveal", function(payload)
		task.spawn(RevealController.PlayGroup, payload)
	end)
	Net.OnEvent("CityEvent", onCityEvent)
	Net.OnEvent("CityEventSummary", onCitySummary)
	local ok, current = Net.Invoke("GetPartyState")
	if ok then
		setState(current)
	end
end

return PartyController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="78">
            <Properties>
              <string name="Name">PeopleController</string>
              <string name="Source"><![CDATA[--[[
	PeopleController  (StarterPlayerScripts.Client.Controllers.PeopleController)
	The 👥 People panel: everyone in your life with their bond, plus actions.
	You get People.ActionsPerTurn actions between decisions:
	  Spend time · Give a gift · Talk   (per person)
	  Meet new friends · Look for love  (age 18+, when single)
	The server validates and applies every action (LifeService → Lib/Actions).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local People = require(Shared.Util.People)
local Format = require(Shared.Util.Format)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Components = require(UILib.Components)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local HUDController = require(script.Parent.HUDController)
local NotificationController = require(script.Parent.NotificationController)
local DecisionController = require(script.Parent.DecisionController)

local PeopleController = {}
PeopleController.Priority = 42

local ROLE_ORDER = { "Partner", "Child", "Parent", "Sibling", "BestFriend", "Friend", "Ex" }
local ERRORS = {
	NoActionsLeft = "No actions left. Make your next decision to get more time.",
	NotEnoughMoney = "You can't afford a gift right now.",
	TooManyFriends = "You already have plenty of friends.",
	TooYoung = "You're too young for that.",
	AlreadyTaken = "You're already in a relationship.",
	RateLimited = "Slow down a moment.",
}

local handle = nil
local busy = false

function PeopleController.ActionsLeft(life): number
	if life.ActionTurn ~= #life.Decisions then
		return People.ActionsPerTurn
	end
	return math.max(0, People.ActionsPerTurn - life.ActionsUsed)
end

local function bondWord(bond: number): string
	if bond >= 85 then
		return "Inseparable"
	elseif bond >= 65 then
		return "Close"
	elseif bond >= 45 then
		return "Good"
	elseif bond >= 25 then
		return "Distant"
	end
	return "Strained"
end

local function bondColor(bond: number): Color3
	if bond >= 65 then
		return Theme.Color.Positive
	elseif bond >= 35 then
		return Theme.Color.Warning
	end
	return Theme.Color.Negative
end

local render

local function act(remote: string, ...)
	if busy then
		return
	end
	busy = true
	local ok, result = Net.Invoke(remote, ...)
	busy = false
	if ok then
		local lines = { result.Text }
		for _, change in ipairs(result.BondChanges or {}) do
			table.insert(lines, ("%s %s"):format(change.Name, Format.Signed(change.Delta)))
		end
		NotificationController.Notify({ Title = "👥 People", Text = table.concat(lines, "  ·  "), Kind = "Success", Duration = 3 })
		DecisionController.Refresh()
	else
		NotificationController.Notify({ Title = "Not now", Text = ERRORS[result] or tostring(result), Kind = "Warning", Duration = 3 })
	end
	task.wait(0.25) -- let the data snapshot arrive
	if handle and handle.IsOpen() then
		render()
	end
end

local function personRow(parent, life, person, order: number, narrow: boolean, canAct: boolean)
	local role = People.Roles[person.Role]
	local height = if narrow then 128 else 76
	local row = Create("Frame", { Name = person.Id, BackgroundColor3 = Theme.Color.SurfaceHigh, BackgroundTransparency = 0.2, Size = UDim2.new(1, 0, 0, height), LayoutOrder = order, Parent = parent }, { Create.Corner(Theme.RadiusSmall), Create.Padding(10, 14) })
	local subtitle = role.Label
	local age = People.AgeOf(life, person)
	if age then
		subtitle ..= (" · age %d"):format(age)
	end
	if person.Married then
		subtitle = "Spouse"
	end
	subtitle ..= " · " .. bondWord(person.Bond)
	Create.Label({ Name = "Name", Text = role.Icon .. "  " .. person.Name, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.Body, Size = UDim2.new(0, 260, 0, 24), TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = row })
	Create.Label({ Name = "Sub", Text = subtitle, TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.Tiny, Size = UDim2.new(0, 260, 0, 18), Position = UDim2.fromOffset(0, 24), TextWrapped = false, Parent = row })
	local track = Create("Frame", { Name = "Bond", BackgroundColor3 = Theme.Color.Background, Size = UDim2.fromOffset(240, 8), Position = UDim2.fromOffset(0, 46), Parent = row }, { Create.Corner(Theme.RadiusPill) })
	Create("Frame", { Name = "Fill", BackgroundColor3 = bondColor(person.Bond), Size = UDim2.fromScale(person.Bond / 100, 1), Parent = track }, { Create.Corner(Theme.RadiusPill) })

	local buttons = Create("Frame", {
		Name = "Actions",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(if narrow then 0 else 330, 46),
		AutomaticSize = if narrow then Enum.AutomaticSize.X else Enum.AutomaticSize.None,
		AnchorPoint = if narrow then Vector2.new(0, 1) else Vector2.new(1, 0.5),
		Position = if narrow then UDim2.fromScale(0, 1) else UDim2.fromScale(1, 0.5),
		Parent = row,
	})
	Create.List(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center).Parent = buttons
	local options = if person.Role == "Ex" then { { "Talk", "💬 Talk" } } else { { "Time", "⏰ Time" }, { "Gift", "🎁 " .. Format.Money(People.GiftCost(life)) }, { "Talk", "💬 Talk" } }
	for i, option in ipairs(options) do
		local button = Components.Button({ Name = option[1], Text = option[2], Style = "Secondary", Size = UDim2.fromOffset(104, 44), TextSize = 17, LayoutOrder = i, Parent = buttons, OnClick = function()
			act("Interact", person.Id, option[1])
		end })
		if not canAct then
			Components.SetDisabled(button, true)
		end
	end
end

function render()
	local life = DataController.GetActiveLife()
	if not handle or not life then
		return
	end
	handle.Clear()
	local narrow = UIController.IsNarrow()
	local left = PeopleController.ActionsLeft(life)
	handle.Subtitle.Text = ("%d action%s left before your next decision"):format(left, if left == 1 then "" else "s")
	local scroll = handle.Scroll

	local top = Create("Frame", { Name = "Meet", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 50), LayoutOrder = 0, Parent = scroll })
	Create.List(Enum.FillDirection.Horizontal, 10).Parent = top
	local meet = Components.Button({ Name = "MeetFriends", Text = "Meet new friends", Icon = "🙂", Style = "Accent", Size = UDim2.fromOffset(if narrow then 200 else 240, 48), TextSize = 18, LayoutOrder = 1, Parent = top, OnClick = function()
		act("MeetPeople", "Friend")
	end })
	if left <= 0 then
		Components.SetDisabled(meet, true)
	end
	if life.Age >= 18 and not life.Relationships.Partner then
		local love = Components.Button({ Name = "LookForLove", Text = "Look for love", Icon = "💘", Style = "Primary", Size = UDim2.fromOffset(if narrow then 180 else 220, 48), TextSize = 18, LayoutOrder = 2, Parent = top, OnClick = function()
			act("MeetPeople", "Love")
		end })
		if left <= 0 then
			Components.SetDisabled(love, true)
		end
	end

	local order = 1
	for _, role in ipairs(ROLE_ORDER) do
		for _, person in ipairs(People.ByRole(life, role)) do
			order += 1
			personRow(scroll, life, person, order, narrow, left > 0)
		end
	end
	if #life.People == 0 then
		Create.Label({ Text = "Nobody yet. Go out and meet people!", TextColor3 = Theme.Color.TextDim, LayoutOrder = 2, Parent = scroll })
	end
	Create.Label({
		Text = "💡 Bonds fade over time unless you make time for people. Strong bonds make you happier; very weak ones can end relationships.",
		TextSize = Theme.TextSize.Tiny,
		TextColor3 = Theme.Color.TextFaint,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 999,
		Parent = scroll,
	})
end

function PeopleController.Open()
	local life = DataController.GetActiveLife()
	if not life then
		return
	end
	handle = UIController.OpenPanel({ Name = "PeopleModal", Title = "👥  People in " .. life.Name .. "'s Life", Width = 860, OnClose = function()
		handle = nil
	end })
	render()
end

function PeopleController.Init()
	HUDController.AddAction({ Id = "People", Icon = "👥", Order = 10, OnClick = PeopleController.Open })
end

function PeopleController.Start()
	DataController.Changed:Connect(function()
		if handle and handle.IsOpen() and not busy then
			render()
		end
	end)
end

return PeopleController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="79">
            <Properties>
              <string name="Name">RevealController</string>
              <string name="Source"><![CDATA[--[[
	RevealController  (StarterPlayerScripts.Client.Controllers.RevealController)
	The cinematic LIFE REVEAL sequences (data comes from the server: Lib/Reveal).

	RevealController.PlayStage(reveal)          -- yields until the player continues
	RevealController.PlayFinal(entry, options)  -- yields; returns "Again" | "History" | "Menu"

	Built entirely from UI (the 3D world arrives in Phase 8): title cards with
	light rays, counting probability bars with trend arrows, typewriter
	predictions, a TWIST sequence, and an animated preview scene for the
	predicted future (Luxury, Family, Fame, Career, Genius, Health, Hero,
	Content, Adventure, Difficult, Lonely) with a slow "camera" push-in.
	Tap to speed up a step; Skip jumps to the end card. Respects Reduce animations.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Futures = require(Shared.Util.Futures)
local Format = require(Shared.Util.Format)
local LifeStages = require(Shared.Data.LifeStages)
local StatDefinitions = require(Shared.Data.StatDefinitions)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Anim = require(UILib.Anim)
local Components = require(UILib.Components)

local UIController = require(script.Parent.UIController)
local AudioController = require(script.Parent.AudioController)

local RevealController = {}
RevealController.Priority = 46

local gui: ScreenGui
local root: Frame
local uiScale: UIScale
local playing = false
local session = { Fast = false, Skip = false }

-- ===== Layout =====
-- Full-screen size in pixels. A disabled ScreenGui may not report its size
-- yet, so fall back to the camera's viewport.
local function screenSize(): Vector2
	local absolute = gui.AbsoluteSize
	if (not absolute or absolute.X < 2) and workspace and workspace.CurrentCamera then
		absolute = workspace.CurrentCamera.ViewportSize
	end
	return absolute
end

local function layout()
	local scale = UIController.GetScale()
	uiScale.Scale = scale
	local absolute = screenSize()
	root.Size = UDim2.fromOffset(math.floor(absolute.X / scale), math.floor(absolute.Y / scale))
end

local function size(): Vector2
	local absolute = screenSize()
	local scale = UIController.GetScale()
	return Vector2.new(absolute.X / scale, absolute.Y / scale)
end

-- ===== Sequencing =====
local function pause(seconds: number)
	if Anim.Reduced then
		seconds *= 0.5
	end
	local elapsed = 0
	while elapsed < seconds and not session.Fast and not session.Skip do
		elapsed += task.wait()
	end
end

local function newStep(): Frame
	session.Fast = false
	Create.Clear(root:FindFirstChild("Stage") :: Frame)
	return root:FindFirstChild("Stage") :: Frame
end

local function label(parent, props)
	local defaults = { TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), Parent = parent }
	for k, v in pairs(props) do
		defaults[k] = v
	end
	return Create.Label(defaults)
end

local function column(parent, width: number)
	local frame = Create("Frame", {
		Name = "Column",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(width, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Parent = parent,
	})
	Create.List(Enum.FillDirection.Vertical, 14, Enum.HorizontalAlignment.Center).Parent = frame
	return frame
end

local function typewrite(textLabel: TextLabel, cps: number?)
	if Anim.Reduced then
		return
	end
	local total = utf8.len(textLabel.Text) or #textLabel.Text
	textLabel.MaxVisibleGraphemes = 0
	local shown = 0
	while shown < total and not session.Fast and not session.Skip do
		shown += math.max(1, math.floor((cps or 45) / 30))
		textLabel.MaxVisibleGraphemes = shown
		task.wait(1 / 30)
	end
	textLabel.MaxVisibleGraphemes = -1
end

-- Rotating light rays behind a title.
local function lightRays(parent, color: Color3)
	local s = size()
	local d = math.max(s.X, s.Y) * 1.6
	local rays = Create("Frame", {
		Name = "Rays",
		BackgroundColor3 = color,
		BackgroundTransparency = 0,
		Size = UDim2.fromOffset(d, d),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = 0,
		Parent = parent,
	}, { Create.Corner(Theme.RadiusPill) })
	local keypoints = {}
	for i = 0, 12 do
		table.insert(keypoints, NumberSequenceKeypoint.new(i / 12, if i % 2 == 0 then 0.82 else 1))
	end
	local gradient = Create("UIGradient", { Transparency = NumberSequence.new(keypoints), Parent = rays })
	Anim.Loop(gradient, { Rotation = 90 }, 10)
	return rays
end

local function flash(color: Color3?)
	if Anim.Reduced then
		return
	end
	local f = Create("Frame", { Name = "Flash", BackgroundColor3 = color or Theme.Color.White, BackgroundTransparency = 0.1, Size = UDim2.fromScale(1, 1), ZIndex = 20, Parent = root })
	Anim.Tween(f, { BackgroundTransparency = 1 }, 0.6)
	task.delay(0.7, function()
		f:Destroy()
	end)
end

local function skipButton()
	local button = Components.Button({
		Name = "RevealSkip",
		Text = "Skip ▶▶",
		Style = "Ghost",
		Size = UDim2.fromOffset(130, 46),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 16),
		TextSize = 18,
		Parent = root,
		OnClick = function()
			session.Skip = true
		end,
	})
	button.ZIndex = 30
	return button
end

-- ===== Probability bars =====
local function futureBar(parent, entry, previous: number?, order: number, width: number)
	local info = Futures.Info[entry.Id]
	local row = Create("Frame", { Name = entry.Id, BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 46), LayoutOrder = order, Parent = parent })
	Create.Label({ Text = info.Icon .. "  " .. info.Title, FontFace = Theme.Font.Bold, TextSize = Theme.TextSize.Body, Size = UDim2.new(0.6, 0, 0, 24), TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
	local pctLabel = Create.Label({ Name = "Pct", Text = "0%", FontFace = Theme.Font.Heavy, TextSize = 24, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(0.4, 0, 0, 24), Position = UDim2.fromScale(0.6, 0), TextWrapped = false, Parent = row })
	local track = Create("Frame", { BackgroundColor3 = Theme.Color.Background, BackgroundTransparency = 0.2, Size = UDim2.new(1, 0, 0, 12), Position = UDim2.fromOffset(0, 30), Parent = row }, { Create.Corner(Theme.RadiusPill) })
	local color = if info.Positive then (if entry.Pct >= 60 then Theme.Color.Positive elseif entry.Pct >= 35 then Theme.Color.Warning else Theme.Color.Accent) else Theme.Color.Negative
	local fill = Create("Frame", { BackgroundColor3 = color, Size = UDim2.fromScale((previous or 0) / 100, 1), Parent = track }, { Create.Corner(Theme.RadiusPill) })
	local trend = ""
	if previous then
		local diff = entry.Pct - previous
		if math.abs(diff) >= 3 then
			trend = ("  <font color=\"%s\">%s%d</font>"):format(if (diff > 0) == info.Positive then Theme.Hex.Positive else Theme.Hex.Negative, if diff > 0 then "▲" else "▼", math.abs(diff))
		end
	end
	pctLabel.RichText = true
	return function(duration: number)
		Anim.Tween(fill, { Size = UDim2.fromScale(entry.Pct / 100, 1) }, duration)
		task.spawn(function()
			local start = previous or 0
			local steps = math.max(1, math.floor(duration * 30))
			for i = 1, steps do
				if session.Fast or session.Skip then
					break
				end
				pctLabel.Text = tostring(math.floor(start + (entry.Pct - start) * i / steps + 0.5)) .. "%"
				task.wait(duration / steps)
			end
			pctLabel.Text = entry.Pct .. "%" .. trend
		end)
	end
end

local function chosenFutures(predictions)
	local positives, risks = Futures.Sorted(predictions)
	local list = {}
	for i = 1, math.min(4, #positives) do
		table.insert(list, positives[i])
	end
	if risks[1] and risks[1].Pct >= 25 then
		table.insert(list, risks[1])
	end
	return list
end

local function barsStep(title: string, predictions, previous, subtitle: string?)
	local step = newStep()
	local width = math.min(640, size().X - 40)
	local col = column(step, width)
	label(col, { Text = title, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, LayoutOrder = 1 })
	if subtitle then
		label(col, { Text = subtitle, TextColor3 = Theme.Color.TextDim, LayoutOrder = 2 })
	end
	local starters = {}
	for i, entry in ipairs(chosenFutures(predictions)) do
		table.insert(starters, futureBar(col, entry, previous and previous[entry.Id], 10 + i, width))
	end
	for _, start in ipairs(starters) do
		start(0.7)
		AudioController.Play("Select")
		pause(0.35)
	end
	pause(1.4)
end

-- ===== Cinematic preview scenes =====
local SCENES = {
	Luxury = { Sky = { Color3.fromRGB(60, 30, 90), Color3.fromRGB(255, 190, 90) }, Hero = "🏰", Props = { "🏎️", "💎", "🛥️" }, Sparkle = "✨", Caption = "A mansion on the hill. Cars in the drive. A life of luxury." },
	Family = { Sky = { Color3.fromRGB(255, 160, 120), Color3.fromRGB(255, 220, 160) }, Hero = "🏡", Props = { "👨‍👩‍👧‍👦", "🐶", "🌳" }, Sparkle = "💛", Caption = "A house full of laughter, and the people you love most." },
	Fame = { Sky = { Color3.fromRGB(20, 10, 40), Color3.fromRGB(120, 40, 160) }, Hero = "🎤", Props = { "📸", "👏", "🌟" }, Sparkle = "🌟", Caption = "Bright lights. Screaming fans. Your name in lights." },
	Career = { Sky = { Color3.fromRGB(20, 40, 90), Color3.fromRGB(100, 160, 255) }, Hero = "🏙️", Props = { "💼", "📈", "🏆" }, Sparkle = "⭐", Caption = "The corner office. The top of your field." },
	Genius = { Sky = { Color3.fromRGB(10, 20, 60), Color3.fromRGB(60, 90, 200) }, Hero = "🔬", Props = { "💡", "📚", "🧠" }, Sparkle = "✦", Caption = "Discoveries, inventions, ideas that change the world." },
	Health = { Sky = { Color3.fromRGB(120, 200, 255), Color3.fromRGB(255, 230, 160) }, Hero = "🏃", Props = { "🌅", "🥗", "🚴" }, Sparkle = "☀️", Caption = "Strong, energetic and still running marathons at 80." },
	Hero = { Sky = { Color3.fromRGB(40, 30, 80), Color3.fromRGB(255, 200, 120) }, Hero = "🏅", Props = { "🤝", "🏛️", "🕊️" }, Sparkle = "✨", Caption = "Respected. Trusted. The person everyone turns to." },
	Content = { Sky = { Color3.fromRGB(255, 190, 220), Color3.fromRGB(190, 220, 255) }, Hero = "😊", Props = { "🌈", "🌻", "☕" }, Sparkle = "💫", Caption = "Not perfect, but genuinely, deeply happy." },
	Adventure = { Sky = { Color3.fromRGB(40, 120, 200), Color3.fromRGB(120, 220, 200) }, Hero = "🌍", Props = { "✈️", "⛰️", "🧭" }, Sparkle = "✦", Caption = "Mountains, oceans, a passport full of stamps." },
	Difficult = { Sky = { Color3.fromRGB(40, 45, 60), Color3.fromRGB(90, 95, 110) }, Hero = "🏚️", Props = { "🌧️", "🧾", "☂️" }, Sparkle = "💧", Caption = "Hard times could be ahead… but it's not too late to change course." },
	Lonely = { Sky = { Color3.fromRGB(20, 25, 50), Color3.fromRGB(60, 70, 110) }, Hero = "🪑", Props = { "🌙", "🕯️", "📞" }, Sparkle = "✦", Caption = "A quiet house… but people are waiting to know you." },
}

local function sceneStep(archetype: string)
	local scene = SCENES[archetype] or SCENES.Content
	local step = newStep()
	local s = size()
	local frame = Create("CanvasGroup", { Name = "Scene", BackgroundColor3 = Theme.Color.White, Size = UDim2.fromScale(1, 1), Parent = step }, {
		Create.Gradient(ColorSequence.new(scene.Sky[1], scene.Sky[2]), 90),
	})
	local camera = Anim.Scale(frame)
	camera.Scale = 1
	Anim.Tween(camera, { Scale = 1.12 }, 6, Enum.EasingStyle.Sine)
	local heroSize = math.min(s.X, s.Y) * 0.36
	local hero = Create.Label({ Text = scene.Hero, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(heroSize, heroSize), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.48), Parent = frame })
	Anim.Pop(hero, 0.5, 0.8)
	for i, prop in ipairs(scene.Props) do
		local x = ({ 0.2, 0.8, 0.35 })[i]
		local y = ({ 0.68, 0.66, 0.78 })[i]
		local p = Create.Label({ Text = prop, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(heroSize * 0.38, heroSize * 0.38), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x - (if i == 1 then 0.25 else 0), y), Parent = frame })
		Anim.Tween(p, { Position = UDim2.fromScale(x, y) }, 1.6 + i * 0.4, Enum.EasingStyle.Quad)
		Anim.Loop(p, { Rotation = 4 }, 1.2 + i * 0.3)
	end
	local rng = Random.new(#archetype)
	for i = 1, 10 do
		local sparkle = Create.Label({ Name = "Sparkle" .. i, Text = scene.Sparkle, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center, TextTransparency = 0.2, Size = UDim2.fromOffset(28, 28), Position = UDim2.fromScale(rng:NextNumber(0.05, 0.95), rng:NextNumber(0.05, 0.55)), Parent = frame })
		Anim.Loop(sparkle, { TextTransparency = 0.9 }, rng:NextNumber(0.6, 1.4))
	end
	if archetype == "Fame" then
		task.spawn(function()
			for _ = 1, 3 do
				pause(0.6)
				flash()
			end
		end)
	end
	local caption = Create.Label({
		Text = scene.Caption,
		FontFace = Theme.Font.Bold,
		TextSize = Theme.TextSize.H3,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -30),
		Size = UDim2.new(0.9, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Color.Black,
		BackgroundTransparency = 0.45,
		Parent = frame,
	})
	Create.Corner(Theme.RadiusSmall).Parent = caption
	Create.Padding(10, 16).Parent = caption
	label(step, { Text = "A GLIMPSE OF ONE POSSIBLE FUTURE…", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.White, Position = UDim2.fromOffset(0, 24), ZIndex = 5 })
	typewrite(caption, 40)
	pause(2.6)
end

-- ===== End card =====
local function endCard(title: string, body: string, buttons)
	session.Skip = false
	local step = newStep()
	lightRays(step, Theme.Color.AccentAlt)
	local width = math.min(620, size().X - 40)
	local col = column(step, width)
	label(col, { Text = title, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, LayoutOrder = 1 })
	label(col, { Text = body, TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.H3, LayoutOrder = 2 })
	local row = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = col })
	local list = Create.List(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center)
	list.Wraps = true
	list.Parent = row
	local result = nil
	local first
	for i, b in ipairs(buttons) do
		local button = Components.Button({ Name = b.Name, Text = b.Text, Icon = b.Icon, Style = b.Style or "Primary", Size = UDim2.fromOffset(b.Width or 260, 58), LayoutOrder = i, Parent = row, OnClick = function()
			result = b.Result
		end })
		first = first or button
	end
	Anim.Pop(col, 0.9)
	UIController.Focus(first)
	while result == nil do
		task.wait()
	end
	return result
end

-- ===== Session control =====
local function begin()
	playing = true
	session.Fast = false
	session.Skip = false
	gui.Enabled = true
	Create.Clear(root) -- keeps the UIScale
	Create("Frame", { Name = "Backdrop", BackgroundColor3 = Theme.Color.White, Size = UDim2.fromScale(1, 1), Parent = root }, {
		Create.Gradient(ColorSequence.new(Color3.fromRGB(8, 6, 20), Color3.fromRGB(40, 16, 70)), 120),
	})
	local stage = Create("Frame", { Name = "Stage", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = root })
	-- Tap anywhere to speed up the current step.
	local tap = Create("TextButton", { Name = "Tap", Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Selectable = false, ZIndex = 1, Parent = root })
	tap.Activated:Connect(function()
		session.Fast = true
	end)
	stage.ZIndex = 2
	skipButton()
	layout()
end

local function finish()
	playing = false
	gui.Enabled = false
	Create.Clear(root)
end

function RevealController.IsPlaying(): boolean
	return playing
end

function RevealController.Skip()
	session.Skip = true
end

-- ===== Stage reveal =====
function RevealController.PlayStage(reveal)
	if playing then
		return
	end
	begin()
	AudioController.Play("StageComplete")

	-- 1. Title
	local step = newStep()
	lightRays(step, Theme.Color.Accent)
	local col = column(step, math.min(700, size().X - 40))
	local title = label(col, { Text = "🔮  LIFE REVEAL", FontFace = Theme.Font.Heavy, TextSize = 64, LayoutOrder = 1 })
	Create.Gradient(Theme.Gradient.Title).Parent = title
	label(col, { Text = ("%s is over. You are %d."):format(reveal.StageName, reveal.Age), TextSize = Theme.TextSize.H3, TextColor3 = Theme.Color.TextDim, LayoutOrder = 2 })
	Anim.Pop(title, 0.6, 0.9)
	pause(1.8)

	-- 2. Who you became
	if not session.Skip and reveal.Became and #reveal.Became > 0 then
		local s2 = newStep()
		local c2 = column(s2, math.min(640, size().X - 40))
		label(c2, { Text = "Who you became", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, LayoutOrder = 1 })
		for i, line in ipairs(reveal.Became) do
			local chip = Components.Chip({ Text = line, Height = 44, TextSize = Theme.TextSize.Body, LayoutOrder = 1 + i, Parent = c2 })
			Anim.Pop(chip, 0.6, 0.35 + i * 0.08)
		end
		pause(1.8)
	end

	-- 3. Futures
	if not session.Skip then
		barsStep("Your possible futures", if reveal.Twist then reveal.Twist.Before else reveal.Predictions, reveal.Previous, "Based on everything you've done so far")
	end

	-- 4. Headline
	if not session.Skip then
		local s4 = newStep()
		lightRays(s4, Theme.Color.Primary)
		local c4 = column(s4, math.min(720, size().X - 40))
		local h = label(c4, { Text = if reveal.Twist then Futures.Headline(reveal.Twist.Before) else reveal.Headline, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, LayoutOrder = 1 })
		typewrite(h, 50)
		local warning = if reveal.Twist then select(2, Futures.Headline(reveal.Twist.Before)) else reveal.Warning
		if warning then
			label(c4, { Text = "⚠️ " .. warning, TextColor3 = Theme.Color.Warning, TextSize = Theme.TextSize.H3, LayoutOrder = 2 })
		end
		pause(2)
	end

	-- 5. Twist
	if not session.Skip and reveal.Twist then
		local twist = reveal.Twist
		flash()
		AudioController.Play("Negative")
		local s5 = newStep()
		local c5 = column(s5, math.min(680, size().X - 40))
		local but = label(c5, { Text = "⚡ BUT THEN…", FontFace = Theme.Font.Heavy, TextSize = 56, TextColor3 = Theme.Color.Gold, LayoutOrder = 1 })
		Anim.Shake(but)
		label(c5, { Text = twist.Icon, TextSize = 72, LayoutOrder = 2 })
		label(c5, { Text = twist.Title, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, LayoutOrder = 3 })
		local story = label(c5, { Text = twist.Story, TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.H3, LayoutOrder = 4 })
		typewrite(story, 45)
		local changes = {}
		for _, text in ipairs(twist.LifeChanges or {}) do
			table.insert(changes, text)
		end
		for stat, delta in pairs(twist.Applied or {}) do
			local info = StatDefinitions.Info[stat]
			if info and math.abs(delta) >= 0.5 then
				table.insert(changes, info.Icon .. " " .. Format.Signed(delta))
			end
		end
		if twist.MoneyDelta and twist.MoneyDelta ~= 0 then
			table.insert(changes, "💰 " .. (if twist.MoneyDelta > 0 then "+" else "") .. Format.Money(twist.MoneyDelta))
		end
		if #changes > 0 then
			label(c5, { Text = table.concat(changes, "   "), FontFace = Theme.Font.Bold, TextColor3 = Theme.Color.Gold, LayoutOrder = 5 })
		end
		pause(2.6)
		if not session.Skip then
			barsStep("The odds have changed", reveal.Predictions, twist.Before, "One moment can change everything")
		end
	end

	-- 6. Cinematic preview
	if not session.Skip then
		sceneStep(reveal.Archetype)
	end

	-- 7. End card
	endCard(
		if reveal.Twist then reveal.Headline else "The future is never decided.",
		"Every choice can still change it." .. (if reveal.NextStageName then ("\n%s begins now."):format(reveal.NextStageName) else ""),
		{ { Name = "RevealContinue", Text = if reveal.NextStageName then "Continue to " .. reveal.NextStageName else "Continue", Icon = "▶", Result = "Continue", Width = 340 } }
	)
	finish()
end

-- ===== Final reveal =====
local function section(parent, title: string, lines, order: number)
	if not lines or #lines == 0 then
		return
	end
	label(parent, { Text = title, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.Primary, LayoutOrder = order })
	for i, line in ipairs(lines) do
		local l = label(parent, { Text = line, TextSize = Theme.TextSize.Body, LayoutOrder = order + i })
		Anim.Pop(l, 0.8, 0.25 + i * 0.05)
	end
end

function RevealController.PlayFinal(entry, options)
	options = options or {}
	if playing then
		return "Menu"
	end
	begin()
	local width = math.min(720, size().X - 40)

	-- 1. Title
	local step = newStep()
	lightRays(step, Theme.Color.Gold)
	local col = column(step, width)
	label(col, { Text = "THE LIFE OF", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H3, TextColor3 = Theme.Color.TextDim, LayoutOrder = 1 })
	local name = label(col, { Text = string.upper(entry.Name), FontFace = Theme.Font.Heavy, TextSize = 72, LayoutOrder = 2 })
	Create.Gradient(Theme.Gradient.Title).Parent = name
	label(col, { Text = ("Age 5 → %d · %d decisions"):format(entry.Age, entry.DecisionCount or 0), TextColor3 = Theme.Color.TextDim, LayoutOrder = 3 })
	Anim.Pop(name, 0.6, 0.9)
	pause(2)

	-- 2. Key decisions montage
	if not session.Skip and #entry.KeyDecisions > 0 then
		local s2 = newStep()
		local c2 = column(s2, width)
		label(c2, { Text = "The choices that shaped you", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, LayoutOrder = 1 })
		for i, d in ipairs(entry.KeyDecisions) do
			if session.Skip then
				break
			end
			local stage = LifeStages.ForAge(d.Age)
			local card = Components.Panel({ Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, Padding = 12, LayoutOrder = 1 + i, Parent = c2, Color = Theme.Color.SurfaceHigh })
			Create.Label({ Text = ("<font color=\"%s\">AGE %d · %s</font>   %s"):format(Theme.Hex.Gold, d.Age, string.upper(stage.DisplayName), d.Title), RichText = true, TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.Y, Parent = card })
			Create.Label({ Text = "“" .. d.Choice .. "”", FontFace = Theme.Font.Bold, Position = UDim2.fromOffset(0, 24), AutomaticSize = Enum.AutomaticSize.Y, Parent = card })
			Anim.Pop(card, 0.7, 0.35)
			pause(0.8)
		end
		pause(1.2)
	end

	-- 3. Family & relationships
	if not session.Skip then
		local s3 = newStep()
		local c3 = column(s3, width)
		label(c3, { Text = "The people in your life", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, LayoutOrder = 1 })
		local lines = {}
		if entry.Partner then
			table.insert(lines, (if entry.Partner.Married then "💍 Married to " else "❤️ Together with ") .. entry.Partner.Name)
		else
			table.insert(lines, "🕊️ Single at the end")
		end
		if #entry.Children > 0 then
			table.insert(lines, "👶 Children: " .. table.concat(entry.Children, ", "))
		end
		if entry.BestFriend then
			table.insert(lines, "🫶 Best friend: " .. entry.BestFriend)
		end
		for i, line in ipairs(lines) do
			local l = label(c3, { Text = line, TextSize = Theme.TextSize.H3, LayoutOrder = 1 + i })
			Anim.Pop(l, 0.7, 0.3 + i * 0.1)
		end
		pause(2)
	end

	-- 4. Wealth & career
	if not session.Skip then
		local s4 = newStep()
		local c4 = column(s4, width)
		label(c4, { Text = "What you built", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, LayoutOrder = 1 })
		local worth = label(c4, { Text = "$0", FontFace = Theme.Font.Heavy, TextSize = 64, TextColor3 = Theme.Color.Gold, LayoutOrder = 2 })
		label(c4, { Text = "net worth", TextColor3 = Theme.Color.TextDim, LayoutOrder = 3 })
		label(c4, { Text = "💼 " .. entry.Career .. "   ·   🎓 " .. entry.Education, TextSize = Theme.TextSize.H3, LayoutOrder = 4 })
		local steps = 40
		for i = 1, steps do
			if session.Fast or session.Skip then
				break
			end
			worth.Text = Format.Money(entry.NetWorth * (i / steps) ^ 2)
			task.wait(1 / 30)
		end
		worth.Text = Format.Money(entry.NetWorth)
		pause(1.6)
	end

	-- 5. Achievements, moments, mistakes
	if not session.Skip then
		local s5 = newStep()
		local scroll = Create("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4, Selectable = false, Parent = s5 })
		Create.List(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center).Parent = scroll
		Create.Padding(80, 20, 40, 20).Parent = scroll
		local c5 = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = scroll })
		Create.List(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center).Parent = c5
		section(c5, "🏆 ACHIEVEMENTS", entry.Achievements, 10)
		section(c5, "✨ GREATEST MOMENTS", entry.Moments, 40)
		section(c5, "💭 BIGGEST REGRETS", entry.Mistakes, 70)
		if #entry.Achievements + #entry.Moments + #entry.Mistakes == 0 then
			label(c5, { Text = "A simple life, lived your way.", TextSize = Theme.TextSize.H3, LayoutOrder = 1 })
		end
		pause(3.2)
	end

	-- 6. Predictions vs reality
	if not session.Skip and #entry.Journey > 0 then
		local s6 = newStep()
		local c6 = column(s6, width)
		label(c6, { Text = "What we predicted… and what came true", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H2, LayoutOrder = 1 })
		local came = {}
		for _, id in ipairs(entry.CameTrue) do
			came[id] = true
		end
		local first = entry.Journey[math.min(2, #entry.Journey)]
		for i, top in ipairs(first.Top) do
			local info = Futures.Info[top.Id]
			label(c6, {
				Text = ("At %d: %s %s %d%% → %s"):format(first.Age, info.Icon, info.Title, top.Pct, if came[top.Id] then "✅ it came true" else "❌ it didn't"),
				RichText = false,
				TextSize = Theme.TextSize.Body,
				LayoutOrder = 1 + i,
			})
		end
		local trueList = {}
		for _, id in ipairs(entry.CameTrue) do
			if Futures.Info[id].Positive then
				table.insert(trueList, Futures.Info[id].Icon .. " " .. Futures.Info[id].Title)
			end
		end
		label(c6, { Text = if #trueList > 0 then "Your life became: " .. table.concat(trueList, " · ") else "Your life took its own unpredictable path.", FontFace = Theme.Font.Bold, TextColor3 = Theme.Color.Gold, LayoutOrder = 10 })
		pause(3)
	end

	-- 7. Ending title
	if not session.Skip then
		local s7 = newStep()
		local c7 = column(s7, width)
		label(c7, { Text = "Your life will be remembered as…", TextSize = Theme.TextSize.H3, TextColor3 = Theme.Color.TextDim, LayoutOrder = 1 })
		pause(1.4)
	end
	local s8 = newStep()
	lightRays(s8, Theme.Color.Gold)
	flash(Theme.Color.Gold)
	AudioController.Play("StageComplete")
	local c8 = column(s8, width)
	local icon = label(c8, { Text = entry.Ending.Icon, TextSize = 96, LayoutOrder = 1 })
	local endingTitle = label(c8, { Text = string.upper(entry.Ending.Title), FontFace = Theme.Font.Heavy, TextSize = 60, LayoutOrder = 2 })
	Create.Gradient(Theme.Gradient.Title).Parent = endingTitle
	label(c8, { Text = entry.Ending.Line, TextSize = Theme.TextSize.H3, TextColor3 = Theme.Color.TextDim, LayoutOrder = 3 })
	if not options.Replay then
		label(c8, { Text = ("🪙 +%d coins"):format(entry.Coins or 0), FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Gold, LayoutOrder = 4 })
	end
	Anim.Pop(icon, 0.3, 1)
	Anim.Pop(endingTitle, 0.6, 0.9)
	pause(2.5)

	local result = endCard("What if you had chosen differently?", "Every life is a different story. Would yours have turned out better?", {
		{ Name = "RevealAgain", Text = "Live Again", Icon = "✨", Result = "Again", Width = 230 },
		{ Name = "RevealHistory", Text = "Life History", Icon = "📜", Style = "Accent", Result = "History", Width = 230 },
		{ Name = "RevealMenu", Text = if options.Replay then "Close" else "Main Menu", Style = "Secondary", Result = "Menu", Width = 200 },
	})
	finish()
	return result
end

-- ===== Group Life Reveal (a Life Circle watches together) =====
function RevealController.PlayGroup(payload)
	-- If another reveal is showing (e.g. your own stage reveal), wait for it.
	local waited = 0
	while playing and waited < 90 do
		waited += task.wait(0.25)
	end
	if playing then
		return
	end
	begin()
	local width = math.min(700, size().X - 40)

	local step = newStep()
	lightRays(step, Theme.Color.AccentAlt)
	local col = column(step, width)
	local title = label(col, { Text = "👥  GROUP LIFE REVEAL", FontFace = Theme.Font.Heavy, TextSize = 56, LayoutOrder = 1 })
	Create.Gradient(Theme.Gradient.Title).Parent = title
	label(col, { Text = ("Started by %s · %d lives, %d possible futures"):format(payload.StartedBy, #payload.Cards, #payload.Cards), TextColor3 = Theme.Color.TextDim, LayoutOrder = 2 })
	Anim.Pop(title, 0.6, 0.9)
	pause(1.8)

	for _, entry in ipairs(payload.Cards) do
		if session.Skip then
			break
		end
		local s2 = newStep()
		local c2 = column(s2, width)
		label(c2, { Text = entry.DisplayName .. (if entry.IsYou then " (you)" else ""), FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, LayoutOrder = 1 })
		if entry.Hidden or not entry.Card then
			label(c2, { Text = if entry.NoLife then "Between lives right now." else "🔒 Keeps their future private.", TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.H3, LayoutOrder = 2 })
			pause(1.2)
		else
			local card = entry.Card
			label(c2, { Text = ("%s · age %d · %s · %s"):format(card.LifeName, card.Age, card.StageName, card.Career), TextColor3 = Theme.Color.TextDim, LayoutOrder = 2 })
			local starters = {}
			local positives = Futures.Sorted(card.Predictions)
			for i = 1, math.min(3, #positives) do
				table.insert(starters, futureBar(c2, positives[i], nil, 10 + i, width))
			end
			for _, start in ipairs(starters) do
				start(0.6)
				pause(0.25)
			end
			local headline = label(c2, { Text = card.Headline, FontFace = Theme.Font.Bold, TextColor3 = Theme.Color.Gold, LayoutOrder = 20 })
			typewrite(headline, 60)
			pause(1.6)
		end
	end

	if not session.Skip and #payload.Superlatives > 0 then
		local s3 = newStep()
		lightRays(s3, Theme.Color.Gold)
		local c3 = column(s3, width)
		label(c3, { Text = "MOST LIKELY TO…", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, LayoutOrder = 1 })
		for i = 1, math.min(6, #payload.Superlatives) do
			local s = payload.Superlatives[i]
			local info = Futures.Info[s.Id]
			local line = label(c3, { Text = ("%s %s: <b>%s</b> (%d%%)"):format(info.Icon, info.Title, s.DisplayName, s.Pct), RichText = true, TextSize = Theme.TextSize.H3, LayoutOrder = 1 + i })
			Anim.Pop(line, 0.7, 0.3)
			pause(0.5)
		end
		pause(2)
	end

	endCard("Same start. Different futures.", "Keep choosing. Every one of these futures can still change.", {
		{ Name = "RevealGroupClose", Text = "Close", Icon = "👍", Result = "Close", Width = 240 },
	})
	finish()
end

function RevealController.Init()
	gui = Create("ScreenGui", {
		Name = "CYL_Reveal",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ScreenInsets = Enum.ScreenInsets.None,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 60,
		Enabled = false,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	root = Create("Frame", { Name = "Root", BackgroundTransparency = 1, Parent = gui })
	uiScale = Instance.new("UIScale")
	uiScale.Parent = root
	layout()
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
	UIController.LayoutChanged:Connect(layout)
end

function RevealController.Start() end

return RevealController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="80">
            <Properties>
              <string name="Name">SettingsController</string>
              <string name="Source"><![CDATA[--[[
	SettingsController  (StarterPlayerScripts.Client.Controllers.SettingsController)
	Holds the player's settings + privacy choices on the client, applies them
	instantly (volume, UI scale, graphics, animations) and saves them to the
	server a moment after the last change (the server validates every value).

	SettingsController.Get(key)            SettingsController.Set(key, value)
	SettingsController.GetPrivacy(key)     SettingsController.SetPrivacy(key, value)
	SettingsController.Changed:Connect(fn(key, value))
	CameraSensitivity is read by the game's own camera systems (Life Reveal
	cinematics, house viewer). Roblox doesn't let games change the default
	camera's mouse sensitivity.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local DataTemplate = require(Shared.Data.DataTemplate)
local Anim = require(script.Parent.Parent:WaitForChild("UILib").Anim)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local AudioController = require(script.Parent.AudioController)
local GraphicsController = require(script.Parent.GraphicsController)

local SettingsController = {}
SettingsController.Priority = 5
SettingsController.Changed = Signal.new()
SettingsController.SaveStateChanged = Signal.new() -- ("Saving" | "Saved" | "Failed")

local settings = table.clone(DataTemplate.DefaultSettings)
local privacy = table.clone(DataTemplate.DefaultPrivacy)
local pendingSettings, pendingPrivacy = {}, {}
local saveScheduled = false
local loadedFromServer = false
local scaleToken = 0

local function apply(key: string)
	if key == "MusicVolume" or key == "SfxVolume" then
		AudioController.SetVolumes(settings.MusicVolume, settings.SfxVolume)
	elseif key == "UIScale" then
		-- Applied after the slider pauses, so the screen doesn't re-layout mid-drag.
		scaleToken += 1
		local token = scaleToken
		task.delay(0.45, function()
			if token == scaleToken then
				UIController.SetUserScale(settings.UIScale)
			end
		end)
	elseif key == "Graphics" then
		GraphicsController.Apply(settings.Graphics)
	elseif key == "ReduceAnimations" then
		Anim.Reduced = settings.ReduceAnimations
	end
end

local function applyAll()
	for key in pairs(settings) do
		apply(key)
	end
end

local function scheduleSave()
	if saveScheduled then
		return
	end
	saveScheduled = true
	task.delay(0.8, function()
		saveScheduled = false
		local s, p = pendingSettings, pendingPrivacy
		pendingSettings, pendingPrivacy = {}, {}
		SettingsController.SaveStateChanged:Fire("Saving")
		local ok = true
		if next(s) then
			ok = (Net.Invoke("UpdateSettings", s)) == true and ok
		end
		if next(p) then
			ok = (Net.Invoke("UpdatePrivacy", p)) == true and ok
		end
		if not ok then
			-- Put the values back so the next change retries them.
			for key, value in pairs(s) do
				if pendingSettings[key] == nil then
					pendingSettings[key] = value
				end
			end
			for key, value in pairs(p) do
				if pendingPrivacy[key] == nil then
					pendingPrivacy[key] = value
				end
			end
		end
		SettingsController.SaveStateChanged:Fire(if ok then "Saved" else "Failed")
	end)
end

function SettingsController.Get(key: string)
	return settings[key]
end

function SettingsController.Set(key: string, value: any)
	if settings[key] == nil or settings[key] == value then
		return
	end
	settings[key] = value
	pendingSettings[key] = value
	apply(key)
	SettingsController.Changed:Fire(key, value)
	scheduleSave()
end

function SettingsController.GetPrivacy(key: string)
	return privacy[key]
end

function SettingsController.SetPrivacy(key: string, value: string)
	if privacy[key] == nil or privacy[key] == value then
		return
	end
	privacy[key] = value
	pendingPrivacy[key] = value
	SettingsController.Changed:Fire("Privacy." .. key, value)
	scheduleSave()
end

function SettingsController.Init() end

function SettingsController.Start()
	applyAll()
	DataController.Changed:Connect(function(data)
		-- Adopt saved values once; afterwards the client copy is the source of
		-- truth for display (the server already has whatever we sent).
		if loadedFromServer then
			return
		end
		loadedFromServer = true
		for key, value in pairs(data.Settings or {}) do
			if settings[key] ~= nil then
				settings[key] = value
			end
		end
		for key, value in pairs(data.Privacy or {}) do
			if privacy[key] ~= nil then
				privacy[key] = value
			end
		end
		applyAll()
		SettingsController.Changed:Fire("*", nil)
	end)
end

return SettingsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="81">
            <Properties>
              <string name="Name">SettingsMenu</string>
              <string name="Source"><![CDATA[--[[
	SettingsMenu  (StarterPlayerScripts.Client.Controllers.SettingsMenu)
	The Settings screen. Every control applies immediately and saves
	automatically (see SettingsController). Works with mouse, touch and gamepad.
]]

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Components = require(UILib.Components)
local Layout = require(UILib.Layout)

local UIController = require(script.Parent.UIController)
local SettingsController = require(script.Parent.SettingsController)

local SettingsMenu = {}
SettingsMenu.Priority = 50

local frame: CanvasGroup
local saveLabel: TextLabel? = nil
local firstControl: GuiObject? = nil

local SHARE_OPTIONS = { "Everyone", "Friends", "Nobody" }
local SHARE_LABELS = { "Everyone", "Friends only", "Nobody" }

local function section(parent, title: string, order: number)
	Create.Label({
		Text = title,
		FontFace = Theme.Font.Heavy,
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Color.Primary,
		Size = UDim2.new(1, 0, 0, 30),
		TextYAlignment = Enum.TextYAlignment.Bottom,
		LayoutOrder = order,
		Parent = parent,
	})
end

local function render()
	Create.Clear(frame, true)
	Layout.Header(frame, "Settings", function()
		UIController.Back()
	end)
	local scroll = Layout.Scroll(frame)
	local width = math.min(720, UIController.GetVirtualSize().X - 32)
	local column = Layout.Column(scroll, width)
	local order = 0
	local function nextOrder()
		order += 1
		return order
	end

	section(column, "🔊  AUDIO", nextOrder())
	local music = Components.Slider({ Label = "Music volume", Min = 0, Max = 1, Step = 0.05, Value = SettingsController.Get("MusicVolume"), LayoutOrder = nextOrder(), Parent = column, OnChanged = function(v)
		SettingsController.Set("MusicVolume", v)
	end })
	firstControl = music.Instance:FindFirstChild("Controls") and music.Instance.Controls:FindFirstChildWhichIsA("GuiButton")
	Components.Slider({ Label = "Sound effects volume", Min = 0, Max = 1, Step = 0.05, Value = SettingsController.Get("SfxVolume"), LayoutOrder = nextOrder(), Parent = column, OnChanged = function(v)
		SettingsController.Set("SfxVolume", v)
	end })

	section(column, "🖥️  DISPLAY", nextOrder())
	Components.Selector({ Label = "Graphics", Options = { "Auto", "Low", "High" }, Labels = { "Auto", "Low (faster)", "High" }, Value = SettingsController.Get("Graphics"), LayoutOrder = nextOrder(), Parent = column, OnChanged = function(v)
		SettingsController.Set("Graphics", v)
	end })
	Components.Slider({
		Label = "UI scale",
		Min = 0.75,
		Max = 1.25,
		Step = 0.05,
		Value = SettingsController.Get("UIScale"),
		LayoutOrder = nextOrder(),
		Parent = column,
		OnChanged = function(v)
			SettingsController.Set("UIScale", v)
		end,
	})
	Components.Toggle({ Label = "Reduce animations", Value = SettingsController.Get("ReduceAnimations"), LayoutOrder = nextOrder(), Parent = column, OnChanged = function(v)
		SettingsController.Set("ReduceAnimations", v)
	end })

	section(column, "🎮  CONTROLS", nextOrder())
	Components.Slider({
		Label = "Camera sensitivity",
		Min = 0.2,
		Max = 2,
		Step = 0.1,
		Value = SettingsController.Get("CameraSensitivity"),
		Format = function(v)
			return ("%.1fx"):format(v)
		end,
		LayoutOrder = nextOrder(),
		Parent = column,
		OnChanged = function(v)
			SettingsController.Set("CameraSensitivity", v)
		end,
	})

	section(column, "🔔  NOTIFICATIONS", nextOrder())
	Components.Toggle({ Label = "Show notifications", Value = SettingsController.Get("Notifications"), LayoutOrder = nextOrder(), Parent = column, OnChanged = function(v)
		SettingsController.Set("Notifications", v)
	end })

	section(column, "🔒  PRIVACY: WHAT OTHERS CAN SEE", nextOrder())
	for _, entry in ipairs({
		{ Key = "ShareStats", Label = "My life stats" },
		{ Key = "ShareReveals", Label = "My Life Reveals" },
		{ Key = "ShareHistory", Label = "My past lives" },
	}) do
		Components.Selector({ Label = entry.Label, Options = SHARE_OPTIONS, Labels = SHARE_LABELS, Value = SettingsController.GetPrivacy(entry.Key), LayoutOrder = nextOrder(), Parent = column, OnChanged = function(v)
			SettingsController.SetPrivacy(entry.Key, v)
		end })
	end

	saveLabel = Create.Label({
		Text = "✓ Changes save automatically",
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Color.TextFaint,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = nextOrder(),
		Parent = column,
	})
end

function SettingsMenu.Init()
	frame = UIController.NewScreen("Settings", {
		Back = true,
		OnOpen = render,
		DefaultFocus = function()
			return firstControl
		end,
	})
end

function SettingsMenu.Start()
	SettingsController.SaveStateChanged:Connect(function(state)
		if not saveLabel or not saveLabel.Parent then
			return
		end
		if state == "Saving" then
			saveLabel.Text = "Saving…"
		elseif state == "Saved" then
			saveLabel.Text = "✓ Saved"
		else
			saveLabel.Text = "⚠️ Couldn't save. It will retry with your next change."
		end
	end)
	UIController.LayoutChanged:Connect(function()
		-- UI scale changes re-layout the screen; rebuild so sizes fit.
		if UIController.Current() == "Settings" then
			render()
		end
	end)
end

return SettingsMenu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--[[
	UIController  (StarterPlayerScripts.Client.Controllers.UIController)
	Owns the ScreenGuis, responsive scaling, the screen router and modals.

	Responsive scaling: all UI is designed in "virtual pixels". We pick a design
	resolution for the device shape (landscape / phone-landscape / portrait),
	compute scale = min(screen / design) × the player's UI Scale setting, and
	apply it with a UIScale. Root frames are sized in virtual pixels, so text
	and touch targets stay readable on phones and crisp on 4K monitors.

	Screens:
	  local frame = UIController.NewScreen("Menu", { Back = nil, OnOpen = fn, OnClose = fn, Backdrop = true })
	  UIController.Show("Menu", ...)      -- fades the old screen out, new one in
	  UIController.Back()                 -- previous screen (gamepad B does this)
	  UIController.Confirm({ Title, Text, ConfirmText, CancelText, Danger }) -> boolean (yields)
	Layout:
	  UIController.GetVirtualSize() -> Vector2,  UIController.IsNarrow() -> boolean
	  UIController.LayoutChanged:Connect(fn(virtualSize, isNarrow))
]]

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Signal = require(ReplicatedStorage:WaitForChild("Shared").Util.Signal)
local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Anim = require(UILib.Anim)
local Components = require(UILib.Components)

local UIController = {}
UIController.Priority = 1

UIController.LayoutChanged = Signal.new()
UIController.ScreenChanged = Signal.new()

local mainGui: ScreenGui
local overlayGui: ScreenGui
local backdropGui: ScreenGui
local root: Frame
local overlay: Frame
local backdrop: Frame
local scales: { UIScale } = {}

local userScale = 1
local currentScale = 1
local virtualSize = Theme.DesignLandscape
local narrow = false

local screens: { [string]: any } = {}
local current: string? = nil
local history: { string } = {}
local modalOpen = false
local navigatingBack = false

-- ===== Scaling =====
local function computeLayout()
	local absolute = mainGui.AbsoluteSize
	if absolute.X < 2 or absolute.Y < 2 then
		return
	end
	local design
	if absolute.Y > absolute.X then
		design = Theme.DesignPortrait
	elseif absolute.Y < 500 then
		design = Theme.DesignCompact
	else
		design = Theme.DesignLandscape
	end
	local scale = math.min(absolute.X / design.X, absolute.Y / design.Y) * userScale
	scale = math.clamp(scale, 0.4, 3)
	currentScale = scale
	virtualSize = Vector2.new(math.floor(absolute.X / scale), math.floor(absolute.Y / scale))
	narrow = virtualSize.X < Theme.NarrowWidth

	for _, s in ipairs(scales) do
		s.Scale = scale
	end
	root.Size = UDim2.fromOffset(virtualSize.X, virtualSize.Y)
	overlay.Size = UDim2.fromOffset(virtualSize.X, virtualSize.Y)
	UIController.LayoutChanged:Fire(virtualSize, narrow)
end

function UIController.GetVirtualSize(): Vector2
	return virtualSize
end

-- The UIScale currently applied to virtual-pixel layouts.
function UIController.GetScale(): number
	return currentScale
end

function UIController.IsNarrow(): boolean
	return narrow
end

function UIController.SetUserScale(value: number)
	userScale = math.clamp(value, 0.75, 1.25)
	if mainGui then
		computeLayout()
	end
end

function UIController.GetRoot()
	return root
end

function UIController.GetOverlay()
	return overlay
end

function UIController.UsingGamepad(): boolean
	local last = UserInputService:GetLastInputType()
	return UserInputService.GamepadEnabled and (last.Name:find("Gamepad") ~= nil)
end

-- Moves gamepad selection to `target` when a gamepad is in use.
function UIController.Focus(target: GuiObject?)
	if target and UIController.UsingGamepad() then
		GuiService.SelectedObject = target
	end
end

-- ===== Screens =====
function UIController.NewScreen(name: string, options: { [string]: any }?)
	options = options or {}
	local frame = Create("CanvasGroup", {
		Name = name,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		GroupTransparency = 1,
		Parent = root,
	})
	screens[name] = {
		Frame = frame,
		Back = options.Back,
		OnOpen = options.OnOpen,
		OnClose = options.OnClose,
		Backdrop = options.Backdrop ~= false,
		DefaultFocus = options.DefaultFocus,
	}
	return frame
end

function UIController.SetScreenOptions(name: string, options: { [string]: any })
	local screen = screens[name]
	for key, value in pairs(options) do
		screen[key] = value
	end
end

function UIController.HasScreen(name: string): boolean
	return screens[name] ~= nil
end

function UIController.Current(): string?
	return current
end

function UIController.Show(name: string, ...)
	local screen = screens[name]
	assert(screen, "UIController.Show: unknown screen " .. name)
	if current == name then
		if screen.OnOpen then
			task.spawn(screen.OnOpen, ...)
		end
		return
	end
	local previous = current and screens[current]
	if previous then
		Anim.Fade(previous.Frame, false, 0.18)
		if previous.OnClose then
			task.spawn(previous.OnClose)
		end
		if not navigatingBack then
			table.insert(history, current :: string)
			if #history > 20 then
				table.remove(history, 1)
			end
		end
	end
	current = name
	backdrop.Visible = screen.Backdrop
	Anim.Fade(screen.Frame, true, 0.28)
	if screen.OnOpen then
		task.spawn(screen.OnOpen, ...)
	end
	task.defer(function()
		if current == name and screen.DefaultFocus then
			UIController.Focus(screen.DefaultFocus())
		end
	end)
	UIController.ScreenChanged:Fire(name)
end

-- Goes to the screen's declared Back target: a screen name, or `true` for
-- "wherever I came from". History is trimmed so it always reflects the path.
function UIController.Back()
	if modalOpen or not current then
		return
	end
	local screen = screens[current]
	local target = if screen.Back == true then history[#history] else screen.Back
	if not target or not screens[target] then
		return
	end
	for i = #history, 1, -1 do
		if history[i] == target then
			for j = #history, i, -1 do
				history[j] = nil
			end
			break
		end
	end
	navigatingBack = true
	UIController.Show(target)
	navigatingBack = false
end

-- ===== Modals =====
function UIController.Confirm(options: { [string]: any }): boolean
	if modalOpen then
		return false
	end
	modalOpen = true
	local result = nil
	local previousSelection = GuiService.SelectedObject

	local dim = Create("CanvasGroup", {
		Name = "ConfirmModal",
		BackgroundColor3 = Theme.Color.Black,
		BackgroundTransparency = 0.35,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
		Parent = overlay,
	})
	local width = math.min(520, virtualSize.X - 40)
	local panel = Components.Panel({
		Size = UDim2.fromOffset(width, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Color = Theme.Color.Surface,
		Padding = 24,
		Parent = dim,
	})
	Create.List(Enum.FillDirection.Vertical, 14, Enum.HorizontalAlignment.Center).Parent = panel
	Create.Label({
		Text = options.Title or "Are you sure?",
		FontFace = Theme.Font.Heavy,
		TextSize = Theme.TextSize.H2,
		TextXAlignment = Enum.TextXAlignment.Center,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		Parent = panel,
	})
	Create.Label({
		Text = options.Text or "",
		TextColor3 = Theme.Color.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		Parent = panel,
	})
	local row = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 56), LayoutOrder = 3, Parent = panel })
	Create.List(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center).Parent = row
	local buttonWidth = math.floor((width - 48 - 12) / 2)
	local cancel = Components.Button({
		Text = options.CancelText or "Cancel",
		Style = "Secondary",
		Size = UDim2.fromOffset(buttonWidth, 54),
		LayoutOrder = 1,
		Parent = row,
		OnClick = function()
			result = false
		end,
	})
	Components.Button({
		Text = options.ConfirmText or "Confirm",
		Style = if options.Danger then "Danger" else "Primary",
		Size = UDim2.fromOffset(buttonWidth, 54),
		LayoutOrder = 2,
		Parent = row,
		OnClick = function()
			result = true
		end,
	})
	Anim.Fade(dim, true, 0.2)
	Anim.Pop(panel, 0.9)
	UIController.Focus(cancel)
	UIController._modalCancel = function()
		result = false
	end

	while result == nil do
		task.wait()
	end
	UIController._modalCancel = nil
	modalOpen = false
	Anim.Fade(dim, false, 0.15)
	task.delay(0.3, function()
		dim:Destroy()
	end)
	if previousSelection and previousSelection.Parent then
		UIController.Focus(previousSelection)
	end
	return result
end

function UIController.IsModalOpen(): boolean
	return modalOpen
end

--[[
	Panel modal used by the HUD panels (People, Lifestyle, Money, Stats).
	Only one is open at a time. Returns a handle:
	  { Root, Panel, Scroll, Close(), IsOpen() }
	Closes on ✕, on tapping outside, and on gamepad B.
]]
local currentPanel = nil
function UIController.ClosePanel()
	if currentPanel then
		local handle = currentPanel
		currentPanel = nil
		ContextActionService:UnbindAction("CYL_ClosePanel")
		Anim.Fade(handle.Root, false, 0.15)
		task.delay(0.25, function()
			handle.Root:Destroy()
		end)
		if handle.OnClose then
			task.spawn(handle.OnClose)
		end
	end
end

function UIController.OpenPanel(options: { [string]: any })
	UIController.ClosePanel()
	local modalRoot = Create("CanvasGroup", { Name = options.Name or "PanelModal", BackgroundColor3 = Theme.Color.Black, BackgroundTransparency = 0.35, Size = UDim2.fromScale(1, 1), ZIndex = 30, Parent = overlay })
	local closer = Create("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Selectable = false, Parent = modalRoot })
	closer.Activated:Connect(UIController.ClosePanel)
	local width = math.min(options.Width or 820, virtualSize.X - 24)
	local height = math.min(options.Height or 660, virtualSize.Y - 24)
	local panel = Components.Panel({ Name = "Panel", Size = UDim2.fromOffset(width, height), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Padding = 20, Parent = modalRoot })
	Create.Label({ Name = "Title", Text = options.Title or "", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H2, Size = UDim2.new(1, -60, 0, 36), TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = panel })
	local subtitle = Create.Label({ Name = "Subtitle", Text = options.Subtitle or "", TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.Small, Position = UDim2.fromOffset(0, 38), Size = UDim2.new(1, -60, 0, 22), TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = panel })
	local close = Components.Button({ Name = "Close", Text = "✕", Style = "Secondary", Size = UDim2.fromOffset(48, 48), AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Parent = panel, OnClick = UIController.ClosePanel })
	local scroll = Create("ScrollingFrame", {
		Name = "Scroll",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 72),
		Size = UDim2.new(1, 0, 1, -72),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Color.Stroke,
		Selectable = false,
		Parent = panel,
	})
	Create.List(Enum.FillDirection.Vertical, 12).Parent = scroll
	Create.Padding(4, 10, 14, 4).Parent = scroll

	local handle = { Root = modalRoot, Panel = panel, Scroll = scroll, Subtitle = subtitle, Close = UIController.ClosePanel, OnClose = options.OnClose }
	function handle.IsOpen()
		return currentPanel == handle
	end
	-- Rebuilds the scrolling contents (keeps scroll position).
	function handle.Clear()
		Create.Clear(scroll)
	end
	currentPanel = handle
	Anim.Fade(modalRoot, true, 0.2)
	Anim.Pop(panel, 0.94)
	UIController.Focus(close)
	ContextActionService:BindActionAtPriority("CYL_ClosePanel", function(_, state)
		if state == Enum.UserInputState.Begin then
			UIController.ClosePanel()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonB)
	return handle
end

function UIController.CurrentPanel()
	return currentPanel
end

-- ===== Backdrop: gradient + slowly drifting soft circles =====
local function buildBackdrop()
	backdrop = Create("Frame", {
		Name = "Backdrop",
		BackgroundColor3 = Theme.Color.White,
		Size = UDim2.fromScale(1, 1),
		BorderSizePixel = 0,
		Parent = backdropGui,
	}, { Create.Gradient(Theme.Gradient.Backdrop, 120) })
	local gradient = backdrop:FindFirstChildOfClass("UIGradient")
	if gradient then
		Anim.Loop(gradient, { Rotation = 160 }, 12)
	end
	local orbColors = { Theme.Color.Primary, Theme.Color.Accent, Theme.Color.AccentAlt, Theme.Color.PrimaryAlt }
	local rng = Random.new(7)
	for i = 1, 6 do
		local size = rng:NextInteger(180, 420)
		local orb = Create("Frame", {
			Name = "Orb" .. i,
			BackgroundColor3 = orbColors[(i - 1) % #orbColors + 1],
			BackgroundTransparency = 0.86,
			Size = UDim2.fromOffset(size, size),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(rng:NextNumber(0.05, 0.95), rng:NextNumber(0.05, 0.95)),
			Parent = backdrop,
		}, { Create.Corner(Theme.RadiusPill) })
		orb:SetAttribute("Decor", true)
		local target = orb.Position + UDim2.fromScale(rng:NextNumber(-0.08, 0.08), rng:NextNumber(-0.08, 0.08))
		Anim.Loop(orb, { Position = target }, rng:NextNumber(9, 16))
	end
end

function UIController.SetDecorations(enabled: boolean)
	if not backdrop then
		return
	end
	for _, child in ipairs(backdrop:GetChildren()) do
		if child:GetAttribute("Decor") then
			(child :: GuiObject).Visible = enabled
		end
	end
end

-- ===== Lifecycle =====
function UIController.Init()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

	backdropGui = Create("ScreenGui", {
		Name = "CYL_Backdrop",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ScreenInsets = Enum.ScreenInsets.None,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 1,
		Parent = playerGui,
	})
	mainGui = Create("ScreenGui", {
		Name = "CYL_Main",
		ResetOnSpawn = false,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 5,
		Parent = playerGui,
	})
	overlayGui = Create("ScreenGui", {
		Name = "CYL_Overlay",
		ResetOnSpawn = false,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 20,
		Parent = playerGui,
	})

	root = Create("Frame", { Name = "Root", BackgroundTransparency = 1, Parent = mainGui })
	overlay = Create("Frame", { Name = "Root", BackgroundTransparency = 1, Parent = overlayGui })
	for _, container in ipairs({ root, overlay }) do
		local s = Instance.new("UIScale")
		s.Parent = container
		table.insert(scales, s)
	end
	buildBackdrop()

	mainGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(computeLayout)
	computeLayout()

	-- Gamepad B goes back; modals treat it as Cancel.
	ContextActionService:BindAction("CYL_Back", function(_, state)
		if state ~= Enum.UserInputState.Begin then
			return Enum.ContextActionResult.Pass
		end
		if modalOpen and UIController._modalCancel then
			UIController._modalCancel()
			return Enum.ContextActionResult.Sink
		end
		if current and screens[current].Back then
			UIController.Back()
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.ButtonB)
end

function UIController.Start() end

return UIController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="83">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Main  (StarterPlayerScripts.Client.Main)  — LocalScript
	Client bootstrap: same Init/Start lifecycle as the server, using the
	ModuleScripts in Client.Controllers. (Client.UILib holds shared UI
	building blocks; it is required by controllers, not auto-started.)
]]

local controllers = {}

local function collect(folder: Instance?)
	if not folder then
		return
	end
	for _, module in ipairs(folder:GetChildren()) do
		if module:IsA("ModuleScript") then
			local ok, controller = pcall(require, module)
			if ok and type(controller) == "table" then
				controller.Name = controller.Name or module.Name
				table.insert(controllers, controller)
			else
				warn("[Client] Failed to load " .. module.Name .. ": " .. tostring(controller))
			end
		end
	end
end

collect(script.Parent:WaitForChild("Controllers"))

table.sort(controllers, function(a, b)
	return (a.Priority or 100) < (b.Priority or 100)
end)

for _, controller in ipairs(controllers) do
	if controller.Init then
		local ok, err = pcall(controller.Init)
		if not ok then
			warn("[Client] " .. controller.Name .. ".Init failed: " .. tostring(err))
		end
	end
end

for _, controller in ipairs(controllers) do
	if controller.Start then
		task.spawn(function()
			local ok, err = pcall(controller.Start)
			if not ok then
				warn("[Client] " .. controller.Name .. ".Start failed: " .. tostring(err))
			end
		end)
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="84">
          <Properties>
            <string name="Name">UILib</string>
          </Properties>
          <Item class="ModuleScript" referent="85">
            <Properties>
              <string name="Name">Anim</string>
              <string name="Source"><![CDATA[--[[
	Anim  (StarterPlayerScripts.Client.UILib.Anim)
	Tween helpers that respect the "Reduce animations" setting: when reduced,
	properties are set instantly and looping/decorative motion is skipped.
]]

local TweenService = game:GetService("TweenService")

local Anim = {}
Anim.Reduced = false

local fadeTokens = setmetatable({}, { __mode = "k" })

function Anim.Tween(inst: Instance, props: { [string]: any }, time: number?, style: Enum.EasingStyle?, direction: Enum.EasingDirection?)
	if Anim.Reduced or time == 0 then
		for key, value in pairs(props) do
			(inst :: any)[key] = value
		end
		return nil
	end
	local tween = TweenService:Create(inst, TweenInfo.new(time or 0.25, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

function Anim.Await(tween)
	if tween and tween.PlaybackState ~= Enum.PlaybackState.Completed then
		tween.Completed:Wait()
	end
end

-- A UIScale named "AnimScale" used for pop/press effects without touching Size.
function Anim.Scale(inst: Instance): UIScale
	local scale = inst:FindFirstChild("AnimScale")
	if not scale then
		scale = Instance.new("UIScale")
		scale.Name = "AnimScale"
		scale.Parent = inst
	end
	return scale :: UIScale
end

function Anim.Pop(inst: Instance, from: number?, time: number?)
	local scale = Anim.Scale(inst)
	if Anim.Reduced then
		scale.Scale = 1
		return nil
	end
	scale.Scale = from or 0.85
	return Anim.Tween(scale, { Scale = 1 }, time or 0.35, Enum.EasingStyle.Back)
end

-- Fades a CanvasGroup in/out and toggles Visible. Safe to call repeatedly.
function Anim.Fade(group: CanvasGroup, visible: boolean, time: number?)
	local token = (fadeTokens[group] or 0) + 1
	fadeTokens[group] = token
	if visible then
		group.Visible = true
		if not Anim.Reduced then
			group.GroupTransparency = 1
		end
		return Anim.Tween(group, { GroupTransparency = 0 }, time or 0.25)
	end
	local tween = Anim.Tween(group, { GroupTransparency = 1 }, time or 0.2)
	if tween then
		tween.Completed:Connect(function()
			if fadeTokens[group] == token then
				group.Visible = false
			end
		end)
	else
		group.Visible = false
	end
	return tween
end

-- Small wobble (rotation, so it also works inside layouts), e.g. for a locked choice.
function Anim.Shake(inst: GuiObject)
	if Anim.Reduced then
		return
	end
	task.spawn(function()
		for _, angle in ipairs({ 3, -3, 2, -2, 1, 0 }) do
			Anim.Tween(inst, { Rotation = angle }, 0.05, Enum.EasingStyle.Linear)
			task.wait(0.05)
		end
		inst.Rotation = 0
	end)
end

--[[
	Repeating back-and-forth tween for ambient motion (skipped when reduced).
	Returns a stop() function.
]]
function Anim.Loop(inst: Instance, props: { [string]: any }, time: number)
	if Anim.Reduced then
		return function() end
	end
	local tween = TweenService:Create(inst, TweenInfo.new(time, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), props)
	tween:Play()
	return function()
		tween:Cancel()
	end
end

return Anim
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="86">
            <Properties>
              <string name="Name">Components</string>
              <string name="Source"><![CDATA[--[[
	Components  (StarterPlayerScripts.Client.UILib.Components)
	Reusable, themed widgets. Every interactive widget works with mouse,
	touch and gamepad (all are Selectable buttons; sliders also have −/+).

	Components.Button{ Text, Icon?, Style?, Size?, TextSize?, LayoutOrder?, Parent?, OnClick }
	Components.SetDisabled(button, disabled) / Components.SetText(button, text)
	Components.Panel{ Size?, Color?, Parent?, ... }
	Components.Slider{ Label, Min, Max, Step, Value, Format?, OnChanged, Parent?, LayoutOrder? } -> { Instance, Set }
	Components.Toggle{ Label, Value, OnChanged, Parent?, LayoutOrder? }                  -> { Instance, Set }
	Components.Selector{ Label, Options, Labels?, Value, OnChanged, Parent?, LayoutOrder? } -> { Instance, Set }
	Components.StatBar{ Name, Icon, Color, Value, Compact?, Parent?, LayoutOrder? }        -> { Instance, Set }
	Components.Chip{ Text, Color?, Parent?, LayoutOrder? }

	Components.OnClickSound: set by AudioController to play a click.
]]

local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)
local Create = require(script.Parent.Create)
local Anim = require(script.Parent.Anim)

local Components = {}
Components.OnClickSound = nil :: (() -> ())?

local STYLES = {
	Primary = { Color = Theme.Color.White, Gradient = Theme.Gradient.Primary, Text = Theme.Color.White },
	Accent = { Color = Theme.Color.White, Gradient = Theme.Gradient.Accent, Text = Theme.Color.White },
	Positive = { Color = Theme.Color.White, Gradient = Theme.Gradient.Positive, Text = Theme.Color.White },
	Danger = { Color = Theme.Color.White, Gradient = Theme.Gradient.Danger, Text = Theme.Color.White },
	Secondary = { Color = Theme.Color.SurfaceHigh, Text = Theme.Color.Text, Stroke = true },
	Ghost = { Color = Theme.Color.Surface, Text = Theme.Color.TextDim, Stroke = true, Transparency = 0.35 },
}

-- ===== Button =====
function Components.Button(p)
	local style = STYLES[p.Style or "Primary"] or STYLES.Primary
	local button = Create("TextButton", {
		Name = p.Name or "Button",
		AutoButtonColor = false,
		Text = "",
		Size = p.Size or UDim2.fromOffset(280, 56),
		Position = p.Position or UDim2.new(),
		AnchorPoint = p.AnchorPoint or Vector2.zero,
		BackgroundColor3 = style.Color,
		BackgroundTransparency = style.Transparency or 0,
		LayoutOrder = p.LayoutOrder or 0,
		Selectable = true,
		Parent = p.Parent,
	}, {
		Create.Corner(p.Radius or Theme.RadiusSmall),
	})
	if style.Gradient then
		Create.Gradient(style.Gradient, 15).Parent = button
	end
	local stroke = Create.Stroke(if style.Stroke then Theme.Color.Stroke else Theme.Color.White, 1.5, if style.Stroke then 0.4 else 1)
	stroke.Parent = button

	local text = p.Text or ""
	Create.Label({
		Name = "Label",
		Text = if p.Icon then p.Icon .. "  " .. text else text,
		Size = UDim2.fromScale(1, 1),
		FontFace = Theme.Font.Bold,
		TextSize = p.TextSize or 22,
		TextColor3 = style.Text,
		TextXAlignment = p.TextXAlignment or Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
		Parent = button,
	})
	if p.TextXAlignment == Enum.TextXAlignment.Left then
		Create.Padding(0, 18).Parent = button
	end

	local scale = Anim.Scale(button)
	local hovering = false
	button.MouseEnter:Connect(function()
		hovering = true
		if not button:GetAttribute("Disabled") then
			Anim.Tween(scale, { Scale = 1.03 }, 0.15)
		end
	end)
	button.MouseLeave:Connect(function()
		hovering = false
		Anim.Tween(scale, { Scale = 1 }, 0.15)
	end)
	button.InputBegan:Connect(function(input)
		if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not button:GetAttribute("Disabled") then
			Anim.Tween(scale, { Scale = 0.96 }, 0.08)
		end
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			Anim.Tween(scale, { Scale = if hovering then 1.03 else 1 }, 0.12)
		end
	end)
	-- Gamepad selection highlight.
	button.SelectionGained:Connect(function()
		stroke.Color = Theme.Color.Gold
		stroke.Thickness = 3
		stroke.Transparency = 0
	end)
	button.SelectionLost:Connect(function()
		stroke.Color = if style.Stroke then Theme.Color.Stroke else Theme.Color.White
		stroke.Thickness = 1.5
		stroke.Transparency = if style.Stroke then 0.4 else 1
	end)

	button.Activated:Connect(function()
		if button:GetAttribute("Disabled") then
			return
		end
		if Components.OnClickSound then
			Components.OnClickSound()
		end
		if p.OnClick then
			p.OnClick(button)
		end
	end)
	return button
end

function Components.SetDisabled(button: GuiButton, disabled: boolean)
	button:SetAttribute("Disabled", disabled)
	button.BackgroundTransparency = if disabled then 0.6 else 0
	local label = button:FindFirstChild("Label")
	if label then
		(label :: TextLabel).TextTransparency = if disabled then 0.5 else 0
	end
end

function Components.SetText(button: GuiButton, text: string)
	local label = button:FindFirstChild("Label")
	if label then
		(label :: TextLabel).Text = text
	end
end

-- ===== Panel =====
function Components.Panel(p)
	local props = {
		Name = p.Name or "Panel",
		Size = p.Size or UDim2.fromScale(1, 1),
		Position = p.Position or UDim2.new(),
		AnchorPoint = p.AnchorPoint or Vector2.zero,
		BackgroundColor3 = p.Color or Theme.Color.Surface,
		BackgroundTransparency = p.Transparency or 0.05,
		LayoutOrder = p.LayoutOrder or 0,
		AutomaticSize = p.AutomaticSize or Enum.AutomaticSize.None,
		Parent = p.Parent,
	}
	local panel = Create("Frame", props, { Create.Corner(p.Radius), Create.Stroke() })
	if p.Padding then
		Create.Padding(p.Padding).Parent = panel
	end
	return panel
end

-- ===== Chip =====
function Components.Chip(p)
	local chip = Create("Frame", {
		Name = "Chip",
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, p.Height or 34),
		BackgroundColor3 = p.Color or Theme.Color.SurfaceHigh,
		BackgroundTransparency = p.Transparency or 0.1,
		LayoutOrder = p.LayoutOrder or 0,
		Parent = p.Parent,
	}, { Create.Corner(Theme.RadiusPill), Create.Padding(0, 14) })
	Create.Label({
		Name = "Label",
		Text = p.Text,
		RichText = true,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromScale(0, 1),
		TextWrapped = false,
		FontFace = Theme.Font.Bold,
		TextSize = p.TextSize or Theme.TextSize.Small,
		TextColor3 = p.TextColor or Theme.Color.Text,
		Parent = chip,
	})
	return chip
end

-- ===== Row helper for settings widgets =====
local function settingRow(p, height)
	local row = Create("Frame", {
		Name = p.Label or "Row",
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = Theme.Color.SurfaceHigh,
		BackgroundTransparency = 0.2,
		LayoutOrder = p.LayoutOrder or 0,
		Parent = p.Parent,
	}, { Create.Corner(Theme.RadiusSmall), Create.Padding(10, 16) })
	Create.Label({
		Name = "Title",
		Text = p.Label,
		Size = UDim2.new(0.5, 0, 0, 28),
		FontFace = Theme.Font.Bold,
		TextSize = Theme.TextSize.Body,
		Parent = row,
	})
	return row
end

local function smallButton(text: string, onClick: () -> ())
	return Components.Button({ Text = text, Style = "Secondary", Size = UDim2.fromOffset(Theme.TouchTarget, Theme.TouchTarget - 8), TextSize = 22, OnClick = onClick })
end

-- ===== Slider =====
function Components.Slider(p)
	local min, max, step = p.Min, p.Max, p.Step or 0.05
	local value = p.Value
	local format = p.Format or function(v)
		return tostring(math.floor(v * 100 + 0.5)) .. "%"
	end
	local row = settingRow(p, 96)

	local valueLabel = Create.Label({
		Name = "Value",
		Size = UDim2.new(0.5, 0, 0, 28),
		Position = UDim2.fromScale(0.5, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Theme.Color.TextDim,
		FontFace = Theme.Font.Bold,
		Parent = row,
	})

	local controls = Create("Frame", {
		Name = "Controls",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, Theme.TouchTarget - 8),
		Position = UDim2.fromOffset(0, 34),
		Parent = row,
	})
	local minus = smallButton("−", function()
		Components._sliderNudge(p, -1)
	end)
	minus.Parent = controls
	local plus = smallButton("+", function()
		Components._sliderNudge(p, 1)
	end)
	plus.AnchorPoint = Vector2.new(1, 0)
	plus.Position = UDim2.fromScale(1, 0)
	plus.Parent = controls

	local track = Create("TextButton", {
		Name = "Track",
		Text = "",
		AutoButtonColor = false,
		Selectable = false,
		BackgroundColor3 = Theme.Color.Background,
		Size = UDim2.new(1, -(Theme.TouchTarget * 2 + 28), 0, 12),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = controls,
	}, { Create.Corner(Theme.RadiusPill) })
	local fill = Create("Frame", {
		Name = "Fill",
		BackgroundColor3 = Theme.Color.White,
		Size = UDim2.fromScale(0, 1),
		Parent = track,
	}, { Create.Corner(Theme.RadiusPill), Create.Gradient(Theme.Gradient.Primary) })
	local knob = Create("Frame", {
		Name = "Knob",
		BackgroundColor3 = Theme.Color.White,
		Size = UDim2.fromOffset(26, 26),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Parent = track,
	}, { Create.Corner(Theme.RadiusPill) })

	local function render()
		local alpha = (value - min) / (max - min)
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.fromScale(alpha, 0.5)
		valueLabel.Text = format(value)
	end

	local function set(newValue: number, silent: boolean?)
		newValue = math.clamp(math.floor((newValue - min) / step + 0.5) * step + min, min, max)
		newValue = math.floor(newValue * 1000 + 0.5) / 1000
		if newValue == value then
			render()
			return
		end
		value = newValue
		render()
		if not silent and p.OnChanged then
			p.OnChanged(value)
		end
	end
	p._set = set
	p._get = function()
		return value
	end

	local dragging = false
	local function fromX(x: number)
		local alpha = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		set(min + alpha * (max - min))
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			fromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	render()
	return { Instance = row, Set = set, Get = p._get }
end

function Components._sliderNudge(p, direction: number)
	p._set(p._get() + direction * (p.Step or 0.05))
end

-- ===== Toggle =====
function Components.Toggle(p)
	local value = p.Value == true
	local row = settingRow(p, 60)
	local pill = Create("TextButton", {
		Name = "Switch",
		Text = "",
		AutoButtonColor = false,
		Selectable = true,
		Size = UDim2.fromOffset(72, 38),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		BackgroundColor3 = Theme.Color.Background,
		Parent = row,
	}, { Create.Corner(Theme.RadiusPill), Create.Stroke() })
	local knob = Create("Frame", {
		Name = "Knob",
		Size = UDim2.fromOffset(30, 30),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Theme.Color.TextDim,
		Parent = pill,
	}, { Create.Corner(Theme.RadiusPill) })
	local stroke = pill:FindFirstChildOfClass("UIStroke")

	local function render(animate: boolean?)
		local props = { Position = if value then UDim2.new(1, -34, 0.5, 0) else UDim2.new(0, 4, 0.5, 0), BackgroundColor3 = if value then Theme.Color.White else Theme.Color.TextDim }
		if animate then
			Anim.Tween(knob, props, 0.18)
		else
			knob.Position = props.Position
			knob.BackgroundColor3 = props.BackgroundColor3
		end
		pill.BackgroundColor3 = if value then Theme.Color.Positive else Theme.Color.Background
	end
	local function set(newValue: boolean, silent: boolean?)
		value = newValue == true
		render(true)
		if not silent and p.OnChanged then
			p.OnChanged(value)
		end
	end
	pill.Activated:Connect(function()
		if Components.OnClickSound then
			Components.OnClickSound()
		end
		set(not value)
	end)
	pill.SelectionGained:Connect(function()
		if stroke then
			stroke.Color = Theme.Color.Gold
			stroke.Thickness = 3
		end
	end)
	pill.SelectionLost:Connect(function()
		if stroke then
			stroke.Color = Theme.Color.Stroke
			stroke.Thickness = 1.5
		end
	end)
	render(false)
	return { Instance = row, Set = set, Get = function()
		return value
	end }
end

-- ===== Selector (cycle through options) =====
function Components.Selector(p)
	local options = p.Options
	local labels = p.Labels or options
	local index = table.find(options, p.Value) or 1
	local row = settingRow(p, 60)
	local box = Create("Frame", {
		Name = "Box",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(250, Theme.TouchTarget - 8),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Parent = row,
	})
	local valueLabel = Create.Label({
		Name = "Value",
		Size = UDim2.new(1, -(Theme.TouchTarget * 2), 1, 0),
		Position = UDim2.fromOffset(Theme.TouchTarget, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = Theme.Font.Bold,
		Parent = box,
	})
	local function render()
		valueLabel.Text = labels[index]
	end
	local function step(direction: number)
		index = (index - 1 + direction) % #options + 1
		render()
		if p.OnChanged then
			p.OnChanged(options[index])
		end
	end
	local left = smallButton("‹", function()
		step(-1)
	end)
	left.Parent = box
	local right = smallButton("›", function()
		step(1)
	end)
	right.AnchorPoint = Vector2.new(1, 0)
	right.Position = UDim2.fromScale(1, 0)
	right.Parent = box
	render()
	return {
		Instance = row,
		Set = function(v)
			index = table.find(options, v) or index
			render()
		end,
		Get = function()
			return options[index]
		end,
	}
end

-- ===== StatBar =====
function Components.StatBar(p)
	local compact = p.Compact == true
	local height = if compact then 34 else 58
	local frame = Create("Frame", {
		Name = p.Name,
		BackgroundTransparency = 1,
		Size = p.Size or UDim2.new(1, 0, 0, height),
		LayoutOrder = p.LayoutOrder or 0,
		Parent = p.Parent,
	})
	local title = Create.Label({
		Name = "Title",
		Text = p.Icon .. "  " .. p.DisplayName,
		Size = UDim2.new(1, -60, 0, if compact then 16 else 26),
		TextSize = if compact then Theme.TextSize.Tiny else Theme.TextSize.Body,
		FontFace = Theme.Font.Bold,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
		Parent = frame,
	})
	local valueLabel = Create.Label({
		Name = "Value",
		Size = UDim2.new(0, 60, 0, if compact then 16 else 26),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextSize = if compact then Theme.TextSize.Tiny else Theme.TextSize.Body,
		FontFace = Theme.Font.Heavy,
		TextColor3 = p.Color,
		Parent = frame,
	})
	if compact then
		title.Visible = p.ShowTitle ~= false
	end
	local track = Create("Frame", {
		Name = "Track",
		BackgroundColor3 = Theme.Color.Background,
		Size = UDim2.new(1, 0, 0, if compact then 8 else 14),
		Position = UDim2.new(0, 0, 1, if compact then -10 else -18),
		Parent = frame,
	}, { Create.Corner(Theme.RadiusPill) })
	local fill = Create("Frame", {
		Name = "Fill",
		BackgroundColor3 = p.Color,
		Size = UDim2.fromScale(0, 1),
		Parent = track,
	}, { Create.Corner(Theme.RadiusPill) })

	local current = nil
	local function set(value: number, animate: boolean?)
		value = math.clamp(value, 0, 100)
		valueLabel.Text = tostring(math.floor(value + 0.5))
		local size = UDim2.fromScale(value / 100, 1)
		if animate and current ~= nil then
			Anim.Tween(fill, { Size = size }, 0.6)
		else
			fill.Size = size
		end
		current = value
	end
	set(p.Value or 0, false)
	return { Instance = frame, Set = set }
end

return Components
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">Create</string>
              <string name="Source"><![CDATA[--[[
	Create  (StarterPlayerScripts.Client.UILib.Create)
	Small helpers for building UI from code.

	Create("Frame", { Size = ..., Parent = ... }, { childA, childB })
	Create.Corner(radius)   Create.Stroke(color, thickness, transparency)
	Create.Padding(all) / Create.Padding(top, right, bottom, left)
	Create.List(direction, padding, hAlign, vAlign)
	Create.Gradient(colorSequence, rotation)
	Create.Label(props)     TextLabel with the theme defaults applied
	Create.Clear(instance)  destroys all GuiObject children (keeps layouts if asked)
]]

local Theme = require(script.Parent.Theme)

local function new(className: string, props: { [string]: any }?, children: { Instance }?)
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for key, value in pairs(props) do
			if key == "Parent" then
				parent = value
			else
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local Create = setmetatable({}, {
	__call = function(_, className, props, children)
		return new(className, props, children)
	end,
})

function Create.Corner(radius: UDim?)
	return new("UICorner", { CornerRadius = radius or Theme.Radius })
end

function Create.Stroke(color: Color3?, thickness: number?, transparency: number?)
	return new("UIStroke", {
		Color = color or Theme.Color.Stroke,
		Thickness = thickness or 1.5,
		Transparency = transparency or 0.35,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Create.Padding(top: number, right: number?, bottom: number?, left: number?)
	right = right or top
	bottom = bottom or top
	left = left or right
	return new("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingRight = UDim.new(0, right :: number),
		PaddingBottom = UDim.new(0, bottom :: number),
		PaddingLeft = UDim.new(0, left :: number),
	})
end

function Create.List(direction: Enum.FillDirection?, padding: number?, hAlign: Enum.HorizontalAlignment?, vAlign: Enum.VerticalAlignment?)
	return new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 10),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function Create.Gradient(sequence: ColorSequence, rotation: number?)
	return new("UIGradient", { Color = sequence, Rotation = rotation or 0 })
end

function Create.Label(props: { [string]: any })
	local defaults = {
		BackgroundTransparency = 1,
		FontFace = Theme.Font.Medium,
		TextSize = Theme.TextSize.Body,
		TextColor3 = Theme.Color.Text,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Size = UDim2.new(1, 0, 0, 28),
	}
	for key, value in pairs(props) do
		defaults[key] = value
	end
	return new("TextLabel", defaults)
end

-- Removes GuiObject children (layouts/corners/padding are kept unless `all`).
function Create.Clear(inst: Instance, all: boolean?)
	for _, child in ipairs(inst:GetChildren()) do
		if all or child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

return Create
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="88">
            <Properties>
              <string name="Name">Layout</string>
              <string name="Source"><![CDATA[--[[
	Layout  (StarterPlayerScripts.Client.UILib.Layout)
	Screen-level layout helpers shared by every menu.

	Layout.Header(parent, title, onBack?)     -> header frame (back button + title)
	Layout.Scroll(parent, props?)             -> ScrollingFrame with vertical list + auto canvas
	Layout.Column(parent, width, props?)      -> centred vertical column frame
]]

local Theme = require(script.Parent.Theme)
local Create = require(script.Parent.Create)
local Components = require(script.Parent.Components)

local Layout = {}

Layout.HeaderHeight = 72

function Layout.Header(parent: Instance, title: string, onBack: (() -> ())?)
	local header = Create("Frame", {
		Name = "Header",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, Layout.HeaderHeight),
		Parent = parent,
	}, { Create.Padding(12, 20) })
	local backButton
	if onBack then
		backButton = Components.Button({
			Name = "Back",
			Text = "‹  Back",
			Style = "Ghost",
			Size = UDim2.fromOffset(120, Theme.TouchTarget),
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			TextSize = 20,
			Parent = header,
			OnClick = onBack,
		})
	end
	Create.Label({
		Name = "Title",
		Text = title,
		FontFace = Theme.Font.Heavy,
		TextSize = Theme.TextSize.H1,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -280, 1, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		TextScaled = true,
		Parent = header,
	})
	local titleLabel = header:FindFirstChild("Title") :: TextLabel
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = Theme.TextSize.H1
	constraint.MinTextSize = 18
	constraint.Parent = titleLabel
	return header, backButton
end

function Layout.Scroll(parent: Instance, props: { [string]: any }?)
	local defaults = {
		Name = "Scroll",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, -Layout.HeaderHeight),
		Position = UDim2.fromOffset(0, Layout.HeaderHeight),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Color.Stroke,
		Selectable = false,
		Parent = parent,
	}
	for key, value in pairs(props or {}) do
		defaults[key] = value
	end
	local scroll = Create("ScrollingFrame", defaults)
	Create.List(Enum.FillDirection.Vertical, 12, Enum.HorizontalAlignment.Center).Parent = scroll
	Create.Padding(8, 16, 24, 16).Parent = scroll
	return scroll
end

function Layout.Column(parent: Instance, width: number, props: { [string]: any }?)
	local defaults = {
		Name = "Column",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(width, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = parent,
	}
	for key, value in pairs(props or {}) do
		defaults[key] = value
	end
	local column = Create("Frame", defaults)
	Create.List(Enum.FillDirection.Vertical, 12, Enum.HorizontalAlignment.Center).Parent = column
	return column
end

return Layout
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="89">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--[[
	Theme  (StarterPlayerScripts.Client.UILib.Theme)
	One place for colours, fonts, sizes and the virtual design resolution, so
	every screen looks consistent.
]]

local Theme = {}

local FAMILY = "rbxasset://fonts/families/BuilderSans.json"
Theme.Font = {
	Regular = Font.new(FAMILY, Enum.FontWeight.Regular),
	Medium = Font.new(FAMILY, Enum.FontWeight.Medium),
	Bold = Font.new(FAMILY, Enum.FontWeight.Bold),
	Heavy = Font.new(FAMILY, Enum.FontWeight.ExtraBold),
}

Theme.Color = {
	Background = Color3.fromRGB(13, 14, 30),
	BackgroundAlt = Color3.fromRGB(34, 20, 58),
	Surface = Color3.fromRGB(27, 30, 56),
	SurfaceHigh = Color3.fromRGB(39, 43, 78),
	SurfaceHigher = Color3.fromRGB(52, 57, 100),
	Stroke = Color3.fromRGB(78, 84, 140),
	Text = Color3.fromRGB(246, 247, 255),
	TextDim = Color3.fromRGB(172, 177, 214),
	TextFaint = Color3.fromRGB(120, 126, 170),
	Primary = Color3.fromRGB(255, 90, 140),
	PrimaryAlt = Color3.fromRGB(255, 150, 90),
	Accent = Color3.fromRGB(108, 140, 255),
	AccentAlt = Color3.fromRGB(150, 100, 255),
	Positive = Color3.fromRGB(88, 220, 145),
	Negative = Color3.fromRGB(245, 90, 100),
	Warning = Color3.fromRGB(255, 196, 72),
	Gold = Color3.fromRGB(255, 212, 90),
	Black = Color3.fromRGB(0, 0, 0),
	White = Color3.fromRGB(255, 255, 255),
}

-- Hex strings for RichText <font color="">.
Theme.Hex = {
	Positive = "#58DC91",
	Negative = "#F55A64",
	Dim = "#ACB1D6",
	Gold = "#FFD45A",
}

Theme.TextSize = {
	Hero = 64,
	H1 = 40,
	H2 = 28,
	H3 = 23,
	Body = 20,
	Small = 17,
	Tiny = 14,
}

Theme.Radius = UDim.new(0, 16)
Theme.RadiusSmall = UDim.new(0, 10)
Theme.RadiusPill = UDim.new(1, 0)

Theme.Gradient = {
	Primary = ColorSequence.new(Color3.fromRGB(255, 90, 140), Color3.fromRGB(255, 150, 90)),
	Accent = ColorSequence.new(Color3.fromRGB(108, 140, 255), Color3.fromRGB(150, 100, 255)),
	Positive = ColorSequence.new(Color3.fromRGB(60, 200, 130), Color3.fromRGB(110, 230, 170)),
	Danger = ColorSequence.new(Color3.fromRGB(230, 70, 90), Color3.fromRGB(255, 120, 90)),
	Backdrop = ColorSequence.new(Color3.fromRGB(13, 14, 30), Color3.fromRGB(40, 20, 66)),
	Title = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 120, 170)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 200, 120)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(140, 170, 255)),
	}),
}

-- Virtual design resolutions. UIController picks one and scales the UI so
-- it fills the screen on every device.
Theme.DesignLandscape = Vector2.new(1280, 720)
Theme.DesignCompact = Vector2.new(960, 540) -- phones held sideways
Theme.DesignPortrait = Vector2.new(540, 960) -- phones held upright
Theme.NarrowWidth = 900 -- below this virtual width, layouts stack vertically

-- Minimum touch target in virtual pixels.
Theme.TouchTarget = 48

return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
