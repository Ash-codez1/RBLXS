Catalog.ById = {}
for _, entry in ipairs(Catalog.Items) do
	Catalog.ById[entry.Id] = entry
end

-- Items players may trade with each other: bought with Coins, not VIP-only.
function Catalog.IsTradable(entry): boolean
	return entry ~= nil and not entry.VipOnly and not entry.NoTrade and (entry.Price or 0) > 0
end

function Catalog.Get(id: any)
	return if type(id) == "string" then Catalog.ById[id] else nil
end

function Catalog.InCategory(categoryId: string)
	local list = {}
	for _, entry in ipairs(Catalog.Items) do
		if entry.Category == categoryId then
			table.insert(list, entry)
		end
	end
	return list
end

-- Case-insensitive search over name, description and category.
function Catalog.Search(query: string, categoryId: string?)
	local q = string.lower(query or "")
	local list = {}
	for _, entry in ipairs(Catalog.Items) do
		if not categoryId or entry.Category == categoryId then
			local haystack = string.lower(entry.Name .. " " .. entry.Description .. " " .. entry.Category .. " " .. entry.Rarity)
			if q == "" or haystack:find(q, 1, true) then
				table.insert(list, entry)
			end
		end
	end
	return list
end

-- Checks the catalog itself; returns a list of problems (used by tests and at startup).
function Catalog.Validate()
	local problems, seen, categories = {}, {}, {}
	for _, c in ipairs(Catalog.Categories) do
		categories[c.Id] = true
	end
	for _, entry in ipairs(Catalog.Items) do
		if seen[entry.Id] then
			table.insert(problems, "duplicate item " .. entry.Id)
		end
		seen[entry.Id] = true
		if not categories[entry.Category] then
			table.insert(problems, entry.Id .. ": unknown category")
		end
		local slot = Catalog.Slots[entry.Slot]
		if not slot then
			table.insert(problems, entry.Id .. ": unknown slot")
		elseif slot.Category ~= entry.Category then
			table.insert(problems, entry.Id .. ": slot belongs to another category")
		end
		if not Catalog.Rarities[entry.Rarity] then
			table.insert(problems, entry.Id .. ": unknown rarity")
		end
		if entry.VipOnly then
			if entry.Price ~= 0 or entry.Rarity ~= "VIP" then
				table.insert(problems, entry.Id .. ": VIP items are free with VIP and marked VIP")
			end
		elseif type(entry.Price) ~= "number" or entry.Price <= 0 or entry.Price % 1 ~= 0 then
			table.insert(problems, entry.Id .. ": needs a positive whole price")
		end
		if entry.Slot == "Hair" and not entry.Face then
			table.insert(problems, entry.Id .. ": looks need a Face")
		elseif entry.Slot == "NameColor" and not (type(entry.Color) == "string" and entry.Color:match("^#%x%x%x%x%x%x$")) then
			table.insert(problems, entry.Id .. ": name colours need a #RRGGBB Color")
		elseif entry.Slot == "Title" and type(entry.Text) ~= "string" then
			table.insert(problems, entry.Id .. ": titles need Text")
		elseif entry.Slot == "Backdrop" and not (entry.Colors and #entry.Colors == 2) then
			table.insert(problems, entry.Id .. ": themes need two Colors")
		elseif entry.Slot == "RevealEffect" and not (entry.Glyphs and #entry.Glyphs >= 1) then
			table.insert(problems, entry.Id .. ": reveal effects need Glyphs")
		elseif entry.Slot == "Aura" and not (entry.Aura and entry.Aura.Kind) then
			table.insert(problems, entry.Id .. ": auras need Aura settings")
		end
	end
	return problems
end

return Catalog
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Challenges</string>
            <string name="Source"><![CDATA[--[[
	Challenges  (ReplicatedStorage.Shared.Data.Challenges)
	Daily and weekly challenge pools. Each day (UTC) everyone gets the same
	Config.DailyChallengeCount challenges from the Daily pool, and each week
	(Monday to Sunday, UTC) Config.WeeklyChallengeCount from the Weekly pool.
	A challenge with Possible(lifetime) is skipped for anyone who can no
	longer do it (for example, they've already been to every district); they
	get the next one in that day's order instead.

	A challenge watches one or more Lifetime counters (or sets, which count
	new entries). Progress = how much they grew since the challenge began,
	so only things you do after it starts count. Rewards are Coins, granted
	automatically by ChallengeService when the target is reached.
]]

local NPCs = require(script.Parent.NPCs)
local World = require(script.Parent.World)

local Challenges = {}

local function size(set): number
	local n = 0
	for _ in pairs(type(set) == "table" and set or {}) do
		n += 1
	end
	return n
end

local TOWNSPEOPLE = #NPCs.List + #NPCs.Walkers

Challenges.Daily = {
	{ Id = "D_Decisions", Icon = "🧭", Text = "Make 5 decisions", Counter = { "DecisionsMade" }, Target = 5, Coins = 40 },
	{ Id = "D_World", Icon = "🌆", Text = "Do 3 things around Lifeville", Counter = { "WorldActions" }, Target = 3, Coins = 40 },
	{ Id = "D_Talk", Icon = "💬", Text = "Talk to 2 townspeople you haven't met", Counter = { "NPCsTalked" }, Target = 2, Coins = 30, Possible = function(lifetime)
		return size(lifetime.NPCsTalked) + 2 <= TOWNSPEOPLE
	end },
	{ Id = "D_Stage", Icon = "🎒", Text = "Finish a life stage", Counter = { "StagesCompleted" }, Target = 1, Coins = 50 },
	{ Id = "D_Coins", Icon = "🪙", Text = "Earn 60 Coins by playing", Counter = { "PlayCoins" }, Target = 60, Coins = 30 },
	{ Id = "D_Wish", Icon = "⛲", Text = "Make a wish at the Plaza fountain", Counter = { "Wishes" }, Target = 1, Coins = 25 },
	{ Id = "D_Shift", Icon = "💼", Text = "Work an extra shift at your workplace", Counter = { "ShiftsWorked" }, Target = 1, Coins = 40 },
	{ Id = "D_Social", Icon = "🤝", Text = "Join a group decision or a city event", Counter = { "GroupDecisions", "CityEvents" }, Target = 1, Coins = 40 },
	{ Id = "D_Explore", Icon = "🗺️", Text = "Visit a district you've never been to", Counter = { "DistrictsVisited" }, Target = 1, Coins = 30, Possible = function(lifetime)
		return size(lifetime.DistrictsVisited) < #World.Districts
	end },
}

Challenges.Weekly = {
	{ Id = "W_Decisions", Icon = "🧭", Text = "Make 40 decisions", Counter = { "DecisionsMade" }, Target = 40, Coins = 200 },
	{ Id = "W_Life", Icon = "🏁", Text = "Complete a life", Counter = { "LivesCompleted" }, Target = 1, Coins = 250 },
	{ Id = "W_World", Icon = "🌆", Text = "Do 20 things around Lifeville", Counter = { "WorldActions" }, Target = 20, Coins = 180 },
	{ Id = "W_Stages", Icon = "🎒", Text = "Finish 4 life stages", Counter = { "StagesCompleted" }, Target = 4, Coins = 200 },
	{ Id = "W_Shifts", Icon = "💼", Text = "Work 6 extra shifts", Counter = { "ShiftsWorked" }, Target = 6, Coins = 160 },
	{ Id = "W_Social", Icon = "🤝", Text = "Join 3 group decisions or city events", Counter = { "GroupDecisions", "CityEvents" }, Target = 3, Coins = 160 },
	{ Id = "W_Coins", Icon = "🪙", Text = "Earn 400 Coins by playing", Counter = { "PlayCoins" }, Target = 400, Coins = 150 },
	{ Id = "W_Twist", Icon = "🌀", Text = "Live through a Life Reveal twist", Counter = { "TwistsSeen" }, Target = 1, Coins = 150 },
}

Challenges.ById = {}
for _, list in ipairs({ Challenges.Daily, Challenges.Weekly }) do
	for _, c in ipairs(list) do
		Challenges.ById[c.Id] = c
	end
end

-- UTC day number and Monday-starting week number for a Unix time.
function Challenges.DayOf(unixTime: number): number
	return math.floor(unixTime / 86400)
end

function Challenges.WeekOf(day: number): number
	return math.floor((day + 3) / 7) -- 1 Jan 1970 was a Thursday
end

-- The challenge ids for a given day / week: the same order for every player.
-- With `lifetime`, challenges that player can no longer do are skipped.
local function pick(pool, count: number, seed: number, lifetime)
	local ids = {}
	for _, c in ipairs(pool) do
		table.insert(ids, c.Id)
	end
	local rng = Random.new(seed)
	for i = #ids, 2, -1 do
		local j = rng:NextInteger(1, i)
		ids[i], ids[j] = ids[j], ids[i]
	end
	local out = {}
	for _, id in ipairs(ids) do
		if #out >= count then
			break
		end
		local def = Challenges.ById[id]
		if not (lifetime and def.Possible and not def.Possible(lifetime)) then
			table.insert(out, id)
		end
	end
	table.sort(out)
	return out
end

function Challenges.ForDay(day: number, count: number, lifetime: any?)
	return pick(Challenges.Daily, count, day * 7919 + 13, lifetime)
end

function Challenges.ForWeek(week: number, count: number, lifetime: any?)
	return pick(Challenges.Weekly, count, week * 104729 + 7, lifetime)
end

-- Current value of a challenge's counters (sets count their entries).
function Challenges.CounterValue(def, lifetime): number
	local total = 0
	for _, key in ipairs(def.Counter) do
		local value = lifetime and lifetime[key]
		if type(value) == "table" then
			for _ in pairs(value) do
				total += 1
			end
		else
			total += tonumber(value) or 0
		end
	end
	return total
end

-- progress, target for an active challenge entry { Base, Done }.
function Challenges.Progress(def, entry, lifetime): (number, number)
	if entry and entry.Done then
		return def.Target, def.Target
	end
	local base = entry and entry.Base or 0
	return math.clamp(Challenges.CounterValue(def, lifetime) - base, 0, def.Target), def.Target
end

return Challenges
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Collectibles</string>
            <string name="Source"><![CDATA[--[[
	Collectibles  (ReplicatedStorage.Shared.Data.Collectibles)
	Memory Stars: 20 glowing stars hidden around Lifeville. The district
	builders place each one (Builder.Star); CollectibleService checks you're
	really next to one before it counts. Each star is found once per
	account and pays Coins; finding them all is an achievement, and one is
	a secret. Stars in districts that open later are behind their walls
	until then.
]]

local Collectibles = {}

Collectibles.Coins = 15

Collectibles.List = {
	{ Id = "Star_HallOfLives", District = "Plaza", Hint = "Behind the Hall of Lives." },
	{ Id = "Star_Arch", District = "Plaza", Hint = "At the foot of the welcome arch." },
	{ Id = "Star_Goal", District = "School", Hint = "Behind a goal on the sports field." },
	{ Id = "Star_Library", District = "School", Hint = "Among the school library's shelves." },
	{ Id = "Star_Statue", District = "University", Hint = "Behind the founder's statue." },
	{ Id = "Star_Union", District = "University", Hint = "In the student union." },
	{ Id = "Star_BusStop", District = "Downtown", Hint = "Waiting at the bus stop." },
	{ Id = "Star_Arcade", District = "Downtown", Hint = "Next to an arcade machine." },
	{ Id = "Star_ClockTower", District = "CareerRow", Hint = "Behind the town hall's clock tower." },
	{ Id = "Star_Booth", District = "CareerRow", Hint = "In the recording booth." },
	{ Id = "Star_Helipad", District = "Hospital", Hint = "On the helipad." },
	{ Id = "Star_Ward", District = "Hospital", Hint = "Beside a hospital bed." },
	{ Id = "Star_Pond", District = "Park", Hint = "On the far side of the duck pond." },
	{ Id = "Star_Stands", District = "Park", Hint = "At the top of the arena stands." },
	{ Id = "Star_Picnic", District = "Park", Hint = "Under a picnic table." },
	{ Id = "Star_Stairs", District = "Residential", Hint = "At the top of the apartment stairs." },
	{ Id = "Star_Hedge", District = "Residential", Hint = "Behind the hedges at the end of Oak Street." },
	{ Id = "Star_Lighthouse", District = "Harbour", Hint = "Swim out to the lighthouse.", Secret = "S_Lighthouse" },
	{ Id = "Star_Pier", District = "Harbour", Hint = "At the very end of the pier." },
	{ Id = "Star_Pool", District = "Harbour", Hint = "By the pool on Hilltop." },
}

Collectibles.ById = {}
for _, star in ipairs(Collectibles.List) do
	Collectibles.ById[star.Id] = star
end
Collectibles.Total = #Collectibles.List

return Collectibles
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">DataTemplate</string>
            <string name="Source"><![CDATA[--[[
	DataTemplate  (ReplicatedStorage.Shared.Data.DataTemplate)
	The saved-data schema, new-life factory and version migrations.

	Shape of a saved profile (all keys are strings so it is DataStore-safe):

	Profile
	├─ Version            schema version, see DataTemplate.CurrentVersion
	├─ Coins              meta currency spent in the shop (persists across lives)
	├─ ActiveSlot         "Slot1" | "Slot2" | "Slot3"
	├─ Slots              { Slot1 = Life | false, ... }  (false = empty slot)
	├─ LifeHistory        array of completed-life summaries (capped)
	├─ Inventory          { Owned = { [itemId] = true }, Equipped = { [slot] = itemId } } (Data/Catalog)
	├─ Passes             game pass ownership (from Roblox on every join)
	├─ PassesUnverified   in-game pass purchases Roblox hasn't confirmed yet
	├─ Achievements       { [achievementId] = unlockUnixTime }
	├─ Collectibles       { [collectibleId] = true }
	├─ Daily              login streak / daily reward state
	├─ Challenges         daily + weekly challenge progress
	├─ Lifetime           totals across every life (for profiles + leaderboards)
	├─ Settings           client preferences (validated on the server)
	├─ Privacy            what friends may see in comparisons
	├─ Tutorial           onboarding progress
	├─ BadgesAwarded      Roblox badges already awarded
	├─ TradeLog           recent cosmetic trades (for support)
	├─ ProcessedTrades    recent trade ids (duplicate guard)
	└─ ProcessedReceipts  recent developer-product receipt ids (duplicate guard)
]]

local Config = require(script.Parent.Parent.Config)
local StatDefinitions = require(script.Parent.StatDefinitions)
local TableUtil = require(script.Parent.Parent.Util.TableUtil)
local StatMath = require(script.Parent.Parent.Util.StatMath)
local People = require(script.Parent.Parent.Util.People)

local DataTemplate = {}

DataTemplate.CurrentVersion = 2

DataTemplate.SlotIds = {}
for i = 1, Config.SaveSlotCount do
	table.insert(DataTemplate.SlotIds, "Slot" .. i)
end

DataTemplate.DefaultSettings = {
	MusicVolume = 0.5, -- 0..1
	SfxVolume = 0.7, -- 0..1
	Graphics = "Auto", -- "Auto" | "Low" | "High"
	UIScale = 1, -- 0.75..1.25
	CameraSensitivity = 1, -- 0.2..2
	Notifications = true,
	ReduceAnimations = false,
}

DataTemplate.DefaultPrivacy = {
	ShareStats = "Friends", -- "Everyone" | "Friends" | "Nobody"
	ShareReveals = "Friends",
	ShareHistory = "Friends",
}

local profileTemplate = {
	Version = DataTemplate.CurrentVersion,
	Coins = Config.StartingCoins,
	ActiveSlot = "Slot1",
	Slots = {},
	LifeHistory = {},
	Inventory = { Owned = {}, Equipped = {} }, -- cosmetics: Owned[itemId] = true, Equipped[slot] = itemId
	Passes = {}, -- game pass ownership { VIP = true, CoinBooster = true }, from Roblox on every join
	PassesUnverified = {}, -- passes bought in this session that Roblox hasn't confirmed yet (re-checked on join)
	Achievements = {}, -- { [achievementId] = unlock time } (Data/Achievements)
	BadgesAwarded = {}, -- { [badgeId] = true } Roblox badges already given (Data/Badges)
	Collectibles = {}, -- { [starId] = true } Memory Stars found in Lifeville
	Daily = { LastClaimDay = 0, Streak = 0, BestStreak = 0 },
	Challenges = { DailyDay = 0, Daily = {}, WeeklyWeek = 0, Weekly = {} },
	Lifetime = {
		LivesStarted = 0,
		LivesCompleted = 0,
		DecisionsMade = 0,
		CoinsEarned = 0,
		CoinsBought = 0,
		CoinsSpent = 0,
		HighestNetWorth = 0,
		RareEventsSeen = 0,
		FirstJoin = 0,
		-- Phase 9 (achievements, challenges, profiles, leaderboards)
		PlayCoins = 0, -- coins earned by playing (stages, lives, events), for challenges
		StagesCompleted = 0,
		TwistsSeen = 0,
		TopCareerLevel = 0,
		InvestActions = 0,
		LoansRepaid = 0,
		WorldActions = 0,
		ShiftsWorked = 0,
		Wishes = 0,
		Trips = 0,
		CirclesJoined = 0,
		GroupDecisions = 0,
		CityEvents = 0,
		TradesCompleted = 0,
		ChallengesCompleted = 0,
		DailyClaims = 0,
		Rebirths = 0,
		CareersHeld = {}, -- { [careerId] = true }
		AssetsOwned = {}, -- { [assetId] = true } homes and cars owned in any life
		EndingsSeen = {}, -- { [endingId] = true }
		NPCsTalked = {}, -- { [npcId] = true }
		DistrictsVisited = {}, -- { [districtId] = true }
	},
	TradeLog = {}, -- recent trades { Id, With, Gave, Got, Time } (capped)
	ProcessedTrades = {}, -- recent trade ids (duplicate guard)
	Settings = DataTemplate.DefaultSettings,
	Privacy = DataTemplate.DefaultPrivacy,
	Tutorial = { Completed = false, Step = 0 },
	ProcessedReceipts = {},
}
for _, slotId in ipairs(DataTemplate.SlotIds) do
	profileTemplate.Slots[slotId] = false
end

function DataTemplate.NewProfile()
	local profile = TableUtil.DeepCopy(profileTemplate)
	profile.Lifetime.FirstJoin = os.time()
	return profile
end

--[[
	A single life. Lives inside Profile.Slots[slotId].
	`Seed` drives this life's random events so results are reproducible for
	debugging; the server owns it and never trusts a client-supplied seed.
]]
function DataTemplate.NewLife(name: string, seed: number)
	local stats = {}
	for _, statName in ipairs(StatDefinitions.Order) do
		stats[statName] = Config.StatStart
	end
	-- Wealth is always derived from net worth (see StatMath.WealthFromNetWorth).
	stats.Wealth = StatMath.WealthFromNetWorth(Config.StartingMoney)

	local life = {
		Name = name,
		Seed = seed,
		StartedAt = os.time(),
		Age = 5,
		Stage = 1,
		ScenarioIndex = 0, -- scenarios completed in the current stage
		Stats = stats,
		Money = Config.StartingMoney,
		Assets = {}, -- { [assetId] = true } houses, cars bought in-life
		Career = { Id = "None", Level = 0, YearsInRole = 0 },
		PeakSalary = 0, -- highest yearly salary reached (sets the retirement pension)
		PeakCareerLevel = 0, -- highest career level ever reached (1–5)
		BestCareer = false, -- { Id, Level } best career ever held
		HistoryId = false, -- LifeHistory id once this life is completed
		Education = "None",
		Relationships = { Partner = false, Married = false, Children = 0, Friends = 0 },
		Traits = {}, -- { [traitId] = strength } personality built from choices
		Flags = {}, -- { [flagId] = true } story branches unlocked by decisions
		Decisions = {}, -- array of { Scenario, Choice, Age, Stage }
		Story = {}, -- array of short story lines for Life History
		Events = {}, -- array of random-event ids that happened
		Seen = {}, -- { [scenarioId] = true } scenarios already played this life
		Reveals = {}, -- array of Life Reveal snapshots per stage
		CurrentScenario = false, -- the scenario the server is waiting on, or false
		Completed = false,
		-- Phase 4: people, lifestyle and finances
		People = {}, -- array of Person (see Shared/Util/People)
		NextPersonId = 1,
		Focus = "Balanced", -- lifestyle focus (see Shared/Data/Lifestyle)
		Investments = 0, -- invested money (grows/shrinks with the market each year)
		Loans = {}, -- array of { Kind = "Student"|"Mortgage", Balance, Rate, Payment }
		ActionTurn = -1, -- decision count when ActionsUsed was last reset
		ActionsUsed = 0, -- People/Finance actions used since the last decision
		Shared = {}, -- moments shared with other players: { Title, Icon, With = {names}, Age } (capped)
	}
	-- Everyone starts with two parents.
	local rng = Random.new(seed % 2147483646 + 1)
	People.Add(life, "Parent", rng)
	People.Add(life, "Parent", rng)
	return life
end

--[[
	Migrations: Migrations[n] upgrades a profile from version n to n + 1.
	Add a new function whenever CurrentVersion is bumped; never edit old ones.
]]
DataTemplate.Migrations = {
	-- v1 → v2: lives gained named People, Focus, Investments and Loans.
	-- Build People from the old counters so existing partners/children keep existing.
	[1] = function(profile)
		for _, life in pairs(profile.Slots or {}) do
			if type(life) == "table" and life.People == nil then
				local rel = life.Relationships or { Partner = false, Married = false, Children = 0, Friends = 0 }
				local counts = { Partner = rel.Partner, Married = rel.Married, Children = rel.Children or 0, Friends = rel.Friends or 0 }
				life.Relationships = rel
				life.People = {}
				life.NextPersonId = 1
				life.Age = life.Age or 30
				life.Name = life.Name or "You"
				local rng = Random.new(((life.Seed or 1) % 2147483646) + 1)
				People.Add(life, "Parent", rng)
				People.Add(life, "Parent", rng)
				if counts.Partner then
					local partner = People.Add(life, "Partner", rng)
					partner.Married = counts.Married == true
				end
				for _ = 1, math.min(counts.Children, 12) do
					local child = People.Add(life, "Child", rng)
					child.BornAge = math.max(0, life.Age - 5)
				end
				for _ = 1, math.min(counts.Friends, People.MaxFriends) do
					People.Add(life, "Friend", rng)
				end
				People.Sync(life)
			end
		end
	end,
}

--[[
	Brings any loaded profile up to date:
	  1. run migrations from its version to CurrentVersion
	  2. fill any keys added to the template since it was saved
	Returns the profile (mutated in place) or nil + reason if unusable.
]]
function DataTemplate.Upgrade(profile: any)
	if type(profile) ~= "table" then
		return nil, "profile is not a table"
	end
	local version = tonumber(profile.Version) or 1
	if version > DataTemplate.CurrentVersion then
		-- Saved by a newer server build. Refuse rather than corrupt it.
		return nil, ("profile version %d is newer than server version %d"):format(version, DataTemplate.CurrentVersion)
	end
	while version < DataTemplate.CurrentVersion do
		local migrate = DataTemplate.Migrations[version]
		if not migrate then
			return nil, "missing migration for version " .. version
		end
		migrate(profile)
		version += 1
		profile.Version = version
	end
	TableUtil.Reconcile(profile, profileTemplate)

	-- Reconcile active lives too, so lives saved before new fields existed keep working.
	local lifeTemplate = DataTemplate.NewLife("", 0)
	for _, slotId in ipairs(DataTemplate.SlotIds) do
		local life = profile.Slots[slotId]
		if type(life) == "table" then
			TableUtil.Reconcile(life, lifeTemplate)
		elseif life ~= false then
			profile.Slots[slotId] = false
		end
	end
	if profile.Slots[profile.ActiveSlot] == nil then
		profile.ActiveSlot = DataTemplate.SlotIds[1]
	end
	return profile
end

return DataTemplate
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Leaderboards</string>
            <string name="Source"><![CDATA[--[[
	Leaderboards  (ReplicatedStorage.Shared.Data.Leaderboards)
	The boards shown in 🏆 Leaderboards (global and friends) and on the Hall
	of Fame in Lifeville Plaza. Value(data) is what a player scores, read
	from their saved profile by the server (never sent by a client).
]]

local Leaderboards = {}

local function count(set): number
	local n = 0
	for _ in pairs(set or {}) do
		n += 1
	end
	return n
end

Leaderboards.List = {
	{ Id = "LivesCompleted", Name = "Lives lived", Icon = "🏁", Value = function(data)
		return data.Lifetime.LivesCompleted or 0
	end },
	{ Id = "HighestNetWorth", Name = "Richest life", Icon = "💰", Money = true, Value = function(data)
		return math.floor(data.Lifetime.HighestNetWorth or 0)
	end },
	{ Id = "Achievements", Name = "Achievements", Icon = "🏆", Value = function(data)
		return count(data.Achievements)
	end },
	{ Id = "BestStreak", Name = "Best login streak", Icon = "🔥", Value = function(data)
		return data.Daily.BestStreak or 0
	end },
	{ Id = "Stars", Name = "Memory Stars", Icon = "⭐", Value = function(data)
		return count(data.Collectibles)
	end },
}

Leaderboards.ById = {}
for _, board in ipairs(Leaderboards.List) do
	Leaderboards.ById[board.Id] = board
end

Leaderboards.HallOfFame = "LivesCompleted" -- the board shown in the Plaza

return Leaderboards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Legacy</string>
            <string name="Source"><![CDATA[--[[
	Legacy  (ReplicatedStorage.Shared.Data.Legacy)
	Rebirth: every life you complete raises your Legacy level and unlocks
	perks. When you start a new life you can be "reborn" with one unlocked
	perk, a small head start inherited from your past lives. Perks are
	earned by playing only (never sold) and stay modest so every life is
	still decided by its choices.
]]

local Legacy = {}

Legacy.Perks = {
	{ Id = "HeadStart", Name = "Head Start", Icon = "📚", Lives = 1, Description = "Start with +5 Intelligence.", Stats = { Intelligence = 5 } },
	{ Id = "StrongGenes", Name = "Strong Genes", Icon = "💪", Lives = 1, Description = "Start with +5 Health.", Stats = { Health = 5 } },
	{ Id = "SunnyStart", Name = "Sunny Disposition", Icon = "😊", Lives = 2, Description = "Start with +5 Happiness.", Stats = { Happiness = 5 } },
	{ Id = "PopularKid", Name = "Popular Kid", Icon = "⭐", Lives = 2, Description = "Start with +5 Popularity.", Stats = { Popularity = 5 } },
	{ Id = "FamilyFortune", Name = "Family Fortune", Icon = "💰", Lives = 3, Description = "Start with $500 in savings.", Money = 500 },
	{ Id = "GoodName", Name = "A Good Name", Icon = "🏅", Lives = 4, Description = "Start with +5 Reputation.", Stats = { Reputation = 5 } },
	{ Id = "OldSoul", Name = "Old Soul", Icon = "🦉", Lives = 6, Description = "Start with +3 to every stat.", Stats = { Happiness = 3, Intelligence = 3, Health = 3, Popularity = 3, Relationships = 3, Reputation = 3, Career = 3 } },
}

Legacy.ById = {}
for _, perk in ipairs(Legacy.Perks) do
	Legacy.ById[perk.Id] = perk
end

function Legacy.Level(livesCompleted: number): number
	return math.max(0, math.floor(livesCompleted or 0))
end

function Legacy.IsUnlocked(perkId: any, livesCompleted: number): boolean
	local perk = type(perkId) == "string" and Legacy.ById[perkId]
	return perk ~= nil and perk ~= false and (livesCompleted or 0) >= perk.Lives
end

function Legacy.Unlocked(livesCompleted: number)
	local list = {}
	for _, perk in ipairs(Legacy.Perks) do
		if (livesCompleted or 0) >= perk.Lives then
			table.insert(list, perk)
		end
	end
	return list
end

return Legacy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">LifeStages</string>
            <string name="Source"><![CDATA[--[[
	LifeStages  (ReplicatedStorage.Shared.Data.LifeStages)
	The six major life stages. A stage ends with a Life Reveal (Phase 5).
	ScenariosPerStage is how many decisions a player makes before the stage's reveal.
]]

local LifeStages = {}

LifeStages.List = {
	{ Id = 1, Key = "Childhood", DisplayName = "Childhood", MinAge = 5, MaxAge = 12, ScenariosPerStage = 6, Color = Color3.fromRGB(255, 196, 87) },
	{ Id = 2, Key = "Teen", DisplayName = "Teenage Years", MinAge = 13, MaxAge = 18, ScenariosPerStage = 7, Color = Color3.fromRGB(255, 120, 170) },
	{ Id = 3, Key = "YoungAdult", DisplayName = "Young Adulthood", MinAge = 19, MaxAge = 25, ScenariosPerStage = 7, Color = Color3.fromRGB(110, 170, 255) },
	{ Id = 4, Key = "Adult", DisplayName = "Adulthood", MinAge = 26, MaxAge = 40, ScenariosPerStage = 7, Color = Color3.fromRGB(90, 210, 150) },
	{ Id = 5, Key = "MiddleAge", DisplayName = "Middle Age", MinAge = 41, MaxAge = 60, ScenariosPerStage = 6, Color = Color3.fromRGB(190, 130, 255) },
	{ Id = 6, Key = "Retirement", DisplayName = "Retirement", MinAge = 61, MaxAge = 85, ScenariosPerStage = 5, Color = Color3.fromRGB(240, 170, 110) },
}

LifeStages.Count = #LifeStages.List

function LifeStages.Get(id: number)
	return LifeStages.List[id]
end

-- Returns the stage containing `age`, clamped to the first/last stage.
function LifeStages.ForAge(age: number)
	for _, stage in ipairs(LifeStages.List) do
		if age <= stage.MaxAge then
			return stage
		end
	end
	return LifeStages.List[#LifeStages.List]
end

--[[
	Age the player should be after completing `scenarioIndex` (1-based) of `stageId`.
	Ages advance evenly across the stage so the final scenario lands on MaxAge.
]]
function LifeStages.AgeAfterScenario(stageId: number, scenarioIndex: number): number
	local stage = LifeStages.List[stageId]
	local span = stage.MaxAge - stage.MinAge
	local fraction = math.clamp(scenarioIndex / stage.ScenariosPerStage, 0, 1)
	return stage.MinAge + math.floor(span * fraction + 0.5)
end

return LifeStages
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Lifestyle</string>
            <string name="Source"><![CDATA[--[[
	Lifestyle  (ReplicatedStorage.Shared.Data.Lifestyle)
	The player's lifestyle focus: what they prioritise as the years pass.
	Chosen any time from the HUD (🎯). Applied by the server every simulated
	year (Lib/Yearly); shared so the client can describe each option.

	PerYear: stat changes per year. BondDecay: change to yearly bond decay
	(negative = bonds grow). SavingsBonus adds to the savings rate.
	PromotionMultiplier scales the automatic promotion chance.
	Under 19, "Career" focus means schoolwork and boosts Intelligence instead.
]]

local Lifestyle = {}

Lifestyle.Order = { "Balanced", "Career", "Family", "Health", "Social", "Money" }

Lifestyle.Info = {
	Balanced = {
		Icon = "⚖️", Title = "Balanced", Description = "A bit of everything. Steady and content.",
		PerYear = { Happiness = 0.3, Health = 0.2 },
	},
	Career = {
		Icon = "💼", Title = "Career / School", Description = "Work hard and climb faster. Relationships and health suffer a little.",
		PerYear = { Career = 1.5, Health = -0.4 }, YouthPerYear = { Intelligence = 1.2, Happiness = -0.2 },
		BondDecay = { All = 1 }, PromotionMultiplier = 1.6,
	},
	Family = {
		Icon = "🏡", Title = "Family", Description = "Put loved ones first. Family bonds grow stronger; career slows.",
		PerYear = { Happiness = 0.4, Career = -0.5 },
		BondDecay = { Partner = -3, Child = -3, Parent = -3, Sibling = -3 }, PromotionMultiplier = 0.7,
	},
	Health = {
		Icon = "💪", Title = "Health", Description = "Exercise, sleep, eat well. Health improves every year.",
		PerYear = { Health = 1.5, Happiness = 0.2 },
	},
	Social = {
		Icon = "🎉", Title = "Social Life", Description = "Friends, parties, networking. Friendships and popularity grow.",
		PerYear = { Popularity = 1, Happiness = 0.3, Intelligence = -0.2 },
		BondDecay = { Friend = -4, BestFriend = -4 },
	},
	Money = {
		Icon = "💰", Title = "Save Money", Description = "Live frugally and save much more. Life is a bit less fun.",
		PerYear = { Happiness = -0.4 }, SavingsBonus = 0.08, MinAge = 16,
	},
}

function Lifestyle.IsValid(id: any): boolean
	return type(id) == "string" and Lifestyle.Info[id] ~= nil
end

function Lifestyle.Available(id: string, age: number): boolean
	local info = Lifestyle.Info[id]
	return info ~= nil and age >= (info.MinAge or 0)
end

return Lifestyle
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Monetisation</string>
            <string name="Source"><![CDATA[--[[
	Monetisation  (ReplicatedStorage.Shared.Data.Monetisation)
	Real Robux purchases through Roblox's MarketplaceService. Nothing is
	faked: prices shown in the game come from Roblox itself, purchases use
	Roblox's own purchase prompt, and everything is granted by the server
	only after Roblox confirms it (Services/StoreService).

	HOW TO SET UP (once, after publishing the game):
	  1. Creator Dashboard (create.roblox.com) → your experience →
	     Monetization → Passes → create "VIP" and "2× Coins" passes, set a price.
	  2. Monetization → Developer Products → create the coin packs below.
	  3. Paste each Id here. Anything left at 0 is simply hidden in the game.

	Fair play: everything you can buy is cosmetic or speeds up earning
	cosmetic Coins. Nothing affects a life's choices, stats or outcomes.
]]

return {
	Passes = {
		VIP = {
			Id = 0, -- paste your VIP game pass id
			Name = "VIP",
			Icon = "⭐",
			Description = "6 exclusive VIP cosmetics (Crown, Golden Robes, Grand Manor, Unicorn, Golden Aura, VIP title).",
		},
		CoinBooster = {
			Id = 0, -- paste your 2× Coins game pass id
			Name = "2× Coins",
			Icon = "🪙",
			Description = "Earn double Coins from playing (completing stages and lives, group and city events).",
		},
	},
	PassOrder = { "VIP", "CoinBooster" },

	Products = {
		{ Key = "CoinsSmall", Id = 0, Coins = 500, Name = "Pocket of Coins", Icon = "🪙" },
		{ Key = "CoinsMedium", Id = 0, Coins = 1500, Name = "Bag of Coins", Icon = "💰" },
		{ Key = "CoinsLarge", Id = 0, Coins = 4000, Name = "Chest of Coins", Icon = "🧰" },
	},
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">NPCs</string>
            <string name="Source"><![CDATA[--[[
	NPCs  (ReplicatedStorage.Shared.Data.NPCs)
	The people of Lifeville: names, looks, what they say and what they can do
	for you. District builders place each one (NPC anchors); NPCService spawns
	them; DialogueController shows their lines.

	Lines: by life stage key (Childhood, Teen, YoungAdult, Adult, MiddleAge,
	Retirement) with Default as the fallback; Career lines win when the
	player's career matches. Options:
	  { Text, Reply }            just a reply
	  { Text, Spot = id }        do a world action (WorldSpots) right here
	  { Text, Open = screen }    Shop / Money / Map / SlotSelect / People / Future
	  { Text, Guide = district } point the way (map waypoint)
	  { Text, Tip = true }       a helpful tip about the game
	  MinAge / MaxAge on an option hide it for other ages (the server still checks).
]]

local NPCs = {}

-- Looks: Skin/Shirt/Pants hex colours, Hair colour + style, optional Hat.
local SKIN = { "#F1C27D", "#E0AC69", "#C68642", "#8D5524", "#FFDBAC", "#A0662F" }

NPCs.List = {
	-- ===== Plaza =====
	{ Id = "Mayor", Name = "Mayor Bloom", Role = "Mayor of Lifeville", Icon = "🎩", Anim = "Wave",
		Looks = { Skin = SKIN[1], Shirt = "#3D405B", Pants = "#22223B", Hair = "#B0B0B0", HairStyle = "Short", Hat = "Top" },
		Lines = {
			Default = "Welcome to Lifeville! Every choice you make shapes your future, and this town grows with you.",
			Childhood = "Hello there, young one! The school, the park, Oak Street and the hospital are all open to you. More of town opens as you grow up!",
			Teen = "Downtown and the harbour are open to you now. Grab a milkshake, but don't forget your studies!",
			Retirement = "Ah, a wise resident! The Sunset Club in Willow Park has opened its doors to you.",
		},
		Options = {
			{ Text = "What can I do around town?", Reply = "Walk up to things and people. You get 2 actions between decisions: study, exercise, eat out, work a shift... Then press 📝 Next decision." },
			{ Text = "Show me the town map", Open = "Map" },
			{ Text = "Any tips?", Tip = true },
		} },
	{ Id = "Keeper", Name = "Sage the Keeper", Role = "Keeper of the Hall of Lives", Icon = "🌟", Anim = "Idle",
		Looks = { Skin = SKIN[4], Shirt = "#6A4C93", Pants = "#3C2A4D", Hair = "#1B1B1B", HairStyle = "Long" },
		Lines = { Default = "Every life you live is kept here, in the Hall of Lives. Which life will you live today?" },
		Options = {
			{ Text = "Choose a life", Open = "SlotSelect" },
			{ Text = "What are the pedestals?", Reply = "One for each of your three save slots. Continue a life, or begin a brand new one." },
		} },
	{ Id = "Busker", Name = "Jay the Busker", Role = "Street musician", Icon = "🎸", Anim = "Dance",
		Looks = { Skin = SKIN[3], Shirt = "#F4A261", Pants = "#264653", Hair = "#3B2F2F", HairStyle = "Short", Hat = "Cap" },
		Lines = { Default = "Every street has a song! Mine's just a bit louder.", Career = { Musician = "A fellow musician! Fancy a jam later?", Singer = "That voice of yours could fill a stadium." } },
		Options = {
			{ Text = "How do I become a musician?", Reply = "Pick music when it comes up in your choices. Open-mic night at Starlight Studios helps too!" },
			{ Text = "Where's Starlight Studios?", Guide = "CareerRow" },
		} },

	-- ===== Maple School =====
	{ Id = "Teacher", Name = "Ms. Rivera", Role = "Teacher", Icon = "🍎", Anim = "Point",
		Looks = { Skin = SKIN[2], Shirt = "#E76F51", Pants = "#3D405B", Hair = "#5A3825", HairStyle = "Bun" },
		Lines = {
			Default = "Learning never stops. Not even when you're grown up!",
			Childhood = "Good morning! Studying at your desk raises your Intelligence, and the playground makes you happy.",
			Teen = "Exams are coming. A little studying now opens doors later, like university.",
			Career = { Teacher = "Morning, colleague! The staff room needs you for an extra class." },
		},
		Options = {
			{ Text = "Help me study", Spot = "School_Study", MaxAge = 18 },
			{ Text = "How do I get into university?", Reply = "Keep your Intelligence up and choose university in your teenage decisions." },
		} },
	{ Id = "Librarian", Name = "Mr. Chen", Role = "Librarian", Icon = "📖", Anim = "Idle",
		Looks = { Skin = SKIN[5], Shirt = "#2A9D8F", Pants = "#264653", Hair = "#2B2B2B", HairStyle = "Short" },
		Lines = { Default = "Shh... A good book is the best adventure there is." },
		Options = { { Text = "Recommend me a book", Spot = "School_Library" } } },
	{ Id = "Coach", Name = "Coach Okafor", Role = "Sports coach", Icon = "⚽", Anim = "Point",
		Looks = { Skin = SKIN[4], Shirt = "#E63946", Pants = "#1D3557", HairStyle = "Bald", Hat = "Cap" },
		Lines = { Default = "Sport keeps you healthy and makes you friends. Get out there!", Career = { Athlete = "There's my star! The arena team is lucky to have you." } },
		Options = { { Text = "Put me in the game", Spot = "School_Football" } } },

	-- ===== Lifeville University =====
	{ Id = "Professor", Name = "Professor Hale", Role = "Professor", Icon = "🎓", Anim = "Point",
		Looks = { Skin = SKIN[1], Shirt = "#5E548E", Pants = "#231942", Hair = "#E0E0E0", HairStyle = "Short", Hat = "Grad" },
		Lines = {
			Default = "Curiosity is the engine of every great life.",
			YoungAdult = "Enrolled students can attend my lectures. Everyone else is welcome at evening classes.",
			Career = { Scientist = "Your research is the talk of the faculty!" },
		},
		Options = {
			{ Text = "Attend a lecture", Spot = "Uni_Lecture" },
			{ Text = "Tell me about evening classes", Reply = "From 19, anyone can take an evening class here for $150. It builds Intelligence and Career Success." },
		} },
	{ Id = "Student", Name = "Sam", Role = "Student", Icon = "🎒", Anim = "Idle",
