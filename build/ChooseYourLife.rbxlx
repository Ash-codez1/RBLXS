				Effects = { Career = "Influencer", Money = 5000, Stats = { Popularity = 8, Happiness = 4 }, Flags = { "CareerChosen" }, Story = "{name} signed the deal and became a full-time influencer." } },
			{ Id = "YouTuber", Text = "Go full-time on video", Description = "Your channel, your rules.",
				Effects = { Career = "YouTuber", Stats = { Popularity = 6, Happiness = 6 }, Flags = { "CareerChosen" }, Story = "{name} turned their channel into a full-time job." } },
			{ Id = "Decline", Text = "Turn it down", Description = "Keep it fun.",
				Effects = { Stats = { Reputation = 3, Popularity = -2 }, Story = "{name} turned the deal down and kept posting for fun." } },
		},
	},
	{
		Id = "Y_MovingOut", Stage = 3, Icon = "🔑", Title = "Moving Out",
		Description = "You can't live with your parents forever. Can you?",
		Once = true, Weight = 1.5,
		Choices = {
			{ Id = "Flat", Text = "Rent your own flat", Description = "Your space, your rules.",
				Effects = { Money = -2000, Stats = { Happiness = 6 }, Flags = { "OwnPlace" }, Story = "{name} got the keys to their very own flat." } },
			{ Id = "Share", Text = "Flatshare with friends", Description = "Cheaper and chaotic.",
				Effects = { Money = -800, Stats = { Relationships = 5, Happiness = 4 }, Bond = { Friend = 8, BestFriend = 8 }, Friends = 1, Story = "{name} moved into a flatshare with friends." } },
			{ Id = "Stay", Text = "Stay with your parents", Description = "Save money.",
				Effects = { Money = 3000, Stats = { Happiness = -3, Relationships = 2 }, Bond = { Parent = 6 }, Traits = { Thrifty = 1 }, Story = "{name} stayed at home and saved a lot of money." } },
			{ Id = "Buy", Text = "Buy a small apartment", Requires = { MinMoney = 60000 }, LockHint = "Requires $60,000", Description = "On the property ladder already!",
