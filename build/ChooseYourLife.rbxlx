		Priority = 7, Once = true, Requires = { Flags = { "AtUni" }, MinAge = 21 },
		Choices = {
			{ Id = "Honours", Text = "Graduate with top honours", Requires = { AnyFlags = { "FirstClass", "Scholarship" } }, LockHint = "Requires top marks at university", Description = "Best in your year.",
				Effects = { Education = "University", Stats = { Reputation = 6, Happiness = 6, Career = 5 }, ClearFlags = { "AtUni" }, Flags = { "Graduate", "Honours" }, Story = "{name} graduated with top honours." } },
			{ Id = "Graduate", Text = "Graduate and celebrate", Description = "Proud family, big party.",
				Effects = { Education = "University", Stats = { Happiness = 6, Relationships = 3 }, ClearFlags = { "AtUni" }, Flags = { "Graduate" }, Story = "{name} graduated, and their family cheered the loudest." } },
			{ Id = "Masters", Text = "Stay on for a research Master's", Requires = { MinStats = { Intelligence = 60 } }, LockHint = "Requires Intelligence 60+", Description = "Science is calling.",
				Effects = { Education = "Masters", Career = "Scientist", Money = -4000, Stats = { Intelligence = 7 }, ClearFlags = { "AtUni" }, Flags = { "Graduate", "CareerChosen" }, Story = "{name} stayed on to research, and was hired by the lab straight after." } },
			{ Id = "Trip", Text = "Graduate, then travel for a summer", Description = "One last adventure.",
				Effects = { Education = "University", Money = -1500, Stats = { Happiness = 8 }, Traits = { Adventurous = 1 }, ClearFlags = { "AtUni" }, Flags = { "Graduate" }, Story = "{name} graduated and spent the summer exploring Europe." } },
		},
	},
	{
		Id = "Y_CareerPro", Stage = 3, Icon = "💼", Title = "Graduate Careers Fair",
		Description = "Recruiters from hospitals, law firms and engineering companies want to meet you.",
		Priority = 6, Once = true, Requires = { MinEducation = "University", NotFlags = { "CareerChosen" }, MinAge = 21 },
		Choices = {
			{ Id = "Doctor", Text = "Train as a doctor", Requires = { MinStats = { Intelligence = 64 }, AnyFlags = { "MedicalInterest", "STEM", "Honours" } }, LockHint = "Requires Intelligence 64+ and a science or medical interest", Description = "Long hours, saving lives.",
				Effects = { Career = "Doctor", Stats = { Reputation = 6, Career = 6, Happiness = -1 }, Flags = { "CareerChosen" }, Story = "{name} began training as a doctor." } },
			{ Id = "Lawyer", Text = "Join a law firm", Requires = { MinStats = { Intelligence = 56 } }, LockHint = "Requires Intelligence 56+", Description = "Suits, cases, big money.",
				Effects = { Career = "Lawyer", Stats = { Career = 6, Reputation = 3 }, Flags = { "CareerChosen" }, Story = "{name} joined a city law firm as a junior lawyer." } },
			{ Id = "Engineer", Text = "Become an engineer", Requires = { AnyFlags = { "STEM", "TechTalent", "AppBuilder" } }, LockHint = "Requires a science or tech background", Description = "Build the future.",
				Effects = { Career = "Engineer", Stats = { Career = 6, Intelligence = 3 }, Flags = { "CareerChosen" }, Story = "{name} landed a graduate engineering job." } },
			{ Id = "Teacher", Text = "Train as a teacher", Description = "Inspire the next generation.",
				Effects = { Career = "Teacher", Stats = { Reputation = 5, Relationships = 3, Career = 4 }, Traits = { Kind = 1 }, Flags = { "CareerChosen" }, Story = "{name} trained as a teacher." } },
			{ Id = "Explore", Text = "Keep exploring", Description = "None of these feel right.",
				Effects = { Stats = { Happiness = 1 }, Flags = { "Explorer" }, Story = "{name} walked out of the careers fair still searching." } },
		},
	},
	{
		Id = "Y_CareerCreative", Stage = 3, Icon = "🎭", Title = "The Creative Path",
		Description = "An agent, a gallery owner and a talent manager have all seen your work. Do you go for it?",
		Priority = 5, Once = true,
		Requires = { NotFlags = { "CareerChosen" }, MinAge = 21, AnyFlags = { "MusicTalent", "Songwriter", "Performer", "StageStar", "Creative", "CrowdArts", "WritingTalent", "Published", "Arts" } },
		Choices = {
			{ Id = "Singer", Text = "Become a singer", Requires = { AnyFlags = { "MusicTalent", "Songwriter" } }, LockHint = "Requires a musical talent", Description = "Sign with a small label.",
				Effects = { Career = "Singer", Stats = { Popularity = 6, Happiness = 6 }, Flags = { "CareerChosen" }, Story = "{name} signed with a small record label." } },
			{ Id = "Actor", Text = "Become an actor", Requires = { AnyFlags = { "Performer", "StageStar" } }, LockHint = "Requires a performing background", Description = "Auditions, auditions, auditions.",
				Effects = { Career = "Actor", Stats = { Popularity = 5, Happiness = 4 }, Flags = { "CareerChosen" }, Story = "{name} got an agent and started auditioning." } },
			{ Id = "Artist", Text = "Become a full-time artist", Requires = { AnyFlags = { "Creative", "CrowdArts", "Arts", "WritingTalent", "Published" } }, LockHint = "Requires a creative background", Description = "Follow your art.",
				Effects = { Career = "Artist", Stats = { Happiness = 7 }, Flags = { "CareerChosen" }, Story = "{name} set up a studio and committed to their art." } },
			{ Id = "Hobby", Text = "Keep it as a hobby", Description = "Find a steadier path.",
				Effects = { Stats = { Happiness = -1, Career = 1 }, Flags = { "Explorer" }, Story = "{name} decided to keep their creative side as a hobby." } },
		},
	},
	{
		Id = "Y_CareerHustle", Stage = 3, Icon = "📊", Title = "A Business Idea",
		Description = "You've spotted a gap in the market. Friends say you'd be mad not to try.",
		Priority = 4, Once = true,
		Requires = { NotFlags = { "CareerChosen" }, MinAge = 21, AnyFlags = { "YoungEntrepreneur", "TeenHustler", "BusinessStudies", "AppBuilder", "AppHit", "Leader" } },
		Choices = {
			{ Id = "Startup", Text = "Launch a tech startup", Requires = { AnyFlags = { "AppBuilder", "TechTalent", "STEM", "AppHit" } }, LockHint = "Requires a tech background", Description = "High risk, high reward.",
				Effects = { Career = "Entrepreneur", Stats = { Career = 5, Happiness = 3, Health = -2 }, Traits = { Ambitious = 1 }, Flags = { "CareerChosen", "StartupFounder" }, Story = "{name} founded a tech startup from their bedroom.",
					Outcomes = { { Chance = 0.3, Money = 40000, Stats = { Reputation = 5 }, Story = "Investors loved it: $40,000 in seed funding!" } } } },
			{ Id = "Shop", Text = "Open a small shop", Description = "Your own little business.",
				Effects = { Career = "BusinessOwner", Money = -2000, Stats = { Career = 5, Happiness = 4 }, Flags = { "CareerChosen" }, Story = "{name} opened a small shop on the high street." } },
			{ Id = "Property", Text = "Get into property", Requires = { MinStats = { Popularity = 45 } }, LockHint = "Requires Popularity 45+", Description = "Start as an estate agent.",
				Effects = { Career = "RealEstate", Stats = { Career = 5 }, Flags = { "CareerChosen" }, Story = "{name} became an estate agent with big ambitions." } },
			{ Id = "Food", Text = "Start a food truck", Description = "Street food, big flavour.",
				Effects = { Career = "Chef", Money = -1500, Stats = { Happiness = 5, Career = 3 }, Flags = { "CareerChosen", "FoodTruck" }, Story = "{name} bought an old van and turned it into a food truck." } },
			{ Id = "Explore", Text = "Not yet; keep exploring", Description = "Maybe later.",
				Effects = { Stats = { Happiness = -1 }, Flags = { "Explorer" }, Story = "{name} shelved the business idea for now." } },
		},
	},
	{
		Id = "Y_CareerService", Stage = 3, Icon = "🧑‍💼", Title = "Job Interviews",
		Description = "You've applied everywhere. The offers are in. Which will you accept?",
		Priority = 3, Once = true, Requires = { NotFlags = { "CareerChosen" }, MinAge = 22 },
		Choices = {
			{ Id = "Police", Text = "Join the police", Requires = { MinStats = { Health = 40 } }, LockHint = "Requires Health 40+", Description = "Protect and serve.",
				Effects = { Career = "PoliceOfficer", Stats = { Reputation = 5, Career = 5, Health = 2 }, Traits = { Brave = 1 }, Flags = { "CareerChosen" }, Story = "{name} passed police training and became a constable." } },
			{ Id = "Chef", Text = "Train as a chef", Description = "Hot kitchens, great food.",
				Effects = { Career = "Chef", Stats = { Career = 4, Happiness = 3 }, Flags = { "CareerChosen" }, Story = "{name} started as a line cook in a busy restaurant." } },
			{ Id = "Athlete", Text = "Sign a professional sports contract", Requires = { Flags = { "Scouted" } }, LockHint = "Requires being scouted", Description = "The dream!",
				Effects = { Career = "Athlete", Money = 10000, Stats = { Popularity = 8, Health = 5, Happiness = 8 }, Flags = { "CareerChosen" }, Story = "{name} signed a professional contract. A childhood dream come true." } },
			{ Id = "ProGamer", Text = "Join a pro esports team", Requires = { Flags = { "Esports" }, AnyFlags = { "CompetitiveGamer", "TeenFamous" } }, LockHint = "Requires an esports background", Description = "Game for a living.",
				Effects = { Career = "ProGamer", Stats = { Popularity = 7, Happiness = 7, Health = -2 }, Flags = { "CareerChosen" }, Story = "{name} signed with a professional esports team!" } },
			{ Id = "Retail", Text = "Take a steady retail job", Description = "Reliable, if not exciting.",
				Effects = { Career = "ShopAssistant", Stats = { Career = 2 }, Flags = { "CareerChosen" }, Story = "{name} took a steady job in retail." } },
		},
	},
	{
		Id = "Y_Band", Stage = 3, Icon = "🎸", Title = "The Band's Big Chance",
		Description = "Your band has been offered a support slot on a national tour. It means quitting everything else.",
		Once = true, Weight = 3, Requires = { Flags = { "Band" }, NotFlags = { "CareerChosen" } },
		Choices = {
			{ Id = "Tour", Text = "Go on tour", Description = "Living the dream.",
				Effects = { Career = "Musician", Stats = { Popularity = 7, Happiness = 8, Health = -3 }, Flags = { "CareerChosen", "Touring" }, Story = "{name} quit everything and went on tour with the band." } },
			{ Id = "Hobby", Text = "Keep the band as a hobby", Description = "Weekend gigs only.",
				Effects = { Stats = { Happiness = 2 }, Story = "{name} kept the band going at weekends." } },
			{ Id = "Quit", Text = "Leave the band", Description = "Time to grow up.",
