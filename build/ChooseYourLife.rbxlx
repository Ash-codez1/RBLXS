		},
	},
	{
		Id = "Y_Love", Stage = 3, Icon = "💞", Title = "Someone Special?",
		Description = "Your friends keep asking if you're seeing anyone.",
		Once = true, Requires = { Partner = false },
		Choices = {
			{ Id = "Date", Text = "Go on some dates", Description = "See who's out there.",
				Effects = { Stats = { Happiness = 2 }, Story = "{name} went on a string of first dates.",
					Outcomes = { { Chance = 0.6, Partner = true, Stats = { Happiness = 7, Relationships = 6 }, Story = "One of them turned into something real." } } } },
			{ Id = "FirstLove", Text = "Reconnect with your first love", Requires = { AnyFlags = { "FirstLove", "TeenSweethearts" } }, LockHint = "Requires a teenage romance", Description = "The one that got away.",
				Effects = { Partner = true, Stats = { Happiness = 9, Relationships = 7 }, Flags = { "Rekindled" }, Story = "{name} bumped into their first love. The spark was still there." } },
			{ Id = "SetUp", Text = "Let friends set you up", Description = "They know you best.",
				Effects = { Stats = { Relationships = 3 }, Story = "{name}'s friends set them up on a blind date.",
					Outcomes = { { Chance = 0.45, Partner = true, Stats = { Happiness = 6 }, Story = "It went brilliantly." }, { Chance = 0.55, Stats = { Happiness = -2 }, Story = "It was a disaster, but a funny one." } } } },
			{ Id = "Solo", Text = "Focus on yourself", Description = "Love can wait.",
				Effects = { Stats = { Career = 3, Happiness = 2 }, Story = "{name} decided to focus on themselves for a while." } },
		},
	},
	{
		Id = "Y_MoveIn", Stage = 3, Icon = "🛋️", Title = "Moving In Together?",
		Description = "Your partner asks if you want to move in together.",
		Once = true, Requires = { Partner = true },
		Choices = {
			{ Id = "Yes", Text = "Yes, let's do it", Description = "A big step.",
				Effects = { Stats = { Happiness = 6, Relationships = 6 }, Money = 1000, Bond = { Partner = 10 }, Flags = { "Cohabiting" }, Story = "{name} moved in with their partner." } },
			{ Id = "Slow", Text = "Take it slow", Description = "No rush.",
				Effects = { Stats = { Relationships = 1 }, Bond = { Partner = -3 }, Story = "{name} wanted to take things slowly." } },
			{ Id = "End", Text = "Actually… end the relationship", Description = "It's not right.",
				Effects = { Partner = false, Stats = { Happiness = -5, Relationships = -4 }, Story = "{name} realised it wasn't right and ended things." } },
		},
	},
	{
		Id = "Y_Paycheque", Stage = 3, Icon = "💳", Title = "Your First Big Paycheque",
		Description = "Payday. More money than you've ever had at once. What do you do with it?",
		Once = true, Requires = { HasCareer = true },
		Choices = {
			{ Id = "Save", Text = "Save most of it", Description = "Build a safety net.",
				Effects = { Money = 2000, Stats = { Happiness = -1 }, Traits = { Thrifty = 1 }, Flags = { "Saver" }, Story = "{name} put most of their pay into savings." } },
			{ Id = "Treat", Text = "Treat yourself", Description = "You earned it.",
				Effects = { Money = -800, Stats = { Happiness = 6 }, Story = "{name} bought new clothes, a new phone and a very nice dinner." } },
			{ Id = "Stocks", Text = "Invest in the stock market", Description = "Make your money work.",
				Effects = { Stats = { Intelligence = 2 }, Flags = { "Investor" }, Story = "{name} opened an investment account.",
					Outcomes = { { Chance = 0.6, Money = 3000, Story = "The market went up. Nice!" }, { Chance = 0.4, Money = -1000, Story = "The market dipped. Lesson learned." } } } },
			{ Id = "Loan", Text = "Pay down your student loan", Requires = { HasLoan = "Student" }, LockHint = "Requires a student loan", Description = "Every bit of debt gone feels good.",
				Effects = { RepayLoan = { Kind = "Student", Amount = 2500 }, Stats = { Happiness = 4, Reputation = 2 }, Story = "{name} paid a big chunk off their student loan." } },
		},
	},
	{
		Id = "Y_Fitness", Stage = 3, Icon = "🏋️", Title = "Getting in Shape",
		Description = "Long days are taking their toll. You know you should look after yourself more.",
		Once = true,
		Choices = {
			{ Id = "Gym", Text = "Join a gym", Description = "Lift, sweat, repeat.",
				Effects = { Money = -400, Stats = { Health = 8, Happiness = 2 }, Traits = { Athletic = 1 }, Story = "{name} joined a gym and actually kept going." } },
			{ Id = "Run", Text = "Join a running club", Description = "Fitness and friends.",
				Effects = { Stats = { Health = 6, Relationships = 4 }, Story = "{name} joined a running club and ran their first 10k." } },
			{ Id = "League", Text = "Play in a weekend sports league", Description = "Competitive but fun.",
				Effects = { Stats = { Health = 5, Popularity = 4 }, Flags = { "TeamPlayer" }, Story = "{name} joined a weekend league." } },
			{ Id = "Sofa", Text = "Sofa, snacks and streaming", Description = "Next year, maybe.",
				Effects = { Stats = { Happiness = 4, Health = -6 }, Story = "{name} chose comfort. Their back started to complain." } },
		},
	},
	{
		Id = "Y_Abroad", Stage = 3, Icon = "✈️", Title = "An Opportunity Abroad",
		Description = "A friend offers you a place to stay and a job for six months in another country.",
		Once = true, Weight = 0.9,
		Choices = {
			{ Id = "Go", Text = "Go for it", Description = "New language, new life.",
				Effects = { Stats = { Happiness = 6, Intelligence = 4, Relationships = -2 }, Traits = { Adventurous = 1 }, Flags = { "LivedAbroad" }, Story = "{name} spent six months living abroad and came back changed." } },
			{ Id = "Holiday", Text = "Just visit for a holiday", Description = "A taste of it.",
				Effects = { Money = -700, Stats = { Happiness = 5 }, Story = "{name} visited for two amazing weeks." } },
			{ Id = "Stay", Text = "Stay and focus on home", Description = "Too much going on.",
				Effects = { Stats = { Career = 3, Happiness = -1 }, Story = "{name} stayed home and focused on their plans." } },
		},
	},
	{
		Id = "Y_PastCatchesUp", Stage = 3, Icon = "📂", Title = "Your Past Catches Up",
		Description = "A job application asks about your past. Someone from back then has also been talking about you online.",
		Once = true, Weight = 2, Requires = { AnyFlags = { "Record", "Cheater", "WasBully" } },
		Choices = {
			{ Id = "Honest", Text = "Be honest and own it", Description = "You've grown since then.",
				Effects = { Stats = { Reputation = 6, Happiness = 2 }, Traits = { Brave = 1 }, Flags = { "Redeemed" }, Story = "{name} owned their past mistakes. People respected it." } },
			{ Id = "Hide", Text = "Hide it and hope", Description = "Nobody needs to know.",
				Effects = { Stats = {}, Story = "{name} tried to bury the past.",
					Outcomes = { { Chance = 0.5, Stats = { Reputation = -10, Career = -5 }, Story = "It came out anyway, at the worst possible moment." } } } },
			{ Id = "Amends", Text = "Reach out and make amends", Description = "Apologise properly.",
				Effects = { Stats = { Relationships = 6, Reputation = 4 }, Traits = { Kind = 1 }, Flags = { "Redeemed" }, Story = "{name} apologised to the people they'd hurt." } },
		},
	},
}
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">Twists</string>
            <string name="Source"><![CDATA[--[[
	Life Reveal twists  (ServerScriptService.Server.Content.Twists)
	"Even if a future looks predictable, anything can happen."
	At the end of a stage, Lib/Reveal may roll a twist (Config.TwistChance):
	  • Setback: if one future looks very likely (60%+), a twist that works
	    against it (Counters lists which futures it can upset)
	  • Rescue: if a risk (Hard times / Lonely) looks likely, a twist that helps
	  • Surprise: otherwise, an unexpected turn
	Twists apply real effects (Consequences format) and the reveal shows the
	odds before and after. Each twist happens at most once per life.
]]

local KID, TEEN, YOUNG, ADULT, MID = 1, 2, 3, 4, 5

return {
	-- ===== Setbacks =====
	{ Id = "TW_Crash", Kind = "Setback", Icon = "📉", Title = "The Crash", Stages = { YOUNG, ADULT, MID }, Counters = { "Millionaire" }, Requires = { MinMoney = 20000 },
		Effects = { MoneyPercent = -0.5, InvestPercent = -0.5, Stats = { Happiness = -8 }, Story = "Out of nowhere, a global financial crash wiped out half of everything {name} had saved." } },
	{ Id = "TW_Scandal", Kind = "Setback", Icon = "📰", Title = "Scandal at Work", Stages = { YOUNG, ADULT, MID }, Counters = { "Career", "Respected" }, Requires = { HasCareer = true },
		Effects = { Promote = -1, Stats = { Career = -12, Reputation = -10 }, Story = "A colleague's lie dragged {name} into a workplace scandal. It took years to clear their name." } },
	{ Id = "TW_Illness", Kind = "Setback", Icon = "🏥", Title = "A Serious Illness", Stages = { TEEN, YOUNG, ADULT, MID }, Counters = { "Healthy", "Content", "Genius" },
		Effects = { Stats = { Health = -18, Happiness = -6 }, Story = "{name} fell seriously ill. Recovery was long and slow." } },
	{ Id = "TW_Heartbreak", Kind = "Setback", Icon = "💔", Title = "Heartbreak", Stages = { YOUNG, ADULT, MID }, Counters = { "Family", "Content" }, Requires = { Partner = true },
		Effects = { Partner = false, Stats = { Happiness = -10 }, Story = "Without warning, {name}'s partner left. Everything they'd planned together was gone." } },
	{ Id = "TW_FameFades", Kind = "Setback", Icon = "🕯️", Title = "Yesterday's News", Stages = { TEEN, YOUNG, ADULT, MID }, Counters = { "Fame" }, Requires = { MinStats = { Popularity = 55 } },
		Effects = { Stats = { Popularity = -18, Happiness = -5 }, Story = "The spotlight moved on. Almost overnight, nobody was talking about {name} any more." } },
	{ Id = "TW_FallOut", Kind = "Setback", Icon = "🌪️", Title = "A Bitter Falling-Out", Stages = { TEEN, YOUNG, ADULT, MID }, Counters = { "Respected", "Family", "Adventurer" },
		Effects = { Bond = { All = -15 }, Stats = { Reputation = -6, Relationships = -8 }, Story = "A misunderstanding spiralled into a falling-out that split {name}'s circle in two." } },

	-- ===== Rescues =====
	{ Id = "TW_Inheritance", Kind = "Rescue", Icon = "📜", Title = "A Secret Inheritance", Stages = { YOUNG, ADULT, MID }, Counters = { "Struggling" },
		Effects = { Money = 150000, Stats = { Happiness = 8 }, Story = "A letter from a lawyer: a relative {name} had never met had left them $150,000." } },
	{ Id = "TW_Partnership", Kind = "Rescue", Icon = "🤝", Title = "The Offer of a Lifetime", Stages = { YOUNG, ADULT, MID }, Counters = { "Struggling" }, Requires = { HasCareer = false },
		Effects = { Career = "BusinessOwner", Promote = 1, Money = 20000, Stats = { Happiness = 8, Career = 8 }, Story = "An old friend offered {name} a partnership in their thriving business. Life turned around overnight." } },
	{ Id = "TW_NewCircle", Kind = "Rescue", Icon = "🎊", Title = "A New Circle", Stages = { TEEN, YOUNG, ADULT, MID }, Counters = { "Lonely", "Struggling" },
		Effects = { Friends = 3, Meet = "BestFriend", Stats = { Happiness = 10, Relationships = 10 }, Story = "A chance invitation led {name} into a warm, welcoming group of new friends." } },
	{ Id = "TW_SecondChance", Kind = "Rescue", Icon = "💌", Title = "A Second Chance at Love", Stages = { YOUNG, ADULT, MID }, Counters = { "Lonely" }, Requires = { Partner = false },
		Effects = { Partner = true, Stats = { Happiness = 10, Relationships = 8 }, Story = "Just when {name} had stopped looking, love found them." } },

	-- ===== Surprises =====
	{ Id = "TW_Prodigy", Kind = "Surprise", Icon = "🎹", Title = "An Extraordinary Talent", Stages = { KID, TEEN }, Counters = {},
		Effects = { Flags = { "MusicTalent", "Prodigy" }, Stats = { Intelligence = 6, Popularity = 6, Happiness = 6 }, Story = "An ordinary afternoon, a borrowed piano, and {name} played like they'd practised for years. A prodigy." } },
	{ Id = "TW_BigIdea", Kind = "Surprise", Icon = "💡", Title = "The Big Idea", Stages = { TEEN, YOUNG, ADULT, MID }, Counters = {},
		Effects = { Flags = { "BigIdea" }, Stats = { Intelligence = 6, Career = 8 }, Traits = { Ambitious = 1 }, Story = "At 3am, {name} sat up in bed with an idea that would change the direction of their life." } },
	{ Id = "TW_HiddenTalent", Kind = "Surprise", Icon = "💎", Title = "A Hidden Gift", Stages = { YOUNG, ADULT, MID }, Counters = {},
		Effects = { Flags = { "LateBloomer" }, Stats = { Popularity = 10, Happiness = 8 }, Story = "{name} discovered a gift they never knew they had, and people couldn't stop talking about it." } },
	{ Id = "TW_Windfall", Kind = "Surprise", Icon = "🍀", Title = "A Lucky Break", Stages = { TEEN, YOUNG, ADULT, MID }, Counters = {},
		Effects = { Money = 40000, Stats = { Happiness = 6 }, Story = "A forgotten investment of {name}'s grandparent's turned out to be worth $40,000." } },
	{ Id = "TW_Sibling", Kind = "Surprise", Icon = "🧬", Title = "A Long-Lost Sibling", Stages = { YOUNG, ADULT, MID }, Counters = {},
		Effects = { Meet = "Sibling", Stats = { Relationships = 6, Happiness = 6 }, Story = "A DNA test revealed {name} had a sibling they'd never known. They met, and it felt like they always had." } },
	{ Id = "TW_Mentor", Kind = "Surprise", Icon = "🦉", Title = "An Unexpected Mentor", Stages = { KID, TEEN, YOUNG }, Counters = {},
		Effects = { Stats = { Intelligence = 6, Reputation = 4, Career = 4 }, Traits = { Studious = 1 }, Story = "A brilliant retired professor took an interest in {name} and changed how they saw the world." } },
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="53">
        <Properties>
          <string name="Name">Lib</string>
        </Properties>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">Actions</string>
            <string name="Source"><![CDATA[--[[
	Actions  (ServerScriptService.Server.Lib.Actions)
	Things a player can do between decisions, from the People, Lifestyle and
	Money panels. Every function validates its input, mutates `life` in place
	and returns ok, result | reason. LifeService wraps them in remotes and
	DataService.Update.

	People and world actions (limited to People.ActionsPerTurn per decision):
	  Interact(personId, "Time" | "Gift" | "Talk")
	  Meet("Friend" | "Love")
	  World(spotId, { OwnHome = bool })   -- Lifeville spots (Data/WorldSpots);
	                                        WorldService checks where you are
	Free actions:
	  SetFocus(focusId)
	  Invest(amount), Withdraw(amount), RepayLoan(index, amount)   (age 18+)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local People = require(Shared.Util.People)
local Lifestyle = require(Shared.Data.Lifestyle)
local Format = require(Shared.Util.Format)
local Consequences = require(script.Parent.Consequences)
local World = require(Shared.Data.World)
local WorldSpots = require(Shared.Data.WorldSpots)
local Careers = require(Shared.Data.Careers)
local TableUtil = require(Shared.Util.TableUtil)

local Actions = {}

Actions.MinFinanceAge = 18
Actions.MinLoveAge = 18

function Actions.ActionsLeft(life): number
	if life.ActionTurn ~= #life.Decisions then
		return People.ActionsPerTurn
	end
	return math.max(0, People.ActionsPerTurn - life.ActionsUsed)
end

local function useAction(life)
	if life.ActionTurn ~= #life.Decisions then
		life.ActionTurn = #life.Decisions
		life.ActionsUsed = 0
	end
	life.ActionsUsed += 1
end

local function finish(life, summary, text: string)
	Consequences.SyncWealth(life)
	return true, {
		Text = text,
		Applied = summary.Applied,
		BondChanges = summary.BondChanges,
		LifeChanges = summary.LifeChanges,
		MoneyDelta = summary.MoneyDelta,
		Story = if summary.Story ~= "" then summary.Story else nil,
		ActionsLeft = Actions.ActionsLeft(life),
	}
end

function Actions.Interact(life, personId: string, action: string, rng)
	if life.Completed then
		return false, "NoLife"
	end
	local person = People.Find(life, personId)
	if not person then
		return false, "NoSuchPerson"
	end
	if action ~= "Time" and action ~= "Gift" and action ~= "Talk" then
		return false, "BadAction"
	end
	if person.Role == "Ex" and action ~= "Talk" then
		return false, "BadAction"
	end
	if Actions.ActionsLeft(life) <= 0 then
		return false, "NoActionsLeft"
	end
	local summary = Consequences.NewSummary(rng)
	local text
	if action == "Time" then
		Consequences.ChangeBond(person, 7, summary)
		Consequences.AddStats(life, { Happiness = 1 }, summary, false)
		text = "You spent quality time with " .. person.Name .. "."
	elseif action == "Gift" then
		local cost = People.GiftCost(life)
		if life.Money < cost then
			return false, "NotEnoughMoney"
		end
		life.Money -= cost
		summary.MoneyDelta -= cost
		Consequences.ChangeBond(person, 10, summary)
		text = ("You gave %s a gift (%s). They loved it!"):format(person.Name, Format.Money(cost))
	else
		local deep = rng:NextNumber() < 0.25
		Consequences.ChangeBond(person, if deep then 9 else 4, summary)
		Consequences.AddStats(life, { Relationships = 1 }, summary, false)
		text = if deep then ("You and %s had a heart-to-heart that brought you much closer."):format(person.Name) else ("You had a good talk with %s."):format(person.Name)
	end
	useAction(life)
	return finish(life, summary, text)
end

function Actions.Meet(life, kind: string, rng)
	if life.Completed then
		return false, "NoLife"
	end
	if kind ~= "Friend" and kind ~= "Love" then
		return false, "BadAction"
	end
	if Actions.ActionsLeft(life) <= 0 then
		return false, "NoActionsLeft"
	end
	local summary = Consequences.NewSummary(rng)
	local text
	if kind == "Friend" then
		if life.Relationships.Friends >= People.MaxFriends then
			return false, "TooManyFriends"
		end
		local chance = 0.35 + life.Stats.Popularity / 200
		if rng:NextNumber() < chance then
			local friend = People.Add(life, "Friend", rng)
			table.insert(summary.LifeChanges, "🙂 New friend: " .. friend.Name)
			text = "You hit it off with " .. friend.Name .. "!"
		else
			text = "You put yourself out there, but nobody clicked this time."
		end
	else
		if life.Age < Actions.MinLoveAge then
			return false, "TooYoung"
		end
		if People.Partner(life) then
			return false, "AlreadyTaken"
		end
		local chance = 0.25 + (life.Stats.Popularity + life.Stats.Happiness) / 400
		if rng:NextNumber() < chance then
			local partner = People.Add(life, "Partner", rng)
			table.insert(summary.LifeChanges, "❤️ In a relationship with " .. partner.Name)
			Consequences.AddStats(life, { Happiness = 5 }, summary, false)
			text = ("You met %s. Sparks flew!"):format(partner.Name)
		else
			Consequences.AddStats(life, { Happiness = -1 }, summary, false)
			text = "A few dates, but no spark. Maybe next time."
		end
	end
	useAction(life)
	return finish(life, summary, text)
end

function Actions.SetFocus(life, focusId: string)
	if not Lifestyle.IsValid(focusId) then
		return false, "BadFocus"
	end
	if not Lifestyle.Available(focusId, life.Age) then
		return false, "TooYoung"
	end
	life.Focus = focusId
	return true, { Focus = focusId }
end

local function checkAmount(amount: any, max: number): number?
	if type(amount) ~= "number" or amount ~= amount or amount % 1 ~= 0 or amount < 1 or amount > max then
		return nil
	end
	return amount
end

function Actions.Invest(life, amount: any)
	if life.Age < Actions.MinFinanceAge then
		return false, "TooYoung"
	end
	local value = checkAmount(amount, life.Money)
	if not value then
		return false, "BadAmount"
	end
	life.Money -= value
	life.Investments = (life.Investments or 0) + value
	Consequences.SyncWealth(life)
	return true, { Money = life.Money, Investments = life.Investments }
end

function Actions.Withdraw(life, amount: any)
	if life.Age < Actions.MinFinanceAge then
		return false, "TooYoung"
	end
	local value = checkAmount(amount, life.Investments or 0)
	if not value then
		return false, "BadAmount"
	end
	life.Investments -= value
	life.Money += value
	Consequences.SyncWealth(life)
	return true, { Money = life.Money, Investments = life.Investments }
end

function Actions.RepayLoan(life, index: any, amount: any)
	if type(index) ~= "number" or index % 1 ~= 0 then
		return false, "BadLoan"
	end
	local loan = life.Loans[index]
	if not loan then
		return false, "BadLoan"
	end
	local value = checkAmount(amount, math.min(life.Money, loan.Balance))
	if not value then
		return false, "BadAmount"
	end
	life.Money -= value
	loan.Balance -= value
	local paidOff = loan.Balance <= 0
	if paidOff then
		table.remove(life.Loans, index)
	end
	Consequences.SyncWealth(life)
	return true, { Money = life.Money, PaidOff = paidOff }
end

-- ===== Lifeville world actions =====
function Actions.ShiftPay(life): number
	if life.Career.Id == "None" or not Careers.Info[life.Career.Id] then
		return 0
	end
	return math.max(WorldSpots.MinShiftPay, math.floor(Careers.SalaryAt(life.Career.Id, life.Career.Level) * WorldSpots.ShiftPay))
end

-- Checks a spot against this life without changing it: ok, reason.
function Actions.CanUseSpot(life, spotDef, extra): (boolean, string?)
	if life.Completed then
		return false, "NoLife"
	end
	if not spotDef or spotDef.Kind == "Open" then
		return false, "BadSpot"
	end
	local stage = World.StageOf(life)
	if not World.IsUnlocked(spotDef.District, stage) or (spotDef.Lock and not World.IsLockOpen(spotDef.Lock, stage)) then
		return false, "Locked"
	end
	if spotDef.MinAge and life.Age < spotDef.MinAge then
		return false, "TooYoung"
	end
	if spotDef.MaxAge and life.Age > spotDef.MaxAge then
		return false, "TooOld"
	end
	if spotDef.Flag and not life.Flags[spotDef.Flag] then
		return false, "NeedFlag"
	end
	if spotDef.Kind == "Shift" then
		if life.Career.Id == "None" or life.Flags.Retired then
			return false, "NoJob"
		end
		if World.WorkplaceOf[life.Career.Id] ~= spotDef.Workplace then
			return false, "WrongJob"
		end
	end
	if spotDef.OwnHome and not (extra and extra.OwnHome) then
		return false, "NotYourHome"
	end
	if Actions.ActionsLeft(life) <= 0 then
		return false, "NoActionsLeft"
	end
	if WorldSpots.CostFor(spotDef, life.Age) > life.Money then
		return false, "NotEnoughMoney"
	end
	return true, nil
end

function Actions.World(life, spotId: any, extra, rng)
	local spotDef = WorldSpots.Get(spotId)
	local ok, reason = Actions.CanUseSpot(life, spotDef, extra)
	if not ok then
		return false, reason
	end
	local effects
	if spotDef.Kind == "Shift" then
		effects = { Stats = { Career = 2, Happiness = -1 }, Money = Actions.ShiftPay(life) }
	else
		effects = TableUtil.DeepCopy(spotDef.Effects)
		local cost = WorldSpots.CostFor(spotDef, life.Age)
		if cost > 0 then
			effects.Money = (effects.Money or 0) - cost
		end
	end
	local summary = Consequences.Apply(life, effects, rng, true)
	useAction(life)
	return finish(life, summary, spotDef.Text or spotDef.Label)
end

return Actions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">CoinRewards</string>
            <string name="Source"><![CDATA[--[[
	CoinRewards  (ServerScriptService.Server.Lib.CoinRewards)
	The one place Coins are earned by PLAYING (not bought). Call inside a
	DataService.Update mutator. The 2× Coins game pass doubles these.

	Sources & amounts (see Config): completing a stage, completing a life
	(score-based, from the Final Reveal), joining group decisions and
	city events.
]]

local CoinRewards = {}

function CoinRewards.Multiplier(data): number
	return if data.Passes and data.Passes.CoinBooster then 2 else 1
end

-- Adds `amount` (× multiplier) and returns what was actually granted.
function CoinRewards.Grant(data, amount: number): number
	if type(amount) ~= "number" or amount <= 0 then
		return 0
	end
	local granted = math.floor(amount * CoinRewards.Multiplier(data))
	data.Coins += granted
	data.Lifetime.CoinsEarned += granted
	data.Lifetime.PlayCoins = (data.Lifetime.PlayCoins or 0) + granted -- for "earn coins by playing" challenges
	return granted
end

-- Rewards that aren't from playing (achievements, challenges, daily rewards):
-- counted as earned, never doubled, and not towards "earn coins" challenges.
function CoinRewards.GrantBonus(data, amount: number): number
	if type(amount) ~= "number" or amount <= 0 then
		return 0
	end
	local granted = math.floor(amount)
	data.Coins += granted
	data.Lifetime.CoinsEarned += granted
	return granted
end

return CoinRewards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">Conditions</string>
            <string name="Source"><![CDATA[--[[
	Conditions  (ServerScriptService.Server.Lib.Conditions)
	Evaluates a `Requires` table against a life. Used by scenarios and by
	individual choices, which is how earlier decisions unlock (or close off)
	later branches.

	Requires = {
		Flags      = { "A", "B" },    -- all must be set
		AnyFlags   = { "A", "B" },    -- at least one must be set
		NotFlags   = { "C" },         -- none may be set
		MinStats   = { Intelligence = 60 },
		MaxStats   = { Health = 30 },
		MinTraits  = { Studious = 2 },
		MinMoney   = 1000,
		MinAge     = 7,  MaxAge = 10,
		-- life situation
		HasCareer  = true | false,
		Careers    = { "Doctor", "Lawyer" },  -- current career is one of these
		NotCareers = { "ShopAssistant" },
		MinCareerLevel = 3,
		MinEducation = "University",          -- None < School < University < Masters
		MaxEducation = "School",
		Partner    = true | false,
		Married    = true | false,
		MinChildren = 1, MaxChildren = 0,
		Assets     = { "House" },             -- owns all of these
		AnyAssets  = { "House", "Mansion" },
		NotAssets  = { "Mansion" },
		-- people & finances
		HasRole    = { "BestFriend" },        -- has someone in each of these roles
		NotRole    = { "Partner" },
		MinBond    = { Partner = 40 },         -- best bond among people in that role
		MaxBond    = { Partner = 30 },         -- (role must exist for MaxBond to pass)
		MinFriends = 2, MaxFriends = 0,
		HasLoan    = "Mortgage", NoLoans = true,
		MinInvestments = 10000,
		Focus      = { "Career", "Money" },
	}
	Every field is optional; nil or {} always passes.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Careers = require(ReplicatedStorage:WaitForChild("Shared").Data.Careers)
local People = require(ReplicatedStorage:WaitForChild("Shared").Util.People)

local Conditions = {}

local function hasCareer(life): boolean
	return life.Career.Id ~= "None" and Careers.Info[life.Career.Id] ~= nil
end
Conditions.HasCareer = hasCareer

function Conditions.Check(life, requires): boolean
	if not requires then
		return true
	end
	local flags = life.Flags
	if requires.Flags then
		for _, flag in ipairs(requires.Flags) do
			if not flags[flag] then
				return false
			end
		end
	end
	if requires.AnyFlags then
		local any = false
		for _, flag in ipairs(requires.AnyFlags) do
			if flags[flag] then
				any = true
				break
			end
		end
		if not any then
			return false
		end
	end
	if requires.NotFlags then
		for _, flag in ipairs(requires.NotFlags) do
			if flags[flag] then
				return false
			end
		end
	end
	if requires.MinStats then
		for stat, min in pairs(requires.MinStats) do
			if (life.Stats[stat] or 0) < min then
				return false
			end
		end
	end
	if requires.MaxStats then
		for stat, max in pairs(requires.MaxStats) do
			if (life.Stats[stat] or 0) > max then
				return false
			end
		end
	end
	if requires.MinTraits then
		for trait, min in pairs(requires.MinTraits) do
			if (life.Traits[trait] or 0) < min then
				return false
			end
		end
	end
	if requires.MinMoney and life.Money < requires.MinMoney then
		return false
	end
	if requires.MinAge and life.Age < requires.MinAge then
		return false
	end
	if requires.MaxAge and life.Age > requires.MaxAge then
		return false
	end
	if requires.HasCareer ~= nil and hasCareer(life) ~= requires.HasCareer then
		return false
	end
	if requires.Careers and not table.find(requires.Careers, life.Career.Id) then
		return false
	end
	if requires.NotCareers and table.find(requires.NotCareers, life.Career.Id) then
		return false
	end
	if requires.MinCareerLevel and (not hasCareer(life) or life.Career.Level < requires.MinCareerLevel) then
		return false
	end
	local educationRank = Careers.EducationRank[life.Education] or 0
	if requires.MinEducation and educationRank < Careers.EducationRank[requires.MinEducation] then
		return false
	end
	if requires.MaxEducation and educationRank > Careers.EducationRank[requires.MaxEducation] then
		return false
	end
	local rel = life.Relationships
	if requires.Partner ~= nil and (rel.Partner == true) ~= requires.Partner then
		return false
	end
	if requires.Married ~= nil and (rel.Married == true) ~= requires.Married then
		return false
	end
	if requires.MinChildren and rel.Children < requires.MinChildren then
		return false
	end
	if requires.MaxChildren and rel.Children > requires.MaxChildren then
		return false
	end
	if requires.Assets then
		for _, asset in ipairs(requires.Assets) do
			if not life.Assets[asset] then
				return false
			end
		end
	end
	if requires.AnyAssets then
		local any = false
		for _, asset in ipairs(requires.AnyAssets) do
			if life.Assets[asset] then
				any = true
				break
			end
		end
		if not any then
			return false
		end
	end
	if requires.NotAssets then
		for _, asset in ipairs(requires.NotAssets) do
			if life.Assets[asset] then
				return false
			end
		end
	end
	if requires.HasRole then
		for _, role in ipairs(requires.HasRole) do
			if #People.ByRole(life, role) == 0 then
				return false
			end
		end
	end
	if requires.NotRole then
		for _, role in ipairs(requires.NotRole) do
			if #People.ByRole(life, role) > 0 then
				return false
			end
		end
	end
	local function bestBond(role)
		local best = nil
		for _, person in ipairs(People.ByRole(life, role)) do
			best = math.max(best or 0, person.Bond)
		end
		return best
	end
	if requires.MinBond then
		for role, min in pairs(requires.MinBond) do
			local bond = bestBond(role)
			if not bond or bond < min then
				return false
			end
		end
	end
	if requires.MaxBond then
		for role, max in pairs(requires.MaxBond) do
			local bond = bestBond(role)
			if not bond or bond > max then
				return false
			end
		end
	end
	if requires.MinFriends and rel.Friends < requires.MinFriends then
		return false
	end
	if requires.MaxFriends and rel.Friends > requires.MaxFriends then
		return false
	end
	if requires.HasLoan then
		local found = false
		for _, loan in ipairs(life.Loans) do
			if loan.Kind == requires.HasLoan then
				found = true
			end
		end
		if not found then
			return false
		end
	end
	if requires.NoLoans and #life.Loans > 0 then
		return false
	end
	if requires.MinInvestments and (life.Investments or 0) < requires.MinInvestments then
		return false
	end
	if requires.Focus and not table.find(requires.Focus, life.Focus) then
		return false
	end
	return true
end

return Conditions
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">Consequences</string>
            <string name="Source"><![CDATA[--[[
	Consequences  (ServerScriptService.Server.Lib.Consequences)
	Applies an Effects table (from a choice or a random event) to a life IN
	PLACE and returns a summary for the client. LifeService calls it inside
	DataService.Update so a whole decision is applied atomically.

	Effects = {
		-- immediate
		Stats        = { Intelligence = 6, Happiness = -2 },  -- Wealth is derived; don't set it
		Money        = 50,              -- flat change
		MoneyPercent = -0.3,            -- change by a share of current money (e.g. a crash)
		-- long-term
		Flags        = { "StudiedEarly" }, ClearFlags = { "Shy" },
		Traits       = { Studious = 1 },
		Career       = "Doctor" | "None", -- start a new career at level 1 (or lose your job)
		Promote      = 1,               -- move up career levels
		Retire       = true,            -- stop working; pension from PeakSalary
		Education    = "University",    -- raised only if higher than current
		Partner      = true | false,    Married = true | false,   -- creates/ends named people
		Children     = 1,               Friends = 2,
		Meet         = "BestFriend",    -- a new person in a role (BestFriend promotes your closest friend)
		Bond         = { Partner = 8, Child = 5, Friend = 3, Parent = 4, BestFriend = 6, Sibling = 3, All = 2 },
		Loan         = { Kind = "Mortgage", Amount = 208000, Years = 25, Rate = 0.04 },
		RepayLoan    = { Kind = "Student", Amount = 1500 },
		InvestPercent = 0.25,           -- grow/shrink invested money
		Farewell     = "Parent",        -- someone in that role passes away (gently, late in life)
		Reunite      = true,            -- get back together with an ex (if single)
		Assets       = { "House" },     RemoveAssets = { "Apartment" },
		Story        = "Text. {name} is replaced.",
		Outcomes     = { { Chance = 0.3, ...any of the above... }, ... },  -- at most one triggers
	}
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local StatMath = require(Shared.Util.StatMath)
local TableUtil = require(Shared.Util.TableUtil)
local Traits = require(Shared.Data.Traits)
local Careers = require(Shared.Data.Careers)
local Assets = require(Shared.Data.Assets)
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)
local People = require(Shared.Util.People)
local Budget = require(Shared.Util.Budget)

local Consequences = {}

local function personalise(text: string?, life): string?
	if not text then
		return nil
	end
	return (text:gsub("{name}", life.Name))
end

function Consequences.NetWorth(life): number
	return Budget.NetWorth(life)
end

function Consequences.SyncWealth(life)
	life.Stats.Wealth = StatMath.WealthFromNetWorth(math.max(0, Consequences.NetWorth(life)))
end

Consequences.LoanKinds = { Student = { Rate = 0.03, Years = 15, Title = "Student loan" }, Mortgage = { Rate = 0.04, Years = 25, Title = "Mortgage" } }

-- Records a bond change for the outcome card (merged per person).
local function noteBond(summary, person, delta: number)
	if math.abs(delta) < 0.05 then
		return
	end
	for _, entry in ipairs(summary.BondChanges) do
		if entry.Id == person.Id then
			entry.Delta += delta
			return
		end
	end
	table.insert(summary.BondChanges, { Id = person.Id, Name = person.Name, Role = person.Role, Delta = delta })
end
Consequences.NoteBond = noteBond

function Consequences.ChangeBond(person, delta: number, summary)
	noteBond(summary, person, People.ChangeBond(person, delta))
end

-- Ends the current relationship: partner becomes an Ex.
function Consequences.EndRelationship(life, summary, text: string?)
	local partner = People.Partner(life)
	if not partner then
		return
	end
	local wasMarried = partner.Married == true
	partner.Role = "Ex"
	partner.Married = nil
	partner.Bond = math.min(partner.Bond, 25)
	People.Sync(life)
	table.insert(summary.LifeChanges, text or ((if wasMarried then "📄 Divorced from " else "💔 Broke up with ") .. partner.Name))
end

local function addStats(life, deltas, summary, useTraits: boolean)
	local multipliers = if useTraits then Traits.GainMultipliers(life.Traits) else {}
	local scaled = {}
	for stat, delta in pairs(deltas) do
		if stat ~= "Wealth" then
			scaled[stat] = if delta > 0 then delta * (multipliers[stat] or 1) else delta
		end
	end
	local newStats, applied = StatMath.Apply(life.Stats, scaled)
	life.Stats = newStats
	for stat, change in pairs(applied) do
		summary.Applied[stat] = (summary.Applied[stat] or 0) + change
	end
end
Consequences.AddStats = addStats

local function changeMoney(life, amount: number, summary)
	local before = life.Money
	life.Money = math.max(0, math.floor(life.Money + amount))
	summary.MoneyDelta += life.Money - before
end

local function setCareer(life, careerId: string, summary)
	if careerId == "None" then
		if life.Career.Id ~= "None" then
			table.insert(summary.LifeChanges, "💼 Left job as " .. Careers.TitleAt(life.Career.Id, life.Career.Level))
		end
		life.Career = { Id = "None", Level = 0, YearsInRole = 0 }
		return
	end
	if not Careers.Info[careerId] or life.Career.Id == careerId then
		return
	end
	life.Career = { Id = careerId, Level = 1, YearsInRole = 0 }
	life.Flags["Was_" .. careerId] = true
	life.PeakCareerLevel = math.max(life.PeakCareerLevel or 0, 1)
	Consequences.TrackBestCareer(life)
	life.PeakSalary = math.max(life.PeakSalary or 0, Careers.SalaryAt(careerId, 1))
	table.insert(summary.LifeChanges, Careers.Info[careerId].Icon .. " New career: " .. Careers.TitleAt(careerId, 1))
end

-- Remembers the best career this life ever had (for endings and Life History).
function Consequences.TrackBestCareer(life)
	local current = life.Career
	if current.Id == "None" then
		return
	end
	local bestCareer = life.BestCareer
	if not bestCareer or current.Level > bestCareer.Level or (current.Level == bestCareer.Level and Careers.SalaryAt(current.Id, current.Level) > Careers.SalaryAt(bestCareer.Id, bestCareer.Level)) then
		life.BestCareer = { Id = current.Id, Level = current.Level }
	end
end

-- Career Success needed for the top levels: 62+ for level 4, 80+ for level 5.
function Consequences.MaxLevelForCareerStat(careerStat: number): number
	if careerStat >= 80 then
		return 5
	elseif careerStat >= 62 then
		return 4
	end
	return 3
end

function Consequences.Promote(life, levels: number, summary)
	local career = life.Career
	if career.Id == "None" or not Careers.Info[career.Id] then
		return false
	end
	local newLevel = math.clamp(career.Level + levels, 1, Careers.MaxLevel)
	if newLevel == career.Level then
		return false
	end
	local up = newLevel > career.Level
	-- The top roles need a strong track record (Career Success stat).
	if up then
		local cap = Consequences.MaxLevelForCareerStat(life.Stats.Career)
		if newLevel > cap then
			if cap <= career.Level then
				table.insert(summary.LifeChanges, ("📋 Not quite ready to be %s yet: build your Career Success"):format(Careers.TitleAt(career.Id, career.Level + 1)))
				addStats(life, { Career = 3 }, summary, false)
				return false
			end
			newLevel = cap
		end
	end
	career.Level = newLevel
	career.YearsInRole = 0
	life.PeakCareerLevel = math.max(life.PeakCareerLevel or 0, newLevel)
	Consequences.TrackBestCareer(life)
	life.PeakSalary = math.max(life.PeakSalary or 0, Careers.SalaryAt(career.Id, newLevel))
	table.insert(summary.LifeChanges, (if up then "📈 Promoted to " else "📉 Demoted to ") .. Careers.TitleAt(career.Id, newLevel))
	addStats(life, { Career = if up then 6 else -6 }, summary, false)
	return true
end

-- Applies one Effects-shaped table (base effects or a single outcome).
local function applyBlock(life, block, summary)
	if block.Stats then
		addStats(life, block.Stats, summary, true)
	end
	if type(block.Money) == "number" and block.Money ~= 0 then
		changeMoney(life, block.Money, summary)
	end
	if type(block.MoneyPercent) == "number" and block.MoneyPercent ~= 0 then
		changeMoney(life, life.Money * block.MoneyPercent, summary)
	end
	if block.Flags then
		for _, flag in ipairs(block.Flags) do
			if not life.Flags[flag] then
				life.Flags[flag] = true
				table.insert(summary.FlagsAdded, flag)
			end
		end
	end
	if block.ClearFlags then
		for _, flag in ipairs(block.ClearFlags) do
			life.Flags[flag] = nil
		end
	end
	if block.Traits then
		for trait, change in pairs(block.Traits) do
			if Traits.IsValid(trait) then
				local before = life.Traits[trait] or 0
				local after = math.clamp(before + change, 0, Traits.MaxStrength)
				life.Traits[trait] = if after > 0 then after else nil
				if before == 0 and after > 0 then
					table.insert(summary.TraitsGained, trait)
				end
			end
		end
	end
	if block.Retire then
		if not life.Flags.Retired then
			life.Flags.Retired = true
			if life.Career.Id ~= "None" then
				table.insert(summary.LifeChanges, "🏖️ Retired as " .. Careers.TitleAt(life.Career.Id, life.Career.Level))
			else
				table.insert(summary.LifeChanges, "🏖️ Retired")
			end
			life.Career = { Id = "None", Level = 0, YearsInRole = 0 }
		end
	end
	if type(block.Career) == "string" then
		setCareer(life, block.Career, summary)
	end
	if type(block.Promote) == "number" and block.Promote ~= 0 then
		Consequences.Promote(life, block.Promote, summary)
	end
	if type(block.Education) == "string" and Careers.EducationRank[block.Education] then
		if Careers.EducationRank[block.Education] > (Careers.EducationRank[life.Education] or 0) then
			life.Education = block.Education
			if Careers.EducationRank[block.Education] >= 2 then
				table.insert(summary.LifeChanges, "🎓 Earned a " .. Careers.EducationNames[block.Education])
			end
		end
	end
	local rng = summary._rng
	if block.Reunite and not People.Partner(life) then
		local ex = People.ByRole(life, "Ex")[1]
		if ex then
			ex.Role = "Partner"
			ex.Bond = math.max(ex.Bond, 60)
			People.Sync(life)
			table.insert(summary.LifeChanges, "❤️ Back together with " .. ex.Name)
		end
	end
	if block.Partner ~= nil then
		local partner = People.Partner(life)
		if block.Partner == true and not partner then
			partner = People.Add(life, "Partner", rng)
			table.insert(summary.LifeChanges, "❤️ In a relationship with " .. partner.Name)
		elseif block.Partner == false and partner then
			Consequences.EndRelationship(life, summary)
		end
	end
	if block.Married ~= nil then
		local partner = People.Partner(life)
		if block.Married == true then
			if not partner then
				partner = People.Add(life, "Partner", rng)
			end
			if not partner.Married then
				partner.Married = true
				People.ChangeBond(partner, 10)
				table.insert(summary.LifeChanges, "💍 Married " .. partner.Name)
			end
		elseif partner and partner.Married then
			Consequences.EndRelationship(life, summary)
		end
		People.Sync(life)
	end
	if type(block.Children) == "number" and block.Children > 0 then
		local names = {}
		for _ = 1, math.min(block.Children, 12 - life.Relationships.Children) do
			table.insert(names, People.Add(life, "Child", rng).Name)
		end
		if #names == 1 then
			table.insert(summary.LifeChanges, "👶 Welcome, " .. names[1] .. "!")
		elseif #names > 1 then
			table.insert(summary.LifeChanges, "👶 Welcome, " .. table.concat(names, " & ") .. "!")
		end
	end
	if type(block.Friends) == "number" and block.Friends ~= 0 then
		if block.Friends > 0 then
			for _ = 1, block.Friends do
				if life.Relationships.Friends >= People.MaxFriends then
					break
				end
				local friend = People.Add(life, "Friend", rng)
				table.insert(summary.LifeChanges, "🙂 New friend: " .. friend.Name)
			end
		else
			for _ = 1, -block.Friends do
				local friends = People.ByRole(life, "Friend")
				table.sort(friends, function(a, b)
					return a.Bond < b.Bond
				end)
				if friends[1] then
					table.insert(summary.LifeChanges, "👋 Lost touch with " .. friends[1].Name)
					People.Remove(life, friends[1])
				end
			end
		end
	end
	if block.Meet == "BestFriend" and #People.ByRole(life, "BestFriend") == 0 then
		local friends = People.ByRole(life, "Friend")
		table.sort(friends, function(a, b)
			return a.Bond > b.Bond
		end)
		local best = friends[1] or People.Add(life, "Friend", rng)
		best.Role = "BestFriend"
		People.ChangeBond(best, 15)
		People.Sync(life)
		table.insert(summary.LifeChanges, "🫶 " .. best.Name .. " is now your best friend")
	elseif block.Meet == "Sibling" then
		local sibling = People.Add(life, "Sibling", rng)
		sibling.BornAge = life.Age
		table.insert(summary.LifeChanges, "🧒 A new sibling: " .. sibling.Name)
	elseif block.Meet == "Friend" and life.Relationships.Friends < People.MaxFriends then
		local friend = People.Add(life, "Friend", rng)
		table.insert(summary.LifeChanges, "🙂 New friend: " .. friend.Name)
	end
	if type(block.InvestPercent) == "number" and (life.Investments or 0) > 0 then
		local before = life.Investments
		life.Investments = math.max(0, math.floor(before * (1 + block.InvestPercent)))
		local change = life.Investments - before
		table.insert(summary.LifeChanges, ("%s Investments %s%s"):format(if change >= 0 then "📈" else "📉", if change >= 0 then "+" else "", Format.Money(change)))
	end
	if type(block.Farewell) == "string" then
		local person = People.ByRole(life, block.Farewell)[1]
		if person then
			People.Remove(life, person)
			table.insert(summary.LifeChanges, "🕊️ Said goodbye to " .. person.Name)
		end
	end
	if type(block.Bond) == "table" then
		for _, person in ipairs(life.People) do
			local delta = (block.Bond[person.Role] or 0) + (if person.Role ~= "Ex" then (block.Bond.All or 0) else 0)
			if delta ~= 0 then
				Consequences.ChangeBond(person, delta, summary)
			end
		end
	end
	if type(block.Loan) == "table" and Consequences.LoanKinds[block.Loan.Kind] then
		local kind = Consequences.LoanKinds[block.Loan.Kind]
		local rate = block.Loan.Rate or kind.Rate
		local years = block.Loan.Years or kind.Years
		table.insert(life.Loans, { Kind = block.Loan.Kind, Balance = block.Loan.Amount, Rate = rate, Payment = Budget.LoanPayment(block.Loan.Amount, rate, years) })
		table.insert(summary.LifeChanges, "🏦 " .. kind.Title .. ": " .. Format.Money(block.Loan.Amount))
	end
	if type(block.RepayLoan) == "table" then
		for i, loan in ipairs(life.Loans) do
			if loan.Kind == block.RepayLoan.Kind then
				local paid = math.min(loan.Balance, block.RepayLoan.Amount, life.Money)
				loan.Balance -= paid
				changeMoney(life, -paid, summary)
				if loan.Balance <= 0 then
					table.remove(life.Loans, i)
					table.insert(summary.LifeChanges, "🎉 Paid off your " .. string.lower(Consequences.LoanKinds[loan.Kind].Title))
				end
				break
			end
		end
	end
	if block.Assets then
		for _, id in ipairs(block.Assets) do
			if Assets.Info[id] and not life.Assets[id] then
				life.Assets[id] = true
				table.insert(summary.LifeChanges, Assets.Info[id].Icon .. " Bought: " .. Assets.Info[id].Title)
			end
		end
	end
	if block.RemoveAssets then
		for _, id in ipairs(block.RemoveAssets) do
			if life.Assets[id] then
				life.Assets[id] = nil
				table.insert(summary.LifeChanges, Assets.Info[id].Icon .. " Sold: " .. Assets.Info[id].Title)
			end
		end
	end
	local story = personalise(block.Story, life)
	if story then
		table.insert(summary.StoryParts, story)
	end
end

function Consequences.NewSummary(rng)
	return {
		_rng = rng,
		BondChanges = {},
		Applied = {},
		MoneyDelta = 0,
		FlagsAdded = {},
		TraitsGained = {},
		LifeChanges = {},
		StoryParts = {},
		OutcomeTriggered = false,
	}
end

--[[
	Applies effects (and possibly one chance Outcome) to `life`.
	Returns summary = { Applied, MoneyDelta, FlagsAdded, TraitsGained, LifeChanges, Story, OutcomeTriggered }
]]
-- Rolls which chance Outcome (if any) happens: returns its index, or 0 for none.
function Consequences.RollOutcome(effects, rng): number
	if not effects.Outcomes then
		return 0
	end
	local roll = rng:NextNumber()
	local cumulative = 0
	for index, outcome in ipairs(effects.Outcomes) do
		cumulative += outcome.Chance
		if roll < cumulative then
			return index
		end
	end
	return 0
end

--[[
	`forcedOutcome` (optional) decides the chance Outcome instead of rolling:
	group decisions roll once and pass the same index to every member, so
	friends who start a business together share the same fate, while each
	life still applies the effects to its own stats and money.
]]
function Consequences.Apply(life, effects, rng, logStory: boolean?, forcedOutcome: number?)
	local summary = Consequences.NewSummary(rng)
	applyBlock(life, effects, summary)

	if effects.Outcomes then
		local index = if forcedOutcome ~= nil then forcedOutcome else Consequences.RollOutcome(effects, rng)
		local outcome = effects.Outcomes[index]
		if outcome then
			applyBlock(life, outcome, summary)
			summary.OutcomeTriggered = true
		end
	end

	Consequences.SyncWealth(life)
	summary.Story = table.concat(summary.StoryParts, " ")
	summary.StoryParts = nil
	summary._rng = nil
	if logStory ~= false and summary.Story ~= "" then
		table.insert(life.Story, { Age = life.Age, Text = summary.Story })
		TableUtil.TrimArray(life.Story, Config.MaxStoryEntries)
	end
	return summary
end

--[[
	Consequence preview for the decision cards: direction + size of each base
	stat effect, never exact numbers, and never what chance Outcomes do.
	Returns { { Stat, Dir = 1|-1, Size = 1..3 } ... }, moneyDir, risky, tags
	`tags` are short hints for big life changes ("💼 New career", "🏠 Home").
]]
function Consequences.Preview(effects)
	local preview = {}
	if effects.Stats then
		for stat, delta in pairs(effects.Stats) do
			if delta ~= 0 and stat ~= "Wealth" then
				local size = if math.abs(delta) <= 4 then 1 elseif math.abs(delta) <= 8 then 2 else 3
				table.insert(preview, { Stat = stat, Dir = if delta > 0 then 1 else -1, Size = size })
			end
		end
	end
	table.sort(preview, function(a, b)
		if a.Dir ~= b.Dir then
			return a.Dir > b.Dir
		end
		if a.Size ~= b.Size then
			return a.Size > b.Size
		end
		return a.Stat < b.Stat
	end)
	local money = (effects.Money or 0) + (if effects.MoneyPercent then effects.MoneyPercent * 1e6 else 0)
	local moneyDir = if money > 0 then 1 elseif money < 0 then -1 else 0

	local tags = {}
	if type(effects.Career) == "string" and effects.Career ~= "None" and Careers.Info[effects.Career] then
		table.insert(tags, Careers.Info[effects.Career].Icon .. " " .. Careers.TitleAt(effects.Career, 1))
	elseif effects.Career == "None" then
		table.insert(tags, "💼 Leave job")
	end
	if effects.Promote and effects.Promote > 0 then
		table.insert(tags, "📈 Promotion")
	end
	if effects.Education then
		table.insert(tags, "🎓 " .. (Careers.EducationNames[effects.Education] or effects.Education))
	end
	if effects.Married then
		table.insert(tags, "💍 Marriage")
	elseif effects.Partner == true then
		table.insert(tags, "❤️ Romance")
	end
	if effects.Children and effects.Children > 0 then
		table.insert(tags, "👶 Family")
	end
	if effects.Assets then
		for _, id in ipairs(effects.Assets) do
			if Assets.Info[id] then
				table.insert(tags, Assets.Info[id].Icon .. " " .. Assets.Info[id].Title)
			end
		end
	end
	if effects.Retire then
		table.insert(tags, "🏖️ Retire")
	end
	if type(effects.Loan) == "table" then
		table.insert(tags, "🏦 Loan " .. Format.Money(effects.Loan.Amount))
	end
	if type(effects.Bond) == "table" then
		local up, down = false, false
		for _, delta in pairs(effects.Bond) do
			if delta > 0 then
				up = true
			elseif delta < 0 then
				down = true
			end
		end
		if up then
			table.insert(tags, "💞 Closer bonds")
		end
		if down then
			table.insert(tags, "💔 Strained bonds")
		end
	end
	if type(effects.Money) == "number" and math.abs(effects.Money) >= 1000 then
		table.insert(tags, (if effects.Money > 0 then "+" else "") .. Format.Money(effects.Money))
	end
	return preview, moneyDir, effects.Outcomes ~= nil, tags
end

return Consequences
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">MockDataStore</string>
            <string name="Source"><![CDATA[--[[
	MockDataStore  (ServerScriptService.Server.Lib.MockDataStore)
	In-memory stand-in with the same method signatures as a GlobalDataStore.
	DataService uses it automatically when DataStores are unavailable
	(Studio with "Enable Studio Access to API Services" off, or unit tests).
	Data is lost when the server stops.
]]

local MockDataStore = {}
MockDataStore.__index = MockDataStore

local function deepCopy(v)
	if type(v) ~= "table" then
		return v
	end
	local c = {}
	for k, x in pairs(v) do
		c[k] = deepCopy(x)
	end
	return c
end

function MockDataStore.new()
	return setmetatable({ _data = {} }, MockDataStore)
end

function MockDataStore:GetAsync(key: string)
	return deepCopy(self._data[key])
end

function MockDataStore:SetAsync(key: string, value: any)
	self._data[key] = deepCopy(value)
end

function MockDataStore:UpdateAsync(key: string, transform: (any) -> any)
	local result = transform(deepCopy(self._data[key]))
	if result ~= nil then
		self._data[key] = deepCopy(result)
	end
	return deepCopy(result)
end

function MockDataStore:RemoveAsync(key: string)
	local old = self._data[key]
	self._data[key] = nil
	return old
end

return MockDataStore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">MockOrderedDataStore</string>
            <string name="Source"><![CDATA[--[[
	MockOrderedDataStore  (ServerScriptService.Server.Lib.MockOrderedDataStore)
	In-memory stand-in for an OrderedDataStore, used when Studio can't reach
	DataStores (and in tests). Same calls as the real thing:
	SetAsync, GetAsync, RemoveAsync, GetSortedAsync(ascending, pageSize).
	Nothing persists between Play sessions.
]]

local MockOrderedDataStore = {}
MockOrderedDataStore.__index = MockOrderedDataStore

function MockOrderedDataStore.new()
	return setmetatable({ _data = {} }, MockOrderedDataStore)
end

function MockOrderedDataStore:SetAsync(key, value)
	assert(type(value) == "number" and value % 1 == 0, "OrderedDataStore values must be integers")
	self._data[tostring(key)] = value
end

function MockOrderedDataStore:GetAsync(key)
	return self._data[tostring(key)]
end

function MockOrderedDataStore:RemoveAsync(key)
	local old = self._data[tostring(key)]
	self._data[tostring(key)] = nil
	return old
end

function MockOrderedDataStore:GetSortedAsync(ascending: boolean, pageSize: number)
	local entries = {}
	for key, value in pairs(self._data) do
		table.insert(entries, { key = key, value = value })
	end
	table.sort(entries, function(a, b)
		if a.value == b.value then
			return a.key < b.key
		end
		return if ascending then a.value < b.value else a.value > b.value
	end)
	local page = {}
	for i = 1, math.min(pageSize, #entries) do
		page[i] = entries[i]
	end
	return {
		IsFinished = true,
		GetCurrentPage = function()
			return page
		end,
		AdvanceToNextPageAsync = function() end,
	}
end

return MockOrderedDataStore
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">RandomEvents</string>
            <string name="Source"><![CDATA[--[[
	RandomEvents  (ServerScriptService.Server.Lib.RandomEvents)
	Rolls for an unexpected life event after each decision.

	  1. A base chance (Config.EventChance) decides whether anything happens.
	  2. Eligible events = right stage, Requires pass, not already had (Once).
	     So events respect the player's circumstances (you can't lose a job you
	     don't have, inherit a fortune twice, etc.).
	  3. Weighted pick by rarity × Boost (e.g. inheritances favour people with
	     strong Relationships).
	Legendary events are extremely rare: roughly one life in a few hundred.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)

local Conditions = require(script.Parent.Conditions)
local ScenarioPicker = require(script.Parent.ScenarioPicker)

local RandomEvents = {}

RandomEvents.RarityWeight = {
	Common = 10,
	Uncommon = 4,
	Rare = 1.2,
	Legendary = 0.12,
}

local function hadEvent(life, id: string): boolean
	return table.find(life.Events, id) ~= nil
end

function RandomEvents.Eligible(life, pool)
	local list = {}
	for _, event in ipairs(pool) do
		if table.find(event.Stages, life.Stage) and not (event.Once ~= false and hadEvent(life, event.Id)) and Conditions.Check(life, event.Requires) then
			table.insert(list, event)
		end
	end
	return list
end

function RandomEvents.Roll(life, pool, rng)
	if rng:NextNumber() >= Config.EventChance then
		return nil
	end
	local eligible = RandomEvents.Eligible(life, pool)
	if #eligible == 0 then
		return nil
	end
	local weights, total = {}, 0
	for i, event in ipairs(eligible) do
		weights[i] = ScenarioPicker.Weight(event, life, RandomEvents.RarityWeight[event.Rarity] or 1)
		total += weights[i]
	end
	local roll = rng:NextNumber() * total
	for i, event in ipairs(eligible) do
		roll -= weights[i]
		if roll <= 0 then
			return event
		end
	end
	return eligible[#eligible]
end

return RandomEvents
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">Reveal</string>
            <string name="Source"><![CDATA[--[[
	Reveal  (ServerScriptService.Server.Lib.Reveal)
	Builds LIFE REVEAL moments from a life's real state.

	Reveal.Stage(life, completedStage, rng) -> payload
	  End-of-stage reveal: predictions (Shared/Util/Futures), headline and
	  warning, cinematic archetype, who-you-became highlights, how the odds
	  moved since the last reveal, and maybe a TWIST that really changes the
	  life (Content/Twists) with odds before → after. Also writes the
	  predictions into the stage's life.Reveals snapshot.

	Reveal.Final(life, nextId) -> historyEntry
	  The final reveal / Life History entry: ending title, achievements,
	  greatest moments, biggest mistakes, key decisions, family, wealth,
	  career, stats, which futures came true, and the prediction journey.

	Reveal.Card(life) -> shareable summary for comparing with other players.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Futures = require(Shared.Util.Futures)
local Endings = require(Shared.Util.Endings)
local Budget = require(Shared.Util.Budget)
local People = require(Shared.Util.People)
local StatMath = require(Shared.Util.StatMath)
local StatDefinitions = require(Shared.Data.StatDefinitions)
local LifeStages = require(Shared.Data.LifeStages)
local Careers = require(Shared.Data.Careers)
local Traits = require(Shared.Data.Traits)
local Assets = require(Shared.Data.Assets)
local Config = require(Shared.Config)

local Conditions = require(script.Parent.Conditions)
local Consequences = require(script.Parent.Consequences)
local Content = script.Parent.Parent.Content
local Scenarios = require(Content.Scenarios)
local Twists = require(Content.Twists)

local Reveal = {}

Reveal.Twists = Twists
Reveal.TwistById = {}
for _, twist in ipairs(Twists) do
	Reveal.TwistById[twist.Id] = twist
end

Reveal.AchievementFlags = {
	Astronaut = "🚀 Went to space",
	SpaceHero = "🛰️ Saved a space mission",
	NobelPrize = "🏆 Won the world's top science prize",
	LotteryWinner = "🎰 Won the lottery",
	Celebrity = "🌟 Became a celebrity",
	Tycoon = "🏙️ Built a business empire",
	Champion = "🏅 Won a championship",
	WorldChampion = "🎮 Became world champion",
	Bestseller = "📚 Wrote a bestseller",
	Published = "✍️ Got published",
	Album = "💿 Recorded an album",
	AwardWinner = "🏆 Won a major award",
	LifetimeAward = "🎖️ Received a lifetime achievement award",
	Foundation = "🎁 Set up a charitable foundation",
	Philanthropist = "💝 Gave generously to charity",
	MiracleDoctor = "🩺 Performed a 'miracle' operation",
	PeoplesLawyer = "⚖️ Won a landmark case for a family in need",
	StarChef = "⭐ Earned a five-star review",
	Inventor = "💡 Patented an invention",
	Councillor = "🗳️ Was elected to the council",
	SavedPark = "🌳 Saved the local park",
	ChessChampion = "♟️ Became senior chess champion",
	Marathoner = "🏃 Ran a marathon",
	Sailor = "⛵ Sailed around the world",
	Honours = "🎓 Graduated with top honours",
	AppHit = "📱 Made a chart-topping app",
	Detective = "🕵️ Became a detective",
	LifeChangingTeacher = "🍎 Changed a student's life",
	Grandparent = "👶 Became a grandparent",
	ViralSenior = "📱 Became the internet's favourite grandparent",
	Prodigy = "🎹 Was a child prodigy",
}

local function round(n: number): number
	return math.floor(n + 0.5)
end

local function topPredictions(predictions, count: number)
	local positives = Futures.Sorted(predictions)
	local top = {}
	for i = 1, math.min(count, #positives) do
		table.insert(top, { Id = positives[i].Id, Pct = positives[i].Pct })
	end
	return top
end

-- Decides which kind of twist fits the current predictions.
local function pickTwist(life, predictions, rng, completedStage: number)
	local positives, risks = Futures.Sorted(predictions)
	local kind, counter
	if risks[1].Pct >= 45 then
		kind, counter = "Rescue", risks[1].Id
	elseif positives[1].Pct >= 60 then
		kind, counter = "Setback", positives[1].Id
	else
		kind = "Surprise"
	end
	local function candidates(wantKind, wantCounter)
		local list = {}
		for _, twist in ipairs(Twists) do
			if twist.Kind == wantKind and table.find(twist.Stages, completedStage) and not table.find(life.Events, twist.Id) and Conditions.Check(life, twist.Requires) then
				if not wantCounter or table.find(twist.Counters, wantCounter) then
					table.insert(list, twist)
				end
			end
		end
		return list
	end
	local list = candidates(kind, counter)
	if #list == 0 then
		list = candidates("Surprise", nil)
	end
	if #list == 0 then
		return nil
	end
	return list[rng:NextInteger(1, #list)]
end

-- Short "who you became" lines for the reveal.
local function becameHighlights(life)
	local lines = {}
	local traitList = {}
	for id, strength in pairs(life.Traits) do
		table.insert(traitList, { Id = id, Strength = strength })
	end
	table.sort(traitList, function(a, b)
		return a.Strength > b.Strength
	end)
	for i = 1, math.min(3, #traitList) do
		local info = Traits.Info[traitList[i].Id]
		if info then
			table.insert(lines, info.Icon .. " " .. info.DisplayName)
		end
	end
	-- Strongest and weakest stats.
	local order = table.clone(StatDefinitions.Order)
	table.sort(order, function(a, b)
		return life.Stats[a] > life.Stats[b]
	end)
	local strongest = StatDefinitions.Info[order[1]]
	table.insert(lines, ("%s Strongest: %s (%d)"):format(strongest.Icon, strongest.DisplayName, round(life.Stats[order[1]])))
	return lines
end

function Reveal.Stage(life, completedStage: number, rng)
	local record = life.Reveals[#life.Reveals]
	local previous = life.Reveals[#life.Reveals - 1]
	local before = Futures.Predict(life)
	local payload = {
		Stage = completedStage,
		StageName = LifeStages.Get(completedStage).DisplayName,
		NextStageName = if completedStage < LifeStages.Count then LifeStages.Get(completedStage + 1).DisplayName else nil,
		Age = life.Age,
		Became = becameHighlights(life),
		Previous = previous and previous.Predictions or nil,
	}

	local predictions = before
	if completedStage < LifeStages.Count and rng:NextNumber() < Config.TwistChance then
		local twist = pickTwist(life, before, rng, completedStage)
		if twist then
			local summary = Consequences.Apply(life, twist.Effects, rng)
			table.insert(life.Events, twist.Id)
			summary.Applied.Wealth = nil
			predictions = Futures.Predict(life)
			payload.Twist = {
				Id = twist.Id,
				Kind = twist.Kind,
				Icon = twist.Icon,
				Title = twist.Title,
				Story = summary.Story,
				Applied = summary.Applied,
				MoneyDelta = summary.MoneyDelta,
				LifeChanges = summary.LifeChanges,
				BondChanges = summary.BondChanges,
				Before = before,
			}
			if record then
				record.Stats = table.clone(life.Stats) -- a twist isn't a "trend"
				record.Money = life.Money
				record.Twist = twist.Id
			end
		end
	end

	local headline, warning = Futures.Headline(predictions)
	payload.Predictions = predictions
	payload.Headline = headline
	payload.Warning = warning
	payload.Archetype = Futures.Archetype(predictions)
	if record then
		record.Predictions = predictions
		record.Headline = headline
		record.Archetype = payload.Archetype
	end
	return payload
end

-- ===== Final reveal =====
local function decisionText(d): string
	if d.X and d.T then
		return ("Age %d: %s (%s)"):format(d.Age, d.X, d.T)
	end
	return ("Age %d: a choice that mattered"):format(d.Age)
end

function Reveal.Final(life, nextId: number)
	local ending, ctx = Endings.Determine(life)
	local outcomes = ctx.Outcomes
	local decisions = {}
	for _, d in ipairs(life.Decisions) do
		table.insert(decisions, d)
	end

	-- Key decisions: the most consequential choices, in life order.
	table.sort(decisions, function(a, b)
		return (a.I or 0) > (b.I or 0)
	end)
	local key = {}
	for i = 1, math.min(5, #decisions) do
		local d = decisions[i]
		table.insert(key, { Age = d.Age, Title = d.T or "", Choice = d.X or "" })
	end
	table.sort(key, function(a, b)
		return a.Age < b.Age
	end)

	-- Greatest moments and biggest mistakes by how good/bad they were.
	table.sort(decisions, function(a, b)
		return (a.G or 0) > (b.G or 0)
	end)
	local moments, mistakes = {}, {}
	for i = 1, math.min(3, #decisions) do
		if (decisions[i].G or 0) >= 6 then
			table.insert(moments, decisionText(decisions[i]))
		end
	end
	for i = #decisions, math.max(1, #decisions - 2), -1 do
		if (decisions[i].G or 0) <= -4 then
			table.insert(mistakes, decisionText(decisions[i]))
		end
	end
	for _, eventId in ipairs(life.Events) do
		local event = Scenarios.EventById[eventId]
		local twist = Reveal.TwistById[eventId]
		if event and (event.Rarity == "Rare" or event.Rarity == "Legendary") and #moments < 6 then
			table.insert(moments, event.Icon .. " " .. event.Title)
		elseif twist and twist.Kind ~= "Setback" and #moments < 6 then
			table.insert(moments, twist.Icon .. " " .. twist.Title)
		end
	end

	-- Moments shared with friends (group events in a Life Circle).
	for i = #(life.Shared or {}), 1, -1 do
		local shared = life.Shared[i]
		if #moments >= 7 then
			break
		end
		table.insert(moments, ("%s With %s: %s"):format(shared.Icon or "🤝", table.concat(shared.With or {}, " & "), shared.Title))
	end

	-- Achievements.
	local achievements = {}
	if outcomes.Millionaire then
		table.insert(achievements, "💰 Became a millionaire")
	end
	if outcomes.Career then
		table.insert(achievements, "💼 Reached the top of their field")
	end
	if (Careers.EducationRank[life.Education] or 0) >= 2 then
		table.insert(achievements, "🎓 Earned a " .. Careers.EducationNames[life.Education])
	end
	if life.Assets.House or life.Assets.Mansion or life.Assets.Apartment then
		table.insert(achievements, "🏠 Owned their own home")
	end
	for flagId, text in pairs(Reveal.AchievementFlags) do
		if life.Flags[flagId] then
			table.insert(achievements, text)
		end
	end
	table.sort(achievements)

	-- Family.
	local partner = People.Partner(life)
	local children = {}
	for _, child in ipairs(People.ByRole(life, "Child")) do
		table.insert(children, child.Name)
	end
	local bestFriend = People.ByRole(life, "BestFriend")[1]

	-- Prediction journey across the stages.
	local journey = {}
	for _, r in ipairs(life.Reveals) do
		if r.Predictions then
			table.insert(journey, { Stage = r.Stage, Age = r.Age, Top = topPredictions(r.Predictions, 3), Headline = r.Headline, Twist = r.Twist })
		end
	end

	local came = {}
	for _, id in ipairs(Futures.Order) do
		if outcomes[id] then
			table.insert(came, id)
		end
	end

	local stats = {}
	for _, statName in ipairs(StatDefinitions.Order) do
		stats[statName] = round(life.Stats[statName])
	end
	local bestCareer = life.BestCareer
	local overall = ctx.Overall
	local coins = math.floor(40 + overall + 5 * #came + (ending.Coins or 30))

	return {
		Id = nextId,
		Name = life.Name,
		Ending = { Id = ending.Id, Title = ending.Title, Icon = ending.Icon, Line = (ending.Line:gsub("{name}", life.Name)) },
		Age = life.Age,
		CompletedAt = os.time(),
		NetWorth = math.floor(ctx.NetWorth),
		Money = life.Money,
		Overall = round(overall),
		Stats = stats,
		Career = if bestCareer then Careers.TitleAt(bestCareer.Id, bestCareer.Level) else "No career",
		CareerId = if bestCareer then bestCareer.Id else "None",
		Education = Careers.EducationNames[life.Education] or "None",
		Partner = if partner then { Name = partner.Name, Married = partner.Married == true, Bond = round(partner.Bond) } else false,
		Children = children,
		BestFriend = if bestFriend then bestFriend.Name else false,
		Achievements = achievements,
		Moments = moments,
		Mistakes = mistakes,
		KeyDecisions = key,
		Journey = journey,
		CameTrue = came,
		DecisionCount = #life.Decisions,
		Coins = coins,
	}
end

-- ===== Shareable card for comparisons =====
function Reveal.Card(life, includeStats: boolean)
	local predictions = Futures.Predict(life)
	local headline = Futures.Headline(predictions)
	local card = {
		LifeName = life.Name,
		Age = life.Age,
		StageName = LifeStages.Get(life.Stage).DisplayName,
		Completed = life.Completed,
		Career = if life.Career.Id ~= "None" and Careers.Info[life.Career.Id] then Careers.TitleAt(life.Career.Id, life.Career.Level) elseif life.Flags.Retired then "Retired" else "—",
		Predictions = predictions,
		Headline = headline,
		Archetype = Futures.Archetype(predictions),
		Married = life.Relationships.Married,
		Children = life.Relationships.Children,
	}
	if includeStats then
		card.Stats = {}
		for _, statName in ipairs(StatDefinitions.Order) do
			card.Stats[statName] = round(life.Stats[statName])
		end
		card.NetWorth = math.floor(Budget.NetWorth(life))
		card.Overall = round(StatMath.Overall(life.Stats))
		-- Show off your lifestyle: homes, cars and more.
		local owned = {}
		for id in pairs(life.Assets) do
			local asset = Assets.Info[id]
			if asset then
				table.insert(owned, asset.Icon .. " " .. asset.Title)
			end
		end
		table.sort(owned)
		card.Assets = owned
	end
	return card
end

return Reveal
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">ScenarioPicker</string>
            <string name="Source"><![CDATA[--[[
	ScenarioPicker  (ServerScriptService.Server.Lib.ScenarioPicker)
	Chooses the next scenario for a life from a stage's pool.

	Rules, in order:
	  1. Only scenarios for the life's current stage (Stage, or any of Stages)
	     whose Requires pass.
	  2. Scenarios marked Once are skipped if already seen this life.
	  3. If any eligible scenario has a Priority, the highest Priority wins
	     (used for "first day of school"-style openers).
	  4. Otherwise a weighted random pick. Weight = scenario.Weight (default 1)
	     × Boost multipliers for matching flags/traits, so earlier decisions make
	     related situations more likely. Recently seen repeatables are down-weighted.
]]

local Conditions = require(script.Parent.Conditions)

local ScenarioPicker = {}

--[[
	Weight for a scenario or random event:
	  base × Boost.Flags[flag] (if set) × Boost.Traits (scaled by strength)
	       × Boost.Stats[stat].Multiplier (if stat ≥ Min, or ≤ Max)
	Seen repeatable scenarios are down-weighted.
]]
function ScenarioPicker.Weight(entry, life, base: number): number
	local weight = base
	local boost = entry.Boost
	if boost then
		if boost.Flags then
			for flag, multiplier in pairs(boost.Flags) do
				if life.Flags[flag] then
					weight *= multiplier
				end
			end
		end
		if boost.Traits then
			for trait, multiplier in pairs(boost.Traits) do
				local strength = life.Traits[trait]
				if strength then
					weight *= 1 + (multiplier - 1) * math.min(strength, 3) / 3
				end
			end
		end
		if boost.Stats then
			for stat, rule in pairs(boost.Stats) do
				local value = life.Stats[stat] or 0
				if (rule.Min and value >= rule.Min) or (rule.Max and value <= rule.Max) then
					weight *= rule.Multiplier
				end
			end
		end
	end
	if life.Seen[entry.Id] then
		weight *= 0.25
	end
	return weight
end

local function weightFor(scenario, life): number
	return ScenarioPicker.Weight(scenario, life, scenario.Weight or 1)
end

function ScenarioPicker.Eligible(life, pool)
	local eligible = {}
	for _, scenario in ipairs(pool) do
		local stageMatch = scenario.Stage == life.Stage or (scenario.Stages ~= nil and table.find(scenario.Stages, life.Stage) ~= nil)
		if stageMatch and not (scenario.Once and life.Seen[scenario.Id]) and Conditions.Check(life, scenario.Requires) then
			table.insert(eligible, scenario)
		end
	end
	return eligible
end

function ScenarioPicker.Pick(life, pool, rng)
	local eligible = ScenarioPicker.Eligible(life, pool)
	if #eligible == 0 then
		return nil
	end

	local best, bestPriority = nil, -math.huge
	for _, scenario in ipairs(eligible) do
		if scenario.Priority and scenario.Priority > bestPriority then
			best, bestPriority = scenario, scenario.Priority
		end
	end
	if best then
		return best
	end

	local total = 0
	local weights = {}
	for i, scenario in ipairs(eligible) do
		weights[i] = weightFor(scenario, life)
		total += weights[i]
	end
	local roll = rng:NextNumber() * total
	for i, scenario in ipairs(eligible) do
		roll -= weights[i]
		if roll <= 0 then
			return scenario
		end
	end
	return eligible[#eligible]
end

return ScenarioPicker
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">SessionLock</string>
            <string name="Source"><![CDATA[--[[
	SessionLock  (ServerScriptService.Server.Lib.SessionLock)
	Pure transform functions used inside DataStore:UpdateAsync so only one
	server can own a player's data at a time (prevents item/coin duplication
	when a player hops servers quickly).

	Stored record shape:  { Data = profile, Lock = { JobId = string, Time = unix } | nil }
]]

local SessionLock = {}

SessionLock.Result = {
	Acquired = "Acquired",
	Locked = "Locked", -- another live server owns it; caller should retry
}

--[[
	Attempt to claim `record` for `jobId`.
	Returns newRecord (to write, or nil to cancel the write), result.
	A lock older than `expiry` seconds is considered abandoned and is taken over.
]]
function SessionLock.Acquire(record: any, jobId: string, now: number, expiry: number)
	if type(record) ~= "table" then
		record = { Data = nil, Lock = nil }
	end
	local lock = record.Lock
	if type(lock) == "table" and lock.JobId ~= jobId and type(lock.Time) == "number" and now - lock.Time < expiry then
		return nil, SessionLock.Result.Locked
	end
	record.Lock = { JobId = jobId, Time = now }
	return record, SessionLock.Result.Acquired
end

--[[
	Write `data` back. If `release` the lock is cleared, otherwise refreshed.
	Returns nil (cancel write) if a different server has taken the lock, so a
	stale server can never overwrite newer data.
]]
function SessionLock.Write(record: any, jobId: string, data: any, now: number, release: boolean)
	if type(record) == "table" and type(record.Lock) == "table" and record.Lock.JobId ~= jobId then
		return nil, "LockStolen"
	end
	local newRecord = { Data = data, Lock = nil }
	if not release then
		newRecord.Lock = { JobId = jobId, Time = now }
	end
	return newRecord, "Written"
end

return SessionLock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">Validate</string>
            <string name="Source"><![CDATA[--[[
	Validate  (ServerScriptService.Server.Lib.Validate)
	Argument checks for anything arriving from a client. Each function returns
	the sanitized value or nil if invalid. Never trust client types or ranges.
]]

local Validate = {}

function Validate.Number(value: any, min: number, max: number): number?
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return nil
	end
	if value < min or value > max then
		return nil
	end
	return value
end

function Validate.Integer(value: any, min: number, max: number): number?
	local n = Validate.Number(value, min, max)
	if n and n % 1 == 0 then
		return n
	end
	return nil
end

function Validate.String(value: any, maxLength: number): string?
	if type(value) ~= "string" or #value == 0 or #value > maxLength or not utf8.len(value) then
		return nil
	end
	return value
end

function Validate.Boolean(value: any): boolean?
	if type(value) == "boolean" then
		return value
	end
	return nil
end

function Validate.OneOf(value: any, options: { any }): any
	if table.find(options, value) then
		return value
	end
	return nil
end

-- Identifiers used for scenario/choice/item ids: letters, digits, underscore.
function Validate.Id(value: any, maxLength: number?): string?
	local s = Validate.String(value, maxLength or 64)
	if s and s:match("^[%w_]+$") then
		return s
	end
	return nil
end

--[[
	Validates a partial settings table against a schema:
	schema[key] = { Kind = "Number"|"Boolean"|"OneOf", Min, Max, Options }
	Unknown keys are dropped. Returns a new table with only valid entries.
]]
function Validate.Partial(input: any, schema: { [string]: any }): { [string]: any }
	local out = {}
	if type(input) ~= "table" then
		return out
	end
	for key, rule in pairs(schema) do
		local raw = input[key]
		if raw ~= nil then
			local value
			if rule.Kind == "Number" then
				value = Validate.Number(raw, rule.Min, rule.Max)
			elseif rule.Kind == "Boolean" then
				value = Validate.Boolean(raw)
			elseif rule.Kind == "OneOf" then
				value = Validate.OneOf(raw, rule.Options)
			end
			if value ~= nil then
				out[key] = value
			end
		end
	end
	return out
end

return Validate
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">Yearly</string>
            <string name="Source"><![CDATA[--[[
	Yearly  (ServerScriptService.Server.Lib.Yearly)
	What happens to a life as years pass between decisions. For each year:
	  • money: the budget from Shared/Util/Budget (salary savings, pension, rent,
	    unemployment, children under 18, loan repayments)
	  • investments: a market return (usually +, sometimes a crash)
	  • career: years in role; strong performers may be promoted automatically
	    (more likely with a Career focus)
	  • lifestyle focus: small stat changes each year (Shared/Data/Lifestyle)
	  • people: bonds fade unless maintained; close bonds lift Happiness and
	    pull the Relationships stat toward them; loneliness hurts; a very weak
	    partner bond can end the relationship
	  • ageing: Health slowly declines after 55, faster after 70
	Called by LifeService inside the decision update, with the life's seeded RNG.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Careers = require(Shared.Data.Careers)
local Lifestyle = require(Shared.Data.Lifestyle)
local Budget = require(Shared.Util.Budget)
local People = require(Shared.Util.People)
local Format = require(Shared.Util.Format)
local Consequences = require(script.Parent.Consequences)

local Yearly = {}

-- Re-exported for tests and tuning.
Yearly.BaseSavingsRate = Budget.BaseSavingsRate
Yearly.RentCost = Budget.RentCost
Yearly.ChildCost = Budget.ChildCost
Yearly.PensionShare = Budget.PensionShare
Yearly.AutoPromoteYears = 6
Yearly.AutoPromoteMinCareer = 60
Yearly.AutoPromoteChance = 0.25
Yearly.MarketReturn = 0.045
Yearly.MarketSwing = 0.22
Yearly.CrashChance = 0.06
Yearly.NeglectBond = 15 -- partner bond below this risks a break-up
Yearly.NeglectChance = 0.25

local function payLoans(life, summary)
	local paidTotal = 0
	for i = #life.Loans, 1, -1 do
		local loan = life.Loans[i]
		local owed = math.ceil(loan.Balance * (1 + loan.Rate))
		local due = math.min(loan.Payment, owed)
		local paid = math.min(due, life.Money)
		life.Money -= paid
		paidTotal += paid
		loan.Balance = owed - paid
		if loan.Balance <= 0 then
			table.remove(life.Loans, i)
			table.insert(summary.LifeChanges, "🎉 Paid off your " .. string.lower(Consequences.LoanKinds[loan.Kind].Title))
		end
	end
	return paidTotal
end

local function growInvestments(life, rng, summary): number
	if (life.Investments or 0) <= 0 then
		return 0
	end
	local r
	if rng:NextNumber() < Yearly.CrashChance then
		r = -0.3
	else
		r = Yearly.MarketReturn + (rng:NextNumber() - 0.5) * Yearly.MarketSwing
	end
	local before = life.Investments
	life.Investments = math.max(0, math.floor(before * (1 + r)))
	if r == -0.3 then
		table.insert(summary.LifeChanges, "📉 Market crash! Investments fell 30%")
	end
	return life.Investments - before
end

local function tendPeople(life, focus, summary, rng)
	for _, person in ipairs(life.People) do
		local info = People.Roles[person.Role]
		if info and info.Decay > 0 then
			local decay = if person.Married and info.MarriedDecay then info.MarriedDecay else info.Decay
			if focus.BondDecay then
				decay += (focus.BondDecay[person.Role] or 0) + (focus.BondDecay.All or 0)
			end
			People.ChangeBond(person, -decay) -- gradual drift: visible in the People panel, not as chips
		end
	end
	local partner = People.Partner(life)
	if partner and partner.Bond < Yearly.NeglectBond and rng:NextNumber() < Yearly.NeglectChance then
		local married = partner.Married
		Consequences.EndRelationship(life, summary, ("💔 You and %s drifted apart%s"):format(partner.Name, if married then " and divorced" else ""))
		Consequences.AddStats(life, { Happiness = -8 }, summary, false)
		if married then
			local before = life.Money
			life.Money = math.floor(life.Money * 0.75)
			summary.MoneyDelta += life.Money - before
		end
	end
end

local function relationshipMood(life, summary)
	local close = People.CloseBond(life)
	local deltas = {}
	if close then
		deltas.Happiness = (close - 50) / 50 * 0.8
		deltas.Relationships = (close - life.Stats.Relationships) * 0.12
	end
	local hasSomeone = People.Partner(life) ~= nil or life.Relationships.Friends > 0
	if life.Age >= 25 and not hasSomeone then
		deltas.Happiness = (deltas.Happiness or 0) - 0.5
	end
	if next(deltas) then
		Consequences.AddStats(life, deltas, summary, false)
	end
end

--[[
	Advances `years` years starting at `startAge`. Mutates life and adds to
	`summary` (a Consequences summary). Returns { Years, Income, Investment }.
]]
function Yearly.Advance(life, startAge: number, years: number, rng, summary)
	local income, investment = 0, 0
	local healthLoss = 0
	local focusTotals = {}
	local focus = Lifestyle.Info[life.Focus] or Lifestyle.Info.Balanced
	local savedAge = life.Age
	for i = 0, years - 1 do
		local age = startAge + i
		life.Age = age -- budget and people depend on the age during that year
		local before = life.Money
		local budget = Budget.Breakdown(life, age)
		local net = budget.Net - (budget.Lines.Loans or 0) -- loans paid separately below
		life.Money = math.max(0, math.floor(life.Money + net))
		payLoans(life, summary)
		income += life.Money - before
		investment += growInvestments(life, rng, summary)

		local career = life.Career
		if career.Id ~= "None" then
			career.YearsInRole += 1
			if career.YearsInRole >= Yearly.AutoPromoteYears and career.Level < Careers.MaxLevel and life.Stats.Career >= Yearly.AutoPromoteMinCareer then
				if rng:NextNumber() < Yearly.AutoPromoteChance * (focus.PromotionMultiplier or 1) then
					Consequences.Promote(life, 1, summary)
				end
			end
		end

		local perYear = if age < 19 and focus.YouthPerYear then focus.YouthPerYear else focus.PerYear
		for stat, delta in pairs(perYear or {}) do
			if not (stat == "Career" and age < 19) then
				focusTotals[stat] = (focusTotals[stat] or 0) + delta
			end
		end
		tendPeople(life, focus, summary, rng)
		relationshipMood(life, summary)

		if age >= 70 then
			healthLoss += 0.8
		elseif age >= 55 then
			healthLoss += 0.4
		end
	end
	life.Age = savedAge
	if healthLoss > 0 then
		focusTotals.Health = (focusTotals.Health or 0) - healthLoss
	end
	if next(focusTotals) then
		Consequences.AddStats(life, focusTotals, summary, false)
	end
	summary.MoneyDelta += income
	if investment ~= 0 then
		table.insert(summary.LifeChanges, ("%s Investments %s%s"):format(if investment > 0 then "📈" else "📉", if investment > 0 then "+" else "", Format.Money(investment)))
	end
	Consequences.SyncWealth(life)
	return { Years = years, Income = income, Investment = investment }
end

return Yearly
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="66">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Main  (ServerScriptService.Server.Main)  — Script
	Server bootstrap. Steps:
	  1. Net.Init() creates every RemoteEvent/RemoteFunction.
	  2. Require every ModuleScript in Services, sorted by .Priority.
	  3. Call Init() on each in order. Init must not yield; it may connect to
	     other services' Signals (e.g. DataService.ProfileLoaded).
	  4. Call Start() on each in its own thread (may yield, may use other services).
	A service that errors is reported but does not stop the others from starting.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))
Net.Init()

local services = {}
for _, module in ipairs(script.Parent.Services:GetChildren()) do
	if module:IsA("ModuleScript") then
		local ok, service = pcall(require, module)
		if ok and type(service) == "table" then
			service.Name = service.Name or module.Name
			table.insert(services, service)
		else
			warn("[Server] Failed to load service " .. module.Name .. ": " .. tostring(service))
		end
	end
end

table.sort(services, function(a, b)
	return (a.Priority or 100) < (b.Priority or 100)
end)

for _, service in ipairs(services) do
	if service.Init then
		local ok, err = pcall(service.Init)
		if not ok then
			warn("[Server] " .. service.Name .. ".Init failed: " .. tostring(err))
		end
	end
end

for _, service in ipairs(services) do
	if service.Start then
		task.spawn(function()
			local ok, err = pcall(service.Start)
			if not ok then
				warn("[Server] " .. service.Name .. ".Start failed: " .. tostring(err))
			end
		end)
	end
end

print(("[Server] CHOOSE YOUR LIFE started with %d services"):format(#services))
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="67">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">ChallengeService</string>
            <string name="Source"><![CDATA[--[[
	ChallengeService  (ServerScriptService.Server.Services.ChallengeService)
	Daily and weekly challenges (Shared/Data/Challenges).
	  • Everyone gets the same challenges each UTC day / week, except that a
	    challenge you can no longer do (say, visiting a new district when
	    you've been everywhere) is swapped for the next one.
	  • When a new day or week starts for a player, their challenges are
	    replaced and each remembers where its counters were (Base), so only
	    progress made from then on counts.
	  • After every data change the server checks progress; a finished
	    challenge pays its Coins once, automatically, and says so.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Config = require(Shared.Config)
local Challenges = require(Shared.Data.Challenges)

local CoinRewards = require(script.Parent.Parent.Lib.CoinRewards)
local DataService = require(script.Parent.DataService)
local DailyService = require(script.Parent.DailyService)

local ChallengeService = {}
ChallengeService.Priority = 23

local queued: { [Player]: boolean } = {}

local function fresh(ids, lifetime)
	local set = {}
	for _, id in ipairs(ids) do
		set[id] = { Base = Challenges.CounterValue(Challenges.ById[id], lifetime), Done = false }
	end
	return set
end

-- Starts today's / this week's challenges if they changed. Call inside Update.
function ChallengeService.Roll(d, today: number)
	local week = Challenges.WeekOf(today)
	local c = d.Challenges
	local changed = false
	if c.DailyDay ~= today then
		c.DailyDay = today
		c.Daily = fresh(Challenges.ForDay(today, Config.DailyChallengeCount, d.Lifetime), d.Lifetime)
		changed = true
	end
	if c.WeeklyWeek ~= week then
		c.WeeklyWeek = week
		c.Weekly = fresh(Challenges.ForWeek(week, Config.WeeklyChallengeCount, d.Lifetime), d.Lifetime)
		changed = true
	end
	return changed
end

-- Rolls over if needed and pays for anything just finished.
function ChallengeService.Evaluate(player: Player)
	local data = DataService.Get(player)
	if not data then
		return {}
	end
	local today = DailyService.Today()
	local c = data.Challenges
	local needsRoll = c.DailyDay ~= today or c.WeeklyWeek ~= Challenges.WeekOf(today)
	local finished = {}
	for _, group in ipairs({ c.Daily, c.Weekly }) do
		for id, entry in pairs(group or {}) do
			local def = Challenges.ById[id]
			if def and not entry.Done then
				local progress, target = Challenges.Progress(def, entry, data.Lifetime)
				if progress >= target then
					table.insert(finished, id)
				end
			end
		end
	end
	if not needsRoll and #finished == 0 then
		return {}
	end
	local paid = {}
	DataService.Update(player, function(d)
		for _, id in ipairs(finished) do
			local entry = d.Challenges.Daily[id] or d.Challenges.Weekly[id]
			if entry and not entry.Done then
				entry.Done = true
				d.Lifetime.ChallengesCompleted += 1
				CoinRewards.GrantBonus(d, Challenges.ById[id].Coins)
				table.insert(paid, id)
			end
		end
		ChallengeService.Roll(d, today)
	end)
	for _, id in ipairs(paid) do
		local def = Challenges.ById[id]
		Net.Fire("Notify", player, { Title = "🎯 Challenge complete!", Text = ("%s %s · +%d 🪙"):format(def.Icon, def.Text, def.Coins), Kind = "Important", Duration = 5 })
	end
	return paid
end

function ChallengeService.Init()
	DataService.Changed:Connect(function(player)
		if queued[player] then
			return
		end
		queued[player] = true
		task.defer(function()
			queued[player] = nil
			if player.Parent then
				ChallengeService.Evaluate(player)
			end
		end)
	end)
	DataService.ProfileLoaded:Connect(ChallengeService.Evaluate)
end

function ChallengeService.Start()
	-- New day while playing: roll the challenges over even if nothing changes.
	task.spawn(function()
		while true do
			task.wait(60)
			for _, player in ipairs(Players:GetPlayers()) do
				pcall(ChallengeService.Evaluate, player)
			end
		end
	end)
end

return ChallengeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">CityEventService</string>
            <string name="Source"><![CDATA[--[[
	CityEventService  (ServerScriptService.Server.Services.CityEventService)
	Shared, server-wide events (Content/CityEvents): every few minutes the
	whole server gets the same invitation, such as a festival, the marathon
	or a free concert. Each player chooses to join or skip within the time
	limit. Joining applies the effects to that player's own life; chance
	outcomes are rolled once for the whole city, so everyone who joins
	shares the same result. A summary ("12 people joined!") follows.

	CityEventRespond(eventId, join) -> true, result | false, reason
	CityEventService.Trigger(eventId?) starts one now (tests / admin tools).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Config = require(Shared.Config)

local Server = script.Parent.Parent
local Conditions = require(Server.Lib.Conditions)
local Consequences = require(Server.Lib.Consequences)
local Scenarios = require(Server.Content.Scenarios)
local CoinRewards = require(Server.Lib.CoinRewards)

local DataService = require(script.Parent.DataService)

local CityEventService = {}
CityEventService.Priority = 37

local current = nil
local lastId = nil
local counter = 0
local rng = Random.new()

local function activeLife(player: Player)
	local life = DataService.GetActiveLife(player)
	if life and not life.Completed then
		return life
	end
	return nil
end

local function interval(): number
	return if RunService:IsStudio() then 90 else Config.CityEventInterval
end

local function minPlayers(): number
	return if RunService:IsStudio() then 1 else Config.CityEventMinPlayers
end

local function finish(event)
	if current ~= event then
		return
	end
	current = nil
	local joined, invited = 0, 0
	for _, response in pairs(event.Responses) do
		if response == "Join" then
			joined += 1
		end
	end
	for _ in pairs(event.Invited) do
		invited += 1
	end
	Net.FireAll("CityEventSummary", { EventId = event.Id, Icon = event.Def.Icon, Title = event.Def.Title, Joined = joined, Invited = invited })
end

function CityEventService.Current()
	return current
end

function CityEventService.Trigger(eventId: string?)
	if current then
		return false, "EventActive"
	end
	local pool = {}
	for _, def in ipairs(Scenarios.City) do
		if (not eventId or def.Id == eventId) and def.Id ~= lastId then
			table.insert(pool, def)
		end
	end
	if eventId and #pool == 0 then
		pool = { Scenarios.CityById[eventId] }
	end
	local def = pool[rng:NextInteger(1, #pool)]
	if not def then
		return false, "NoEvent"
	end
	counter += 1
	lastId = def.Id
	local event = {
		Id = counter,
		Def = def,
		OutcomeIndex = Consequences.RollOutcome(def.Effects, rng), -- the same for the whole city
		Responses = {},
		Invited = {},
		Deadline = os.clock() + Config.CityEventJoinSeconds,
	}
	current = event
	for _, player in ipairs(Players:GetPlayers()) do
		local life = activeLife(player)
		if life then
			local eligible = Conditions.Check(life, def.Requires)
			event.Invited[player] = eligible
			Net.Fire("CityEvent", player, {
				EventId = event.Id,
				Icon = def.Icon,
				Title = def.Title,
				Description = def.Description,
				JoinText = def.JoinText,
				SkipText = def.SkipText,
				Seconds = Config.CityEventJoinSeconds,
				Eligible = eligible,
			})
		end
	end
	task.delay(Config.CityEventJoinSeconds, function()
		finish(event)
	end)
	return true, { EventId = event.Id, Id = def.Id }
end

function CityEventService.Respond(player: Player, eventId: any, join: any)
	local event = current
	if not event or event.Id ~= eventId then
		return false, "NoEvent"
	end
	if event.Invited[player] == nil then
		return false, "NotInvited"
	end
	if event.Responses[player] then
		return false, "AlreadyResponded"
	end
	if join ~= true then
		event.Responses[player] = "Skip"
		return true, { Joined = false }
	end
	if not event.Invited[player] then
		return false, "NotEligible"
	end
	local result
	DataService.Update(player, function(d)
		local life = d.Slots[d.ActiveSlot]
		if type(life) ~= "table" or life.Completed then
			return
		end
		local lifeRng = Random.new((life.Seed + #life.Decisions * 17 + event.Id * 13) % 2147483646 + 1)
		local summary = Consequences.Apply(life, event.Def.Effects, lifeRng, true, event.OutcomeIndex)
		summary.Applied.Wealth = nil
		d.Lifetime.CityEvents += 1
		result = {
			Coins = CoinRewards.Grant(d, Config.CityEventCoins),
			Joined = true,
			Icon = event.Def.Icon,
			Title = event.Def.Title,
			Story = summary.Story,
			Applied = summary.Applied,
			MoneyDelta = summary.MoneyDelta,
			LifeChanges = summary.LifeChanges,
			TraitsGained = summary.TraitsGained,
			Lucky = event.OutcomeIndex > 0,
		}
	end)
	if not result then
		return false, "NoLife"
	end
	event.Responses[player] = "Join"
	return true, result
end

function CityEventService.Init() end

function CityEventService.Start()
	Net.Handle("CityEventRespond", CityEventService.Respond)
	task.spawn(function()
		while true do
			task.wait(interval())
			local active = 0
			for _, player in ipairs(Players:GetPlayers()) do
				if activeLife(player) then
					active += 1
				end
			end
			if active >= minPlayers() and not current then
				CityEventService.Trigger()
			end
		end
	end)
end

return CityEventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">CollectibleService</string>
            <string name="Source"><![CDATA[--[[
	CollectibleService  (ServerScriptService.Server.Services.CollectibleService)
	Memory Stars (Shared/Data/Collectibles) hidden around Lifeville.
	CollectStar(starId): the server checks the star exists, you haven't found
	it already, and your character is right next to it; then it's saved,
	pays Collectibles.Coins, and may unlock a secret achievement.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Collectibles = require(Shared.Data.Collectibles)

local Server = script.Parent.Parent
local Validate = require(Server.Lib.Validate)
local CoinRewards = require(Server.Lib.CoinRewards)
local DataService = require(script.Parent.DataService)
local ProgressService = require(script.Parent.ProgressService)
local WorldService = require(script.Parent.WorldService)

local CollectibleService = {}
CollectibleService.Priority = 24
CollectibleService.MaxDistance = 12

local stars: { [string]: BasePart } = {}

function CollectibleService.Part(starId: string): BasePart?
	return stars[starId]
end

function CollectibleService.Collect(player: Player, starId: string)
	local def = Collectibles.ById[starId]
	local part = stars[starId]
	if not def or not part then
		return false, "NoSuchStar"
	end
	local data = DataService.Get(player)
	if not data then
		return false, "NotLoaded"
	end
	if data.Collectibles[starId] then
		return false, "AlreadyFound"
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - part.Position).Magnitude > CollectibleService.MaxDistance then
		return false, "TooFar"
	end
	local found = 0
	DataService.Update(player, function(d)
		d.Collectibles[starId] = true
		CoinRewards.GrantBonus(d, Collectibles.Coins)
		for _ in pairs(d.Collectibles) do
			found += 1
		end
	end)
	if def.Secret then
		ProgressService.Unlock(player, def.Secret)
	end
	return true, { Found = found, Total = Collectibles.Total, Coins = Collectibles.Coins }
end

function CollectibleService.Init()
	local world = WorldService.Folder()
	for _, part in ipairs(CollectionService:GetTagged("CYL_Star")) do
		if not world or part:IsDescendantOf(world) then
			stars[part:GetAttribute("CYL_Star")] = part
		end
	end
end

function CollectibleService.Start()
	Net.Handle("CollectStar", function(player, starId)
		local id = Validate.Id(starId, 32)
		if not id then
			return false, "BadArgs"
		end
		return CollectibleService.Collect(player, id)
	end)
end

return CollectibleService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">CosmeticsService</string>
            <string name="Source"><![CDATA[--[[
	CosmeticsService  (ServerScriptService.Server.Services.CosmeticsService)
	Shows equipped cosmetics on the player's Roblox character for everyone in
	the server: a name tag (with title and name colour) above the head, and
	an aura (Sparkles / Fire / Smoke, built-in effects with no asset ids
	needed). Reapplied on spawn and whenever equipment changes. Visible once
	the 3D world is in play (Phase 8).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Style = require(Shared.Util.Style)

local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)

local CosmeticsService = {}
CosmeticsService.Priority = 17

local TAG = "CYL_Cosmetic"

local function color(hex: string?, fallback: Color3): Color3
	if type(hex) == "string" then
		local ok, value = pcall(Color3.fromHex, hex)
		if ok then
			return value
		end
	end
	return fallback
end

function CosmeticsService.Apply(player: Player)
	local character = player.Character
	local data = DataService.Get(player)
	if not character or not data then
		return
	end
	for _, d in ipairs(character:GetDescendants()) do
		if d:GetAttribute(TAG) then
			d:Destroy()
		end
	end
	local style = Style.Of(data.Inventory.Equipped)
	local head = character:FindFirstChild("Head")
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None -- our name tag replaces it
	end
	if head then
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "CYL_NameTag"
		billboard:SetAttribute(TAG, true)
		billboard.Size = UDim2.fromOffset(220, 56)
		billboard.StudsOffset = Vector3.new(0, 2.6, 0)
		billboard.MaxDistance = 80
		billboard.Adornee = head
		local name = Instance.new("TextLabel")
		name.Name = "Name"
		name.BackgroundTransparency = 1
		name.Size = UDim2.new(1, 0, 0.6, 0)
		name.Text = player.DisplayName
		name.TextScaled = true
		name.TextColor3 = color(style.NameColor, Color3.fromRGB(255, 255, 255))
		name.TextStrokeTransparency = 0.4
		name.Font = Enum.Font.GothamBold
		name.Parent = billboard
		if style.Title then
			local title = Instance.new("TextLabel")
			title.Name = "Title"
			title.BackgroundTransparency = 1
			title.Position = UDim2.fromScale(0, 0.6)
			title.Size = UDim2.new(1, 0, 0.4, 0)
			title.Text = style.Title
			title.TextScaled = true
			title.TextColor3 = Color3.fromRGB(255, 212, 90)
			title.TextStrokeTransparency = 0.5
			title.Font = Enum.Font.Gotham
			title.Parent = billboard
		end
		billboard.Parent = head
	end
	if root and style.Aura then
		local aura = style.Aura
		local effect
		if aura.Kind == "Fire" then
			effect = Instance.new("Fire")
			effect.Color = color(aura.Color, Color3.fromRGB(255, 106, 0))
			effect.SecondaryColor = color(aura.Secondary, Color3.fromRGB(255, 208, 0))
			effect.Size = 4
			effect.Heat = 6
		elseif aura.Kind == "Smoke" then
			effect = Instance.new("Smoke")
			effect.Color = color(aura.Color, Color3.fromRGB(180, 140, 255))
			effect.Opacity = 0.15
			effect.RiseVelocity = 2
			effect.Size = 2
		else
			effect = Instance.new("Sparkles")
			effect.SparkleColor = color(aura.Color, Color3.fromRGB(255, 255, 255))
		end
		effect.Name = "CYL_Aura"
		effect:SetAttribute(TAG, true)
		effect.Parent = root
	end
end

function CosmeticsService.Init()
	ShopService.EquipmentChanged:Connect(function(player)
		CosmeticsService.Apply(player)
	end)
end

function CosmeticsService.Start()
	local function watch(player: Player)
		player.CharacterAdded:Connect(function()
			task.wait() -- let the character finish assembling
			CosmeticsService.Apply(player)
		end)
		if player.Character then
			CosmeticsService.Apply(player)
		end
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in ipairs(Players:GetPlayers()) do
		watch(player)
	end
end

return CosmeticsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">DailyService</string>
            <string name="Source"><![CDATA[--[[
	DailyService  (ServerScriptService.Server.Services.DailyService)
	Daily rewards and login streaks.
	  • One reward per UTC day: ClaimDaily() → Coins from Config.DailyRewards,
	    by your streak day (1–7, then the cycle repeats; day 7 is the big one).
	  • Claim on consecutive days to grow the streak; miss a day and it
	    starts again at 1. Your best streak is kept (achievements, profile).
	  • The server's clock decides the day; clients can't claim twice.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Challenges = require(Shared.Data.Challenges)
local Daily = require(Shared.Util.Daily)

local CoinRewards = require(script.Parent.Parent.Lib.CoinRewards)
local DataService = require(script.Parent.DataService)

local DailyService = {}
DailyService.Priority = 22

-- Today's UTC day number (tests replace this).
function DailyService.Today(): number
	return Challenges.DayOf(os.time())
end

-- What claiming today would give (for a profile).
function DailyService.Status(data)
	return Daily.Status(data.Daily, DailyService.Today(), os.time())
end

function DailyService.Claim(player: Player)
	local data = DataService.Get(player)
	if not data then
		return false, "NotLoaded"
	end
	local result = nil
	DataService.Update(player, function(d)
		local status = DailyService.Status(d)
		if not status.Claimable then
			return
		end
		d.Daily.Streak = status.Streak
		d.Daily.LastClaimDay = status.Today
		d.Daily.BestStreak = math.max(d.Daily.BestStreak or 0, status.Streak)
		d.Lifetime.DailyClaims += 1
		result = { Coins = CoinRewards.GrantBonus(d, status.Reward), Streak = status.Streak, Day = status.Day }
	end)
	if not result then
		return false, "AlreadyClaimed"
	end
	return true, result
end

function DailyService.Init() end

function DailyService.Start()
	Net.Handle("ClaimDaily", function(player)
		return DailyService.Claim(player)
	end)
end

return DailyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--[[
	DataService  (ServerScriptService.Server.Services.DataService)
	Owns every player's saved profile on this server.

	• Loads with a session lock (Lib/SessionLock) inside UpdateAsync so two
	  servers can never both write the same player's data (anti-duplication).
	• Retries loads/saves with backoff; kicks with a friendly message rather
	  than letting a player play on unsaved/blank data.
	• Autosaves every Config.AutosaveInterval (this also refreshes the lock),
	  saves + releases on leave, and flushes everything in BindToClose.
	• Validates that data is DataStore-serializable before writing.
	• Replicates a sanitized snapshot to the owning client only (throttled).
	• Falls back to an in-memory MockDataStore in Studio when API access is off.

	Other services must change data ONLY through DataService.Update(player, fn).
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local DataTemplate = require(Shared.Data.DataTemplate)
local TableUtil = require(Shared.Util.TableUtil)
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Net)

local Lib = script.Parent.Parent.Lib
local SessionLock = require(Lib.SessionLock)
local MockDataStore = require(Lib.MockDataStore)

local DataService = {}
DataService.Priority = 0 -- initialised first; everything else depends on it

DataService.ProfileLoaded = Signal.new() -- (player, data)
DataService.ProfileReleasing = Signal.new() -- (player, data) fired before the final save
DataService.Changed = Signal.new() -- (player) after updates (batched with replication)
DataService.UsingMockStore = false

local JOB_ID = if game.JobId ~= "" then game.JobId else "Studio_" .. HttpService:GenerateGUID(false)

type Entry = {
	Data: any,
	Saving: boolean,
	Releasing: boolean,
	LockLost: boolean,
	ReplicationQueued: boolean,
	SentHistoryKey: string?,
}

local store: any = nil
local entries: { [Player]: Entry } = {}
local loading: { [Player]: boolean } = {}
local activeSaves = 0
local shuttingDown = false

local function keyFor(player: Player): string
	return Config.DataKeyPrefix .. player.UserId
end

local function chooseStore()
	local realStore
	local ok, err = pcall(function()
		realStore = DataStoreService:GetDataStore(Config.DataStoreName)
		if RunService:IsStudio() then
			realStore:GetAsync("__studio_probe")
		end
	end)
	if ok then
		return realStore, false
	end
	warn("[DataService] DataStores unavailable (" .. tostring(err) .. "). Using in-memory MockDataStore: progress will NOT persist.")
	return MockDataStore.new(), true
end

local function waitForBudget(requestType: Enum.DataStoreRequestType)
	if DataService.UsingMockStore then
		return
	end
	local deadline = os.clock() + 10
	while DataStoreService:GetRequestBudgetForRequestType(requestType) < 1 and os.clock() < deadline do
		task.wait(0.5)
	end
end

-- ===== Load =====
local function loadData(player: Player): (any, string?)
	local key = keyFor(player)
	for attempt = 1, Config.LoadRetries do
		local status, loadedRecord
		waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
		local ok, err = pcall(function()
			store:UpdateAsync(key, function(record)
				local newRecord, result = SessionLock.Acquire(record, JOB_ID, os.time(), Config.SessionLockExpiry)
				status = result
				loadedRecord = newRecord
				return newRecord
			end)
		end)

		if ok and status == SessionLock.Result.Acquired then
			local data = loadedRecord.Data
			if data == nil then
				data = DataTemplate.NewProfile()
			end
			local upgraded, reason = DataTemplate.Upgrade(data)
			if not upgraded then
				return nil, reason
			end
			return upgraded
		end

		if not ok then
			warn(("[DataService] Load attempt %d for %s failed: %s"):format(attempt, player.Name, tostring(err)))
		else
			warn(("[DataService] %s's data is locked by another server (attempt %d)"):format(player.Name, attempt))
		end
		if player.Parent == nil then
			return nil, "PlayerLeft"
		end
		task.wait(Config.LoadRetryDelay * attempt)
	end
	return nil, "Could not load data after " .. Config.LoadRetries .. " attempts"
end

-- ===== Save =====
-- Returns true when the write is confirmed.
local function writeData(player: Player, data: any, release: boolean): (boolean, string?)
	local serializable, problem = TableUtil.IsSerializable(data)
	if not serializable then
		warn("[DataService] Refusing to save unserializable data for " .. player.Name .. ": " .. tostring(problem))
		return false, "Unserializable"
	end
	local payload = TableUtil.DeepCopy(data)
	local key = keyFor(player)

	for attempt = 1, Config.SaveRetries do
		local status
		waitForBudget(Enum.DataStoreRequestType.UpdateAsync)
		local ok, err = pcall(function()
			store:UpdateAsync(key, function(record)
				local newRecord, result = SessionLock.Write(record, JOB_ID, payload, os.time(), release)
				status = result
				return newRecord
			end)
		end)
		if ok and status == "Written" then
			return true
		elseif ok and status == "LockStolen" then
			return false, "LockStolen"
		end
		warn(("[DataService] Save attempt %d for %s failed: %s"):format(attempt, player.Name, tostring(err)))
		if attempt < Config.SaveRetries then
			task.wait(2 ^ attempt)
		end
	end
	return false, "SaveFailed"
end

local function saveEntry(player: Player, release: boolean): boolean
	local entry = entries[player]
	if not entry or entry.LockLost then
		return false
	end
	while entry.Saving do
		task.wait()
	end
	entry.Saving = true
	activeSaves += 1
	local ok, reason = writeData(player, entry.Data, release)
	activeSaves -= 1
	entry.Saving = false

	if reason == "LockStolen" then
		entry.LockLost = true
		warn("[DataService] Another server took " .. player.Name .. "'s data; this server will stop saving it.")
		if player.Parent then
			player:Kick("Your game was opened on another server. Please rejoin.")
		end
	end
	return ok
end

-- ===== Replication =====
-- What the owning client is allowed to see. Server-only fields are stripped.
local function historyKey(data): string
	local history = data.LifeHistory or {}
	local last = history[#history]
	return #history .. ":" .. tostring(last and last.Id or 0)
end

--[[
	When `omitHistory` is true, LifeHistory (up to ~75 KB) is left out and
	`HistoryUnchanged = true` is set instead; the client keeps its copy.
	This keeps the frequent pushes after every decision small.
]]
function DataService.Snapshot(player: Player, omitHistory: boolean?)
	local entry = entries[player]
	if not entry then
		return nil
	end
	local snapshot = {}
	for key, value in pairs(entry.Data) do
		if key ~= "ProcessedReceipts" and not (omitHistory and key == "LifeHistory") then
			snapshot[key] = TableUtil.DeepCopy(value)
		end
	end
	if omitHistory then
		snapshot.HistoryUnchanged = true
	end
	for _, slotId in ipairs(DataTemplate.SlotIds) do
		local life = snapshot.Slots[slotId]
		if type(life) == "table" then
			life.Seed = nil -- never reveal the RNG seed
		end
	end
	return snapshot
end

local function replicate(player: Player)
	local entry = entries[player]
	if not entry or entry.ReplicationQueued then
		return
	end
	entry.ReplicationQueued = true
	task.delay(Config.ReplicationThrottle, function()
		entry.ReplicationQueued = false
		if entries[player] == entry and player.Parent then
			DataService.Changed:Fire(player)
			local key = historyKey(entry.Data)
			local omit = entry.SentHistoryKey == key
			entry.SentHistoryKey = key
			Net.Fire("DataSnapshot", player, DataService.Snapshot(player, omit))
		end
	end)
end

-- ===== Public API =====
function DataService.IsLoaded(player: Player): boolean
	return entries[player] ~= nil
end

-- Read-only access. Do NOT mutate the returned table; use Update.
function DataService.Get(player: Player)
	local entry = entries[player]
	return entry and entry.Data
end

function DataService.WaitForData(player: Player, timeout: number?)
	local deadline = os.clock() + (timeout or 30)
	while not entries[player] and player.Parent and os.clock() < deadline do
		task.wait(0.1)
	end
	return DataService.Get(player)
end

--[[
	The only way to change saved data. `mutator(data)` edits in place.
	Returns true + mutator's return value, or false if data isn't loaded.
	The mutator must not yield.
]]
function DataService.Update(player: Player, mutator: (any) -> any)
	local entry = entries[player]
	if not entry or entry.Releasing then
		return false
	end
	local result = mutator(entry.Data)
	replicate(player)
	return true, result
end

-- The life in the player's active save slot, or nil if that slot is empty.
function DataService.GetActiveLife(player: Player)
	local data = DataService.Get(player)
	if not data then
		return nil
	end
	local life = data.Slots[data.ActiveSlot]
	return if type(life) == "table" then life else nil
end

function DataService.SaveNow(player: Player): boolean
	return saveEntry(player, false)
end

-- ===== Lifecycle =====
local function onPlayerAdded(player: Player)
	if loading[player] or entries[player] then
		return
	end
	loading[player] = true
	local data, reason = loadData(player)
	loading[player] = nil

	if not data then
		if reason ~= "PlayerLeft" and player.Parent then
			warn("[DataService] Failed to load " .. player.Name .. ": " .. tostring(reason))
			player:Kick("We couldn't load your life safely (" .. tostring(reason) .. "). Please rejoin in a moment.")
		end
		return
	end

	local entry: Entry = { Data = data, Saving = false, Releasing = false, LockLost = false, ReplicationQueued = false }
	entries[player] = entry

	if player.Parent == nil then
		-- Left while loading: release the lock we just took.
		entry.Releasing = true
		saveEntry(player, true)
		entries[player] = nil
		return
	end

	DataService.ProfileLoaded:Fire(player, data)
	replicate(player)
end

local function onPlayerRemoving(player: Player)
	local entry = entries[player]
	if not entry or entry.Releasing then
		return
	end
	DataService.ProfileReleasing:Fire(player, entry.Data)
	task.wait() -- let ProfileReleasing handlers (deferred) run their final edits
	entry.Releasing = true
	saveEntry(player, true)
	entries[player] = nil
end

local function onClose()
	shuttingDown = true
	local pending = 0
	for player in pairs(entries) do
		pending += 1
		task.spawn(function()
			onPlayerRemoving(player)
			pending -= 1
		end)
	end
	local deadline = os.clock() + 25
	while (pending > 0 or activeSaves > 0) and os.clock() < deadline do
		task.wait(0.1)
	end
end

function DataService.Init()
	local chosen, isMock = chooseStore()
	store = chosen
	DataService.UsingMockStore = isMock
end

function DataService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end
	game:BindToClose(onClose)

	Net.Handle("GetData", function(player)
		local data = DataService.WaitForData(player, 30)
		if not data then
			return false, "NotLoaded"
		end
		local entry = entries[player]
		if entry then
			entry.SentHistoryKey = historyKey(entry.Data)
		end
		return true, DataService.Snapshot(player)
	end)

	task.spawn(function()
		while not shuttingDown do
			task.wait(Config.AutosaveInterval)
			for player, entry in pairs(entries) do
				if not entry.Releasing then
					task.spawn(saveEntry, player, false)
				end
			end
		end
	end)
end

-- Exposed for tests only.
DataService._setStore = function(s, isMock)
	store = s
	DataService.UsingMockStore = isMock
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[--[[
	LeaderboardService  (ServerScriptService.Server.Services.LeaderboardService)
	🏆 Global and friends leaderboards (Shared/Data/Leaderboards), the Hall of
	Fame board in Lifeville Plaza, and the player list (leaderstats).

	Global boards use one OrderedDataStore per board ("CYL_LB_<board>"):
	  • scores come from saved profiles on the server, never from clients;
	  • written when they change (every SubmitSeconds) and when you leave,
	    only while the DataStore request budget allows;
	  • players who set Privacy → My life stats to "Nobody" are removed
	    from global boards and the player list.
	Friends boards: your Roblox friends (Players:GetFriendsAsync), with live
	scores for friends in this server and cached lookups for the rest.
	In Studio without API access an in-memory store is used (nothing saved).
]]

local CollectionService = game:GetService("CollectionService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserService = game:GetService("UserService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Leaderboards = require(Shared.Data.Leaderboards)
local Format = require(Shared.Util.Format)

local Server = script.Parent.Parent
local Validate = require(Server.Lib.Validate)
local MockOrderedDataStore = require(Server.Lib.MockOrderedDataStore)
local DataService = require(script.Parent.DataService)

local LeaderboardService = {}
LeaderboardService.Priority = 26
LeaderboardService.SubmitSeconds = 120
LeaderboardService.CacheSeconds = 120
LeaderboardService.FriendCacheSeconds = 300
LeaderboardService.FriendLookups = 25 -- most DataStore reads one friends board request may make
LeaderboardService.TopSize = 50

local stores = {}
local submitted: { [Player]: { [string]: any } } = {}
local topCache = {}
local nameCache: { [number]: string } = {}
local friendCache: { [Player]: { Time: number, Ids: { number } } } = {}
local valueCache = {}

local function usingMock(): boolean
	return DataService.UsingMockStore == true
end

local function store(boardId: string)
	if stores[boardId] then
		return stores[boardId]
	end
	local s = nil
	if not usingMock() then
		local ok, result = pcall(function()
			return DataStoreService:GetOrderedDataStore("CYL_LB_" .. boardId)
		end)
		if ok then
			s = result
		end
	end
	s = s or MockOrderedDataStore.new()
	stores[boardId] = s
	return s
end

local function budget(requestType): boolean
	local ok, value = pcall(function()
		return DataStoreService:GetRequestBudgetForRequestType(requestType)
	end)
	return not ok or value > 0
end

local function playerById(userId: number): Player?
	for _, player in ipairs(Players:GetPlayers()) do
		if player.UserId == userId then
			return player
		end
	end
	return nil
end

local function hidden(data): boolean
	return data.Privacy and data.Privacy.ShareStats == "Nobody"
end

-- Writes this player's scores to the global boards if they changed.
function LeaderboardService.Submit(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	submitted[player] = submitted[player] or {}
	local mine = submitted[player]
	local key = tostring(player.UserId)
	for _, board in ipairs(Leaderboards.List) do
		local s = store(board.Id)
		if hidden(data) then
			if mine[board.Id] ~= "removed" and budget(Enum.DataStoreRequestType.SetIncrementSortedAsync) then
				if pcall(s.RemoveAsync, s, key) then
					mine[board.Id] = "removed"
				end
			end
		else
			local value = math.floor(board.Value(data))
			if value > 0 and mine[board.Id] ~= value and budget(Enum.DataStoreRequestType.SetIncrementSortedAsync) then
				local ok, err = pcall(s.SetAsync, s, key, value)
				if ok then
					mine[board.Id] = value
				else
					warn("[LeaderboardService] Couldn't save " .. board.Id .. ": " .. tostring(err))
				end
			end
		end
	end
	topCache = {} -- fresh scores show on the next look
end

local function resolveNames(ids: { number })
	local missing = {}
	for _, id in ipairs(ids) do
		local player = playerById(id)
		if player then
			nameCache[id] = player.DisplayName or player.Name
		elseif not nameCache[id] then
			table.insert(missing, id)
		end
	end
	if #missing > 0 then
		local ok, infos = pcall(function()
			return UserService:GetUserInfosByUserIdsAsync(missing)
		end)
		if ok and type(infos) == "table" then
			for _, info in ipairs(infos) do
				nameCache[info.Id] = info.DisplayName or info.Username
			end
		end
	end
end

-- Top scores worldwide: { { Rank, UserId, Name, Value } }.
function LeaderboardService.Top(boardId: string, force: boolean?)
	local cached = topCache[boardId]
	if cached and not force and os.clock() - cached.Time < LeaderboardService.CacheSeconds then
		return cached.Entries
	end
	if not budget(Enum.DataStoreRequestType.GetSortedAsync) then
		return if cached then cached.Entries else {}
	end
	local s = store(boardId)
	local ok, pages = pcall(s.GetSortedAsync, s, false, LeaderboardService.TopSize)
	if not ok then
		warn("[LeaderboardService] Couldn't read " .. boardId .. ": " .. tostring(pages))
		return if cached then cached.Entries else {}
	end
	local entries, ids = {}, {}
	for rank, item in ipairs(pages:GetCurrentPage()) do
		local userId = tonumber(item.key)
		if userId then
			table.insert(entries, { Rank = rank, UserId = userId, Value = item.value })
			table.insert(ids, userId)
		end
	end
	resolveNames(ids)
	for _, entry in ipairs(entries) do
		entry.Name = nameCache[entry.UserId] or ("Player " .. entry.UserId)
	end
	topCache[boardId] = { Time = os.clock(), Entries = entries }
	return entries
end

local function friendIds(player: Player): { number }
	local cached = friendCache[player]
	if cached and os.clock() - cached.Time < LeaderboardService.FriendCacheSeconds then
		return cached.Ids
	end
	local ids = {}
	local ok, pages = pcall(function()
		return Players:GetFriendsAsync(player.UserId)
	end)
	if ok and pages then
		local okPage, page = pcall(function()
			return pages:GetCurrentPage()
		end)
		if okPage and type(page) == "table" then
			for _, friend in ipairs(page) do
				table.insert(ids, friend.Id)
				nameCache[friend.Id] = friend.DisplayName or friend.Username
			end
		end
	end
	friendCache[player] = { Time = os.clock(), Ids = ids }
	return ids
end

-- You and your Roblox friends, best first.
function LeaderboardService.Friends(player: Player, boardId: string)
	local board = Leaderboards.ById[boardId]
	local data = DataService.Get(player)
	local entries = {}
	if data then
		table.insert(entries, { UserId = player.UserId, Name = player.DisplayName or player.Name, Value = math.floor(board.Value(data)) })
	end
	local s = store(boardId)
	local lookups = 0
	for _, id in ipairs(friendIds(player)) do
		local friend = playerById(id)
		local friendData = friend and DataService.Get(friend)
		if friendData then
			if not hidden(friendData) then
				table.insert(entries, { UserId = id, Name = friend.DisplayName or friend.Name, Value = math.floor(board.Value(friendData)), InServer = true })
			end
		else
			local key = boardId .. ":" .. id
			local cached = valueCache[key]
			if not (cached and os.clock() - cached.Time < LeaderboardService.FriendCacheSeconds) and lookups < LeaderboardService.FriendLookups and budget(Enum.DataStoreRequestType.GetAsync) then
				lookups += 1
				local ok, value = pcall(s.GetAsync, s, tostring(id))
				cached = { Time = os.clock(), Value = if ok then value else nil }
				valueCache[key] = cached
			end
			if cached and type(cached.Value) == "number" then
				table.insert(entries, { UserId = id, Name = nameCache[id] or ("Player " .. id), Value = cached.Value })
			end
		end
	end
	table.sort(entries, function(a, b)
		if a.Value == b.Value then
			return a.UserId < b.UserId
		end
		return a.Value > b.Value
	end)
	for rank, entry in ipairs(entries) do
		entry.Rank = rank
	end
	return entries
end

-- ===== Hall of Fame (Plaza) and the player list =====
function LeaderboardService.UpdateHallOfFame()
	local board = Leaderboards.ById[Leaderboards.HallOfFame]
	local entries = LeaderboardService.Top(board.Id, true)
	local lines = { "🏆 HALL OF FAME", board.Icon .. " " .. board.Name }
	for i = 1, 5 do
		local e = entries[i]
		table.insert(lines, if e then ("%d. %s · %s"):format(i, e.Name, if board.Money then Format.Money(e.Value) else tostring(e.Value)) else ("%d. —"):format(i))
	end
	local text = table.concat(lines, "\n")
	for _, part in ipairs(CollectionService:GetTagged("CYL_HallOfFame")) do
		local gui = part:FindFirstChild("Text")
		local label = gui and gui:FindFirstChild("Label")
		if label then
			label.Text = text
		end
	end
	return text
end

local function updateLeaderstats(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local folder = player:FindFirstChild("leaderstats")
	if hidden(data) then
		if folder then
			folder:Destroy()
		end
		return
	end
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "leaderstats"
		for _, name in ipairs({ "Lives", "Trophies" }) do
			local value = Instance.new("IntValue")
			value.Name = name
			value.Parent = folder
		end
		folder.Parent = player
	end
	folder.Lives.Value = data.Lifetime.LivesCompleted or 0
	folder.Trophies.Value = Leaderboards.ById.Achievements.Value(data)
end
LeaderboardService.UpdateLeaderstats = updateLeaderstats

function LeaderboardService.Init()
	DataService.ProfileLoaded:Connect(updateLeaderstats)
	DataService.Changed:Connect(updateLeaderstats)
	DataService.ProfileReleasing:Connect(function(player)
		LeaderboardService.Submit(player)
		submitted[player] = nil
		friendCache[player] = nil
	end)
end

function LeaderboardService.Start()
	local ids = {}
	for _, board in ipairs(Leaderboards.List) do
		table.insert(ids, board.Id)
	end
	Net.Handle("GetLeaderboard", function(player, boardId, scope)
		local id = Validate.OneOf(boardId, ids)
		local which = Validate.OneOf(scope, { "Global", "Friends" })
		if not id or not which then
			return false, "BadArgs"
		end
		LeaderboardService.Submit(player)
		local entries = if which == "Global" then LeaderboardService.Top(id) else LeaderboardService.Friends(player, id)
		local you = nil
		for _, entry in ipairs(entries) do
			if entry.UserId == player.UserId then
				you = entry
			end
		end
		return true, { Board = id, Scope = which, Entries = entries, You = you, Offline = usingMock() }
	end)
	task.spawn(function()
		while true do
			pcall(LeaderboardService.UpdateHallOfFame)
			task.wait(LeaderboardService.SubmitSeconds)
			for _, player in ipairs(Players:GetPlayers()) do
				pcall(LeaderboardService.Submit, player)
			end
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="75">
          <Properties>
            <string name="Name">LifeService</string>
            <string name="Source"><![CDATA[--[[
	LifeService  (ServerScriptService.Server.Services.LifeService)
	The authoritative life loop: save slots, starting/continuing lives,
	serving scenarios and resolving choices.

	Flow (client asks, server decides):
	  StartNewLife(slot, name, overwrite) -> true, slotId
	  ContinueLife(slot)                  -> true, slotId
	  DeleteLife(slot)                    -> true
	  GetScenario()                       -> true, scenarioPayload | false, reason
	  MakeChoice(scenarioId, choiceId)    -> true, outcome | false, reason

	Anti-exploit:
	  • The scenario being answered is stored in the save (life.CurrentScenario),
	    so a client can only answer the scenario it was given, once.
	  • Rejoining returns the same scenario (no rerolling bad situations).
	  • Randomness comes from a per-life server seed + decision count, so
	    leaving and rejoining can't reroll a chance outcome either.
	  • Locked choices are re-checked on the server.
	  • Names are length-checked and passed through Roblox text filtering.

	Signals for other systems:
	  LifeService.ChoiceMade(player, scenarioId, choiceId, summary)
	  LifeService.StageCompleted(player, stageId, life)    -- Phase 5 Life Reveal hooks here
	  LifeService.LifeCompleted(player, life)              -- Phase 5 final reveal hooks here
	  LifeService.LifeStarted(player, slotId, life)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local LifeStages = require(Shared.Data.LifeStages)
local DataTemplate = require(Shared.Data.DataTemplate)
local TableUtil = require(Shared.Util.TableUtil)
local Config = require(Shared.Config)
local Legacy = require(Shared.Data.Legacy)

local Server = script.Parent.Parent
local Validate = require(Server.Lib.Validate)
local Conditions = require(Server.Lib.Conditions)
local Consequences = require(Server.Lib.Consequences)
local ScenarioPicker = require(Server.Lib.ScenarioPicker)
local RandomEvents = require(Server.Lib.RandomEvents)
local Yearly = require(Server.Lib.Yearly)
local Actions = require(Server.Lib.Actions)
local Reveal = require(Server.Lib.Reveal)
local CoinRewards = require(Server.Lib.CoinRewards)
local Scenarios = require(Server.Content.Scenarios)

local DataService = require(script.Parent.DataService)
local StatService = require(script.Parent.StatService)

local LifeService = {}
LifeService.Priority = 30

LifeService.ChoiceMade = Signal.new()
LifeService.StageCompleted = Signal.new()
LifeService.LifeCompleted = Signal.new()
LifeService.LifeStarted = Signal.new()

local NAME_MIN, NAME_MAX = 2, 20

-- ===== Helpers =====
local function rngFor(life, salt: number)
	-- Deterministic per life + progress: same state always gives the same roll.
	return Random.new((life.Seed + #life.Decisions * 7919 + salt * 104729) % 2147483647)
end

local function activeLife(data)
	local life = data.Slots[data.ActiveSlot]
	return if type(life) == "table" then life else nil
end

local function cleanName(raw: any): string?
	if type(raw) ~= "string" then
		return nil
	end
	local name = raw:gsub("%c", ""):gsub("%s+", " "):match("^%s*(.-)%s*$")
	local length = utf8.len(name)
	if not length or length < NAME_MIN or length > NAME_MAX then
		return nil
	end
	return name
end

-- Roblox requires user-typed text shown to others to be filtered.
local function filterName(name: string, player: Player): string?
	local ok, result = pcall(function()
		local filtered = TextService:FilterStringAsync(name, player.UserId, Enum.TextFilterContext.PublicChat)
		return filtered:GetNonChatStringForBroadcastAsync()
	end)
	if not ok then
		if RunService:IsStudio() then
			-- Studio (especially unpublished places) may not offer filtering.
			-- Allow the name so testing works; live servers always reject.
			warn("[LifeService] Text filtering is unavailable in Studio, so the name is allowed for testing only: " .. tostring(result))
			return name
		end
		warn("[LifeService] Text filter unavailable: " .. tostring(result))
		return nil
	end
	if result ~= name then
		return nil -- something was censored; ask for a different name
	end
	return result
end

-- What the client is allowed to know about a scenario.
function LifeService.ToClient(scenario, life)
	local choices = {}
	for index, choice in ipairs(scenario.Choices) do
		local unlocked = Conditions.Check(life, choice.Requires)
		local preview, moneyDir, risky, tags = Consequences.Preview(choice.Effects)
		table.insert(choices, {
			Id = choice.Id,
			Index = index,
			Text = choice.Text,
			Description = choice.Description,
			Locked = not unlocked,
			LockHint = if unlocked then nil else (choice.LockHint or "Locked"),
			Mystery = choice.Mystery == true,
			Preview = if choice.Mystery then {} else preview,
			MoneyDir = if choice.Mystery then 0 else moneyDir,
			Risky = risky,
			Tags = if choice.Mystery or not unlocked then {} else tags,
		})
	end
	local stage = LifeStages.Get(life.Stage)
	return {
		Id = scenario.Id,
		Icon = scenario.Icon or "✨",
		Title = scenario.Title,
		Description = (scenario.Description:gsub("{name}", life.Name)),
		Age = life.Age,
		Stage = life.Stage,
		StageName = stage.DisplayName,
		ScenarioNumber = life.ScenarioIndex + 1,
		ScenariosInStage = stage.ScenariosPerStage,
		Choices = choices,
	}
end

-- ===== Remote handlers =====
-- Rebirth: applies a Legacy perk (Shared/Data/Legacy) to a brand-new life.
function LifeService.ApplyLegacy(life, perk)
	for stat, bonus in pairs(perk.Stats or {}) do
		if life.Stats[stat] ~= nil and stat ~= "Wealth" then
			life.Stats[stat] = math.clamp(life.Stats[stat] + bonus, 0, 100)
		end
	end
	if perk.Money then
		life.Money += perk.Money
	end
	life.Legacy = perk.Id
	Consequences.SyncWealth(life)
end

local function startNewLife(player: Player, slotArg: any, nameArg: any, overwriteArg: any, perkArg: any)
	local slotId = Validate.OneOf(slotArg, DataTemplate.SlotIds)
	if not slotId then
		return false, "BadSlot"
	end
	local data = DataService.Get(player)
	if not data then
		return false, "NotLoaded"
	end
	if type(data.Slots[slotId]) == "table" and overwriteArg ~= true then
		return false, "SlotInUse"
	end
	local perk = nil
	if perkArg ~= nil and perkArg ~= false then
		if not Legacy.IsUnlocked(perkArg, data.Lifetime.LivesCompleted) then
			return false, "PerkLocked"
		end
		perk = Legacy.ById[perkArg]
	end
	local name = cleanName(nameArg)
	if not name then
		return false, "BadName"
	end
	name = filterName(name, player) -- yields
	if not name then
		return false, "NameFiltered"
	end

	local seed = Random.new():NextInteger(1, 2147483646)
	local life = DataTemplate.NewLife(name, seed)
	if perk then
		LifeService.ApplyLegacy(life, perk)
	end
	local ok = DataService.Update(player, function(d)
		d.Slots[slotId] = life
		d.ActiveSlot = slotId
		d.Lifetime.LivesStarted += 1
		if perk then
			d.Lifetime.Rebirths += 1
			life.Rebirth = d.Lifetime.Rebirths
		end
	end)
	if not ok then
		return false, "NotLoaded"
	end
	LifeService.LifeStarted:Fire(player, slotId, life)
	return true, slotId
end

local function continueLife(player: Player, slotArg: any)
	local slotId = Validate.OneOf(slotArg, DataTemplate.SlotIds)
	if not slotId then
		return false, "BadSlot"
	end
	local data = DataService.Get(player)
	if not data then
		return false, "NotLoaded"
	end
	if type(data.Slots[slotId]) ~= "table" then
		return false, "EmptySlot"
	end
	DataService.Update(player, function(d)
		d.ActiveSlot = slotId
	end)
	return true, slotId
end

local function deleteLife(player: Player, slotArg: any)
	local slotId = Validate.OneOf(slotArg, DataTemplate.SlotIds)
	if not slotId then
		return false, "BadSlot"
	end
	local ok = DataService.Update(player, function(d)
		d.Slots[slotId] = false
	end)
	return ok, if ok then slotId else "NotLoaded"
end

function LifeService.GetScenario(player: Player)
	local data = DataService.Get(player)
	if not data then
		return false, "NotLoaded"
	end
	local life = activeLife(data)
	if not life then
		return false, "NoLife"
	end
	if life.Completed then
		return false, "LifeComplete"
	end

	local scenario = if life.CurrentScenario then Scenarios.ById[life.CurrentScenario] else nil
	if not scenario then
		scenario = ScenarioPicker.Pick(life, Scenarios.All, rngFor(life, 1))
		if not scenario then
			return false, "StageNotAvailable"
		end
		DataService.Update(player, function(d)
			local l = activeLife(d)
			if l then
				l.CurrentScenario = scenario.Id
			end
		end)
	end
	return true, LifeService.ToClient(scenario, life)
end

function LifeService.MakeChoice(player: Player, scenarioArg: any, choiceArg: any)
	local scenarioId = Validate.Id(scenarioArg)
	local choiceId = Validate.Id(choiceArg)
	if not scenarioId or not choiceId then
		return false, "BadArgs"
	end
	local data = DataService.Get(player)
	if not data then
		return false, "NotLoaded"
	end
	local life = activeLife(data)
	if not life or life.Completed then
		return false, "NoLife"
	end
	if life.CurrentScenario ~= scenarioId then
		return false, "WrongScenario"
	end
	local scenario = Scenarios.ById[scenarioId]
	local choice = scenario and scenario.ChoiceById[choiceId]
	if not choice then
		return false, "BadChoice"
	end
	if not Conditions.Check(life, choice.Requires) then
		return false, "ChoiceLocked"
	end

	local outcome
	local stageCompleted, lifeCompleted = nil, false
	DataService.Update(player, function(d)
		local l = activeLife(d)
		local prevAge, prevStage = l.Age, l.Stage
		local wealthStart = l.Stats.Wealth

		-- 1. The choice itself.
		local summary = Consequences.Apply(l, choice.Effects, rngFor(l, 2))
		-- How much this decision mattered (I) and how well it went (G), for the final reveal.
		local impact, goodness = 4 * #summary.LifeChanges, 0
		for stat, delta in pairs(summary.Applied) do
			if stat ~= "Wealth" then
				impact += math.abs(delta)
				goodness += delta
			end
		end
		if math.abs(summary.MoneyDelta) >= 10000 then
			impact += 5
			goodness += if summary.MoneyDelta > 0 then 3 else -3
		end
		table.insert(l.Decisions, {
			S = scenarioId,
			C = choiceId,
			Age = prevAge,
			Stage = prevStage,
			T = scenario.Title,
			X = choice.Text,
			I = math.floor(impact * 10 + 0.5) / 10,
			G = math.floor(goodness * 10 + 0.5) / 10,
		})
		l.Seen[scenarioId] = true
		l.CurrentScenario = false
		l.ScenarioIndex += 1
		d.Lifetime.DecisionsMade += 1

		-- 2. Time passes: ageing, income, career years.
		local stage = LifeStages.Get(l.Stage)
		local newAge = LifeStages.AgeAfterScenario(l.Stage, l.ScenarioIndex)
		if l.ScenarioIndex >= stage.ScenariosPerStage then
			stageCompleted = l.Stage
			if l.Stage < LifeStages.Count then
				newAge = LifeStages.Get(l.Stage + 1).MinAge
			end
		end
		local years = math.max(0, newAge - prevAge)
		local yearly = Yearly.Advance(l, prevAge, years, rngFor(l, 5), summary)
		l.Age = newAge

		-- 3. Maybe something unexpected happens.
		local eventPayload = nil
		local event = RandomEvents.Roll(l, Scenarios.Events, rngFor(l, 3))
		if event then
			local eventSummary = Consequences.Apply(l, event.Effects, rngFor(l, 4))
			table.insert(l.Events, event.Id)
			if event.Rarity == "Rare" or event.Rarity == "Legendary" then
				d.Lifetime.RareEventsSeen += 1
			end
			eventSummary.Applied.Wealth = nil
			eventPayload = {
				Id = event.Id,
				Title = event.Title,
				Icon = event.Icon,
				Rarity = event.Rarity,
				Story = eventSummary.Story,
				Applied = eventSummary.Applied,
				MoneyDelta = eventSummary.MoneyDelta,
				TraitsGained = eventSummary.TraitsGained,
				LifeChanges = eventSummary.LifeChanges,
				BondChanges = eventSummary.BondChanges,
				Lucky = eventSummary.OutcomeTriggered,
			}
		end

		-- 4. Stage bookkeeping + LIFE REVEAL.
		local revealPayload, finalEntry = nil, nil
		if stageCompleted then
			table.insert(l.Reveals, { Stage = stageCompleted, Age = l.Age, Stats = table.clone(l.Stats), Money = l.Money, Time = os.time() })
			if l.Stage < LifeStages.Count then
				l.Stage += 1
				l.ScenarioIndex = 0
				revealPayload = Reveal.Stage(l, stageCompleted, rngFor(l, 6))
				revealPayload.Coins = CoinRewards.Grant(d, Config.StageCoins)
				revealPayload.Boosted = CoinRewards.Multiplier(d) > 1
				if revealPayload.Twist then
					d.Lifetime.TwistsSeen += 1
				end
			else
				l.Completed = true
				lifeCompleted = true
				d.Lifetime.LivesCompleted += 1
				Consequences.SyncWealth(l)
				finalEntry = Reveal.Final(l, d.Lifetime.LivesCompleted)
				l.HistoryId = finalEntry.Id
				table.insert(d.LifeHistory, finalEntry)
				TableUtil.TrimArray(d.LifeHistory, Config.MaxLifeHistory)
				finalEntry.Boosted = CoinRewards.Multiplier(d) > 1
				finalEntry.Coins = CoinRewards.Grant(d, finalEntry.Coins)
				d.Lifetime.EndingsSeen[finalEntry.Ending.Id] = true
			end
			d.Lifetime.StagesCompleted += 1
		end

		Consequences.SyncWealth(l)
		local wealthChange = l.Stats.Wealth - wealthStart
		summary.Applied.Wealth = if math.abs(wealthChange) >= 0.05 then wealthChange else nil
		d.Lifetime.HighestNetWorth = math.max(d.Lifetime.HighestNetWorth, Consequences.NetWorth(l))
		LifeService.RecordMilestones(d, l)

		outcome = {
			ScenarioId = scenarioId,
			ChoiceId = choiceId,
			Story = summary.Story,
			Applied = summary.Applied,
			MoneyDelta = summary.MoneyDelta - yearly.Income,
			Income = yearly.Income,
			Years = yearly.Years,
			Money = l.Money,
			Lucky = summary.OutcomeTriggered,
			TraitsGained = summary.TraitsGained,
			LifeChanges = summary.LifeChanges,
			BondChanges = summary.BondChanges,
			Investment = yearly.Investment,
			Event = eventPayload,
			Reveal = revealPayload,
			Final = finalEntry,
			PrevAge = prevAge,
			Age = l.Age,
			PrevStage = prevStage,
			Stage = l.Stage,
			StageName = LifeStages.Get(l.Stage).DisplayName,
			StageCompleted = stageCompleted ~= nil,
			CompletedStageName = if stageCompleted then LifeStages.Get(stageCompleted).DisplayName else nil,
			LifeCompleted = lifeCompleted,
			NextStageAvailable = lifeCompleted or Scenarios.CountForStage(l.Stage) > 0,
		}
	end)

	StatService.StatsChanged:Fire(player, outcome.Applied, "Choice:" .. scenarioId)
	LifeService.ChoiceMade:Fire(player, scenarioId, choiceId, outcome)
	if stageCompleted then
		LifeService.StageCompleted:Fire(player, stageCompleted, life)
	end
	if lifeCompleted then
		LifeService.LifeCompleted:Fire(player, life)
	end
	return true, TableUtil.DeepCopy(outcome)
end

--[[
	Runs one Lib/Actions function on the active life inside DataService.Update.
	Actions get their own RNG stream keyed by decision count + actions used,
	so results can't be rerolled by retrying.
]]
local function runAction(player: Player, fn, ...)
	local data = DataService.Get(player)
	if not data then
		return false, "NotLoaded"
	end
	local life = activeLife(data)
	if not life or life.Completed then
		return false, "NoLife"
	end
	local args = table.pack(...)
	local ok, result
	DataService.Update(player, function(d)
		local l = activeLife(d)
		local salt = 10 + (if l.ActionTurn == #l.Decisions then l.ActionsUsed else 0)
		-- Append the RNG as the last argument. (A table.unpack in the middle of
		-- an argument list would be cut down to its first value.)
		args[args.n + 1] = rngFor(l, salt)
		ok, result = fn(l, table.unpack(args, 1, args.n + 1))
	end)
	return ok, if type(result) == "table" then TableUtil.DeepCopy(result) else result
end

-- Lifetime records for achievements and profiles: careers, homes and cars
-- ever held (any life), and the highest career level reached.
function LifeService.RecordMilestones(d, l)
	local lifetime = d.Lifetime
	if l.Career and l.Career.Id ~= "None" then
		lifetime.CareersHeld[l.Career.Id] = true
	end
	lifetime.TopCareerLevel = math.max(lifetime.TopCareerLevel or 0, l.PeakCareerLevel or 0, l.Career and l.Career.Level or 0)
	for assetId in pairs(l.Assets or {}) do
		lifetime.AssetsOwned[assetId] = true
	end
end

-- Lifeville world actions. WorldService validates where the player is first
-- (distance to the spot or NPC, their own home) and passes `extra`.
function LifeService.WorldAction(player: Player, spotId: string, extra)
	return runAction(player, Actions.World, spotId, extra or {})
end

function LifeService.Interact(player: Player, personId: any, action: any)
	local id = Validate.Id(personId, 16)
	local kind = Validate.OneOf(action, { "Time", "Gift", "Talk" })
	if not id or not kind then
		return false, "BadArgs"
	end
	return runAction(player, Actions.Interact, id, kind)
end

function LifeService.MeetPeople(player: Player, kind: any)
	local k = Validate.OneOf(kind, { "Friend", "Love" })
	if not k then
		return false, "BadArgs"
	end
	return runAction(player, Actions.Meet, k)
end

function LifeService.SetFocus(player: Player, focus: any)
	local id = Validate.Id(focus, 16)
	if not id then
		return false, "BadArgs"
	end
	return runAction(player, function(life, f)
		return Actions.SetFocus(life, f)
	end, id)
end

function LifeService.Invest(player: Player, amount: any)
	local ok, result = runAction(player, function(life, a)
		return Actions.Invest(life, a)
	end, amount)
	if ok then
		DataService.Update(player, function(d)
			d.Lifetime.InvestActions += 1
		end)
	end
	return ok, result
end

function LifeService.Withdraw(player: Player, amount: any)
	return runAction(player, function(life, a)
		return Actions.Withdraw(life, a)
	end, amount)
end

function LifeService.RepayLoan(player: Player, index: any, amount: any)
	local ok, result = runAction(player, function(life, i, a)
		return Actions.RepayLoan(life, i, a)
	end, index, amount)
	if ok and type(result) == "table" and result.PaidOff then
		DataService.Update(player, function(d)
			d.Lifetime.LoansRepaid += 1
		end)
	end
	return ok, result
end

function LifeService.Init()
	if #Scenarios.Issues > 0 then
		warn(("[LifeService] %d content issue(s) found; see warnings above"):format(#Scenarios.Issues))
	end
end

function LifeService.Start()
	Net.Handle("StartNewLife", startNewLife)
	Net.Handle("ContinueLife", continueLife)
	Net.Handle("DeleteLife", deleteLife)
	Net.Handle("GetScenario", LifeService.GetScenario)
	Net.Handle("MakeChoice", LifeService.MakeChoice)
	Net.Handle("Interact", LifeService.Interact)
	Net.Handle("MeetPeople", LifeService.MeetPeople)
	Net.Handle("SetFocus", LifeService.SetFocus)
	Net.Handle("Invest", LifeService.Invest)
	Net.Handle("Withdraw", LifeService.Withdraw)
	Net.Handle("RepayLoan", LifeService.RepayLoan)
end

return LifeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">NPCService</string>
            <string name="Source"><![CDATA[--[[
	NPCService  (ServerScriptService.Server.Services.NPCService)
	Spawns the people of Lifeville (Shared/Data/NPCs) at the anchors the
	district builders placed (World.NPCAnchors), into Workspace.World.NPCs:
	  • R15 characters built with Players:CreateHumanoidModelFromDescription
	    (skin, shirt and trouser colours), with simple hair and hats, a name tag
	    and a "Talk" ProximityPrompt (attribute CYL_NPC = id);
	  • idle animation plus a wave / point / dance now and then;
	  • six townsfolk walk loops round town (World.WalkLoops).
	Animations are Roblox's default R15 animations; if one can't load the
	character simply stands still.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local NPCs = require(Shared.Data.NPCs)
local World = require(Shared.Data.World)

local WorldService = require(script.Parent.WorldService)

local NPCService = {}
NPCService.Priority = 18

NPCService.Animations = {
	Idle = "rbxassetid://507766666",
	Walk = "rbxassetid://507777826",
	Wave = "rbxassetid://507770239",
	Point = "rbxassetid://507770453",
	Dance = "rbxassetid://507771019",
}

local rigs: { [string]: Model } = {}
local folder: Folder? = nil

local function colour(hex: string?, fallback: string): Color3
	return Color3.fromHex(hex or fallback)
end

function NPCService.Get(npcId: string): Model?
	return rigs[npcId]
end

function NPCService.PositionOf(npcId: string): Vector3?
	local rig = rigs[npcId]
	local root = rig and rig:FindFirstChild("HumanoidRootPart")
	return if root then root.Position else nil
end

-- A blocky stand-in if Roblox can't build a character (keeps the world usable).
local function blockyRig(name: string): Model
	local model = Instance.new("Model")
	model.Name = name
	local function part(partName, size, y)
		local p = Instance.new("Part")
		p.Name = partName
		p.Size = size
		p.CFrame = CFrame.new(0, y, 0)
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end
	local root = part("HumanoidRootPart", Vector3.new(2, 2, 1), 3)
	root.Transparency = 1
	local torso = part("UpperTorso", Vector3.new(2, 2, 1), 3)
	local head = part("Head", Vector3.new(1.2, 1.2, 1.2), 4.6)
	local legs = part("LowerTorso", Vector3.new(2, 2, 1), 1)
	for _, p in ipairs({ torso, head, legs }) do
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = p
		weld.Parent = p
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.HipHeight = 0
	humanoid.Parent = model
	Instance.new("Animator").Parent = humanoid
	model.PrimaryPart = root
	return model
end

local function buildRig(npc): Model
	local looks = npc.Looks or {}
	local skin = colour(looks.Skin, "#F1C27D")
	local shirt = colour(looks.Shirt, "#457B9D")
	local pants = colour(looks.Pants, "#1D3557")
	local ok, rig = pcall(function()
		local description = Instance.new("HumanoidDescription")
		description.HeadColor = skin
		description.TorsoColor = shirt
		description.LeftArmColor = shirt
		description.RightArmColor = shirt
		description.LeftLegColor = pants
		description.RightLegColor = pants
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not rig then
		warn("[NPCService] Using a simple character for " .. npc.Id .. ": " .. tostring(rig))
		rig = blockyRig(npc.Id)
		for _, p in ipairs(rig:GetChildren()) do
			if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
				p.Color = if p.Name == "Head" then skin elseif p.Name == "LowerTorso" then pants else shirt
			end
		end
	end
	rig.Name = "NPC_" .. npc.Id
	rig:SetAttribute("CYL_NPC", npc.Id)
	return rig
end

-- Hair and hats: plain parts welded to the head.
local function attach(head: BasePart, name: string, size: Vector3, offset: CFrame, col: Color3, shape)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	if shape then
		p.Shape = shape
	end
	p.Color = col
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.CFrame = head.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = head
	weld.Part1 = p
	weld.Parent = p
	p.Parent = head.Parent
	return p
end

local UPRIGHT = CFrame.Angles(0, 0, math.rad(90)) -- cylinders stand along Y

local function decorate(rig: Model, looks)
	local head = rig:FindFirstChild("Head") :: BasePart?
	if not head then
		return
	end
	local top = head.Size.Y / 2
	local hair = if looks.Hair then Color3.fromHex(looks.Hair) else nil
	local style = looks.HairStyle or "Short"
	if hair and style ~= "Bald" then
		attach(head, "Hair", Vector3.new(1.3, 0.35, 1.3), CFrame.new(0, top + 0.05, 0.02), hair)
		local backLength = if style == "Long" then 1.5 else 0.7
		attach(head, "HairBack", Vector3.new(1.3, backLength, 0.3), CFrame.new(0, top - backLength / 2 + 0.1, 0.55), hair)
		if style == "Bun" then
			attach(head, "Bun", Vector3.new(0.7, 0.7, 0.7), CFrame.new(0, top + 0.25, 0.5), hair, Enum.PartType.Ball)
		end
	end
	local hat = looks.Hat
	if hat == "Top" then
		attach(head, "Hat", Vector3.new(1.1, 1, 1), CFrame.new(0, top + 0.6, 0) * UPRIGHT, Color3.fromHex("#111111"), Enum.PartType.Cylinder)
		attach(head, "Brim", Vector3.new(0.1, 1.7, 1.7), CFrame.new(0, top + 0.1, 0) * UPRIGHT, Color3.fromHex("#111111"), Enum.PartType.Cylinder)
	elseif hat == "Cap" or hat == "Flat" then
		attach(head, "Hat", Vector3.new(1.35, 0.4, 1.35), CFrame.new(0, top + 0.15, 0), Color3.fromHex(looks.Shirt or "#E63946"))
		attach(head, "Brim", Vector3.new(1.1, 0.1, 0.6), CFrame.new(0, top, -0.85), Color3.fromHex(looks.Shirt or "#E63946"))
	elseif hat == "Grad" then
		attach(head, "Hat", Vector3.new(1.25, 0.35, 1.25), CFrame.new(0, top + 0.12, 0), Color3.fromHex("#111111"))
		attach(head, "Board", Vector3.new(1.8, 0.1, 1.8), CFrame.new(0, top + 0.35, 0) * CFrame.Angles(0, math.rad(45), 0), Color3.fromHex("#111111"))
	elseif hat == "Police" or hat == "Captain" then
		local crown = if hat == "Police" then "#1D3557" else "#F8F9FA"
		attach(head, "Hat", Vector3.new(0.5, 1.35, 1.35), CFrame.new(0, top + 0.2, 0) * UPRIGHT, Color3.fromHex(crown), Enum.PartType.Cylinder)
		attach(head, "Brim", Vector3.new(1, 0.1, 0.5), CFrame.new(0, top, -0.8), Color3.fromHex("#111111"))
	elseif hat == "Chef" then
		attach(head, "Hat", Vector3.new(1.3, 1.1, 1.1), CFrame.new(0, top + 0.6, 0) * UPRIGHT, Color3.fromHex("#FFFFFF"), Enum.PartType.Cylinder)
	elseif hat == "Nurse" then
		attach(head, "Hat", Vector3.new(0.9, 0.35, 0.5), CFrame.new(0, top + 0.12, -0.2), Color3.fromHex("#FFFFFF"))
	elseif hat == "Hard" then
		attach(head, "Hat", Vector3.new(1.45, 0.55, 1.45), CFrame.new(0, top + 0.18, 0), Color3.fromHex("#FFD60A"))
	elseif hat == "Beret" then
		attach(head, "Hat", Vector3.new(0.25, 1.4, 1.4), CFrame.new(0.1, top + 0.08, 0) * UPRIGHT * CFrame.Angles(0, 0, math.rad(10)), Color3.fromHex("#9D0208"), Enum.PartType.Cylinder)
	elseif hat == "Ranger" then
		attach(head, "Hat", Vector3.new(0.6, 1.2, 1.2), CFrame.new(0, top + 0.3, 0) * UPRIGHT, Color3.fromHex("#BC8A5F"), Enum.PartType.Cylinder)
		attach(head, "Brim", Vector3.new(0.1, 2, 2), CFrame.new(0, top + 0.05, 0) * UPRIGHT, Color3.fromHex("#BC8A5F"), Enum.PartType.Cylinder)
	end
end

local function nameTag(rig: Model, npc)
	local head = rig:FindFirstChild("Head")
	if not head then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "CYL_NPCTag"
	gui.Size = UDim2.fromOffset(220, 52)
	gui.StudsOffset = Vector3.new(0, 2.8, 0)
	gui.MaxDistance = 55
	gui.LightInfluence = 0
	gui.Parent = head
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "Name"
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.new(1, 0, 0.58, 0)
	nameLabel.Text = (npc.Icon or "") .. " " .. npc.Name
	nameLabel.TextScaled = true
	nameLabel.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Heavy)
	nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	nameLabel.TextStrokeTransparency = 0.4
	nameLabel.Parent = gui
	local roleLabel = Instance.new("TextLabel")
	roleLabel.Name = "Role"
	roleLabel.BackgroundTransparency = 1
	roleLabel.Position = UDim2.fromScale(0, 0.6)
	roleLabel.Size = UDim2.new(1, 0, 0.4, 0)
	roleLabel.Text = npc.Role or ""
	roleLabel.TextScaled = true
	roleLabel.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Medium)
	roleLabel.TextColor3 = Color3.fromRGB(255, 214, 90)
	roleLabel.TextStrokeTransparency = 0.5
	roleLabel.Parent = gui
end

local function talkPrompt(rig: Model, npc)
	local root = rig:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "TalkPrompt"
	prompt.ActionText = "Talk"
	prompt.ObjectText = (npc.Icon or "") .. " " .. npc.Name
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt:SetAttribute("CYL_NPC", npc.Id)
	prompt.Parent = root
end

local function load(rig: Model, key: string)
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return nil
	end
	local ok, track = pcall(function()
		local animation = Instance.new("Animation")
		animation.Name = key
		animation.AnimationId = NPCService.Animations[key]
		return animator:LoadAnimation(animation)
	end)
	return if ok then track else nil
end

local function animate(rig: Model, npc)
	local idle = load(rig, "Idle")
	if idle then
		idle.Looped = true
		idle:Play()
	end
	local gestureKey = npc.Anim
	if gestureKey == "Dance" then
		local dance = load(rig, "Dance")
		if dance then
			dance.Looped = true
			dance:Play()
		end
	elseif gestureKey == "Wave" or gestureKey == "Point" then
		local gesture = load(rig, gestureKey)
		if gesture then
			task.spawn(function()
				local rng = Random.new(#npc.Id * 97)
				while rig.Parent do
					task.wait(rng:NextNumber(8, 16))
					if rig.Parent then
						gesture:Play()
					end
				end
			end)
		end
	end
end

local function standingCFrame(rig: Model, anchor: BasePart): CFrame
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	local root = rig:FindFirstChild("HumanoidRootPart") :: BasePart?
	local floorY = anchor.Position.Y - anchor.Size.Y / 2
	local height = (if humanoid then humanoid.HipHeight else 2) + (if root then root.Size.Y / 2 else 1)
	return anchor.CFrame.Rotation + Vector3.new(anchor.Position.X, floorY + height, anchor.Position.Z)
end

-- `place` is an anchor part (stand on it) or a CFrame for the root part.
local function spawnAt(npc, place, anchored: boolean): Model
	local rig = buildRig(npc)
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	end
	rig:PivotTo(if typeof(place) == "Instance" then standingCFrame(rig, place) else place)
	local root = rig:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		root.Anchored = anchored
	end
	decorate(rig, npc.Looks or {})
	nameTag(rig, npc)
	talkPrompt(rig, npc)
	rig.Parent = folder
	if root and not anchored then
		pcall(function()
			root:SetNetworkOwner(nil) -- the server moves walkers, not nearby players
		end)
	end
	rigs[npc.Id] = rig
	animate(rig, npc)
	return rig
end

local function waitForMove(humanoid: Humanoid, timeout: number): boolean
	local done, reached = false, false
	local connection = humanoid.MoveToFinished:Connect(function(ok)
		done = true
		reached = ok
	end)
	local waited = 0
	while not done and waited < timeout do
		waited += task.wait(0.25)
	end
	connection:Disconnect()
	return reached
end

local function walk(rig: Model, loop)
	local humanoid = rig:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	humanoid.WalkSpeed = loop.Speed or 7
	local walkTrack = load(rig, "Walk")
	if walkTrack then
		walkTrack.Looped = true
	end
	humanoid.Running:Connect(function(speed)
		if walkTrack then
			if speed > 0.5 and not walkTrack.IsPlaying then
				walkTrack:Play()
			elseif speed <= 0.5 and walkTrack.IsPlaying then
				walkTrack:Stop()
			end
		end
	end)
	local district = World.ById[loop.District]
	local points = {}
	for _, p in ipairs(loop.Points) do
		table.insert(points, Vector3.new(district.X + p[1], 0.2, district.Z + p[2]))
	end
	local index = 2
	while rig.Parent do
		local target = points[index]
		humanoid:MoveTo(target)
		if not waitForMove(humanoid, 30) then
			-- Stuck (or blocked by a player): hop to the corner and carry on.
			rig:PivotTo(CFrame.new(target + Vector3.new(0, 3, 0)))
		end
		index = index % #points + 1
		task.wait(0.4)
	end
end

function NPCService.Init()
	WorldService.NPCPosition = NPCService.PositionOf
end

function NPCService.Start()
	local world = WorldService.Folder()
	if not world then
		return
	end
	folder = world:FindFirstChild("NPCs") :: Folder?
	if not folder then
		local f = Instance.new("Folder")
		f.Name = "NPCs"
		f.Parent = world
		folder = f
	end
	local anchors = world:FindFirstChild("NPCAnchors")
	for _, npc in ipairs(NPCs.List) do
		local anchor = anchors and anchors:FindFirstChild(npc.Id)
		if anchor then
			local ok, err = pcall(spawnAt, npc, anchor, true)
			if not ok then
				warn("[NPCService] Couldn't spawn " .. npc.Id .. ": " .. tostring(err))
			end
		end
	end
	for _, loop in ipairs(World.WalkLoops) do
		local npc = NPCs.ById[loop.Walker]
		local district = World.ById[loop.District]
		if npc and district then
			local first = loop.Points[1]
			local ok, rig = pcall(spawnAt, npc, CFrame.new(district.X + first[1], 3.2, district.Z + first[2]), false)
			if ok then
				task.spawn(walk, rig, loop)
			else
				warn("[NPCService] Couldn't spawn walker " .. npc.Id .. ": " .. tostring(rig))
			end
		end
	end
end

return NPCService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="77">
          <Properties>
            <string name="Name">PartyService</string>
            <string name="Source"><![CDATA[--[[
	PartyService  (ServerScriptService.Server.Services.PartyService)
	"Life Circles": play with friends while every life stays independent.

	Circles (parties) of up to 4 players in the same server:
	  PartyInvite(targetUserId) · PartyRespond(inviteId, accept) · PartyLeave() · PartyKick(userId)
	  Invites expire; the leader role passes on if the leader leaves; a circle
	  of one dissolves.

	Group events (PartyStartEvent → PartyVote):
	  The server picks a group scenario every member qualifies for
	  (Content/GroupScenarios), everyone votes, and the majority wins (ties and
	  no-shows are settled fairly at random). Chance outcomes are rolled ONCE
	  for the group (shared fate), but the effects are applied to each
	  member's OWN life with their own stats, traits and money. Nothing a
	  friend does ever writes to your life except through a vote you were
	  part of. Group events don't use a decision or change anyone's age.
	  Each member's life also gains the others as named friends and records
	  the shared moment (it appears in the Final Reveal).

	Group Life Reveal (PartyStartReveal): everyone watches each member's
	predicted futures, then a "most likely to…" board. Privacy settings
	still apply; circle members count as friends.

	JoinFriendServer(placeId, jobId): teleport to a friend's server of this
	experience (the client finds friends with Player:GetFriendsOnline).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local People = require(Shared.Util.People)
local Futures = require(Shared.Util.Futures)
local TableUtil = require(Shared.Util.TableUtil)
local LifeStages = require(Shared.Data.LifeStages)
local Careers = require(Shared.Data.Careers)
local Style = require(Shared.Util.Style)

local Server = script.Parent.Parent
local Conditions = require(Server.Lib.Conditions)
local Consequences = require(Server.Lib.Consequences)
local Scenarios = require(Server.Content.Scenarios)
local CoinRewards = require(Server.Lib.CoinRewards)
local Config = require(Shared.Config)

local DataService = require(script.Parent.DataService)
local RevealService = require(script.Parent.RevealService)

local PartyService = {}
PartyService.Priority = 36

PartyService.MaxMembers = 4
PartyService.InviteSeconds = 45
PartyService.VoteSeconds = 40
PartyService.EventCooldown = 90
PartyService.RevealCooldown = 45
PartyService.MaxSharedMoments = 10

PartyService.EventResolved = Signal.new() -- (party, scenario, choiceId, outcomeIndex)

local parties = {}
local partyOf: { [Player]: any } = {}
local invites = {}
local counters = { Party = 0, Invite = 0, Event = 0, Reveal = 0 }
local rng = Random.new()

-- ===== Helpers =====
local function now(): number
	return os.clock()
end

local function findPlayer(userId: any): Player?
	if type(userId) ~= "number" or userId ~= userId or userId % 1 ~= 0 then
		return nil
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if p.UserId == userId then
			return p
		end
	end
	return nil
end

local function displayName(player: Player): string
	return player.DisplayName or player.Name
end

local function activeLife(player: Player)
	local life = DataService.GetActiveLife(player)
	if life and not life.Completed then
		return life
	end
	return nil
end

function PartyService.PartyOf(player: Player)
	return partyOf[player]
end

function PartyService.SameParty(a: Player, b: Player): boolean
	return partyOf[a] ~= nil and partyOf[a] == partyOf[b]
end

local function memberInfo(party, player: Player)
	local info = { UserId = player.UserId, DisplayName = displayName(player), IsLeader = party.Leader == player }
	local data = DataService.Get(player)
	if data then
		info.Style = Style.Public(data.Inventory.Equipped)
	end
	local life = DataService.GetActiveLife(player)
	if life then
		info.LifeName = life.Name
		info.Age = life.Age
		info.StageName = LifeStages.Get(life.Stage).DisplayName
		info.Completed = life.Completed
		info.Career = if life.Career.Id ~= "None" and Careers.Info[life.Career.Id] then Careers.TitleAt(life.Career.Id, life.Career.Level) elseif life.Flags.Retired then "Retired" else nil
	end
	return info
end

function PartyService.State(party)
	local members = {}
	for _, member in ipairs(party.Members) do
		table.insert(members, memberInfo(party, member))
	end
	return {
		Id = party.Id,
		LeaderUserId = party.Leader.UserId,
		Members = members,
		MaxMembers = PartyService.MaxMembers,
		EventActive = party.Event ~= nil,
		EventCooldown = math.max(0, math.ceil(PartyService.EventCooldown - (now() - party.LastEventAt))),
		RevealCooldown = math.max(0, math.ceil(PartyService.RevealCooldown - (now() - party.LastRevealAt))),
	}
end

local function broadcast(party)
	local state = PartyService.State(party)
	for _, member in ipairs(party.Members) do
		Net.Fire("PartyUpdate", member, state)
	end
end

local function notify(player: Player, text: string, kind: string?)
	Net.Fire("Notify", player, { Title = "🤝 Life Circle", Text = text, Kind = kind or "Info" })
end

-- ===== Circle membership =====
local resolveEvent

local function removeFromParty(player: Player, reason: string?)
	local party = partyOf[player]
	if not party then
		return
	end
	partyOf[player] = nil
	local index = table.find(party.Members, player)
	if index then
		table.remove(party.Members, index)
	end
	if player.Parent then
		Net.Fire("PartyUpdate", player, false)
	end
	if #party.Members <= 1 then
		-- A circle of one dissolves.
		for _, last in ipairs(party.Members) do
			partyOf[last] = nil
			Net.Fire("PartyUpdate", last, false)
			notify(last, "Your Life Circle has ended.")
		end
		party.Members = {}
		party.Event = nil
		parties[party.Id] = nil
		return
	end
	if party.Leader == player then
		party.Leader = party.Members[1]
	end
	for _, member in ipairs(party.Members) do
		notify(member, displayName(player) .. (if reason == "Kicked" then " was removed from the circle." else " left the circle."))
	end
	-- A leaving voter no longer counts; finish the vote if everyone left has voted.
	local event = party.Event
	if event then
		event.Votes[player] = nil
		local stillVoting = false
		for _, voter in ipairs(event.Voters) do
			if partyOf[voter] == party and event.Votes[voter] == nil then
				stillVoting = true
			end
		end
		if not stillVoting then
			resolveEvent(party)
		end
	end
	broadcast(party)
end

function PartyService.Invite(player: Player, targetUserId: any)
	local target = findPlayer(targetUserId)
	if not target then
		return false, "NotHere"
	end
	if target == player then
		return false, "Self"
	end
	if not DataService.IsLoaded(player) or not DataService.IsLoaded(target) then
		return false, "NotLoaded"
	end
	local party = partyOf[player]
	if party and table.find(party.Members, target) then
		return false, "AlreadyMember"
	end
	if party and #party.Members >= PartyService.MaxMembers then
		return false, "PartyFull"
	end
	for _, invite in pairs(invites) do
		if invite.From == player and invite.To == target and invite.Expires > now() then
			return false, "AlreadyInvited"
		end
	end
	counters.Invite += 1
	local id = "inv" .. counters.Invite
	invites[id] = { Id = id, From = player, To = target, Expires = now() + PartyService.InviteSeconds }
	Net.Fire("PartyInviteReceived", target, { InviteId = id, FromUserId = player.UserId, FromName = displayName(player), Seconds = PartyService.InviteSeconds })
	return true, { InviteId = id }
end

function PartyService.Respond(player: Player, inviteId: any, accept: any)
	if type(inviteId) ~= "string" then
		return false, "BadArgs"
	end
	local invite = invites[inviteId]
	if not invite or invite.To ~= player then
		return false, "NoInvite"
	end
	invites[inviteId] = nil
	if invite.Expires < now() then
		return false, "Expired"
	end
	local from = invite.From
	if not from.Parent then
		return false, "NotHere"
	end
	if accept ~= true then
		notify(from, displayName(player) .. " declined your invite.")
		return true, { Joined = false }
	end
	local party = partyOf[from]
	if party and #party.Members >= PartyService.MaxMembers then
		return false, "PartyFull"
	end
	if partyOf[player] and partyOf[player] ~= party then
		removeFromParty(player)
	end
	if not party then
		counters.Party += 1
		party = { Id = "circle" .. counters.Party, Leader = from, Members = { from }, LastEventAt = -math.huge, LastRevealAt = -math.huge, Recent = {} }
		parties[party.Id] = party
		partyOf[from] = party
	end
	if not table.find(party.Members, player) then
		table.insert(party.Members, player)
	end
	partyOf[player] = party
	for _, member in ipairs({ from, player }) do
		DataService.Update(member, function(d)
			d.Lifetime.CirclesJoined += 1
		end)
	end
	for _, member in ipairs(party.Members) do
		if member ~= player then
			notify(member, displayName(player) .. " joined your Life Circle!", "Success")
		end
	end
	broadcast(party)
	return true, { Joined = true, PartyId = party.Id }
end

function PartyService.Leave(player: Player)
	if not partyOf[player] then
		return false, "NoParty"
	end
	removeFromParty(player)
	return true
end

function PartyService.Kick(player: Player, userId: any)
	local party = partyOf[player]
	if not party then
		return false, "NoParty"
	end
	if party.Leader ~= player then
		return false, "NotLeader"
	end
	local target = findPlayer(userId)
	if not target or target == player or partyOf[target] ~= party then
		return false, "NotMember"
	end
	removeFromParty(target, "Kicked")
	if target.Parent then
		notify(target, "You were removed from the Life Circle.", "Warning")
	end
	return true
end

-- ===== Group events =====
local function lockedFor(lives, requires): boolean
	for _, life in ipairs(lives) do
		if not Conditions.Check(life, requires) then
			return true
		end
	end
	return false
end

function PartyService.EligibleScenarios(lives)
	local list = {}
	for _, scenario in ipairs(Scenarios.Group) do
		if not lockedFor(lives, scenario.Requires) then
			local open = 0
			for _, choice in ipairs(scenario.Choices) do
				if not lockedFor(lives, choice.Requires) then
					open += 1
				end
			end
			if open >= 2 then
				table.insert(list, scenario)
			end
		end
	end
	return list
end

function PartyService.StartEvent(player: Player, forcedScenarioId: string?)
	local party = partyOf[player]
	if not party then
		return false, "NoParty"
	end
	if party.Event then
		return false, "EventActive"
	end
	local wait = PartyService.EventCooldown - (now() - party.LastEventAt)
	if wait > 0 then
		return false, "Cooldown", math.ceil(wait)
	end
	local lives = {}
	for _, member in ipairs(party.Members) do
		local life = activeLife(member)
		if not life then
			return false, "NotEveryoneReady", displayName(member)
		end
		table.insert(lives, life)
	end
	local eligible = PartyService.EligibleScenarios(lives)
	local scenario
	if forcedScenarioId then
		scenario = Scenarios.GroupById[forcedScenarioId]
		if not scenario or not table.find(eligible, scenario) then
			return false, "NotEligible"
		end
	else
		local total, weights = 0, {}
		for i, s in ipairs(eligible) do
			weights[i] = (s.Weight or 1) * (if table.find(party.Recent, s.Id) then 0.15 else 1)
			total += weights[i]
		end
		local roll = rng:NextNumber() * total
		for i, s in ipairs(eligible) do
			roll -= weights[i]
			if roll <= 0 then
				scenario = s
				break
			end
		end
		scenario = scenario or eligible[#eligible]
	end
	if not scenario then
		return false, "NoEvent"
	end
	counters.Event += 1
	local event = {
		Id = counters.Event,
		Scenario = scenario,
		Voters = table.clone(party.Members),
		Votes = {},
		Locked = {},
		StartedBy = player,
	}
	local choices = {}
	for index, choice in ipairs(scenario.Choices) do
		local locked = lockedFor(lives, choice.Requires)
		event.Locked[choice.Id] = locked
		local preview, moneyDir, risky, tags = Consequences.Preview(choice.Effects)
		table.insert(choices, {
			Id = choice.Id,
			Index = index,
			Text = choice.Text,
			Description = choice.Description,
			Locked = locked,
			LockHint = if locked then (choice.LockHint or "Not everyone can do this") else nil,
			Preview = preview,
			MoneyDir = moneyDir,
			Risky = risky,
			Tags = tags,
		})
	end
	local names = {}
	for _, member in ipairs(party.Members) do
		table.insert(names, displayName(member))
	end
	party.Event = event
	local payload = {
		EventId = event.Id,
		Icon = scenario.Icon,
		Title = scenario.Title,
		Description = scenario.Description,
		Choices = choices,
		Seconds = PartyService.VoteSeconds,
		Members = names,
		StartedBy = displayName(player),
	}
	for _, member in ipairs(party.Members) do
		Net.Fire("GroupEvent", member, payload)
	end
	broadcast(party)
	task.delay(PartyService.VoteSeconds, function()
		if party.Event == event then
			resolveEvent(party)
		end
	end)
	return true, { EventId = event.Id, ScenarioId = scenario.Id }
end

function PartyService.Vote(player: Player, eventId: any, choiceId: any)
	local party = partyOf[player]
	local event = party and party.Event
	if not event or event.Id ~= eventId then
		return false, "NoEvent"
	end
	if not table.find(event.Voters, player) then
		return false, "NotInEvent"
	end
	if type(choiceId) ~= "string" or not event.Scenario.ChoiceById[choiceId] then
		return false, "BadChoice"
	end
	if event.Locked[choiceId] then
		return false, "ChoiceLocked"
	end
	event.Votes[player] = choiceId
	local votes = {}
	for voter, choice in pairs(event.Votes) do
		votes[tostring(voter.UserId)] = choice
	end
	for _, member in ipairs(party.Members) do
		Net.Fire("GroupVote", member, { EventId = event.Id, Votes = votes })
	end
	local everyone = true
	for _, voter in ipairs(event.Voters) do
		if partyOf[voter] == party and event.Votes[voter] == nil then
			everyone = false
		end
	end
	if everyone then
		task.defer(function()
			if party.Event == event then
				resolveEvent(party)
			end
		end)
	end
	return true
end

function resolveEvent(party)
	local event = party.Event
	if not event then
		return
	end
	party.Event = nil
	party.LastEventAt = now()
	table.insert(party.Recent, event.Scenario.Id)
	if #party.Recent > 4 then
		table.remove(party.Recent, 1)
	end
	local scenario = event.Scenario

	-- Count votes from voters still in the circle.
	local tally, best, top = {}, 0, {}
	local voteMap = {}
	for voter, choiceId in pairs(event.Votes) do
		if partyOf[voter] == party then
			tally[choiceId] = (tally[choiceId] or 0) + 1
			voteMap[tostring(voter.UserId)] = choiceId
		end
	end
	for choiceId, count in pairs(tally) do
		if count > best then
			best, top = count, { choiceId }
		elseif count == best then
			table.insert(top, choiceId)
		end
	end
	local noVotes = #top == 0
	if noVotes then
		for _, choice in ipairs(scenario.Choices) do
			if not event.Locked[choice.Id] then
				table.insert(top, choice.Id)
			end
		end
	end
	table.sort(top)
	local choiceId = top[rng:NextInteger(1, #top)]
	local choice = scenario.ChoiceById[choiceId]
	local outcomeIndex = Consequences.RollOutcome(choice.Effects, rng) -- shared fate

	local members = table.clone(party.Members)
	local lifeNames = {}
	for _, member in ipairs(members) do
		local life = DataService.GetActiveLife(member)
		lifeNames[member] = if life then life.Name else displayName(member)
	end
	for _, member in ipairs(members) do
		local result
		DataService.Update(member, function(d)
			local life = d.Slots[d.ActiveSlot]
			if type(life) ~= "table" or life.Completed then
				return
			end
			local memberRng = Random.new((life.Seed + #life.Decisions * 31 + event.Id * 7) % 2147483646 + 1)
			local summary = Consequences.Apply(life, choice.Effects, memberRng, true, outcomeIndex)
			-- Friends in real life become friends in each other's lives.
			local others = {}
			for _, other in ipairs(members) do
				if other ~= member then
					table.insert(others, lifeNames[other])
					local existing = nil
					for _, person in ipairs(life.People) do
						if person.PlayerUserId == other.UserId then
							existing = person
						end
					end
					if existing then
						Consequences.ChangeBond(existing, 5, summary)
					else
						local added = People.AddNamed(life, "Friend", lifeNames[other], other.UserId, 70)
						if added then
							table.insert(summary.LifeChanges, ("🤝 %s (%s) is now in your People"):format(added.Name, displayName(other)))
						end
					end
				end
			end
			life.Shared = life.Shared or {}
			table.insert(life.Shared, { Title = scenario.Title, Icon = scenario.Icon, With = others, Age = life.Age })
			TableUtil.TrimArray(life.Shared, PartyService.MaxSharedMoments)
			Consequences.SyncWealth(life)
			summary.Applied.Wealth = nil
			local coins = CoinRewards.Grant(d, Config.GroupEventCoins)
			d.Lifetime.GroupDecisions += 1
			result = {
				Coins = coins,
				EventId = event.Id,
				Icon = scenario.Icon,
				Title = scenario.Title,
				ChoiceId = choiceId,
				ChoiceText = choice.Text,
				Tally = tally,
				Votes = voteMap,
				NoVotes = noVotes,
				Tie = not noVotes and #top > 1,
				Lucky = outcomeIndex > 0,
				Story = summary.Story,
				Applied = summary.Applied,
				MoneyDelta = summary.MoneyDelta,
				LifeChanges = summary.LifeChanges,
				TraitsGained = summary.TraitsGained,
				BondChanges = summary.BondChanges,
			}
		end)
		if result and member.Parent then
			Net.Fire("GroupEventResult", member, result)
		end
	end
	PartyService.EventResolved:Fire(party, scenario, choiceId, outcomeIndex)
	if parties[party.Id] then
		broadcast(party)
	end
end

-- ===== Group Life Reveal =====
local function superlatives(cards)
	local list = {}
	for _, id in ipairs(Futures.Order) do
		local info = Futures.Info[id]
		if info.Positive then
			local best = nil
			for _, c in ipairs(cards) do
				if c.Card and (not best or c.Card.Predictions[id] > best.Card.Predictions[id]) then
					best = c
				end
			end
			if best and best.Card.Predictions[id] >= 15 then
				table.insert(list, { Id = id, UserId = best.UserId, DisplayName = best.DisplayName, LifeName = best.Card.LifeName, Pct = best.Card.Predictions[id] })
			end
		end
	end
	table.sort(list, function(a, b)
		return a.Pct > b.Pct
	end)
	return list
end

function PartyService.StartReveal(player: Player)
	local party = partyOf[player]
	if not party then
		return false, "NoParty"
	end
	local wait = PartyService.RevealCooldown - (now() - party.LastRevealAt)
	if wait > 0 then
		return false, "Cooldown", math.ceil(wait)
	end
	party.LastRevealAt = now()
	counters.Reveal += 1
	for _, viewer in ipairs(party.Members) do
		local cards = {}
		for _, target in ipairs(party.Members) do
			local card = RevealService.CardFor(viewer, target)
			if card then
				table.insert(cards, card)
			end
		end
		Net.Fire("GroupReveal", viewer, {
			SessionId = counters.Reveal,
			StartedBy = displayName(player),
			Cards = cards,
			Superlatives = superlatives(cards),
		})
	end
	broadcast(party)
	return true
end

-- ===== Joining friends in other servers =====
local function looksLikeJobId(value: any): boolean
	return type(value) == "string" and #value <= 64 and value:match("^[%w%-]+$") ~= nil
end

function PartyService.JoinFriendServer(player: Player, placeId: any, jobId: any)
	if placeId ~= game.PlaceId or not looksLikeJobId(jobId) then
		return false, "BadServer"
	end
	if jobId == game.JobId then
		return false, "SameServer"
	end
	local ok, err = pcall(function()
		TeleportService:TeleportToPlaceInstance(placeId, jobId, player)
	end)
	if not ok then
		return false, "TeleportFailed: " .. tostring(err)
	end
	return true
end

-- ===== Lifecycle =====
function PartyService.Init()
	RevealService.ExtraFriendCheck = PartyService.SameParty
end

function PartyService.Start()
	Net.Handle("PartyInvite", PartyService.Invite)
	Net.Handle("PartyRespond", PartyService.Respond)
	Net.Handle("PartyLeave", PartyService.Leave)
	Net.Handle("PartyKick", PartyService.Kick)
	Net.Handle("PartyStartEvent", function(player)
		return PartyService.StartEvent(player)
	end)
	Net.Handle("PartyVote", PartyService.Vote)
	Net.Handle("PartyStartReveal", PartyService.StartReveal)
	Net.Handle("JoinFriendServer", PartyService.JoinFriendServer)
	Net.Handle("GetPartyState", function(player)
		local party = partyOf[player]
		return true, if party then PartyService.State(party) else false
	end)
	Players.PlayerRemoving:Connect(function(player)
		removeFromParty(player)
		for id, invite in pairs(invites) do
			if invite.From == player or invite.To == player then
				invites[id] = nil
			end
		end
	end)
	-- Tidy expired invites.
	task.spawn(function()
		while true do
			task.wait(30)
			for id, invite in pairs(invites) do
				if invite.Expires < now() then
					invites[id] = nil
				end
			end
		end
	end)
end

return PartyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[--[[
	PlotService  (ServerScriptService.Server.Services.PlotService)
	Gives every player a house plot on Oak Street (8 plots per server) and
	keeps their house matching their life: family home → own place → house
	or mansion, with their equipped house style, car, pet and centrepiece
	(see World/Homes). Other players can visit; only the owner can use the
	"Rest at home" and "Family dinner" spots there (WorldService checks).

	Plot models carry attributes OwnerUserId and OwnerName for the client.
	PlotService.PlotOf(player) -> plot model?
]]

local Players = game:GetService("Players")

local DataService = require(script.Parent.DataService)
local WorldService = require(script.Parent.WorldService)
local ShopService = require(script.Parent.ShopService)
local Homes = require(script.Parent.Parent.World.Homes)

local PlotService = {}
PlotService.Priority = 19
PlotService.RefreshSeconds = 3

local owners: { [Player]: Model } = {}
local keys: { [Model]: string } = {}

local function plots(): { Model }
	local world = WorldService.Folder()
	local folder = world and world:FindFirstChild("Plots")
	local list = {}
	if folder then
		for _, plot in ipairs(folder:GetChildren()) do
			if plot:IsA("Model") and plot:FindFirstChild("Base") then
				table.insert(list, plot)
			end
		end
	end
	table.sort(list, function(a, b)
		return (a:GetAttribute("Index") or 0) < (b:GetAttribute("Index") or 0)
	end)
	return list
end

function PlotService.PlotOf(player: Player): Model?
	return owners[player]
end

local function spotPartsIn(plot: Model): { BasePart }
	local list = {}
	for _, part in ipairs(plot:GetDescendants()) do
		if part:IsA("BasePart") and part:GetAttribute("CYL_Spot") then
			table.insert(list, part)
		end
	end
	return list
end

local function unregisterSpots(plot: Model)
	for _, part in ipairs(spotPartsIn(plot)) do
		WorldService.UnregisterSpot(part)
	end
end

local function registerSpots(plot: Model)
	for _, part in ipairs(spotPartsIn(plot)) do
		WorldService.RegisterSpot(part)
	end
end

-- Rebuilds the player's house if anything it shows has changed.
function PlotService.Refresh(player: Player)
	local plot = owners[player]
	local data = DataService.Get(player)
	if not plot or not data then
		return
	end
	local spec = Homes.SpecFor(player, data)
	if keys[plot] == spec.Key then
		return
	end
	unregisterSpots(plot)
	Homes.Build(plot, spec)
	registerSpots(plot)
	keys[plot] = spec.Key
end

function PlotService.Assign(player: Player): Model?
	if owners[player] then
		return owners[player]
	end
	for _, plot in ipairs(plots()) do
		if not plot:GetAttribute("OwnerUserId") then
			plot:SetAttribute("OwnerUserId", player.UserId)
			plot:SetAttribute("OwnerName", player.DisplayName or player.Name)
			owners[player] = plot
			PlotService.Refresh(player)
			return plot
		end
	end
	return nil -- the street is full; everything else still works
end

function PlotService.Release(player: Player)
	local plot = owners[player]
	if not plot then
		return
	end
	owners[player] = nil
	keys[plot] = nil
	unregisterSpots(plot)
	Homes.Clear(plot)
	Homes.ResetSign(plot)
	plot:SetAttribute("OwnerUserId", nil)
	plot:SetAttribute("OwnerName", nil)
end

-- The player's own home spot (WorldService.HomeSpot hook).
local function homeSpot(player: Player, spotId: string): BasePart?
	local plot = owners[player]
	if not plot then
		return nil
	end
	for _, part in ipairs(spotPartsIn(plot)) do
		if part:GetAttribute("CYL_Spot") == spotId then
			return part
		end
	end
	return nil
end

function PlotService.Init()
	WorldService.HomeSpot = homeSpot
end

function PlotService.Start()
	DataService.ProfileLoaded:Connect(function(player)
		PlotService.Assign(player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		if DataService.IsLoaded(player) then
			PlotService.Assign(player)
		end
	end
	Players.PlayerRemoving:Connect(PlotService.Release)
	ShopService.EquipmentChanged:Connect(function(player)
		PlotService.Refresh(player)
	end)
	-- Lives change through many systems (choices, events, group decisions),
	-- so houses are compared on a short timer; rebuilding only happens when
	-- something visible changed.
	task.spawn(function()
		while true do
			task.wait(PlotService.RefreshSeconds)
			for player in pairs(owners) do
				if player.Parent then
					local ok, err = pcall(PlotService.Refresh, player)
					if not ok then
						warn("[PlotService] " .. tostring(err))
					end
				end
			end
		end
	end)
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">ProfileService</string>
            <string name="Source"><![CDATA[--[[
	ProfileService  (ServerScriptService.Server.Services.ProfileService)
	👤 Player profiles and statistics: GetProfile(userId) for yourself or
	anyone in this server. What others see follows their privacy settings:
	  • the name, look, title, Legacy level and achievement / star counts
	    are always shown;
	  • lifetime statistics and the current life need "My life stats" to be
	    Everyone, or Friends (Roblox friends and Life Circle members);
	  • recent lives need "Past lives" to allow you.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Style = require(Shared.Util.Style)
local Achievements = require(Shared.Data.Achievements)
local Collectibles = require(Shared.Data.Collectibles)
local LifeStages = require(Shared.Data.LifeStages)
local Endings = require(Shared.Util.Endings)
local Legacy = require(Shared.Data.Legacy)

local Server = script.Parent.Parent
local Validate = require(Server.Lib.Validate)
local DataService = require(script.Parent.DataService)
local RevealService = require(script.Parent.RevealService)
local SettingsService = require(script.Parent.SettingsService)

local ProfileService = {}
ProfileService.Priority = 27

local count = Achievements.Count

-- Same relationship rules as Life Reveal comparisons (circle members count as friends).
local function relation(viewer: Player, target: Player): string
	if viewer == target then
		return "Self"
	end
	local circle = RevealService.ExtraFriendCheck ~= nil and RevealService.ExtraFriendCheck(viewer, target)
	return if circle or RevealService.AreFriends(viewer, target) then "Friend" else "Stranger"
end

function ProfileService.Build(viewer: Player, target: Player)
	local data = DataService.Get(target)
	if not data then
		return nil
	end
	local rel = relation(viewer, target)
	local lifetime = data.Lifetime
	local endingIcons = {}
	for _, ending in ipairs(Endings.List) do
		if lifetime.EndingsSeen[ending.Id] then
			table.insert(endingIcons, ending.Icon)
		end
	end
	local profile = {
		UserId = target.UserId,
		DisplayName = target.DisplayName or target.Name,
		IsYou = viewer == target,
		Style = Style.Public(data.Inventory.Equipped),
		LegacyLevel = Legacy.Level(lifetime.LivesCompleted),
		Rebirths = lifetime.Rebirths,
		Achievements = count(data.Achievements),
		AchievementsTotal = #Achievements.List,
		Stars = count(data.Collectibles),
		StarsTotal = Collectibles.Total,
		Private = false,
	}
	if SettingsService.CanView(target, "ShareStats", rel) then
		profile.Stats = {
			LivesCompleted = lifetime.LivesCompleted,
			DecisionsMade = lifetime.DecisionsMade,
			HighestNetWorth = math.floor(lifetime.HighestNetWorth),
			CoinsEarned = lifetime.CoinsEarned,
			BestStreak = data.Daily.BestStreak,
			EndingsSeen = count(lifetime.EndingsSeen),
			EndingsTotal = #Endings.List,
			CareersHeld = count(lifetime.CareersHeld),
			WorldActions = lifetime.WorldActions,
			ShiftsWorked = lifetime.ShiftsWorked,
			DistrictsVisited = count(lifetime.DistrictsVisited),
			ChallengesCompleted = lifetime.ChallengesCompleted,
			TradesCompleted = lifetime.TradesCompleted,
		}
		profile.EndingIcons = endingIcons
		local life = data.Slots[data.ActiveSlot]
		if type(life) == "table" and not life.Completed then
			profile.CurrentLife = { Name = life.Name, Age = life.Age, Stage = LifeStages.Get(life.Stage).DisplayName, Legacy = life.Legacy }
		end
	else
		profile.Private = true
	end
	if SettingsService.CanView(target, "ShareHistory", rel) then
		profile.RecentLives = {}
		for i = #data.LifeHistory, math.max(1, #data.LifeHistory - 2), -1 do
			local entry = data.LifeHistory[i]
			table.insert(profile.RecentLives, { Name = entry.Name, Age = entry.Age, EndingIcon = entry.Ending.Icon, EndingTitle = entry.Ending.Title, Career = entry.Career, NetWorth = entry.NetWorth })
		end
	end
	return profile
end

function ProfileService.Get(viewer: Player, userId: number)
	local target = nil
	for _, player in ipairs(Players:GetPlayers()) do
		if player.UserId == userId then
			target = player
		end
	end
	if not target then
		return false, "NotHere"
	end
	local profile = ProfileService.Build(viewer, target)
	if not profile then
		return false, "NotLoaded"
	end
	return true, profile
end

function ProfileService.Init() end

function ProfileService.Start()
	Net.Handle("GetProfile", function(player, userId)
		local id = Validate.Integer(userId, -1e12, 1e12)
		if not id then
			return false, "BadArgs"
		end
		return ProfileService.Get(player, id)
	end)
end

return ProfileService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">ProgressService</string>
            <string name="Source"><![CDATA[--[[
	ProgressService  (ServerScriptService.Server.Services.ProgressService)
	Achievements (Shared/Data/Achievements) and optional Roblox badges.

	Every system records progress in the profile as it happens (Lifetime
	counters such as DecisionsMade, WorldActions, EndingsSeen...). After any
	data change (DataService.Changed) this service checks each achievement's
	Progress(data) and unlocks the ones now complete: the unlock time is
	saved, the Coins reward is granted once, the player is told, and the
	matching Roblox badge (Data/Badges) is awarded if one is set up.
	Event achievements (e.g. a wish at night) are unlocked directly with
	ProgressService.Unlock by the system that sees them happen.
]]

local BadgeService = game:GetService("BadgeService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Achievements = require(Shared.Data.Achievements)
local Badges = require(Shared.Data.Badges)

local CoinRewards = require(script.Parent.Parent.Lib.CoinRewards)
local Validate = require(script.Parent.Parent.Lib.Validate)
local DataService = require(script.Parent.DataService)

local ProgressService = {}
ProgressService.Priority = 21
ProgressService.AchievementUnlocked = Signal.new() -- (player, achievementId)

local queued: { [Player]: boolean } = {}

-- Adds to a Lifetime counter (Bump) or set (Mark).
function ProgressService.Bump(player: Player, key: string, amount: number?)
	DataService.Update(player, function(d)
		d.Lifetime[key] = (tonumber(d.Lifetime[key]) or 0) + (amount or 1)
	end)
end

function ProgressService.Mark(player: Player, setKey: string, id: string): boolean
	local added = false
	DataService.Update(player, function(d)
		local set = d.Lifetime[setKey]
		if type(set) ~= "table" then
			set = {}
			d.Lifetime[setKey] = set
		end
		if not set[id] then
			set[id] = true
			added = true
		end
	end)
	return added
end

local function awardBadge(player: Player, badgeId: number)
	if type(badgeId) ~= "number" or badgeId == 0 then
		return
	end
	local data = DataService.Get(player)
	if not data or data.BadgesAwarded[tostring(badgeId)] then
		return
	end
	task.spawn(function()
		local ok, awarded = pcall(function()
			return BadgeService:AwardBadge(player.UserId, badgeId)
		end)
		if ok and awarded then
			DataService.Update(player, function(d)
				d.BadgesAwarded[tostring(badgeId)] = true
			end)
		elseif not ok then
			warn("[ProgressService] Couldn't award badge " .. badgeId .. ": " .. tostring(awarded))
		end
	end)
end

local function announce(player: Player, ids: { string })
	local coins = 0
	for _, id in ipairs(ids) do
		coins += Achievements.ById[id].Coins or 0
	end
	if #ids <= 2 then
		for _, id in ipairs(ids) do
			local def = Achievements.ById[id]
			Net.Fire("Notify", player, { Title = "🏆 Achievement unlocked!", Text = ("%s %s · +%d 🪙"):format(def.Icon, def.Name, def.Coins or 0), Kind = "Important", Duration = 5 })
		end
	else
		Net.Fire("Notify", player, { Title = ("🏆 %d achievements unlocked!"):format(#ids), Text = ("+%d 🪙 · see 🏆 Achievements"):format(coins), Kind = "Important", Duration = 6 })
	end
	Net.Fire("AchievementsUnlocked", player, ids)
end

-- Unlocks achievements `ids` (skipping ones already unlocked). Returns the new ones.
local function unlockMany(player: Player, ids: { string }): { string }
	local fresh = {}
	DataService.Update(player, function(d)
		for _, id in ipairs(ids) do
			local def = Achievements.ById[id]
			if def and not d.Achievements[id] then
				d.Achievements[id] = os.time()
				CoinRewards.GrantBonus(d, def.Coins or 0)
				table.insert(fresh, id)
			end
		end
	end)
	if #fresh > 0 then
		announce(player, fresh)
		for _, id in ipairs(fresh) do
			awardBadge(player, Badges.ForAchievement[id] or 0)
			ProgressService.AchievementUnlocked:Fire(player, id)
		end
	end
	return fresh
end

-- For event achievements. Returns true if it was newly unlocked.
function ProgressService.Unlock(player: Player, achievementId: string): boolean
	return #unlockMany(player, { achievementId }) > 0
end

-- Checks every progress achievement against the player's data.
function ProgressService.Evaluate(player: Player): { string }
	local data = DataService.Get(player)
	if not data then
		return {}
	end
	local ready = {}
	for _, def in ipairs(Achievements.List) do
		if not def.Event and not data.Achievements[def.Id] then
			local current, target = Achievements.ProgressOf(def.Id, data)
			if current >= target then
				table.insert(ready, def.Id)
			end
		end
	end
	if #ready == 0 then
		return {}
	end
	return unlockMany(player, ready)
end

-- Badges for achievements unlocked before their badge id was configured.
local function catchUpBadges(player: Player)
	local data = DataService.Get(player)
	if not data then
		return
	end
	awardBadge(player, Badges.Welcome)
	for id in pairs(data.Achievements) do
		awardBadge(player, Badges.ForAchievement[id] or 0)
	end
end

function ProgressService.Init()
	DataService.Changed:Connect(function(player)
		if queued[player] then
			return
		end
		queued[player] = true
		task.defer(function()
			queued[player] = nil
			if player.Parent then
				ProgressService.Evaluate(player)
			end
		end)
	end)
	DataService.ProfileLoaded:Connect(function(player)
		ProgressService.Evaluate(player)
		catchUpBadges(player)
	end)
end

-- Tutorial progress: the furthest step reached, "Done" or "Reset" (Help → replay).
function ProgressService.SetTutorial(player: Player, step: any)
	if step == "Done" or step == "Reset" then
		DataService.Update(player, function(d)
			d.Tutorial.Completed = step == "Done"
			if step == "Reset" then
				d.Tutorial.Step = 0
			end
		end)
		return true
	end
	local n = Validate.Integer(step, 0, 20)
	if not n then
		return false, "BadArgs"
	end
	DataService.Update(player, function(d)
		d.Tutorial.Step = math.max(d.Tutorial.Step or 0, n)
	end)
	return true
end

function ProgressService.Start()
	Net.Handle("TutorialStep", ProgressService.SetTutorial)
end

return ProgressService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">RevealService</string>
            <string name="Source"><![CDATA[--[[
	RevealService  (ServerScriptService.Server.Services.RevealService)
	Friends' Life Reveals: lets players compare predicted futures with
	others in the same server, respecting each player's privacy settings
	(Settings → Privacy):
	  ShareReveals  who may see your predicted futures at all
	  ShareStats    who may also see your exact stats and net worth
	  ShareHistory  who may see the endings of your past lives
	Each is Everyone / Friends / Nobody. "Friends" uses Roblox friendships.

	Remote: GetLifeCards() -> true, { card per player in the server }
	(Group reveal sessions arrive with multiplayer in Phase 6.)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("Shared").Net)
local Style = require(ReplicatedStorage:WaitForChild("Shared").Util.Style)

local DataService = require(script.Parent.DataService)
local SettingsService = require(script.Parent.SettingsService)
local Reveal = require(script.Parent.Parent.Lib.Reveal)

local RevealService = {}
RevealService.Priority = 35
RevealService.FriendCacheSeconds = 300

local friendCache: { [string]: { Value: boolean, Time: number } } = {}

-- Set by PartyService: members of the same Life Circle count as friends.
RevealService.ExtraFriendCheck = nil :: ((Player, Player) -> boolean)?

function RevealService.AreFriends(a: Player, b: Player): boolean
	if a == b then
		return true
	end
	local low, high = math.min(a.UserId, b.UserId), math.max(a.UserId, b.UserId)
	local key = low .. ":" .. high
	local cached = friendCache[key]
	if cached and os.clock() - cached.Time < RevealService.FriendCacheSeconds then
		return cached.Value
	end
	local ok, result = pcall(function()
		return a:IsFriendsWith(b.UserId)
	end)
	local value = ok and result == true
	friendCache[key] = { Value = value, Time = os.clock() }
	return value
end

function RevealService.CardFor(viewer: Player, target: Player)
	local data = DataService.Get(target)
	if not data then
		return nil
	end
	local partyFriend = RevealService.ExtraFriendCheck ~= nil and RevealService.ExtraFriendCheck(viewer, target)
	local relation = if viewer == target then "Self" elseif partyFriend or RevealService.AreFriends(viewer, target) then "Friend" else "Stranger"
	local entry = {
		UserId = target.UserId,
		DisplayName = target.DisplayName or target.Name,
		IsYou = relation == "Self",
		IsFriend = relation == "Friend",
		Style = Style.Public(data.Inventory.Equipped), -- cosmetics are for showing off
	}
	if SettingsService.CanView(target, "ShareHistory", relation) then
		local endings = {}
		for i = #data.LifeHistory, math.max(1, #data.LifeHistory - 2), -1 do
			local h = data.LifeHistory[i]
			table.insert(endings, { Icon = h.Ending.Icon, Title = h.Ending.Title, Name = h.Name })
		end
		entry.Endings = endings
	end
	if not SettingsService.CanView(target, "ShareReveals", relation) then
		entry.Hidden = true
		return entry
	end
	local life = data.Slots[data.ActiveSlot]
	if type(life) ~= "table" then
		entry.NoLife = true
		return entry
	end
	entry.Card = Reveal.Card(life, SettingsService.CanView(target, "ShareStats", relation))
	return entry
end

function RevealService.CardsFor(viewer: Player)
	local cards = {}
	for _, target in ipairs(Players:GetPlayers()) do
		local card = RevealService.CardFor(viewer, target)
		if card then
			table.insert(cards, card)
		end
	end
	table.sort(cards, function(a, b)
		if a.IsYou ~= b.IsYou then
			return a.IsYou
		end
		if a.IsFriend ~= b.IsFriend then
			return a.IsFriend
		end
		return a.DisplayName < b.DisplayName
	end)
	return cards
end

function RevealService.Init() end

function RevealService.Start()
	Net.Handle("GetLifeCards", function(player)
		if not DataService.IsLoaded(player) then
			return false, "NotLoaded"
		end
		return true, RevealService.CardsFor(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		for key in pairs(friendCache) do
			if key:find(tostring(player.UserId), 1, true) then
				friendCache[key] = nil
			end
		end
	end)
end

return RevealService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">SettingsService</string>
            <string name="Source"><![CDATA[--[[
	SettingsService  (ServerScriptService.Server.Services.SettingsService)
	Saves client preferences and privacy choices. Every field is validated
	against a schema; unknown keys and out-of-range values are dropped.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local DataService = require(script.Parent.DataService)
local Validate = require(script.Parent.Parent.Lib.Validate)

local SettingsService = {}
SettingsService.Priority = 20

local SHARE_OPTIONS = { "Everyone", "Friends", "Nobody" }

SettingsService.SettingsSchema = {
	MusicVolume = { Kind = "Number", Min = 0, Max = 1 },
	SfxVolume = { Kind = "Number", Min = 0, Max = 1 },
	Graphics = { Kind = "OneOf", Options = { "Auto", "Low", "High" } },
	UIScale = { Kind = "Number", Min = 0.75, Max = 1.25 },
	CameraSensitivity = { Kind = "Number", Min = 0.2, Max = 2 },
	Notifications = { Kind = "Boolean" },
	ReduceAnimations = { Kind = "Boolean" },
}

SettingsService.PrivacySchema = {
	ShareStats = { Kind = "OneOf", Options = SHARE_OPTIONS },
	ShareReveals = { Kind = "OneOf", Options = SHARE_OPTIONS },
	ShareHistory = { Kind = "OneOf", Options = SHARE_OPTIONS },
}

local function applyPartial(player: Player, field: string, input: any, schema)
	local clean = Validate.Partial(input, schema)
	if next(clean) == nil then
		return false, "NothingValid"
	end
	local ok = DataService.Update(player, function(data)
		for key, value in pairs(clean) do
			data[field][key] = value
		end
	end)
	if not ok then
		return false, "NotLoaded"
	end
	return true, clean
end

-- Used by multiplayer systems (Phase 6) before revealing someone's stats.
-- relation: "Self" | "Friend" | "Stranger"
function SettingsService.CanView(owner: Player, field: string, relation: string): boolean
	if relation == "Self" then
		return true
	end
	local data = DataService.Get(owner)
	if not data then
		return false
	end
	local level = data.Privacy[field]
	if level == "Everyone" then
		return true
	elseif level == "Friends" then
		return relation == "Friend"
	end
	return false
end

function SettingsService.Init() end

function SettingsService.Start()
	Net.Handle("UpdateSettings", function(player, input)
		return applyPartial(player, "Settings", input, SettingsService.SettingsSchema)
	end)
	Net.Handle("UpdatePrivacy", function(player, input)
		return applyPartial(player, "Privacy", input, SettingsService.PrivacySchema)
	end)
end

return SettingsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[--[[
	ShopService  (ServerScriptService.Server.Services.ShopService)
	The Coin shop and inventory. Everything is validated on the server:
	the client only sends an item id.

	ShopBuy(itemId)      buy with Coins (auto-equips); VIP items are free with VIP
	ShopEquip(itemId)    equip something you own
	ShopUnequip(slot)    back to the default look for that slot
	ShopService.EquipmentChanged(player) fires after any change (Cosmetics).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Catalog = require(Shared.Data.Catalog)

local DataService = require(script.Parent.DataService)

local ShopService = {}
ShopService.Priority = 15
ShopService.EquipmentChanged = Signal.new() -- (player)

local function hasVip(data): boolean
	return data.Passes ~= nil and data.Passes.VIP == true
end

function ShopService.Buy(player: Player, itemId: any)
	local item = Catalog.Get(itemId)
	if not item then
		return false, "NoSuchItem"
	end
	local data = DataService.Get(player)
	if not data then
		return false, "NotLoaded"
	end
	if data.Inventory.Owned[item.Id] then
		return false, "AlreadyOwned"
	end
	if item.VipOnly then
		if not hasVip(data) then
			return false, "NeedVIP"
		end
	elseif data.Coins < item.Price then
		return false, "NotEnoughCoins"
	end
	DataService.Update(player, function(d)
		if not item.VipOnly then
			d.Coins -= item.Price
			d.Lifetime.CoinsSpent += item.Price
		end
		d.Inventory.Owned[item.Id] = true
		d.Inventory.Equipped[item.Slot] = item.Id
	end)
	ShopService.EquipmentChanged:Fire(player)
	return true, { Coins = DataService.Get(player).Coins, Equipped = item.Slot }
end

function ShopService.Equip(player: Player, itemId: any)
	local item = Catalog.Get(itemId)
	if not item then
		return false, "NoSuchItem"
	end
	local data = DataService.Get(player)
	if not data then
		return false, "NotLoaded"
	end
	if not data.Inventory.Owned[item.Id] then
		return false, "NotOwned"
	end
	if item.VipOnly and not hasVip(data) then
		return false, "NeedVIP"
	end
	DataService.Update(player, function(d)
		d.Inventory.Equipped[item.Slot] = item.Id
	end)
	ShopService.EquipmentChanged:Fire(player)
	return true, { Slot = item.Slot }
end

function ShopService.Unequip(player: Player, slot: any)
	if type(slot) ~= "string" or not Catalog.Slots[slot] then
		return false, "BadSlot"
	end
	if not DataService.Update(player, function(d)
		d.Inventory.Equipped[slot] = nil
	end) then
		return false, "NotLoaded"
	end
	ShopService.EquipmentChanged:Fire(player)
	return true
end

--[[
	Removes anything that's no longer valid: unknown items (removed from the
	catalog), items not owned, and VIP items without VIP. Called on join and
	whenever VIP ownership changes.
]]
function ShopService.Sanitize(player: Player)
	DataService.Update(player, function(d)
		for slot, itemId in pairs(d.Inventory.Equipped) do
			local item = Catalog.Get(itemId)
			if not item or item.Slot ~= slot or not d.Inventory.Owned[itemId] or (item.VipOnly and not hasVip(d)) then
				d.Inventory.Equipped[slot] = nil
			end
		end
	end)
	ShopService.EquipmentChanged:Fire(player)
end

function ShopService.Init()
	local problems = Catalog.Validate()
	for _, problem in ipairs(problems) do
		warn("[ShopService] Catalog problem: " .. problem)
	end
	DataService.ProfileLoaded:Connect(function(player)
		ShopService.Sanitize(player)
	end)
end

function ShopService.Start()
	Net.Handle("ShopBuy", ShopService.Buy)
	Net.Handle("ShopEquip", ShopService.Equip)
	Net.Handle("ShopUnequip", ShopService.Unequip)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">StatService</string>
            <string name="Source"><![CDATA[--[[
	StatService  (ServerScriptService.Server.Services.StatService)
	Authoritative stat changes for the active life. Decision, event, career and
	relationship systems (later phases) call StatService.Apply; nothing on the
	client can change stats directly.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local StatMath = require(Shared.Util.StatMath)
local Signal = require(Shared.Util.Signal)

local DataService = require(script.Parent.DataService)

local StatService = {}
StatService.Priority = 10

StatService.StatsChanged = Signal.new() -- (player, applied, reason)

--[[
	Applies deltas to the active life. `multipliers` lets traits amplify or dampen
	specific stats (e.g. a "Resilient" trait halves Health losses).
	Returns the actually-applied deltas, or nil if the player has no active life.
]]
function StatService.Apply(player: Player, deltas: { [string]: number }, reason: string, multipliers: { [string]: number }?)
	local applied
	local ok = DataService.Update(player, function(data)
		local life = data.Slots[data.ActiveSlot]
		if type(life) ~= "table" or life.Completed then
			return
		end
		local newStats
		newStats, applied = StatMath.Apply(life.Stats, deltas, multipliers)
		life.Stats = newStats
	end)
	if ok and applied then
		StatService.StatsChanged:Fire(player, applied, reason)
		return applied
	end
	return nil
end

function StatService.Get(player: Player): { [string]: number }?
	local life = DataService.GetActiveLife(player)
	return life and table.clone(life.Stats)
end

-- Recomputes the Wealth stat from money + asset value (called by economy systems).
function StatService.SyncWealth(player: Player, netWorth: number)
	DataService.Update(player, function(data)
		local life = data.Slots[data.ActiveSlot]
		if type(life) == "table" then
			life.Stats.Wealth = StatMath.WealthFromNetWorth(netWorth)
		end
	end)
end

function StatService.Init() end
function StatService.Start() end

return StatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">StoreService</string>
            <string name="Source"><![CDATA[--[[
	StoreService  (ServerScriptService.Server.Services.StoreService)
	Legitimate Robux purchases via MarketplaceService (ids in Data/Monetisation).

	Developer products (coin packs): MarketplaceService.ProcessReceipt
	  • each PurchaseId is granted at most once (profile.ProcessedReceipts)
	  • Coins are granted, then the profile is SAVED, and only then do we
	    tell Roblox PurchaseGranted. If anything fails we answer
	    NotProcessedYet, and Roblox safely retries later.
	Game passes (VIP, 2× Coins):
	  • on every join, ownership comes from Roblox (UserOwnsGamePassAsync);
	  • when Roblox reports a purchase in this server (the server-side
	    PromptGamePassPurchaseFinished), the pass applies straight away, as
	    Roblox's own guide does. Roblox caches ownership, so a pass bought
	    in-game can still read as "not owned" for the rest of the session.
	    Until Roblox confirms ownership, the pass is marked unverified
	    (data.PassesUnverified) and is re-checked on the next join; it is
	    removed if Roblox says it isn't owned (or can't say).
	  • Remotes never grant passes: the client's word is never trusted.
	GetStoreInfo(): real names and Robux prices from Roblox (GetProductInfo).
	Unconfigured ids (0) are hidden: no placeholder buttons, nothing fake.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Config = require(Shared.Config)
local Monetisation = require(Shared.Data.Monetisation)
local TableUtil = require(Shared.Util.TableUtil)

local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)

local StoreService = {}
StoreService.Priority = 16
StoreService.PassChanged = Signal.new() -- (player, key, owned)
StoreService.CoinsPurchased = Signal.new() -- (player, coins)

-- Looked up on demand so ids pasted into Data/Monetisation are always current.
local function productFor(id: number)
	for _, product in ipairs(Monetisation.Products) do
		if product.Id ~= 0 and product.Id == id then
			return product
		end
	end
	return nil
end

local function passKeys(): { [number]: string }
	local map = {}
	for key, pass in pairs(Monetisation.Passes) do
		if pass.Id ~= 0 then
			map[pass.Id] = key
		end
	end
	return map
end

function StoreService.HasPass(player: Player, key: string): boolean
	local data = DataService.Get(player)
	return data ~= nil and data.Passes[key] == true
end

local function ownsPass(player: Player, passId: number): boolean?
	local ok, owned = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, passId)
	end)
	if ok then
		return owned == true
	end
	return nil -- unknown (Roblox unreachable): keep the cached value
end

-- verified = Roblox confirmed ownership (UserOwnsGamePassAsync).
local function setPass(player: Player, key: string, owned: boolean, verified: boolean): boolean
	local changed = false
	DataService.Update(player, function(d)
		d.PassesUnverified = d.PassesUnverified or {}
		if (d.Passes[key] == true) ~= owned then
			changed = true
		end
		d.Passes[key] = owned or nil
		d.PassesUnverified[key] = if owned and not verified then true else nil
	end)
	if changed then
		StoreService.PassChanged:Fire(player, key, owned)
		if key == "VIP" then
			ShopService.Sanitize(player)
		end
	end
	return changed
end

function StoreService.IsVerified(player: Player, key: string): boolean
	local data = DataService.Get(player)
	return data ~= nil and data.Passes[key] == true and not (data.PassesUnverified and data.PassesUnverified[key])
end

-- On join: Roblox's answer is fresh when a player enters a server.
function StoreService.RefreshPasses(player: Player)
	for passId, key in pairs(passKeys()) do
		local owned = ownsPass(player, passId)
		if owned ~= nil then
			setPass(player, key, owned, true)
		elseif StoreService.HasPass(player, key) and not StoreService.IsVerified(player, key) then
			-- Roblox unreachable: keep confirmed passes, but an unconfirmed one
			-- waits until Roblox can confirm it.
			setPass(player, key, false, false)
		end
	end
end

-- ===== Developer products =====
function StoreService.ProcessReceipt(receipt)
	local player = nil
	for _, p in ipairs(Players:GetPlayers()) do
		if p.UserId == receipt.PlayerId then
			player = p
		end
	end
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- they left; Roblox retries next time
	end
	local product = productFor(receipt.ProductId)
	if not product then
		warn("[StoreService] Receipt for an unknown product id " .. tostring(receipt.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.WaitForData(player, 15)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if table.find(data.ProcessedReceipts, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted -- already granted earlier
	end
	DataService.Update(player, function(d)
		d.Coins += product.Coins
		d.Lifetime.CoinsBought += product.Coins
		table.insert(d.ProcessedReceipts, receipt.PurchaseId)
		TableUtil.TrimArray(d.ProcessedReceipts, Config.MaxProcessedReceipts)
	end)
	if not DataService.SaveNow(player) then
		-- Keep the in-memory grant (the receipt id blocks a double grant if
		-- Roblox retries in this session), but don't confirm until it's saved.
		warn("[StoreService] Couldn't save after a purchase; Roblox will retry")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	StoreService.CoinsPurchased:Fire(player, product.Coins)
	Net.Fire("Notify", player, { Title = product.Icon .. " Thank you!", Text = ("+%d Coins added to your account."):format(product.Coins), Kind = "Important" })
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

-- ===== Store info for the client =====
local infoCache = {}
local function productInfo(id: number, infoType)
	local cached = infoCache[id]
	if cached and os.clock() - cached.Time < 300 then
		return cached.Info
	end
	local ok, info = pcall(function()
		return MarketplaceService:GetProductInfo(id, infoType)
	end)
	if ok and type(info) == "table" then
		infoCache[id] = { Info = info, Time = os.clock() }
		return info
	end
	return nil
end

function StoreService.Info(player: Player)
	local products, passes = {}, {}
	for _, product in ipairs(Monetisation.Products) do
		if product.Id ~= 0 then
			local info = productInfo(product.Id, Enum.InfoType.Product)
			if info and info.PriceInRobux then
				table.insert(products, { Key = product.Key, Id = product.Id, Coins = product.Coins, Name = product.Name, Icon = product.Icon, Price = info.PriceInRobux })
			end
		end
	end
	for _, key in ipairs(Monetisation.PassOrder) do
		local pass = Monetisation.Passes[key]
		if pass.Id ~= 0 then
			local info = productInfo(pass.Id, Enum.InfoType.GamePass)
			if info and info.PriceInRobux then
				table.insert(passes, { Key = key, Id = pass.Id, Name = pass.Name, Icon = pass.Icon, Description = pass.Description, Price = info.PriceInRobux, Owned = StoreService.HasPass(player, key) })
			end
		end
	end
	return { Products = products, Passes = passes }
end

function StoreService.Init()
	DataService.ProfileLoaded:Connect(function(player)
		task.spawn(StoreService.RefreshPasses, player)
	end)
end

function StoreService.Start()
	MarketplaceService.ProcessReceipt = StoreService.ProcessReceipt
	-- Fired on the server by Roblox's purchase prompt (not one of our remotes).
	local checking = {} -- [player] = { [passId] = true } while confirming
	Players.PlayerRemoving:Connect(function(player)
		checking[player] = nil
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		local key = passKeys()[passId]
		if not key or not purchased or not DataService.Get(player) then
			return
		end
		if StoreService.IsVerified(player, key) then
			return -- already confirmed (repeat events change nothing)
		end
		local pass = Monetisation.Passes[key]
		if setPass(player, key, true, false) then
			Net.Fire("Notify", player, { Title = pass.Icon .. " " .. pass.Name .. " unlocked!", Text = "Thank you for supporting the game.", Kind = "Important" })
		end
		checking[player] = checking[player] or {}
		if checking[player][passId] then
			return -- a confirmation is already running
		end
		checking[player][passId] = true
		-- Confirm with Roblox when its cache allows; otherwise on the next join.
		for attempt = 1, 3 do
			if player.Parent == nil then
				break
			end
			if ownsPass(player, passId) then
				setPass(player, key, true, true)
				break
			end
			task.wait(attempt * 2)
		end
		if checking[player] then
			checking[player][passId] = nil
		end
	end)
	Net.Handle("GetStoreInfo", function(player)
		return true, StoreService.Info(player)
	end)
end

return StoreService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">TradeService</string>
            <string name="Source"><![CDATA[--[[
	TradeService  (ServerScriptService.Server.Services.TradeService)
	🔄 Trading cosmetic items between two players in the same server.
	Only items bought with Coins can be traded (Catalog.IsTradable); VIP
	items, Coins and anything bought with Robux never change hands.

	Flow (every step checked on the server):
	  1. TradeRequestSend(userId) → the other player gets a request (30 s).
	  2. TradeRespond(requestId, true) opens a trade window for both.
	  3. TradeSetOffer(sessionId, { itemIds }) — up to MaxItems you own that
	     the other player doesn't. Any change un-readies BOTH players and
	     bumps the offer Version.
	  4. TradeReady(sessionId, version, true) — you lock in the exact version
	     you saw, so nobody can switch items after you agree. When both are
	     ready a short countdown runs; either player can still cancel.
	  5. The server re-checks everything (both still here, own the items,
	     can receive them), swaps both inventories in one step with no
	     yielding in between, records the trade id in both profiles (a trade
	     is applied at most once) and saves both players immediately.
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Catalog = require(Shared.Data.Catalog)
local TableUtil = require(Shared.Util.TableUtil)

local Server = script.Parent.Parent
local Validate = require(Server.Lib.Validate)
local DataService = require(script.Parent.DataService)
local ShopService = require(script.Parent.ShopService)

local TradeService = {}
TradeService.Priority = 28
TradeService.MaxItems = 6
TradeService.RequestSeconds = 30
TradeService.RequestCooldown = 8
TradeService.CountdownSeconds = 3
TradeService.MaxLog = 20
TradeService.Completed = Signal.new() -- (playerA, playerB, tradeId)

local requests = {}
local sessions = {}
local sessionOf: { [Player]: any } = {}
local lastRequest: { [Player]: number } = {}
local counter = 0

local function nextId(prefix: string): string
	counter += 1
	return prefix .. counter
end

local function name(player: Player): string
	return player.DisplayName or player.Name
end

local function playerById(userId: number): Player?
	for _, player in ipairs(Players:GetPlayers()) do
		if player.UserId == userId then
			return player
		end
	end
	return nil
end

local function other(session, player: Player): Player
	return if session.A == player then session.B else session.A
end

local function itemInfo(ids: { string })
	local out = {}
	for _, id in ipairs(ids) do
		local item = Catalog.Get(id)
		if item then
			table.insert(out, { Id = id, Name = item.Name, Icon = item.Icon, Rarity = item.Rarity })
		end
	end
	return out
end

local function stateFor(session, player: Player)
	local them = other(session, player)
	return {
		SessionId = session.Id,
		Version = session.Version,
		With = { UserId = them.UserId, Name = name(them) },
		Mine = itemInfo(session.Offers[player]),
		Theirs = itemInfo(session.Offers[them]),
		MyReady = session.Ready[player] == true,
		TheirReady = session.Ready[them] == true,
		Countdown = session.CountdownEnds and math.max(0, math.ceil(session.CountdownEnds - os.clock())) or nil,
	}
end

local function broadcast(session)
	for _, player in ipairs({ session.A, session.B }) do
		Net.Fire("TradeUpdate", player, stateFor(session, player))
	end
end

local function close(session, reason: string, extra)
	if session.Done then
		return
	end
	session.Done = true
	sessions[session.Id] = nil
	for _, player in ipairs({ session.A, session.B }) do
		if sessionOf[player] == session then
			sessionOf[player] = nil
		end
		local payload = { Closed = true, Reason = reason, SessionId = session.Id }
		if extra then
			payload.Completed = true
			payload.Gave = itemInfo(session.Offers[player])
			payload.Got = itemInfo(session.Offers[other(session, player)])
		end
		Net.Fire("TradeUpdate", player, payload)
	end
end

function TradeService.SessionOf(player: Player)
	return sessionOf[player]
end

-- ===== Requests =====
function TradeService.Request(player: Player, targetUserId: number)
	local target = playerById(targetUserId)
	if not target or target == player then
		return false, "NotHere"
	end
	if not DataService.Get(player) or not DataService.Get(target) then
		return false, "NotLoaded"
	end
	if sessionOf[player] then
		return false, "AlreadyTrading"
	end
	if sessionOf[target] then
		return false, "TheyAreTrading"
	end
	local now = os.clock()
	if lastRequest[player] and now - lastRequest[player] < TradeService.RequestCooldown then
		return false, "Cooldown"
	end
	lastRequest[player] = now
	local id = nextId("tr")
	requests[id] = { Id = id, From = player, To = target, Expires = now + TradeService.RequestSeconds }
	Net.Fire("TradeRequest", target, { RequestId = id, FromUserId = player.UserId, FromName = name(player), Seconds = TradeService.RequestSeconds })
	return true, id
end

function TradeService.Respond(player: Player, requestId: string, accept: boolean)
	local request = requests[requestId]
	if not request or request.To ~= player then
		return false, "NoRequest"
	end
	requests[requestId] = nil
	local from = request.From
	if os.clock() > request.Expires then
		return false, "Expired"
	end
	if not accept then
		Net.Fire("Notify", from, { Title = "🔄 Trade", Text = name(player) .. " declined your trade request.", Kind = "Info" })
		return true, "Declined"
	end
	if not from.Parent then
		return false, "NotHere"
	end
	if sessionOf[player] or sessionOf[from] then
		return false, "AlreadyTrading"
	end
	local session = { Id = nextId("ts"), A = from, B = player, Offers = { [from] = {}, [player] = {} }, Ready = {}, Version = 1 }
	sessions[session.Id] = session
	sessionOf[from] = session
	sessionOf[player] = session
	broadcast(session)
	return true, session.Id
end

-- ===== Offers =====
-- Checks `ids` can go from `giver` to `receiver`: ok, reason.
function TradeService.CheckOffer(giver: Player, receiver: Player, ids: { string }): (boolean, string?)
	local giverData, receiverData = DataService.Get(giver), DataService.Get(receiver)
	if not giverData or not receiverData then
		return false, "NotLoaded"
	end
	local seen = {}
	for _, id in ipairs(ids) do
		local item = Catalog.Get(id)
		if seen[id] then
			return false, "Duplicate"
		end
		seen[id] = true
		if not Catalog.IsTradable(item) then
			return false, "NotTradable"
		end
		if not giverData.Inventory.Owned[id] then
			return false, "NotOwned"
		end
		if receiverData.Inventory.Owned[id] then
			return false, "TheyOwnIt"
		end
	end
	return true, nil
end

local function cancelCountdown(session)
	session.CountdownEnds = nil
	session.CountdownToken = nil
end

function TradeService.SetOffer(player: Player, sessionId: string, itemIds: any)
	local session = sessions[sessionId]
	if not session or sessionOf[player] ~= session or session.Done then
		return false, "NoTrade"
	end
	if type(itemIds) ~= "table" or #itemIds > TradeService.MaxItems then
		return false, "TooMany"
	end
	local ids = {}
	for i = 1, #itemIds do
		local id = Validate.Id(itemIds[i], 40)
		if not id then
			return false, "BadArgs"
		end
		table.insert(ids, id)
	end
	local ok, reason = TradeService.CheckOffer(player, other(session, player), ids)
	if not ok then
		return false, reason
	end
	session.Offers[player] = ids
	session.Ready = {}
	session.Version += 1
	cancelCountdown(session)
	broadcast(session)
	return true, session.Version
end

-- ===== Completing a trade =====
local function applySide(d, gives: { string }, gets: { string }, tradeId: string, withName: string)
	for _, id in ipairs(gives) do
		d.Inventory.Owned[id] = nil
		for slot, equipped in pairs(d.Inventory.Equipped) do
			if equipped == id then
				d.Inventory.Equipped[slot] = nil
			end
		end
	end
	for _, id in ipairs(gets) do
		d.Inventory.Owned[id] = true
	end
	d.Lifetime.TradesCompleted += 1
	table.insert(d.ProcessedTrades, tradeId)
	TableUtil.TrimArray(d.ProcessedTrades, 50)
	table.insert(d.TradeLog, { Id = tradeId, With = withName, Gave = table.clone(gives), Got = table.clone(gets), Time = os.time() })
	TableUtil.TrimArray(d.TradeLog, TradeService.MaxLog)
end

function TradeService.Execute(session)
	local a, b = session.A, session.B
	if session.Done or not a.Parent or not b.Parent then
		close(session, "A player left.")
		return false, "Gone"
	end
	local giveA, giveB = session.Offers[a], session.Offers[b]
	if #giveA + #giveB == 0 then
		return false, "Empty"
	end
	local okA, reasonA = TradeService.CheckOffer(a, b, giveA)
	local okB, reasonB = TradeService.CheckOffer(b, a, giveB)
	if not okA or not okB then
		session.Ready = {}
		cancelCountdown(session)
		broadcast(session)
		return false, reasonA or reasonB
	end
	local tradeId = HttpService:GenerateGUID(false)
	local dataA, dataB = DataService.Get(a), DataService.Get(b)
	if table.find(dataA.ProcessedTrades, tradeId) or table.find(dataB.ProcessedTrades, tradeId) then
		return false, "Duplicate"
	end
	-- Both inventories change together: no yields between these two updates.
	DataService.Update(a, function(d)
		applySide(d, giveA, giveB, tradeId, name(b))
	end)
	DataService.Update(b, function(d)
		applySide(d, giveB, giveA, tradeId, name(a))
	end)
	close(session, "Trade complete!", true)
	for _, player in ipairs({ a, b }) do
		ShopService.EquipmentChanged:Fire(player)
		task.spawn(function()
			if not DataService.SaveNow(player) then
				warn("[TradeService] Save after trade " .. tradeId .. " failed for " .. player.Name .. "; it will be saved with the next autosave")
			end
		end)
	end
	TradeService.Completed:Fire(a, b, tradeId)
	return true, tradeId
end

function TradeService.SetReady(player: Player, sessionId: string, version: any, ready: any)
	local session = sessions[sessionId]
	if not session or sessionOf[player] ~= session or session.Done then
		return false, "NoTrade"
	end
	if version ~= session.Version then
		return false, "Changed" -- the offer changed since you looked
	end
	session.Ready[player] = ready == true
	if not session.Ready[player] then
		cancelCountdown(session)
		broadcast(session)
		return true
	end
	local them = other(session, player)
	if session.Ready[them] and #session.Offers[player] + #session.Offers[them] > 0 then
		local token = {}
		session.CountdownToken = token
		session.CountdownEnds = os.clock() + TradeService.CountdownSeconds
		local lockedVersion = session.Version
		task.delay(TradeService.CountdownSeconds, function()
			if session.CountdownToken == token and session.Version == lockedVersion and session.Ready[session.A] and session.Ready[session.B] then
				TradeService.Execute(session)
			end
		end)
	end
	broadcast(session)
	return true
end

function TradeService.Cancel(player: Player, sessionId: any)
	local session = sessionOf[player]
	if not session or (sessionId ~= nil and session.Id ~= sessionId) then
		return false, "NoTrade"
	end
	close(session, name(player) .. " cancelled the trade.")
	return true
end

function TradeService.Init()
	Players.PlayerRemoving:Connect(function(player)
		local session = sessionOf[player]
		if session then
			close(session, name(player) .. " left the server.")
		end
		for id, request in pairs(requests) do
			if request.From == player or request.To == player then
				requests[id] = nil
			end
		end
		lastRequest[player] = nil
	end)
end

function TradeService.Start()
	Net.Handle("TradeRequestSend", function(player, userId)
		local id = Validate.Integer(userId, -1e12, 1e12)
		if not id then
			return false, "BadArgs"
		end
		return TradeService.Request(player, id)
	end)
	Net.Handle("TradeRespond", function(player, requestId, accept)
		local id = Validate.Id(requestId, 16)
		if not id or type(accept) ~= "boolean" then
			return false, "BadArgs"
		end
		return TradeService.Respond(player, id, accept)
	end)
	Net.Handle("TradeSetOffer", function(player, sessionId, itemIds)
		local id = Validate.Id(sessionId, 16)
		if not id then
			return false, "BadArgs"
		end
		return TradeService.SetOffer(player, id, itemIds)
	end)
	Net.Handle("TradeReady", function(player, sessionId, version, ready)
		local id = Validate.Id(sessionId, 16)
		if not id or type(version) ~= "number" then
			return false, "BadArgs"
		end
		return TradeService.SetReady(player, id, version, ready)
	end)
	Net.Handle("TradeCancel", function(player, sessionId)
		return TradeService.Cancel(player, Validate.Id(sessionId, 16))
	end)
end

return TradeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--[[
	WorldService  (ServerScriptService.Server.Services.WorldService)
	Lifeville on the server:
	  • builds the town into Workspace.World when the server starts (or keeps
	    a World you baked into the place, see World/Town);
	  • sets up lighting effects (the day/night cycle runs on each client from
	    the shared server clock, see Shared/Data/World.ClockTimeAt);
	  • handles WorldAction(spotId, npcId?) — the server decides:
	      - the spot exists and isn't just a menu shortcut,
	      - your character is actually there (near the spot, or near the NPC
	        offering it), or in your own home for home spots,
	      - then Actions.World checks age, career, unlocks, money and the
	        2-actions-per-decision budget (shared with the People panel).

	Hooks set by other services (avoids circular requires):
	  WorldService.NPCPosition(npcId) -> Vector3?      (NPCService)
	  WorldService.HomeSpot(player, spotId) -> BasePart? (PlotService)
	Signals: WorldService.ActionDone(player, spotId, result)
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local World = require(Shared.Data.World)
local WorldSpots = require(Shared.Data.WorldSpots)
local NPCs = require(Shared.Data.NPCs)

local Server = script.Parent.Parent
local Validate = require(Server.Lib.Validate)
local Town = require(Server.World.Town)

local LifeService = require(script.Parent.LifeService)
local DataService = require(script.Parent.DataService)
local ProgressService = require(script.Parent.ProgressService)

local WorldService = {}
WorldService.Priority = 12
WorldService.ActionDone = Signal.new()
WorldService.MaxSpotDistance = 16
WorldService.MaxNPCDistance = 18

WorldService.NPCPosition = function(_npcId: string): Vector3?
	return nil
end
WorldService.HomeSpot = function(_player: Player, _spotId: string): BasePart?
	return nil
end

local world: Folder? = nil
local spotParts: { [string]: { BasePart } } = {}

function WorldService.Folder(): Folder?
	return world
end

function WorldService.SpotParts(spotId: string): { BasePart }
	return spotParts[spotId] or {}
end

function WorldService.RegisterSpot(part: BasePart)
	local id = part:GetAttribute("CYL_Spot")
	if type(id) == "string" then
		spotParts[id] = spotParts[id] or {}
		if not table.find(spotParts[id], part) then
			table.insert(spotParts[id], part)
		end
	end
end

function WorldService.UnregisterSpot(part: BasePart)
	local id = part:GetAttribute("CYL_Spot")
	local list = type(id) == "string" and spotParts[id]
	if list then
		local i = table.find(list, part)
		if i then
			table.remove(list, i)
		end
	end
end

local function rootPosition(player: Player): Vector3?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root then root.Position else nil
end

local function npcOffers(npcId: string, spotId: string): boolean
	local npc = NPCs.ById[npcId]
	if not npc or not npc.Options then
		return false
	end
	for _, option in ipairs(npc.Options) do
		if option.Spot == spotId then
			return true
		end
	end
	return false
end

-- Validates where the player is, then runs the action on their life.
function WorldService.Use(player: Player, spotId: string, npcId: string?)
	local def = WorldSpots.Get(spotId)
	if not def or def.Kind == "Open" then
		return false, "BadSpot"
	end
	local position = rootPosition(player)
	if not position then
		return false, "NoCharacter"
	end
	local extra = {}
	if npcId then
		if not npcOffers(npcId, spotId) then
			return false, "BadSpot"
		end
		local npcPosition = WorldService.NPCPosition(npcId)
		if not npcPosition or (npcPosition - position).Magnitude > WorldService.MaxNPCDistance then
			return false, "TooFar"
		end
	elseif def.OwnHome then
		local part = WorldService.HomeSpot(player, spotId)
		if not part then
			return false, "NotYourHome"
		end
		if (part.Position - position).Magnitude > WorldService.MaxSpotDistance then
			return false, "TooFar"
		end
		extra.OwnHome = true
	else
		local nearest = math.huge
		for _, part in ipairs(WorldService.SpotParts(spotId)) do
			nearest = math.min(nearest, (part.Position - position).Magnitude)
		end
		if nearest > WorldService.MaxSpotDistance then
			return false, "TooFar"
		end
	end
	local ok, result = LifeService.WorldAction(player, spotId, extra)
	if ok then
		DataService.Update(player, function(d)
			local lifetime = d.Lifetime
			lifetime.WorldActions += 1
			if def.Kind == "Shift" then
				lifetime.ShiftsWorked += 1
			end
			if spotId == "Plaza_Wish" then
				lifetime.Wishes += 1
			elseif spotId == "Harbour_Trip" then
				lifetime.Trips += 1
			end
		end)
		if spotId == "Plaza_Wish" and World.IsNight(World.ClockTimeAt(workspace:GetServerTimeNow())) then
			ProgressService.Unlock(player, "S_NightOwl")
		end
		WorldService.ActionDone:Fire(player, spotId, result)
	end
	return ok, result
end

-- Talking to someone (checked: you're standing next to them).
function WorldService.Talk(player: Player, npcId: string)
	if not NPCs.ById[npcId] then
		return false, "BadNPC"
	end
	local position = rootPosition(player)
	local npcPosition = WorldService.NPCPosition(npcId)
	if not position or not npcPosition or (npcPosition - position).Magnitude > WorldService.MaxNPCDistance then
		return false, "TooFar"
	end
	ProgressService.Mark(player, "NPCsTalked", npcId)
	return true
end

-- Records which districts each player has walked into (open ones only).
function WorldService.CheckVisits()
	for _, player in ipairs(Players:GetPlayers()) do
		local position = rootPosition(player)
		local data = DataService.Get(player)
		if position and data then
			local districtId = World.DistrictAt(position.X, position.Z)
			local life = data.Slots[data.ActiveSlot]
			local stage = World.StageOf(if type(life) == "table" then life else nil)
			if districtId and not data.Lifetime.DistrictsVisited[districtId] and World.IsUnlocked(districtId, stage) then
				ProgressService.Mark(player, "DistrictsVisited", districtId)
			end
		end
	end
end

local function ensureEffect(className: string, name: string, props)
	local effect = Lighting:FindFirstChild(name)
	if not effect then
		effect = Instance.new(className)
		effect.Name = name
		for key, value in pairs(props) do
			effect[key] = value
		end
		effect.Parent = Lighting
	end
	return effect
end

local function setupLighting()
	ensureEffect("Atmosphere", "Atmosphere", { Density = 0.28, Offset = 0.2, Color = Color3.fromRGB(199, 214, 230), Decay = Color3.fromRGB(106, 112, 125), Glare = 0.15, Haze = 1.1 })
	ensureEffect("BloomEffect", "Bloom", { Intensity = 0.4, Size = 24, Threshold = 1.7 })
	ensureEffect("SunRaysEffect", "SunRays", { Intensity = 0.05, Spread = 0.6 })
	ensureEffect("ColorCorrectionEffect", "WorldColour", { Saturation = 0.08, Contrast = 0.04, Brightness = 0 })
end

local function ensureSpawn()
	for _, child in ipairs(workspace:GetChildren()) do
		if child:IsA("SpawnLocation") then
			return
		end
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "SpawnLocation"
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.CFrame = CFrame.new(0, 0.66, 32)
	spawn.Duration = 0
	spawn.Parent = workspace
end

function WorldService.Init()
	world = workspace:FindFirstChild("World") :: Folder?
	if not world then
		world = Town.Build(workspace)
	end
	for _, part in ipairs(CollectionService:GetTagged("CYL_Spot")) do
		if part:IsDescendantOf(world) then
			WorldService.RegisterSpot(part)
		end
	end
	ensureSpawn()
	setupLighting()
end

function WorldService.Start()
	Net.Handle("WorldAction", function(player, spotId, npcId)
		local id = Validate.Id(spotId, 32)
		if not id then
			return false, "BadArgs"
		end
		local npc = nil
		if npcId ~= nil then
			npc = Validate.Id(npcId, 24)
			if not npc then
				return false, "BadArgs"
			end
		end
		return WorldService.Use(player, id, npc)
	end)
	Net.Handle("Talk", function(player, npcId)
		local id = Validate.Id(npcId, 24)
		if not id then
			return false, "BadArgs"
		end
		return WorldService.Talk(player, id)
	end)
	task.spawn(function()
		while true do
			task.wait(3)
			pcall(WorldService.CheckVisits)
		end
	end)
end

return WorldService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="88">
        <Properties>
          <string name="Name">World</string>
        </Properties>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">Builder</string>
            <string name="Source"><![CDATA[--[[
	Builder  (ServerScriptService.Server.World.Builder)
	Building blocks for generating Lifeville from code: parts, buildings you
	can walk into (walls with a real doorway, windows, roof, lights, sign),
	furniture, trees, lamps, benches (sittable Seats), cars, boats, signs,
	interaction spots (ProximityPrompts) and NPC anchors.

	Conventions:
	  • Everything is Anchored; small props don't cast shadows (performance).
	  • A CFrame "cf" for a building is its ground centre; the front (door)
	    faces cf.LookVector (-Z in its local space).
	  • Tags (CollectionService) the client and services look for:
	      CYL_Lamp (street lamp heads), CYL_Window (glow at night),
	      CYL_Door (sliding door panels), CYL_Spot (interaction parts),
	      CYL_Lock (locked-area walls), CYL_Seat.
	  • Spot parts carry attribute CYL_Spot = WorldSpots id.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local WorldSpots = require(Shared.Data.WorldSpots)

local B = {}

B.Palette = {
	Asphalt = "#3A3D42", Line = "#F1F1F1", Pavement = "#B9B4AA", Kerb = "#8F8A80",
	Grass = "#5DA34B", DarkGrass = "#3F7F36", Sand = "#E8D3A2", Wood = "#8B5A2B", DarkWood = "#5C3B1E",
	Leaves = "#3E9B46", LeavesLight = "#6BBF59", Trunk = "#6B4423", Stone = "#A8A29A", Glass = "#9FD3F2",
	White = "#F5F5F5", Black = "#1E1E1E", Metal = "#9AA0A6", Roof = "#7A3E2E", Water = "#3FA7D6",
}

local function color(value)
	if type(value) == "string" then
		return Color3.fromHex(value)
	end
	return value
end
B.Color = color

-- CFrame helper: position + yaw (degrees).
function B.At(x: number, y: number, z: number, yaw: number?): CFrame
	return CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(yaw or 0), 0)
end

-- Yaw (degrees) that makes something at (x, z) face (tx, tz).
function B.YawFacing(x: number, z: number, tx: number, tz: number): number
	return math.deg(math.atan2(x - tx, z - tz))
end

function B.Folder(parent: Instance, name: string): Folder
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

function B.Model(parent: Instance, name: string): Model
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

--[[
	B.Part(parent, {
		Name, Size = Vector3, CFrame, Color = hex|Color3, Material = Enum.Material,
		Class = "Part" | "WedgePart" | "Seat" | "SpawnLocation", Shape = Enum.PartType,
		Transparency, CanCollide, CastShadow, Reflectance, Tag
	})
]]
function B.Part(parent: Instance, p)
	local part = Instance.new(p.Class or "Part")
	part.Name = p.Name or "Part"
	part.Anchored = true
	part.Size = p.Size
	part.CFrame = p.CFrame
	part.Color = color(p.Color or B.Palette.Stone)
	part.Material = p.Material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if p.Shape then
		part.Shape = p.Shape
	end
	if p.Transparency then
		part.Transparency = p.Transparency
	end
	if p.Reflectance then
		part.Reflectance = p.Reflectance
	end
	if p.CanCollide ~= nil then
		part.CanCollide = p.CanCollide
	end
	part.CastShadow = p.CastShadow == true
	if p.CanCollide == false then
		part.CanTouch = false
	end
	if p.Tag then
		CollectionService:AddTag(part, p.Tag)
	end
	part.Parent = parent
	return part
end

-- Box with size (x, y, z) whose BOTTOM sits on cf (handy for things on the ground).
function B.Block(parent: Instance, name: string, cf: CFrame, sx: number, sy: number, sz: number, col, material, extra)
	local props = extra or {}
	props.Name = name
	props.Size = Vector3.new(sx, sy, sz)
	props.CFrame = cf * CFrame.new(0, sy / 2, 0)
	props.Color = col
	props.Material = material
	return B.Part(parent, props)
end

function B.Cylinder(parent: Instance, name: string, cf: CFrame, diameter: number, height: number, col, material, extra)
	-- Roblox cylinders run along X; rotate so they stand up.
	local props = extra or {}
	props.Name = name
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(height, diameter, diameter)
	props.CFrame = cf * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, 0, math.rad(90))
	props.Color = col
	props.Material = material
	return B.Part(parent, props)
end

function B.Ball(parent: Instance, name: string, position: Vector3, diameter: number, col, material, extra)
	local props = extra or {}
	props.Name = name
	props.Shape = Enum.PartType.Ball
	props.Size = Vector3.new(diameter, diameter, diameter)
	props.CFrame = CFrame.new(position)
	props.Color = col
	props.Material = material
	return B.Part(parent, props)
end

-- ===== Text =====
function B.Text(part: BasePart, face, text: string, options)
	options = options or {}
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Text"
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = options.PixelsPerStud or 30
	gui.LightInfluence = options.LightInfluence or 0.2
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = text
	label.TextScaled = true
	label.TextWrapped = true
	label.RichText = true
	label.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Heavy)
	label.TextColor3 = color(options.TextColor or B.Palette.White)
	label.Parent = gui
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.04, 0)
	padding.PaddingRight = UDim.new(0.04, 0)
	padding.PaddingTop = UDim.new(0.08, 0)
	padding.PaddingBottom = UDim.new(0.08, 0)
	padding.Parent = label
	return label
end

-- A sign board (front faces cf.LookVector) with text.
function B.Sign(parent: Instance, name: string, cf: CFrame, width: number, height: number, text: string, bg, fg)
	local board = B.Part(parent, { Name = name, Size = Vector3.new(width, height, 0.4), CFrame = cf, Color = bg or "#264653", Material = Enum.Material.SmoothPlastic })
	B.Text(board, Enum.NormalId.Front, text, { TextColor = fg })
	return board
end

-- A sign on two posts, standing on the ground at cf.
function B.PostSign(parent: Instance, name: string, cf: CFrame, width: number, text: string, bg, fg)
	local model = B.Model(parent, name)
	for _, side in ipairs({ -1, 1 }) do
		B.Block(model, "Post", cf * CFrame.new(side * (width / 2 - 0.3), 0, 0), 0.4, 6, 0.4, B.Palette.DarkWood, Enum.Material.Wood)
	end
	B.Sign(model, "Board", cf * CFrame.new(0, 5, -0.25), width, 2.4, text, bg, fg)
	return model
end

-- ===== Ground and roads =====
function B.Slab(parent: Instance, name: string, x: number, z: number, sx: number, sz: number, top: number, col, material, thickness: number?)
	local t = thickness or 1
	return B.Part(parent, { Name = name, Size = Vector3.new(sx, t, sz), CFrame = CFrame.new(x, top - t / 2, z), Color = col, Material = material or Enum.Material.SmoothPlastic })
end

-- Straight road from (x1, z1) to (x2, z2) along one axis, with a centre line.
function B.Road(parent: Instance, x1: number, z1: number, x2: number, z2: number, width: number, top: number)
	local model = B.Model(parent, "Road")
	local horizontal = z1 == z2
	local length = if horizontal then math.abs(x2 - x1) else math.abs(z2 - z1)
	local cx, cz = (x1 + x2) / 2, (z1 + z2) / 2
	local sx, sz = if horizontal then length else width, if horizontal then width else length
	B.Slab(model, "Asphalt", cx, cz, sx, sz, top, B.Palette.Asphalt, Enum.Material.Asphalt, 0.4)
	local lx, lz = if horizontal then length - 8 else 0.6, if horizontal then 0.6 else length - 8
	B.Slab(model, "CentreLine", cx, cz, lx, lz, top + 0.02, B.Palette.Line, Enum.Material.SmoothPlastic, 0.05)
	return model
end

-- ===== Nature and street furniture =====
function B.Tree(parent: Instance, position: Vector3, scale: number?, style: string?)
	local s = scale or 1
	local model = B.Model(parent, "Tree")
	local base = CFrame.new(position)
	if style == "Palm" then
		B.Cylinder(model, "Trunk", base, 1.2 * s, 14 * s, "#8D6E63", Enum.Material.Wood)
		B.Ball(model, "Leaves", position + Vector3.new(0, 14.5 * s, 0), 7 * s, "#4CAF50", Enum.Material.Grass, { CanCollide = false })
	elseif style == "Pine" then
		B.Cylinder(model, "Trunk", base, 1.4 * s, 6 * s, B.Palette.Trunk, Enum.Material.Wood)
		B.Ball(model, "Leaves", position + Vector3.new(0, 7 * s, 0), 8 * s, "#2E7D32", Enum.Material.Grass, { CanCollide = false })
		B.Ball(model, "Top", position + Vector3.new(0, 11 * s, 0), 5 * s, "#388E3C", Enum.Material.Grass, { CanCollide = false })
	else
		B.Cylinder(model, "Trunk", base, 1.6 * s, 7 * s, B.Palette.Trunk, Enum.Material.Wood)
		B.Ball(model, "Leaves", position + Vector3.new(0, 9 * s, 0), 9 * s, if (position.X + position.Z) % 2 < 1 then B.Palette.Leaves else B.Palette.LeavesLight, Enum.Material.Grass, { CanCollide = false })
	end
	return model
end

function B.Lamp(parent: Instance, position: Vector3)
	local model = B.Model(parent, "Lamp")
	B.Cylinder(model, "Pole", CFrame.new(position), 0.6, 12, B.Palette.Black, Enum.Material.Metal)
	local head = B.Part(model, { Name = "Head", Size = Vector3.new(1.6, 1, 1.6), CFrame = CFrame.new(position + Vector3.new(0, 12.5, 0)), Color = "#FFF3C4", Material = Enum.Material.SmoothPlastic, CanCollide = false, Tag = "CYL_Lamp" })
	local light = Instance.new("PointLight")
	light.Name = "Light"
	light.Range = 18
	light.Brightness = 1.6
	light.Color = color("#FFD99A")
	light.Shadows = false
	light.Enabled = false
	light.Parent = head
	return model
end

-- A bench you can sit on (Seat). Faces cf.LookVector.
function B.Bench(parent: Instance, cf: CFrame)
	local model = B.Model(parent, "Bench")
	B.Part(model, { Name = "Seat", Class = "Seat", Size = Vector3.new(5, 0.6, 1.8), CFrame = cf * CFrame.new(0, 1.6, 0), Color = B.Palette.Wood, Material = Enum.Material.Wood, Tag = "CYL_Seat" })
	B.Part(model, { Name = "Back", Size = Vector3.new(5, 2, 0.4), CFrame = cf * CFrame.new(0, 2.9, 0.8), Color = B.Palette.Wood, Material = Enum.Material.Wood })
	B.Block(model, "Legs", cf * CFrame.new(0, 0, 0), 4.4, 1.3, 1.2, B.Palette.Black, Enum.Material.Metal)
	return model
end

function B.Hedge(parent: Instance, cf: CFrame, sx: number, sz: number, height: number?)
	return B.Block(parent, "Hedge", cf, sx, height or 3, sz, B.Palette.DarkGrass, Enum.Material.Grass)
end

function B.Flowerbed(parent: Instance, cf: CFrame, sx: number, sz: number)
	local model = B.Model(parent, "Flowerbed")
	B.Block(model, "Soil", cf, sx, 0.8, sz, "#5D4037", Enum.Material.Ground)
	local colours = { "#FF6B6B", "#FFD93D", "#C77DFF", "#FF9F1C" }
	local n = math.max(2, math.floor(sx * sz / 18))
	for i = 1, math.min(n, 6) do
		local fx = ((i * 37) % 10) / 10 - 0.5
		local fz = ((i * 53) % 10) / 10 - 0.5
		B.Ball(model, "Flower", (cf * CFrame.new(fx * (sx - 1), 1.2, fz * (sz - 1))).Position, 1.2, colours[(i - 1) % #colours + 1], Enum.Material.SmoothPlastic, { CanCollide = false })
	end
	return model
end

function B.Fountain(parent: Instance, position: Vector3, diameter: number?)
	local d = diameter or 18
	local model = B.Model(parent, "Fountain")
	local base = CFrame.new(position)
	B.Cylinder(model, "Basin", base, d, 2.4, B.Palette.Stone, Enum.Material.Marble)
	B.Cylinder(model, "Water", base * CFrame.new(0, 0.6, 0), d - 2, 2, B.Palette.Water, Enum.Material.Glass, { Transparency = 0.25, CanCollide = false })
	B.Cylinder(model, "Pillar", base, 2.4, 7, B.Palette.Stone, Enum.Material.Marble)
	local bowl = B.Cylinder(model, "Bowl", base * CFrame.new(0, 7, 0), 7, 1, B.Palette.Stone, Enum.Material.Marble)
	local spray = Instance.new("ParticleEmitter")
	spray.Name = "Spray"
	spray.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	spray.Color = ColorSequence.new(color("#E0F7FF"))
	spray.Size = NumberSequence.new(0.6)
	spray.Lifetime = NumberRange.new(0.8, 1.4)
	spray.Rate = 40
	spray.Speed = NumberRange.new(8, 12)
	spray.SpreadAngle = Vector2.new(25, 25)
	spray.Acceleration = Vector3.new(0, -30, 0)
	spray.Parent = bowl
	return model
end

-- ===== Vehicles =====
local CAR_SHAPES = {
	Hatch = { Length = 9, Width = 4.6, Body = 2.2, Cabin = 2, CabinLength = 5, CabinOffset = 0.6 },
	SUV = { Length = 10, Width = 5, Body = 2.8, Cabin = 2.4, CabinLength = 6.5, CabinOffset = 0.8 },
	Pickup = { Length = 11, Width = 5, Body = 2.6, Cabin = 2.4, CabinLength = 4, CabinOffset = -2 },
	Van = { Length = 11, Width = 5, Body = 3.2, Cabin = 3, CabinLength = 9, CabinOffset = 0.5 },
	Vintage = { Length = 10, Width = 4.6, Body = 2.2, Cabin = 1.8, CabinLength = 4.5, CabinOffset = 1 },
	Super = { Length = 10, Width = 5, Body = 1.6, Cabin = 1.4, CabinLength = 4, CabinOffset = 0.8 },
	Moto = { Length = 5, Width = 1.4, Body = 1.8, Cabin = 0, CabinLength = 0, CabinOffset = 0 },
}
B.CarShapes = CAR_SHAPES

-- A simple car (body, cabin, wheels, lights). Faces cf.LookVector.
function B.Car(parent: Instance, cf: CFrame, bodyColour, shape: string?)
	local s = CAR_SHAPES[shape or "Hatch"] or CAR_SHAPES.Hatch
	local model = B.Model(parent, "Car")
	local wheelSize = if shape == "Moto" then 2.2 else 2
	B.Block(model, "Body", cf * CFrame.new(0, wheelSize * 0.45, 0), s.Width, s.Body, s.Length, bodyColour or "#E63946", Enum.Material.SmoothPlastic, { CastShadow = true })
	if s.Cabin > 0 then
		B.Block(model, "Cabin", cf * CFrame.new(0, wheelSize * 0.45 + s.Body, s.CabinOffset), s.Width - 0.6, s.Cabin, s.CabinLength, "#BFE3F7", Enum.Material.Glass, { Transparency = 0.15 })
	end
	local wx = s.Width / 2 - 0.2
	local wz = s.Length / 2 - 1.6
	local wheels = if shape == "Moto" then { { 0, wz }, { 0, -wz } } else { { -wx, wz }, { wx, wz }, { -wx, -wz }, { wx, -wz } }
	for _, w in ipairs(wheels) do
		B.Part(model, { Name = "Wheel", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.9, wheelSize, wheelSize), CFrame = cf * CFrame.new(w[1], wheelSize / 2, w[2]), Color = B.Palette.Black, Material = Enum.Material.SmoothPlastic, CanCollide = false })
	end
	if shape ~= "Moto" then
		for _, side in ipairs({ -1, 1 }) do
			B.Part(model, { Name = "Headlight", Size = Vector3.new(0.8, 0.5, 0.2), CFrame = cf * CFrame.new(side * (s.Width / 2 - 0.7), wheelSize * 0.45 + s.Body * 0.6, -s.Length / 2 - 0.05), Color = "#FFF8D6", Material = Enum.Material.Neon, CanCollide = false })
		end
	end
	model.PrimaryPart = model:FindFirstChild("Body")
	return model
end

function B.Boat(parent: Instance, cf: CFrame, length: number, hullColour, big: boolean?)
	local model = B.Model(parent, "Boat")
	local width = length * 0.36
	B.Block(model, "Hull", cf, width, 2.4, length * 0.75, hullColour or B.Palette.White, Enum.Material.SmoothPlastic)
	B.Part(model, { Name = "Bow", Class = "WedgePart", Size = Vector3.new(width, 2.4, length * 0.25), CFrame = cf * CFrame.new(0, 1.2, -length * 0.5), Color = hullColour or B.Palette.White })
	B.Block(model, "Cabin", cf * CFrame.new(0, 2.4, length * 0.1), width * 0.7, if big then 4 else 2.4, length * 0.3, "#ECEFF1", Enum.Material.SmoothPlastic)
	if not big then
		B.Cylinder(model, "Mast", cf * CFrame.new(0, 2.4, -length * 0.15), 0.4, length * 0.7, B.Palette.White, Enum.Material.Metal)
	end
	return model
end

-- ===== Furniture (positions are on the floor at cf; front faces cf.LookVector) =====
function B.Desk(parent: Instance, cf: CFrame, width: number?)
	local model = B.Model(parent, "Desk")
	local w = width or 4
	B.Block(model, "Top", cf * CFrame.new(0, 2.6, 0), w, 0.3, 2.4, B.Palette.Wood, Enum.Material.Wood)
	B.Block(model, "Legs", cf, w - 0.6, 2.6, 0.4, B.Palette.Metal, Enum.Material.Metal)
	return model
end

function B.Chair(parent: Instance, cf: CFrame, col)
	local model = B.Model(parent, "Chair")
	B.Part(model, { Name = "Seat", Class = "Seat", Size = Vector3.new(2, 0.4, 2), CFrame = cf * CFrame.new(0, 1.7, 0), Color = col or "#2A9D8F", Tag = "CYL_Seat" })
	B.Part(model, { Name = "Back", Size = Vector3.new(2, 2, 0.3), CFrame = cf * CFrame.new(0, 2.9, 0.85), Color = col or "#2A9D8F" })
	B.Block(model, "Leg", cf, 0.4, 1.5, 0.4, B.Palette.Metal, Enum.Material.Metal)
	return model
end

function B.Table(parent: Instance, cf: CFrame, sx: number?, sz: number?, col)
	local model = B.Model(parent, "Table")
	B.Block(model, "Top", cf * CFrame.new(0, 2.8, 0), sx or 4, 0.3, sz or 4, col or B.Palette.Wood, Enum.Material.Wood)
	B.Block(model, "Leg", cf, 0.6, 2.8, 0.6, B.Palette.DarkWood, Enum.Material.Wood)
	return model
end

function B.Counter(parent: Instance, cf: CFrame, length: number, col)
	local model = B.Model(parent, "Counter")
	B.Block(model, "Body", cf, length, 3.2, 2, col or "#6D4C41", Enum.Material.Wood)
	B.Block(model, "Top", cf * CFrame.new(0, 3.2, 0), length + 0.4, 0.3, 2.4, "#ECEFF1", Enum.Material.Marble)
	return model
end

function B.Shelf(parent: Instance, cf: CFrame, width: number?)
	local model = B.Model(parent, "Shelf")
	local w = width or 6
	B.Block(model, "Frame", cf, w, 8, 1.4, B.Palette.DarkWood, Enum.Material.Wood)
	local colours = { "#E63946", "#457B9D", "#F4A261", "#2A9D8F" }
	for row = 1, 3 do
		B.Block(model, "Books", cf * CFrame.new(0, row * 2.3 - 1, -0.6), w - 0.8, 1.4, 0.3, colours[row], Enum.Material.SmoothPlastic, { CanCollide = false })
	end
	return model
end

function B.Bed(parent: Instance, cf: CFrame, col)
	local model = B.Model(parent, "Bed")
	B.Block(model, "Frame", cf, 4.4, 1.6, 8, B.Palette.DarkWood, Enum.Material.Wood)
	B.Block(model, "Mattress", cf * CFrame.new(0, 1.6, 0), 4, 0.8, 7.6, col or "#E0E7FF", Enum.Material.Fabric)
	B.Block(model, "Pillow", cf * CFrame.new(0, 2.4, 3), 3, 0.6, 1.4, B.Palette.White, Enum.Material.Fabric, { CanCollide = false })
	return model
end

function B.Sofa(parent: Instance, cf: CFrame, col)
	local model = B.Model(parent, "Sofa")
	local c = col or "#577590"
	B.Part(model, { Name = "Seat", Class = "Seat", Size = Vector3.new(6, 1.2, 2.6), CFrame = cf * CFrame.new(0, 1.2, 0), Color = c, Material = Enum.Material.Fabric, Tag = "CYL_Seat" })
	B.Block(model, "Base", cf, 6, 0.6, 2.6, c, Enum.Material.Fabric)
	B.Block(model, "Back", cf * CFrame.new(0, 0.6, 1.1), 6, 3, 0.6, c, Enum.Material.Fabric)
	return model
end

function B.Plant(parent: Instance, cf: CFrame)
	local model = B.Model(parent, "Plant")
	B.Cylinder(model, "Pot", cf, 1.6, 1.4, "#A1887F", Enum.Material.SmoothPlastic)
	B.Ball(model, "Leaves", (cf * CFrame.new(0, 2.6, 0)).Position, 2.6, B.Palette.Leaves, Enum.Material.Grass, { CanCollide = false })
	return model
end

-- A wall board/screen with text facing cf.LookVector (bottom at cf).
function B.Board(parent: Instance, cf: CFrame, width: number, height: number, text: string, bg, fg)
	local board = B.Part(parent, { Name = "Board", Size = Vector3.new(width, height, 0.3), CFrame = cf * CFrame.new(0, height / 2, 0), Color = bg or "#2D4739", Material = Enum.Material.SmoothPlastic, CanCollide = false })
	B.Text(board, Enum.NormalId.Front, text, { TextColor = fg or "#F1FAEE", PixelsPerStud = 24 })
	return board
end

-- ===== Buildings =====
--[[
	B.Building(parent, {
		Name, CFrame (ground centre, front = LookVector), Width, Depth, Height,
		Wall, Trim, Roof = hex, RoofStyle = "Flat" | "Pitched",
		DoorWidth (8), DoorHeight (9), DoorOffset (0), AutoDoor (true),
		Sign = "text", SignColor, Floors (visual window rows, 1),
		Floor = hex, FloorMaterial, Light = true,
	})
	Returns model, plus `inside(x, y, z, yaw)` -> CFrame helper in the building's
	local space (origin on the floor at the centre, -Z towards the door).
]]
function B.Building(parent: Instance, spec)
	local model = B.Model(parent, spec.Name)
	model:SetAttribute("CYL_Building", spec.Name)
	local cf: CFrame = spec.CFrame
	local w, d, h = spec.Width, spec.Depth, spec.Height
	local t = 1
	local wall = spec.Wall or "#E9E4D8"
	local material = spec.WallMaterial or Enum.Material.SmoothPlastic
	local doorW, doorH = spec.DoorWidth or 8, spec.DoorHeight or 9
	local doorX = spec.DoorOffset or 0

	local floor = B.Block(model, "Floor", cf, w, 0.4, d, spec.Floor or "#D7CCC8", spec.FloorMaterial or Enum.Material.WoodPlanks)
	model.PrimaryPart = floor
	local base = cf * CFrame.new(0, 0.4, 0)
	local wallH = h - 0.4

	local function wallPart(name, sx, sy, sz, x, y, z)
		return B.Part(model, { Name = name, Size = Vector3.new(sx, sy, sz), CFrame = base * CFrame.new(x, y, z), Color = wall, Material = material, CastShadow = true })
	end
	-- Back and sides
	wallPart("BackWall", w, wallH, t, 0, wallH / 2, d / 2 - t / 2)
	wallPart("LeftWall", t, wallH, d - 2 * t, -w / 2 + t / 2, wallH / 2, 0)
	wallPart("RightWall", t, wallH, d - 2 * t, w / 2 - t / 2, wallH / 2, 0)
	-- Front wall with a doorway
	local leftEdge, rightEdge = -w / 2, w / 2
	local doorL, doorR = doorX - doorW / 2, doorX + doorW / 2
	local frontZ = -d / 2 + t / 2
	if doorL - leftEdge > 0.05 then
		wallPart("FrontWallL", doorL - leftEdge, wallH, t, (leftEdge + doorL) / 2, wallH / 2, frontZ)
	end
	if rightEdge - doorR > 0.05 then
		wallPart("FrontWallR", rightEdge - doorR, wallH, t, (doorR + rightEdge) / 2, wallH / 2, frontZ)
	end
	if wallH - doorH > 0.05 then
		wallPart("FrontWallTop", doorW, wallH - doorH, t, doorX, doorH + (wallH - doorH) / 2, frontZ)
	end

	-- Sliding door panels (animated by the client; never collide).
	if spec.AutoDoor ~= false then
		for _, side in ipairs({ -1, 1 }) do
			local panel = B.Part(model, { Name = "DoorPanel", Size = Vector3.new(doorW / 2, doorH, 0.3), CFrame = base * CFrame.new(doorX + side * doorW / 4, doorH / 2, frontZ - 0.2), Color = "#BFE3F7", Material = Enum.Material.Glass, Transparency = 0.35, CanCollide = false, Tag = "CYL_Door" })
			panel:SetAttribute("SlideX", side * (doorW / 2 - 0.2))
		end
	end

	-- Windows (glow at night): rows on the sides and back.
	local floors = spec.Floors or 1
	local rowH = wallH / floors
	local function windowsAlong(face: string, length: number)
		local count = math.max(1, math.floor(length / 10))
		for f = 1, floors do
			local y = (f - 1) * rowH + rowH * 0.58
			for i = 1, count do
				local along = -length / 2 + (i - 0.5) * (length / count)
				local cfw
				if face == "Back" then
					cfw = base * CFrame.new(along, y, d / 2 + 0.05)
				elseif face == "Left" then
					cfw = base * CFrame.new(-w / 2 - 0.05, y, along) * CFrame.Angles(0, math.rad(90), 0)
				elseif face == "Right" then
					cfw = base * CFrame.new(w / 2 + 0.05, y, along) * CFrame.Angles(0, math.rad(90), 0)
				else
					if math.abs(along - doorX) < doorW / 2 + 3 and f == 1 then
						continue
					end
					cfw = base * CFrame.new(along, y, -d / 2 - 0.05)
				end
				B.Part(model, { Name = "Window", Size = Vector3.new(math.min(5, length / count - 2), math.min(4, rowH * 0.5), 0.2), CFrame = cfw, Color = B.Palette.Glass, Material = Enum.Material.Glass, Transparency = 0.2, CanCollide = false, Tag = "CYL_Window" })
			end
		end
	end
	if spec.Windows ~= false then
		windowsAlong("Front", w)
		windowsAlong("Back", w)
		windowsAlong("Left", d)
		windowsAlong("Right", d)
	end

	-- Roof
	local roofColour = spec.Roof or "#5C5C5C"
	if spec.RoofStyle == "Pitched" then
		local rise = math.min(w, d) * 0.35
		for _, side in ipairs({ -1, 1 }) do
			B.Part(model, { Name = "Roof", Class = "WedgePart", Size = Vector3.new(d + 2, rise, w / 2 + 1), CFrame = base * CFrame.new(side * (w / 4 + 0.5), wallH + rise / 2, 0) * CFrame.Angles(0, math.rad(-side * 90), 0), Color = roofColour, Material = Enum.Material.Slate, CastShadow = true })
		end
	else
		B.Part(model, { Name = "Roof", Size = Vector3.new(w + 1.4, 1, d + 1.4), CFrame = base * CFrame.new(0, wallH + 0.5, 0), Color = roofColour, Material = Enum.Material.Concrete, CastShadow = true })
	end

	-- Sign above the door
	if spec.Sign then
		B.Sign(model, "Sign", base * CFrame.new(doorX, math.min(wallH - 1.2, doorH + 2.2), -d / 2 - 0.35), math.min(w - 2, math.max(16, #spec.Sign * 1.1)), 3, spec.Sign, spec.SignColor or "#264653", spec.SignText)
	end

	-- Ceiling light
	if spec.Light ~= false then
		local lamp = B.Part(model, { Name = "CeilingLight", Size = Vector3.new(3, 0.3, 3), CFrame = base * CFrame.new(0, wallH - 0.3, 0), Color = "#FFF8E1", Material = Enum.Material.Neon, CanCollide = false })
		local light = Instance.new("PointLight")
		light.Name = "Light"
		light.Range = math.min(40, math.max(w, d) * 0.7)
		light.Brightness = 1.4
		light.Shadows = false
		light.Parent = lamp
	end

	local function inside(x: number, y: number, z: number, yaw: number?): CFrame
		return base * CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(yaw or 0), 0)
	end
	return model, inside
end

-- ===== Gameplay markers =====
-- An interaction spot: invisible part + ProximityPrompt for WorldSpots[id].
function B.Spot(parent: Instance, spotId: string, cf: CFrame, holdDuration: number?)
	local def = WorldSpots.Get(spotId)
	assert(def, "Builder.Spot: unknown spot " .. tostring(spotId))
	local part = B.Part(parent, { Name = "Spot_" .. spotId, Size = Vector3.new(1, 1, 1), CFrame = cf * CFrame.new(0, 2.5, 0), Transparency = 1, CanCollide = false, Tag = "CYL_Spot" })
	part.CanQuery = false
	part:SetAttribute("CYL_Spot", spotId)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "Prompt"
	prompt.ActionText = def.Label
	prompt.ObjectText = def.Object
	prompt.HoldDuration = holdDuration or (if def.Kind == "Open" then 0 else 0.4)
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt:SetAttribute("CYL_Spot", spotId)
	prompt.Parent = part
	return part
end

-- A Memory Star collectible (Data/Collectibles), floating above cf.
function B.Star(parent: Instance, starId: string, cf: CFrame)
	local star = B.Part(parent, { Name = starId, Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.6, 1.6), CFrame = cf * CFrame.new(0, 1.4, 0), Color = "#FFD60A", Material = Enum.Material.Neon, CanCollide = false, Tag = "CYL_Star" })
	star.CanQuery = false
	star:SetAttribute("CYL_Star", starId)
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Name = "Sparkle"
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Color = ColorSequence.new(color("#FFF3B0"))
	sparkle.Size = NumberSequence.new(0.35)
	sparkle.Lifetime = NumberRange.new(0.6, 1.2)
	sparkle.Rate = 8
	sparkle.Speed = NumberRange.new(0.5, 1.5)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.Parent = star
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "Prompt"
	prompt.ActionText = "Collect"
	prompt.ObjectText = "✨ Memory Star"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt:SetAttribute("CYL_Star", starId)
	prompt.Parent = star
	return star
end

-- Where an NPC stands (NPCService spawns the character here, facing cf.LookVector).
function B.NPC(anchors: Instance, npcId: string, cf: CFrame)
	local part = B.Part(anchors, { Name = npcId, Size = Vector3.new(1, 1, 1), CFrame = cf * CFrame.new(0, 0.5, 0), Transparency = 1, CanCollide = false })
	part.CanQuery = false
	return part
end

-- Walls of a locked area (the client turns them solid while it's locked for you).
function B.LockWall(parent: Instance, lockId: string, unlockStage: number, cf: CFrame, sx: number, sy: number, sz: number)
	local part = B.Part(parent, { Name = "Lock_" .. lockId, Size = Vector3.new(sx, sy, sz), CFrame = cf * CFrame.new(0, sy / 2, 0), Color = "#7B61FF", Material = Enum.Material.ForceField, Transparency = 1, CanCollide = false, Tag = "CYL_Lock" })
	part.CanQuery = false
	part:SetAttribute("LockId", lockId)
	part:SetAttribute("UnlockStage", unlockStage)
	return part
end

return B
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="90">
          <Properties>
            <string name="Name">Districts</string>
          </Properties>
          <Item class="ModuleScript" referent="91">
            <Properties>
              <string name="Name">CareerRow</string>
              <string name="Source"><![CDATA[--[[
	CareerRow  (ServerScriptService.Server.World.Districts.CareerRow)
	Opens at Young Adulthood. The workplaces along one street: the police
	station, Starlight Studios & Theatre and the science lab (north side),
	the courthouse, the workshop and the town hall (south side).
]]

return function(B, ctx)
	local f = ctx.Folder
	B.Slab(f, "Street", ctx.Pos(0, 0).X, ctx.Pos(0, 0).Z, 132, 28, 0.16, "#CFC6B8", Enum.Material.Pavement, 0.1)

	-- ===== North side (facing south) =====
	local police, pIn = B.Building(f, {
		Name = "Police Station", CFrame = ctx.At(-44, -36, 180), Width = 34, Depth = 28, Height = 16,
		Wall = "#1D3557", Roof = "#0B132B", Floor = "#ADB5BD", FloorMaterial = Enum.Material.Concrete,
		Sign = "👮 POLICE STATION", SignColor = "#457B9D",
	})
	B.Counter(police, pIn(0, 0, 2), 10, "#1D3557")
	B.NPC(ctx.NPCs, "Officer", pIn(0, 0, 4.5))
	B.Spot(police, "Police_Watch", pIn(0, 0, -1.5))
	for _, x in ipairs({ -14, -11.5, -9 }) do
		B.Block(police, "Locker", pIn(x, 0, 12.1), 2.2, 7, 1.6, "#6C757D", Enum.Material.Metal)
	end
	B.Spot(police, "Police_Shift", pIn(-11.5, 0, 8))
	B.Car(f, ctx.At(-44, -17, -90), "#F8F9FA", "Hatch")

	local studio, sIn = B.Building(f, {
		Name = "Starlight Studios", CFrame = ctx.At(0, -36, 180), Width = 36, Depth = 30, Height = 20,
		Wall = "#240046", Roof = "#10002B", Floor = "#3C096C", FloorMaterial = Enum.Material.Carpet,
		Sign = "⭐ STARLIGHT STUDIOS & THEATRE", SignColor = "#7209B7",
	})
	B.Block(studio, "Stage", sIn(2, 0, 10.5), 22, 2, 7, "#5A189A", Enum.Material.WoodPlanks)
	B.Board(studio, sIn(2, 2, 13.8), 20, 7, "✨ OPEN-MIC NIGHT ✨", "#10002B", "#FFD60A")
	for _, z in ipairs({ -2, 2 }) do
		for _, x in ipairs({ -6, -2, 2, 6, 10 }) do
			B.Chair(studio, sIn(x, 0, z, 180), "#9D0208")
		end
	end
	B.Spot(studio, "Theatre_Watch", sIn(2, 0, -7))
	B.Spot(studio, "Studio_OpenMic", sIn(8, 0, 6))
	B.Block(studio, "RecordingBooth", sIn(-13, 0, 9), 8, 9, 8, "#BFE3F7", Enum.Material.Glass, { Transparency = 0.5, CanCollide = false })
	B.Spot(studio, "Studio_Shift", sIn(-13, 0, 3))
	B.NPC(ctx.NPCs, "Director", sIn(-6, 0, 6))

	local lab, lIn = B.Building(f, {
		Name = "Science Lab", CFrame = ctx.At(44, -36, 180), Width = 34, Depth = 28, Height = 16,
		Wall = "#E0FBFC", Roof = "#3D5A80", Floor = "#F8F9FA", FloorMaterial = Enum.Material.Marble,
		Sign = "🔬 SCIENCE LAB", SignColor = "#3D5A80",
	})
	for _, z in ipairs({ 3, 9 }) do
		B.Counter(lab, lIn(7, 0, z), 12, "#ECEFF1")
		for i = 1, 3 do
			B.Ball(lab, "Flask", (lIn(2 + i * 3, 3.9, z)).Position, 0.9, ({ "#80FFDB", "#F72585", "#FFD60A" })[i], Enum.Material.Neon, { CanCollide = false })
		end
	end
	B.Spot(lab, "Lab_Shift", lIn(7, 0, 0))
	B.NPC(ctx.NPCs, "Scientist", lIn(3, 0, 6))
	B.Cylinder(lab, "RocketBody", lIn(-10, 0, 6), 3, 9, "#F8F9FA", Enum.Material.Metal)
	B.Ball(lab, "RocketTip", (lIn(-10, 9.6, 6)).Position, 3, "#E63946", Enum.Material.SmoothPlastic)
	B.Board(lab, lIn(-10, 1, -2, 0), 8, 3, "🚀 SPACE & SCIENCE EXHIBIT", "#3D5A80")
	B.Spot(lab, "Lab_Exhibit", lIn(-10, 0, -6))

	-- ===== South side (facing north) =====
	local court, cIn = B.Building(f, {
		Name = "Courthouse", CFrame = ctx.At(-44, 36, 0), Width = 34, Depth = 26, Height = 18,
		Wall = "#E9E4D8", WallMaterial = Enum.Material.Limestone, Roof = "#6C757D", Floor = "#6F4E37", FloorMaterial = Enum.Material.WoodPlanks,
		Sign = "⚖️ COURTHOUSE", SignColor = "#6C757D",
	})
	for _, x in ipairs({ -12, -4, 4, 12 }) do
		B.Cylinder(f, "Column", ctx.At(-44 + x, 21.5), 2, 15, "#F8F9FA", Enum.Material.Marble)
	end
	B.Block(court, "JudgesBench", cIn(0, 0, 8.5), 12, 4.5, 2.5, "#4E342E", Enum.Material.Wood)
	B.NPC(ctx.NPCs, "Judge", cIn(0, 0, 10.8))
	for _, z in ipairs({ -6, -2 }) do
		B.Bench(court, cIn(-6, 0, z, 180))
	end
	B.Spot(court, "Court_Watch", cIn(-6, 0, -9))
	B.Table(court, cIn(7, 0, 3), 6, 3, "#6D4C41")
	B.Spot(court, "Court_Shift", cIn(7, 0, -1))

	local shop, wIn = B.Building(f, {
		Name = "Workshop", CFrame = ctx.At(0, 36, 0), Width = 30, Depth = 24, Height = 14,
		Wall = "#6C757D", WallMaterial = Enum.Material.CorrodedMetal, Roof = "#343A40", Floor = "#495057", FloorMaterial = Enum.Material.Concrete,
		Sign = "🔧 WORKSHOP", SignColor = "#F77F00",
	})
	B.Counter(shop, wIn(-6, 0, 6), 10, "#8D6E63")
	B.Block(shop, "Toolboard", wIn(-6, 3, 10.6), 10, 4, 0.3, "#3E2723", Enum.Material.Wood, { CanCollide = false })
	B.Spot(shop, "Workshop_Class", wIn(-6, 0, 2.5))
	B.Block(shop, "Generator", wIn(8, 0, 6), 5, 4, 4, "#F77F00", Enum.Material.Metal)
	B.Spot(shop, "Workshop_Shift", wIn(8, 0, 1))
	B.NPC(ctx.NPCs, "Builder", wIn(0, 0, 4))

	local hall, hIn = B.Building(f, {
		Name = "Town Hall", CFrame = ctx.At(44, 36, 0), Width = 34, Depth = 28, Height = 20,
		Wall = "#F1FAEE", WallMaterial = Enum.Material.Marble, Roof = "#457B9D", Floor = "#E9ECEF", FloorMaterial = Enum.Material.Marble,
		Sign = "🏛️ TOWN HALL", SignColor = "#1D3557",
	})
	B.Block(f, "ClockTower", ctx.At(44, 40, 0, 20.5), 8, 14, 8, "#F1FAEE", Enum.Material.Marble)
	B.Sign(f, "Clock", ctx.At(44, 35.7, 0, 30), 5, 5, "🕰️", "#1D3557")
	B.Counter(hall, hIn(0, 0, 4), 12, "#1D3557")
	B.NPC(ctx.NPCs, "Clerk", hIn(0, 0, 6.5))
	B.Spot(hall, "TownHall_Volunteer", hIn(0, 0, 0))
	for _, x in ipairs({ -12, 12 }) do
		B.Cylinder(hall, "FlagPole", hIn(x, 0, 10), 0.4, 10, "#ADB5BD", Enum.Material.Metal)
		B.Part(hall, { Name = "Flag", Size = Vector3.new(3, 2, 0.1), CFrame = hIn(x + 1.6, 9, 10), Color = "#E63946", CanCollide = false })
	end

	-- Street furniture
	for _, x in ipairs({ -60, -22, 22, 60 }) do
		B.Lamp(f, ctx.Pos(x, -11, 0.16))
		B.Lamp(f, ctx.Pos(x, 11, 0.16))
	end
	for _, x in ipairs({ -22, 22 }) do
		B.Bench(f, ctx.At(x + 6, -10, 180, 0.16))
		B.Bench(f, ctx.At(x - 6, 10, 0, 0.16))
	end
	for _, p in ipairs({ { -64, -64 }, { 64, -64 }, { -64, 64 }, { 64, 64 } }) do
		B.Tree(f, ctx.Pos(p[1], p[2], 0.1), 0.9)
	end
	B.PostSign(f, "CareerRowSign", ctx.At(-66, 0, 90), 12, "💼 Career Row", "#F77F00")

	-- Memory Stars
	B.Star(f, "Star_ClockTower", ctx.At(44, 54))
	B.Star(studio, "Star_Booth", sIn(-13, 0, 10))
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="92">
            <Properties>
              <string name="Name">Downtown</string>
              <string name="Source"><![CDATA[--[[
	Downtown  (ServerScriptService.Server.World.Districts.Downtown)
	Opens in the Teenage Years. A pedestrian high street with Lifeville Tower
	(offices, reception, careers fair) at the north end, the bank, the Golden
	Fork restaurant and the café on the west side, and Starlight Cinema &
	Arcade and the boutique on the east side.
]]

return function(B, ctx)
	local f = ctx.Folder

	-- High street paving
	B.Slab(f, "HighStreet", ctx.Pos(0, 4).X, ctx.Pos(0, 4).Z, 18, 128, 0.16, "#CFC6B8", Enum.Material.Pavement, 0.1)

	-- Lifeville Tower (north end, facing south)
	local tower, tIn = B.Building(f, {
		Name = "Lifeville Tower", CFrame = ctx.At(0, -46, 180), Width = 36, Depth = 30, Height = 64, Floors = 6,
		Wall = "#6C8EAD", WallMaterial = Enum.Material.Glass, Roof = "#2B2D42", Floor = "#E5E5E5", FloorMaterial = Enum.Material.Marble,
		DoorWidth = 10, DoorHeight = 10, Sign = "LIFEVILLE TOWER", SignColor = "#2B2D42",
	})
	B.Counter(tower, tIn(0, 0, 2), 10, "#2B2D42")
	B.NPC(ctx.NPCs, "Receptionist", tIn(0, 0, 4.5))
	for _, x in ipairs({ -12, -4, 4, 12 }) do
		B.Desk(tower, tIn(x, 0, 10), 5)
		B.Chair(tower, tIn(x, 0, 12.4, 0), "#2B2D42")
		B.Block(tower, "Monitor", tIn(x, 2.9, 9.8), 2.4, 1.6, 0.2, "#111111", Enum.Material.Neon, { CanCollide = false })
	end
	B.Spot(tower, "Office_Shift", tIn(-8, 0, 7))
	B.Table(tower, tIn(12, 0, -8), 6, 3, "#E63946")
	B.Board(tower, tIn(12, 3, -4.6), 8, 3, "🧑‍💼 CAREERS FAIR", "#E63946")
	B.Spot(tower, "Office_Fair", tIn(12, 0, -11.5))
	B.Plant(tower, tIn(-15, 0, -12))

	-- West side (facing east): bank, restaurant, café
	local bank, bIn = B.Building(f, {
		Name = "Lifeville Bank", CFrame = ctx.At(-30, -16, -90), Width = 24, Depth = 22, Height = 16,
		Wall = "#E9ECEF", WallMaterial = Enum.Material.Marble, Roof = "#14213D", Floor = "#F8F9FA", FloorMaterial = Enum.Material.Marble,
		Sign = "🏦 LIFEVILLE BANK", SignColor = "#14213D",
	})
	B.Counter(bank, bIn(0, 0, 3), 12, "#14213D")
	B.NPC(ctx.NPCs, "Banker", bIn(0, 0, 5.5))
	B.Spot(bank, "Bank_Open", bIn(0, 0, 0))
	B.Block(bank, "Vault", bIn(0, 0, 8.6), 6, 7, 1, "#ADB5BD", Enum.Material.DiamondPlate)

	local rest, rIn = B.Building(f, {
		Name = "The Golden Fork", CFrame = ctx.At(-30, 14, -90), Width = 28, Depth = 24, Height = 14,
		Wall = "#BC4749", WallMaterial = Enum.Material.Brick, Roof = "#386641", Floor = "#6F4E37", FloorMaterial = Enum.Material.WoodPlanks,
		Sign = "🍝 THE GOLDEN FORK", SignColor = "#386641",
	})
	for _, p in ipairs({ { -8, -3 }, { 0, -3 }, { 8, -3 } }) do
		B.Table(rest, rIn(p[1], 0, p[2]), 4, 4, "#FFFFFF")
		B.Chair(rest, rIn(p[1], 0, p[2] - 3, 180), "#BC4749")
		B.Chair(rest, rIn(p[1], 0, p[2] + 3, 0), "#BC4749")
	end
	B.Spot(rest, "Restaurant_Eat", rIn(-4, 0, -6))
	B.Table(rest, rIn(-7, 0, 6), 9, 4, "#FFF3B0")
	B.Spot(rest, "Restaurant_Treat", rIn(-7, 0, 3))
	B.Counter(rest, rIn(7, 0, 9), 10, "#ADB5BD")
	B.Spot(rest, "Restaurant_Shift", rIn(7, 0, 6))
	B.NPC(ctx.NPCs, "Waiter", rIn(1, 0, 3))

	local cafe, cIn = B.Building(f, {
		Name = "Lifeville Café", CFrame = ctx.At(-30, 44, -90), Width = 22, Depth = 22, Height = 12,
		Wall = "#DDA15E", WallMaterial = Enum.Material.WoodPlanks, Roof = "#606C38", Floor = "#BC6C25", FloorMaterial = Enum.Material.WoodPlanks,
		Sign = "☕ CAFÉ", SignColor = "#606C38",
	})
	B.Counter(cafe, cIn(0, 0, 6), 10, "#283618")
	B.NPC(ctx.NPCs, "Barista", cIn(0, 0, 8.5))
	for _, x in ipairs({ -6, 6 }) do
		B.Table(cafe, cIn(x, 0, -3), 3, 3)
		B.Chair(cafe, cIn(x - 2.4, 0, -3, -90), "#606C38")
		B.Chair(cafe, cIn(x + 2.4, 0, -3, 90), "#606C38")
	end
	B.Spot(cafe, "Cafe_Chat", cIn(0, 0, 1))

	-- East side (facing west): cinema & arcade, boutique
	local cinema, aIn = B.Building(f, {
		Name = "Starlight Cinema & Arcade", CFrame = ctx.At(32, -10, 90), Width = 34, Depth = 26, Height = 18,
		Wall = "#3A0CA3", Roof = "#240046", Floor = "#10002B", FloorMaterial = Enum.Material.Carpet,
		Sign = "🎬 STARLIGHT CINEMA & ARCADE", SignColor = "#7209B7",
	})
	B.Board(cinema, aIn(-6, 3, 11.8), 18, 8, "NOW SHOWING:\nThe Life You Chose", "#111111", "#FFD60A")
	for _, z in ipairs({ 2, 6 }) do
		for _, x in ipairs({ -12, -8, -4, 0 }) do
			B.Chair(cinema, aIn(x, 0, z, 180), "#9D0208")
		end
	end
	B.Spot(cinema, "Cinema_Watch", aIn(-6, 0, -2))
	for i, z in ipairs({ -8, -3, 2, 7 }) do
		local machine = B.Block(cinema, "ArcadeMachine", aIn(14, 0, z, 90), 3, 6, 2.4, "#111111", Enum.Material.SmoothPlastic)
		B.Part(cinema, { Name = "ArcadeScreen", Size = Vector3.new(2.4, 1.8, 0.2), CFrame = aIn(12.7, 4.4, z, 90), Color = ({ "#F72585", "#4CC9F0", "#FFD60A", "#80FFDB" })[i], Material = Enum.Material.Neon, CanCollide = false })
		machine:SetAttribute("Arcade", true)
	end
	B.Spot(cinema, "Arcade_Play", aIn(10, 0, -1))
	B.Block(cinema, "EsportsStage", aIn(8, 0, 9), 8, 1, 5, "#7209B7", Enum.Material.Neon)
	B.Spot(cinema, "Arcade_Shift", aIn(8, 1, 6))
	B.NPC(ctx.NPCs, "Usher", aIn(2, 0, -8))

	local boutique, sIn = B.Building(f, {
		Name = "The Boutique", CFrame = ctx.At(30, 28, 90), Width = 24, Depth = 22, Height = 14,
		Wall = "#FFAFCC", Roof = "#CDB4DB", Floor = "#FFF0F3", FloorMaterial = Enum.Material.Marble,
		Sign = "🛍️ THE BOUTIQUE", SignColor = "#B5179E",
	})
	for i, x in ipairs({ -7, 0, 7 }) do
		B.Block(boutique, "Rail", sIn(x, 0, 4), 5, 5, 0.4, "#ADB5BD", Enum.Material.Metal, { CanCollide = false })
		B.Block(boutique, "Clothes", sIn(x, 1.6, 4), 4.4, 2.6, 1.2, ({ "#F72585", "#4361EE", "#FFBE0B" })[i], Enum.Material.Fabric, { CanCollide = false })
	end
	B.Counter(boutique, sIn(-6, 0, -4), 6, "#B5179E")
	B.Spot(boutique, "Boutique_Shop", sIn(-6, 0, -7))
	B.Spot(boutique, "Boutique_Shift", sIn(6, 0, -3))
	B.NPC(ctx.NPCs, "Stylist", sIn(-6, 0, -1.6))

	-- Street furniture
	for _, z in ipairs({ -20, 0, 20, 40, 58 }) do
		B.Lamp(f, ctx.Pos(-10, z, 0.16))
		B.Lamp(f, ctx.Pos(10, z + 10, 0.16))
	end
	for _, z in ipairs({ -6, 30 }) do
		B.Bench(f, ctx.At(-6, z, -90, 0.16))
		B.Bench(f, ctx.At(6, z + 8, 90, 0.16))
	end
	for _, p in ipairs({ { -56, -56 }, { 56, -56 }, { -58, 62 }, { 58, 62 } }) do
		B.Tree(f, ctx.Pos(p[1], p[2], 0.1), 1)
	end
	B.Block(f, "ShelterBack", ctx.At(-12, 60.8), 8, 7, 0.4, "#BFE3F7", Enum.Material.Glass, { Transparency = 0.3 })
	B.Block(f, "ShelterRoof", ctx.At(-12, 62.2, 0, 7), 8.4, 0.4, 3.6, "#ADB5BD", Enum.Material.Metal)
	B.Bench(f, ctx.At(-12, 62.4, 180, 0.1))
	B.PostSign(f, "DowntownSign", ctx.At(0, 66, 180), 12, "🏙️ Downtown", "#2B2D42")

	-- Memory Stars
	B.Star(f, "Star_BusStop", ctx.At(-17, 62.4))
	B.Star(cinema, "Star_Arcade", aIn(11, 0, -11))
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="93">
            <Properties>
              <string name="Name">Harbour</string>
              <string name="Source"><![CDATA[--[[
	Harbour  (ServerScriptService.Server.World.Districts.Harbour)
	Harbour & Hilltop (opens in the Teenage Years), on the bay in the
	south-east of the island:
	  north-west  the harbour square: travel agent and ice-cream kiosk
	  north-east  Hilltop: a raised plateau with Hilltop Mansion and its pool
	  south-west  Lifeville Beach: umbrellas, towels, lifeguard tower
	  south-east  the bay (sea): the pier, moored boats and the lighthouse
	This district builds its own ground (part of it is water).
]]

return function(B, ctx)
	local f = ctx.Folder
	local d = ctx.District
	local function slab(name, x, z, sx, sz, top, colour, material)
		B.Slab(f, name, d.X + x, d.Z + z, sx, sz, top, colour, material, 0.3)
	end
	slab("HarbourSquare", -39, -39, 58, 58, 0.16, "#D9CBB0", Enum.Material.Pavement)
	slab("HilltopGrounds", 29, -39, 78, 58, 0.1, "#7FBF6A", Enum.Material.Grass)
	slab("Beach", -39, 29, 58, 78, 0.12, B.Palette.Sand, Enum.Material.Sand)

	-- ===== Hilltop =====
	local hilltop = 10.1
	B.Block(f, "Plateau", ctx.At(37, -38, 0, 0.1), 62, hilltop - 0.4, 48, "#8D7B68", Enum.Material.Slate)
	B.Block(f, "PlateauGrass", ctx.At(37, -38, 0, hilltop - 0.3), 62, 0.3, 48, "#6FBF5A", Enum.Material.Grass)
	B.Part(f, { Name = "Ramp", Class = "WedgePart", Size = Vector3.new(12, hilltop - 0.1, 30), CFrame = ctx.At(-9, -38, 90, (hilltop + 0.1) / 2), Color = "#8D7B68", Material = Enum.Material.Slate })
	for _, z in ipairs({ -45, -31 }) do
		B.Block(f, "GatePost", ctx.At(7, z, 0, hilltop), 1.4, 6, 1.4, "#F8F9FA", Enum.Material.Marble)
	end
	local mansion, mIn = B.Building(f, {
		Name = "Hilltop Mansion", CFrame = ctx.At(40, -38, 90, hilltop), Width = 34, Depth = 24, Height = 20, Floors = 2,
		Wall = "#FFF8E7", WallMaterial = Enum.Material.Marble, Roof = "#2B2D42", Floor = "#F3E9D2", FloorMaterial = Enum.Material.Marble,
		DoorWidth = 8, DoorHeight = 11, Sign = "HILLTOP MANSION", SignColor = "#2B2D42", SignText = "#FFD60A",
	})
	B.Sofa(mansion, mIn(-8, 0, 7, 0), "#9D0208")
	B.Block(mansion, "Piano", mIn(9, 0, 7), 5, 3.4, 4, "#111111", Enum.Material.SmoothPlastic)
	B.Table(mansion, mIn(0, 0, -3), 10, 4, "#6D4C41")
	B.Ball(mansion, "Chandelier", (mIn(0, 15, 0)).Position, 3, "#FFF3B0", Enum.Material.Neon, { CanCollide = false })
	B.NPC(ctx.NPCs, "Butler", ctx.At(24, -38, 90, hilltop))
	B.Block(f, "PoolRim", ctx.At(60, -38, 0, hilltop), 12, 0.5, 22, "#F8F9FA", Enum.Material.Marble)
	B.Block(f, "PoolWater", ctx.At(60, -38, 0, hilltop + 0.05), 10, 0.5, 20, "#4CC9F0", Enum.Material.Glass, { Transparency = 0.25, CanCollide = false })
	for _, p in ipairs({ { 14, -58 }, { 64, -58 }, { 14, -18 }, { 64, -17 } }) do
		B.Tree(f, ctx.Pos(p[1], p[2], hilltop), 1, "Palm")
	end

	-- ===== Harbour square =====
	local agent, tIn = B.Building(f, {
		Name = "Travel Agent", CFrame = ctx.At(-50, -50, 180), Width = 16, Depth = 12, Height = 10,
		Wall = "#90E0EF", Roof = "#023E8A", Floor = "#CAF0F8", DoorWidth = 6, Sign = "✈️ TRAVEL", SignColor = "#023E8A",
	})
	B.Counter(agent, tIn(0, 0, 2), 8, "#023E8A")
	B.Board(agent, tIn(0, 2, 4.8), 10, 3, "🌍 See the world!", "#0077B6")
	B.Spot(agent, "Harbour_Trip", tIn(0, 0, -1.5))
	B.Block(f, "IceCreamHut", ctx.At(-26, -32), 8, 7, 6, "#FFC8DD", Enum.Material.WoodPlanks)
	B.Part(f, { Name = "Awning", Class = "WedgePart", Size = Vector3.new(9, 1.6, 3), CFrame = ctx.At(-26, -27.6, 180, 7.4), Color = "#FF006E" })
	B.Sign(f, "IceCreamSign", ctx.At(-26, -28.9, 180, 5), 6, 1.6, "🍦 ICE CREAM", "#FF006E")
	B.Spot(f, "Beach_IceCream", ctx.At(-26, -25))
	B.NPC(ctx.NPCs, "IceCream", ctx.At(-20, -26, 180, 0.16))
	for _, p in ipairs({ { -62, -20 }, { -14, -62 }, { -36, -62 }, { -62, -36 } }) do
		B.Tree(f, ctx.Pos(p[1], p[2], 0.16), 1, "Palm")
	end
	for _, x in ipairs({ -50, -38 }) do
		B.Bench(f, ctx.At(x, -16, 180, 0.16))
	end
	B.Lamp(f, ctx.Pos(-44, -22, 0.16))
	B.Lamp(f, ctx.Pos(-16, -52, 0.16))

	-- ===== Beach =====
	local umbrellaColours = { "#F72585", "#4CC9F0", "#FFD60A" }
	for i, p in ipairs({ { -50, 10 }, { -42, 40 }, { -56, 58 } }) do
		B.Cylinder(f, "UmbrellaPole", ctx.At(p[1], p[2], 0, 0.12), 0.4, 7, "#F8F9FA", Enum.Material.SmoothPlastic)
		B.Cylinder(f, "Umbrella", ctx.At(p[1], p[2], 0, 6.6), 8, 0.4, umbrellaColours[i], Enum.Material.Fabric, { CanCollide = false })
		B.Block(f, "Towel", ctx.At(p[1] + 4, p[2] + 1, 15, 0.12), 3, 0.05, 6, umbrellaColours[(i % 3) + 1], Enum.Material.Fabric, { CanCollide = false })
	end
	for _, p in ipairs({ { -33, 49 }, { -27, 49 }, { -33, 55 }, { -27, 55 } }) do
		B.Block(f, "TowerLeg", ctx.At(p[1], p[2], 0, 0.12), 0.6, 6, 0.6, "#F8F9FA", Enum.Material.Wood)
	end
	B.Block(f, "TowerDeck", ctx.At(-30, 52, 0, 6.1), 7, 0.5, 7, "#E63946", Enum.Material.Wood)
	B.Block(f, "TowerRoof", ctx.At(-30, 52, 0, 9.5), 7.6, 0.4, 7.6, "#E63946", Enum.Material.SmoothPlastic)
	for _, x in ipairs({ -33, -27 }) do
		B.Block(f, "RoofPost", ctx.At(x, 55, 0, 6.6), 0.4, 2.9, 0.4, "#F8F9FA", Enum.Material.Wood)
	end
	B.Spot(f, "Beach_Swim", ctx.At(-13, 20, 0, 0.12))

	-- ===== Pier, boats and lighthouse =====
	B.Block(f, "PierDeck", ctx.At(19, 40, 0, 1.0), 66, 0.6, 6, B.Palette.Wood, Enum.Material.WoodPlanks)
	B.Part(f, { Name = "PierRamp", Class = "WedgePart", Size = Vector3.new(6, 1.48, 4), CFrame = ctx.At(-16, 40, 90, 0.86), Color = B.Palette.Wood, Material = Enum.Material.WoodPlanks })
	for _, x in ipairs({ -4, 8, 20, 32, 44 }) do
		for _, z in ipairs({ 37.5, 42.5 }) do
			B.Cylinder(f, "PierPost", ctx.At(x, z, 0, -14), 1, 15, B.Palette.DarkWood, Enum.Material.Wood)
		end
	end
	B.Spot(f, "Pier_Fish", ctx.At(48, 40, 0, 1.6))
	B.Boat(f, ctx.At(12, 49, 90, -1.8), 16, "#E63946")
	B.Boat(f, ctx.At(36, 51, 90, -1.8), 24, "#F8F9FA", true)
	B.NPC(ctx.NPCs, "Captain", ctx.At(-16, 34, -90, 0.12))
	B.Block(f, "LighthouseRock", ctx.At(56, 58, 0, -14), 14, 17, 14, "#6C757D", Enum.Material.Rock)
	for i, colour in ipairs({ "#E63946", "#F8F9FA", "#E63946" }) do
		B.Cylinder(f, "LighthouseBand", ctx.At(56, 58, 0, 3 + (i - 1) * 7), 6 - i * 0.4, 7, colour, Enum.Material.SmoothPlastic)
	end
	local lantern = B.Ball(f, "Lantern", ctx.Pos(56, 58, 25.5), 4, "#FFF3B0", Enum.Material.Neon, { CanCollide = false, Tag = "CYL_Lamp" })
	local beam = Instance.new("PointLight")
	beam.Name = "Light"
	beam.Range = 40
	beam.Brightness = 2
	beam.Enabled = false
	beam.Parent = lantern
	B.Cylinder(f, "LighthouseCap", ctx.At(56, 58, 0, 27.4), 5, 1.2, "#1D3557", Enum.Material.Metal)
	B.PostSign(f, "HarbourSign", ctx.At(-66, -20, 90, 0.16), 12, "⚓ Harbour & Hilltop", "#023E8A")

	-- Memory Stars
	B.Star(f, "Star_Lighthouse", ctx.At(46, 58, 0, -0.4))
	B.Star(f, "Star_Pier", ctx.At(51, 41.5, 0, 1.6))
	B.Star(f, "Star_Pool", ctx.At(60, -51, 0, hilltop))
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="94">
            <Properties>
              <string name="Name">Hospital</string>
              <string name="Source"><![CDATA[--[[
	Hospital  (ServerScriptService.Server.World.Districts.Hospital)
	St. Hope Hospital: reception and waiting area, the wards, the staff
	entrance, an ambulance bay, car park and helipad. Faces west, towards
	the Plaza.
]]

return function(B, ctx)
	local f = ctx.Folder
	B.Slab(f, "Forecourt", ctx.Pos(-38, 0).X, ctx.Pos(-38, 0).Z, 56, 128, 0.16, "#CFC6B8", Enum.Material.Concrete, 0.1)

	local hospital, hIn = B.Building(f, {
		Name = "St. Hope Hospital", CFrame = ctx.At(10, -6, 90), Width = 64, Depth = 40, Height = 24, Floors = 2,
		Wall = "#F8F9FA", Roof = "#0077B6", Floor = "#E0F2F1", FloorMaterial = Enum.Material.Marble,
		DoorWidth = 12, DoorHeight = 11, Sign = "🏥 ST. HOPE HOSPITAL", SignColor = "#0077B6",
	})
	-- Reception and waiting area
	B.Counter(hospital, hIn(0, 0, -6), 14, "#0077B6")
	B.Spot(hospital, "Hospital_Checkup", hIn(0, 0, -10))
	B.NPC(ctx.NPCs, "Doctor", hIn(-4, 0, -3.5))
	for _, x in ipairs({ -26, -22, -18, -14 }) do
		B.Chair(hospital, hIn(x, 0, -12, 180), "#90E0EF")
		B.Chair(hospital, hIn(x, 0, -6, 0), "#90E0EF")
	end
	B.Plant(hospital, hIn(-29, 0, -17))
	-- Wards along the back wall
	for _, x in ipairs({ -26, -18, -10, 10, 18, 26 }) do
		B.Bed(hospital, hIn(x, 0, 14, 0), "#CAF0F8")
	end
	B.Spot(hospital, "Hospital_Volunteer", hIn(14, 0, 6))
	B.NPC(ctx.NPCs, "Nurse", hIn(18, 0, 7))
	-- Staff entrance
	B.Board(hospital, hIn(26, 3, -18.8, 180), 7, 2.5, "STAFF ONLY", "#023E8A")
	B.Spot(hospital, "Hospital_Shift", hIn(26, 0, -14))

	-- Ambulance bay, car park and helipad
	B.Block(f, "AmbulanceCanopy", ctx.At(-40, 40, 0, 10), 18, 0.6, 14, "#0077B6", Enum.Material.SmoothPlastic)
	for _, p in ipairs({ { -48, 34 }, { -32, 34 }, { -48, 46 }, { -32, 46 } }) do
		B.Block(f, "CanopyPost", ctx.At(p[1], p[2]), 0.6, 10, 0.6, "#ADB5BD", Enum.Material.Metal)
	end
	local ambulance = B.Car(f, ctx.At(-40, 40, 180), "#F8F9FA", "Van")
	B.Part(ambulance, { Name = "Stripe", Size = Vector3.new(5.2, 0.6, 11.2), CFrame = ctx.At(-40, 40, 180, 2.4), Color = "#E63946", CanCollide = false })
	for i, z in ipairs({ -40, -28, -16 }) do
		B.Car(f, ctx.At(-56, z, 90), ({ "#457B9D", "#F4A261", "#6A994E" })[i], ({ "Hatch", "SUV", "Hatch" })[i])
	end
	B.Cylinder(f, "Helipad", ctx.At(44, 46), 22, 0.4, "#495057", Enum.Material.Concrete)
	B.Sign(f, "HelipadH", ctx.At(44, 46, 0, 0.62) * CFrame.Angles(math.rad(90), 0, 0), 9, 9, "H", "#495057")

	for _, p in ipairs({ { -62, -60 }, { -62, 62 }, { 62, -62 }, { 62, 26 }, { 16, 60 } }) do
		B.Tree(f, ctx.Pos(p[1], p[2], 0.1), 1)
	end
	for _, z in ipairs({ -50, -20, 10, 30, 56 }) do
		B.Lamp(f, ctx.Pos(-64, z, 0.16))
	end
	B.Bench(f, ctx.At(-26, -48, 90, 0.16))
	B.Bench(f, ctx.At(-26, 26, 90, 0.16))
	B.PostSign(f, "HospitalSign", ctx.At(-64, -8, 90), 12, "🏥 St. Hope Hospital", "#0077B6")

	-- Memory Stars
	B.Star(f, "Star_Helipad", ctx.At(44, 46, 0, 0.5))
	B.Star(hospital, "Star_Ward", hIn(-22, 0, 12))
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="95">
            <Properties>
              <string name="Name">Park</string>
              <string name="Source"><![CDATA[--[[
	Park  (ServerScriptService.Server.World.Districts.Park)
	Willow Park: the running track round the edge, Willow Arena (stands and
	pitch), the duck pond, the playground with swings, the outdoor gym, the
	picnic area and the Sunset Club (opens in Retirement).
]]

return function(B, ctx)
	local f = ctx.Folder
	local d = ctx.District

	-- Running track and paths
	local track = "#C1666B"
	B.Slab(f, "TrackN", d.X, d.Z - 61, 128, 6, 0.16, track, Enum.Material.Fabric, 0.1)
	B.Slab(f, "TrackS", d.X, d.Z + 61, 128, 6, 0.16, track, Enum.Material.Fabric, 0.1)
	B.Slab(f, "TrackW", d.X - 61, d.Z, 6, 116, 0.165, track, Enum.Material.Fabric, 0.1)
	B.Slab(f, "TrackE", d.X + 61, d.Z, 6, 116, 0.165, track, Enum.Material.Fabric, 0.1)
	B.Spot(f, "Park_Run", ctx.At(61, 12))
	B.Slab(f, "PathEW", d.X + 2, d.Z, 116, 6, 0.15, "#D4C5A9", Enum.Material.Pebble, 0.08)
	B.Slab(f, "PathNS", d.X, d.Z + 2, 6, 116, 0.155, "#D4C5A9", Enum.Material.Pebble, 0.08)

	-- Willow Arena (north-west)
	B.Slab(f, "ArenaPitch", ctx.Pos(-32, -34).X, ctx.Pos(-32, -34).Z, 36, 24, 0.16, "#4C9A2A", Enum.Material.Grass, 0.08)
	for i = 1, 3 do
		B.Block(f, "StandNorth", ctx.At(-32, -46 - i * 2.2), 36, 1.2 * i, 2.2, "#ADB5BD", Enum.Material.Concrete)
		B.Block(f, "StandSouth", ctx.At(-32, -22 + i * 2.2), 36, 1.2 * i, 2.2, "#ADB5BD", Enum.Material.Concrete)
	end
	B.Sign(f, "ArenaSign", ctx.At(-32, -53.9, 180, 8), 20, 3, "🏟️ WILLOW ARENA", "#1D3557")
	B.Spot(f, "Arena_Watch", ctx.At(-32, -13))
	B.Spot(f, "Arena_Shift", ctx.At(-40, -34))
	B.Lamp(f, ctx.Pos(-52, -10, 0.1))
	B.Lamp(f, ctx.Pos(-12, -10, 0.1))

	-- Sunset Club (north-east, opens in Retirement)
	local club, cIn = B.Building(f, {
		Name = "Sunset Club", CFrame = ctx.At(34, -36, 180), Width = 30, Depth = 24, Height = 12,
		Wall = "#FFE8D6", WallMaterial = Enum.Material.WoodPlanks, Roof = "#CB997E", Floor = "#DDBEA9",
		DoorWidth = 8, Sign = "🌅 SUNSET CLUB · 61+", SignColor = "#B07D62",
	})
	B.Slab(club, "BowlsGreen", (cIn(-4, 0, 4)).Position.X, (cIn(-4, 0, 4)).Position.Z, 16, 10, 0.62, "#4C9A2A", Enum.Material.Fabric, 0.05)
	for i = 1, 3 do
		B.Ball(club, "Bowl", (cIn(-8 + i * 2.5, 1.1, 6)).Position, 1, "#212529", Enum.Material.SmoothPlastic, { CanCollide = false })
	end
	B.Spot(club, "Club_Bowls", cIn(-4, 0, -3))
	B.Table(club, cIn(9, 0, 6), 4, 4, "#FFFFFF")
	B.Chair(club, cIn(9, 0, 3, 180), "#B07D62")
	B.Chair(club, cIn(9, 0, 9, 0), "#B07D62")
	B.Spot(club, "Club_Tea", cIn(9, 0, 0))
	B.LockWall(ctx.Locks, "SunsetClub", 6, ctx.At(34, -23.4), 9, 10, 1.2)
	B.NPC(ctx.NPCs, "Grandpa", ctx.At(42, -19, 180, 0.1))
	B.Bench(f, ctx.At(26, -18, 180, 0.1))

	-- Duck pond (south-west)
	local pond = ctx.Pos(-30, 28, 0.1)
	B.Cylinder(f, "PondBed", CFrame.new(pond), 28, 0.3, "#4E6E58", Enum.Material.Mud)
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		B.Block(f, "PondRim", CFrame.new(pond + Vector3.new(math.cos(a) * 14.6, 0, math.sin(a) * 14.6)) * CFrame.Angles(0, -a, 0), 2, 1.6, 8, B.Palette.Stone, Enum.Material.Slate)
	end
	pcall(function()
		workspace.Terrain:FillCylinder(CFrame.new(pond + Vector3.new(0, 0.9, 0)), 1.2, 13.5, Enum.Material.Water)
	end)
	for i = 1, 4 do
		B.Ball(f, "Duck", pond + Vector3.new(-6 + i * 3, 1.7, ((i * 5) % 7) - 3), 1.1, "#FFD60A", Enum.Material.SmoothPlastic, { CanCollide = false })
	end
	B.Spot(f, "Park_Ducks", ctx.At(-30, 46))
	B.NPC(ctx.NPCs, "Ranger", ctx.At(-40, 47, 0, 0.1))
	B.Bench(f, ctx.At(-12, 40, B.YawFacing(-12, 40, -30, 28), 0.1)) -- the quiet bench by the pond

	-- Playground, outdoor gym and picnic area (south-east)
	B.Slab(f, "SoftGround", ctx.Pos(24, 26).X, ctx.Pos(24, 26).Z, 22, 16, 0.14, "#F4A261", Enum.Material.Fabric, 0.05)
	for _, x in ipairs({ 16, 32 }) do
		B.Block(f, "SwingPost", ctx.At(x, 26), 0.6, 8, 0.6, "#264653", Enum.Material.Metal)
	end
	B.Block(f, "SwingBar", ctx.At(24, 26, 0, 8), 17, 0.6, 0.6, "#264653", Enum.Material.Metal)
	for _, x in ipairs({ 20, 28 }) do
		B.Part(f, { Name = "Swing", Class = "Seat", Size = Vector3.new(2, 0.3, 1.4), CFrame = ctx.At(x, 26, 0, 2.2), Color = "#E76F51", Tag = "CYL_Seat" })
		for _, side in ipairs({ -0.9, 0.9 }) do
			B.Part(f, { Name = "Rope", Size = Vector3.new(0.1, 5.8, 0.1), CFrame = ctx.At(x + side, 26, 0, 5.2), Color = "#ADB5BD", CanCollide = false })
		end
	end
	B.Spot(f, "Park_Swings", ctx.At(24, 20))
	for _, x in ipairs({ 44, 52 }) do
		B.Block(f, "GymPost", ctx.At(x, 26), 0.5, 8, 0.5, "#6C757D", Enum.Material.Metal)
	end
	B.Block(f, "PullUpBar", ctx.At(48, 26, 0, 8), 8.5, 0.4, 0.4, "#6C757D", Enum.Material.Metal)
	B.Block(f, "GymBench", ctx.At(48, 32), 2, 1.6, 5, "#343A40", Enum.Material.SmoothPlastic)
	B.Spot(f, "Park_Gym", ctx.At(48, 20))
	for _, x in ipairs({ 22, 38 }) do
		B.Table(f, ctx.At(x, 50), 6, 3, B.Palette.Wood)
		B.Part(f, { Name = "PicnicSeat", Class = "Seat", Size = Vector3.new(6, 0.4, 1.2), CFrame = ctx.At(x, 47.6, 0, 1.6), Color = B.Palette.Wood, Material = Enum.Material.Wood, Tag = "CYL_Seat" })
		B.Part(f, { Name = "PicnicSeat", Class = "Seat", Size = Vector3.new(6, 0.4, 1.2), CFrame = ctx.At(x, 52.4, 180, 1.6), Color = B.Palette.Wood, Material = Enum.Material.Wood, Tag = "CYL_Seat" })
	end
	B.Spot(f, "Park_Picnic", ctx.At(30, 44))

	-- Trees, lamps, benches, flowers
	for _, p in ipairs({ { -54, 8 }, { -48, 56 }, { -8, 56 }, { -6, 18 }, { -52, 20 }, { 10, -20 }, { 54, -6 }, { 56, 50 }, { 8, 48 }, { -8, -50 }, { 12, -56 }, { 54, -54 } }) do
		B.Tree(f, ctx.Pos(p[1], p[2], 0.1), 1.2, if p[1] % 3 == 0 then "Pine" else nil)
	end
	for _, p in ipairs({ { 6, -30 }, { 6, 30 }, { -30, 6 }, { 30, 6 }, { 6, 52 } }) do
		B.Lamp(f, ctx.Pos(p[1], p[2], 0.1))
	end
	for _, p in ipairs({ { -20, -6, 180 }, { 20, -6, 180 }, { 20, 6, 0 } }) do
		B.Bench(f, ctx.At(p[1], p[2] + (if p[3] == 0 then 1 else -1), p[3], 0.1))
	end
	B.Flowerbed(f, ctx.At(-12, -12), 8, 8)
	B.Flowerbed(f, ctx.At(12, 12), 8, 8)
	B.PostSign(f, "ParkSign", ctx.At(66, 0, -90), 12, "🌳 Willow Park", "#386641")

	-- Memory Stars
	B.Star(f, "Star_Pond", ctx.At(-47, 28))
	B.Star(f, "Star_Stands", ctx.At(-20, -52.6, 0, 3.7))
	B.Star(f, "Star_Picnic", ctx.At(22, 50))
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="96">
            <Properties>
              <string name="Name">Plaza</string>
              <string name="Source"><![CDATA[--[[
	Plaza  (ServerScriptService.Server.World.Districts.Plaza)
	Lifeville Plaza: the main spawn area. The wishing fountain, the Hall of
	Lives (the life selection area: one pedestal per save slot), the town map
	notice board, the welcome arch, the mayor and the busker.
	The SpawnLocation (from default.project.json) stands south of the fountain.
]]

return function(B, ctx)
	local f = ctx.Folder
	local d = ctx.District
	B.Slab(f, "Paving", d.X, d.Z, 132, 132, 0.16, "#D9CBB0", Enum.Material.Pavement, 0.1)

	-- Wishing fountain
	B.Fountain(f, ctx.Pos(0, 0, 0.16), 22)
	B.Spot(f, "Plaza_Wish", ctx.At(0, 13))

	-- Hall of Lives (north side, facing the fountain)
	local hall, inside = B.Building(f, {
		Name = "Hall of Lives", CFrame = ctx.At(0, -40, 180), Width = 46, Depth = 26, Height = 20,
		Wall = "#F3E9D2", WallMaterial = Enum.Material.Marble, Roof = "#6A4C93", Floor = "#EDE7F6", FloorMaterial = Enum.Material.Marble,
		DoorWidth = 10, DoorHeight = 11, Sign = "🌟 HALL OF LIVES", SignColor = "#6A4C93",
	})
	local orbColours = { "#FFD166", "#7BDFF2", "#F7AEF8" }
	for i, x in ipairs({ -13, 0, 13 }) do
		local base = inside(x, 0, 5)
		B.Cylinder(hall, "Pedestal", base, 4, 3, "#E0D7C6", Enum.Material.Marble)
		B.Ball(hall, "Orb", (base * CFrame.new(0, 4.4, 0)).Position, 2.6, orbColours[i], Enum.Material.Neon, { CanCollide = false })
		local sign = B.Sign(hall, "SlotSign", inside(x, 7.6, 5), 8, 2.6, "Life " .. i, "#3C2A4D", "#FFFFFF")
		sign.CanCollide = false
		sign:SetAttribute("Slot", "Slot" .. i)
		game:GetService("CollectionService"):AddTag(sign, "CYL_Pedestal")
		B.Spot(hall, "Plaza_Hall", inside(x, 0, 1), 0)
	end
	B.Slab(hall, "Carpet", (inside(0, 0, -6)).Position.X, (inside(0, 0, -6)).Position.Z, 6, 14, 0.62, "#9B2226", Enum.Material.Fabric, 0.05)
	B.Plant(hall, inside(-19, 0, -9))
	B.Plant(hall, inside(19, 0, -9))
	B.NPC(ctx.NPCs, "Keeper", inside(0, 0, -5))

	-- Welcome arch (south entrance)
	for _, x in ipairs({ -15, 15 }) do
		B.Block(f, "ArchPillar", ctx.At(x, 60), 3, 16, 3, "#F3E9D2", Enum.Material.Marble)
	end
	B.Block(f, "ArchBeam", ctx.At(0, 60, 0, 16), 34, 3, 3, "#6A4C93", Enum.Material.SmoothPlastic)
	B.Sign(f, "ArchSignSouth", ctx.At(0, 61.6, 180, 17.5), 30, 2.6, "WELCOME TO LIFEVILLE", "#6A4C93")
	B.Sign(f, "ArchSignNorth", ctx.At(0, 58.4, 0, 17.5), 30, 2.6, "EVERY CHOICE SHAPES YOUR FUTURE", "#6A4C93")

	-- Hall of Fame (LeaderboardService writes the top 5 here)
	for _, x in ipairs({ -36.6, -27.4 }) do
		B.Block(f, "FamePost", ctx.At(x, -24, 0, 0.16), 0.6, 4, 0.6, B.Palette.Black, Enum.Material.Metal)
	end
	local fame = B.Sign(f, "HallOfFame", ctx.At(-32, -24.3, 180, 8.6), 10, 9.4, "🏆 HALL OF FAME\nLoading…", "#3C2A4D", "#FFD60A")
	game:GetService("CollectionService"):AddTag(fame, "CYL_HallOfFame")

	-- Town map notice board
	B.PostSign(f, "NoticeBoard", ctx.At(28, 22, 180), 9, "🗺️ TOWN MAP", "#2A9D8F")
	B.Spot(f, "Plaza_Board", ctx.At(28, 25))

	-- Benches facing the fountain, flowers, trees and lamps
	for _, p in ipairs({ { 17, 17 }, { -17, 17 }, { 17, -17 }, { -17, -17 } }) do
		B.Bench(f, ctx.At(p[1], p[2], B.YawFacing(p[1], p[2], 0, 0), 0.16))
	end
	for _, x in ipairs({ -26, 26 }) do
		B.Flowerbed(f, ctx.At(x, 4, 0, 0.16), 6, 10)
	end
	for _, p in ipairs({ { -54, -54 }, { 54, -54 }, { -54, 54 }, { 54, 54 }, { -60, 8 }, { 60, 8 }, { -36, 46 }, { 36, 46 } }) do
		B.Tree(f, ctx.Pos(p[1], p[2], 0.16), 1.1)
	end
	for _, p in ipairs({ { -30, 30 }, { 30, 30 }, { -32, -16 }, { 32, -16 }, { -10, 56 }, { 10, 56 } }) do
		B.Lamp(f, ctx.Pos(p[1], p[2], 0.16))
	end

	-- The busker's little stage and the mayor
	B.Cylinder(f, "BuskerStage", ctx.At(-26, 22, 0, 0.16), 7, 0.6, "#8D6E63", Enum.Material.WoodPlanks)
	B.NPC(ctx.NPCs, "Busker", ctx.At(-26, 22, B.YawFacing(-26, 22, 0, 0), 0.76))
	B.NPC(ctx.NPCs, "Mayor", ctx.At(10, 20, 180, 0.16))

	-- Memory Stars
	B.Star(f, "Star_HallOfLives", ctx.At(0, -57, 0, 0.16))
	B.Star(f, "Star_Arch", ctx.At(19, 60, 0, 0.16))
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="97">
            <Properties>
              <string name="Name">Residential</string>
              <string name="Source"><![CDATA[--[[
	Residential  (ServerScriptService.Server.World.Districts.Residential)
	Oak Street: eight house plots (PlotService builds a home on each plot for
	a player in this server), the Oak Street Apartments, a bus stop, street
	lamps and back-garden hedges.

	Plot models live in World.Plots: Plot1..Plot8, each with a Base part
	(the lawn) whose CFrame faces the street, and a NameSign board.
]]

return function(B, ctx)
	local f = ctx.Folder
	local d = ctx.District

	-- Oak Street and pavements
	B.Slab(f, "OakStreet", d.X - 2, d.Z, 132, 16, 0.2, B.Palette.Asphalt, Enum.Material.Asphalt, 0.3)
	B.Slab(f, "PavementN", d.X - 2, d.Z - 10, 132, 4, 0.24, B.Palette.Pavement, Enum.Material.Pavement, 0.3)
	B.Slab(f, "PavementS", d.X - 2, d.Z + 10, 132, 4, 0.24, B.Palette.Pavement, Enum.Material.Pavement, 0.3)
	B.PostSign(f, "StreetSign", ctx.At(-64, -14, 90), 9, "🏡 Oak Street", "#386641")

	-- Eight plots: four on each side, facing the street
	local index = 0
	for _, side in ipairs({ -1, 1 }) do
		for _, x in ipairs({ -50, -24, 2, 28 }) do
			index += 1
			local yaw = if side < 0 then 180 else 0
			local plot = B.Model(ctx.Plots, "Plot" .. index)
			plot:SetAttribute("Index", index)
			local base = B.Block(plot, "Base", ctx.At(x, side * 30, yaw, 0.12), 24, 0.1, 30, "#6FBF5A", Enum.Material.Grass)
			base.CFrame = ctx.At(x, side * 30, yaw, 0.17)
			plot.PrimaryPart = base
			local sign = B.PostSign(plot, "NameSign", ctx.At(x + 9, side * 13.5, yaw, 0.24), 6, "🏡 For sale", "#386641")
			sign:SetAttribute("PlotSign", true)
			B.Hedge(f, ctx.At(x, side * 46, 0, 0.1), 24, 1.6, 3)
		end
	end

	-- Oak Street Apartments (north-east, facing the street)
	local flats, aIn = B.Building(f, {
		Name = "Oak Street Apartments", CFrame = ctx.At(55, -32, 180), Width = 24, Depth = 28, Height = 30, Floors = 4,
		Wall = "#B5838D", WallMaterial = Enum.Material.Brick, Roof = "#6D6875", Floor = "#E5E5E5",
		DoorWidth = 7, Sign = "🏢 APARTMENTS", SignColor = "#6D6875",
	})
	B.Block(flats, "Mailboxes", aIn(-9, 0, 4, 90), 6, 5, 1.2, "#ADB5BD", Enum.Material.Metal)
	B.Sofa(flats, aIn(5, 0, 6, 0), "#6D6875")
	B.Plant(flats, aIn(9, 0, -10))
	B.Part(flats, { Name = "Stairs", Class = "WedgePart", Size = Vector3.new(6, 9, 10), CFrame = aIn(-3, 4.5, 8), Color = "#ADB5BD" })
	B.Spot(flats, "Flats_Neighbours", aIn(0, 0, 0))

	-- Bus stop (south-east corner)
	B.Block(f, "ShelterBack", ctx.At(54, 22.2), 8, 7, 0.4, "#BFE3F7", Enum.Material.Glass, { Transparency = 0.3 })
	B.Block(f, "ShelterRoof", ctx.At(54, 20.8, 0, 7), 8.4, 0.4, 3.6, "#ADB5BD", Enum.Material.Metal)
	B.Bench(f, ctx.At(54, 20.4, 0, 0.1))
	B.PostSign(f, "BusSign", ctx.At(60, 16, 0, 0.1), 4, "🚌 Bus", "#1D3557")

	-- Street lamps, trees and the neighbour
	for _, x in ipairs({ -56, -30, -4, 22, 48 }) do
		B.Lamp(f, ctx.Pos(x, -13, 0.24))
	end
	for _, x in ipairs({ -62, -36, -10, 16, 44 }) do
		B.Lamp(f, ctx.Pos(x, 13, 0.24))
	end
	for _, p in ipairs({ { -64, 56 }, { -36, 58 }, { -10, 58 }, { 16, 58 }, { 48, 58 }, { -64, -56 }, { -36, -58 }, { -10, -58 }, { 16, -58 }, { 64, 58 } }) do
		B.Tree(f, ctx.Pos(p[1], p[2], 0.1), 1)
	end
	B.NPC(ctx.NPCs, "Neighbour", ctx.At(-6, 10, 0, 0.24))

	-- Memory Stars
	B.Star(flats, "Star_Stairs", aIn(-3, 9, 12.5))
	B.Star(f, "Star_Hedge", ctx.At(-60, -50))
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">School</string>
              <string name="Source"><![CDATA[--[[
	School  (ServerScriptService.Server.World.Districts.School)
	Maple School: a classroom (desks you can sit at, the board), the school
	library, the staff room, the playground and the sports field with goals.
	The entrance faces east, towards the Plaza.
]]

return function(B, ctx)
	local f = ctx.Folder

	-- Forecourt and main building
	B.Slab(f, "Forecourt", ctx.Pos(56, -18).X, ctx.Pos(56, -18).Z, 22, 40, 0.16, "#C9C3B6", Enum.Material.Concrete, 0.1)
	local school, inside = B.Building(f, {
		Name = "Maple School", CFrame = ctx.At(30, -18, -90), Width = 50, Depth = 30, Height = 16,
		Wall = "#C8553D", WallMaterial = Enum.Material.Brick, Roof = "#3D405B", Floor = "#E9D8A6",
		DoorWidth = 10, Sign = "🏫 MAPLE SCHOOL", SignColor = "#3D405B",
	})

	-- Classroom (left half): the board, two rows of desks and chairs
	B.Board(school, inside(-13, 2.5, 13.8), 14, 6, "Today: Fractions! ➗", "#2D4739")
	for _, z in ipairs({ 2, -5 }) do
		for _, x in ipairs({ -20, -13, -6 }) do
			B.Desk(school, inside(x, 0, z), 4)
			B.Chair(school, inside(x, 0, z - 2.4, 180), "#E9C46A")
		end
	end
	B.Spot(school, "School_Study", inside(-13, 0, -1))
	B.NPC(ctx.NPCs, "Teacher", inside(-13, 0, 9))

	-- Library (right half)
	for _, z in ipairs({ -8, 0, 8 }) do
		B.Shelf(school, inside(23, 0, z, 90), 6)
	end
	B.Table(school, inside(11, 0, 1), 6, 4)
	B.Chair(school, inside(11, 0, -2, 180), "#2A9D8F")
	B.Chair(school, inside(11, 0, 4, 0), "#2A9D8F")
	B.Counter(school, inside(13, 0, 9), 6)
	B.Spot(school, "School_Library", inside(14, 0, -4))
	B.NPC(ctx.NPCs, "Librarian", inside(13, 0, 11.5))

	-- Staff room corner
	B.Table(school, inside(-20, 0, -10), 4, 4, "#ADB5BD")
	B.Board(school, inside(-20, 3, -13.8, 180), 6, 2, "STAFF ROOM", "#3D405B")
	B.Spot(school, "School_Shift", inside(-17, 0, -10))

	-- Playground (south)
	B.Slab(f, "SoftGround", ctx.Pos(18, 42).X, ctx.Pos(18, 42).Z, 34, 24, 0.14, "#E76F51", Enum.Material.Fabric, 0.06)
	B.Block(f, "SlideTower", ctx.At(8, 42), 4, 6, 4, "#2A9D8F", Enum.Material.SmoothPlastic)
	B.Part(f, { Name = "Slide", Class = "WedgePart", Size = Vector3.new(3, 6, 10), CFrame = ctx.At(8, 49, 180, 3.1), Color = "#E9C46A", Material = Enum.Material.SmoothPlastic })
	for _, x in ipairs({ 22, 30 }) do
		for _, z in ipairs({ 36, 46 }) do
			B.Block(f, "FramePost", ctx.At(x, z), 0.6, 7, 0.6, "#264653", Enum.Material.Metal)
		end
	end
	B.Block(f, "FrameTop", ctx.At(26, 41, 0, 7), 9, 0.6, 11, "#264653", Enum.Material.Metal)
	B.Spot(f, "School_Playground", ctx.At(18, 36))
	B.Bench(f, ctx.At(42, 46, 90))

	-- Sports field (north-west) with goals
	local fieldCentre = ctx.Pos(-30, -30, 0.14)
	B.Slab(f, "Pitch", fieldCentre.X, fieldCentre.Z, 56, 36, 0.14, "#4C9A2A", Enum.Material.Grass, 0.04)
	B.Slab(f, "HalfwayLine", fieldCentre.X, fieldCentre.Z, 0.6, 36, 0.15, "#FFFFFF", Enum.Material.SmoothPlastic, 0.01)
	for _, x in ipairs({ -57, -3 }) do
		local inward = if x < -30 then 1 else -1
		for _, z in ipairs({ -34, -26 }) do
			B.Block(f, "GoalPost", ctx.At(x, z), 0.5, 5, 0.5, "#FFFFFF", Enum.Material.SmoothPlastic)
		end
		B.Block(f, "Crossbar", ctx.At(x, -30, 0, 5), 0.5, 0.5, 8.5, "#FFFFFF", Enum.Material.SmoothPlastic)
		B.Block(f, "Net", ctx.At(x - inward * 1.2, -30), 2, 5, 8, "#FFFFFF", Enum.Material.Fabric, { Transparency = 0.6, CanCollide = false })
	end
	B.Ball(f, "Football", ctx.Pos(-24, -28, 1.2), 1.6, "#FFFFFF", Enum.Material.SmoothPlastic)
	B.Spot(f, "School_Football", ctx.At(-30, -9))
	B.NPC(ctx.NPCs, "Coach", ctx.At(-36, -9, 0))

	-- Trees, benches and lamps
	for _, p in ipairs({ { -60, 10 }, { -60, 30 }, { -60, 52 }, { -40, 60 }, { -20, 60 }, { 60, 30 }, { 60, 60 }, { -62, -62 }, { 0, -62 } }) do
		B.Tree(f, ctx.Pos(p[1], p[2], 0.1), 1)
	end
	for _, p in ipairs({ { -20, 10 }, { 0, 10 } }) do
		B.Bench(f, ctx.At(p[1], p[2], 180))
	end
	for _, p in ipairs({ { 62, -40 }, { 62, 4 }, { -10, -52 } }) do
		B.Lamp(f, ctx.Pos(p[1], p[2], 0.1))
	end
	B.PostSign(f, "SchoolSign", ctx.At(64, 20, -90), 12, "🏫 Maple School", "#C8553D")

	-- Memory Stars
	B.Star(f, "Star_Goal", ctx.At(-62, -30))
	B.Star(school, "Star_Library", inside(21, 0, 4))
end
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="99">
            <Properties>
              <string name="Name">University</string>
              <string name="Source"><![CDATA[--[[
	University  (ServerScriptService.Server.World.Districts.University)
	Lifeville University (opens at Young Adulthood): the lecture hall, the
	campus library, evening classes, the student union and the campus green.
	The main entrance faces south, towards the road into Downtown.
]]

return function(B, ctx)
	local f = ctx.Folder

	-- Main building: lecture hall (left) and library (right)
	local uni, inside = B.Building(f, {
		Name = "Lifeville University", CFrame = ctx.At(0, -20, 180), Width = 60, Depth = 34, Height = 22, Floors = 2,
		Wall = "#E9E4D8", WallMaterial = Enum.Material.Limestone, Roof = "#5E548E", Floor = "#D6CCC2",
		DoorWidth = 12, DoorHeight = 12, Sign = "🎓 LIFEVILLE UNIVERSITY", SignColor = "#5E548E",
	})
	B.Board(uni, inside(-15, 3, 15.8), 18, 7, "Lecture 7: The Meaning of Life 🤔", "#22223B")
	B.Block(uni, "Podium", inside(-15, 0, 11.5), 3, 3.6, 2, "#6D4C41", Enum.Material.Wood)
	for _, z in ipairs({ 5, 1, -3 }) do
		for _, x in ipairs({ -25, -20, -15, -10, -5 }) do
			B.Chair(uni, inside(x, 0, z, 180), "#5E548E")
		end
	end
	B.Spot(uni, "Uni_Lecture", inside(-15, 0, -7))
	B.NPC(ctx.NPCs, "Professor", inside(-11, 0, 12))

	for _, z in ipairs({ -10, -3, 4, 11 }) do
		B.Shelf(uni, inside(28, 0, z, 90), 6)
	end
	for _, z in ipairs({ -4, 6 }) do
		B.Table(uni, inside(14, 0, z), 8, 4)
		B.Chair(uni, inside(11, 0, z - 3, 180), "#2A9D8F")
		B.Chair(uni, inside(17, 0, z + 3, 0), "#2A9D8F")
	end
	B.Spot(uni, "Uni_Library", inside(14, 0, 1))
	B.Board(uni, inside(20, 0, -13.5, 180), 7, 4, "🌙 Evening Classes\nFrom age 19", "#3C2A4D")
	B.Spot(uni, "Uni_Evening", inside(20, 0, -11))

	-- Student union (east side, facing east)
	local union, uInside = B.Building(f, {
		Name = "Student Union", CFrame = ctx.At(44, 34, -90), Width = 26, Depth = 20, Height = 12,
		Wall = "#FFB4A2", Roof = "#6D597A", Floor = "#E5989B", DoorWidth = 8, Sign = "🎭 STUDENT UNION", SignColor = "#6D597A",
	})
	B.Sofa(union, uInside(-6, 0, 6, 0), "#6D597A")
	B.Table(union, uInside(-6, 0, 1), 5, 3)
	B.Board(union, uInside(6, 2, 8.8), 8, 5, "SOCIETIES:\nDrama · Chess · Coding · Football", "#6D597A")
	B.Spot(union, "Uni_Society", uInside(6, 0, 3))
	B.NPC(ctx.NPCs, "Student", uInside(2, 0, 5))

	-- Campus green: path, statue, trees, benches, lamps
	B.Slab(f, "CampusPath", ctx.Pos(0, 32).X, ctx.Pos(0, 32).Z, 10, 70, 0.16, "#C9C3B6", Enum.Material.Pavement, 0.1)
	B.Block(f, "StatuePlinth", ctx.At(-24, 30), 4, 3, 4, "#ADB5BD", Enum.Material.Marble)
	B.Block(f, "Statue", ctx.At(-24, 30, 0, 3), 1.6, 6, 1.6, "#B08D57", Enum.Material.Metal)
	B.Ball(f, "StatueHead", ctx.Pos(-24, 30, 10), 2, "#B08D57", Enum.Material.Metal)
	for _, p in ipairs({ { -50, 10 }, { -50, 40 }, { -40, 60 }, { -20, 58 }, { 20, 58 }, { 60, -50 }, { -60, -56 }, { 60, 8 } }) do
		B.Tree(f, ctx.Pos(p[1], p[2], 0.1), 1.1)
	end
	for _, p in ipairs({ { -12, 20 }, { -12, 44 }, { 12, 20 }, { 12, 44 } }) do
		B.Bench(f, ctx.At(p[1], p[2], if p[1] < 0 then -90 else 90, 0.1))
	end
	for _, p in ipairs({ { -7, 10 }, { 7, 10 }, { -7, 52 }, { 7, 52 } }) do
		B.Lamp(f, ctx.Pos(p[1], p[2], 0.16))
	end
	B.PostSign(f, "UniSign", ctx.At(0, 64, 180), 14, "🎓 Lifeville University", "#5E548E")

	-- Memory Stars
	B.Star(f, "Star_Statue", ctx.At(-29, 30))
	B.Star(union, "Star_Union", uInside(-9, 0, -6))
end
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="100">
          <Properties>
            <string name="Name">Homes</string>
            <string name="Source"><![CDATA[--[[
	Homes  (ServerScriptService.Server.World.Homes)
	Builds a player's house on an Oak Street plot. The house reflects their
	life and their shop cosmetics:
	  • size: family home (under 19, living with parents), rented house,
	    starter home (Apartment asset), family house (House) or mansion;
	  • look: the equipped House style (or Apartment style for flats);
	  • drive: the equipped car, or the life's own car;
	  • garden: the equipped pet; inside: the equipped centrepiece;
	  • inside: "Rest at home" (sofa) and "Have a family dinner" (table) spots.

	Homes.SpecFor(player, data) -> spec (with spec.Key to detect changes)
	Homes.Build(plotModel, spec) -> house model
	Homes.Clear(plotModel)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared.Data.Catalog)

local B = require(script.Parent.Builder)

local Homes = {}

Homes.Tiers = {
	Family = { Title = "family home", Width = 16, Depth = 14, Height = 12, RoofStyle = "Pitched" },
	Rented = { Title = "rented house", Width = 13, Depth = 12, Height = 11, RoofStyle = "Pitched" },
	Apartment = { Title = "starter home", Width = 14, Depth = 12, Height = 12, RoofStyle = "Flat" },
	House = { Title = "family house", Width = 18, Depth = 15, Height = 15, RoofStyle = "Pitched", Floors = 2 },
	Mansion = { Title = "mansion", Width = 21, Depth = 18, Height = 18, RoofStyle = "Flat", Floors = 2 },
}

Homes.Styles = {
	Default = { Wall = "#E9E4D8", Roof = "#7A3E2E" },
	House_Cottage = { Wall = "#FFF3D6", Roof = "#A0522D", RoofStyle = "Pitched" },
	House_Cabin = { Wall = "#8B5A2B", Roof = "#2F5233", Material = Enum.Material.WoodPlanks, RoofStyle = "Pitched" },
	House_Beach = { Wall = "#FFFFFF", Roof = "#48CAE4", RoofStyle = "Flat" },
	House_Japanese = { Wall = "#4E342E", Roof = "#263238", Material = Enum.Material.Wood, RoofStyle = "Pitched" },
	House_Castle = { Wall = "#9E9E9E", Roof = "#616161", Material = Enum.Material.Cobblestone, RoofStyle = "Flat" },
	House_Manor = { Wall = "#F5F0E1", Roof = "#1D3557", Material = Enum.Material.Marble, RoofStyle = "Pitched" },
	Apt_Loft = { Wall = "#B5651D", Roof = "#3E2723", Material = Enum.Material.Brick, RoofStyle = "Flat" },
	Apt_Studio = { Wall = "#ADB5BD", Roof = "#495057", Material = Enum.Material.Concrete, RoofStyle = "Flat" },
	Apt_Penthouse = { Wall = "#90E0EF", Roof = "#023E8A", Material = Enum.Material.Glass, RoofStyle = "Flat" },
	Apt_Tower = { Wall = "#2B2D42", Roof = "#8D99AE", Material = Enum.Material.Glass, RoofStyle = "Flat" },
}

Homes.Cars = {
	Car_Hatch = { Shape = "Hatch", Color = "#E63946" },
	Car_SUV = { Shape = "SUV", Color = "#2A9D8F" },
	Car_Pickup = { Shape = "Pickup", Color = "#F4A261" },
	Car_Camper = { Shape = "Van", Color = "#E9C46A" },
	Car_Moto = { Shape = "Moto", Color = "#111111" },
	Car_Vintage = { Shape = "Vintage", Color = "#9B2226" },
	Car_Super = { Shape = "Super", Color = "#FFBE0B" },
}

local function activeLife(data)
	local life = data.Slots[data.ActiveSlot]
	if type(life) == "table" and not life.Completed then
		return life
	end
	return nil
end

function Homes.SpecFor(player: Player, data)
	local life = activeLife(data)
	local equipped = data.Inventory and data.Inventory.Equipped or {}
	local tier
	if not life or life.Age < 19 then
		tier = "Family"
	elseif life.Assets.Mansion then
		tier = "Mansion"
	elseif life.Assets.House then
		tier = "House"
	elseif life.Assets.Apartment then
		tier = "Apartment"
	else
		tier = "Rented"
	end
	local styleId = if tier == "Apartment" or tier == "Rented" then equipped.Apartment else equipped.House
	local car = Homes.Cars[equipped.Car or ""]
	if not car and life then
		if life.Assets.SportsCar then
			car = { Shape = "Super", Color = "#D00000" }
		elseif life.Assets.Car then
			car = { Shape = "Hatch", Color = "#8D99AE" }
		elseif tier == "Family" then
			car = { Shape = "SUV", Color = "#6C757D" } -- your parents' car
		end
	end
	local pet = Catalog.Get(equipped.Pet)
	local furniture = Catalog.Get(equipped.Furniture)
	local spec = {
		Tier = tier,
		Style = if styleId and Homes.Styles[styleId] then styleId else "Default",
		Car = car,
		Pet = pet and pet.Icon or nil,
		Furniture = furniture and furniture.Icon or nil,
		Owner = player.DisplayName or player.Name,
		LifeName = life and life.Name or nil,
	}
	spec.Key = table.concat({ spec.Tier, spec.Style, car and (car.Shape .. car.Color) or "-", spec.Pet or "-", spec.Furniture or "-", spec.Owner, spec.LifeName or "-" }, "|")
	return spec
end

function Homes.Clear(plot: Model)
	local house = plot:FindFirstChild("House")
	if house then
		house:Destroy()
	end
end

local function floatingIcon(parent: Instance, position: Vector3, icon: string, size: number)
	local holder = B.Part(parent, { Name = "Icon", Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(position), Transparency = 1, CanCollide = false })
	holder.CanQuery = false
	local gui = Instance.new("BillboardGui")
	gui.Name = "Icon"
	gui.Size = UDim2.fromOffset(size, size)
	gui.MaxDistance = 80
	gui.LightInfluence = 0
	gui.Parent = holder
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = icon
	label.TextScaled = true
	label.Parent = gui
	return holder
end

-- Builds the house for `spec` on `plot` (replacing any previous house).
function Homes.Build(plot: Model, spec)
	Homes.Clear(plot)
	local base = plot:FindFirstChild("Base") :: BasePart
	local house = B.Model(plot, "House")
	house:SetAttribute("Key", spec.Key)
	local tier = Homes.Tiers[spec.Tier] or Homes.Tiers.Family
	local style = Homes.Styles[spec.Style] or Homes.Styles.Default
	-- The plot's Base faces the street (-Z). The house sits at the back left,
	-- the drive and car on the right, the garden in front.
	local ground = base.CFrame * CFrame.new(0, base.Size.Y / 2, 0)
	local halfW, halfD = tier.Width / 2, tier.Depth / 2
	local houseCf = ground * CFrame.new(-12 + halfW + 0.6, 0, 15 - halfD - 0.6)
	local building, inside = B.Building(house, {
		Name = "Home", CFrame = houseCf, Width = tier.Width, Depth = tier.Depth, Height = tier.Height, Floors = tier.Floors,
		Wall = style.Wall, WallMaterial = style.Material, Roof = style.Roof, RoofStyle = style.RoofStyle or tier.RoofStyle,
		DoorWidth = 5, DoorHeight = 8, DoorOffset = -halfW + 3.5, Floor = "#D7CCC8", Light = true,
	})
	building:SetAttribute("Tier", spec.Tier)
	-- Inside: sofa (rest) at the back left, table (dinner) on the right, centrepiece
	B.Sofa(building, inside(-halfW + 4.5, 0, halfD - 3, 0), "#577590")
	local rest = B.Spot(building, "Home_Rest", inside(-halfW + 4.5, 0, halfD - 6))
	B.Table(building, inside(halfW - 3.5, 0, -1), 4, 4, "#FFFFFF")
	B.Chair(building, inside(halfW - 3.5, 0, -3.6, 180), "#E9C46A")
	B.Chair(building, inside(halfW - 3.5, 0, 1.6, 0), "#E9C46A")
	local dinner = B.Spot(building, "Home_Dinner", inside(halfW - 6.5, 0, -1))
	for _, part in ipairs({ rest, dinner }) do
		part:SetAttribute("Plot", plot:GetAttribute("Index"))
	end
	if spec.Furniture then
		floatingIcon(building, (inside(0, 3, halfD - 3)).Position, spec.Furniture, 90)
	end
	-- Drive and garden
	local drive = ground * CFrame.new(9.5, 0, -10.5)
	B.Slab(house, "Drive", drive.Position.X, drive.Position.Z, 5, 9, ground.Position.Y + 0.06, B.Palette.Pavement, Enum.Material.Pavement, 0.1)
	if spec.Car then
		B.Car(house, drive * CFrame.new(0, 0.06, 0), spec.Car.Color, spec.Car.Shape)
	end
	if spec.Pet then
		B.Block(house, "Kennel", ground * CFrame.new(-8, 0, -10), 2.4, 2.2, 2.4, B.Palette.Wood, Enum.Material.WoodPlanks)
		floatingIcon(house, (ground * CFrame.new(-5.5, 2, -10)).Position, spec.Pet, 60)
	end
	B.Flowerbed(house, ground * CFrame.new(-6, 0, -13.5), 8, 2)
	B.Tree(house, (ground * CFrame.new(3, 0, -11)).Position, 0.8)
	-- Name sign
	local sign = plot:FindFirstChild("NameSign")
	local board = sign and sign:FindFirstChild("Board")
	local label = board and board:FindFirstChild("Text") and board.Text:FindFirstChild("Label")
	if label then
		label.Text = ("🏡 %s's %s"):format(spec.Owner, tier.Title)
	end
	return house
end

function Homes.ResetSign(plot: Model)
	local sign = plot:FindFirstChild("NameSign")
	local board = sign and sign:FindFirstChild("Board")
	local label = board and board:FindFirstChild("Text") and board.Text:FindFirstChild("Label")
	if label then
		label.Text = "🏡 For sale"
	end
end

return Homes
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="101">
          <Properties>
            <string name="Name">Town</string>
            <string name="Source"><![CDATA[--[[
	Town  (ServerScriptService.Server.World.Town)
	Generates Lifeville into Workspace.World: the island, sea, roads, street
	lamps, trees, every district (World/Districts) and the walls of areas
	that unlock later in life.

	Town.Build(parent) -> worldFolder
	  World
	  ├─ Ground        land, roads, coast
	  ├─ Districts     one Folder per district (buildings, props, spots)
	  ├─ Locks         locked-area walls (CYL_Lock)
	  ├─ NPCAnchors    where NPCService places each character
	  └─ Plots         the 8 house plots on Oak Street (PlotService builds houses)

	Studio tip: you can bake the town into your place from the Command Bar:
	  require(game.ServerScriptService.Server.World.Town).Build(workspace)
	WorldService keeps an existing Workspace.World instead of generating one.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local World = require(Shared.Data.World)

local B = require(script.Parent.Builder)
local Districts = script.Parent:WaitForChild("Districts")

local Town = {}

Town.LandHalf = 320 -- island from -320 to 320 (minus the harbour bay)
Town.BayCorner = 150 -- the bay is x > 150 and z > 150
Town.WaterTop = -0.6
Town.SeaFloor = -14

local ROAD_TOP_H = 0.2 -- east-west roads
local ROAD_TOP_V = 0.22 -- north-south roads sit a hair higher (no z-fighting)

local function inBay(x: number, z: number): boolean
	return x > Town.BayCorner - 4 and z > Town.BayCorner - 4
end

local function buildGround(world: Folder)
	local ground = B.Folder(world, "Ground")
	local L, bay = Town.LandHalf, Town.BayCorner
	local depth = -Town.SeaFloor
	-- Two land blocks leave the bay open in the south-east corner.
	B.Part(ground, { Name = "LandNorth", Size = Vector3.new(2 * L, depth, L + bay), CFrame = CFrame.new(0, -depth / 2, (-L + bay) / 2), Color = B.Palette.Grass, Material = Enum.Material.Grass })
	B.Part(ground, { Name = "LandSouthWest", Size = Vector3.new(L + bay, depth, L - bay), CFrame = CFrame.new((-L + bay) / 2, -depth / 2, (L + bay) / 2), Color = B.Palette.Grass, Material = Enum.Material.Grass })
	-- Sand around the coast.
	local beach = 10
	B.Slab(ground, "CoastN", 0, -L + beach / 2, 2 * L, beach, 0.05, B.Palette.Sand, Enum.Material.Sand, 0.2)
	B.Slab(ground, "CoastW", -L + beach / 2, 0, beach, 2 * L, 0.05, B.Palette.Sand, Enum.Material.Sand, 0.2)
	B.Slab(ground, "CoastE", L - beach / 2, (-L + bay) / 2, beach, L + bay, 0.05, B.Palette.Sand, Enum.Material.Sand, 0.2)
	B.Slab(ground, "CoastS", (-L + bay) / 2, L - beach / 2, L + bay, beach, 0.05, B.Palette.Sand, Enum.Material.Sand, 0.2)

	-- Roads: two north-south, two east-west and a ring (cut by the bay).
	local roads = B.Folder(ground, "Roads")
	local w = World.RoadWidth
	local ring = World.RingRoad
	local outer = ring + w / 2
	for _, x in ipairs({ -80, 80 }) do
		B.Road(roads, x, -outer, x, outer, w, ROAD_TOP_V)
	end
	for _, z in ipairs({ -80, 80 }) do
		B.Road(roads, -outer, z, outer, z, w, ROAD_TOP_H)
	end
	local roadEnd = bay - 16 -- the ring road stops short of the bay
	B.Road(roads, -outer, -ring, outer, -ring, w, ROAD_TOP_H) -- north
	B.Road(roads, -ring, -outer, -ring, outer, w, ROAD_TOP_V) -- west
	B.Road(roads, ring, -outer, ring, roadEnd, w, ROAD_TOP_V) -- east
	B.Road(roads, -outer, ring, roadEnd, ring, w, ROAD_TOP_H) -- south
	-- Turning circles where the ring road meets the bay.
	B.Cylinder(roads, "TurnEast", CFrame.new(ring, ROAD_TOP_V - 0.4, roadEnd), 30, 0.4, B.Palette.Asphalt, Enum.Material.Asphalt)
	B.Cylinder(roads, "TurnSouth", CFrame.new(roadEnd, ROAD_TOP_H - 0.4, ring), 30, 0.4, B.Palette.Asphalt, Enum.Material.Asphalt)
	return ground
end

local function buildSea(world: Folder)
	local terrain = workspace.Terrain
	local half = 520
	local height = Town.WaterTop - Town.SeaFloor
	pcall(function()
		terrain:FillBlock(CFrame.new(0, Town.SeaFloor + height / 2, 0), Vector3.new(half * 2, height, half * 2), Enum.Material.Water)
	end)
	-- A sandy slope from the beach into the bay.
	local coast = world.Ground
	local run, drop = 18, 8
	B.Part(coast, { Name = "BeachSlope", Class = "WedgePart", Size = Vector3.new(Town.LandHalf - Town.BayCorner, drop, run), CFrame = CFrame.new(Town.BayCorner + run / 2, -drop / 2, (Town.BayCorner + Town.LandHalf) / 2) * CFrame.Angles(0, math.rad(-90), 0), Color = B.Palette.Sand, Material = Enum.Material.Sand })
end

-- Street lamps along the road edges and trees around the edge of town.
local function buildStreets(world: Folder)
	local streets = B.Folder(world, "Streets")
	local ring = World.RingRoad
	local edge = World.RoadWidth / 2 - 1
	local function nearCrossing(t: number): boolean
		for _, line in ipairs({ -80, 80, -ring, ring }) do
			if math.abs(t - line) < 16 then
				return true
			end
		end
		return false
	end
	for _, line in ipairs({ -80, 80 }) do
		for t = -208, 208, 64 do
			if not nearCrossing(t) then
				if not inBay(line - edge, t) then
					B.Lamp(streets, Vector3.new(line - edge, ROAD_TOP_V, t)) -- north-south roads, west edge
				end
				if not inBay(t, line + edge) then
					B.Lamp(streets, Vector3.new(t, ROAD_TOP_H, line + edge)) -- east-west roads, south edge
				end
			end
		end
	end
	-- Trees beyond the ring road (a green belt round the island).
	local belt = ring + 30
	for t = -300, 300, 36 do
		for _, p in ipairs({ { t, -belt }, { -belt, t }, { belt, t }, { t, belt } }) do
			local x, z = p[1], p[2]
			if not inBay(x, z) and math.abs(x) < Town.LandHalf - 14 and math.abs(z) < Town.LandHalf - 14 then
				B.Tree(streets, Vector3.new(x, 0, z), 1.1 + ((x * 7 + z * 3) % 5) / 10, if (x + z) % 72 == 0 then "Pine" else nil)
			end
		end
	end
	-- Direction signs at the Plaza's corners.
	B.PostSign(streets, "SignNorth", B.At(-60, 0.16, -64, 0), 15, "⬆ Downtown · University · Career Row", "#1D3557")
	B.PostSign(streets, "SignSouth", B.At(60, 0.16, 64, 180), 15, "⬇ Oak Street · Willow Park · Harbour", "#1D3557")
	return streets
end

-- Walls round each district that unlocks later (the client makes them solid).
local function buildLocks(world: Folder)
	local locks = B.Folder(world, "Locks")
	local half = World.CellSize / 2
	for _, d in ipairs(World.Districts) do
		if d.UnlockStage > 1 then
			-- From the sea floor up, so nobody can swim underneath.
			local c = Vector3.new(d.X, Town.SeaFloor, d.Z)
			local height, thickness = 16 - Town.SeaFloor, 1
			B.LockWall(locks, d.Id, d.UnlockStage, CFrame.new(c + Vector3.new(0, 0, -half)), World.CellSize, height, thickness)
			B.LockWall(locks, d.Id, d.UnlockStage, CFrame.new(c + Vector3.new(0, 0, half)), World.CellSize, height, thickness)
			B.LockWall(locks, d.Id, d.UnlockStage, CFrame.new(c + Vector3.new(-half, 0, 0)), thickness, height, World.CellSize)
			B.LockWall(locks, d.Id, d.UnlockStage, CFrame.new(c + Vector3.new(half, 0, 0)), thickness, height, World.CellSize)
		end
	end
	return locks
end

--[[
	ctx passed to each district builder:
	  ctx.Folder, ctx.District (World entry), ctx.NPCs (anchor folder),
	  ctx.Plots (Residential only), ctx.Locks,
	  ctx.At(x, z, yaw?, y?) -> CFrame in world space from district-local
	  coordinates (origin at the district centre on the ground).
]]
function Town.Context(world: Folder, district)
	local folder = B.Folder(world.Districts, district.Id)
	folder:SetAttribute("District", district.Id)
	local ctx = {
		Folder = folder,
		District = district,
		NPCs = world.NPCAnchors,
		Plots = world.Plots,
		Locks = world.Locks,
		Ground = 0.1,
	}
	function ctx.At(x: number, z: number, yaw: number?, y: number?): CFrame
		return B.At(district.X + x, y or ctx.Ground, district.Z + z, yaw)
	end
	function ctx.Pos(x: number, z: number, y: number?): Vector3
		return Vector3.new(district.X + x, y or ctx.Ground, district.Z + z)
	end
	return ctx
end

function Town.Build(parent: Instance?)
	local target = parent or workspace
	local existing = target:FindFirstChild("World")
	if existing then
		existing:Destroy()
	end
	local world = B.Folder(target, "World")
	world:SetAttribute("Town", World.TownName)
	buildGround(world)
	buildSea(world)
	B.Folder(world, "Districts")
	B.Folder(world, "NPCAnchors")
	B.Folder(world, "Plots")
	buildLocks(world)
	buildStreets(world)
	for _, district in ipairs(World.Districts) do
		local module = Districts:FindFirstChild(district.Id)
		if module then
			local ctx = Town.Context(world, district)
			if not district.Coastal then
				B.Slab(ctx.Folder, "Ground", district.X, district.Z, World.CellSize, World.CellSize, 0.1, "#7FBF6A", Enum.Material.Grass, 0.3)
			end
			require(module)(B, ctx)
		end
	end
	return world
end

return Town
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="102">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="103">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="104">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="105">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="106">
            <Properties>
              <string name="Name">AchievementsController</string>
              <string name="Source"><![CDATA[--[[
	AchievementsController  (StarterPlayerScripts.Client.Controllers.AchievementsController)
	🏆 The Achievements screen (main menu → Achievements), with three tabs:
	  • Achievements: every achievement with progress bars, rewards and
	    unlock dates; secret ones stay "???" with a hint until unlocked.
	  • Challenges: today's daily reward, the daily and weekly challenges
	    with progress and time left (the server pays rewards automatically).
	  • Memory Stars: how many you've found, with a hint for each one left.
	Progress is read from your own synced data, the same rules the server uses.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Achievements = require(Shared.Data.Achievements)
local Challenges = require(Shared.Data.Challenges)
local Collectibles = require(Shared.Data.Collectibles)
local World = require(Shared.Data.World)
local Format = require(Shared.Util.Format)
local DailyRules = require(Shared.Util.Daily)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Components = require(UILib.Components)
local Layout = require(UILib.Layout)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)

local AchievementsController = {}
AchievementsController.Priority = 62

local frame: CanvasGroup
local tab = "Achievements"
local category: string? = nil

local MONEY = { NestEgg = true, Millionaire = true, S_Billionaire = true }
local MONTHS = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" }

-- "12 Mar 2027" (Roblox's os.date only returns tables).
local function dateText(unix: number): string
	local t = os.date("!*t", unix)
	return ("%d %s %d"):format(t.day, MONTHS[t.month], t.year)
end

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

function AchievementsController.Today(): number
	return Challenges.DayOf(serverNow())
end

local function timeLeft(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local days = math.floor(seconds / 86400)
	local hours = math.floor(seconds % 86400 / 3600)
	local minutes = math.floor(seconds % 3600 / 60)
	if days > 0 then
		return ("%dd %dh"):format(days, hours)
	end
	return ("%dh %dm"):format(hours, minutes)
end

local function card(parent, order: number, props)
	local panel = Components.Panel({ Name = props.Name, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Padding = 14, LayoutOrder = order, Parent = parent, Color = if props.Done then Theme.Color.SurfaceHigh else Theme.Color.Surface })
	Create.List(Enum.FillDirection.Vertical, 6).Parent = panel
	local top = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 1, Parent = panel })
	Create.Label({ Name = "Title", Text = props.Icon .. "  " .. props.Title, FontFace = Theme.Font.Heavy, Size = UDim2.new(1, -120, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = top })
	Create.Label({ Name = "Reward", Text = props.Reward or "", TextColor3 = if props.Done then Theme.Color.Positive else Theme.Color.Gold, FontFace = Theme.Font.Bold, TextSize = Theme.TextSize.Small, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 120, 1, 0), Parent = top })
	Create.Label({ Name = "Description", Text = props.Text, TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = panel })
	if props.Fraction then
		Components.ProgressBar({ Fraction = props.Fraction, Text = props.ProgressText, Color = if props.Done then Theme.Color.Positive else Theme.Color.Accent, LayoutOrder = 3, Parent = panel })
	end
	return panel
end

local function grid(parent, order: number, columns: number, width: number)
	local holder = Create("Frame", { Name = "Grid", BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, Parent = parent })
	if columns > 1 then
		local list = Create.List(Enum.FillDirection.Horizontal, 12)
		list.Wraps = true
		list.Parent = holder
	else
		Create.List(Enum.FillDirection.Vertical, 10).Parent = holder
	end
	return holder, math.floor((width - 12 * (columns - 1)) / columns)
end

-- ===== Tabs =====
local function renderAchievements(column, data, width: number)
	local unlocked = Achievements.Unlocked(data)
	Create.Label({ Name = "Summary", Text = ("🏆 %d of %d unlocked"):format(unlocked, #Achievements.List), FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Gold, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = column })
	local filters = Create("Frame", { Name = "Filters", BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, Parent = column })
	local list = Create.List(Enum.FillDirection.Horizontal, 8)
	list.Wraps = true
	list.Parent = filters
	local entries = { { Id = nil, Name = "All", Icon = "🌟" } }
	for _, c in ipairs(Achievements.Categories) do
		table.insert(entries, c)
	end
	for i, c in ipairs(entries) do
		Components.Button({ Name = "Filter_" .. (c.Id or "All"), Text = c.Name, Icon = c.Icon, Style = if category == c.Id then "Primary" else "Secondary", Size = UDim2.fromOffset(if UIController.IsNarrow() then 150 else 140, 40), TextSize = 15, LayoutOrder = i, Parent = filters, OnClick = function()
			category = c.Id
			AchievementsController.Render()
		end })
	end
	local columns = if UIController.IsNarrow() then 1 else 2
	local holder, cellWidth = grid(column, 5, columns, width)
	local order = 0
	for _, def in ipairs(Achievements.List) do
		if category == nil or def.Category == category then
			order += 1
			local done = data.Achievements[def.Id] ~= nil
			local hidden = def.Secret and not done
			local current, target = Achievements.ProgressOf(def.Id, data)
			local progressText = if MONEY[def.Id] then ("%s / %s"):format(Format.Money(current), Format.Money(target)) else ("%s / %s"):format(Format.Commas(current), Format.Commas(target))
			local c = card(holder, order, {
				Name = "Ach_" .. def.Id,
				Icon = if hidden then "🔒" else def.Icon,
				Title = if hidden then "???" else def.Name,
				Text = if hidden then "Secret: " .. (def.Hint or "keep playing to find it.") else def.Description,
				Reward = if done then "✅ Unlocked" else ("🪙 %d"):format(def.Coins or 0),
				Done = done,
				Fraction = if hidden then nil else current / target,
				ProgressText = if done then "Unlocked " .. dateText(data.Achievements[def.Id]) else progressText,
			})
			c.Size = UDim2.fromOffset(cellWidth, 0)
		end
	end
end

local function challengeCards(column, order: number, title: string, group, defsById, lifetime, secondsLeft: number, prefix: string)
	Create.Label({ Name = prefix .. "Heading", Text = ("%s · resets in %s"):format(title, timeLeft(secondsLeft)), TextSize = Theme.TextSize.Tiny, FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Primary, Size = UDim2.new(1, 0, 0, 28), TextYAlignment = Enum.TextYAlignment.Bottom, LayoutOrder = order, Parent = column })
	local ids = {}
	for id in pairs(group or {}) do
		table.insert(ids, id)
	end
	table.sort(ids)
	if #ids == 0 then
		Create.Label({ Text = "New challenges are on their way…", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order + 1, Parent = column })
	end
	for i, id in ipairs(ids) do
		local def = defsById[id]
		if def then
			local entry = group[id]
			local progress, target = Challenges.Progress(def, entry, lifetime)
			card(column, order + i, {
				Name = "Challenge_" .. id,
				Icon = def.Icon,
				Title = def.Text,
				Text = if entry.Done then "Complete! The Coins are yours." else "Progress made since this challenge started counts.",
				Reward = if entry.Done then "✅ Done" else ("🪙 %d"):format(def.Coins),
				Done = entry.Done,
				Fraction = progress / target,
				ProgressText = ("%d / %d"):format(progress, target),
			})
		end
	end
end

local function renderChallenges(column, data)
	local today = AchievementsController.Today()
	local status = DailyRules.Status(data.Daily, today, serverNow())
	local daily = Components.Panel({ Name = "DailyCard", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Padding = 14, LayoutOrder = 3, Parent = column, Color = Theme.Color.SurfaceHigh })
	Create.List(Enum.FillDirection.Vertical, 8).Parent = daily
	Create.Label({ Text = ("🎁 Daily reward · 🔥 %d-day streak"):format(data.Daily.Streak or 0), FontFace = Theme.Font.Heavy, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = daily })
	Create.Label({ Text = if status.Claimable then ("Day %d reward ready: 🪙 %d"):format(status.Day, status.Reward) else ("Claimed today. Next reward in %s."):format(timeLeft(status.SecondsLeft)), TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = daily })
	Components.Button({ Name = "OpenDaily", Text = if status.Claimable then "Claim" else "View", Icon = "🎁", Style = if status.Claimable then "Primary" else "Secondary", Size = UDim2.fromOffset(180, 46), TextSize = 18, LayoutOrder = 3, Parent = daily, OnClick = function()
		require(script.Parent.DailyController).Open()
	end })
	local c = data.Challenges
	local dailyGroup = if c.DailyDay == today then c.Daily else {}
	local week = Challenges.WeekOf(today)
	local weeklyGroup = if c.WeeklyWeek == week then c.Weekly else {}
	local weekEnds = (week * 7 + 4) * 86400 -- Monday 00:00 UTC
	challengeCards(column, 10, "🎯 DAILY CHALLENGES", dailyGroup, Challenges.ById, data.Lifetime, (today + 1) * 86400 - serverNow(), "Daily")
	challengeCards(column, 30, "🗓️ WEEKLY CHALLENGES", weeklyGroup, Challenges.ById, data.Lifetime, weekEnds - serverNow(), "Weekly")
end

local function renderStars(column, data)
	local found = Achievements.Count(data.Collectibles)
	Create.Label({ Name = "StarSummary", Text = ("⭐ %d of %d Memory Stars found · 🪙 %d each"):format(found, Collectibles.Total, Collectibles.Coins), FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Gold, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = column })
	Components.ProgressBar({ Name = "StarBar", Fraction = found / Collectibles.Total, Text = ("%d / %d"):format(found, Collectibles.Total), Color = Theme.Color.Gold, LayoutOrder = 4, Parent = column })
	local order = 10
	for _, district in ipairs(World.Districts) do
		local stars = {}
		for _, star in ipairs(Collectibles.List) do
			if star.District == district.Id then
				table.insert(stars, star)
			end
		end
		if #stars > 0 then
			order += 1
			Create.Label({ Text = district.Icon .. "  " .. district.Name, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, Parent = column })
			for _, star in ipairs(stars) do
				order += 1
				local got = data.Collectibles[star.Id] == true
				Create.Label({ Name = star.Id, Text = (if got then "✅ Found · " else "❔ ") .. star.Hint, TextColor3 = if got then Theme.Color.Positive else Theme.Color.TextDim, TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, Parent = column })
			end
		end
	end
end

function AchievementsController.Render()
	Create.Clear(frame, true)
	Layout.Header(frame, "Achievements", function()
		UIController.Back()
	end)
	local data = DataController.Get()
	if not data then
		return
	end
	local scroll = Layout.Scroll(frame)
	local width = math.min(900, UIController.GetVirtualSize().X - 32)
	local column = Layout.Column(scroll, width)
	local tabs = Create("Frame", { Name = "Tabs", BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 48), LayoutOrder = 1, Parent = column })
	Create.List(Enum.FillDirection.Horizontal, 8).Parent = tabs
	local tabWidth = math.floor((width - 16) / 3)
	for i, t in ipairs({ { "Achievements", "🏆" }, { "Challenges", "🎯" }, { "Stars", "⭐" } }) do
		Components.Button({ Name = "Tab_" .. t[1], Text = if t[1] == "Stars" then "Memory Stars" else t[1], Icon = t[2], Style = if tab == t[1] then "Primary" else "Secondary", Size = UDim2.fromOffset(tabWidth, 48), TextSize = 17, LayoutOrder = i, Parent = tabs, OnClick = function()
			tab = t[1]
			AchievementsController.Render()
		end })
	end
	if tab == "Achievements" then
		renderAchievements(column, data, width)
	elseif tab == "Challenges" then
		renderChallenges(column, data)
	else
		renderStars(column, data)
	end
end

function AchievementsController.Open(tabName: string?)
	tab = tabName or tab
	UIController.Show("Achievements")
end

function AchievementsController.Init()
	frame = UIController.NewScreen("Achievements", { Back = true, OnOpen = function(tabName)
		if tabName then
			tab = tabName
		end
		AchievementsController.Render()
	end })
end

function AchievementsController.Start()
	DataController.Changed:Connect(function()
		if UIController.Current() == "Achievements" then
			AchievementsController.Render()
		end
	end)
	UIController.LayoutChanged:Connect(function()
		if UIController.Current() == "Achievements" then
			AchievementsController.Render()
		end
	end)
end

return AchievementsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="107">
            <Properties>
              <string name="Name">AmbienceController</string>
              <string name="Source"><![CDATA[--[[
	AmbienceController  (StarterPlayerScripts.Client.Controllers.AmbienceController)
	Background sound while exploring: each district has an ambient loop
	(World.Districts[].Ambient: birdsong in the park, chatter downtown, waves
	at the harbour...), switching to AmbientNight after dark, crossfading as
	you walk between districts. The busker in the Plaza plays music you hear
	when you're near him.
	All sounds come from Shared/Data/SoundIds and follow the Sound effects
	volume. Empty ids are silent, so the game works before audio is added.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local World = require(Shared.Data.World)
local SoundIds = require(Shared.Data.SoundIds)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Anim = require(UILib.Anim)

local ExploreController = require(script.Parent.ExploreController)
local DayNightController = require(script.Parent.DayNightController)

local AmbienceController = {}
AmbienceController.Priority = 60
AmbienceController.Volume = 0.45

local currentKey: string? = nil
local currentSound: Sound? = nil

local function sfxGroup(): SoundGroup?
	return SoundService:FindFirstChild("CYL_SFX") :: SoundGroup?
end

function AmbienceController.Current(): string?
	return currentKey
end

-- Which ambient loop fits where you are and the time of day.
function AmbienceController.KeyFor(districtId: string?, night: boolean): string
	if night then
		return "AmbientNight"
	end
	local district = districtId and World.ById[districtId]
	return if district then district.Ambient else "AmbientCity"
end

function AmbienceController.Set(key: string?)
	if key == currentKey then
		return
	end
	currentKey = key
	local old = currentSound
	currentSound = nil
	if old then
		Anim.Tween(old, { Volume = 0 }, 1.2)
		task.delay(1.3, function()
			old:Destroy()
		end)
	end
	local id = key and SoundIds[key]
	if type(id) == "string" and id ~= "" then
		local sound = Instance.new("Sound")
		sound.Name = key
		sound.SoundId = id
		sound.Looped = true
		sound.Volume = 0
		sound.SoundGroup = sfxGroup()
		sound.Parent = SoundService
		sound:Play()
		Anim.Tween(sound, { Volume = AmbienceController.Volume }, 1.5)
		currentSound = sound
	end
end

local function busker(on: boolean)
	local world = workspace:FindFirstChild("World")
	local npcs = world and world:FindFirstChild("NPCs")
	local rig = npcs and npcs:FindFirstChild("NPC_Busker")
	local head = rig and rig:FindFirstChild("Head")
	if not head then
		return
	end
	local music = head:FindFirstChild("CYL_BuskerMusic") :: Sound?
	if not music and on and SoundIds.BuskerMusic ~= "" then
		local sound = Instance.new("Sound")
		sound.Name = "CYL_BuskerMusic"
		sound.SoundId = SoundIds.BuskerMusic
		sound.Looped = true
		sound.Volume = 0.8
		sound.RollOffMaxDistance = 70
		sound.SoundGroup = sfxGroup()
		sound.Parent = head
		music = sound
	end
	if music then
		if on then
			music:Play()
		else
			music:Stop()
		end
	end
end

function AmbienceController.Step()
	if ExploreController.IsExploring() then
		AmbienceController.Set(AmbienceController.KeyFor(ExploreController.CurrentDistrict(), DayNightController.IsNight()))
	else
		AmbienceController.Set(nil)
	end
end

function AmbienceController.Init() end

function AmbienceController.Start()
	ExploreController.Changed:Connect(function(on)
		busker(on)
		AmbienceController.Step()
	end)
	ExploreController.DistrictChanged:Connect(AmbienceController.Step)
	while true do
		task.wait(2)
		AmbienceController.Step()
	end
end

return AmbienceController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="108">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--[[
	AudioController  (StarterPlayerScripts.Client.Controllers.AudioController)
	Creates Music and SFX SoundGroups (driven by the volume settings), plays UI
	sound effects and switches background music per screen.
	Asset ids live in Shared.Data.SoundIds; empty ids are skipped.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local SoundIds = require(ReplicatedStorage:WaitForChild("Shared").Data.SoundIds)
local Components = require(script.Parent.Parent:WaitForChild("UILib").Components)

local AudioController = {}
AudioController.Priority = 2

local musicGroup: SoundGroup
local sfxGroup: SoundGroup
local sfxCache: { [string]: Sound } = {}
local currentMusic: Sound? = nil
local currentMusicName: string? = nil

local MUSIC_FOR_SCREEN = {
	Menu = "MenuMusic",
	SlotSelect = "MenuMusic",
	NameEntry = "MenuMusic",
	Settings = nil, -- keep whatever is playing
	Credits = "MenuMusic",
	Game = "GameMusic",
	Explore = "WorldMusic",
}

local function makeSound(name: string, group: SoundGroup, looped: boolean): Sound?
	local id = SoundIds[name]
	if type(id) ~= "string" or id == "" then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = id
	sound.Looped = looped
	sound.SoundGroup = group
	sound.Parent = group
	return sound
end

function AudioController.Play(name: string)
	local sound = sfxCache[name]
	if sound == nil then
		sound = makeSound(name, sfxGroup, false)
		sfxCache[name] = sound or (false :: any)
	end
	if sound then
		sound.TimePosition = 0
		sound:Play()
	end
end

function AudioController.PlayMusic(name: string?)
	if name == currentMusicName then
		return
	end
	currentMusicName = name
	if currentMusic then
		currentMusic:Stop()
		currentMusic:Destroy()
		currentMusic = nil
	end
	if name then
		currentMusic = makeSound(name, musicGroup, true)
		if currentMusic then
			currentMusic:Play()
		end
	end
end

function AudioController.SetVolumes(music: number, sfx: number)
	musicGroup.Volume = math.clamp(music, 0, 1)
	sfxGroup.Volume = math.clamp(sfx, 0, 1)
end

function AudioController.Init()
	musicGroup = Instance.new("SoundGroup")
	musicGroup.Name = "CYL_Music"
	musicGroup.Parent = SoundService
	sfxGroup = Instance.new("SoundGroup")
	sfxGroup.Name = "CYL_SFX"
	sfxGroup.Parent = SoundService
	Components.OnClickSound = function()
		AudioController.Play("Click")
	end
end

function AudioController.Start()
	local UIController = require(script.Parent.UIController)
	UIController.ScreenChanged:Connect(function(screen)
		local track = MUSIC_FOR_SCREEN[screen]
		if track then
			AudioController.PlayMusic(track)
		end
	end)
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="109">
            <Properties>
              <string name="Name">CollectiblesController</string>
              <string name="Source"><![CDATA[--[[
	CollectiblesController  (StarterPlayerScripts.Client.Controllers.CollectiblesController)
	✨ Memory Stars in Lifeville: stars you've already found are hidden on
	your screen (their prompt and sparkle switch off), and collecting one
	asks the server (CollectibleService), which checks you're next to it.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Collectibles = require(Shared.Data.Collectibles)

local DataController = require(script.Parent.DataController)
local AudioController = require(script.Parent.AudioController)

local CollectiblesController = {}
CollectiblesController.Priority = 69

local busy = false

local function apply(star: BasePart)
	local data = DataController.Get()
	local found = data ~= nil and data.Collectibles[star:GetAttribute("CYL_Star")] == true
	star.Transparency = if found then 1 else 0
	local prompt = star:FindFirstChildOfClass("ProximityPrompt")
	if prompt then
		prompt.Enabled = not found
	end
	local sparkle = star:FindFirstChildOfClass("ParticleEmitter")
	if sparkle then
		sparkle.Enabled = not found
	end
end

function CollectiblesController.Refresh()
	for _, star in ipairs(CollectionService:GetTagged("CYL_Star")) do
		apply(star)
	end
end

function CollectiblesController.Collect(starId: string)
	if busy then
		return false
	end
	busy = true
	local ok, result = Net.Invoke("CollectStar", starId)
	busy = false
	local Explore = require(script.Parent.ExploreController)
	if ok then
		AudioController.Play("Positive")
		Explore.ShowCard("✨ Memory Star found!", ("%d of %d found · +%d 🪙"):format(result.Found, result.Total, result.Coins) .. (if result.Found == result.Total then "\n🌟 You found them all!" else ""), nil, "Result")
	elseif result ~= "AlreadyFound" then
		Explore.ShowCard("✨ Memory Star", if result == "TooFar" then "Get a little closer." else "Couldn't collect it right now.", nil, "Problem")
	end
	CollectiblesController.Refresh()
	return ok, result
end

function CollectiblesController.Found(): number
	local data = DataController.Get()
	local n = 0
	for id in pairs(data and data.Collectibles or {}) do
		if Collectibles.ById[id] then
			n += 1
		end
	end
	return n
end

function CollectiblesController.Init() end

function CollectiblesController.Start()
	CollectionService:GetInstanceAddedSignal("CYL_Star"):Connect(apply)
	DataController.Changed:Connect(CollectiblesController.Refresh)
	CollectiblesController.Refresh()
end

return CollectiblesController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="110">
            <Properties>
              <string name="Name">ControlsController</string>
              <string name="Source"><![CDATA[--[[
	ControlsController  (StarterPlayerScripts.Client.Controllers.ControlsController)
	Until the 3D world arrives (Phase 8) the game is played through its menus,
	so the default character controls are switched off: no walking with WASD
	behind the UI, and no touch thumbstick / jump button covering the decision
	cards on phones and tablets.
	ControlsController.SetEnabled(true) turns them back on (world mode).
]]

local Players = game:GetService("Players")

local ControlsController = {}
ControlsController.Priority = 6

local controls = nil
local wantEnabled = false

function ControlsController.SetEnabled(enabled: boolean)
	wantEnabled = enabled
	if controls then
		if enabled then
			controls:Enable()
		else
			controls:Disable()
		end
	end
end

function ControlsController.Init() end

function ControlsController.Start()
	-- PlayerModule is Roblox's default control script inside PlayerScripts.
	local ok, module = pcall(function()
		local playerScripts = Players.LocalPlayer:WaitForChild("PlayerScripts", 15)
		local playerModule = playerScripts and playerScripts:WaitForChild("PlayerModule", 15)
		return playerModule and require(playerModule)
	end)
	if ok and module then
		controls = module:GetControls()
		ControlsController.SetEnabled(wantEnabled)
	end
end

return ControlsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="111">
            <Properties>
              <string name="Name">DailyController</string>
              <string name="Source"><![CDATA[--[[
	DailyController  (StarterPlayerScripts.Client.Controllers.DailyController)
	🎁 Daily reward panel: the 7-day reward track, your streak, and Claim.
	Opens from the main menu (🎁 Daily Reward) or Achievements → Challenges;
	once per visit a reminder appears when a reward is waiting.
	The server decides the day and pays the reward (DailyService).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Config = require(Shared.Config)
local Challenges = require(Shared.Data.Challenges)
local DailyRules = require(Shared.Util.Daily)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Anim = require(UILib.Anim)
local Components = require(UILib.Components)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local NotificationController = require(script.Parent.NotificationController)
local AudioController = require(script.Parent.AudioController)

local DailyController = {}
DailyController.Priority = 63

local shownThisVisit = false
local busy = false

function DailyController.Status()
	local data = DataController.Get()
	if not data then
		return nil
	end
	local now = workspace:GetServerTimeNow()
	return DailyRules.Status(data.Daily, Challenges.DayOf(now), now)
end

function DailyController.IsClaimable(): boolean
	local status = DailyController.Status()
	return status ~= nil and status.Claimable
end

local function hours(seconds: number): string
	return ("%dh %dm"):format(math.floor(seconds / 3600), math.floor(seconds % 3600 / 60))
end

function DailyController.Open()
	local status = DailyController.Status()
	if not status then
		return
	end
	local handle = UIController.OpenPanel({ Name = "DailyModal", Title = "🎁  Daily Reward", Width = 680, Height = 520 })
	handle.Subtitle.Text = ("🔥 %d-day streak · come back every day for bigger rewards"):format(DataController.Get().Daily.Streak or 0)
	local scroll = handle.Scroll
	local track = Create("Frame", { Name = "Track", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = scroll })
	local list = Create.List(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center)
	list.Wraps = true
	list.Parent = track
	local currentDay = status.Day
	local doneUpTo = if status.Claimable then currentDay - 1 else currentDay
	local tileWidth = math.min(80, math.floor((UIController.GetVirtualSize().X - 120) / 7))
	for day, coins in ipairs(Config.DailyRewards) do
		local today = status.Claimable and day == currentDay
		local tile = Create("Frame", { Name = "Day" .. day, BackgroundColor3 = if today then Theme.Color.Primary elseif day <= doneUpTo then Theme.Color.SurfaceHigher else Theme.Color.Surface, Size = UDim2.fromOffset(tileWidth, 104), LayoutOrder = day, Parent = track }, { Create.Corner(Theme.RadiusSmall), Create.Stroke(if day == #Config.DailyRewards then Theme.Color.Gold else Theme.Color.Stroke, if day == #Config.DailyRewards then 2 else 1, 0.2) })
		Create.Label({ Text = "Day " .. day, TextSize = Theme.TextSize.Tiny, FontFace = Theme.Font.Bold, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 20), Parent = tile })
		Create.Label({ Text = if day <= doneUpTo then "✅" elseif day == #Config.DailyRewards then "💰" else "🪙", TextSize = 30, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 28), Size = UDim2.new(1, 0, 0, 36), Parent = tile })
		Create.Label({ Name = "Coins", Text = tostring(coins), FontFace = Theme.Font.Heavy, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 70), Size = UDim2.new(1, 0, 0, 24), Parent = tile })
		if today then
			Anim.Pop(tile, 0.9, 0.4)
		end
	end
	local message = Create.Label({ Name = "Message", Text = if status.Claimable then ("Day %d of your streak: 🪙 %d Coins are waiting!"):format(currentDay, status.Reward) else ("You've claimed today's reward. Come back in %s."):format(hours(status.SecondsLeft)), TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = scroll })
	local claim = Components.Button({ Name = "Claim", Text = if status.Claimable then ("Claim 🪙 %d"):format(status.Reward) else "Claimed ✓", Icon = "🎁", Style = "Primary", Size = UDim2.new(1, 0, 0, 58), LayoutOrder = 3, Parent = scroll, OnClick = function(button)
		if busy or not DailyController.IsClaimable() then
			return
		end
		busy = true
		local ok, result = Net.Invoke("ClaimDaily")
		busy = false
		if ok then
			AudioController.Play("Positive")
			NotificationController.Notify({ Title = "🎁 Daily reward", Text = ("+%d 🪙 · %d-day streak!"):format(result.Coins, result.Streak), Kind = "Success", Duration = 4 })
			message.Text = ("+%d Coins! See you tomorrow for day %d."):format(result.Coins, (result.Day % #Config.DailyRewards) + 1)
			Components.SetText(button, "🎁  Claimed ✓")
			Components.SetDisabled(button, true)
		else
			message.Text = if result == "AlreadyClaimed" then "Already claimed today." else "Couldn't claim right now. Try again in a moment."
		end
	end })
	if not status.Claimable then
		Components.SetDisabled(claim, true)
	end
	Create.Label({ Text = "Miss a day and your streak starts again at day 1. Day 7 is the big one!", TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextFaint, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, Parent = scroll })
	return handle
end

function DailyController.Init() end

function DailyController.Start()
	-- A gentle reminder (not a pop-up that blocks the menu) once per visit.
	UIController.ScreenChanged:Connect(function(screen)
		if screen == "Menu" and not shownThisVisit then
			shownThisVisit = true
			task.delay(1.5, function()
				local status = DailyController.Status()
				if status and status.Claimable then
					NotificationController.Notify({ Title = "🎁 Daily reward ready", Text = ("Day %d of your streak: 🪙 %d. Open 🎁 Daily Reward in the menu."):format(status.Day, status.Reward), Kind = "Info", Duration = 6 })
				end
			end)
		end
	end)
end

return DailyController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="112">
            <Properties>
              <string name="Name">DataController</string>
              <string name="Source"><![CDATA[--[[
	DataController  (StarterPlayerScripts.Client.Controllers.DataController)
	Holds the local player's latest data snapshot sent by the server.
	The client copy is DISPLAY-ONLY: changing it changes nothing on the server.

	DataController.Changed:Connect(function(data) ... end)
	DataController.Get()            -> data or nil
	DataController.WaitForData()    -> data (yields until first snapshot)
	DataController.GetActiveLife()  -> life table or nil
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)

local DataController = {}
DataController.Priority = 0

DataController.Changed = Signal.new() -- (data)
DataController.Loaded = Signal.new() -- () fired once

local current = nil

local function set(data)
	if type(data) ~= "table" then
		return
	end
	-- The server leaves Life History out of updates when it hasn't changed.
	if data.HistoryUnchanged then
		data.HistoryUnchanged = nil
		data.LifeHistory = if current then current.LifeHistory else {}
	end
	local first = current == nil
	current = data
	DataController.Changed:Fire(data)
	if first then
		DataController.Loaded:Fire()
	end
end

function DataController.Get()
	return current
end

function DataController.WaitForData()
	if current then
		return current
	end
	DataController.Loaded:Wait()
	return current
end

function DataController.GetActiveLife()
	if not current then
		return nil
	end
	local life = current.Slots[current.ActiveSlot]
	return if type(life) == "table" then life else nil
end

function DataController.Init() end

function DataController.Start()
	Net.OnEvent("DataSnapshot", set)
	-- Also ask directly, in case the first push arrived before we connected.
	for attempt = 1, 5 do
		if current then
			return
		end
		local ok, data = Net.Invoke("GetData")
		if ok then
			set(data)
			return
		end
		task.wait(attempt)
	end
	if not current then
		warn("[DataController] Could not fetch data from server")
	end
end

return DataController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="113">
            <Properties>
              <string name="Name">DayNightController</string>
              <string name="Source"><![CDATA[--[[
	DayNightController  (StarterPlayerScripts.Client.Controllers.DayNightController)
	Lifeville's day and night: the sky (Lighting.ClockTime) follows the shared
	server clock (World.ClockTimeAt), so every player sees the same time with
	no network traffic. A full day lasts World.DayLengthSeconds (12 min).
	At dusk street lamps glow and windows light up; at dawn they switch off.
	On Low graphics lamps glow without casting light (cheaper on phones).
	DayNightController.Override(hour?) pins the time (Life Reveal showcase).
]]

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local World = require(ReplicatedStorage:WaitForChild("Shared").Data.World)

local GraphicsController = require(script.Parent.GraphicsController)

local DayNightController = {}
DayNightController.Priority = 56

local WINDOW_NIGHT = Color3.fromRGB(255, 226, 150)

local override: number? = nil
local night: boolean? = nil
local windowDay: { [BasePart]: { Color: Color3, Material: Enum.Material, Transparency: number } } = {}

function DayNightController.ClockTime(): number
	if override then
		return override
	end
	return World.ClockTimeAt(workspace:GetServerTimeNow())
end

function DayNightController.IsNight(): boolean
	return World.IsNight(DayNightController.ClockTime())
end

local function applyLamp(part: BasePart, on: boolean)
	part.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
	local light = part:FindFirstChildOfClass("PointLight")
	if light then
		light.Enabled = on and not GraphicsController.IsLow()
	end
end

local function applyWindow(part: BasePart, on: boolean)
	if not windowDay[part] then
		windowDay[part] = { Color = part.Color, Material = part.Material, Transparency = part.Transparency }
		part.Destroying:Connect(function()
			windowDay[part] = nil
		end)
	end
	local day = windowDay[part]
	if on then
		part.Color = WINDOW_NIGHT
		part.Material = Enum.Material.Neon
		part.Transparency = 0.05
	else
		part.Color = day.Color
		part.Material = day.Material
		part.Transparency = day.Transparency
	end
end

function DayNightController.ApplyAll()
	local on = night == true
	for _, part in ipairs(CollectionService:GetTagged("CYL_Lamp")) do
		applyLamp(part, on)
	end
	for _, part in ipairs(CollectionService:GetTagged("CYL_Window")) do
		applyWindow(part, on)
	end
end

function DayNightController.Step()
	local clock = DayNightController.ClockTime()
	Lighting.ClockTime = clock
	local isNight = World.IsNight(clock)
	if isNight ~= night then
		night = isNight
		DayNightController.ApplyAll()
	end
end

-- Pins the sky to `hour` (nil returns to the shared clock).
function DayNightController.Override(hour: number?)
	override = hour
	DayNightController.Step()
end

function DayNightController.Init() end

function DayNightController.Start()
	CollectionService:GetInstanceAddedSignal("CYL_Lamp"):Connect(function(part)
		applyLamp(part, night == true)
	end)
	CollectionService:GetInstanceAddedSignal("CYL_Window"):Connect(function(part)
		if night then
			applyWindow(part, true)
		end
	end)
	GraphicsController.Changed:Connect(DayNightController.ApplyAll)
	DayNightController.Step()
	while true do
		task.wait(1)
		DayNightController.Step()
	end
end

return DayNightController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="114">
            <Properties>
              <string name="Name">DecisionController</string>
              <string name="Source"><![CDATA[--[[
	DecisionController  (StarterPlayerScripts.Client.Controllers.DecisionController)
	Draws scenarios inside the Game screen and drives the decision loop:

	  GetScenario → choice cards → select (highlight + confirm bar) → confirm
	  → MakeChoice → outcome card (story, stat changes, traits) → Continue
	  → age-up / stage-complete transition → next scenario

	Input: click/tap a card to select, tap again or press Confirm to lock it in.
	Keyboard 1–5 selects, Enter confirms / continues. Gamepad: D-pad + A, B to cancel.
	Locked choices show their unlock hint, so players know hidden paths exist.

	The client never decides outcomes; it only sends (scenarioId, choiceId).
]]

local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Format = require(Shared.Util.Format)
local LifeStages = require(Shared.Data.LifeStages)
local StatDefinitions = require(Shared.Data.StatDefinitions)
local Traits = require(Shared.Data.Traits)
local Careers = require(Shared.Data.Careers)
local StatMath = require(Shared.Util.StatMath)
local People = require(Shared.Util.People)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Anim = require(UILib.Anim)
local Components = require(UILib.Components)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local HUDController = require(script.Parent.HUDController)
local AudioController = require(script.Parent.AudioController)
local NotificationController = require(script.Parent.NotificationController)
local RevealController = require(script.Parent.RevealController)

local DecisionController = {}
DecisionController.Priority = 45

local content: Frame
local view: Frame? = nil
local mode = "Idle" -- Idle | Loading | Scenario | Outcome | Transition | Message
local scenario = nil
local selected = nil
local outcome = nil
local pendingEvent = nil -- event waiting to be shown after the outcome
local shownEvent = nil -- event card currently on screen
local busy = false
local cards: { [string]: TextButton } = {}
local confirmBar: Frame? = nil
local continueButton: GuiButton? = nil
local requestToken = 0

-- Invokes the server, waiting and retrying briefly if we were rate-limited
-- (e.g. very fast tapping), so the player never sees a spurious error.
local function invoke(name: string, ...)
	local ok, result
	for attempt = 1, 4 do
		ok, result = Net.Invoke(name, ...)
		if ok or result ~= "RateLimited" then
			break
		end
		task.wait(0.4 * attempt)
	end
	return ok, result
end

-- ===== View helpers =====
-- Views are plain Frames (not CanvasGroups): the Game screen is already a
-- CanvasGroup, and nesting them costs texture memory on mobile. Entry motion
-- comes from Anim.Pop on each view's main elements instead.
local function newView(): Frame
	if view then
		view:Destroy()
	end
	cards = {}
	confirmBar = nil
	continueButton = nil
	local v = Create("Frame", { Name = "View", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = content })
	view = v
	return v
end

local function previewText(choice): string
	if choice.Mystery then
		return "❓ <font color=\"" .. Theme.Hex.Dim .. "\">Unknown outcome</font>"
	end
	local parts = {}
	for _, p in ipairs(choice.Preview) do
		local info = StatDefinitions.Info[p.Stat]
		if info then
			local arrows = string.rep(if p.Dir > 0 then "▲" else "▼", p.Size)
			local color = if p.Dir > 0 then Theme.Hex.Positive else Theme.Hex.Negative
			table.insert(parts, ("%s<font color=\"%s\">%s</font>"):format(info.Icon, color, arrows))
		end
	end
	if choice.MoneyDir ~= 0 then
		table.insert(parts, ("💰<font color=\"%s\">%s</font>"):format(if choice.MoneyDir > 0 then Theme.Hex.Positive else Theme.Hex.Negative, if choice.MoneyDir > 0 then "▲" else "▼"))
	end
	if choice.Risky then
		table.insert(parts, "🎲<font color=\"" .. Theme.Hex.Gold .. "\">Risky</font>")
	end
	return table.concat(parts, "   ")
end

local function centeredPanel(parent: Instance, width: number)
	local panel = Components.Panel({
		Size = UDim2.fromOffset(width, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Padding = 26,
		Parent = parent,
	})
	Create.List(Enum.FillDirection.Vertical, 14, Enum.HorizontalAlignment.Center).Parent = panel
	return panel
end

local function messageView(icon: string, title: string, body: string, buttons: { any })
	mode = "Message"
	local v = newView()
	local width = math.min(640, UIController.GetVirtualSize().X - 32)
	local panel = centeredPanel(v, width)
	Create.Label({ Text = icon, TextSize = 60, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 66), LayoutOrder = 1, Parent = panel })
	Create.Label({ Text = title, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = panel })
	Create.Label({ Text = body, TextColor3 = Theme.Color.TextDim, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = panel })
	local row = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 56), LayoutOrder = 4, Parent = panel })
	Create.List(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center).Parent = row
	local w = math.floor((width - 52 - 12 * (#buttons - 1)) / #buttons)
	local first
	for i, b in ipairs(buttons) do
		local button = Components.Button({ Text = b.Text, Icon = b.Icon, Style = b.Style or "Primary", Size = UDim2.fromOffset(math.min(w, 280), 56), LayoutOrder = i, Parent = row, OnClick = b.OnClick })
		first = first or button
	end
	Anim.Pop(panel, 0.92)
	UIController.Focus(first)
end

local function toMenu()
	UIController.Show("Menu")
end

local function showUnavailable()
	local life = DataController.GetActiveLife()
	local name = if life then life.Name else "Your"
	local stage = if life then LifeStages.Get(life.Stage).DisplayName else "next chapter"
	messageView(
		"📖",
		"To be continued…",
		("%s's %s haven't been written yet. Your life is saved at age %d, so you can pick up right here when new life stages arrive."):format(name, stage, if life then life.Age else 0),
		{
			{ Text = "Main Menu", Icon = "🏠", Style = "Secondary", OnClick = toMenu },
			{ Text = "Another Life", Icon = "✨", OnClick = function()
				UIController.Show("SlotSelect", "New")
			end },
		}
	)
end

local function showLifeComplete()
	local life = DataController.GetActiveLife()
	local body = "Every choice made this story yours."
	if life then
		local career = if life.Flags.Retired then "a well-earned retirement" elseif life.Career.Id ~= "None" then "life as " .. Careers.TitleAt(life.Career.Id, life.Career.Level) else "a life of their own design"
		body = ("%s lived to %d and ended with %s, %s in the bank, and overall life score %d/100. Every choice made this story yours."):format(
			life.Name,
			life.Age,
			career,
			Format.Money(life.Money),
			math.floor(StatMath.Overall(life.Stats) + 0.5)
		)
	end
	messageView("🌅", "A Life Complete", body, {
		{ Text = "Main Menu", Icon = "🏠", Style = "Secondary", OnClick = toMenu },
		{ Text = "Life History", Icon = "📜", Style = "Accent", OnClick = function()
			UIController.Show("LifeHistory")
		end },
		{ Text = "Live Again", Icon = "✨", OnClick = function()
			UIController.Show("SlotSelect", "New")
		end },
	})
end

local function showError(reason: any)
	messageView("⚠️", "Hmm, that didn't work", "We couldn't load your next decision (" .. tostring(reason) .. "). Your progress is safe.", {
		{ Text = "Main Menu", Icon = "🏠", Style = "Secondary", OnClick = toMenu },
		{ Text = "Try Again", Icon = "🔄", OnClick = function()
			DecisionController.Next()
		end },
	})
end

local function showLoading()
	mode = "Loading"
	local v = newView()
	Create.Label({
		Text = "✨ Thinking about your life…",
		FontFace = Theme.Font.Bold,
		TextColor3 = Theme.Color.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.new(1, -40, 0, 40),
		Parent = v,
	})
end

-- ===== Scenario =====
local renderScenario

local function setCardHighlight(card: TextButton, state: string)
	local stroke = card:FindFirstChildOfClass("UIStroke")
	local dim = card:FindFirstChild("Dim") :: Frame
	local scale = Anim.Scale(card)
	if state == "Selected" then
		if stroke then
			stroke.Color = Theme.Color.Primary
			stroke.Thickness = 3
			stroke.Transparency = 0
		end
		Anim.Tween(dim, { BackgroundTransparency = 1 }, 0.15)
		Anim.Tween(scale, { Scale = 1.03 }, 0.2, Enum.EasingStyle.Back)
	elseif state == "Dimmed" then
		if stroke then
			stroke.Color = Theme.Color.Stroke
			stroke.Thickness = 1.5
			stroke.Transparency = 0.35
		end
		Anim.Tween(dim, { BackgroundTransparency = 0.5 }, 0.15)
		Anim.Tween(scale, { Scale = 0.97 }, 0.2)
	else
		if stroke then
			stroke.Color = Theme.Color.Stroke
			stroke.Thickness = 1.5
			stroke.Transparency = 0.35
		end
		Anim.Tween(dim, { BackgroundTransparency = 1 }, 0.15)
		Anim.Tween(scale, { Scale = 1 }, 0.2)
	end
end

local confirmChoice

local function clearSelection()
	selected = nil
	for _, card in pairs(cards) do
		setCardHighlight(card, "Normal")
	end
	if confirmBar then
		confirmBar.Visible = false
	end
end

local function selectChoice(choice)
	if busy or mode ~= "Scenario" then
		return
	end
	local card = cards[choice.Id]
	if choice.Locked then
		AudioController.Play("Locked")
		if card then
			Anim.Shake(card)
		end
		NotificationController.Notify({ Title = "Locked choice", Text = "🔒 " .. (choice.LockHint or "Not available yet"), Kind = "Warning", Duration = 3 })
		return
	end
	if selected == choice then
		confirmChoice()
		return
	end
	selected = choice
	AudioController.Play("Select")
	for id, c in pairs(cards) do
		setCardHighlight(c, if id == choice.Id then "Selected" else "Dimmed")
	end
	if confirmBar then
		local label = confirmBar:FindFirstChild("Choice") :: TextLabel
		label.Text = "You chose: <b>" .. choice.Text .. "</b>"
		confirmBar.Visible = true
		Anim.Pop(confirmBar, 0.9, 0.25)
		UIController.Focus(confirmBar:FindFirstChild("Confirm", true) :: GuiObject)
	end
end

local function buildCard(parent: Instance, choice, wide: boolean)
	local card = Create("TextButton", {
		Name = choice.Id,
		Text = "",
		AutoButtonColor = false,
		Selectable = true,
		BackgroundColor3 = Theme.Color.Surface,
		BackgroundTransparency = if choice.Locked then 0.45 else 0.02,
		Size = if wide then UDim2.new() else UDim2.new(1, 0, 0, 0),
		AutomaticSize = if wide then Enum.AutomaticSize.None else Enum.AutomaticSize.Y,
		LayoutOrder = choice.Index,
		Parent = parent,
	}, { Create.Corner(Theme.Radius), Create.Stroke() })

	-- Body holds the laid-out content; Dim sits on top and isn't part of the layout.
	local body = Create("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		Size = if wide then UDim2.fromScale(1, 1) else UDim2.new(1, 0, 0, 0),
		AutomaticSize = if wide then Enum.AutomaticSize.None else Enum.AutomaticSize.Y,
		Parent = card,
	}, { Create.Padding(16) })
	Create.List(Enum.FillDirection.Vertical, 8).Parent = body

	local top = Create("Frame", { Name = "Top", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 32), LayoutOrder = 1, Parent = body })
	local badge = Create("Frame", { Name = "Badge", BackgroundColor3 = Theme.Color.SurfaceHigher, Size = UDim2.fromOffset(32, 32), Parent = top }, { Create.Corner(Theme.RadiusPill) })
	Create.Label({ Text = if choice.Locked then "🔒" else tostring(choice.Index), FontFace = Theme.Font.Heavy, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = badge })
	if choice.Risky and not choice.Locked then
		local chip = Components.Chip({ Text = "🎲 Risky", Height = 28, TextSize = 14, Color = Theme.Color.SurfaceHigher, Parent = top })
		chip.AnchorPoint = Vector2.new(1, 0)
		chip.Position = UDim2.fromScale(1, 0)
	end

	local textTransparency = if choice.Locked then 0.45 else 0
	Create.Label({ Name = "Text", Text = choice.Text, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H3, TextTransparency = textTransparency, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = body })
	Create.Label({
		Name = "Description",
		Text = if choice.Locked then "🔒 " .. (choice.LockHint or "Locked") else (choice.Description or ""),
		TextSize = Theme.TextSize.Small,
		TextColor3 = if choice.Locked then Theme.Color.Warning else Theme.Color.TextDim,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 3,
		Parent = body,
	})
	if not choice.Locked then
		Create.Label({ Name = "Preview", Text = previewText(choice), RichText = true, FontFace = Theme.Font.Bold, TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, Parent = body })
		if choice.Tags and #choice.Tags > 0 then
			Create.Label({ Name = "Tags", Text = table.concat(choice.Tags, "  ·  "), FontFace = Theme.Font.Bold, TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.Gold, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 5, Parent = body })
		end
	end
	-- Dim overlay used when another card is selected.
	Create("Frame", { Name = "Dim", BackgroundColor3 = Theme.Color.Black, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = card }, { Create.Corner(Theme.Radius) })

	local stroke = card:FindFirstChildOfClass("UIStroke")
	card.SelectionGained:Connect(function()
		if selected ~= choice and stroke then
			stroke.Color = Theme.Color.Gold
			stroke.Thickness = 2.5
		end
	end)
	card.SelectionLost:Connect(function()
		if selected ~= choice and stroke then
			stroke.Color = Theme.Color.Stroke
			stroke.Thickness = 1.5
		end
	end)
	card.Activated:Connect(function()
		selectChoice(choice)
	end)
	cards[choice.Id] = card
	return card
end

function renderScenario(animateIn: boolean?)
	mode = "Scenario"
	local v = newView()
	local vs = UIController.GetVirtualSize()
	local narrow = UIController.IsNarrow()
	local width = math.min(1180, vs.X - 32)

	local scroll = Create("ScrollingFrame", {
		Name = "Scroll",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Color.Stroke,
		Selectable = false,
		Parent = v,
	})
	Create.List(Enum.FillDirection.Vertical, 18, Enum.HorizontalAlignment.Center).Parent = scroll
	Create.Padding(6, 16, if narrow then 150 else 110, 16).Parent = scroll

	-- Header: icon, title, age/stage line, description.
	local header = Create("Frame", { Name = "Header", BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = scroll })
	Create.List(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center).Parent = header
	local stage = LifeStages.Get(scenario.Stage)
	Create.Label({
		Text = ("AGE %d  ·  %s  ·  DECISION %d OF %d"):format(scenario.Age, string.upper(scenario.StageName), scenario.ScenarioNumber, scenario.ScenariosInStage),
		FontFace = Theme.Font.Heavy,
		TextSize = Theme.TextSize.Tiny,
		TextColor3 = stage.Color,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 18),
		LayoutOrder = 1,
		Parent = header,
	})
	Create.Label({
		Name = "Title",
		Text = scenario.Icon .. "  " .. scenario.Title,
		FontFace = Theme.Font.Heavy,
		TextSize = if narrow then 34 else Theme.TextSize.H1 + 4,
		TextXAlignment = Enum.TextXAlignment.Center,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		Parent = header,
	})
	local description = Create.Label({
		Text = scenario.Description,
		TextColor3 = Theme.Color.TextDim,
		TextSize = if narrow then Theme.TextSize.Body else 22,
		TextXAlignment = Enum.TextXAlignment.Center,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 3,
		Parent = header,
	})
	Create("UISizeConstraint", { MaxSize = Vector2.new(820, math.huge) }).Parent = description

	-- Choice cards: a responsive grid on wide screens, a list on narrow ones.
	local choicesFrame = Create("Frame", { Name = "Choices", BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = scroll })
	local count = #scenario.Choices
	if narrow then
		Create.List(Enum.FillDirection.Vertical, 12, Enum.HorizontalAlignment.Center).Parent = choicesFrame
	else
		local gap = 16
		local columns = math.clamp(math.floor((width + gap) / (210 + gap)), 1, count)
		if count == 4 and columns == 3 then
			columns = 2
		end
		local cellWidth = math.floor((width - gap * (columns - 1)) / columns)
		Create("UIGridLayout", {
			CellSize = UDim2.fromOffset(cellWidth, if columns >= 4 then 250 else 210),
			CellPadding = UDim2.fromOffset(gap, gap),
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Parent = choicesFrame,
		})
	end
	local firstOpen
	for i, choice in ipairs(scenario.Choices) do
		local card = buildCard(choicesFrame, choice, not narrow)
		if not choice.Locked and not firstOpen then
			firstOpen = card
		end
		if animateIn ~= false then
			Anim.Pop(card, 0.85, 0.3 + i * 0.06)
		end
	end

	-- Confirm bar pinned to the bottom of the content area.
	local barWidth = math.min(700, vs.X - 32)
	local bar = Components.Panel({
		Name = "ConfirmBar",
		Size = UDim2.fromOffset(barWidth, if narrow then 126 else 80),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Color = Theme.Color.SurfaceHigh,
		Padding = 12,
		Parent = v,
	})
	bar.ZIndex = 10
	bar.Visible = false
	Create.Label({
		Name = "Choice",
		RichText = true,
		Text = "",
		TextSize = Theme.TextSize.Body,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = narrow,
		Size = if narrow then UDim2.new(1, 0, 0, 44) else UDim2.new(1, -300, 1, 0),
		Parent = bar,
	})
	local buttons = Create("Frame", {
		Name = "Buttons",
		BackgroundTransparency = 1,
		Size = if narrow then UDim2.new(1, 0, 0, 54) else UDim2.new(0, 290, 1, 0),
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.fromScale(1, 1),
		Parent = bar,
	})
	Create.List(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center).Parent = buttons
	Components.Button({ Name = "Cancel", Text = "✕", Style = "Ghost", Size = UDim2.fromOffset(56, 54), LayoutOrder = 1, Parent = buttons, OnClick = function()
		clearSelection()
		UIController.Focus(firstOpen)
	end })
	Components.Button({ Name = "Confirm", Text = "Confirm", Icon = "✓", Style = "Primary", Size = if narrow then UDim2.new(1, -66, 0, 54) else UDim2.fromOffset(220, 54), LayoutOrder = 2, Parent = buttons, OnClick = function()
		confirmChoice()
	end })
	confirmBar = bar

	if selected then
		local keep = selected
		selected = nil
		selectChoice(keep)
	else
		UIController.Focus(firstOpen)
	end
end

-- ===== Outcome =====
local renderOutcome
local renderEvent
local advance

-- Adds change chips (stats, money, life changes, traits) to `parent`.
local function addChangeChips(parent: Instance, result, animateIn: boolean?, extra: { { Text: string, Color: Color3? } }?)
	local changeList = Create.List(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center)
	changeList.Wraps = true
	changeList.Parent = parent
	local order = 0
	local function addChip(text: string, color: Color3?)
		order += 1
		local chip = Components.Chip({ Text = text, Height = 38, TextColor = color, LayoutOrder = order, Parent = parent })
		if animateIn ~= false then
			Anim.Pop(chip, 0.6, 0.35 + order * 0.05)
		end
	end
	for _, text in ipairs(result.LifeChanges or {}) do
		addChip(text, Theme.Color.Gold)
	end
	local list = {}
	for stat, delta in pairs(result.Applied or {}) do
		if math.abs(delta) >= 0.05 then
			table.insert(list, { Stat = stat, Delta = delta })
		end
	end
	table.sort(list, function(a, b)
		return math.abs(a.Delta) > math.abs(b.Delta)
	end)
	for _, change in ipairs(list) do
		local info = StatDefinitions.Info[change.Stat]
		if info then
			addChip(("%s %s %s"):format(info.Icon, info.DisplayName, Format.Signed(change.Delta)), if change.Delta > 0 then Theme.Color.Positive else Theme.Color.Negative)
		end
	end
	if result.MoneyDelta and result.MoneyDelta ~= 0 then
		addChip("💰 " .. (if result.MoneyDelta > 0 then "+" else "") .. Format.Money(result.MoneyDelta), if result.MoneyDelta > 0 then Theme.Color.Positive else Theme.Color.Negative)
	end
	for _, change in ipairs(result.BondChanges or {}) do
		if math.abs(change.Delta) >= 1 then
			local role = People.Roles[change.Role]
			addChip(("%s %s %s"):format(if role then role.Icon else "👤", change.Name, Format.Signed(change.Delta)), if change.Delta > 0 then Theme.Color.Positive else Theme.Color.Negative)
		end
	end
	for _, item in ipairs(extra or {}) do
		addChip(item.Text, item.Color)
	end
	for _, traitId in ipairs(result.TraitsGained or {}) do
		local info = Traits.Info[traitId]
		if info then
			addChip("New trait: " .. info.Icon .. " " .. info.DisplayName, Theme.Color.Gold)
		end
	end
	if order == 0 then
		addChip("No big changes… for now.", Theme.Color.TextDim)
	end
end

function renderOutcome(animateIn: boolean?)
	mode = "Outcome"
	local v = newView()
	local vs = UIController.GetVirtualSize()
	local width = math.min(760, vs.X - 32)

	local scroll = Create("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		Selectable = false,
		Parent = v,
	})
	local list = Create.List(Enum.FillDirection.Vertical, 0, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	list.Parent = scroll
	Create.Padding(10, 16, 20, 16).Parent = scroll

	local panel = Components.Panel({ Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, Padding = 26, Parent = scroll })
	Create.List(Enum.FillDirection.Vertical, 14, Enum.HorizontalAlignment.Center).Parent = panel

	Create.Label({ Text = "WHAT HAPPENED", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.Primary, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 1, Parent = panel })
	if outcome.Lucky then
		Components.Chip({ Text = "🎲 Twist of fate!", Color = Theme.Color.SurfaceHigher, TextColor = Theme.Color.Gold, LayoutOrder = 2, Parent = panel })
	end
	local story = Create.Label({
		Name = "Story",
		Text = if outcome.Story ~= "" then outcome.Story else "Life goes on.",
		FontFace = Theme.Font.Medium,
		TextSize = Theme.TextSize.H3,
		TextXAlignment = Enum.TextXAlignment.Center,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 3,
		Parent = panel,
	})
	if animateIn ~= false and not Anim.Reduced then
		-- Typewriter reveal.
		story.MaxVisibleGraphemes = 0
		local total = utf8.len(story.Text) or #story.Text
		task.spawn(function()
			local shown = 0
			while shown < total and story.Parent do
				shown = math.min(total, shown + 3)
				story.MaxVisibleGraphemes = shown
				task.wait(1 / 60)
			end
			story.MaxVisibleGraphemes = -1
		end)
	end

	local changes = Create("Frame", { Name = "Changes", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, Parent = panel })
	local extra = {}
	if outcome.Years and outcome.Years > 0 and outcome.Income ~= 0 then
		if outcome.Income > 0 then
			table.insert(extra, { Text = ("💵 Earned %s over %d yr%s"):format(Format.Money(outcome.Income), outcome.Years, if outcome.Years == 1 then "" else "s"), Color = Theme.Color.Positive })
		else
			table.insert(extra, { Text = ("💸 Living costs %s over %d yr%s"):format(Format.Money(-outcome.Income), outcome.Years, if outcome.Years == 1 then "" else "s"), Color = Theme.Color.Negative })
		end
	end
	addChangeChips(changes, outcome, animateIn, extra)

	if outcome.StageCompleted then
		Create.Label({ Text = "🏁 " .. outcome.CompletedStageName .. " complete!", FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Gold, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 5, Parent = panel })
	elseif outcome.Age ~= outcome.PrevAge then
		Create.Label({ Text = "🎂 Next: age " .. outcome.Age, FontFace = Theme.Font.Bold, TextColor3 = Theme.Color.TextDim, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 5, Parent = panel })
	end

	continueButton = Components.Button({
		Name = "Continue",
		Text = "Continue",
		Icon = "▶",
		Style = "Primary",
		Size = UDim2.fromOffset(math.min(320, width - 52), 60),
		LayoutOrder = 6,
		Parent = panel,
		OnClick = function()
			advance()
		end,
	})
	if animateIn ~= false then
		Anim.Pop(panel, 0.9)
	end
	UIController.Focus(continueButton)
end

-- ===== Random life event =====
local RARITY_STYLE = {
	Common = { Label = "LIFE EVENT", Color = Theme.Color.Accent },
	Uncommon = { Label = "UNCOMMON EVENT", Color = Theme.Color.Positive },
	Rare = { Label = "✨ RARE EVENT ✨", Color = Theme.Color.AccentAlt },
	Legendary = { Label = "🌟 LEGENDARY EVENT 🌟", Color = Theme.Color.Gold },
}

function renderEvent(event, animateIn: boolean?)
	mode = "Event"
	local v = newView()
	local style = RARITY_STYLE[event.Rarity] or RARITY_STYLE.Common
	local width = math.min(720, UIController.GetVirtualSize().X - 32)
	local scroll = Create("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		Selectable = false,
		Parent = v,
	})
	Create.List(Enum.FillDirection.Vertical, 0, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center).Parent = scroll
	Create.Padding(10, 16, 20, 16).Parent = scroll
	local panel = Components.Panel({ Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, Padding = 26, Parent = scroll })
	local stroke = panel:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = style.Color
		stroke.Thickness = if event.Rarity == "Legendary" then 4 else 2.5
		stroke.Transparency = 0
	end
	Create.List(Enum.FillDirection.Vertical, 12, Enum.HorizontalAlignment.Center).Parent = panel
	Create.Label({ Text = style.Label, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.Small, TextColor3 = style.Color, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 1, Parent = panel })
	local icon = Create.Label({ Text = event.Icon, TextSize = 64, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 72), LayoutOrder = 2, Parent = panel })
	Create.Label({ Text = event.Title, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = panel })
	Create.Label({ Text = event.Story, TextSize = Theme.TextSize.H3, TextColor3 = Theme.Color.TextDim, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, Parent = panel })
	local changes = Create("Frame", { Name = "Changes", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 5, Parent = panel })
	addChangeChips(changes, event, animateIn)
	continueButton = Components.Button({
		Name = "Continue",
		Text = "Continue",
		Icon = "▶",
		Style = if event.Rarity == "Legendary" then "Primary" else "Accent",
		Size = UDim2.fromOffset(math.min(320, width - 52), 60),
		LayoutOrder = 6,
		Parent = panel,
		OnClick = function()
			advance()
		end,
	})
	if animateIn ~= false then
		Anim.Pop(panel, 0.8, 0.45)
		Anim.Pop(icon, 0.4, 0.6)
	end
	AudioController.Play(if event.Rarity == "Rare" or event.Rarity == "Legendary" then "StageComplete" else "Notify")
	UIController.Focus(continueButton)
end

-- ===== Transitions =====
local function transition(big: string, small: string, color: Color3, hold: number)
	mode = "Transition"
	local v = newView()
	v.BackgroundColor3 = Theme.Color.Background
	v.BackgroundTransparency = 0.2
	local skip = false
	local skipper = Create("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Selectable = false, Parent = v })
	skipper.Activated:Connect(function()
		skip = true
	end)
	local bigLabel = Create.Label({
		Text = big,
		FontFace = Theme.Font.Heavy,
		TextSize = if UIController.IsNarrow() then 52 else 76,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.new(1, -40, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = v,
	})
	Create.Label({
		Text = small,
		FontFace = Theme.Font.Bold,
		TextSize = Theme.TextSize.H3,
		TextColor3 = Theme.Color.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.56),
		Size = UDim2.new(1, -40, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = v,
	})
	Anim.Pop(bigLabel, 0.6, 0.5)
	local elapsed = 0
	local total = if Anim.Reduced then math.min(hold, 0.8) else hold
	while elapsed < total and not skip and view == v do
		elapsed += task.wait()
	end
end

function advance()
	if busy or not outcome then
		return
	end
	if pendingEvent then
		shownEvent = pendingEvent
		pendingEvent = nil
		renderEvent(shownEvent, true)
		return
	end
	busy = true
	shownEvent = nil
	local o = outcome
	local finalAction = nil
	if o.Reveal then
		-- LIFE REVEAL at the end of every stage.
		mode = "Reveal"
		newView()
		RevealController.PlayStage(o.Reveal)
	elseif o.LifeCompleted and o.Final then
		mode = "Reveal"
		newView()
		finalAction = RevealController.PlayFinal(o.Final)
	elseif o.StageCompleted then
		AudioController.Play("StageComplete")
		local nextStage = LifeStages.Get(o.Stage)
		local subtitle = if o.LifeCompleted then "Your story is complete." else ("%s begin · Age %d"):format(o.StageName, o.Age)
		transition("🏁 " .. o.CompletedStageName .. " complete!", subtitle, nextStage.Color, 2.6)
	elseif o.Age ~= o.PrevAge then
		AudioController.Play("AgeUp")
		transition("🎂 Age " .. o.Age, "", Theme.Color.Gold, 1.3)
	end
	busy = false
	outcome = nil
	if finalAction == "Again" then
		UIController.Show("SlotSelect", "New")
		return
	elseif finalAction == "History" then
		UIController.Show("LifeHistory")
		return
	end
	if UIController.Current() ~= "Game" then
		return
	end
	if o.LifeCompleted then
		showLifeComplete()
	elseif not o.NextStageAvailable then
		showUnavailable()
	else
		DecisionController.Next()
	end
end

function confirmChoice()
	if busy or mode ~= "Scenario" or not selected or not scenario then
		return
	end
	busy = true
	local choice = selected
	AudioController.Play("Confirm")
	for id, card in pairs(cards) do
		card.Active = false
		if id ~= choice.Id then
			Anim.Tween(card:FindFirstChild("Dim"), { BackgroundTransparency = 0.25 }, 0.2)
		end
	end
	if confirmBar then
		confirmBar.Visible = false
	end
	local selectedCard = cards[choice.Id]
	if selectedCard then
		Anim.Tween(Anim.Scale(selectedCard), { Scale = 1.08 }, 0.25, Enum.EasingStyle.Back)
	end

	local ok, result = invoke("MakeChoice", scenario.Id, choice.Id)
	busy = false
	if not ok then
		if result == "WrongScenario" or result == "NoLife" or result == "ChoiceLocked" then
			-- Our view was out of date (e.g. money was spent in the Money panel).
			DecisionController.Next()
		else
			NotificationController.Notify({ Title = "Couldn't make that choice", Text = tostring(result), Kind = "Error" })
			selected = nil
			renderScenario(false)
		end
		return
	end
	AudioController.Play(if (result.Applied.Happiness or 0) >= 0 then "Positive" else "Negative")
	task.wait(if Anim.Reduced then 0 else 0.3)
	outcome = result
	pendingEvent = result.Event
	scenario = nil
	selected = nil
	if UIController.Current() == "Game" then
		renderOutcome(true)
	end
end

-- ===== Loop =====
function DecisionController.Next()
	requestToken += 1
	local token = requestToken
	showLoading()
	local ok, payload = invoke("GetScenario")
	if token ~= requestToken or UIController.Current() ~= "Game" then
		return
	end
	if ok then
		scenario = payload
		selected = nil
		renderScenario(true)
	elseif payload == "NoLife" then
		UIController.Show("Menu")
	elseif payload == "StageNotAvailable" then
		showUnavailable()
	elseif payload == "LifeComplete" then
		showLifeComplete()
	else
		showError(payload)
	end
end

-- Re-fetches the current scenario so locked/unlocked choices reflect the
-- latest money, people and stats (called after People/Money panel actions).
function DecisionController.Refresh()
	if mode ~= "Scenario" or busy or not scenario then
		return
	end
	local keep = selected and selected.Id
	local ok, payload = invoke("GetScenario")
	if ok and mode == "Scenario" and UIController.Current() == "Game" then
		scenario = payload
		selected = nil
		renderScenario(false)
		if keep then
			for _, choice in ipairs(payload.Choices) do
				if choice.Id == keep and not choice.Locked then
					selectChoice(choice)
				end
			end
		end
	end
end

function DecisionController.GetMode(): string
	return mode
end

local KEY_INDEX = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.Five] = 5,
}

function DecisionController.Init()
	content = HUDController.Content :: Frame
end

function DecisionController.Start()
	HUDController.Opened:Connect(function()
		-- Returning mid-way restores exactly where the player was.
		if outcome and shownEvent then
			renderEvent(shownEvent, false)
		elseif outcome then
			renderOutcome(false)
		else
			DecisionController.Next()
		end
	end)
	HUDController.Closed:Connect(function()
		requestToken += 1
		mode = "Idle"
		ContextActionService:UnbindAction("CYL_CancelChoice")
	end)
	UIController.LayoutChanged:Connect(function()
		if UIController.Current() ~= "Game" then
			return
		end
		if mode == "Scenario" and scenario then
			renderScenario(false)
		elseif mode == "Outcome" and outcome then
			renderOutcome(false)
		elseif mode == "Event" and shownEvent then
			renderEvent(shownEvent, false)
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or UIController.Current() ~= "Game" or UIController.IsModalOpen() then
			return
		end
		local index = KEY_INDEX[input.KeyCode]
		if index and mode == "Scenario" and scenario and scenario.Choices[index] then
			selectChoice(scenario.Choices[index])
		elseif input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter then
			if mode == "Scenario" and selected then
				confirmChoice()
			elseif mode == "Outcome" or mode == "Event" then
				advance()
			end
		end
	end)

	-- Gamepad B clears a selection instead of leaving the game screen.
	HUDController.Opened:Connect(function()
		ContextActionService:BindAction("CYL_CancelChoice", function(_, state)
			if state == Enum.UserInputState.Begin and mode == "Scenario" and selected then
				clearSelection()
				return Enum.ContextActionResult.Sink
			end
			return Enum.ContextActionResult.Pass
		end, false, Enum.KeyCode.ButtonB)
	end)
end

return DecisionController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="115">
            <Properties>
              <string name="Name">DialogueController</string>
              <string name="Source"><![CDATA[--[[
	DialogueController  (StarterPlayerScripts.Client.Controllers.DialogueController)
	Talking to the people of Lifeville (Shared/Data/NPCs). Their greeting
	depends on your life stage and career. Options can reply, do a world
	action right there (the server checks you're next to them), open a
	screen (shop, bank, map, Hall of Lives), point the way on the map, or
	give a tip.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local NPCs = require(Shared.Data.NPCs)
local WorldSpots = require(Shared.Data.WorldSpots)
local World = require(Shared.Data.World)
local Config = require(Shared.Config)
local Format = require(Shared.Util.Format)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Components = require(UILib.Components)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local ExploreController = require(script.Parent.ExploreController)

local DialogueController = {}
DialogueController.Priority = 54

local tipIndex = 0

local function activeLife()
	local life = DataController.GetActiveLife()
	return if life and not life.Completed then life else nil
end

function DialogueController.Tip(): string
	local life = activeLife()
	if life then
		if ExploreController.ActionsLeft(life) == 0 then
			return "You've used your actions for now. Press 📝 Next decision to move your life on, then come back!"
		end
		if life.Career.Id == "None" and life.Age >= 19 then
			return "No job yet? The careers fair in Lifeville Tower (Downtown) builds Career Success."
		end
	end
	tipIndex = tipIndex % #Config.LoadingTips + 1
	return Config.LoadingTips[tipIndex]
end

function DialogueController.Open(npcId: string)
	local npc = NPCs.ById[npcId]
	if not npc then
		return
	end
	task.spawn(Net.Invoke, "Talk", npcId) -- counts for achievements and challenges
	local handle = UIController.OpenPanel({ Name = "DialogueModal", Title = (npc.Icon or "💬") .. "  " .. npc.Name, Width = 600, Height = 560 })
	handle.Subtitle.Text = npc.Role or ""
	local life = activeLife()
	local age = if life then life.Age else 5

	local function render(line: string, note: string?)
		handle.Clear()
		local bubble = Components.Panel({ Name = "Speech", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Padding = 16, Color = Theme.Color.SurfaceHigh, LayoutOrder = 1, Parent = handle.Scroll })
		Create.Label({ Name = "Line", Text = "“" .. line .. "”", AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.fromScale(1, 0), Parent = bubble })
		if note then
			Create.Label({ Name = "Note", Text = note, TextColor3 = Theme.Color.Warning, TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.fromScale(1, 0), LayoutOrder = 2, Parent = handle.Scroll })
		end
		local order = 10
		for i, option in ipairs(npc.Options or {}) do
			if NPCs.OptionVisible(option, age) then
				order += 1
				local label = option.Text
				local icon = "💬"
				if option.Spot then
					local def = WorldSpots.Get(option.Spot)
					local cost = if def and life then WorldSpots.CostFor(def, life.Age) else 0
					icon = "⚡"
					if cost > 0 then
						label ..= " (" .. Format.Money(cost) .. ")"
					end
				elseif option.Open then
					icon = "➡️"
				elseif option.Guide then
					icon = "🧭"
				elseif option.Tip then
					icon = "💡"
				end
				Components.Button({ Name = "Option" .. i, Text = label, Icon = icon, Style = if option.Spot then "Primary" else "Secondary", Size = UDim2.new(1, 0, 0, 50), TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = order, Parent = handle.Scroll, OnClick = function()
					if option.Reply then
						render(option.Reply)
					elseif option.Tip then
						render(DialogueController.Tip())
					elseif option.Open then
						UIController.ClosePanel()
						ExploreController.OpenScreen(option.Open)
					elseif option.Guide then
						UIController.ClosePanel()
						require(script.Parent.MapController).SetWaypoint(option.Guide)
					elseif option.Spot then
						local ok, result = ExploreController.UseSpot(option.Spot, npc.Id)
						if handle.IsOpen() then
							if ok then
								render(result.Text or "Done!", ("⚡ %d action%s left before your next decision."):format(result.ActionsLeft or 0, if result.ActionsLeft == 1 then "" else "s"))
							else
								render(NPCs.LineFor(npc, life), ExploreController.ReasonText(result, WorldSpots.Get(option.Spot)))
							end
						end
					end
				end })
			end
		end
		if npc.Options and life and ExploreController.ActionsLeft(life) == 0 then
			Create.Label({ Name = "NoActions", Text = "⚡ No actions left until your next decision.", TextColor3 = Theme.Color.TextFaint, TextSize = Theme.TextSize.Tiny, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.fromScale(1, 0), LayoutOrder = 90, Parent = handle.Scroll })
		end
		Components.Button({ Name = "Goodbye", Text = "Goodbye", Icon = "👋", Style = "Ghost", Size = UDim2.new(1, 0, 0, 46), TextSize = 17, LayoutOrder = 99, Parent = handle.Scroll, OnClick = UIController.ClosePanel })
	end

	render(NPCs.LineFor(npc, life))
	return handle
end

-- Which district an NPC lives in (from their anchor), for the map and tips.
function DialogueController.DistrictOf(npcId: string): string?
	local world = workspace:FindFirstChild("World")
	local anchor = world and world:FindFirstChild("NPCAnchors") and world.NPCAnchors:FindFirstChild(npcId)
	return if anchor then World.DistrictAt(anchor.Position.X, anchor.Position.Z) else nil
end

function DialogueController.Init() end
function DialogueController.Start() end

return DialogueController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="116">
            <Properties>
              <string name="Name">DoorsController</string>
              <string name="Source"><![CDATA[--[[
	DoorsController  (StarterPlayerScripts.Client.Controllers.DoorsController)
	Automatic sliding glass doors (parts tagged CYL_Door by the world
	builder): each panel slides open when any character comes within
	OpenDistance studs and closes again after they leave. Panels never
	collide, so nobody can get stuck; the animation runs on each client.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Anim = require(UILib.Anim)

local ExploreController = require(script.Parent.ExploreController)

local DoorsController = {}
DoorsController.Priority = 58
DoorsController.OpenDistance = 11

local doors: { [BasePart]: { Closed: CFrame, Open: CFrame, IsOpen: boolean } } = {}

local function track(panel: BasePart)
	if doors[panel] then
		return
	end
	local slide = panel:GetAttribute("SlideX") or 2
	doors[panel] = { Closed = panel.CFrame, Open = panel.CFrame * CFrame.new(slide, 0, 0), IsOpen = false }
	panel.Destroying:Connect(function()
		doors[panel] = nil
	end)
end

function DoorsController.Doors()
	return doors
end

function DoorsController.Step()
	local positions = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root then
			table.insert(positions, root.Position)
		end
	end
	for panel, door in pairs(doors) do
		local near = false
		local centre = door.Closed.Position
		for _, p in ipairs(positions) do
			if (p - centre).Magnitude < DoorsController.OpenDistance then
				near = true
				break
			end
		end
		if near ~= door.IsOpen then
			door.IsOpen = near
			Anim.Tween(panel, { CFrame = if near then door.Open else door.Closed }, 0.35)
		end
	end
end

function DoorsController.Init() end

function DoorsController.Start()
	for _, panel in ipairs(CollectionService:GetTagged("CYL_Door")) do
		track(panel)
	end
	CollectionService:GetInstanceAddedSignal("CYL_Door"):Connect(track)
	while true do
		task.wait(0.2)
		if ExploreController.IsExploring() then
			DoorsController.Step()
		end
	end
end

return DoorsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="117">
            <Properties>
              <string name="Name">ExploreController</string>
              <string name="Source"><![CDATA[--[[
	ExploreController  (StarterPlayerScripts.Client.Controllers.ExploreController)
	🌆 Explore mode: walk around Lifeville with your character.
	  • Enter from the HUD (🌆) or the main menu (Explore Lifeville).
	  • A slim top bar: your look and age, money, actions left, 🗺️ Map and
	    📝 Next decision (back to the decision cards).
	  • Character controls and ProximityPrompts are only on while exploring.
	  • Walk up to things (E / tap / gamepad X): study, work out, eat out, work
	    a shift... Each uses 1 of your 2 actions between decisions. The server
	    checks everything (WorldService); results show as a card.
	  • Talk to people (DialogueController), open the shop, the bank (Money),
	    the Hall of Lives (choose a life) and the town map.
	  • A banner names each district as you walk in (locked ones say when
	    they open).
]]

local CollectionService = game:GetService("CollectionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Format = require(Shared.Util.Format)
local People = require(Shared.Util.People)
local World = require(Shared.Data.World)
local WorldSpots = require(Shared.Data.WorldSpots)
local StatDefinitions = require(Shared.Data.StatDefinitions)
local Careers = require(Shared.Data.Careers)
local LifeStages = require(Shared.Data.LifeStages)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Anim = require(UILib.Anim)
local Components = require(UILib.Components)
local Avatar = require(UILib.Avatar)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local ControlsController = require(script.Parent.ControlsController)
local AudioController = require(script.Parent.AudioController)
local StyleController = require(script.Parent.StyleController)
local HUDController = require(script.Parent.HUDController)

local ExploreController = {}
ExploreController.Priority = 53
ExploreController.Changed = Signal.new() -- (exploring: boolean)
ExploreController.DistrictChanged = Signal.new() -- (districtId?)

local frame: CanvasGroup
local refs: { [string]: any } = {}
local exploring = false
local currentDistrict: string? = nil
local busy = false
local cardToken = 0

local REASONS = {
	NoActionsLeft = "No actions left. Make your next decision to get more time.",
	NotYourHome = "That's someone else's home. Yours has your name on the sign.",
	TooFar = "Walk a little closer first.",
	NoLife = "Start a life first: press 📝 or visit the Hall of Lives.",
	NoCharacter = "Your character is still arriving. Try again in a moment.",
	NotLoaded = "Still loading your life…",
	RateLimited = "Slow down a moment.",
	BadSpot = "Nothing to do here.",
}

-- Lazily required (they require controllers that load after this one).
local function controller(name: string)
	return require(script.Parent:FindFirstChild(name))
end

local function activeLife()
	local life = DataController.GetActiveLife()
	if life and not life.Completed then
		return life
	end
	return nil
end

function ExploreController.ActionsLeft(life): number
	if not life then
		return 0
	end
	if life.ActionTurn ~= #life.Decisions then
		return People.ActionsPerTurn
	end
	return math.max(0, People.ActionsPerTurn - life.ActionsUsed)
end

function ExploreController.IsExploring(): boolean
	return exploring
end

function ExploreController.CurrentDistrict(): string?
	return currentDistrict
end

local function careerNames(workplaceId: string): string
	local names = {}
	for _, id in ipairs(World.Workplaces[workplaceId].Careers) do
		local info = Careers.Info[id]
		if info then
			table.insert(names, info.Icon .. " " .. Careers.TitleAt(id, 1):gsub("^Junior ", ""):gsub("^Trainee ", ""))
		end
	end
	return table.concat(names, ", ")
end

function ExploreController.ReasonText(reason: string?, spotDef): string
	local life = activeLife()
	if spotDef then
		if reason == "NeedFlag" and spotDef.FlagText then
			return spotDef.FlagText
		elseif reason == "TooYoung" and spotDef.MinAge then
			return ("You need to be %d or older for this."):format(spotDef.MinAge)
		elseif reason == "TooOld" and spotDef.MaxAge then
			return ("This is for ages %d and under."):format(spotDef.MaxAge)
		elseif reason == "Locked" then
			local lock = spotDef.Lock and World.Locks[spotDef.Lock] or World.ById[spotDef.District]
			return ("🔒 %s. %s."):format(lock.Name, World.UnlockText(lock.UnlockStage))
		elseif (reason == "NoJob" or reason == "WrongJob") and spotDef.Workplace then
			return "Only for people who work here: " .. careerNames(spotDef.Workplace) .. "."
		elseif reason == "NotEnoughMoney" and life then
			return ("This costs %s. You have %s."):format(Format.Money(WorldSpots.CostFor(spotDef, life.Age)), Format.Money(life.Money))
		end
	end
	return REASONS[reason or ""] or tostring(reason)
end

-- ===== Result card =====
local function hideCard(token: number)
	task.delay(4.5, function()
		if cardToken == token and refs.Card then
			Anim.Tween(refs.Card, { GroupTransparency = 1 }, 0.3)
		end
	end)
end

local function showCard(title: string, body: string, chips: { { Text: string, Color: Color3 } }?, kind: string?)
	local card = refs.Card :: CanvasGroup?
	if not card then
		return
	end
	cardToken += 1
	Create.Clear(card) -- keeps the card's layout, padding, corner and stroke
	local accent = if kind == "Problem" then Theme.Color.Warning else Theme.Color.Positive
	card:FindFirstChildOfClass("UIStroke").Color = accent
	Create.Label({ Name = "Title", Text = title, FontFace = Theme.Font.Heavy, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.fromScale(1, 0), LayoutOrder = 1, Parent = card })
	Create.Label({ Name = "Body", Text = body, TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.Small, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.fromScale(1, 0), LayoutOrder = 2, Parent = card })
	if chips and #chips > 0 then
		local row = Create("Frame", { Name = "Chips", BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.fromOffset(0, 32), LayoutOrder = 3, Parent = card })
		local list = Create.List(Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center)
		list.Wraps = true
		list.Parent = row
		for i, chip in ipairs(chips) do
			local c = Components.Chip({ Text = chip.Text, Height = 30, TextColor = chip.Color, LayoutOrder = i, Parent = row })
			c.Name = "Chip"
		end
	end
	card.Visible = true
	card.GroupTransparency = 0
	Anim.Pop(card, 0.85, 0.25)
	hideCard(cardToken)
end
ExploreController.ShowCard = showCard

local function resultChips(result)
	local chips = {}
	local applied = result.Applied or {}
	for _, stat in ipairs(StatDefinitions.Order) do
		local delta = applied[stat]
		if delta and math.abs(delta) >= 0.5 then
			local info = StatDefinitions.Info[stat]
			table.insert(chips, { Text = ("%s %s%d"):format(info.Icon, if delta > 0 then "+" else "−", math.floor(math.abs(delta) + 0.5)), Color = if delta > 0 then Theme.Color.Positive else Theme.Color.Negative })
		end
	end
	if result.MoneyDelta and result.MoneyDelta ~= 0 then
		table.insert(chips, { Text = (if result.MoneyDelta > 0 then "💰 +" else "💰 −") .. Format.Money(math.abs(result.MoneyDelta)), Color = if result.MoneyDelta > 0 then Theme.Color.Positive else Theme.Color.Negative })
	end
	for _, bond in ipairs(result.BondChanges or {}) do
		if bond.Delta and bond.Delta > 0 then
			table.insert(chips, { Text = ("❤️ %s +%d"):format(bond.Name, math.floor(bond.Delta + 0.5)), Color = Theme.Color.Positive })
		end
	end
	return chips
end

-- Runs a world action through the server and shows what happened.
function ExploreController.UseSpot(spotId: string, npcId: string?): (boolean, any)
	local def = WorldSpots.Get(spotId)
	if not def or busy then
		return false, "Busy"
	end
	if not activeLife() then
		showCard(def.Label, ExploreController.ReasonText("NoLife"), nil, "Problem")
		return false, "NoLife"
	end
	busy = true
	local ok, result = Net.Invoke("WorldAction", spotId, npcId)
	busy = false
	if ok then
		local left = result.ActionsLeft or 0
		local body = result.Text or ""
		if result.Story then
			body = body .. "\n✨ " .. result.Story
		end
		body = body .. "\n" .. (if left > 0 then ("⚡ %d action%s left before your next decision."):format(left, if left == 1 then "" else "s") else "⚡ That was your last action. 📝 Make your next decision for more.")
		showCard(def.Label .. " ✓", body, resultChips(result), "Result")
		AudioController.Play(if spotId == "Plaza_Wish" then "Splash" else "Positive")
	else
		showCard(def.Label, ExploreController.ReasonText(result, def), nil, "Problem")
		AudioController.Play("Locked")
	end
	ExploreController.UpdateBar()
	return ok, result
end

-- Screens a spot (or an NPC) can open.
function ExploreController.OpenScreen(name: string)
	local needsLife = { Money = true, People = true, Future = true }
	if needsLife[name] and not activeLife() then
		showCard("Not yet", ExploreController.ReasonText("NoLife"), nil, "Problem")
		return
	end
	if name == "Shop" then
		controller("ShopController").Open()
	elseif name == "Money" then
		controller("FinanceController").Open()
	elseif name == "People" then
		controller("PeopleController").Open()
	elseif name == "Future" then
		controller("FutureController").Open()
	elseif name == "Map" then
		controller("MapController").Open()
	elseif name == "SlotSelect" then
		local data = DataController.Get()
		local any = false
		for _, slot in pairs(data and data.Slots or {}) do
			if type(slot) == "table" then
				any = true
			end
		end
		if any then
			UIController.Show("SlotSelect", "Continue")
		else
			controller("MenuController").QuickPlay()
		end
	end
end

local function onPrompt(prompt: ProximityPrompt)
	if not exploring then
		return
	end
	local spotId = prompt:GetAttribute("CYL_Spot")
	local npcId = prompt:GetAttribute("CYL_NPC")
	local starId = prompt:GetAttribute("CYL_Star")
	if type(starId) == "string" then
		controller("CollectiblesController").Collect(starId)
	elseif type(spotId) == "string" then
		local def = WorldSpots.Get(spotId)
		if def and def.Kind == "Open" then
			ExploreController.OpenScreen(def.Open)
		elseif def then
			ExploreController.UseSpot(spotId)
		end
	elseif type(npcId) == "string" then
		controller("DialogueController").Open(npcId)
	end
end
ExploreController.HandlePrompt = onPrompt

-- ===== Prompts and pedestals, personalised for this life =====
local function myPlotIndex(): number?
	local world = workspace:FindFirstChild("World")
	local plots = world and world:FindFirstChild("Plots")
	if not plots then
		return nil
	end
	for _, plot in ipairs(plots:GetChildren()) do
		if plot:GetAttribute("OwnerUserId") == Players.LocalPlayer.UserId then
			return plot:GetAttribute("Index")
		end
	end
	return nil
end
ExploreController.MyPlotIndex = myPlotIndex

function ExploreController.RefreshPrompts()
	local life = activeLife()
	local mine = myPlotIndex()
	for _, part in ipairs(CollectionService:GetTagged("CYL_Spot")) do
		local def = WorldSpots.Get(part:GetAttribute("CYL_Spot"))
		local prompt = part:FindFirstChildOfClass("ProximityPrompt")
		if def and prompt then
			local enabled = true
			if def.Kind == "Shift" then
				enabled = life ~= nil and not life.Flags.Retired and World.WorkplaceOf[life.Career.Id] == def.Workplace
			elseif def.OwnHome then
				enabled = mine ~= nil and part:GetAttribute("Plot") == mine
			end
			prompt.Enabled = enabled
			local text = def.Label
			if life then
				local cost = WorldSpots.CostFor(def, life.Age)
				if (def.MinAge and life.Age < def.MinAge) or (def.MaxAge and life.Age > def.MaxAge) or (def.Flag and not life.Flags[def.Flag]) then
					text = "🔒 " .. text
				elseif cost > 0 then
					text = text .. " · " .. Format.Money(cost)
				end
			end
			prompt.ActionText = text
		end
	end
end

local function refreshPedestals()
	local data = DataController.Get()
	for _, sign in ipairs(CollectionService:GetTagged("CYL_Pedestal")) do
		local slotId = sign:GetAttribute("Slot")
		local life = data and data.Slots[slotId]
		local gui = sign:FindFirstChild("Text")
		local label = gui and gui:FindFirstChild("Label")
		if label then
			if type(life) == "table" then
				label.Text = if life.Completed then ("✔ %s · lived to %d"):format(life.Name, life.Age) else ("%s · age %d"):format(life.Name, life.Age)
			else
				label.Text = "Empty · begin a new life"
			end
		end
	end
end

-- ===== Top bar =====
local function barHeight(): number
	return if UIController.IsNarrow() then 112 else 66
end

function ExploreController.UpdateBar()
	if not refs.Name then
		return
	end
	local life = activeLife()
	local style = StyleController.Get()
	local name = if life then life.Name else (Players.LocalPlayer.DisplayName or "You")
	refs.Name.Text = style.Face .. " " .. Avatar.NameRich(name, style)
	local district = currentDistrict and World.ById[currentDistrict]
	local place = if district then district.Icon .. " " .. district.Name else "🛣️ " .. World.TownName
	if life then
		local stage = LifeStages.Get(life.Stage)
		refs.Sub.Text = ("Age %d · %s · %s"):format(life.Age, stage.DisplayName, place)
		refs.Money:FindFirstChild("Label").Text = "💰 " .. Format.Money(life.Money)
		local left = ExploreController.ActionsLeft(life)
		refs.Actions:FindFirstChild("Label").Text = ("⚡ %d/%d actions"):format(left, People.ActionsPerTurn)
		refs.Actions:FindFirstChild("Label").TextColor3 = if left > 0 then Theme.Color.Text else Theme.Color.Warning
	else
		refs.Sub.Text = "No life yet · " .. place
		refs.Money:FindFirstChild("Label").Text = "💰 —"
		refs.Actions:FindFirstChild("Label").Text = "⚡ —"
	end
	Components.SetText(refs.Next, if life then (if UIController.IsNarrow() then "📝" else "📝  Next decision") else (if UIController.IsNarrow() then "✨" else "✨  Start a life"))
end

local function render()
	Create.Clear(frame, true)
	refs = {}
	local narrow = UIController.IsNarrow()
	local height = barHeight()
	local bar = Create("Frame", { Name = "TopBar", BackgroundColor3 = Theme.Color.Surface, BackgroundTransparency = 0.12, Position = UDim2.fromOffset(12, 10), Size = UDim2.new(1, -24, 0, height), Parent = frame }, { Create.Corner(Theme.Radius), Create.Stroke(), Create.Padding(8, 12) })
	local top = Create("Frame", { Name = "Row1", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 50), Parent = bar })
	Components.Button({ Name = "Menu", Text = "≡", Style = "Secondary", Size = UDim2.fromOffset(50, 50), TextSize = 28, Parent = top, OnClick = function()
		UIController.Show("Menu")
	end })
	local rightWidth = if narrow then 50 else 236 + 8 + 130
	local identity = Create("Frame", { Name = "Identity", BackgroundTransparency = 1, Position = UDim2.fromOffset(62, 0), Size = UDim2.new(1, -(62 + rightWidth + (if narrow then 8 else 300)), 0, 50), Parent = top })
	if narrow then
		identity.Size = UDim2.new(1, -(62 + rightWidth + 8), 0, 50)
	end
	refs.Name = Create.Label({ Name = "Name", RichText = true, FontFace = Theme.Font.Heavy, TextSize = 20, Size = UDim2.new(1, 0, 0, 26), TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = identity })
	refs.Sub = Create.Label({ Name = "Sub", TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextDim, Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 22), TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = identity })
	local right = Create("Frame", { Name = "Right", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(rightWidth, 50), Parent = top })
	Create.List(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right).Parent = right
	local chips = right
	if narrow then
		local row2 = Create("Frame", { Name = "Row2", BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 56), Size = UDim2.new(1, 0, 0, 40), Parent = bar })
		Create.List(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center).Parent = row2
		chips = row2
	else
		local middle = Create("Frame", { Name = "Chips", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -(rightWidth + 8), 0, 5), Size = UDim2.fromOffset(292, 40), Parent = top })
		Create.List(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center).Parent = middle
		chips = middle
	end
	refs.Money = Components.Chip({ Text = "", Height = 40, LayoutOrder = 1, Parent = chips })
	refs.Money.Name = "Money"
	refs.Actions = Components.Chip({ Text = "", Height = 40, LayoutOrder = 2, Parent = chips })
	refs.Actions.Name = "ActionsLeft"
	Components.Button({ Name = "Map", Text = if narrow then "🗺️ Map" else "Map", Icon = if narrow then nil else "🗺️", Style = "Secondary", Size = UDim2.fromOffset(if narrow then 110 else 130, if narrow then 40 else 50), TextSize = 18, LayoutOrder = 3, Parent = if narrow then chips else right, OnClick = function()
		controller("MapController").Open()
	end })
	refs.Next = Components.Button({ Name = "NextDecision", Text = "", Style = "Primary", Size = UDim2.fromOffset(if narrow then 50 else 236, 50), TextSize = if narrow then 24 else 19, LayoutOrder = 4, Parent = right, OnClick = function()
		if activeLife() then
			UIController.Show("Game")
		else
			controller("MenuController").QuickPlay()
		end
	end })

	-- District banner and result card (under the bar, clear of touch controls)
	refs.Banner = Create("CanvasGroup", { Name = "Banner", BackgroundColor3 = Theme.Color.Surface, BackgroundTransparency = 0.1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, height + 22), Size = UDim2.fromOffset(math.min(520, UIController.GetVirtualSize().X - 40), 64), GroupTransparency = 1, Visible = false, Parent = frame }, { Create.Corner(Theme.Radius), Create.Stroke(Theme.Color.Gold, 2, 0.2) })
	Create.Label({ Name = "Title", FontFace = Theme.Font.Heavy, TextSize = 22, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 4), Parent = refs.Banner })
	Create.Label({ Name = "Blurb", TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextDim, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, -20, 0, 24), Position = UDim2.fromOffset(10, 36), TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = refs.Banner })
	refs.Card = Create("CanvasGroup", { Name = "ResultCard", BackgroundColor3 = Theme.Color.Surface, BackgroundTransparency = 0.05, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, height + 96), Size = UDim2.fromOffset(math.min(560, UIController.GetVirtualSize().X - 40), 0), AutomaticSize = Enum.AutomaticSize.Y, GroupTransparency = 1, Visible = false, Parent = frame }, { Create.Corner(Theme.Radius), Create.Stroke(Theme.Color.Positive, 2, 0.1), Create.Padding(12, 16) })
	Create.List(Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center).Parent = refs.Card
	ExploreController.UpdateBar()
end

local function showBanner(districtId: string?)
	local banner = refs.Banner
	if not banner or not districtId then
		return
	end
	local d = World.ById[districtId]
	local life = activeLife()
	local stage = World.StageOf(life)
	local open = World.IsUnlocked(districtId, stage)
	banner.Title.Text = (if open then d.Icon .. "  " else "🔒  ") .. d.Name
	banner.Blurb.Text = if open then d.Blurb else World.UnlockText(d.UnlockStage)
	banner.Visible = true
	banner.GroupTransparency = 0
	Anim.Pop(banner, 0.9, 0.25)
	local token = d.Id .. os.clock()
	banner:SetAttribute("Token", token)
	task.delay(3.5, function()
		if banner:GetAttribute("Token") == token then
			Anim.Tween(banner, { GroupTransparency = 1 }, 0.4)
		end
	end)
end

local function districtLoop()
	while exploring do
		local character = Players.LocalPlayer.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root then
			local id = World.DistrictAt(root.Position.X, root.Position.Z)
			if id ~= currentDistrict then
				currentDistrict = id
				showBanner(id)
				ExploreController.UpdateBar()
				ExploreController.DistrictChanged:Fire(id)
			end
		end
		task.wait(0.5)
	end
end

function ExploreController.Enter()
	UIController.Show("Explore")
end

local function onOpen()
	exploring = true
	render()
	ControlsController.SetEnabled(true)
	ProximityPromptService.Enabled = true
	GuiService.SelectedObject = nil
	local camera = workspace.CurrentCamera
	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if camera then
		camera.CameraType = Enum.CameraType.Custom
		if humanoid then
			camera.CameraSubject = humanoid
		end
	end
	ExploreController.RefreshPrompts()
	refreshPedestals()
	ExploreController.Changed:Fire(true)
	task.spawn(districtLoop)
end

local function onClose()
	exploring = false
	currentDistrict = nil
	ControlsController.SetEnabled(false)
	ProximityPromptService.Enabled = false
	UIController.ClosePanel()
	ExploreController.Changed:Fire(false)
end

function ExploreController.Init()
	frame = UIController.NewScreen("Explore", { Backdrop = false, OnOpen = onOpen, OnClose = onClose })
	HUDController.AddAction({ Id = "Explore", Icon = "🌆", Order = 1, Style = "Primary", OnClick = ExploreController.Enter })
	ProximityPromptService.Enabled = false
end

function ExploreController.Start()
	ProximityPromptService.PromptTriggered:Connect(onPrompt)
	DataController.Changed:Connect(function()
		if exploring then
			ExploreController.UpdateBar()
			ExploreController.RefreshPrompts()
			refreshPedestals()
		end
	end)
	StyleController.Changed:Connect(function()
		if exploring then
			ExploreController.UpdateBar()
		end
	end)
	UIController.LayoutChanged:Connect(function()
		if exploring then
			render()
		end
	end)
	CollectionService:GetInstanceAddedSignal("CYL_Spot"):Connect(function()
		if exploring then
			task.defer(ExploreController.RefreshPrompts)
		end
	end)
end

return ExploreController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="118">
            <Properties>
              <string name="Name">FinanceController</string>
              <string name="Source"><![CDATA[--[[
	FinanceController  (StarterPlayerScripts.Client.Controllers.FinanceController)
	The 💰 Money panel: net worth, this year's budget (from Shared/Util/Budget,
	the exact maths the server uses), investments and loans.
	Invest / withdraw / repay are validated by the server (Lib/Actions).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Budget = require(Shared.Util.Budget)
local Format = require(Shared.Util.Format)
local Assets = require(Shared.Data.Assets)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Components = require(UILib.Components)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local HUDController = require(script.Parent.HUDController)
local NotificationController = require(script.Parent.NotificationController)
local DecisionController = require(script.Parent.DecisionController)

local FinanceController = {}
FinanceController.Priority = 44
FinanceController.MinAge = 18

local LINE_LABELS = {
	Salary = "💼 Salary savings",
	Pension = "🏖️ Pension",
	PartTime = "☕ Part-time job",
	Rent = "🏠 Rent",
	Children = "👶 Raising children",
	Loans = "🏦 Loan repayments",
	Unemployed = "📭 Living costs (no job)",
}
local LINE_ORDER = { "Salary", "Pension", "PartTime", "Rent", "Children", "Loans", "Unemployed" }

local handle = nil
local busy = false
local render

local function act(remote: string, ...)
	if busy then
		return
	end
	busy = true
	local ok, result = Net.Invoke(remote, ...)
	busy = false
	if ok then
		NotificationController.Notify({ Title = "💰 Money", Text = if result.PaidOff then "Loan paid off! 🎉" else "Done.", Kind = "Success", Duration = 2 })
		DecisionController.Refresh()
	else
		NotificationController.Notify({ Title = "Not now", Text = tostring(result), Kind = "Warning", Duration = 3 })
	end
	task.wait(0.25)
	if handle and handle.IsOpen() then
		render()
	end
end

local function row(parent, order: number, left: string, right: string, color: Color3?, bold: boolean?)
	local frame = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = order, Parent = parent })
	Create.Label({ Text = left, Size = UDim2.new(0.65, 0, 1, 0), FontFace = if bold then Theme.Font.Heavy else Theme.Font.Medium, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, Parent = frame })
	Create.Label({ Text = right, Size = UDim2.new(0.35, 0, 1, 0), Position = UDim2.fromScale(0.65, 0), TextXAlignment = Enum.TextXAlignment.Right, FontFace = Theme.Font.Heavy, TextColor3 = color or Theme.Color.Text, TextWrapped = false, Parent = frame })
	return frame
end

local function section(parent, order: number, title: string)
	Create.Label({ Text = title, TextSize = Theme.TextSize.Tiny, FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Primary, Size = UDim2.new(1, 0, 0, 24), TextYAlignment = Enum.TextYAlignment.Bottom, LayoutOrder = order, Parent = parent })
end

local function buttonRow(parent, order: number, buttons)
	local frame = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, Parent = parent })
	local list = Create.List(Enum.FillDirection.Horizontal, 8)
	list.Wraps = true
	list.Parent = frame
	for i, b in ipairs(buttons) do
		local button = Components.Button({ Name = b.Name, Text = b.Text, Style = b.Style or "Secondary", Size = UDim2.fromOffset(b.Width or 150, 46), TextSize = 17, LayoutOrder = i, Parent = frame, OnClick = b.OnClick })
		if b.Disabled then
			Components.SetDisabled(button, true)
		end
	end
end

local function amountButtons(prefix: string, remote: string, pool: number, style: string)
	local list = {}
	for _, share in ipairs({ 0.1, 0.25, 0.5, 1 }) do
		local amount = math.floor(pool * share)
		table.insert(list, {
			Name = prefix .. tostring(math.floor(share * 100)),
			Text = (if share == 1 then "All " else ("%d%% "):format(share * 100)) .. Format.Money(amount),
			Style = style,
			Width = 170,
			Disabled = amount < 1,
			OnClick = function()
				act(remote, amount)
			end,
		})
	end
	return list
end

function render()
	local life = DataController.GetActiveLife()
	if not handle or not life then
		return
	end
	handle.Clear()
	local scroll = handle.Scroll
	local netWorth = Budget.NetWorth(life)
	handle.Subtitle.Text = "Net worth " .. Format.Money(netWorth)

	section(scroll, 1, "WHAT YOU HAVE")
	row(scroll, 2, "💵 Cash", Format.Money(life.Money))
	row(scroll, 3, "📈 Investments", Format.Money(life.Investments or 0))
	local order = 4
	for id in pairs(life.Assets) do
		local info = Assets.Info[id]
		if info then
			row(scroll, order, info.Icon .. " " .. info.Title, Format.Money(info.Value))
			order += 1
		end
	end
	for _, loan in ipairs(life.Loans) do
		row(scroll, order, "🏦 " .. (if loan.Kind == "Mortgage" then "Mortgage" else "Student loan"), "-" .. Format.Money(loan.Balance), Theme.Color.Negative)
		order += 1
	end
	row(scroll, 19, "Net worth", Format.Money(netWorth), if netWorth >= 0 then Theme.Color.Positive else Theme.Color.Negative, true)

	section(scroll, 20, "EACH YEAR")
	local budget = Budget.Breakdown(life)
	local lineOrder = 21
	for _, key in ipairs(LINE_ORDER) do
		local amount = budget.Lines[key]
		if amount then
			row(scroll, lineOrder, LINE_LABELS[key], (if amount > 0 then "+" else "") .. Format.Money(amount), if amount >= 0 then Theme.Color.Positive else Theme.Color.Negative)
			lineOrder += 1
		end
	end
	if budget.GrossSalary > 0 then
		Create.Label({
			Text = ("You save %d%% of %s/yr. A 'Save Money' lifestyle or the Thrifty trait raises this."):format(math.floor(budget.SavingsRate * 100 + 0.5), Format.Money(budget.GrossSalary)),
			TextSize = Theme.TextSize.Tiny,
			TextColor3 = Theme.Color.TextFaint,
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 38,
			Parent = scroll,
		})
	end
	row(scroll, 39, "Per year", (if budget.Net >= 0 then "+" else "") .. Format.Money(budget.Net), if budget.Net >= 0 then Theme.Color.Positive else Theme.Color.Negative, true)

	section(scroll, 40, "INVESTING")
	if life.Age < FinanceController.MinAge then
		Create.Label({ Text = ("Investing unlocks at age %d."):format(FinanceController.MinAge), TextColor3 = Theme.Color.TextDim, LayoutOrder = 41, Parent = scroll })
	else
		Create.Label({ Text = "Investments grow about 6% a year on average, but markets swing, and sometimes crash.", TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 41, Parent = scroll })
		Create.Label({ Text = "Invest from cash:", FontFace = Theme.Font.Bold, LayoutOrder = 42, Parent = scroll })
		buttonRow(scroll, 43, amountButtons("Invest", "Invest", life.Money, "Positive"))
		Create.Label({ Text = "Withdraw to cash:", FontFace = Theme.Font.Bold, LayoutOrder = 44, Parent = scroll })
		buttonRow(scroll, 45, amountButtons("Withdraw", "Withdraw", life.Investments or 0, "Secondary"))
	end

	if #life.Loans > 0 then
		section(scroll, 50, "LOANS")
		for i, loan in ipairs(life.Loans) do
			local name = if loan.Kind == "Mortgage" then "Mortgage" else "Student loan"
			Create.Label({ Text = ("%s · %s left · %s/yr · %.1f%% interest"):format(name, Format.Money(loan.Balance), Format.Money(loan.Payment), loan.Rate * 100), LayoutOrder = 50 + i * 2, AutomaticSize = Enum.AutomaticSize.Y, Parent = scroll })
			local payable = math.min(life.Money, loan.Balance)
			buttonRow(scroll, 51 + i * 2, {
				{ Name = "Repay" .. i .. "Quarter", Text = "Pay " .. Format.Money(math.floor(payable * 0.25)), Width = 180, Disabled = math.floor(payable * 0.25) < 1, OnClick = function()
					act("RepayLoan", i, math.floor(payable * 0.25))
				end },
				{ Name = "Repay" .. i .. "Max", Text = (if payable >= loan.Balance then "Pay it all off " else "Pay ") .. Format.Money(payable), Style = "Primary", Width = 220, Disabled = payable < 1, OnClick = function()
					act("RepayLoan", i, payable)
				end },
			})
		end
	end
end

function FinanceController.Open()
	if not DataController.GetActiveLife() then
		return
	end
	handle = UIController.OpenPanel({ Name = "MoneyModal", Title = "💰  Money", Width = 720, OnClose = function()
		handle = nil
	end })
	render()
end

function FinanceController.Init()
	HUDController.AddAction({ Id = "Money", Icon = "💰", Order = 30, OnClick = FinanceController.Open })
end

function FinanceController.Start()
	DataController.Changed:Connect(function()
		if handle and handle.IsOpen() and not busy then
			render()
		end
	end)
end

return FinanceController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="119">
            <Properties>
              <string name="Name">FriendsController</string>
              <string name="Source"><![CDATA[--[[
	FriendsController  (StarterPlayerScripts.Client.Controllers.FriendsController)
	The "Play With Friends" screen (main menu, and 🤝 in the game HUD):
	  • YOUR LIFE CIRCLE: members, group decision, group reveal, leave/remove
	  • PLAYERS IN THIS SERVER: invite them to your circle, compare futures
	  • INVITE ROBLOX FRIENDS: the Roblox invite prompt
	  • FRIENDS PLAYING ELSEWHERE: join their server
	Every life stays independent; see PartyService for the rules.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Components = require(UILib.Components)
local Layout = require(UILib.Layout)

local UIController = require(script.Parent.UIController)
local HUDController = require(script.Parent.HUDController)
local NotificationController = require(script.Parent.NotificationController)
local PartyController = require(script.Parent.PartyController)
local FutureController = require(script.Parent.FutureController)
local Avatar = require(UILib.Avatar)

local FriendsController = {}
FriendsController.Priority = 50

local frame: CanvasGroup
local elsewhere = nil -- cached list of friends in other servers
local busy = false

local function heading(parent, text: string, order: number)
	Create.Label({ Text = text, TextSize = Theme.TextSize.Tiny, FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Primary, Size = UDim2.new(1, 0, 0, 28), TextYAlignment = Enum.TextYAlignment.Bottom, LayoutOrder = order, Parent = parent })
end

local function act(remote: string, ...)
	if busy then
		return false
	end
	busy = true
	local results = table.pack(Net.Invoke(remote, ...))
	busy = false
	if not results[1] then
		local extra = if results[3] then (" (%ss)"):format(tostring(results[3])) else ""
		NotificationController.Notify({ Title = "🤝 Life Circle", Text = PartyController.ErrorText(results[2]) .. extra, Kind = "Warning" })
	end
	return results[1], results[2]
end

local function row(parent, order: number, title: string, subtitle: string, buttons)
	local frameRow = Create("Frame", { Name = "Row" .. order, BackgroundColor3 = Theme.Color.SurfaceHigh, BackgroundTransparency = 0.15, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, Parent = parent }, { Create.Corner(Theme.RadiusSmall), Create.Padding(10, 14) })
	Create.List(Enum.FillDirection.Vertical, 6).Parent = frameRow
	Create.Label({ Name = "Title", Text = title, RichText = true, FontFace = Theme.Font.Heavy, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = frameRow })
	if subtitle ~= "" then
		Create.Label({ Text = subtitle, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = frameRow })
	end
	if buttons and #buttons > 0 then
		local bar = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = frameRow })
		local list = Create.List(Enum.FillDirection.Horizontal, 8)
		list.Wraps = true
		list.Parent = bar
		for i, b in ipairs(buttons) do
			local button = Components.Button({ Name = b.Name, Text = b.Text, Icon = b.Icon, Style = b.Style or "Secondary", Size = UDim2.fromOffset(b.Width or 170, 44), TextSize = 17, LayoutOrder = i, Parent = bar, OnClick = b.OnClick })
			if b.Disabled then
				Components.SetDisabled(button, true)
			end
		end
	end
	return frameRow
end

local render

local function inCircle(userId: number): boolean
	local state = PartyController.Get()
	if not state then
		return false
	end
	for _, m in ipairs(state.Members) do
		if m.UserId == userId then
			return true
		end
	end
	return false
end

local function memberSummary(m): string
	if not m.LifeName then
		return "No life yet"
	end
	return ("%s · age %d · %s%s"):format(m.LifeName, m.Age, m.StageName, if m.Career then " · " .. m.Career else "") .. (if m.Completed then " · life complete" else "")
end

local function findFriendsElsewhere()
	elsewhere = "loading"
	task.spawn(function()
		local ok, friends = pcall(function()
			return Players.LocalPlayer:GetFriendsOnline(50)
		end)
		local list = {}
		if ok and type(friends) == "table" then
			for _, f in ipairs(friends) do
				-- LocationType 4 = playing an experience; GameId is that server's JobId.
				if f.LocationType == 4 and f.PlaceId == game.PlaceId and f.GameId and f.GameId ~= game.JobId then
					table.insert(list, f)
				end
			end
		end
		elsewhere = list
		if UIController.Current() == "Friends" then
			render()
		end
	end)
end

function render()
	Create.Clear(frame, true)
	Layout.Header(frame, "Play With Friends", function()
		UIController.Back()
	end)
	local scroll = Layout.Scroll(frame)
	local width = math.min(760, UIController.GetVirtualSize().X - 32)
	local column = Layout.Column(scroll, width)
	local state = PartyController.Get()
	local me = Players.LocalPlayer

	-- Circle
	heading(column, "🤝 YOUR LIFE CIRCLE" .. (if state then ("  (%d/%d)"):format(#state.Members, state.MaxMembers) else ""), 1)
	if not state then
		Create.Label({ Text = "You're not in a circle yet. Invite someone below. In a circle you make group decisions together, compare futures and watch Group Life Reveals. Every life stays your own.", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = column })
	else
		local leader = PartyController.IsLeader()
		for i, m in ipairs(state.Members) do
			local buttons = {}
			if m.UserId ~= me.UserId then
				table.insert(buttons, { Name = "Compare" .. m.UserId, Text = "Compare", Icon = "⚖️", Width = 150, OnClick = function()
					FutureController.OpenCompareWith(m.UserId)
				end })
				if leader then
					table.insert(buttons, { Name = "Remove" .. m.UserId, Text = "Remove", Width = 130, OnClick = function()
						local confirmed = UIController.Confirm({ Title = "Remove " .. m.DisplayName .. "?", Text = "They'll leave your Life Circle.", ConfirmText = "Remove", Danger = true })
						if confirmed then
							act("PartyKick", m.UserId)
						end
					end })
				end
			end
			row(column, 2 + i, (if m.IsLeader then "👑 " else "") .. Avatar.Line(m.DisplayName, m.Style) .. (if m.UserId == me.UserId then " (you)" else ""), memberSummary(m), buttons)
		end
		local eventText = if state.EventActive then "Deciding…" elseif state.EventCooldown > 0 then ("Group decision (%ds)"):format(state.EventCooldown) else "Group decision"
		row(column, 10, "Do something together", "Start a group decision for everyone to vote on, or watch everyone's futures in a Group Life Reveal.", {
			{ Name = "StartGroupEvent", Text = eventText, Icon = "🎲", Style = "Primary", Width = 250, Disabled = state.EventActive, OnClick = function()
				act("PartyStartEvent")
			end },
			{ Name = "StartGroupReveal", Text = if state.RevealCooldown > 0 then ("Group reveal (%ds)"):format(state.RevealCooldown) else "Group reveal", Icon = "🔮", Style = "Accent", Width = 230, OnClick = function()
				act("PartyStartReveal")
			end },
			{ Name = "LeaveCircle", Text = "Leave", Icon = "🚪", Width = 130, OnClick = function()
				act("PartyLeave")
			end },
		})
	end

	-- Players here
	heading(column, "👥 PLAYERS IN THIS SERVER", 20)
	local others = 0
	for i, p in ipairs(Players:GetPlayers()) do
		if p ~= me then
			others += 1
			local already = inCircle(p.UserId)
			local full = state and #state.Members >= state.MaxMembers
			row(column, 20 + i, Avatar.NameRich(p.DisplayName or p.Name, nil), if already then "In your circle" else "", {
				{ Name = "Invite" .. p.UserId, Text = if already then "In circle" else "Invite", Icon = "🤝", Style = "Primary", Width = 160, Disabled = already or full, OnClick = function()
					local ok = act("PartyInvite", p.UserId)
					if ok then
						NotificationController.Notify({ Title = "🤝 Invite sent", Text = (p.DisplayName or p.Name) .. " has 45 seconds to accept.", Kind = "Success", Duration = 3 })
					end
				end },
				{ Name = "CompareP" .. p.UserId, Text = "Compare", Icon = "⚖️", Width = 150, OnClick = function()
					FutureController.OpenCompareWith(p.UserId)
				end },
				{ Name = "Profile" .. p.UserId, Text = "Profile", Icon = "👤", Width = 140, OnClick = function()
					require(script.Parent.ProfileController).Open(p.UserId)
				end },
				{ Name = "Trade" .. p.UserId, Text = "Trade", Icon = "🔄", Width = 130, OnClick = function()
					require(script.Parent.TradeController).Request(p.UserId)
				end },
			})
		end
	end
	if others == 0 then
		Create.Label({ Text = "Nobody else is in this server yet.", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 21, Parent = column })
	end

	-- Invite Roblox friends
	heading(column, "📨 INVITE YOUR ROBLOX FRIENDS", 60)
	row(column, 61, "Bring your friends into this server", "They'll get a Roblox invite to join you here.", {
		{ Name = "InviteFriends", Text = "Invite friends", Icon = "📨", Style = "Accent", Width = 220, OnClick = function()
			local ok = pcall(function()
				local SocialService = game:GetService("SocialService")
				if SocialService:CanSendGameInviteAsync(Players.LocalPlayer) then
					SocialService:PromptGameInvite(Players.LocalPlayer)
				else
					error("cannot invite")
				end
			end)
			if not ok then
				NotificationController.Notify({ Title = "Invites unavailable", Text = "Roblox invites only work in a published game, not in Studio.", Kind = "Warning" })
			end
		end },
	})

	-- Friends elsewhere
	heading(column, "🌍 FRIENDS PLAYING IN OTHER SERVERS", 70)
	if elsewhere == nil then
		findFriendsElsewhere()
	end
	if elsewhere == "loading" then
		Create.Label({ Text = "Looking for friends…", TextColor3 = Theme.Color.TextDim, LayoutOrder = 71, Parent = column })
	elseif type(elsewhere) == "table" and #elsewhere == 0 then
		Create.Label({ Text = "No friends are playing CHOOSE YOUR LIFE in other servers right now.", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 71, Parent = column })
	elseif type(elsewhere) == "table" then
		for i, f in ipairs(elsewhere) do
			row(column, 71 + i, f.DisplayName or f.UserName or "Friend", "Playing in another server", {
				{ Name = "Join" .. tostring(f.VisitorId), Text = "Join their server", Icon = "🚀", Style = "Primary", Width = 240, OnClick = function()
					local ok = act("JoinFriendServer", f.PlaceId, f.GameId)
					if ok then
						NotificationController.Notify({ Title = "🚀 Joining…", Text = "Teleporting you to " .. (f.DisplayName or "your friend") .. "'s server.", Kind = "Info" })
					end
				end },
			})
		end
	end
	Components.Button({ Name = "RefreshFriends", Text = "Refresh", Icon = "🔄", Style = "Ghost", Size = UDim2.fromOffset(160, 44), LayoutOrder = 99, Parent = column, OnClick = function()
		elsewhere = nil
		render()
	end })
end

function FriendsController.Init()
	frame = UIController.NewScreen("Friends", { Back = true, OnOpen = function()
		elsewhere = nil
		render()
	end })
	HUDController.AddAction({ Id = "Circle", Icon = "🤝", Order = 8, OnClick = function()
		UIController.Show("Friends")
	end })
end

function FriendsController.Start()
	PartyController.Changed:Connect(function()
		if UIController.Current() == "Friends" then
			render()
		end
	end)
	for _, signal in ipairs({ Players.PlayerAdded, Players.PlayerRemoving }) do
		signal:Connect(function()
			task.defer(function()
				if UIController.Current() == "Friends" then
					render()
				end
			end)
		end)
	end
	UIController.LayoutChanged:Connect(function()
		if UIController.Current() == "Friends" then
			render()
		end
	end)
end

return FriendsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="120">
            <Properties>
              <string name="Name">FutureController</string>
              <string name="Source"><![CDATA[--[[
	FutureController  (StarterPlayerScripts.Client.Controllers.FutureController)
	The 🔮 Future panel:
	  • live odds for every possible future, recalculated from your current
	    life with the same model the server uses (Shared/Util/Futures)
	  • how your predicted future has changed at each Life Reveal so far
	  • compare predicted futures with other players in this server
	    (privacy-respecting; RevealService)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Futures = require(Shared.Util.Futures)
local Format = require(Shared.Util.Format)
local LifeStages = require(Shared.Data.LifeStages)
local StatDefinitions = require(Shared.Data.StatDefinitions)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Components = require(UILib.Components)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local HUDController = require(script.Parent.HUDController)
local NotificationController = require(script.Parent.NotificationController)
local Avatar = require(UILib.Avatar)

local FutureController = {}
FutureController.Priority = 47

local handle = nil

local function bar(parent, order: number, icon: string, title: string, pct: number, positive: boolean, extra: string?)
	local row = Create("Frame", { Name = title, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = order, Parent = parent })
	Create.Label({ Text = icon .. "  " .. title .. (extra or ""), RichText = true, FontFace = Theme.Font.Bold, Size = UDim2.new(0.75, 0, 0, 22), TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
	Create.Label({ Name = "Pct", Text = pct .. "%", FontFace = Theme.Font.Heavy, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(0.25, 0, 0, 22), Position = UDim2.fromScale(0.75, 0), Parent = row })
	local track = Create("Frame", { BackgroundColor3 = Theme.Color.Background, Size = UDim2.new(1, 0, 0, 10), Position = UDim2.fromOffset(0, 26), Parent = row }, { Create.Corner(Theme.RadiusPill) })
	local color = if positive then (if pct >= 60 then Theme.Color.Positive elseif pct >= 35 then Theme.Color.Warning else Theme.Color.Accent) else Theme.Color.Negative
	Create("Frame", { BackgroundColor3 = color, Size = UDim2.fromScale(pct / 100, 1), Parent = track }, { Create.Corner(Theme.RadiusPill) })
end

local function heading(parent, text: string, order: number)
	Create.Label({ Text = text, TextSize = Theme.TextSize.Tiny, FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Primary, Size = UDim2.new(1, 0, 0, 24), TextYAlignment = Enum.TextYAlignment.Bottom, LayoutOrder = order, Parent = parent })
end

local renderCompare

local function render()
	local life = DataController.GetActiveLife()
	if not handle or not life then
		return
	end
	handle.Clear()
	local scroll = handle.Scroll
	local predictions = Futures.Predict(life)
	local headline, warning = Futures.Headline(predictions)
	handle.Subtitle.Text = "Live odds · they change with every choice you make"
	Create.Label({ Text = headline, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H3, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = scroll })
	if warning then
		Create.Label({ Text = "⚠️ " .. warning, TextColor3 = Theme.Color.Warning, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = scroll })
	end
	local last = life.Reveals[#life.Reveals]
	local positives, risks = Futures.Sorted(predictions)
	heading(scroll, "POSSIBLE FUTURES", 3)
	for i, entry in ipairs(positives) do
		local extra = nil
		if last and last.Predictions and last.Predictions[entry.Id] then
			local diff = entry.Pct - last.Predictions[entry.Id]
			if math.abs(diff) >= 3 then
				extra = ("  <font color=\"%s\">%s%d</font>"):format(if diff > 0 then Theme.Hex.Positive else Theme.Hex.Negative, if diff > 0 then "▲" else "▼", math.abs(diff))
			end
		end
		bar(scroll, 3 + i, entry.Icon, entry.Title, entry.Pct, true, extra)
	end
	heading(scroll, "RISKS", 30)
	for i, entry in ipairs(risks) do
		bar(scroll, 30 + i, entry.Icon, entry.Title, entry.Pct, false)
	end

	local journey = {}
	for _, r in ipairs(life.Reveals) do
		if r.Predictions then
			table.insert(journey, r)
		end
	end
	if #journey > 0 then
		heading(scroll, "HOW YOUR FUTURE HAS CHANGED", 50)
		for i, r in ipairs(journey) do
			local top = Futures.Sorted(r.Predictions)
			local parts = {}
			for j = 1, math.min(3, #top) do
				table.insert(parts, ("%s %d%%"):format(top[j].Icon, top[j].Pct))
			end
			Create.Label({
				Text = ("<b>After %s (age %d):</b>  %s%s"):format(LifeStages.Get(r.Stage).DisplayName, r.Age, table.concat(parts, "   "), if r.Twist then "   ⚡ twist!" else ""),
				RichText = true,
				TextSize = Theme.TextSize.Small,
				AutomaticSize = Enum.AutomaticSize.Y,
				LayoutOrder = 50 + i,
				Parent = scroll,
			})
		end
	end
	Create.Label({ Text = "💡 These are estimates, not destiny. The future is never completely decided.", TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextFaint, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 80, Parent = scroll })
	Components.Button({ Name = "Compare", Text = "Compare with players here", Icon = "⚖️", Style = "Accent", Size = UDim2.new(1, 0, 0, 52), LayoutOrder = 90, Parent = scroll, OnClick = function()
		renderCompare()
	end })
end

local function compareView(me, them)
	handle.Clear()
	local scroll = handle.Scroll
	handle.Subtitle.Text = "You vs " .. them.DisplayName
	local mine, theirs = me.Card, them.Card
	Create.Label({ Text = ("%s (%s, %d)   vs   %s (%s, %d)"):format(mine.LifeName, mine.StageName, mine.Age, theirs.LifeName, theirs.StageName, theirs.Age), FontFace = Theme.Font.Heavy, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = scroll })
	Create.Label({ Text = ("💼 %s   vs   💼 %s"):format(mine.Career, theirs.Career), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = scroll })
	heading(scroll, "PREDICTED FUTURES (YOU · THEM)", 3)
	for i, id in ipairs(Futures.Order) do
		local info = Futures.Info[id]
		local a, b = mine.Predictions[id] or 0, theirs.Predictions[id] or 0
		local winner = if math.abs(a - b) < 5 then "🤝" elseif (a > b) == info.Positive then "⬅️" else "➡️"
		Create.Label({ Text = ("%s %s   <b>%d%%</b>  %s  <b>%d%%</b>"):format(info.Icon, info.Title, a, winner, b), RichText = true, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3 + i, Parent = scroll })
	end
	if mine.Stats and theirs.Stats then
		heading(scroll, "STATS", 40)
		for i, statName in ipairs(StatDefinitions.Order) do
			local info = StatDefinitions.Info[statName]
			Create.Label({ Text = ("%s %s   %d  vs  %d"):format(info.Icon, info.DisplayName, mine.Stats[statName], theirs.Stats[statName]), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 40 + i, Parent = scroll })
		end
		Create.Label({ Text = ("💰 Net worth   %s  vs  %s"):format(Format.Money(mine.NetWorth), Format.Money(theirs.NetWorth)), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 60, Parent = scroll })
		heading(scroll, "LIFESTYLE: HOMES & CARS", 61)
		local function owned(card)
			return if card.Assets and #card.Assets > 0 then table.concat(card.Assets, ", ") else "Nothing yet"
		end
		Create.Label({ Text = "You: " .. owned(mine), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 62, Parent = scroll })
		Create.Label({ Text = them.DisplayName .. ": " .. owned(theirs), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 63, Parent = scroll })
	elseif not theirs.Stats then
		Create.Label({ Text = "🔒 " .. them.DisplayName .. " keeps their exact stats private.", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 40, Parent = scroll })
	end
	Components.Button({ Name = "BackToList", Text = "Back", Icon = "‹", Style = "Secondary", Size = UDim2.new(1, 0, 0, 50), LayoutOrder = 99, Parent = scroll, OnClick = function()
		renderCompare()
	end })
end

function renderCompare()
	if not handle then
		return
	end
	handle.Clear()
	handle.Subtitle.Text = "Loading players…"
	local ok, cards = Net.Invoke("GetLifeCards")
	if not handle or not handle.IsOpen() then
		return
	end
	handle.Clear()
	local scroll = handle.Scroll
	if not ok then
		NotificationController.Notify({ Title = "Couldn't load players", Text = tostring(cards), Kind = "Warning" })
		render()
		return
	end
	handle.Subtitle.Text = "Players in this server · respects everyone's privacy settings"
	local me = nil
	for _, c in ipairs(cards) do
		if c.IsYou then
			me = c
		end
	end
	local others = 0
	for i, c in ipairs(cards) do
		if not c.IsYou then
			others += 1
			local panel = Components.Panel({ Name = "Player" .. c.UserId, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Padding = 14, LayoutOrder = i, Parent = scroll, Color = Theme.Color.SurfaceHigh })
			Create.List(Enum.FillDirection.Vertical, 4).Parent = panel
			Create.Label({ Text = Avatar.Line(c.DisplayName, c.Style) .. (if c.IsFriend then "  · 🤝 Friend" else ""), RichText = true, FontFace = Theme.Font.Heavy, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = panel })
			if c.Hidden then
				Create.Label({ Text = "🔒 Keeps their future private.", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = panel })
			elseif c.NoLife then
				Create.Label({ Text = "Between lives right now.", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = panel })
			else
				local card = c.Card
				local top = Futures.Sorted(card.Predictions)
				Create.Label({ Text = ("%s · age %d · %s · %s"):format(card.LifeName, card.Age, card.StageName, card.Career), TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = panel })
				Create.Label({ Text = ("%s %s %d%%   %s %s %d%%"):format(top[1].Icon, top[1].Title, top[1].Pct, top[2].Icon, top[2].Title, top[2].Pct), FontFace = Theme.Font.Bold, TextColor3 = Theme.Color.Gold, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = panel })
				if me and me.Card then
					Components.Button({ Name = "CompareWith", Text = "Compare", Icon = "⚖️", Style = "Accent", Size = UDim2.fromOffset(180, 44), LayoutOrder = 5, Parent = panel, OnClick = function()
						compareView(me, c)
					end })
				end
			end
			if c.Endings and #c.Endings > 0 then
				local titles = {}
				for _, e in ipairs(c.Endings) do
					table.insert(titles, e.Icon .. " " .. e.Title)
				end
				Create.Label({ Text = "Past lives: " .. table.concat(titles, ", "), TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, Parent = panel })
			end
		end
	end
	if others == 0 then
		Create.Label({ Text = "Nobody else is here yet. Invite a friend to compare futures!", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = scroll })
	end
	Components.Button({ Name = "BackToFuture", Text = "Back to my future", Icon = "‹", Style = "Secondary", Size = UDim2.new(1, 0, 0, 50), LayoutOrder = 999, Parent = scroll, OnClick = render })
end

function FutureController.Open()
	if not DataController.GetActiveLife() then
		return
	end
	handle = UIController.OpenPanel({ Name = "FutureModal", Title = "🔮  Your Future", Width = 760, OnClose = function()
		handle = nil
	end })
	render()
end

FutureController.OpenCompare = function()
	FutureController.Open()
	renderCompare()
end

-- Opens a side-by-side comparison with one player (from Play With Friends).
function FutureController.OpenCompareWith(userId: number)
	if not DataController.GetActiveLife() then
		NotificationController.Notify({ Title = "Start a life first", Text = "You need a life in progress to compare futures.", Kind = "Info" })
		return
	end
	handle = UIController.OpenPanel({ Name = "FutureModal", Title = "⚖️  Compare Futures", Width = 760, OnClose = function()
		handle = nil
	end })
	handle.Subtitle.Text = "Loading…"
	local ok, cards = Net.Invoke("GetLifeCards")
	if not handle or not handle.IsOpen() then
		return
	end
	local me, them = nil, nil
	if ok then
		for _, c in ipairs(cards) do
			if c.IsYou then
				me = c
			elseif c.UserId == userId then
				them = c
			end
		end
	end
	if me and me.Card and them and them.Card then
		compareView(me, them)
	else
		handle.Clear()
		handle.Subtitle.Text = ""
		local reason = if not ok then tostring(cards) elseif not them then "That player isn't here any more." elseif them.NoLife then them.DisplayName .. " is between lives right now." else "🔒 " .. them.DisplayName .. " keeps their future private."
		Create.Label({ Text = reason, TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = handle.Scroll })
	end
end

function FutureController.Init()
	HUDController.AddAction({ Id = "Future", Icon = "🔮", Order = 5, OnClick = FutureController.Open })
end

function FutureController.Start() end

return FutureController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="121">
            <Properties>
              <string name="Name">GatesController</string>
              <string name="Source"><![CDATA[--[[
	GatesController  (StarterPlayerScripts.Client.Controllers.GatesController)
	Areas of Lifeville that open later in life (World.Districts UnlockStage,
	World.Locks) are surrounded by walls tagged CYL_Lock. They are invisible
	and walk-through on the server; on your client, the ones you haven't
	unlocked yet become shimmering walls with "🔒 Opens in …" signs.
	(The server still refuses actions there, whatever a client does.)
	If you're standing inside an area that's locked for your life (e.g. you
	started a new life while Downtown), you're taken back to the Plaza.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local World = require(ReplicatedStorage:WaitForChild("Shared").Data.World)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)

local DataController = require(script.Parent.DataController)

local GatesController = {}
GatesController.Priority = 57
GatesController.PlazaSpawn = Vector3.new(0, 4, 32)

local lastStage: number? = nil

local function stage(): number
	local life = DataController.GetActiveLife()
	return World.StageOf(if life and not life.Completed then life else nil)
end

local function lockInfo(lockId: string)
	return World.Locks[lockId] or World.ById[lockId]
end

local function label(wall: BasePart, face)
	local name = "CYL_LockLabel" .. face.Name
	local gui = wall:FindFirstChild(name)
	if not gui then
		gui = Instance.new("SurfaceGui")
		gui.Name = name
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 6
		gui.LightInfluence = 0
		gui.Parent = wall
		local text = Instance.new("TextLabel")
		text.Name = "Label"
		text.BackgroundTransparency = 1
		local height = wall.Size.Y
		local top = wall.Position.Y + height / 2
		text.Position = UDim2.fromScale(0.05, math.clamp((top - 9) / height, 0, 0.9))
		text.Size = UDim2.fromScale(0.9, math.clamp(5 / height, 0.05, 1))
		text.TextScaled = true
		text.FontFace = Theme.Font.Heavy
		text.TextColor3 = Color3.fromRGB(255, 255, 255)
		text.TextStrokeTransparency = 0.3
		text.Parent = gui
	end
	return gui
end

function GatesController.Apply(wall: BasePart, currentStage: number)
	local lockId = wall:GetAttribute("LockId")
	local info = lockInfo(lockId)
	if not info then
		return
	end
	local open = currentStage >= info.UnlockStage
	wall.CanCollide = not open
	wall.Transparency = if open then 1 else 0.55
	local text = ("🔒 %s · %s"):format(info.Name, World.UnlockText(info.UnlockStage))
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right }) do
		local horizontalFace = face == Enum.NormalId.Front or face == Enum.NormalId.Back
		local wide = if horizontalFace then wall.Size.X >= wall.Size.Z else wall.Size.Z > wall.Size.X
		if wide then
			local gui = label(wall, face)
			gui.Enabled = not open
			gui.Label.Text = text
		end
	end
end

local function insideLocked(position: Vector3, currentStage: number): boolean
	local districtId = World.DistrictAt(position.X, position.Z)
	return districtId ~= nil and not World.IsUnlocked(districtId, currentStage)
end

function GatesController.Refresh()
	local current = stage()
	lastStage = current
	for _, wall in ipairs(CollectionService:GetTagged("CYL_Lock")) do
		GatesController.Apply(wall, current)
	end
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and insideLocked(root.Position, current) then
		character:PivotTo(CFrame.new(GatesController.PlazaSpawn))
	end
end

function GatesController.Init() end

function GatesController.Start()
	GatesController.Refresh()
	DataController.Changed:Connect(function()
		if stage() ~= lastStage then
			GatesController.Refresh()
		end
	end)
	CollectionService:GetInstanceAddedSignal("CYL_Lock"):Connect(function(wall)
		GatesController.Apply(wall, stage())
	end)
end

return GatesController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="122">
            <Properties>
              <string name="Name">GraphicsController</string>
              <string name="Source"><![CDATA[--[[
	GraphicsController  (StarterPlayerScripts.Client.Controllers.GraphicsController)
	Applies the Graphics setting (Auto / Low / High) on this client only.
	Roblox doesn't let games change the engine's quality level, so this
	controls what the game itself adds: shadows, post-processing effects
	(Bloom, SunRays, DepthOfField, Blur) and decorative UI motion.
	World systems (Phase 8) read GraphicsController.IsLow() before spawning
	optional decoration such as extra NPCs or particles.

	Auto = Low on touch-only devices (phones/tablets), High elsewhere.
]]

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Signal = require(ReplicatedStorage:WaitForChild("Shared").Util.Signal)

local GraphicsController = {}
GraphicsController.Priority = 3
GraphicsController.Changed = Signal.new() -- (resolvedMode: "Low" | "High")

local resolved = "High"
local originalShadows = nil

function GraphicsController.Resolve(mode: string): string
	if mode == "Low" or mode == "High" then
		return mode
	end
	local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled and not UserInputService.GamepadEnabled
	return if touchOnly then "Low" else "High"
end

function GraphicsController.Apply(mode: string)
	resolved = GraphicsController.Resolve(mode)
	local low = resolved == "Low"
	if originalShadows == nil then
		originalShadows = Lighting.GlobalShadows
	end
	Lighting.GlobalShadows = if low then false else originalShadows
	for _, effect in ipairs(Lighting:GetChildren()) do
		if effect:IsA("PostEffect") and not effect:IsA("ColorCorrectionEffect") then
			effect.Enabled = not low
		end
	end
	local UIController = require(script.Parent.UIController)
	UIController.SetDecorations(not low)
	GraphicsController.Changed:Fire(resolved)
end

function GraphicsController.IsLow(): boolean
	return resolved == "Low"
end

function GraphicsController.Init() end
function GraphicsController.Start() end

return GraphicsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="123">
            <Properties>
              <string name="Name">HUDController</string>
              <string name="Source"><![CDATA[--[[
	HUDController  (StarterPlayerScripts.Client.Controllers.HUDController)
	The "Game" screen: a HUD bar (name, age, life stage, stage progress, money,
	happiness, health, occupation) above a content area where
	DecisionController draws scenarios. Also the full Stats panel.

	HUDController.Content         Frame for gameplay UI below the HUD
	HUDController.Opened / Closed Signals when the Game screen opens/closes
	HUDController.OpenStats()     shows the statistics panel
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Util.Signal)
local Format = require(Shared.Util.Format)
local LifeStages = require(Shared.Data.LifeStages)
local StatDefinitions = require(Shared.Data.StatDefinitions)
local Traits = require(Shared.Data.Traits)
local StatMath = require(Shared.Util.StatMath)
local Careers = require(Shared.Data.Careers)
local Assets = require(Shared.Data.Assets)
local Budget = require(Shared.Util.Budget)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Anim = require(UILib.Anim)
local Components = require(UILib.Components)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local StyleController = require(script.Parent.StyleController)
local Avatar = require(UILib.Avatar)

local HUDController = {}
HUDController.Priority = 40
HUDController.Opened = Signal.new()
HUDController.Closed = Signal.new()
HUDController.Content = nil :: Frame?

local gameFrame: CanvasGroup
local hud: Frame
local refs: { [string]: any } = {}
local actions: { { Id: string, Icon: string, Order: number, OnClick: () -> () } } = {}

--[[
	Adds an icon button to the HUD (People, Lifestyle, Money, Stats...).
	Call from a controller's Init. Buttons are named by Id.
]]
function HUDController.AddAction(action)
	table.insert(actions, action)
	table.sort(actions, function(a, b)
		return a.Order < b.Order
	end)
end

function HUDController.Occupation(life): string
	if life.Career and life.Career.Id ~= "None" and Careers.Info[life.Career.Id] then
		return Careers.TitleAt(life.Career.Id, life.Career.Level)
	end
	if life.Flags.Retired then
		return "Retired"
	elseif life.Flags.AtUni then
		return "University Student"
	elseif life.Age <= 11 then
		return "Primary School Pupil"
	elseif life.Age <= 18 then
		return "Secondary School Student"
	end
	return "Unemployed"
end

-- One row needs room for: menu, identity, money, two bars, occupation and
-- every action button; otherwise the HUD switches to two rows.
local function actionBarWidth(): number
	return #actions * 50 + math.max(0, #actions - 1) * 8
end
local function isCompact(): boolean
	local needed = 50 + 220 + 140 + 120 + 120 + 250 + 14 * 6 + actionBarWidth() + 48
	return UIController.GetVirtualSize().X < needed
end
local function hudHeight(): number
	return if isCompact() then 118 else 74
end

-- Compact layouts use slightly smaller buttons so every action still fits.
local function actionBar(parent, compact: boolean?)
	local button, gap = if compact then 44 else 50, if compact then 6 else 8
	local width = #actions * button + math.max(0, #actions - 1) * gap
	local bar = Create("Frame", { Name = "Actions", BackgroundTransparency = 1, Size = UDim2.fromOffset(width, button), AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Parent = parent })
	Create.List(Enum.FillDirection.Horizontal, gap, Enum.HorizontalAlignment.Right).Parent = bar
	for i, action in ipairs(actions) do
		Components.Button({ Name = action.Id, Text = action.Icon, Style = if action.Style then action.Style elseif i == #actions then "Accent" else "Secondary", Size = UDim2.fromOffset(button, button), TextSize = if compact then 21 else 24, LayoutOrder = i, Parent = bar, OnClick = action.OnClick })
	end
	return width
end

local function identityBlock(parent, width: number, order: number)
	local frame = Create("Frame", { Name = "Identity", BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 50), LayoutOrder = order, Parent = parent })
	refs.Name = Create.Label({ Name = "Name", RichText = true, FontFace = Theme.Font.Heavy, TextSize = 22, Size = UDim2.new(1, 0, 0, 26), TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = frame })
	refs.Sub = Create.Label({ Name = "Sub", TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.TextDim, Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 26), TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = frame })
	return frame
end

local function render()
	Create.Clear(hud, true)
	refs = {}
	local size = UIController.GetVirtualSize()
	local compact = isCompact()
	local height = hudHeight()

	hud.Size = UDim2.new(1, -24, 0, height)
	local content = HUDController.Content :: Frame
	content.Position = UDim2.fromOffset(0, height + 18)
	content.Size = UDim2.new(1, 0, 1, -(height + 18))

	Create.Corner(Theme.Radius).Parent = hud
	Create.Stroke().Parent = hud
	Create.Padding(10, 12, 14, 12).Parent = hud

	-- Thin stage-progress bar along the bottom edge.
	local track = Create("Frame", { Name = "Progress", BackgroundColor3 = Theme.Color.Background, Size = UDim2.new(1, 0, 0, 5), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 8), Parent = hud }, { Create.Corner(Theme.RadiusPill) })
	refs.ProgressFill = Create("Frame", { Name = "Fill", BackgroundColor3 = Theme.Color.Primary, Size = UDim2.fromScale(0, 1), Parent = track }, { Create.Corner(Theme.RadiusPill) })

	local function menuButton(parent, order)
		return Components.Button({ Name = "Menu", Text = "≡", Style = "Secondary", Size = UDim2.fromOffset(50, 50), TextSize = 28, LayoutOrder = order, Parent = parent, OnClick = function()
			UIController.Show("Menu")
		end })
	end
	local function chip(parent, key, order)
		refs[key] = Components.Chip({ Text = "", Height = 40, LayoutOrder = order, Parent = parent })
		refs[key].Name = key
	end
	local function bar(parent, statName, width, order)
		local info = StatDefinitions.Info[statName]
		refs[statName] = Components.StatBar({ Name = statName, Icon = info.Icon, DisplayName = info.DisplayName, Color = info.Color, Compact = true, Size = UDim2.fromOffset(width, 40), LayoutOrder = order, Parent = parent })
	end

	if not compact then
		local row = Create("Frame", { Name = "Row", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = hud })
		Create.List(Enum.FillDirection.Horizontal, 14, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center).Parent = row
		-- Widths budgeted in isCompact(): below that width the HUD uses two rows.
		menuButton(row, 1)
		identityBlock(row, 220, 2)
		chip(row, "Money", 3)
		bar(row, "Happiness", 120, 4)
		bar(row, "Health", 120, 5)
		chip(row, "Occupation", 6)
		actionBar(hud)
	else
		local top = Create("Frame", { Name = "Top", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 50), Parent = hud })
		menuButton(top, 1).Position = UDim2.fromOffset(0, 0)
		local barWidth = actionBar(top, true)
		local identity = identityBlock(top, size.X - 24 - 24 - 50 - barWidth - 28, 2)
		identity.Position = UDim2.fromOffset(64, 0)

		local bottom = Create("Frame", { Name = "Bottom", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 42), Position = UDim2.fromOffset(0, 56), Parent = hud })
		Create.List(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center).Parent = bottom
		chip(bottom, "Money", 1)
		local statWidth = if size.X < 700 then 110 else 140
		bar(bottom, "Happiness", statWidth, 2)
		bar(bottom, "Health", statWidth, 3)
		if size.X >= 760 then
			chip(bottom, "Occupation", 4)
		end
	end
end

local lastLife = nil
local function update(animate: boolean?)
	local life = DataController.GetActiveLife()
	if not life or not refs.Name then
		return
	end
	local stage = LifeStages.Get(life.Stage)
	local style = StyleController.Get()
	refs.Name.Text = style.Face .. " " .. Avatar.NameRich(life.Name, style)
	refs.Name:SetAttribute("LifeName", life.Name)
	refs.Sub.Text = ("Age %d · %s · %d/%d"):format(life.Age, stage.DisplayName, math.min(life.ScenarioIndex + 1, stage.ScenariosPerStage), stage.ScenariosPerStage)
	refs.ProgressFill.BackgroundColor3 = stage.Color
	local progress = UDim2.fromScale(life.ScenarioIndex / stage.ScenariosPerStage, 1)
	if animate then
		Anim.Tween(refs.ProgressFill, { Size = progress }, 0.6)
	else
		refs.ProgressFill.Size = progress
	end
	refs.Money:FindFirstChild("Label").Text = "💰 " .. Format.Money(life.Money)
	if refs.Occupation then
		refs.Occupation:FindFirstChild("Label").Text = "💼 " .. HUDController.Occupation(life)
	end
	refs.Happiness.Set(life.Stats.Happiness, animate)
	refs.Health.Set(life.Stats.Health, animate)
	if animate and lastLife and lastLife.Money ~= life.Money then
		Anim.Pop(refs.Money, 1.2, 0.4)
	end
	lastLife = { Money = life.Money }
end

-- ===== Stats panel =====
function HUDController.CloseStats()
	local panel = UIController.CurrentPanel()
	if panel and panel.Root.Name == "StatsModal" then
		panel.Close()
	end
end

function HUDController.OpenStats()
	local life = DataController.GetActiveLife()
	if not life then
		return
	end
	local narrow = UIController.IsNarrow()
	local stage = LifeStages.Get(life.Stage)
	local handle = UIController.OpenPanel({
		Name = "StatsModal",
		Title = "📊  " .. life.Name .. "'s Life",
		Subtitle = ("Age %d · %s · Overall %d / 100 · %s"):format(life.Age, stage.DisplayName, math.floor(StatMath.Overall(life.Stats) + 0.5), Format.Money(life.Money)),
	})
	local scroll = handle.Scroll

	local grid = Create("Frame", { Name = "Stats", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = scroll })
	Create("UIGridLayout", { CellSize = if narrow then UDim2.new(1, 0, 0, 84) else UDim2.new(0.5, -10, 0, 84), CellPadding = UDim2.fromOffset(20, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	for i, statName in ipairs(StatDefinitions.Order) do
		local info = StatDefinitions.Info[statName]
		local cell = Create("Frame", { Name = statName, BackgroundTransparency = 1, LayoutOrder = i, Parent = grid })
		local bar = Components.StatBar({ Name = "Bar", Icon = info.Icon, DisplayName = info.DisplayName, Color = info.Color, Value = 0, Parent = cell })
		bar.Set(life.Stats[statName], true)
		Create.Label({ Text = info.Description, TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextFaint, Position = UDim2.fromOffset(0, 60), Size = UDim2.new(1, 0, 0, 20), Parent = cell })
	end

	Create.Label({ Text = "PERSONALITY", TextSize = Theme.TextSize.Tiny, FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Primary, LayoutOrder = 2, Parent = scroll })
	local traitRow = Create("Frame", { Name = "Traits", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = scroll })
	Create("UIGridLayout", { CellSize = if narrow then UDim2.new(1, 0, 0, 40) else UDim2.new(0.5, -10, 0, 40), CellPadding = UDim2.fromOffset(20, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = traitRow })
	local traitList = {}
	for id, strength in pairs(life.Traits) do
		table.insert(traitList, { Id = id, Strength = strength })
	end
	table.sort(traitList, function(a, b)
		return a.Strength > b.Strength
	end)
	if #traitList == 0 then
		Create.Label({ Text = "Your choices will shape your personality.", TextColor3 = Theme.Color.TextDim, LayoutOrder = 1, Parent = traitRow })
	end
	for i, trait in ipairs(traitList) do
		local info = Traits.Info[trait.Id]
		if info then
			local dots = string.rep("●", trait.Strength) .. string.rep("○", Traits.MaxStrength - trait.Strength)
			local chipFrame = Components.Chip({ Text = ("%s %s  <font color=\"%s\">%s</font>"):format(info.Icon, info.DisplayName, Theme.Hex.Gold, dots), Height = 40, LayoutOrder = i, Parent = traitRow })
			chipFrame.AutomaticSize = Enum.AutomaticSize.None
		end
	end

	Create.Label({ Text = "LIFE", TextSize = Theme.TextSize.Tiny, FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Primary, LayoutOrder = 10, Parent = scroll })
	local rel = life.Relationships
	local relationship = if rel.Married then "Married" elseif rel.Partner then "In a relationship" else "Single"
	local owned = {}
	for id in pairs(life.Assets) do
		local info = Assets.Info[id]
		if info then
			table.insert(owned, info.Icon .. " " .. info.Title)
		end
	end
	table.sort(owned)
	local career = HUDController.Occupation(life)
	if life.Career.Id ~= "None" then
		career ..= (" · %s/yr"):format(Format.Money(Careers.SalaryAt(life.Career.Id, life.Career.Level)))
	end
	local facts = {
		"💼  " .. career,
		"🎓  " .. (Careers.EducationNames[life.Education] or "None"),
		"❤️  " .. relationship .. (if rel.Children > 0 then ("  ·  👶 %d %s"):format(rel.Children, if rel.Children == 1 then "child" else "children") else ""),
		"🏠  " .. (if #owned > 0 then table.concat(owned, ", ") else "No property yet"),
		"💰  Net worth " .. Format.Money(Budget.NetWorth(life)),
	}
	for i, fact in ipairs(facts) do
		Create.Label({ Text = fact, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 10 + i, Parent = scroll })
	end

	Create.Label({
		Text = ("📝 %d decisions made this life"):format(#life.Decisions),
		TextColor3 = Theme.Color.TextDim,
		TextSize = Theme.TextSize.Small,
		LayoutOrder = 20,
		Parent = scroll,
	})
	return handle
end

-- ===== Lifecycle =====
function HUDController.Init()
	HUDController.AddAction({ Id = "Stats", Icon = "📊", Order = 100, OnClick = HUDController.OpenStats })
	gameFrame = UIController.NewScreen("Game", {
		OnOpen = function()
			render()
			update(false)
			HUDController.Opened:Fire()
		end,
		OnClose = function()
			UIController.ClosePanel()
			HUDController.Closed:Fire()
		end,
	})
	HUDController.Content = Create("Frame", { Name = "Content", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = gameFrame })
	hud = Create("Frame", {
		Name = "HUD",
		BackgroundColor3 = Theme.Color.Surface,
		BackgroundTransparency = 0.1,
		Position = UDim2.fromOffset(12, 10),
		Size = UDim2.new(1, -24, 0, 74),
		Parent = gameFrame,
	})
end

function HUDController.Start()
	DataController.Changed:Connect(function()
		if UIController.Current() == "Game" then
			update(true)
		end
	end)
	StyleController.Changed:Connect(function()
		if UIController.Current() == "Game" then
			update(false)
		end
	end)
	UIController.LayoutChanged:Connect(function()
		if UIController.Current() == "Game" then
			render()
			update(false)
		end
	end)
end

return HUDController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="124">
            <Properties>
              <string name="Name">HelpController</string>
              <string name="Source"><![CDATA[--[[
	HelpController  (StarterPlayerScripts.Client.Controllers.HelpController)
	❓ Help & support (main menu → Help): short answers to the common
	questions (tap one to open it), how to report a problem or a player,
	the game version, and buttons to replay the tutorial or open Settings.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local StatDefinitions = require(Shared.Data.StatDefinitions)
local World = require(Shared.Data.World)
local People = require(Shared.Util.People)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Components = require(UILib.Components)
local Layout = require(UILib.Layout)

local UIController = require(script.Parent.UIController)

local HelpController = {}
HelpController.Priority = 67

local frame: CanvasGroup
local openTopic: string? = "HowToPlay"

local function statsText(): string
	local lines = {}
	for _, name in ipairs(StatDefinitions.Order) do
		local info = StatDefinitions.Info[name]
		table.insert(lines, ("%s %s: %s"):format(info.Icon, info.DisplayName, info.Description))
	end
	return table.concat(lines, "\n")
end

HelpController.Topics = {
	{ Id = "HowToPlay", Title = "How do I play?", Icon = "🎮", Text = function()
		return "You live a whole life, from age 5 to 85, through six life stages. Each decision card shows a situation: tap a choice, then confirm. The arrows hint at what it might change, and 🎲 means it's risky. Locked cards hint at hidden paths you could unlock with different choices."
	end },
	{ Id = "Stats", Title = "What do the stats mean?", Icon = "📊", Text = statsText },
	{ Id = "Actions", Title = "Actions and Lifeville", Icon = "🌆", Text = function()
		return ("Between decisions you get %d actions. Spend them on 👥 People (time, gifts, talks), or press 🌆 to explore Lifeville: study at school, run in the park, eat out, work an extra shift at your job and more. More of the town opens as you grow up: Downtown and the harbour at %d, the university and Career Row at %d, the Sunset Club at %d."):format(People.ActionsPerTurn, World.StageAges[2], World.StageAges[3], World.StageAges[6])
	end },
	{ Id = "Reveal", Title = "What is the Life Reveal?", Icon = "🔮", Text = function()
		return "At the end of every life stage, the Life Reveal predicts your possible futures from your real choices and stats. The odds change as you live, sometimes with a twist. At 85 you get your ending, and you can compare what was predicted with what really happened in 📜 Life History."
	end },
	{ Id = "Coins", Title = "Coins, the shop and passes", Icon = "🪙", Text = function()
		return "You earn Coins by playing: finishing stages and lives, joining group decisions and city events, achievements, challenges and daily rewards. Spend them in the 🛍️ Shop on cosmetics: outfits, homes, cars, pets, titles and effects. Nothing you can buy changes your life's choices or outcomes."
	end },
	{ Id = "Extras", Title = "Achievements, challenges and daily rewards", Icon = "🏆", Text = function()
		return "🏆 Achievements unlock as you play (some are secret!). 🎯 New daily and weekly challenges pay Coins automatically when you finish them. 🎁 Claim a daily reward every day to build a streak; day 7 is the big one. ⭐ Memory Stars are hidden all over Lifeville."
	end },
	{ Id = "Rebirth", Title = "Rebirth and Legacy perks", Icon = "🌟", Text = function()
		return "Every life you complete raises your Legacy level and unlocks perks. When you start a new life you can be reborn with one of them, like a head start in Intelligence or Health. Perks are earned by playing, never bought."
	end },
	{ Id = "Friends", Title = "Playing with friends", Icon = "🤝", Text = function()
		return "Invite players in your server to a Life Circle to vote on group decisions, watch Group Life Reveals and compare futures. Your life always stays your own. You can also trade cosmetic items: both players see the offers and must press Ready, and only items bought with Coins can be traded."
	end },
	{ Id = "Safety", Title = "Privacy and safety", Icon = "🛡️", Text = function()
		return "Settings → Privacy decides who can see your futures, life stats and past lives (Everyone, Friends or Nobody). Choosing Nobody also keeps you off the global leaderboards. Names are filtered by Roblox. To report a player, open the Roblox menu (☰ or Esc) and choose Report."
	end },
	{ Id = "Support", Title = "Something not working?", Icon = "🧰", Text = function()
		return Config.Support .. "\n\nVersion " .. Config.Version
	end },
}

local function render()
	Create.Clear(frame, true)
	Layout.Header(frame, "Help", function()
		UIController.Back()
	end)
	local scroll = Layout.Scroll(frame)
	local width = math.min(760, UIController.GetVirtualSize().X - 32)
	local column = Layout.Column(scroll, width)
	for i, topic in ipairs(HelpController.Topics) do
		local open = openTopic == topic.Id
		Components.Button({ Name = "Topic_" .. topic.Id, Text = topic.Title, Icon = topic.Icon, Style = if open then "Primary" else "Secondary", Size = UDim2.fromOffset(width, 50), TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = i * 2, Parent = column, OnClick = function()
			openTopic = if open then nil else topic.Id
			render()
		end })
		if open then
			local panel = Components.Panel({ Name = "Answer_" .. topic.Id, Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, Padding = 16, LayoutOrder = i * 2 + 1, Parent = column, Color = Theme.Color.SurfaceHigh })
			Create.Label({ Name = "Text", Text = topic.Text(), AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.fromScale(1, 0), Parent = panel })
		end
	end
	local row = Create("Frame", { Name = "Buttons", BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 54), LayoutOrder = 100, Parent = column })
	Create.List(Enum.FillDirection.Horizontal, 10).Parent = row
	Components.Button({ Name = "ReplayTutorial", Text = "Replay the tutorial", Icon = "▶", Style = "Accent", Size = UDim2.fromOffset(math.floor((width - 10) / 2), 52), TextSize = 17, LayoutOrder = 1, Parent = row, OnClick = function()
		require(script.Parent.TutorialController).Restart()
	end })
	Components.Button({ Name = "OpenSettings", Text = "Settings", Icon = "⚙️", Style = "Secondary", Size = UDim2.fromOffset(math.floor((width - 10) / 2), 52), TextSize = 17, LayoutOrder = 2, Parent = row, OnClick = function()
		UIController.Show("Settings")
	end })
end

function HelpController.Open(topicId: string?)
	openTopic = topicId or openTopic
	UIController.Show("Help")
end

function HelpController.Init()
	frame = UIController.NewScreen("Help", { Back = true, OnOpen = render })
end

function HelpController.Start()
	UIController.LayoutChanged:Connect(function()
		if UIController.Current() == "Help" then
			render()
		end
	end)
end

return HelpController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="125">
            <Properties>
              <string name="Name">InventoryController</string>
              <string name="Source"><![CDATA[--[[
	InventoryController  (StarterPlayerScripts.Client.Controllers.InventoryController)
	The 🎒 My Items screen (main menu): your look, what's equipped in every
	slot (change or remove), and everything you own, ready to equip.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Catalog = require(Shared.Data.Catalog)
local Format = require(Shared.Util.Format)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Components = require(UILib.Components)
local Layout = require(UILib.Layout)
local Avatar = require(UILib.Avatar)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local NotificationController = require(script.Parent.NotificationController)
local StyleController = require(script.Parent.StyleController)
local ShopController = require(script.Parent.ShopController)

local InventoryController = {}
InventoryController.Priority = 52

local frame: CanvasGroup
local busy = false

local ERRORS = {
	NotOwned = "You don't own that item.",
	NeedVIP = "VIP items need the VIP pass to wear.",
	NoSuchItem = "That item isn't available any more.",
	BadSlot = "That slot doesn't exist.",
	RateLimited = "Slow down a moment.",
}

local function act(remote: string, arg)
	if busy then
		return
	end
	busy = true
	local ok, result = Net.Invoke(remote, arg)
	busy = false
	if not ok then
		NotificationController.Notify({ Title = "🎒 My Items", Text = ERRORS[result] or tostring(result), Kind = "Warning" })
	end
end

local function heading(parent, text: string, order: number)
	Create.Label({ Text = text, TextSize = Theme.TextSize.Tiny, FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Primary, Size = UDim2.new(1, 0, 0, 28), TextYAlignment = Enum.TextYAlignment.Bottom, LayoutOrder = order, Parent = parent })
end

local function render()
	Create.Clear(frame, true)
	Layout.Header(frame, "My Items", function()
		UIController.Back()
	end)
	local scroll = Layout.Scroll(frame)
	local width = math.min(820, UIController.GetVirtualSize().X - 32)
	local column = Layout.Column(scroll, width)
	local data = DataController.Get()
	if not data then
		return
	end
	local style = StyleController.Get()
	local life = DataController.GetActiveLife()
	local name = if life then life.Name else (Players.LocalPlayer.DisplayName or "You")

	-- Your look
	local look = Components.Panel({ Name = "Look", Size = UDim2.fromOffset(width, 120), Padding = 14, LayoutOrder = 1, Parent = column })
	Avatar.Badge({ Style = style, Size = 90, Parent = look })
	Create.Label({ Name = "LookName", Text = Avatar.Line(name, style), RichText = true, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H3, Position = UDim2.fromOffset(106, 8), Size = UDim2.new(1, -110, 0, 30), TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, Parent = look })
	local owned = 0
	for _ in pairs(data.Inventory.Owned) do
		owned += 1
	end
	Create.Label({ Text = ("🪙 %s Coins · %d of %d items owned"):format(Format.Commas(data.Coins), owned, #Catalog.Items), TextColor3 = Theme.Color.TextDim, Position = UDim2.fromOffset(106, 44), Size = UDim2.new(1, -110, 0, 24), Parent = look })
	Components.Button({ Name = "OpenShop", Text = "Shop", Icon = "🛍️", Style = "Accent", Size = UDim2.fromOffset(140, 40), Position = UDim2.fromOffset(106, 72), TextSize = 17, Parent = look, OnClick = function()
		ShopController.Open()
	end })

	-- Loadout
	heading(column, "EQUIPPED", 2)
	for i, slotId in ipairs(Catalog.SlotOrder) do
		local slot = Catalog.Slots[slotId]
		local item = Catalog.Get(data.Inventory.Equipped[slotId])
		local row = Create("Frame", { Name = "Slot_" .. slotId, BackgroundColor3 = Theme.Color.SurfaceHigh, BackgroundTransparency = 0.2, Size = UDim2.fromOffset(width, 52), LayoutOrder = 2 + i, Parent = column }, { Create.Corner(Theme.RadiusSmall), Create.Padding(4, 12) })
		Create.Label({ Text = slot.Name, TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.Small, Size = UDim2.new(0.28, 0, 1, 0), TextWrapped = false, Parent = row })
		Create.Label({ Name = "Equipped", Text = if item then item.Icon .. " " .. item.Name else "Default", FontFace = Theme.Font.Bold, Position = UDim2.fromScale(0.28, 0), Size = UDim2.new(0.4, 0, 1, 0), TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
		local buttons = Create("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromOffset(230, 40), Parent = row })
		Create.List(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center).Parent = buttons
		Components.Button({ Name = "Change", Text = "Change", Style = "Secondary", Size = UDim2.fromOffset(110, 38), TextSize = 16, LayoutOrder = 1, Parent = buttons, OnClick = function()
			ShopController.Open(slot.Category)
		end })
		if item then
			Components.Button({ Name = "Remove", Text = "Remove", Style = "Ghost", Size = UDim2.fromOffset(110, 38), TextSize = 16, LayoutOrder = 2, Parent = buttons, OnClick = function()
				act("ShopUnequip", slotId)
			end })
		end
	end

	-- Owned items
	heading(column, "YOUR ITEMS", 30)
	local grid = Create("Frame", { Name = "Owned", BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 31, Parent = column })
	local columns = if UIController.IsNarrow() then 2 else 4
	Create("UIGridLayout", { CellSize = UDim2.fromOffset(math.floor((width - 10 * (columns - 1)) / columns), 130), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	local list = {}
	for _, item in ipairs(Catalog.Items) do
		if data.Inventory.Owned[item.Id] then
			table.insert(list, item)
		end
	end
	for i, item in ipairs(list) do
		local isOn = data.Inventory.Equipped[item.Slot] == item.Id
		local card = Create("Frame", { Name = "Own_" .. item.Id, BackgroundColor3 = Theme.Color.Surface, LayoutOrder = i, Parent = grid }, { Create.Corner(Theme.RadiusSmall), Create.Stroke(if isOn then Theme.Color.Positive else Theme.Color.Stroke, if isOn then 2.5 else 1.5, if isOn then 0 else 0.4), Create.Padding(8) })
		Create.Label({ Text = item.Icon, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 44), Parent = card })
		Create.Label({ Text = item.Name, TextSize = Theme.TextSize.Tiny, FontFace = Theme.Font.Bold, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 46), Size = UDim2.new(1, 0, 0, 30), Parent = card })
		if isOn then
			Create.Label({ Name = "On", Text = "✅", TextSize = 16, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(24, 20), Parent = card })
		end
		Components.Button({ Name = "Toggle", Text = if isOn then "Unequip" else "Equip", Style = if isOn then "Secondary" else "Primary", Size = UDim2.new(1, 0, 0, 34), AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), TextSize = 15, Parent = card, OnClick = function()
			if isOn then
				act("ShopUnequip", item.Slot)
			else
				act("ShopEquip", item.Id)
			end
		end })
	end
	if #list == 0 then
		Create.Label({ Text = "You don't own any items yet. Visit the Shop to get your first one!", TextColor3 = Theme.Color.TextDim, Size = UDim2.fromOffset(width, 40), LayoutOrder = 1, Parent = grid })
	end
end

function InventoryController.Init()
	frame = UIController.NewScreen("Inventory", { Back = true, OnOpen = render })
end

function InventoryController.Start()
	DataController.Changed:Connect(function()
		if UIController.Current() == "Inventory" then
			render()
		end
	end)
	UIController.LayoutChanged:Connect(function()
		if UIController.Current() == "Inventory" then
			render()
		end
	end)
end

return InventoryController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="126">
            <Properties>
              <string name="Name">LeaderboardController</string>
              <string name="Source"><![CDATA[--[[
	LeaderboardController  (StarterPlayerScripts.Client.Controllers.LeaderboardController)
	🏆 The Leaderboards screen (main menu): pick a board (lives lived,
	richest life, achievements, login streak, Memory Stars) and Global or
	Friends. Your row is highlighted; tap a player in this server to see
	their profile. Results are cached for a minute to go easy on the server.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Leaderboards = require(Shared.Data.Leaderboards)
local Format = require(Shared.Util.Format)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Components = require(UILib.Components)
local Layout = require(UILib.Layout)

local UIController = require(script.Parent.UIController)

local LeaderboardController = {}
LeaderboardController.Priority = 64
LeaderboardController.CacheSeconds = 60

local frame: CanvasGroup
local boardId = Leaderboards.List[1].Id
local scope = "Global"
local cache = {}
local loading = false

local MEDALS = { "🥇", "🥈", "🥉" }

local function inServer(userId: number): boolean
	for _, p in ipairs(Players:GetPlayers()) do
		if p.UserId == userId then
			return true
		end
	end
	return false
end

function LeaderboardController.Fetch(id: string, which: string, force: boolean?)
	local key = id .. ":" .. which
	local cached = cache[key]
	if cached and not force and os.clock() - cached.Time < LeaderboardController.CacheSeconds then
		return true, cached.Result
	end
	local ok, result = Net.Invoke("GetLeaderboard", id, which)
	if ok then
		cache[key] = { Time = os.clock(), Result = result }
	end
	return ok, result
end

local function valueText(board, value: number): string
	return if board.Money then Format.Money(value) else Format.Commas(value)
end

local render

local function renderList(column, width: number)
	local board = Leaderboards.ById[boardId]
	local list = Create("Frame", { Name = "List", BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 10, Parent = column })
	Create.List(Enum.FillDirection.Vertical, 6).Parent = list
	local status = Create.Label({ Name = "Status", Text = "Loading…", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 0, Parent = list })
	loading = true
	local ok, result = LeaderboardController.Fetch(boardId, scope)
	loading = false
	if not list.Parent then
		return
	end
	if not ok then
		status.Text = if result == "RateLimited" then "Slow down a moment, then try again." else "Couldn't load this leaderboard right now."
		return
	end
	local me = Players.LocalPlayer.UserId
	if #result.Entries == 0 then
		status.Text = if scope == "Friends" then "None of your Roblox friends have a score here yet. Invite them!" else "No scores yet. Be the first!"
	else
		status.Text = if result.Offline then "Studio test mode: scores are kept only until you press Stop." else ""
	end
	for i, entry in ipairs(result.Entries) do
		local mine = entry.UserId == me
		local row = Create("TextButton", { Name = "Entry_" .. entry.UserId, Text = "", AutoButtonColor = false, BackgroundColor3 = if mine then Theme.Color.SurfaceHigher else Theme.Color.Surface, Size = UDim2.new(1, 0, 0, 50), LayoutOrder = i, Parent = list }, { Create.Corner(Theme.RadiusSmall), Create.Stroke(if mine then Theme.Color.Primary else Theme.Color.Stroke, if mine then 2 else 1, if mine then 0 else 0.5), Create.Padding(0, 14) })
		Create.Label({ Name = "Rank", Text = MEDALS[entry.Rank] or ("#" .. entry.Rank), FontFace = Theme.Font.Heavy, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(0, 56, 1, 0), Parent = row })
		Create.Label({ Name = "Name", Text = entry.Name .. (if mine then " (you)" else ""), FontFace = Theme.Font.Bold, Position = UDim2.fromOffset(62, 0), Size = UDim2.new(1, -240, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = row })
		Create.Label({ Name = "Value", Text = board.Icon .. " " .. valueText(board, entry.Value), FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Gold, TextXAlignment = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 170, 1, 0), Parent = row })
		if inServer(entry.UserId) then
			row.Activated:Connect(function()
				require(script.Parent.ProfileController).Open(entry.UserId)
			end)
		end
	end
	if result.You == nil and scope == "Global" and #result.Entries > 0 then
		Create.Label({ Text = "You're not in the top " .. #result.Entries .. " yet. Keep living!", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 999, Parent = list })
	end
end

function render()
	Create.Clear(frame, true)
	Layout.Header(frame, "Leaderboards", function()
		UIController.Back()
	end)
	local scroll = Layout.Scroll(frame)
	local width = math.min(820, UIController.GetVirtualSize().X - 32)
	local column = Layout.Column(scroll, width)
	local boards = Create("Frame", { Name = "Boards", BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = column })
	local list = Create.List(Enum.FillDirection.Horizontal, 8)
	list.Wraps = true
	list.Parent = boards
	for i, board in ipairs(Leaderboards.List) do
		Components.Button({ Name = "Board_" .. board.Id, Text = board.Name, Icon = board.Icon, Style = if board.Id == boardId then "Primary" else "Secondary", Size = UDim2.fromOffset(if UIController.IsNarrow() then 240 else 196, 44), TextSize = 16, LayoutOrder = i, Parent = boards, OnClick = function()
			if not loading then
				boardId = board.Id
				render()
			end
		end })
	end
	local scopes = Create("Frame", { Name = "Scopes", BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 46), LayoutOrder = 2, Parent = column })
	Create.List(Enum.FillDirection.Horizontal, 8).Parent = scopes
	for i, s in ipairs({ { "Global", "🌍" }, { "Friends", "🤝" } }) do
		Components.Button({ Name = "Scope_" .. s[1], Text = s[1], Icon = s[2], Style = if scope == s[1] then "Accent" else "Secondary", Size = UDim2.fromOffset(160, 44), TextSize = 17, LayoutOrder = i, Parent = scopes, OnClick = function()
			if not loading then
				scope = s[1]
				render()
			end
		end })
	end
	Components.Button({ Name = "Refresh", Text = "Refresh", Icon = "🔄", Style = "Ghost", Size = UDim2.fromOffset(140, 44), TextSize = 16, LayoutOrder = 3, Parent = scopes, OnClick = function()
		cache[boardId .. ":" .. scope] = nil
		render()
	end })
	task.spawn(renderList, column, width)
end

function LeaderboardController.Open(id: string?, which: string?)
	boardId = id or boardId
	scope = which or scope
	UIController.Show("Leaderboards")
end

function LeaderboardController.Init()
	frame = UIController.NewScreen("Leaderboards", { Back = true, OnOpen = render })
end

function LeaderboardController.Start()
	UIController.LayoutChanged:Connect(function()
		if UIController.Current() == "Leaderboards" then
			render()
		end
	end)
end

return LeaderboardController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="127">
            <Properties>
              <string name="Name">LifeHistoryController</string>
              <string name="Source"><![CDATA[--[[
	LifeHistoryController  (StarterPlayerScripts.Client.Controllers.LifeHistoryController)
	The 📜 Life History screen (appears on the main menu automatically).
	  • every completed life (newest first) with its ending title
	  • a detail view: career, wealth, family, achievements, moments,
	    regrets, key decisions and how the predictions played out
	  • replay any life's Final Reveal
	  • compare two lives side by side: "What if I had chosen differently?"
	Data: profile.LifeHistory (written by the server at the end of each life).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Futures = require(Shared.Util.Futures)
local Format = require(Shared.Util.Format)
local StatDefinitions = require(Shared.Data.StatDefinitions)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Components = require(UILib.Components)
local Layout = require(UILib.Layout)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local RevealController = require(script.Parent.RevealController)

local LifeHistoryController = {}
LifeHistoryController.Priority = 48

local frame: CanvasGroup

local function history()
	local data = DataController.Get()
	local list = {}
	if data then
		for i = #data.LifeHistory, 1, -1 do
			table.insert(list, data.LifeHistory[i])
		end
	end
	return list
end

function LifeHistoryController.Find(id: number)
	for _, entry in ipairs(history()) do
		if entry.Id == id then
			return entry
		end
	end
	return nil
end

local function summaryLine(entry): string
	return ("Lived to %d · %s · %s"):format(entry.Age, entry.Career, Format.Money(entry.NetWorth))
end

local function familyLine(entry): string
	local parts = {}
	if entry.Partner then
		table.insert(parts, (if entry.Partner.Married then "💍 " else "❤️ ") .. entry.Partner.Name)
	end
	if #entry.Children > 0 then
		table.insert(parts, ("👶 %d %s"):format(#entry.Children, if #entry.Children == 1 then "child" else "children"))
	end
	return if #parts > 0 then table.concat(parts, "  ·  ") else "🕊️ Single"
end

local function heading(parent, text: string, order: number)
	Create.Label({ Text = text, TextSize = Theme.TextSize.Tiny, FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Primary, Size = UDim2.new(1, 0, 0, 24), TextYAlignment = Enum.TextYAlignment.Bottom, LayoutOrder = order, Parent = parent })
end

local function lines(parent, list, order: number)
	for i, text in ipairs(list) do
		Create.Label({ Text = text, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order + i, Parent = parent })
	end
end

local openDetail

local function openCompare(a, b)
	local handle = UIController.OpenPanel({ Name = "CompareLivesModal", Title = "⚖️  " .. a.Name .. " vs " .. b.Name, Width = 860 })
	handle.Subtitle.Text = "Different choices. Different lives."
	local scroll = handle.Scroll
	local function row(order, label, left, right)
		local r = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, Parent = scroll })
		Create.Label({ Text = label, TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.Small, Size = UDim2.new(0.24, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = r })
		Create.Label({ Text = left, FontFace = Theme.Font.Bold, Size = UDim2.new(0.38, -8, 0, 0), Position = UDim2.fromScale(0.24, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = r })
		Create.Label({ Text = right, FontFace = Theme.Font.Bold, Size = UDim2.new(0.38, -8, 0, 0), Position = UDim2.fromScale(0.62, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = r })
	end
	row(1, "", a.Name, b.Name)
	row(2, "Ending", a.Ending.Icon .. " " .. a.Ending.Title, b.Ending.Icon .. " " .. b.Ending.Title)
	row(3, "Career", a.Career, b.Career)
	row(4, "Education", a.Education, b.Education)
	row(5, "Net worth", Format.Money(a.NetWorth), Format.Money(b.NetWorth))
	row(6, "Family", familyLine(a), familyLine(b))
	row(7, "Life score", a.Overall .. " / 100", b.Overall .. " / 100")
	for i, statName in ipairs(StatDefinitions.Order) do
		local info = StatDefinitions.Info[statName]
		local x, y = a.Stats[statName], b.Stats[statName]
		row(10 + i, info.Icon .. " " .. info.DisplayName, tostring(x) .. (if x > y + 4 then " ⭐" else ""), tostring(y) .. (if y > x + 4 then " ⭐" else ""))
	end
	local function came(entry)
		local names = {}
		for _, id in ipairs(entry.CameTrue) do
			if Futures.Info[id] and Futures.Info[id].Positive then
				table.insert(names, Futures.Info[id].Icon)
			end
		end
		return if #names > 0 then table.concat(names, " ") else "—"
	end
	row(30, "Futures that came true", came(a), came(b))
	local function firstChoice(entry)
		local d = entry.KeyDecisions[1]
		return if d then ("Age %d: %s"):format(d.Age, d.Choice) else "—"
	end
	row(31, "A defining choice", firstChoice(a), firstChoice(b))
	Components.Button({ Name = "BackToLife", Text = "Back to " .. a.Name, Icon = "‹", Style = "Secondary", Size = UDim2.new(1, 0, 0, 50), LayoutOrder = 99, Parent = scroll, OnClick = function()
		openDetail(a)
	end })
end

local function pickCompare(entry)
	local handle = UIController.OpenPanel({ Name = "PickLifeModal", Title = "⚖️  Compare " .. entry.Name .. " with…", Width = 640 })
	local scroll = handle.Scroll
	local count = 0
	for i, other in ipairs(history()) do
		if other.Id ~= entry.Id then
			count += 1
			Components.Button({ Name = "Pick" .. other.Id, Text = ("%s %s: %s"):format(other.Ending.Icon, other.Name, other.Ending.Title), Style = "Secondary", Size = UDim2.new(1, 0, 0, 52), TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = i, Parent = scroll, OnClick = function()
				openCompare(entry, other)
			end })
		end
	end
	if count == 0 then
		Create.Label({ Text = "Complete another life to compare them!", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, Parent = scroll })
	end
end

function openDetail(entry)
	local handle = UIController.OpenPanel({ Name = "LifeDetailModal", Title = entry.Ending.Icon .. "  " .. entry.Name .. ": " .. entry.Ending.Title, Width = 820 })
	handle.Subtitle.Text = summaryLine(entry)
	local scroll = handle.Scroll
	local buttons = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 52), LayoutOrder = 0, Parent = scroll })
	Create.List(Enum.FillDirection.Horizontal, 10).Parent = buttons
	Components.Button({ Name = "Replay", Text = "Replay reveal", Icon = "▶", Style = "Primary", Size = UDim2.fromOffset(220, 50), TextSize = 18, LayoutOrder = 1, Parent = buttons, OnClick = function()
		UIController.ClosePanel()
		LifeHistoryController.Replay(entry)
	end })
	Components.Button({ Name = "CompareLives", Text = "Compare", Icon = "⚖️", Style = "Accent", Size = UDim2.fromOffset(180, 50), TextSize = 18, LayoutOrder = 2, Parent = buttons, OnClick = function()
		pickCompare(entry)
	end })
	Create.Label({ Text = "“" .. entry.Ending.Line .. "”", FontFace = Theme.Font.Bold, TextColor3 = Theme.Color.Gold, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = scroll })
	heading(scroll, "LIFE", 2)
	lines(scroll, {
		"💼 " .. entry.Career .. "   ·   🎓 " .. entry.Education,
		"💰 Net worth " .. Format.Money(entry.NetWorth) .. "   ·   Life score " .. entry.Overall .. "/100",
		familyLine(entry) .. (if entry.BestFriend then "   ·   🫶 " .. entry.BestFriend else ""),
	}, 2)
	heading(scroll, "ACHIEVEMENTS", 10)
	lines(scroll, if #entry.Achievements > 0 then entry.Achievements else { "—" }, 10)
	heading(scroll, "GREATEST MOMENTS", 30)
	lines(scroll, if #entry.Moments > 0 then entry.Moments else { "—" }, 30)
	heading(scroll, "BIGGEST REGRETS", 40)
	lines(scroll, if #entry.Mistakes > 0 then entry.Mistakes else { "None worth mentioning." }, 40)
	heading(scroll, "KEY DECISIONS", 50)
	local decisionLines = {}
	for _, d in ipairs(entry.KeyDecisions) do
		table.insert(decisionLines, ("Age %d: %s (%s)"):format(d.Age, d.Choice, d.Title))
	end
	lines(scroll, decisionLines, 50)
	heading(scroll, "PREDICTIONS VS REALITY", 60)
	local came = {}
	for _, id in ipairs(entry.CameTrue) do
		came[id] = true
	end
	local journeyLines = {}
	for _, j in ipairs(entry.Journey) do
		local parts = {}
		for _, top in ipairs(j.Top) do
			table.insert(parts, ("%s %d%%%s"):format(Futures.Info[top.Id].Icon, top.Pct, if came[top.Id] then "✅" else ""))
		end
		table.insert(journeyLines, ("At %d: %s%s"):format(j.Age, table.concat(parts, "  "), if j.Twist then "  ⚡" else ""))
	end
	lines(scroll, journeyLines, 60)
end

function LifeHistoryController.Replay(entry)
	task.spawn(function()
		local action = RevealController.PlayFinal(entry, { Replay = true })
		if action == "Again" then
			UIController.Show("SlotSelect", "New")
		end
	end)
end

local function render()
	Create.Clear(frame, true)
	Layout.Header(frame, "Life History", function()
		UIController.Back()
	end)
	local scroll = Layout.Scroll(frame)
	local width = math.min(760, UIController.GetVirtualSize().X - 32)
	local list = history()
	local data = DataController.Get()
	Create.Label({
		Text = ("%d %s lived · 🪙 %d coins"):format(#list, if #list == 1 then "life" else "lives", data and data.Coins or 0),
		TextColor3 = Theme.Color.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromOffset(width, 24),
		LayoutOrder = 0,
		Parent = scroll,
	})
	if #list == 0 then
		local empty = Components.Panel({ Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, Padding = 24, LayoutOrder = 1, Parent = scroll })
		Create.Label({ Text = "📜 No completed lives yet.\nLive a whole life to age 85 to see its story, ending and Final Reveal here.", TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, Parent = empty })
		return
	end
	for i, entry in ipairs(list) do
		local card = Create("TextButton", {
			Name = "Life" .. entry.Id,
			Text = "",
			AutoButtonColor = false,
			Selectable = true,
			BackgroundColor3 = Theme.Color.Surface,
			Size = UDim2.fromOffset(width, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = i,
			Parent = scroll,
		}, { Create.Corner(Theme.Radius), Create.Stroke(), Create.Padding(14, 18) })
		Create.List(Enum.FillDirection.Vertical, 4).Parent = card
		Create.Label({ Text = entry.Ending.Icon .. "  " .. entry.Ending.Title, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H3, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = card })
		Create.Label({ Text = entry.Name .. " · " .. summaryLine(entry), TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = card })
		Create.Label({ Text = familyLine(entry), TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = card })
		card.Activated:Connect(function()
			if Components.OnClickSound then
				Components.OnClickSound()
			end
			openDetail(entry)
		end)
	end
end

function LifeHistoryController.Init()
	frame = UIController.NewScreen("LifeHistory", { Back = true, OnOpen = render })
end

function LifeHistoryController.Start()
	DataController.Changed:Connect(function()
		if UIController.Current() == "LifeHistory" then
			render()
		end
	end)
	UIController.LayoutChanged:Connect(function()
		if UIController.Current() == "LifeHistory" then
			render()
		end
	end)
end

return LifeHistoryController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="128">
            <Properties>
              <string name="Name">LifestyleController</string>
              <string name="Source"><![CDATA[--[[
	LifestyleController  (StarterPlayerScripts.Client.Controllers.LifestyleController)
	The 🎯 Lifestyle panel: choose what this life prioritises as the years
	pass (Shared/Data/Lifestyle). Free to change at any time; the server
	applies the focus every simulated year.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Lifestyle = require(Shared.Data.Lifestyle)
local StatDefinitions = require(Shared.Data.StatDefinitions)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Components = require(UILib.Components)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local HUDController = require(script.Parent.HUDController)
local NotificationController = require(script.Parent.NotificationController)

local LifestyleController = {}
LifestyleController.Priority = 43

local handle = nil
local busy = false

local function effectText(info, age: number): string
	local parts = {}
	local perYear = if age < 19 and info.YouthPerYear then info.YouthPerYear else info.PerYear
	for stat, delta in pairs(perYear or {}) do
		local stat_info = StatDefinitions.Info[stat]
		if stat_info and not (stat == "Career" and age < 19) then
			table.insert(parts, ("%s%s"):format(stat_info.Icon, if delta > 0 then "▲" else "▼"))
		end
	end
	if info.SavingsBonus then
		table.insert(parts, "💰 saves more")
	end
	if info.BondDecay then
		local grows = false
		for _, v in pairs(info.BondDecay) do
			grows = grows or v < 0
		end
		table.insert(parts, if grows then "💞 bonds grow" else "💔 bonds fade faster")
	end
	if info.PromotionMultiplier then
		table.insert(parts, if info.PromotionMultiplier > 1 then "📈 faster promotions" else "📉 slower promotions")
	end
	table.sort(parts)
	return table.concat(parts, "   ")
end

local function render()
	local life = DataController.GetActiveLife()
	if not handle or not life then
		return
	end
	handle.Clear()
	local current = Lifestyle.Info[life.Focus] or Lifestyle.Info.Balanced
	handle.Subtitle.Text = "Current focus: " .. current.Icon .. " " .. current.Title .. " · applies every year that passes"
	for i, id in ipairs(Lifestyle.Order) do
		local info = Lifestyle.Info[id]
		local available = Lifestyle.Available(id, life.Age)
		local selected = life.Focus == id
		local card = Create("TextButton", {
			Name = id,
			Text = "",
			AutoButtonColor = false,
			Selectable = true,
			BackgroundColor3 = if selected then Theme.Color.SurfaceHigher else Theme.Color.SurfaceHigh,
			BackgroundTransparency = if available then 0.05 else 0.5,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = i,
			Parent = handle.Scroll,
		}, { Create.Corner(Theme.RadiusSmall), Create.Stroke(if selected then Theme.Color.Primary else Theme.Color.Stroke, if selected then 3 else 1.5, if selected then 0 else 0.4), Create.Padding(12, 16) })
		Create.List(Enum.FillDirection.Vertical, 4).Parent = card
		Create.Label({ Text = info.Icon .. "  " .. info.Title .. (if selected then "   ✓ CURRENT" else ""), FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H3, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = card })
		Create.Label({ Text = if available then info.Description else ("Available from age %d."):format(info.MinAge or 0), TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = card })
		Create.Label({ Text = effectText(info, life.Age), FontFace = Theme.Font.Bold, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.Gold, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = card })
		card.Activated:Connect(function()
			if busy or selected or not available then
				return
			end
			if Components.OnClickSound then
				Components.OnClickSound()
			end
			busy = true
			local ok, result = Net.Invoke("SetFocus", id)
			busy = false
			if ok then
				NotificationController.Notify({ Title = "🎯 Lifestyle", Text = "Focus set to " .. info.Title .. ".", Kind = "Success", Duration = 2.5 })
			else
				NotificationController.Notify({ Title = "Not now", Text = tostring(result), Kind = "Warning", Duration = 3 })
			end
			task.wait(0.25)
			if handle and handle.IsOpen() then
				render()
			end
		end)
	end
end

function LifestyleController.Open()
	if not DataController.GetActiveLife() then
		return
	end
	handle = UIController.OpenPanel({ Name = "LifestyleModal", Title = "🎯  Lifestyle Focus", Width = 700, OnClose = function()
		handle = nil
	end })
	render()
end

function LifestyleController.Init()
	HUDController.AddAction({ Id = "Lifestyle", Icon = "🎯", Order = 20, OnClick = LifestyleController.Open })
end

function LifestyleController.Start()
	DataController.Changed:Connect(function()
		if handle and handle.IsOpen() and not busy then
			render()
		end
	end)
end

return LifestyleController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="129">
            <Properties>
              <string name="Name">LoadingController</string>
              <string name="Source"><![CDATA[--[[
	LoadingController  (StarterPlayerScripts.Client.Controllers.LoadingController)
	Full-screen loading screen shown from the moment the client starts until
	the player's data has arrived, then hands over to the main menu.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)
local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Anim = require(UILib.Anim)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)

local LoadingController = {}
LoadingController.Priority = 4
LoadingController.Done = false

local gui: ScreenGui
local group: CanvasGroup
local status: TextLabel

function LoadingController.Init()
	gui = Create("ScreenGui", {
		Name = "CYL_Loading",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ScreenInsets = Enum.ScreenInsets.None,
		DisplayOrder = 100,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	group = Create("CanvasGroup", {
		Name = "Loading",
		BackgroundColor3 = Theme.Color.White,
		Size = UDim2.fromScale(1, 1),
		Parent = gui,
	}, { Create.Gradient(Theme.Gradient.Backdrop, 120) })

	local center = Create("Frame", {
		Name = "Center",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.9, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = group,
	}, { Create.List(Enum.FillDirection.Vertical, 16, Enum.HorizontalAlignment.Center) })
	Create("UISizeConstraint", { MaxSize = Vector2.new(720, math.huge) }).Parent = center

	local title = Create.Label({
		Name = "Title",
		Text = Config.GameName,
		FontFace = Theme.Font.Heavy,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, 0, 0, 80),
		LayoutOrder = 1,
		Parent = center,
	})
	Create("UITextSizeConstraint", { MaxTextSize = 72 }).Parent = title
	Create.Gradient(Theme.Gradient.Title).Parent = title

	-- Spinner: a ring (UIStroke) with a gradient that rotates.
	local ring = Create("Frame", {
		Name = "Spinner",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(54, 54),
		LayoutOrder = 2,
		Parent = center,
	}, { Create.Corner(Theme.RadiusPill) })
	local stroke = Create.Stroke(Theme.Color.White, 5, 0)
	stroke.Parent = ring
	local spinGradient = Create("UIGradient", {
		Color = Theme.Gradient.Primary,
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.6, 0.2), NumberSequenceKeypoint.new(1, 1) }),
		Parent = stroke,
	})
	task.spawn(function()
		while gui.Parent and not LoadingController.Done do
			spinGradient.Rotation = (spinGradient.Rotation + 6) % 360
			task.wait(1 / 30)
		end
	end)

	status = Create.Label({
		Name = "Status",
		Text = "Loading your life…",
		FontFace = Theme.Font.Bold,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 3,
		Parent = center,
	})
	local tip = Create.Label({
		Name = "Tip",
		Text = "💡 " .. Config.LoadingTips[math.random(1, #Config.LoadingTips)],
		TextColor3 = Theme.Color.TextDim,
		TextSize = Theme.TextSize.Small,
		TextXAlignment = Enum.TextXAlignment.Center,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 4,
		Parent = center,
	})
	task.spawn(function()
		local i = 1
		while gui.Parent and not LoadingController.Done do
			task.wait(4)
			i = i % #Config.LoadingTips + 1
			tip.Text = "💡 " .. Config.LoadingTips[i]
		end
	end)
end

function LoadingController.Start()
	task.delay(20, function()
		if not LoadingController.Done then
			status.Text = "Still loading… if this takes much longer, try rejoining."
		end
	end)
	DataController.WaitForData()
	LoadingController.Done = true
	status.Text = "Ready!"
	UIController.Show("Menu")
	task.wait(0.3)
	Anim.Fade(group, false, 0.5)
	task.wait(0.6)
	gui:Destroy()
end

return LoadingController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="130">
            <Properties>
              <string name="Name">MapController</string>
              <string name="Source"><![CDATA[--[[
	MapController  (StarterPlayerScripts.Client.Controllers.MapController)
	🗺️ The town map (explore mode, the Plaza notice board, NPC directions):
	every district with its colour, icon and whether it's open for your life
	stage, the roads, the harbour bay, and you. Tap a district to set a
	waypoint: a glowing guide line from your character and a 📍 marker that
	clear when you arrive.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local World = require(Shared.Data.World)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local ExploreController = require(script.Parent.ExploreController)

local MapController = {}
MapController.Priority = 55
MapController.Extent = 262 -- the map shows -262..262 studs

local waypoint: { Part: BasePart, District: string, Expires: number }? = nil

local function stage(): number
	local life = DataController.GetActiveLife()
	return World.StageOf(if life and not life.Completed then life else nil)
end

function MapController.ClearWaypoint()
	if waypoint then
		waypoint.Part:Destroy()
		waypoint = nil
	end
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local attachment = root and root:FindFirstChild("CYL_WaypointFrom")
	if attachment then
		attachment:Destroy()
	end
end

function MapController.Waypoint(): string?
	return waypoint and waypoint.District or nil
end

function MapController.SetWaypoint(districtId: string)
	local d = World.ById[districtId]
	if not d then
		return
	end
	MapController.ClearWaypoint()
	local part = Instance.new("Part")
	part.Name = "CYL_Waypoint"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(1, 1, 1)
	part.CFrame = CFrame.new(d.X, 8, d.Z)
	local marker = Instance.new("BillboardGui")
	marker.Name = "Marker"
	marker.AlwaysOnTop = true
	marker.Size = UDim2.fromOffset(240, 60)
	marker.LightInfluence = 0
	marker.Parent = part
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = "📍 " .. d.Name
	label.TextScaled = true
	label.FontFace = Theme.Font.Heavy
	label.TextColor3 = Theme.Color.Gold
	label.TextStrokeTransparency = 0.3
	label.Parent = marker
	local target = Instance.new("Attachment")
	target.Name = "To"
	target.Parent = part
	part.Parent = workspace
	waypoint = { Part = part, District = districtId, Expires = os.clock() + 180 }

	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		local from = Instance.new("Attachment")
		from.Name = "CYL_WaypointFrom"
		from.Parent = root
		local beam = Instance.new("Beam")
		beam.Name = "Guide"
		beam.Attachment0 = from
		beam.Attachment1 = target
		beam.Color = ColorSequence.new(Theme.Color.Gold)
		beam.Width0 = 0.5
		beam.Width1 = 0.5
		beam.FaceCamera = true
		beam.LightEmission = 1
		beam.Transparency = NumberSequence.new(0.35)
		beam.Parent = part
	end
	ExploreController.ShowCard("🧭 " .. d.Name, "Follow the golden line" .. (if World.IsUnlocked(districtId, stage()) then "." else ". It's still locked for you: " .. World.UnlockText(d.UnlockStage) .. "."), nil, "Result")
end

local function toMap(x: number, z: number, size: number): UDim2
	local e = MapController.Extent
	return UDim2.fromOffset((x + e) / (2 * e) * size, (z + e) / (2 * e) * size)
end

local function rect(parent: Instance, name: string, x1: number, z1: number, x2: number, z2: number, size: number, colour: Color3, zIndex: number?)
	local e = MapController.Extent
	x1, x2 = math.max(-e, x1), math.min(e, x2)
	z1, z2 = math.max(-e, z1), math.min(e, z2)
	local scale = size / (2 * e)
	return Create("Frame", { Name = name, BackgroundColor3 = colour, BorderSizePixel = 0, Position = toMap(x1, z1, size), Size = UDim2.fromOffset((x2 - x1) * scale, (z2 - z1) * scale), ZIndex = zIndex or 1, Parent = parent })
end

function MapController.Open()
	local handle = UIController.OpenPanel({ Name = "MapModal", Title = "🗺️  " .. World.TownName, Width = 640, Height = 720 })
	handle.Subtitle.Text = "Tap a place to get directions"
	local size = math.min(540, UIController.GetVirtualSize().X - 80, UIController.GetVirtualSize().Y - 200)
	local map = Create("Frame", { Name = "Map", BackgroundColor3 = Color3.fromHex("#3FA7D6"), Size = UDim2.fromOffset(size, size), LayoutOrder = 1, ClipsDescendants = true, Parent = handle.Scroll }, { Create.Corner(Theme.RadiusSmall) })
	local grass = Color3.fromHex("#5DA34B")
	rect(map, "LandNorth", -320, -320, 320, 150, size, grass)
	rect(map, "LandSouth", -320, 150, 150, 320, size, grass)
	local road = Color3.fromHex("#3A3D42")
	local w = World.RoadWidth / 2
	for _, line in ipairs({ -80, 80 }) do
		rect(map, "Road", line - w, -252, line + w, 252, size, road, 2)
		rect(map, "Road", -252, line - w, 252, line + w, size, road, 2)
	end
	rect(map, "Ring", -252, -252, 252, -228, size, road, 2)
	rect(map, "Ring", -252, -252, -228, 252, size, road, 2)
	rect(map, "Ring", 228, -252, 252, 134, size, road, 2)
	rect(map, "Ring", -252, 228, 134, 252, size, road, 2)

	local current = stage()
	local half = World.CellSize / 2
	for _, d in ipairs(World.Districts) do
		local open = World.IsUnlocked(d.Id, current)
		local cell = rect(map, "District_" .. d.Id, d.X - half, d.Z - half, d.X + half, d.Z + half, size, Color3.fromHex(d.Map), 3)
		cell.BackgroundTransparency = if open then 0 else 0.45
		if d.Coastal then
			cell.BackgroundTransparency = if open then 0.25 else 0.55
		end
		Create.Corner(UDim.new(0, 6)).Parent = cell
		local button = Create("TextButton", { Name = "Go", Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = cell })
		button.Activated:Connect(function()
			UIController.ClosePanel()
			MapController.SetWaypoint(d.Id)
		end)
		Create.Label({ Name = "Icon", Text = (if open then d.Icon else "🔒"), TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromScale(0.25, 0.12), Size = UDim2.fromScale(0.5, 0.42), ZIndex = 4, Parent = cell })
		Create.Label({ Name = "Name", Text = d.Name, TextScaled = true, FontFace = Theme.Font.Bold, TextColor3 = Theme.Color.Black, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromScale(0.05, 0.58), Size = UDim2.fromScale(0.9, 0.28), ZIndex = 4, Parent = cell })
	end

	local you = Create("Frame", { Name = "You", BackgroundColor3 = Theme.Color.Primary, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 14), ZIndex = 8, Parent = map }, { Create.Corner(UDim.new(1, 0)), Create.Stroke(Theme.Color.White, 2, 0) })
	local function place()
		local character = Players.LocalPlayer.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		you.Visible = root ~= nil
		if root then
			you.Position = toMap(root.Position.X, root.Position.Z, size)
		end
	end
	place()
	task.spawn(function()
		while handle.IsOpen() do
			place()
			task.wait(0.3)
		end
	end)

	Create.Label({ Name = "Legend", Text = ("🔴 You · 🔒 opens later in life (Downtown & Harbour at %d, University & Career Row at %d, Sunset Club at %d)"):format(World.StageAges[2], World.StageAges[3], World.StageAges[6]), TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.fromScale(1, 0), LayoutOrder = 2, Parent = handle.Scroll })
	return handle
end

function MapController.Init() end

function MapController.Start()
	ExploreController.DistrictChanged:Connect(function(districtId)
		if waypoint and districtId == waypoint.District then
			MapController.ClearWaypoint()
		end
	end)
	ExploreController.Changed:Connect(function(on)
		if not on then
			MapController.ClearWaypoint()
		end
	end)
	task.spawn(function()
		while true do
			task.wait(5)
			if waypoint and os.clock() > waypoint.Expires then
				MapController.ClearWaypoint()
			end
		end
	end)
end

return MapController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="131">
            <Properties>
              <string name="Name">MenuController</string>
              <string name="Source"><![CDATA[--[[
	MenuController  (StarterPlayerScripts.Client.Controllers.MenuController)
	Screens: Menu, SlotSelect, NameEntry, Credits.

	The main menu shows every feature whose screen exists. Later phases register
	their screens (Shop, Achievements, Leaderboards, LifeHistory, Friends) and
	their buttons appear automatically, so no button ever leads nowhere.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Config = require(Shared.Config)
local LifeStages = require(Shared.Data.LifeStages)
local StatDefinitions = require(Shared.Data.StatDefinitions)
local DataTemplate = require(Shared.Data.DataTemplate)
local NamePool = require(Shared.Data.NamePool)
local Format = require(Shared.Util.Format)
local Careers = require(Shared.Data.Careers)
local Legacy = require(Shared.Data.Legacy)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Anim = require(UILib.Anim)
local Components = require(UILib.Components)
local Layout = require(UILib.Layout)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local NotificationController = require(script.Parent.NotificationController)
local StyleController = require(script.Parent.StyleController)
local Avatar = require(UILib.Avatar)

local MenuController = {}
MenuController.Priority = 30

local menuFrame, slotFrame, nameFrame, creditsFrame
local slotMode = "Continue" -- "Continue" | "New"
local busy = false

local ERRORS = {
	BadName = "Names must be 2–20 characters.",
	NameFiltered = "That name isn't allowed. Please try another!",
	SlotInUse = "That slot already has a life in it.",
	RateLimited = "Slow down a moment, then try again.",
	NotLoaded = "Your data is still loading. Try again in a second.",
	EmptySlot = "That save slot is empty.",
	PerkLocked = "That Legacy perk isn't unlocked yet. Complete more lives to earn it.",
}
local function errorText(reason: any): string
	return ERRORS[reason] or "Something went wrong. Please try again."
end

-- ===== Helpers =====
local function lifeSummary(life): string
	if life.Completed then
		return "✅ Life complete · Age " .. life.Age
	end
	local stage = LifeStages.Get(life.Stage)
	local text = ("Age %d · %s"):format(life.Age, stage.DisplayName)
	if life.Career and life.Career.Id ~= "None" and Careers.Info[life.Career.Id] then
		text ..= " · " .. Careers.TitleAt(life.Career.Id, life.Career.Level)
	end
	return text
end

local function statLine(life): string
	local s = life.Stats
	return ("😊 %d   ❤️ %d   🧠 %d   💰 %s"):format(math.floor(s.Happiness + 0.5), math.floor(s.Health + 0.5), math.floor(s.Intelligence + 0.5), Format.Money(life.Money))
end

local function firstEmptySlot(data): string?
	for _, slotId in ipairs(DataTemplate.SlotIds) do
		if data.Slots[slotId] == false then
			return slotId
		end
	end
	return nil
end

local function hasAnyLife(data): boolean
	for _, slotId in ipairs(DataTemplate.SlotIds) do
		if type(data.Slots[slotId]) == "table" then
			return true
		end
	end
	return false
end

function MenuController.ContinueSlot(slotId: string)
	if busy then
		return
	end
	busy = true
	local ok, reason = Net.Invoke("ContinueLife", slotId)
	busy = false
	if ok then
		UIController.Show("Game")
	else
		NotificationController.Notify({ Title = "Couldn't continue", Text = errorText(reason), Kind = "Error" })
	end
end

local function quickPlay()
	local data = DataController.Get()
	if not data then
		return
	end
	local life = DataController.GetActiveLife()
	if life and not life.Completed then
		MenuController.ContinueSlot(data.ActiveSlot)
		return
	end
	local empty = firstEmptySlot(data)
	if empty then
		UIController.Show("NameEntry", empty, false)
	else
		UIController.Show("SlotSelect", "New")
	end
end

MenuController.QuickPlay = quickPlay

-- ===== Main menu =====
local MENU_ITEMS = {
	{ Text = "Play With Friends", Icon = "👥", Screen = "Friends" },
	{ Text = "Continue Life", Icon = "⏯️", Action = function()
		UIController.Show("SlotSelect", "Continue")
	end, NeedsLife = true },
	{ Text = "New Life", Icon = "✨", Action = function()
		UIController.Show("SlotSelect", "New")
	end },
	{ Text = "Explore Lifeville", Icon = "🌆", Screen = "Explore" },
	{ Id = "Daily", Text = "Daily Reward", Icon = "🎁", Action = function()
		require(script.Parent.DailyController).Open()
	end, TextFn = function()
		return if require(script.Parent.DailyController).IsClaimable() then "Daily Reward ✨" else "Daily Reward"
	end },
	{ Text = "Shop", Icon = "🛍️", Screen = "Shop" },
	{ Text = "My Items", Icon = "🎒", Screen = "Inventory" },
	{ Text = "Achievements", Icon = "🏆", Screen = "Achievements" },
	{ Text = "Leaderboards", Icon = "📈", Screen = "Leaderboards" },
	{ Text = "Life History", Icon = "📜", Screen = "LifeHistory" },
	{ Id = "Profile", Text = "Profile", Icon = "👤", Action = function()
		require(script.Parent.ProfileController).Open()
	end },
	{ Id = "Notifications", Text = "Notifications", Icon = "🔔", Action = function()
		NotificationController.OpenInbox()
	end, TextFn = function()
		local unread = NotificationController.Unread()
		return if unread > 0 then ("Notifications (%d)"):format(unread) else "Notifications"
	end },
	{ Text = "Settings", Icon = "⚙️", Screen = "Settings" },
	{ Text = "Help", Icon = "❓", Screen = "Help" },
	{ Text = "Credits", Icon = "🎬", Screen = "Credits" },
}

local playButton
local function buildLifeCard(parent, width: number, life, layoutOrder: number)
	local card = Components.Panel({
		Name = "LifeCard",
		Size = UDim2.fromOffset(width, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Padding = 20,
		LayoutOrder = layoutOrder,
		Parent = parent,
	})
	Create.List(Enum.FillDirection.Vertical, 10).Parent = card
	Create.Label({
		Text = if life then "CURRENT LIFE" else "WELCOME",
		TextSize = Theme.TextSize.Tiny,
		FontFace = Theme.Font.Heavy,
		TextColor3 = Theme.Color.Primary,
		Size = UDim2.new(1, 0, 0, 18),
		LayoutOrder = 1,
		Parent = card,
	})
	if not life then
		Create.Label({
			Text = "Your story hasn't started yet.",
			FontFace = Theme.Font.Heavy,
			TextSize = Theme.TextSize.H2,
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 2,
			Parent = card,
		})
		Create.Label({
			Text = "Start as a five-year-old, make choices that shape who you become, and discover how your life turns out.",
			TextColor3 = Theme.Color.TextDim,
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 3,
			Parent = card,
		})
		return card
	end
	local style = StyleController.Get()
	local nameRow = Create("Frame", { Name = "NameRow", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 64), LayoutOrder = 2, Parent = card })
	Avatar.Badge({ Style = style, Size = 60, Parent = nameRow })
	Create.Label({
		Name = "LifeName",
		Text = Avatar.NameRich(life.Name, style),
		RichText = true,
		FontFace = Theme.Font.Heavy,
		TextSize = Theme.TextSize.H1,
		Position = UDim2.fromOffset(74, 0),
		Size = UDim2.new(1, -74, 0, 40),
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
		Parent = nameRow,
	})
	if style.Title then
		Create.Label({ Text = style.Title, TextColor3 = Theme.Color.Gold, TextSize = Theme.TextSize.Small, Position = UDim2.fromOffset(74, 40), Size = UDim2.new(1, -74, 0, 22), Parent = nameRow })
	end
	Create.Label({ Text = lifeSummary(life), TextColor3 = Theme.Color.TextDim, LayoutOrder = 3, Parent = card })
	local stage = LifeStages.Get(life.Stage)
	local progress = Components.StatBar({
		Name = "StageProgress",
		Icon = "🧭",
		DisplayName = stage.DisplayName .. " progress",
		Color = stage.Color,
		Value = if life.Completed then 100 else life.ScenarioIndex / stage.ScenariosPerStage * 100,
		LayoutOrder = 4,
		Parent = card,
	})
	progress.Instance:FindFirstChild("Value").Visible = false
	local grid = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 5, Parent = card })
	Create("UIGridLayout", { CellSize = UDim2.new(0.5, -6, 0, 40), CellPadding = UDim2.fromOffset(12, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	for i, statName in ipairs({ "Happiness", "Health", "Intelligence", "Popularity" }) do
		local info = StatDefinitions.Info[statName]
		Components.StatBar({ Name = statName, Icon = info.Icon, DisplayName = info.DisplayName, Color = info.Color, Value = life.Stats[statName], Compact = true, LayoutOrder = i, Parent = grid })
	end
	Create.Label({ Text = "💰  " .. Format.Money(life.Money), FontFace = Theme.Font.Bold, LayoutOrder = 6, Parent = card })
	return card
end

local function renderMenu()
	Create.Clear(menuFrame, true)
	local data = DataController.Get()
	local life = DataController.GetActiveLife()
	local size = UIController.GetVirtualSize()
	local narrow = UIController.IsNarrow()

	local scroll = Layout.Scroll(menuFrame, { Size = UDim2.fromScale(1, 1), Position = UDim2.new() })
	local list = scroll:FindFirstChildOfClass("UIListLayout")
	local columnWidth = math.min(if narrow then 460 else 420, size.X - 40)

	local container
	if narrow then
		container = scroll
	else
		list.VerticalAlignment = Enum.VerticalAlignment.Center
		container = Create("Frame", {
			Name = "Split",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Parent = scroll,
		})
		Create.List(Enum.FillDirection.Horizontal, 60, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center).Parent = container
	end

	local left = Layout.Column(container, columnWidth, { LayoutOrder = 1 })
	local title = Create.Label({
		Name = "Title",
		Text = Config.GameName,
		FontFace = Theme.Font.Heavy,
		TextSize = if narrow then 48 else Theme.TextSize.Hero,
		TextXAlignment = if narrow then Enum.TextXAlignment.Center else Enum.TextXAlignment.Left,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		Parent = left,
	})
	Create.Gradient(Theme.Gradient.Title).Parent = title
	Create.Label({
		Text = "Every choice shapes your future.",
		TextColor3 = Theme.Color.TextDim,
		TextXAlignment = title.TextXAlignment,
		LayoutOrder = 2,
		Parent = left,
	})

	if narrow then
		buildLifeCard(left, columnWidth, life, 3)
	end

	local playText = if life and not life.Completed then "Play as " .. life.Name else "Play"
	playButton = Components.Button({
		Name = "Play",
		Text = playText,
		Icon = "▶",
		Style = "Primary",
		Size = UDim2.new(1, 0, 0, 66),
		TextSize = 26,
		LayoutOrder = 4,
		Parent = left,
		OnClick = quickPlay,
	})

	local grid = Create("Frame", { Name = "Buttons", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 5, Parent = left })
	Create("UIGridLayout", { CellSize = UDim2.new(0.5, -6, 0, 54), CellPadding = UDim2.fromOffset(12, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	local order = 0
	for _, item in ipairs(MENU_ITEMS) do
		if item.Screen and not UIController.HasScreen(item.Screen) then
			continue
		end
		order += 1
		local button = Components.Button({
			Name = "Menu_" .. (item.Id or item.Screen or item.Text:gsub("%s", "")),
			Text = if item.TextFn then item.TextFn(data) else item.Text,
			Icon = item.Icon,
			Style = "Secondary",
			TextSize = 19,
			LayoutOrder = order,
			Parent = grid,
			OnClick = item.Action or function()
				UIController.Show(item.Screen)
			end,
		})
		if item.NeedsLife and not hasAnyLife(data) then
			Components.SetDisabled(button, true)
		end
	end

	if not narrow then
		buildLifeCard(container, math.min(440, size.X - columnWidth - 140), life, 2)
	end

	Create.Label({
		Name = "Coins",
		Text = ("🪙 %d coins · %d %s lived"):format(data.Coins, #data.LifeHistory, if #data.LifeHistory == 1 then "life" else "lives"),
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Color.Gold,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 98,
		Parent = scroll,
	})
	Create.Label({
		Name = "Version",
		Text = "v" .. Config.Version,
		TextSize = Theme.TextSize.Tiny,
		TextColor3 = Theme.Color.TextFaint,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 99,
		Parent = scroll,
	})
	Anim.Pop(left, 0.96)
end

-- ===== Save slots =====
local function slotCard(parent, slotId: string, index: number, life, width: number, height: number)
	local card = Components.Panel({
		Name = slotId,
		Size = UDim2.fromOffset(width, height),
		Padding = 18,
		LayoutOrder = index,
		Parent = parent,
	})
	local info = Create("Frame", { Name = "Info", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -64), Parent = card })
	Create.List(Enum.FillDirection.Vertical, 8).Parent = info
	Create.Label({ Text = "SLOT " .. index, TextSize = Theme.TextSize.Tiny, FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Primary, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 1, Parent = info })

	-- Action buttons pinned to the bottom of the card.
	local actions = Create("Frame", {
		Name = "Actions",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, 54),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Parent = card,
	})
	Create.List(Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left).Parent = actions
	local firstButton

	if life then
		Create.Label({ Text = life.Name, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H2, Size = UDim2.new(1, 0, 0, 36), TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, LayoutOrder = 2, Parent = info })
		Create.Label({ Text = lifeSummary(life), TextColor3 = Theme.Color.TextDim, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 3, Parent = info })
		Create.Label({ Text = statLine(life), TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, Parent = info })

		if slotMode == "Continue" then
			firstButton = Components.Button({
				Name = if life.Completed then "ViewReveal" else "Continue",
				Text = if life.Completed then "View Final Reveal" else "Continue",
				Icon = if life.Completed then "🔮" else "▶",
				Style = if life.Completed then "Accent" else "Primary",
				Size = UDim2.new(1, -64, 1, 0),
				LayoutOrder = 1,
				Parent = actions,
				OnClick = function()
					if life.Completed then
						local LifeHistoryController = require(script.Parent.LifeHistoryController)
						local entry = life.HistoryId and LifeHistoryController.Find(life.HistoryId)
						if entry then
							LifeHistoryController.Replay(entry)
						else
							UIController.Show("LifeHistory")
						end
					else
						MenuController.ContinueSlot(slotId)
					end
				end,
			})
		else
			firstButton = Components.Button({
				Text = "Replace",
				Icon = "✨",
				Style = "Accent",
				Size = UDim2.new(1, -64, 1, 0),
				LayoutOrder = 1,
				Parent = actions,
				OnClick = function()
					local confirmed = UIController.Confirm({
						Title = "Replace " .. life.Name .. "?",
						Text = "Starting a new life here will permanently erase " .. life.Name .. "'s life (" .. lifeSummary(life) .. ").",
						ConfirmText = "Replace",
						Danger = true,
					})
					if confirmed then
						UIController.Show("NameEntry", slotId, true)
					end
				end,
			})
		end
		Components.Button({
			Name = "Delete",
			Text = "🗑",
			Style = "Ghost",
			Size = UDim2.fromOffset(54, 54),
			LayoutOrder = 2,
			Parent = actions,
			OnClick = function()
				local confirmed = UIController.Confirm({
					Title = "Delete " .. life.Name .. "?",
					Text = "This life will be gone forever. This can't be undone.",
					ConfirmText = "Delete",
					Danger = true,
				})
				if confirmed then
					local ok, reason = Net.Invoke("DeleteLife", slotId)
					if not ok then
						NotificationController.Notify({ Title = "Couldn't delete", Text = errorText(reason), Kind = "Error" })
					end
				end
			end,
		})
	else
		Create.Label({ Text = "Empty Slot", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H2, TextColor3 = Theme.Color.TextDim, Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 2, Parent = info })
		Create.Label({ Text = "A blank page. Who will you be?", TextColor3 = Theme.Color.TextFaint, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = info })
		firstButton = Components.Button({
			Text = "Start New Life",
			Icon = "✨",
			Style = "Primary",
			Size = UDim2.new(1, 0, 1, 0),
			LayoutOrder = 1,
			Parent = actions,
			OnClick = function()
				UIController.Show("NameEntry", slotId, false)
			end,
		})
	end
	return card, firstButton
end

local function renderSlots()
	Create.Clear(slotFrame, true)
	local data = DataController.Get()
	if not data then
		return
	end
	Layout.Header(slotFrame, if slotMode == "Continue" then "Continue a Life" else "Start a New Life", function()
		UIController.Back()
	end)
	local narrow = UIController.IsNarrow()
	local size = UIController.GetVirtualSize()
	local scroll = Layout.Scroll(slotFrame)
	local row = scroll
	local width, height
	if narrow then
		width, height = math.min(520, size.X - 32), 230
	else
		width, height = math.min(340, math.floor((size.X - 120) / 3)), 300
		row = Create("Frame", { Name = "Row", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, height), Parent = scroll })
		Create.List(Enum.FillDirection.Horizontal, 20, Enum.HorizontalAlignment.Center).Parent = row
		scroll:FindFirstChildOfClass("UIListLayout").VerticalAlignment = Enum.VerticalAlignment.Center
	end
	local focus
	for index, slotId in ipairs(DataTemplate.SlotIds) do
		local life = data.Slots[slotId]
		local card, button = slotCard(row, slotId, index, if type(life) == "table" then life else nil, width, height)
		focus = focus or button
		Anim.Pop(card, 0.92, 0.3 + index * 0.05)
	end
	UIController.Focus(focus)
end

-- ===== Name entry =====
local pendingSlot, pendingOverwrite = "Slot1", false

local function renderNameEntry()
	Create.Clear(nameFrame, true)
	Layout.Header(nameFrame, "", function()
		UIController.Back()
	end)
	local size = UIController.GetVirtualSize()
	local width = math.min(580, size.X - 32)
	local panel = Components.Panel({
		Name = "NamePanel",
		Size = UDim2.fromOffset(width, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 20),
		Padding = 26,
		Parent = nameFrame,
	})
	Create.List(Enum.FillDirection.Vertical, 14, Enum.HorizontalAlignment.Center).Parent = panel
	Create.Label({ Text = "👶", TextSize = 54, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 60), LayoutOrder = 1, Parent = panel })
	Create.Label({ Text = "Who will you become?", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = panel })
	Create.Label({ Text = "Choose a name for your new life. You'll start at age 5.", TextColor3 = Theme.Color.TextDim, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = panel })

	local box = Create("TextBox", {
		Name = "NameBox",
		Text = NamePool[math.random(1, #NamePool)],
		PlaceholderText = "Type a name…",
		PlaceholderColor3 = Theme.Color.TextFaint,
		ClearTextOnFocus = false,
		FontFace = Theme.Font.Bold,
		TextSize = 28,
		TextColor3 = Theme.Color.Text,
		BackgroundColor3 = Theme.Color.Background,
		Size = UDim2.new(1, 0, 0, 64),
		LayoutOrder = 4,
		Parent = panel,
	}, { Create.Corner(Theme.RadiusSmall), Create.Stroke(Theme.Color.Stroke, 2, 0.2) })
	local counter = Create.Label({ Text = "", TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextFaint, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 5, Parent = panel })
	local errorLabel = Create.Label({ Text = "", TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.Negative, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 7, Parent = panel })

	local function refreshCounter()
		-- Keep to 20 characters as the player types.
		local length = utf8.len(box.Text) or #box.Text
		if length > 20 then
			box.Text = box.Text:sub(1, utf8.offset(box.Text, 21) - 1)
			length = 20
		end
		counter.Text = length .. " / 20"
	end
	box:GetPropertyChangedSignal("Text"):Connect(refreshCounter)
	refreshCounter()

	-- 🌟 Rebirth: choose a Legacy perk unlocked by your completed lives.
	local perkChoice = nil
	local data = DataController.Get()
	local unlocked = Legacy.Unlocked(data and data.Lifetime.LivesCompleted or 0)
	if #unlocked > 0 then
		local options, labels = { "None" }, { "No perk" }
		for _, perk in ipairs(unlocked) do
			table.insert(options, perk.Id)
			table.insert(labels, perk.Icon .. " " .. perk.Name)
		end
		local about = nil
		Components.Selector({ Label = ("🌟 Legacy level %d"):format(Legacy.Level(data.Lifetime.LivesCompleted)), Options = options, Labels = labels, Value = "None", LayoutOrder = 6, Parent = panel, OnChanged = function(value)
			perkChoice = if value == "None" then nil else value
			about.Text = if perkChoice then "Reborn with " .. Legacy.ById[perkChoice].Description else "Start fresh, or be reborn with a perk from your past lives."
		end })
		about = Create.Label({ Name = "PerkInfo", Text = "Start fresh, or be reborn with a perk from your past lives.", TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.Gold, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 6, Parent = panel })
	end

	local row = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 58), LayoutOrder = 8, Parent = panel })
	Create.List(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center).Parent = row
	local half = math.floor((width - 52 - 12) / 2)
	Components.Button({
		Text = "Random",
		Icon = "🎲",
		Style = "Secondary",
		Size = UDim2.fromOffset(half, 58),
		LayoutOrder = 1,
		Parent = row,
		OnClick = function()
			box.Text = NamePool[math.random(1, #NamePool)]
			errorLabel.Text = ""
		end,
	})
	local startButton
	local function submit()
		if busy then
			return
		end
		busy = true
		Components.SetDisabled(startButton, true)
		errorLabel.Text = ""
		local ok, result = Net.Invoke("StartNewLife", pendingSlot, box.Text, pendingOverwrite, perkChoice)
		busy = false
		Components.SetDisabled(startButton, false)
		if ok then
			UIController.Show("Game")
		else
			errorLabel.Text = errorText(result)
			Anim.Shake(panel)
		end
	end
	startButton = Components.Button({
		Text = "Start Life",
		Icon = "▶",
		Style = "Primary",
		Size = UDim2.fromOffset(half, 58),
		LayoutOrder = 2,
		Parent = row,
		OnClick = submit,
	})
	box.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			submit()
		end
	end)
	Anim.Pop(panel, 0.92)
	UIController.Focus(startButton)
end

-- ===== Credits =====
local function renderCredits()
	Create.Clear(creditsFrame, true)
	Layout.Header(creditsFrame, "Credits", function()
		UIController.Back()
	end)
	local scroll = Layout.Scroll(creditsFrame)
	local width = math.min(640, UIController.GetVirtualSize().X - 32)
	local column = Layout.Column(scroll, width)
	Create.Label({ Text = Config.GameName, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 0, Parent = column })
	for i, section in ipairs(Config.Credits) do
		local panel = Components.Panel({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Padding = 18, LayoutOrder = i, Parent = column })
		Create.List(Enum.FillDirection.Vertical, 6).Parent = panel
		Create.Label({ Text = section.Heading, FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Primary, TextSize = Theme.TextSize.Small, LayoutOrder = 0, Parent = panel })
		for j, line in ipairs(section.Lines) do
			Create.Label({ Text = line, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = j, Parent = panel })
		end
	end
	Create.Label({ Text = "Version " .. Config.Version, TextColor3 = Theme.Color.TextFaint, TextSize = Theme.TextSize.Small, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 100, Parent = column })
end

-- ===== Lifecycle =====
function MenuController.Init()
	menuFrame = UIController.NewScreen("Menu", {
		OnOpen = renderMenu,
		DefaultFocus = function()
			return playButton
		end,
	})
	slotFrame = UIController.NewScreen("SlotSelect", {
		Back = true, -- the menu, or Lifeville if you came from the Hall of Lives
		OnOpen = function(mode)
			slotMode = mode or slotMode
			renderSlots()
		end,
	})
	nameFrame = UIController.NewScreen("NameEntry", {
		Back = true,
		OnOpen = function(slotId, overwrite)
			pendingSlot = slotId or pendingSlot
			pendingOverwrite = overwrite == true
			renderNameEntry()
		end,
	})
	creditsFrame = UIController.NewScreen("Credits", { Back = true, OnOpen = renderCredits })
end

function MenuController.Start()
	UIController.LayoutChanged:Connect(function()
		local screen = UIController.Current()
		if screen == "Menu" then
			renderMenu()
		elseif screen == "SlotSelect" then
			renderSlots()
		elseif screen == "Credits" then
			renderCredits()
		end
		-- NameEntry is not re-rendered on resize so typed text isn't lost.
	end)
	DataController.Changed:Connect(function()
		local screen = UIController.Current()
		if screen == "SlotSelect" then
			renderSlots()
		end
	end)
	StyleController.Changed:Connect(function()
		if UIController.Current() == "Menu" then
			renderMenu()
		end
	end)
	-- Keep the 🔔 count and 🎁 sparkle up to date without rebuilding the menu.
	local function refreshBadges()
		if UIController.Current() ~= "Menu" then
			return
		end
		for _, item in ipairs(MENU_ITEMS) do
			if item.TextFn and item.Id then
				local button = menuFrame:FindFirstChild("Menu_" .. item.Id, true)
				if button then
					Components.SetText(button, item.Icon .. "  " .. item.TextFn(DataController.Get()))
				end
			end
		end
	end
	NotificationController.Changed:Connect(refreshBadges)
	DataController.Changed:Connect(refreshBadges)
end

return MenuController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="132">
            <Properties>
              <string name="Name">NotificationController</string>
              <string name="Source"><![CDATA[--[[
	NotificationController  (StarterPlayerScripts.Client.Controllers.NotificationController)
	Toast notifications (top-right, or top-centre on narrow screens).
	  NotificationController.Notify({ Title, Text, Kind = "Info"|"Success"|"Warning"|"Error"|"Important", Duration })
	Server pushes arrive on the "Notify" remote. When the player turns
	Notifications off, only "Important" and "Error" toasts are shown.
	🔔 Inbox: every notification this visit is kept (latest 40, even ones
	not shown as toasts) and can be read again from the main menu;
	NotificationController.Unread() counts the new ones.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("Shared").Net)
local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Anim = require(UILib.Anim)

local UIController = require(script.Parent.UIController)
local SettingsController = require(script.Parent.SettingsController)
local AudioController = require(script.Parent.AudioController)

local Signal = require(ReplicatedStorage:WaitForChild("Shared").Util.Signal)

local NotificationController = {}
NotificationController.Priority = 20
NotificationController.Changed = Signal.new() -- inbox changed
NotificationController.MaxHistory = 40

local history: { { Title: string, Text: string, Kind: string, Time: number } } = {}
local unread = 0

local KINDS = {
	Info = { Icon = "ℹ️", Color = Theme.Color.Accent },
	Success = { Icon = "✅", Color = Theme.Color.Positive },
	Warning = { Icon = "⚠️", Color = Theme.Color.Warning },
	Error = { Icon = "⛔", Color = Theme.Color.Negative },
	Important = { Icon = "⭐", Color = Theme.Color.Gold },
}

local stack: Frame
local order = 0

local function layout()
	local narrow = UIController.IsNarrow()
	stack.AnchorPoint = if narrow then Vector2.new(0.5, 0) else Vector2.new(1, 0)
	stack.Position = if narrow then UDim2.new(0.5, 0, 0, 12) else UDim2.new(1, -16, 0, 84)
	stack.Size = UDim2.fromOffset(math.min(360, UIController.GetVirtualSize().X - 24), 0)
end

function NotificationController.History()
	return history
end

function NotificationController.Unread(): number
	return unread
end

function NotificationController.MarkRead()
	unread = 0
	NotificationController.Changed:Fire()
end

function NotificationController.Notify(options: { [string]: any })
	local kind = KINDS[options.Kind or "Info"] or KINDS.Info
	table.insert(history, 1, { Title = tostring(options.Title or ""), Text = tostring(options.Text or ""), Kind = options.Kind or "Info", Time = os.time() })
	if #history > NotificationController.MaxHistory then
		table.remove(history)
	end
	unread += 1
	NotificationController.Changed:Fire()
	local critical = options.Kind == "Important" or options.Kind == "Error"
	if not critical and not SettingsController.Get("Notifications") then
		return
	end
	order += 1
	local toast = Create("CanvasGroup", {
		Name = "Toast",
		BackgroundColor3 = Theme.Color.Surface,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order,
		Parent = stack,
	}, { Create.Corner(Theme.RadiusSmall), Create.Stroke(kind.Color, 2, 0.2), Create.Padding(12, 14) })
	Create.List(Enum.FillDirection.Vertical, 2).Parent = toast
	Create.Label({
		Text = kind.Icon .. "  " .. tostring(options.Title or ""),
		FontFace = Theme.Font.Bold,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		Parent = toast,
	})
	if options.Text and options.Text ~= "" then
		Create.Label({
			Text = tostring(options.Text),
			TextSize = Theme.TextSize.Small,
			TextColor3 = Theme.Color.TextDim,
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 2,
			Parent = toast,
		})
	end
	AudioController.Play("Notify")
	Anim.Fade(toast, true, 0.2)
	task.delay(options.Duration or 4, function()
		Anim.Fade(toast, false, 0.3)
		task.wait(0.35)
		toast:Destroy()
	end)
	-- Keep at most 4 on screen.
	local toasts = {}
	for _, child in ipairs(stack:GetChildren()) do
		if child:IsA("CanvasGroup") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 4 then
		toasts[1]:Destroy()
	end
end

local function ago(t: number): string
	local seconds = math.max(0, os.time() - t)
	if seconds < 60 then
		return "just now"
	elseif seconds < 3600 then
		return ("%d min ago"):format(math.floor(seconds / 60))
	end
	return ("%d h ago"):format(math.floor(seconds / 3600))
end

-- 🔔 The inbox panel (main menu → Notifications).
function NotificationController.OpenInbox()
	local handle = UIController.OpenPanel({ Name = "InboxModal", Title = "🔔  Notifications", Width = 640, Height = 620 })
	handle.Subtitle.Text = if #history == 0 then "Nothing yet" else ("%d this visit"):format(#history)
	for i, item in ipairs(history) do
		local kind = KINDS[item.Kind] or KINDS.Info
		local row = Create("Frame", { Name = "Item" .. i, BackgroundColor3 = Theme.Color.SurfaceHigh, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = i, Parent = handle.Scroll }, { Create.Corner(Theme.RadiusSmall), Create.Stroke(kind.Color, 1.5, if i <= unread then 0 else 0.6), Create.Padding(10, 14) })
		Create.List(Enum.FillDirection.Vertical, 2).Parent = row
		Create.Label({ Text = kind.Icon .. "  " .. item.Title, FontFace = Theme.Font.Bold, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = row })
		if item.Text ~= "" then
			Create.Label({ Text = item.Text, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = row })
		end
		Create.Label({ Text = ago(item.Time), TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextFaint, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = row })
	end
	if #history == 0 then
		Create.Label({ Text = "Achievements, challenges, daily rewards, invites and trades will show up here.", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = handle.Scroll })
	end
	NotificationController.MarkRead()
	return handle
end

function NotificationController.Init()
	stack = Create("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 40,
		Parent = UIController.GetOverlay(),
	})
	Create.List(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right).Parent = stack
	layout()
	UIController.LayoutChanged:Connect(layout)
end

function NotificationController.Start()
	Net.OnEvent("Notify", function(payload)
		if type(payload) == "table" then
			NotificationController.Notify(payload)
		end
	end)
end

return NotificationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="133">
            <Properties>
              <string name="Name">PartyController</string>
              <string name="Source"><![CDATA[--[[
	PartyController  (StarterPlayerScripts.Client.Controllers.PartyController)
	Client side of Life Circles and city events (server: PartyService,
	CityEventService).
	  • keeps the current circle state (PartyController.Get / .Changed)
	  • shows circle invites with Join / No thanks
	  • opens the group-decision vote panel, live tally and countdown, then
	    what the group chose and what it meant for YOUR life
	  • plays Group Life Reveals (RevealController.PlayGroup)
	  • shows city-event invitations with Join / Skip, and a summary
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local Format = require(Shared.Util.Format)
local StatDefinitions = require(Shared.Data.StatDefinitions)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Anim = require(UILib.Anim)
local Components = require(UILib.Components)

local UIController = require(script.Parent.UIController)
local NotificationController = require(script.Parent.NotificationController)
local AudioController = require(script.Parent.AudioController)
local RevealController = require(script.Parent.RevealController)

local PartyController = {}
PartyController.Priority = 49
PartyController.Changed = Signal.new() -- (state or false)

local state = false
local promptStack: Frame
local vote = nil -- { Payload, Handle, Votes, MyVote, Deadline }

local ERRORS = {
	NotHere = "That player isn't in this server any more.",
	PartyFull = "That circle is full (4 players max).",
	AlreadyInvited = "You've already invited them.",
	AlreadyMember = "They're already in your circle.",
	Expired = "That invite has expired.",
	NoInvite = "That invite is no longer valid.",
	Cooldown = "Give it a moment before the next one.",
	EventActive = "Your circle is already deciding something.",
	NotEveryoneReady = "Everyone in the circle needs a life in progress.",
	NoParty = "You're not in a circle.",
	NotLeader = "Only the circle leader can do that.",
	ChoiceLocked = "Not everyone in the circle can do that one.",
	NotEligible = "You can't join this one.",
	RateLimited = "Slow down a moment.",
}
function PartyController.ErrorText(reason: any): string
	return ERRORS[reason] or tostring(reason)
end

function PartyController.Get()
	return state
end

function PartyController.MyUserId(): number
	return Players.LocalPlayer.UserId
end

function PartyController.IsLeader(): boolean
	return state ~= false and state.LeaderUserId == PartyController.MyUserId()
end

local function setState(newState)
	state = newState or false
	PartyController.Changed:Fire(state)
end

-- ===== Small prompt cards (invites, city events) =====
local function promptCard(name: string, title: string, body: string, seconds: number, buttons)
	local card = Create("CanvasGroup", {
		Name = name,
		BackgroundColor3 = Theme.Color.Surface,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = promptStack,
	}, { Create.Corner(Theme.Radius), Create.Stroke(Theme.Color.Gold, 2, 0.1), Create.Padding(14, 16) })
	Create.List(Enum.FillDirection.Vertical, 8).Parent = card
	Create.Label({ Text = title, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H3, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = card })
	Create.Label({ Text = body, TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = card })
	local timer = Create.Label({ Name = "Timer", Text = "", TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextFaint, LayoutOrder = 3, Parent = card })
	local row = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 4, Parent = card })
	Create.List(Enum.FillDirection.Horizontal, 10).Parent = row
	local done = false
	local function close()
		if done then
			return
		end
		done = true
		Anim.Fade(card, false, 0.2)
		task.delay(0.3, function()
			card:Destroy()
		end)
	end
	for i, b in ipairs(buttons) do
		Components.Button({ Name = b.Name, Text = b.Text, Style = b.Style or (if i == 1 then "Primary" else "Secondary"), Size = UDim2.fromOffset(b.Width or 170, 46), TextSize = 18, LayoutOrder = i, Parent = row, OnClick = function()
			if done then
				return
			end
			close()
			if b.OnClick then
				task.spawn(b.OnClick)
			end
		end })
	end
	Anim.Fade(card, true, 0.2)
	AudioController.Play("Notify")
	task.spawn(function()
		local deadline = os.clock() + seconds
		while not done and os.clock() < deadline do
			timer.Text = ("%ds left"):format(math.ceil(deadline - os.clock()))
			task.wait(0.5)
		end
		close()
	end)
	return card
end

PartyController.PromptCard = promptCard -- also used for trade requests

local function onInvite(invite)
	promptCard("Invite" .. invite.InviteId, "🤝 " .. invite.FromName .. " invited you", "Join their Life Circle to make group decisions, compare futures and watch Group Life Reveals together. Your own life stays yours.", invite.Seconds or 45, {
		{ Name = "AcceptInvite", Text = "Join", OnClick = function()
			local ok, result = Net.Invoke("PartyRespond", invite.InviteId, true)
			if ok then
				NotificationController.Notify({ Title = "🤝 Life Circle", Text = "You joined " .. invite.FromName .. "'s circle!", Kind = "Success" })
			else
				NotificationController.Notify({ Title = "Couldn't join", Text = PartyController.ErrorText(result), Kind = "Warning" })
			end
		end },
		{ Name = "DeclineInvite", Text = "No thanks", OnClick = function()
			Net.Invoke("PartyRespond", invite.InviteId, false)
		end },
	})
end

-- ===== Group decisions =====
local function previewText(choice): string
	local parts = {}
	for _, p in ipairs(choice.Preview or {}) do
		local info = StatDefinitions.Info[p.Stat]
		if info then
			table.insert(parts, ("%s<font color=\"%s\">%s</font>"):format(info.Icon, if p.Dir > 0 then Theme.Hex.Positive else Theme.Hex.Negative, string.rep(if p.Dir > 0 then "▲" else "▼", p.Size)))
		end
	end
	if choice.Risky then
		table.insert(parts, "🎲<font color=\"" .. Theme.Hex.Gold .. "\">Risky</font>")
	end
	for _, tag in ipairs(choice.Tags or {}) do
		table.insert(parts, "<font color=\"" .. Theme.Hex.Gold .. "\">" .. tag .. "</font>")
	end
	return table.concat(parts, "   ")
end

local function nameFor(userId: string): string
	if state then
		for _, m in ipairs(state.Members) do
			if tostring(m.UserId) == userId then
				return m.DisplayName
			end
		end
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if tostring(p.UserId) == userId then
			return p.DisplayName or p.Name
		end
	end
	return "Someone"
end

local renderVote
function renderVote()
	if not vote or not vote.Handle or not vote.Handle.IsOpen() then
		return
	end
	local payload = vote.Payload
	local handle = vote.Handle
	handle.Clear()
	local scroll = handle.Scroll
	Create.Label({ Text = payload.Description, TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = scroll })
	Create.Label({ Text = "Everyone votes. The majority decides, and each of you lives with the result in your own life.", TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextFaint, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = scroll })
	local votersByChoice = {}
	for userId, choiceId in pairs(vote.Votes) do
		votersByChoice[choiceId] = votersByChoice[choiceId] or {}
		table.insert(votersByChoice[choiceId], nameFor(userId))
	end
	for i, choice in ipairs(payload.Choices) do
		local mine = vote.MyVote == choice.Id
		local card = Create("TextButton", {
			Name = "Vote" .. choice.Id,
			Text = "",
			AutoButtonColor = false,
			Selectable = not choice.Locked,
			BackgroundColor3 = if mine then Theme.Color.SurfaceHigher else Theme.Color.SurfaceHigh,
			BackgroundTransparency = if choice.Locked then 0.5 else 0.05,
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = 10 + i,
			Parent = scroll,
		}, { Create.Corner(Theme.RadiusSmall), Create.Stroke(if mine then Theme.Color.Primary else Theme.Color.Stroke, if mine then 3 else 1.5, if mine then 0 else 0.4), Create.Padding(12, 14) })
		Create.List(Enum.FillDirection.Vertical, 4).Parent = card
		Create.Label({ Text = (if choice.Locked then "🔒 " elseif mine then "✅ " else "") .. choice.Text, FontFace = Theme.Font.Heavy, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = card })
		Create.Label({ Text = if choice.Locked then (choice.LockHint or "Locked") else choice.Description, TextSize = Theme.TextSize.Small, TextColor3 = if choice.Locked then Theme.Color.Warning else Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = card })
		if not choice.Locked then
			Create.Label({ Text = previewText(choice), RichText = true, TextSize = Theme.TextSize.Small, FontFace = Theme.Font.Bold, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = card })
		end
		local voters = votersByChoice[choice.Id]
		if voters then
			Create.Label({ Name = "Voters", Text = ("🗳️ %d: %s"):format(#voters, table.concat(voters, ", ")), TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.Gold, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, Parent = card })
		end
		card.Activated:Connect(function()
			if choice.Locked then
				NotificationController.Notify({ Title = "Locked", Text = choice.LockHint or "Not everyone can do this.", Kind = "Warning", Duration = 2.5 })
				return
			end
			if Components.OnClickSound then
				Components.OnClickSound()
			end
			vote.MyVote = choice.Id
			renderVote()
			local ok, result = Net.Invoke("PartyVote", payload.EventId, choice.Id)
			if not ok then
				NotificationController.Notify({ Title = "Vote not counted", Text = PartyController.ErrorText(result), Kind = "Warning" })
			end
		end)
	end
end

local function onGroupEvent(payload)
	vote = { Payload = payload, Votes = {}, MyVote = nil, Deadline = os.clock() + (payload.Seconds or 40) }
	local handle = UIController.OpenPanel({ Name = "GroupEventModal", Title = payload.Icon .. "  Group Decision: " .. payload.Title, Width = 760 })
	vote.Handle = handle
	AudioController.Play("Notify")
	renderVote()
	local current = vote
	task.spawn(function()
		while vote == current and handle.IsOpen() and not current.Result do
			local left = math.max(0, math.ceil(current.Deadline - os.clock()))
			handle.Subtitle.Text = ("Vote now · %ds left · started by %s"):format(left, payload.StartedBy)
			task.wait(0.5)
		end
	end)
end

local function onGroupVote(update)
	if vote and vote.Payload.EventId == update.EventId then
		vote.Votes = update.Votes
		renderVote()
	end
end

local function changeLines(result)
	local parts = {}
	for _, text in ipairs(result.LifeChanges or {}) do
		table.insert(parts, text)
	end
	for stat, delta in pairs(result.Applied or {}) do
		local info = StatDefinitions.Info[stat]
		if info and math.abs(delta) >= 0.5 then
			table.insert(parts, info.Icon .. " " .. Format.Signed(delta))
		end
	end
	if result.MoneyDelta and result.MoneyDelta ~= 0 then
		table.insert(parts, "💰 " .. (if result.MoneyDelta > 0 then "+" else "") .. Format.Money(result.MoneyDelta))
	end
	return parts
end

local function onGroupResult(result)
	local handle = if vote and vote.Payload.EventId == result.EventId and vote.Handle.IsOpen() then vote.Handle else nil
	if vote and vote.Payload.EventId == result.EventId then
		vote.Result = result
	end
	if not handle then
		handle = UIController.OpenPanel({ Name = "GroupEventModal", Title = result.Icon .. "  Group Decision: " .. result.Title, Width = 760 })
	end
	handle.Clear()
	local scroll = handle.Scroll
	local chosenText = result.ChoiceText
	local count = result.Tally and result.Tally[result.ChoiceId] or 0
	handle.Subtitle.Text = if result.NoVotes then "Nobody voted, so fate decided" elseif result.Tie then "It was a tie, settled by chance" else ("Decided by %d vote%s"):format(count, if count == 1 then "" else "s")
	Create.Label({ Name = "Chosen", Text = "The group chose: " .. chosenText, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H2, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = scroll })
	if result.Lucky then
		Components.Chip({ Text = "🎲 Fate stepped in!", TextColor = Theme.Color.Gold, LayoutOrder = 2, Parent = scroll })
	end
	Create.Label({ Name = "Story", Text = result.Story, TextSize = Theme.TextSize.H3, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = scroll })
	local lines = changeLines(result)
	if #lines > 0 then
		Create.Label({ Text = "For your life:  " .. table.concat(lines, "   "), FontFace = Theme.Font.Bold, TextColor3 = Theme.Color.Gold, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, Parent = scroll })
	end
	Components.Button({ Name = "CloseGroupResult", Text = "Nice!", Icon = "👍", Style = "Primary", Size = UDim2.new(1, 0, 0, 52), LayoutOrder = 10, Parent = scroll, OnClick = function()
		UIController.ClosePanel()
	end })
	AudioController.Play("Positive")
end

-- ===== City events =====
local function onCityEvent(event)
	if not event.Eligible then
		promptCard("City" .. event.EventId, event.Icon .. " " .. event.Title, event.Description .. "\n(You can't join this one right now.)", event.Seconds or 45, {
			{ Name = "CityOk", Text = "OK", Style = "Secondary" },
		})
		return
	end
	promptCard("City" .. event.EventId, event.Icon .. " " .. event.Title, event.Description, event.Seconds or 45, {
		{ Name = "CityJoin", Text = event.JoinText, Width = 220, OnClick = function()
			local ok, result = Net.Invoke("CityEventRespond", event.EventId, true)
			if ok and result.Joined then
				local lines = changeLines(result)
				NotificationController.Notify({ Title = event.Icon .. " " .. event.Title, Text = result.Story .. (if #lines > 0 then "  " .. table.concat(lines, "  ") else ""), Kind = "Success", Duration = 6 })
			elseif not ok then
				NotificationController.Notify({ Title = "Couldn't join", Text = PartyController.ErrorText(result), Kind = "Warning" })
			end
		end },
		{ Name = "CitySkip", Text = event.SkipText, Width = 220, OnClick = function()
			Net.Invoke("CityEventRespond", event.EventId, false)
		end },
	})
end

local function onCitySummary(summary)
	if summary.Invited and summary.Invited > 1 then
		NotificationController.Notify({ Title = summary.Icon .. " " .. summary.Title, Text = ("%d of %d people in this server joined in."):format(summary.Joined, summary.Invited), Kind = "Info", Duration = 4 })
	end
end

-- ===== Lifecycle =====
function PartyController.Init()
	promptStack = Create("Frame", {
		Name = "Prompts",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.fromOffset(math.min(460, UIController.GetVirtualSize().X - 24), 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 45,
		Parent = UIController.GetOverlay(),
	})
	Create.List(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center).Parent = promptStack
	UIController.LayoutChanged:Connect(function()
		promptStack.Size = UDim2.fromOffset(math.min(460, UIController.GetVirtualSize().X - 24), 0)
	end)
end

function PartyController.Start()
	Net.OnEvent("PartyUpdate", setState)
	Net.OnEvent("PartyInviteReceived", onInvite)
	Net.OnEvent("GroupEvent", onGroupEvent)
	Net.OnEvent("GroupVote", onGroupVote)
	Net.OnEvent("GroupEventResult", onGroupResult)
	Net.OnEvent("GroupReveal", function(payload)
		task.spawn(RevealController.PlayGroup, payload)
	end)
	Net.OnEvent("CityEvent", onCityEvent)
	Net.OnEvent("CityEventSummary", onCitySummary)
	local ok, current = Net.Invoke("GetPartyState")
	if ok then
		setState(current)
	end
end

return PartyController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="134">
            <Properties>
              <string name="Name">PeopleController</string>
              <string name="Source"><![CDATA[--[[
	PeopleController  (StarterPlayerScripts.Client.Controllers.PeopleController)
	The 👥 People panel: everyone in your life with their bond, plus actions.
	You get People.ActionsPerTurn actions between decisions:
	  Spend time · Give a gift · Talk   (per person)
	  Meet new friends · Look for love  (age 18+, when single)
	The server validates and applies every action (LifeService → Lib/Actions).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local People = require(Shared.Util.People)
local Format = require(Shared.Util.Format)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Components = require(UILib.Components)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local HUDController = require(script.Parent.HUDController)
local NotificationController = require(script.Parent.NotificationController)
local DecisionController = require(script.Parent.DecisionController)

local PeopleController = {}
PeopleController.Priority = 42

local ROLE_ORDER = { "Partner", "Child", "Parent", "Sibling", "BestFriend", "Friend", "Ex" }
local ERRORS = {
	NoActionsLeft = "No actions left. Make your next decision to get more time.",
	NotEnoughMoney = "You can't afford a gift right now.",
	TooManyFriends = "You already have plenty of friends.",
	TooYoung = "You're too young for that.",
	AlreadyTaken = "You're already in a relationship.",
	RateLimited = "Slow down a moment.",
}

local handle = nil
local busy = false

function PeopleController.ActionsLeft(life): number
	if life.ActionTurn ~= #life.Decisions then
		return People.ActionsPerTurn
	end
	return math.max(0, People.ActionsPerTurn - life.ActionsUsed)
end

local function bondWord(bond: number): string
	if bond >= 85 then
		return "Inseparable"
	elseif bond >= 65 then
		return "Close"
	elseif bond >= 45 then
		return "Good"
	elseif bond >= 25 then
		return "Distant"
	end
	return "Strained"
end

local function bondColor(bond: number): Color3
	if bond >= 65 then
		return Theme.Color.Positive
	elseif bond >= 35 then
		return Theme.Color.Warning
	end
	return Theme.Color.Negative
end

local render

local function act(remote: string, ...)
	if busy then
		return
	end
	busy = true
	local ok, result = Net.Invoke(remote, ...)
	busy = false
	if ok then
		local lines = { result.Text }
		for _, change in ipairs(result.BondChanges or {}) do
			table.insert(lines, ("%s %s"):format(change.Name, Format.Signed(change.Delta)))
		end
		NotificationController.Notify({ Title = "👥 People", Text = table.concat(lines, "  ·  "), Kind = "Success", Duration = 3 })
		DecisionController.Refresh()
	else
		NotificationController.Notify({ Title = "Not now", Text = ERRORS[result] or tostring(result), Kind = "Warning", Duration = 3 })
	end
	task.wait(0.25) -- let the data snapshot arrive
	if handle and handle.IsOpen() then
		render()
	end
end

local function personRow(parent, life, person, order: number, narrow: boolean, canAct: boolean)
	local role = People.Roles[person.Role]
	local height = if narrow then 128 else 76
	local row = Create("Frame", { Name = person.Id, BackgroundColor3 = Theme.Color.SurfaceHigh, BackgroundTransparency = 0.2, Size = UDim2.new(1, 0, 0, height), LayoutOrder = order, Parent = parent }, { Create.Corner(Theme.RadiusSmall), Create.Padding(10, 14) })
	local subtitle = role.Label
	local age = People.AgeOf(life, person)
	if age then
		subtitle ..= (" · age %d"):format(age)
	end
	if person.Married then
		subtitle = "Spouse"
	end
	subtitle ..= " · " .. bondWord(person.Bond)
	Create.Label({ Name = "Name", Text = role.Icon .. "  " .. person.Name, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.Body, Size = UDim2.new(0, 260, 0, 24), TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = row })
	Create.Label({ Name = "Sub", Text = subtitle, TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.Tiny, Size = UDim2.new(0, 260, 0, 18), Position = UDim2.fromOffset(0, 24), TextWrapped = false, Parent = row })
	local track = Create("Frame", { Name = "Bond", BackgroundColor3 = Theme.Color.Background, Size = UDim2.fromOffset(240, 8), Position = UDim2.fromOffset(0, 46), Parent = row }, { Create.Corner(Theme.RadiusPill) })
	Create("Frame", { Name = "Fill", BackgroundColor3 = bondColor(person.Bond), Size = UDim2.fromScale(person.Bond / 100, 1), Parent = track }, { Create.Corner(Theme.RadiusPill) })

	local buttons = Create("Frame", {
		Name = "Actions",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(if narrow then 0 else 330, 46),
		AutomaticSize = if narrow then Enum.AutomaticSize.X else Enum.AutomaticSize.None,
		AnchorPoint = if narrow then Vector2.new(0, 1) else Vector2.new(1, 0.5),
		Position = if narrow then UDim2.fromScale(0, 1) else UDim2.fromScale(1, 0.5),
		Parent = row,
	})
	Create.List(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center).Parent = buttons
	local options = if person.Role == "Ex" then { { "Talk", "💬 Talk" } } else { { "Time", "⏰ Time" }, { "Gift", "🎁 " .. Format.Money(People.GiftCost(life)) }, { "Talk", "💬 Talk" } }
	for i, option in ipairs(options) do
		local button = Components.Button({ Name = option[1], Text = option[2], Style = "Secondary", Size = UDim2.fromOffset(104, 44), TextSize = 17, LayoutOrder = i, Parent = buttons, OnClick = function()
			act("Interact", person.Id, option[1])
		end })
		if not canAct then
			Components.SetDisabled(button, true)
		end
	end
end

function render()
	local life = DataController.GetActiveLife()
	if not handle or not life then
		return
	end
	handle.Clear()
	local narrow = UIController.IsNarrow()
	local left = PeopleController.ActionsLeft(life)
	handle.Subtitle.Text = ("%d action%s left before your next decision"):format(left, if left == 1 then "" else "s")
	local scroll = handle.Scroll

	local top = Create("Frame", { Name = "Meet", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 50), LayoutOrder = 0, Parent = scroll })
	Create.List(Enum.FillDirection.Horizontal, 10).Parent = top
	local meet = Components.Button({ Name = "MeetFriends", Text = "Meet new friends", Icon = "🙂", Style = "Accent", Size = UDim2.fromOffset(if narrow then 200 else 240, 48), TextSize = 18, LayoutOrder = 1, Parent = top, OnClick = function()
		act("MeetPeople", "Friend")
	end })
	if left <= 0 then
		Components.SetDisabled(meet, true)
	end
	if life.Age >= 18 and not life.Relationships.Partner then
		local love = Components.Button({ Name = "LookForLove", Text = "Look for love", Icon = "💘", Style = "Primary", Size = UDim2.fromOffset(if narrow then 180 else 220, 48), TextSize = 18, LayoutOrder = 2, Parent = top, OnClick = function()
			act("MeetPeople", "Love")
		end })
		if left <= 0 then
			Components.SetDisabled(love, true)
		end
	end

	local order = 1
	for _, role in ipairs(ROLE_ORDER) do
		for _, person in ipairs(People.ByRole(life, role)) do
			order += 1
			personRow(scroll, life, person, order, narrow, left > 0)
		end
	end
	if #life.People == 0 then
		Create.Label({ Text = "Nobody yet. Go out and meet people!", TextColor3 = Theme.Color.TextDim, LayoutOrder = 2, Parent = scroll })
	end
	Create.Label({
		Text = "💡 Bonds fade over time unless you make time for people. Strong bonds make you happier; very weak ones can end relationships.",
		TextSize = Theme.TextSize.Tiny,
		TextColor3 = Theme.Color.TextFaint,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 999,
		Parent = scroll,
	})
end

function PeopleController.Open()
	local life = DataController.GetActiveLife()
	if not life then
		return
	end
	handle = UIController.OpenPanel({ Name = "PeopleModal", Title = "👥  People in " .. life.Name .. "'s Life", Width = 860, OnClose = function()
		handle = nil
	end })
	render()
end

function PeopleController.Init()
	HUDController.AddAction({ Id = "People", Icon = "👥", Order = 10, OnClick = PeopleController.Open })
end

function PeopleController.Start()
	DataController.Changed:Connect(function()
		if handle and handle.IsOpen() and not busy then
			render()
		end
	end)
end

return PeopleController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="135">
            <Properties>
              <string name="Name">ProfileController</string>
              <string name="Source"><![CDATA[--[[
	ProfileController  (StarterPlayerScripts.Client.Controllers.ProfileController)
	👤 Player profiles: your own (main menu → Profile) or anyone in this
	server (Friends screen, leaderboards). Shows their look and title,
	Legacy level, achievements and Memory Stars, and — if their privacy
	settings allow you — lifetime statistics, endings collected, their
	current life and recent lives. From someone else's profile you can
	offer a trade.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Format = require(Shared.Util.Format)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Components = require(UILib.Components)
local Avatar = require(UILib.Avatar)

local UIController = require(script.Parent.UIController)

local ProfileController = {}
ProfileController.Priority = 65

local STATS = {
	{ "LivesCompleted", "🏁", "Lives lived" },
	{ "DecisionsMade", "🧭", "Decisions made" },
	{ "HighestNetWorth", "💰", "Richest life", true },
	{ "CoinsEarned", "🪙", "Coins earned" },
	{ "BestStreak", "🔥", "Best login streak" },
	{ "CareersHeld", "💼", "Careers tried" },
	{ "WorldActions", "🌆", "Things done in town" },
	{ "ShiftsWorked", "⏰", "Extra shifts" },
	{ "DistrictsVisited", "🗺️", "Districts visited" },
	{ "ChallengesCompleted", "🎯", "Challenges done" },
	{ "TradesCompleted", "🔄", "Trades" },
}

local function tile(parent, order: number, icon: string, label: string, value: string, width: number)
	local t = Create("Frame", { Name = "Stat_" .. order, BackgroundColor3 = Theme.Color.SurfaceHigh, Size = UDim2.fromOffset(width, 64), LayoutOrder = order, Parent = parent }, { Create.Corner(Theme.RadiusSmall), Create.Padding(6, 10) })
	Create.Label({ Name = "Value", Text = icon .. " " .. value, FontFace = Theme.Font.Heavy, Size = UDim2.new(1, 0, 0, 28), TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = t })
	Create.Label({ Name = "Label", Text = label, TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.Tiny, Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 20), TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = t })
	return t
end

function ProfileController.Render(handle, profile)
	handle.Clear()
	handle.Subtitle.Text = if profile.IsYou then "Your profile" else "In this server"
	local scroll = handle.Scroll
	local head = Create("Frame", { Name = "Head", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 96), LayoutOrder = 1, Parent = scroll })
	Avatar.Badge({ Style = profile.Style, Size = 88, Parent = head })
	Create.Label({ Name = "NameLine", Text = Avatar.Line(profile.DisplayName, profile.Style), RichText = true, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H3, Position = UDim2.fromOffset(102, 4), Size = UDim2.new(1, -104, 0, 32), TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = head })
	Create.Label({ Name = "Legacy", Text = ("⭐ Legacy level %d · 🌟 %d rebirth%s"):format(profile.LegacyLevel, profile.Rebirths or 0, if profile.Rebirths == 1 then "" else "s"), TextColor3 = Theme.Color.Gold, Position = UDim2.fromOffset(102, 38), Size = UDim2.new(1, -104, 0, 24), Parent = head })
	Create.Label({ Name = "Counts", Text = ("🏆 %d / %d achievements · ✨ %d / %d Memory Stars"):format(profile.Achievements, profile.AchievementsTotal, profile.Stars, profile.StarsTotal), TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.Small, Position = UDim2.fromOffset(102, 64), Size = UDim2.new(1, -104, 0, 24), Parent = head })

	if profile.CurrentLife then
		Create.Label({ Name = "CurrentLife", Text = ("Living as %s · age %d · %s%s"):format(profile.CurrentLife.Name, profile.CurrentLife.Age, profile.CurrentLife.Stage, if profile.CurrentLife.Legacy then " · 🌟 reborn" else ""), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = scroll })
	end
	if profile.Stats then
		local grid = Create("Frame", { Name = "Stats", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = scroll })
		local list = Create.List(Enum.FillDirection.Horizontal, 8)
		list.Wraps = true
		list.Parent = grid
		local columns = if UIController.IsNarrow() then 2 else 3
		local width = math.floor((math.min(720, UIController.GetVirtualSize().X - 24) - 60 - 8 * (columns - 1)) / columns)
		for i, s in ipairs(STATS) do
			local value = profile.Stats[s[1]] or 0
			tile(grid, i, s[2], s[3], if s[4] then Format.Money(value) else Format.Commas(value), width)
		end
		tile(grid, #STATS + 1, "📚", "Endings collected", ("%d / %d"):format(profile.Stats.EndingsSeen, profile.Stats.EndingsTotal), width)
		if profile.EndingIcons and #profile.EndingIcons > 0 then
			Create.Label({ Name = "Endings", Text = "Endings: " .. table.concat(profile.EndingIcons, " "), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4, Parent = scroll })
		end
	elseif profile.Private then
		Create.Label({ Name = "Private", Text = ("🔒 %s keeps their life stats private."):format(profile.DisplayName), TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = scroll })
	end
	if profile.RecentLives and #profile.RecentLives > 0 then
		Create.Label({ Text = "RECENT LIVES", TextSize = Theme.TextSize.Tiny, FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Primary, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 5, Parent = scroll })
		for i, life in ipairs(profile.RecentLives) do
			Create.Label({ Name = "Life" .. i, Text = ("%s %s · %s, lived to %d · %s · %s"):format(life.EndingIcon, life.EndingTitle, life.Name, life.Age, life.Career, Format.Money(life.NetWorth or 0)), TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 5 + i, Parent = scroll })
		end
	end
	if not profile.IsYou then
		Components.Button({ Name = "OfferTrade", Text = "Offer a trade", Icon = "🔄", Style = "Accent", Size = UDim2.new(1, 0, 0, 52), LayoutOrder = 20, Parent = scroll, OnClick = function()
			UIController.ClosePanel()
			require(script.Parent.TradeController).Request(profile.UserId)
		end })
	end
end

function ProfileController.Open(userId: number?)
	local id = userId or Players.LocalPlayer.UserId
	local handle = UIController.OpenPanel({ Name = "ProfileModal", Title = "👤  Profile", Width = 760, Height = 660 })
	Create.Label({ Name = "Loading", Text = "Loading…", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = handle.Scroll })
	task.spawn(function()
		local ok, profile = Net.Invoke("GetProfile", id)
		if not handle.IsOpen() then
			return
		end
		if ok then
			ProfileController.Render(handle, profile)
		else
			handle.Clear()
			Create.Label({ Text = if profile == "NotHere" then "That player has left the server." else "Couldn't load this profile right now.", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = handle.Scroll })
		end
	end)
	return handle
end

function ProfileController.Init() end
function ProfileController.Start() end

return ProfileController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="136">
            <Properties>
              <string name="Name">RevealController</string>
              <string name="Source"><![CDATA[--[[
	RevealController  (StarterPlayerScripts.Client.Controllers.RevealController)
	The cinematic LIFE REVEAL sequences (data comes from the server: Lib/Reveal).

	RevealController.PlayStage(reveal)          -- yields until the player continues
	RevealController.PlayFinal(entry, options)  -- yields; returns "Again" | "History" | "Menu"

	Built entirely from UI (the 3D world arrives in Phase 8): title cards with
	light rays, counting probability bars with trend arrows, typewriter
	predictions, a TWIST sequence, and an animated preview scene for the
	predicted future (Luxury, Family, Fame, Career, Genius, Health, Hero,
	Content, Adventure, Difficult, Lonely) with a slow "camera" push-in.
	Tap to speed up a step; Skip jumps to the end card. Respects Reduce animations.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Futures = require(Shared.Util.Futures)
local Format = require(Shared.Util.Format)
local LifeStages = require(Shared.Data.LifeStages)
local World = require(Shared.Data.World)
local StatDefinitions = require(Shared.Data.StatDefinitions)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Anim = require(UILib.Anim)
local Components = require(UILib.Components)

local UIController = require(script.Parent.UIController)
local AudioController = require(script.Parent.AudioController)
local StyleController = require(script.Parent.StyleController)
local Avatar = require(UILib.Avatar)

local RevealController = {}
RevealController.Priority = 46

local gui: ScreenGui
local root: Frame
local uiScale: UIScale
local playing = false
local session = { Fast = false, Skip = false }

-- ===== Layout =====
-- Full-screen size in pixels. A disabled ScreenGui may not report its size
-- yet, so fall back to the camera's viewport.
local function screenSize(): Vector2
	local absolute = gui.AbsoluteSize
	if (not absolute or absolute.X < 2) and workspace and workspace.CurrentCamera then
		absolute = workspace.CurrentCamera.ViewportSize
	end
	return absolute
end

local function layout()
	local scale = UIController.GetScale()
	uiScale.Scale = scale
	local absolute = screenSize()
	root.Size = UDim2.fromOffset(math.floor(absolute.X / scale), math.floor(absolute.Y / scale))
end

local function size(): Vector2
	local absolute = screenSize()
	local scale = UIController.GetScale()
	return Vector2.new(absolute.X / scale, absolute.Y / scale)
end

-- ===== Sequencing =====
local function pause(seconds: number)
	if Anim.Reduced then
		seconds *= 0.5
	end
	local elapsed = 0
	while elapsed < seconds and not session.Fast and not session.Skip do
		elapsed += task.wait()
	end
end

local function newStep(): Frame
	session.Fast = false
	Create.Clear(root:FindFirstChild("Stage") :: Frame)
	return root:FindFirstChild("Stage") :: Frame
end

local function label(parent, props)
	local defaults = { TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), Parent = parent }
	for k, v in pairs(props) do
		defaults[k] = v
	end
	return Create.Label(defaults)
end

local function column(parent, width: number)
	local frame = Create("Frame", {
		Name = "Column",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(width, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Parent = parent,
	})
	Create.List(Enum.FillDirection.Vertical, 14, Enum.HorizontalAlignment.Center).Parent = frame
	return frame
end

local function typewrite(textLabel: TextLabel, cps: number?)
	if Anim.Reduced then
		return
	end
	local total = utf8.len(textLabel.Text) or #textLabel.Text
	textLabel.MaxVisibleGraphemes = 0
	local shown = 0
	while shown < total and not session.Fast and not session.Skip do
		shown += math.max(1, math.floor((cps or 45) / 30))
		textLabel.MaxVisibleGraphemes = shown
		task.wait(1 / 30)
	end
	textLabel.MaxVisibleGraphemes = -1
end

-- Rotating light rays behind a title.
local function lightRays(parent, color: Color3)
	local s = size()
	local d = math.max(s.X, s.Y) * 1.6
	local rays = Create("Frame", {
		Name = "Rays",
		BackgroundColor3 = color,
		BackgroundTransparency = 0,
		Size = UDim2.fromOffset(d, d),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = 0,
		Parent = parent,
	}, { Create.Corner(Theme.RadiusPill) })
	local keypoints = {}
	for i = 0, 12 do
		table.insert(keypoints, NumberSequenceKeypoint.new(i / 12, if i % 2 == 0 then 0.82 else 1))
	end
	local gradient = Create("UIGradient", { Transparency = NumberSequence.new(keypoints), Parent = rays })
	Anim.Loop(gradient, { Rotation = 90 }, 10)
	return rays
end

local function flash(color: Color3?)
	if Anim.Reduced then
		return
	end
	local f = Create("Frame", { Name = "Flash", BackgroundColor3 = color or Theme.Color.White, BackgroundTransparency = 0.1, Size = UDim2.fromScale(1, 1), ZIndex = 20, Parent = root })
	Anim.Tween(f, { BackgroundTransparency = 1 }, 0.6)
	task.delay(0.7, function()
		f:Destroy()
	end)
end

local function skipButton()
	local button = Components.Button({
		Name = "RevealSkip",
		Text = "Skip ▶▶",
		Style = "Ghost",
		Size = UDim2.fromOffset(130, 46),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 16),
		TextSize = 18,
		Parent = root,
		OnClick = function()
			session.Skip = true
		end,
	})
	button.ZIndex = 30
	return button
end

-- ===== Probability bars =====
local function futureBar(parent, entry, previous: number?, order: number, width: number)
	local info = Futures.Info[entry.Id]
	local row = Create("Frame", { Name = entry.Id, BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 46), LayoutOrder = order, Parent = parent })
	Create.Label({ Text = info.Icon .. "  " .. info.Title, FontFace = Theme.Font.Bold, TextSize = Theme.TextSize.Body, Size = UDim2.new(0.6, 0, 0, 24), TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
	local pctLabel = Create.Label({ Name = "Pct", Text = "0%", FontFace = Theme.Font.Heavy, TextSize = 24, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(0.4, 0, 0, 24), Position = UDim2.fromScale(0.6, 0), TextWrapped = false, Parent = row })
	local track = Create("Frame", { BackgroundColor3 = Theme.Color.Background, BackgroundTransparency = 0.2, Size = UDim2.new(1, 0, 0, 12), Position = UDim2.fromOffset(0, 30), Parent = row }, { Create.Corner(Theme.RadiusPill) })
	local color = if info.Positive then (if entry.Pct >= 60 then Theme.Color.Positive elseif entry.Pct >= 35 then Theme.Color.Warning else Theme.Color.Accent) else Theme.Color.Negative
	local fill = Create("Frame", { BackgroundColor3 = color, Size = UDim2.fromScale((previous or 0) / 100, 1), Parent = track }, { Create.Corner(Theme.RadiusPill) })
	local trend = ""
	if previous then
		local diff = entry.Pct - previous
		if math.abs(diff) >= 3 then
			trend = ("  <font color=\"%s\">%s%d</font>"):format(if (diff > 0) == info.Positive then Theme.Hex.Positive else Theme.Hex.Negative, if diff > 0 then "▲" else "▼", math.abs(diff))
		end
	end
	pctLabel.RichText = true
	return function(duration: number)
		Anim.Tween(fill, { Size = UDim2.fromScale(entry.Pct / 100, 1) }, duration)
		task.spawn(function()
			local start = previous or 0
			local steps = math.max(1, math.floor(duration * 30))
			for i = 1, steps do
				if session.Fast or session.Skip then
					break
				end
				pctLabel.Text = tostring(math.floor(start + (entry.Pct - start) * i / steps + 0.5)) .. "%"
				task.wait(duration / steps)
			end
			pctLabel.Text = entry.Pct .. "%" .. trend
		end)
	end
end

local function chosenFutures(predictions)
	local positives, risks = Futures.Sorted(predictions)
	local list = {}
	for i = 1, math.min(4, #positives) do
		table.insert(list, positives[i])
	end
	if risks[1] and risks[1].Pct >= 25 then
		table.insert(list, risks[1])
	end
	return list
end

local function barsStep(title: string, predictions, previous, subtitle: string?)
	local step = newStep()
	local width = math.min(640, size().X - 40)
	local col = column(step, width)
	label(col, { Text = title, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, LayoutOrder = 1 })
	if subtitle then
		label(col, { Text = subtitle, TextColor3 = Theme.Color.TextDim, LayoutOrder = 2 })
	end
	local starters = {}
	for i, entry in ipairs(chosenFutures(predictions)) do
		table.insert(starters, futureBar(col, entry, previous and previous[entry.Id], 10 + i, width))
	end
	for _, start in ipairs(starters) do
		start(0.7)
		AudioController.Play("Select")
		pause(0.35)
	end
	pause(1.4)
end

-- ===== Cinematic preview scenes =====
local SCENES = {
	Luxury = { Sky = { Color3.fromRGB(60, 30, 90), Color3.fromRGB(255, 190, 90) }, Hero = "🏰", Props = { "🏎️", "💎", "🛥️" }, Sparkle = "✨", Caption = "A mansion on the hill. Cars in the drive. A life of luxury." },
	Family = { Sky = { Color3.fromRGB(255, 160, 120), Color3.fromRGB(255, 220, 160) }, Hero = "🏡", Props = { "👨‍👩‍👧‍👦", "🐶", "🌳" }, Sparkle = "💛", Caption = "A house full of laughter, and the people you love most." },
	Fame = { Sky = { Color3.fromRGB(20, 10, 40), Color3.fromRGB(120, 40, 160) }, Hero = "🎤", Props = { "📸", "👏", "🌟" }, Sparkle = "🌟", Caption = "Bright lights. Screaming fans. Your name in lights." },
	Career = { Sky = { Color3.fromRGB(20, 40, 90), Color3.fromRGB(100, 160, 255) }, Hero = "🏙️", Props = { "💼", "📈", "🏆" }, Sparkle = "⭐", Caption = "The corner office. The top of your field." },
	Genius = { Sky = { Color3.fromRGB(10, 20, 60), Color3.fromRGB(60, 90, 200) }, Hero = "🔬", Props = { "💡", "📚", "🧠" }, Sparkle = "✦", Caption = "Discoveries, inventions, ideas that change the world." },
	Health = { Sky = { Color3.fromRGB(120, 200, 255), Color3.fromRGB(255, 230, 160) }, Hero = "🏃", Props = { "🌅", "🥗", "🚴" }, Sparkle = "☀️", Caption = "Strong, energetic and still running marathons at 80." },
	Hero = { Sky = { Color3.fromRGB(40, 30, 80), Color3.fromRGB(255, 200, 120) }, Hero = "🏅", Props = { "🤝", "🏛️", "🕊️" }, Sparkle = "✨", Caption = "Respected. Trusted. The person everyone turns to." },
	Content = { Sky = { Color3.fromRGB(255, 190, 220), Color3.fromRGB(190, 220, 255) }, Hero = "😊", Props = { "🌈", "🌻", "☕" }, Sparkle = "💫", Caption = "Not perfect, but genuinely, deeply happy." },
	Adventure = { Sky = { Color3.fromRGB(40, 120, 200), Color3.fromRGB(120, 220, 200) }, Hero = "🌍", Props = { "✈️", "⛰️", "🧭" }, Sparkle = "✦", Caption = "Mountains, oceans, a passport full of stamps." },
	Difficult = { Sky = { Color3.fromRGB(40, 45, 60), Color3.fromRGB(90, 95, 110) }, Hero = "🏚️", Props = { "🌧️", "🧾", "☂️" }, Sparkle = "💧", Caption = "Hard times could be ahead… but it's not too late to change course." },
	Lonely = { Sky = { Color3.fromRGB(20, 25, 50), Color3.fromRGB(60, 70, 110) }, Hero = "🪑", Props = { "🌙", "🕯️", "📞" }, Sparkle = "✦", Caption = "A quiet house… but people are waiting to know you." },
}

-- Your shop cosmetics star in your own future: equipped home, car and pet
-- replace the defaults in the scenes where they belong.
local function personalise(archetype: string, scene)
	local style = StyleController.Get()
	local result = table.clone(scene)
	result.Props = table.clone(scene.Props)
	if archetype == "Luxury" then
		result.Hero = style.House or scene.Hero
		result.Props[1] = style.Car or scene.Props[1]
		result.Props[3] = style.Pet or scene.Props[3]
	elseif archetype == "Family" then
		result.Hero = style.House or scene.Hero
		result.Props[2] = style.Pet or scene.Props[2]
	elseif archetype == "Career" then
		result.Props[1] = style.Car or scene.Props[1]
	elseif archetype == "Content" or archetype == "Health" then
		result.Props[2] = style.Pet or scene.Props[2]
	end
	return result
end

-- Falling glyphs from an equipped Reveal effect (shop cosmetic). They live in
-- their own layer above the steps, so they keep falling into the next step
-- (e.g. when the player skips straight to the end card).
local function effectRain(count: number)
	local glyphs = StyleController.Get().RevealGlyphs
	if not glyphs or Anim.Reduced then
		return
	end
	local layer = root:FindFirstChild("Fx") or Create("Frame", { Name = "Fx", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 3, Parent = root })
	local rng = Random.new()
	for i = 1, count do
		local g = Create.Label({ Name = "RevealFx" .. i, Text = glyphs[(i - 1) % #glyphs + 1], TextSize = rng:NextInteger(24, 40), TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(44, 44), Position = UDim2.new(rng:NextNumber(0, 0.97), 0, -0.1 - rng:NextNumber(0, 0.4), 0), Parent = layer })
		local duration = rng:NextNumber(2, 3.5)
		Anim.Tween(g, { Position = UDim2.new(g.Position.X.Scale, 0, 1.1, 0), Rotation = rng:NextInteger(-90, 90) }, duration, Enum.EasingStyle.Linear)
		task.delay(duration + 0.1, function()
			g:Destroy()
		end)
	end
end

local function sceneStep(archetype: string)
	local scene = personalise(archetype, SCENES[archetype] or SCENES.Content)
	local step = newStep()
	local s = size()
	local frame = Create("CanvasGroup", { Name = "Scene", BackgroundColor3 = Theme.Color.White, Size = UDim2.fromScale(1, 1), Parent = step }, {
		Create.Gradient(ColorSequence.new(scene.Sky[1], scene.Sky[2]), 90),
	})
	local camera = Anim.Scale(frame)
	camera.Scale = 1
	Anim.Tween(camera, { Scale = 1.12 }, 6, Enum.EasingStyle.Sine)
	local heroSize = math.min(s.X, s.Y) * 0.36
	local hero = Create.Label({ Text = scene.Hero, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(heroSize, heroSize), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.48), Parent = frame })
	Anim.Pop(hero, 0.5, 0.8)
	for i, prop in ipairs(scene.Props) do
		local x = ({ 0.2, 0.8, 0.35 })[i]
		local y = ({ 0.68, 0.66, 0.78 })[i]
		local p = Create.Label({ Text = prop, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(heroSize * 0.38, heroSize * 0.38), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x - (if i == 1 then 0.25 else 0), y), Parent = frame })
		Anim.Tween(p, { Position = UDim2.fromScale(x, y) }, 1.6 + i * 0.4, Enum.EasingStyle.Quad)
		Anim.Loop(p, { Rotation = 4 }, 1.2 + i * 0.3)
	end
	local rng = Random.new(#archetype)
	for i = 1, 10 do
		local sparkle = Create.Label({ Name = "Sparkle" .. i, Text = scene.Sparkle, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center, TextTransparency = 0.2, Size = UDim2.fromOffset(28, 28), Position = UDim2.fromScale(rng:NextNumber(0.05, 0.95), rng:NextNumber(0.05, 0.55)), Parent = frame })
		Anim.Loop(sparkle, { TextTransparency = 0.9 }, rng:NextNumber(0.6, 1.4))
	end
	if archetype == "Fame" then
		task.spawn(function()
			for _ = 1, 3 do
				pause(0.6)
				flash()
			end
		end)
	end
	local caption = Create.Label({
		Text = scene.Caption,
		FontFace = Theme.Font.Bold,
		TextSize = Theme.TextSize.H3,
		TextXAlignment = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -30),
		Size = UDim2.new(0.9, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Color.Black,
		BackgroundTransparency = 0.45,
		Parent = frame,
	})
	Create.Corner(Theme.RadiusSmall).Parent = caption
	Create.Padding(10, 16).Parent = caption
	label(step, { Text = "A GLIMPSE OF ONE POSSIBLE FUTURE…", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.White, Position = UDim2.fromOffset(0, 24), ZIndex = 5 })
	typewrite(caption, 40)
	pause(2.6)
end

-- ===== The real place in Lifeville (camera flyover) =====
local function worldStep(archetype: string)
	local Showcase = require(script.Parent.ShowcaseController)
	if Anim.Reduced or not Showcase.Available(archetype) then
		return
	end
	local step = newStep()
	local backdrop = root:FindFirstChild("Backdrop")
	if backdrop then
		backdrop.Visible = false
	end
	local shot = Showcase.Begin(archetype)
	local strip = Create("Frame", { Name = "WorldShowcase", BackgroundColor3 = Theme.Color.Black, BackgroundTransparency = 0.35, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 130), Parent = step })
	label(strip, { Name = "Place", Text = "📍 " .. shot.Place .. ", " .. World.TownName, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H2, Position = UDim2.fromOffset(0, 20) })
	label(strip, { Name = "Line", Text = "One day, this could be where your story leads.", TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.H3, Position = UDim2.fromOffset(0, 70) })
	Showcase.Glide(3.8)
	pause(3.8)
	Showcase.End()
	if backdrop then
		backdrop.Visible = true
	end
end
RevealController.WorldStep = worldStep

-- ===== End card =====
local function endCard(title: string, body: string, buttons)
	session.Skip = false
	local step = newStep()
	lightRays(step, Theme.Color.AccentAlt)
	local width = math.min(620, size().X - 40)
	local col = column(step, width)
	label(col, { Text = title, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, LayoutOrder = 1 })
	label(col, { Text = body, TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.H3, LayoutOrder = 2 })
	local row = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = col })
	local list = Create.List(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center)
	list.Wraps = true
	list.Parent = row
	local result = nil
	local first
	for i, b in ipairs(buttons) do
		local button = Components.Button({ Name = b.Name, Text = b.Text, Icon = b.Icon, Style = b.Style or "Primary", Size = UDim2.fromOffset(b.Width or 260, 58), LayoutOrder = i, Parent = row, OnClick = function()
			result = b.Result
		end })
		first = first or button
	end
	Anim.Pop(col, 0.9)
	UIController.Focus(first)
	while result == nil do
		task.wait()
	end
	return result
end

-- ===== Session control =====
local function begin()
	playing = true
	session.Fast = false
	session.Skip = false
	gui.Enabled = true
	Create.Clear(root) -- keeps the UIScale
	Create("Frame", { Name = "Backdrop", BackgroundColor3 = Theme.Color.White, Size = UDim2.fromScale(1, 1), Parent = root }, {
		Create.Gradient(ColorSequence.new(Color3.fromRGB(8, 6, 20), Color3.fromRGB(40, 16, 70)), 120),
	})
	local stage = Create("Frame", { Name = "Stage", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = root })
	-- Tap anywhere to speed up the current step.
	local tap = Create("TextButton", { Name = "Tap", Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Selectable = false, ZIndex = 1, Parent = root })
	tap.Activated:Connect(function()
		session.Fast = true
	end)
	stage.ZIndex = 2
	skipButton()
	layout()
end

local function finish()
	playing = false
	gui.Enabled = false
	Create.Clear(root)
	require(script.Parent.ShowcaseController).End() -- never leave the camera flying
end

function RevealController.IsPlaying(): boolean
	return playing
end

function RevealController.Skip()
	session.Skip = true
end

-- ===== Stage reveal =====
function RevealController.PlayStage(reveal)
	if playing then
		return
	end
	begin()
	AudioController.Play("StageComplete")

	-- 1. Title
	local step = newStep()
	lightRays(step, Theme.Color.Accent)
	local col = column(step, math.min(700, size().X - 40))
	local title = label(col, { Text = "🔮  LIFE REVEAL", FontFace = Theme.Font.Heavy, TextSize = 64, LayoutOrder = 1 })
	Create.Gradient(Theme.Gradient.Title).Parent = title
	label(col, { Text = ("%s is over. You are %d."):format(reveal.StageName, reveal.Age), TextSize = Theme.TextSize.H3, TextColor3 = Theme.Color.TextDim, LayoutOrder = 2 })
	Anim.Pop(title, 0.6, 0.9)
	effectRain(18)
	if reveal.Coins and reveal.Coins > 0 then
		label(col, { Name = "RevealCoins", Text = ("🪙 +%d coins%s"):format(reveal.Coins, if reveal.Boosted then "  (2× Coins)" else ""), FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Gold, LayoutOrder = 3 })
	end
	pause(1.8)

	-- 2. Who you became
	if not session.Skip and reveal.Became and #reveal.Became > 0 then
		local s2 = newStep()
		local c2 = column(s2, math.min(640, size().X - 40))
		label(c2, { Text = "Who you became", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, LayoutOrder = 1 })
		for i, line in ipairs(reveal.Became) do
			local chip = Components.Chip({ Text = line, Height = 44, TextSize = Theme.TextSize.Body, LayoutOrder = 1 + i, Parent = c2 })
			Anim.Pop(chip, 0.6, 0.35 + i * 0.08)
		end
		pause(1.8)
	end

	-- 3. Futures
	if not session.Skip then
		barsStep("Your possible futures", if reveal.Twist then reveal.Twist.Before else reveal.Predictions, reveal.Previous, "Based on everything you've done so far")
	end

	-- 4. Headline
	if not session.Skip then
		local s4 = newStep()
		lightRays(s4, Theme.Color.Primary)
		local c4 = column(s4, math.min(720, size().X - 40))
		local h = label(c4, { Text = if reveal.Twist then Futures.Headline(reveal.Twist.Before) else reveal.Headline, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, LayoutOrder = 1 })
		typewrite(h, 50)
		local warning = if reveal.Twist then select(2, Futures.Headline(reveal.Twist.Before)) else reveal.Warning
		if warning then
			label(c4, { Text = "⚠️ " .. warning, TextColor3 = Theme.Color.Warning, TextSize = Theme.TextSize.H3, LayoutOrder = 2 })
		end
		pause(2)
	end

	-- 5. Twist
	if not session.Skip and reveal.Twist then
		local twist = reveal.Twist
		flash()
		AudioController.Play("Negative")
		local s5 = newStep()
		local c5 = column(s5, math.min(680, size().X - 40))
		local but = label(c5, { Text = "⚡ BUT THEN…", FontFace = Theme.Font.Heavy, TextSize = 56, TextColor3 = Theme.Color.Gold, LayoutOrder = 1 })
		Anim.Shake(but)
		label(c5, { Text = twist.Icon, TextSize = 72, LayoutOrder = 2 })
		label(c5, { Text = twist.Title, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, LayoutOrder = 3 })
		local story = label(c5, { Text = twist.Story, TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.H3, LayoutOrder = 4 })
		typewrite(story, 45)
		local changes = {}
		for _, text in ipairs(twist.LifeChanges or {}) do
			table.insert(changes, text)
		end
		for stat, delta in pairs(twist.Applied or {}) do
			local info = StatDefinitions.Info[stat]
			if info and math.abs(delta) >= 0.5 then
				table.insert(changes, info.Icon .. " " .. Format.Signed(delta))
			end
		end
		if twist.MoneyDelta and twist.MoneyDelta ~= 0 then
			table.insert(changes, "💰 " .. (if twist.MoneyDelta > 0 then "+" else "") .. Format.Money(twist.MoneyDelta))
		end
		if #changes > 0 then
			label(c5, { Text = table.concat(changes, "   "), FontFace = Theme.Font.Bold, TextColor3 = Theme.Color.Gold, LayoutOrder = 5 })
		end
		pause(2.6)
		if not session.Skip then
			barsStep("The odds have changed", reveal.Predictions, twist.Before, "One moment can change everything")
		end
	end

	-- 6. Cinematic preview, then the real place in Lifeville
	if not session.Skip then
		sceneStep(reveal.Archetype)
	end
	if not session.Skip then
		worldStep(reveal.Archetype)
	end

	-- 7. End card
	endCard(
		if reveal.Twist then reveal.Headline else "The future is never decided.",
		"Every choice can still change it." .. (if reveal.NextStageName then ("\n%s begins now."):format(reveal.NextStageName) else ""),
		{ { Name = "RevealContinue", Text = if reveal.NextStageName then "Continue to " .. reveal.NextStageName else "Continue", Icon = "▶", Result = "Continue", Width = 340 } }
	)
	finish()
end

-- ===== Final reveal =====
local function section(parent, title: string, lines, order: number)
	if not lines or #lines == 0 then
		return
	end
	label(parent, { Text = title, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.Primary, LayoutOrder = order })
	for i, line in ipairs(lines) do
		local l = label(parent, { Text = line, TextSize = Theme.TextSize.Body, LayoutOrder = order + i })
		Anim.Pop(l, 0.8, 0.25 + i * 0.05)
	end
end

function RevealController.PlayFinal(entry, options)
	options = options or {}
	if playing then
		return "Menu"
	end
	begin()
	local width = math.min(720, size().X - 40)

	-- 1. Title
	local step = newStep()
	lightRays(step, Theme.Color.Gold)
	local col = column(step, width)
	label(col, { Text = "THE LIFE OF", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H3, TextColor3 = Theme.Color.TextDim, LayoutOrder = 1 })
	local name = label(col, { Text = string.upper(entry.Name), FontFace = Theme.Font.Heavy, TextSize = 72, LayoutOrder = 2 })
	Create.Gradient(Theme.Gradient.Title).Parent = name
	label(col, { Text = ("Age 5 → %d · %d decisions"):format(entry.Age, entry.DecisionCount or 0), TextColor3 = Theme.Color.TextDim, LayoutOrder = 3 })
	Anim.Pop(name, 0.6, 0.9)
	pause(2)

	-- 2. Key decisions montage
	if not session.Skip and #entry.KeyDecisions > 0 then
		local s2 = newStep()
		local c2 = column(s2, width)
		label(c2, { Text = "The choices that shaped you", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, LayoutOrder = 1 })
		for i, d in ipairs(entry.KeyDecisions) do
			if session.Skip then
				break
			end
			local stage = LifeStages.ForAge(d.Age)
			local card = Components.Panel({ Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, Padding = 12, LayoutOrder = 1 + i, Parent = c2, Color = Theme.Color.SurfaceHigh })
			Create.Label({ Text = ("<font color=\"%s\">AGE %d · %s</font>   %s"):format(Theme.Hex.Gold, d.Age, string.upper(stage.DisplayName), d.Title), RichText = true, TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.Y, Parent = card })
			Create.Label({ Text = "“" .. d.Choice .. "”", FontFace = Theme.Font.Bold, Position = UDim2.fromOffset(0, 24), AutomaticSize = Enum.AutomaticSize.Y, Parent = card })
			Anim.Pop(card, 0.7, 0.35)
			pause(0.8)
		end
		pause(1.2)
	end

	-- 3. Family & relationships
	if not session.Skip then
		local s3 = newStep()
		local c3 = column(s3, width)
		label(c3, { Text = "The people in your life", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, LayoutOrder = 1 })
		local lines = {}
		if entry.Partner then
			table.insert(lines, (if entry.Partner.Married then "💍 Married to " else "❤️ Together with ") .. entry.Partner.Name)
		else
			table.insert(lines, "🕊️ Single at the end")
		end
		if #entry.Children > 0 then
			table.insert(lines, "👶 Children: " .. table.concat(entry.Children, ", "))
		end
		if entry.BestFriend then
			table.insert(lines, "🫶 Best friend: " .. entry.BestFriend)
		end
		for i, line in ipairs(lines) do
			local l = label(c3, { Text = line, TextSize = Theme.TextSize.H3, LayoutOrder = 1 + i })
			Anim.Pop(l, 0.7, 0.3 + i * 0.1)
		end
		pause(2)
	end

	-- 4. Wealth & career
	if not session.Skip then
		local s4 = newStep()
		local c4 = column(s4, width)
		label(c4, { Text = "What you built", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, LayoutOrder = 1 })
		local worth = label(c4, { Text = "$0", FontFace = Theme.Font.Heavy, TextSize = 64, TextColor3 = Theme.Color.Gold, LayoutOrder = 2 })
		label(c4, { Text = "net worth", TextColor3 = Theme.Color.TextDim, LayoutOrder = 3 })
		label(c4, { Text = "💼 " .. entry.Career .. "   ·   🎓 " .. entry.Education, TextSize = Theme.TextSize.H3, LayoutOrder = 4 })
		local steps = 40
		for i = 1, steps do
			if session.Fast or session.Skip then
				break
			end
			worth.Text = Format.Money(entry.NetWorth * (i / steps) ^ 2)
			task.wait(1 / 30)
		end
		worth.Text = Format.Money(entry.NetWorth)
		pause(1.6)
	end

	-- 5. Achievements, moments, mistakes
	if not session.Skip then
		local s5 = newStep()
		local scroll = Create("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4, Selectable = false, Parent = s5 })
		Create.List(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center).Parent = scroll
		Create.Padding(80, 20, 40, 20).Parent = scroll
		local c5 = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, Parent = scroll })
		Create.List(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Center).Parent = c5
		section(c5, "🏆 ACHIEVEMENTS", entry.Achievements, 10)
		section(c5, "✨ GREATEST MOMENTS", entry.Moments, 40)
		section(c5, "💭 BIGGEST REGRETS", entry.Mistakes, 70)
		if #entry.Achievements + #entry.Moments + #entry.Mistakes == 0 then
			label(c5, { Text = "A simple life, lived your way.", TextSize = Theme.TextSize.H3, LayoutOrder = 1 })
		end
		pause(3.2)
	end

	-- 6. Predictions vs reality
	if not session.Skip and #entry.Journey > 0 then
		local s6 = newStep()
		local c6 = column(s6, width)
		label(c6, { Text = "What we predicted… and what came true", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H2, LayoutOrder = 1 })
		local came = {}
		for _, id in ipairs(entry.CameTrue) do
			came[id] = true
		end
		local first = entry.Journey[math.min(2, #entry.Journey)]
		for i, top in ipairs(first.Top) do
			local info = Futures.Info[top.Id]
			label(c6, {
				Text = ("At %d: %s %s %d%% → %s"):format(first.Age, info.Icon, info.Title, top.Pct, if came[top.Id] then "✅ it came true" else "❌ it didn't"),
				RichText = false,
				TextSize = Theme.TextSize.Body,
				LayoutOrder = 1 + i,
			})
		end
		local trueList = {}
		for _, id in ipairs(entry.CameTrue) do
			if Futures.Info[id].Positive then
				table.insert(trueList, Futures.Info[id].Icon .. " " .. Futures.Info[id].Title)
			end
		end
		label(c6, { Text = if #trueList > 0 then "Your life became: " .. table.concat(trueList, " · ") else "Your life took its own unpredictable path.", FontFace = Theme.Font.Bold, TextColor3 = Theme.Color.Gold, LayoutOrder = 10 })
		pause(3)
	end

	-- 7. Ending title
	if not session.Skip then
		local s7 = newStep()
		local c7 = column(s7, width)
		label(c7, { Text = "Your life will be remembered as…", TextSize = Theme.TextSize.H3, TextColor3 = Theme.Color.TextDim, LayoutOrder = 1 })
		pause(1.4)
	end
	local s8 = newStep()
	lightRays(s8, Theme.Color.Gold)
	flash(Theme.Color.Gold)
	AudioController.Play("StageComplete")
	local c8 = column(s8, width)
	local icon = label(c8, { Text = entry.Ending.Icon, TextSize = 96, LayoutOrder = 1 })
	local endingTitle = label(c8, { Text = string.upper(entry.Ending.Title), FontFace = Theme.Font.Heavy, TextSize = 60, LayoutOrder = 2 })
	Create.Gradient(Theme.Gradient.Title).Parent = endingTitle
	label(c8, { Text = entry.Ending.Line, TextSize = Theme.TextSize.H3, TextColor3 = Theme.Color.TextDim, LayoutOrder = 3 })
	if not options.Replay then
		label(c8, { Name = "RevealCoins", Text = ("🪙 +%d coins%s"):format(entry.Coins or 0, if entry.Boosted then "  (2× Coins)" else ""), FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Gold, LayoutOrder = 4 })
	end
	Anim.Pop(icon, 0.3, 1)
	Anim.Pop(endingTitle, 0.6, 0.9)
	effectRain(26)
	pause(2.5)

	local result = endCard("What if you had chosen differently?", "Every life is a different story. Would yours have turned out better?", {
		{ Name = "RevealAgain", Text = "Live Again", Icon = "✨", Result = "Again", Width = 230 },
		{ Name = "RevealHistory", Text = "Life History", Icon = "📜", Style = "Accent", Result = "History", Width = 230 },
		{ Name = "RevealMenu", Text = if options.Replay then "Close" else "Main Menu", Style = "Secondary", Result = "Menu", Width = 200 },
	})
	finish()
	return result
end

-- ===== Group Life Reveal (a Life Circle watches together) =====
function RevealController.PlayGroup(payload)
	-- If another reveal is showing (e.g. your own stage reveal), wait for it.
	local waited = 0
	while playing and waited < 90 do
		waited += task.wait(0.25)
	end
	if playing then
		return
	end
	begin()
	local width = math.min(700, size().X - 40)

	local step = newStep()
	lightRays(step, Theme.Color.AccentAlt)
	local col = column(step, width)
	local title = label(col, { Text = "👥  GROUP LIFE REVEAL", FontFace = Theme.Font.Heavy, TextSize = 56, LayoutOrder = 1 })
	Create.Gradient(Theme.Gradient.Title).Parent = title
	label(col, { Text = ("Started by %s · %d lives, %d possible futures"):format(payload.StartedBy, #payload.Cards, #payload.Cards), TextColor3 = Theme.Color.TextDim, LayoutOrder = 2 })
	Anim.Pop(title, 0.6, 0.9)
	pause(1.8)

	for _, entry in ipairs(payload.Cards) do
		if session.Skip then
			break
		end
		local s2 = newStep()
		local c2 = column(s2, width)
		label(c2, { Text = Avatar.Line(entry.DisplayName, entry.Style) .. (if entry.IsYou then " (you)" else ""), RichText = true, FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, LayoutOrder = 1 })
		if entry.Hidden or not entry.Card then
			label(c2, { Text = if entry.NoLife then "Between lives right now." else "🔒 Keeps their future private.", TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.H3, LayoutOrder = 2 })
			pause(1.2)
		else
			local card = entry.Card
			label(c2, { Text = ("%s · age %d · %s · %s"):format(card.LifeName, card.Age, card.StageName, card.Career), TextColor3 = Theme.Color.TextDim, LayoutOrder = 2 })
			local starters = {}
			local positives = Futures.Sorted(card.Predictions)
			for i = 1, math.min(3, #positives) do
				table.insert(starters, futureBar(c2, positives[i], nil, 10 + i, width))
			end
			for _, start in ipairs(starters) do
				start(0.6)
				pause(0.25)
			end
			local headline = label(c2, { Text = card.Headline, FontFace = Theme.Font.Bold, TextColor3 = Theme.Color.Gold, LayoutOrder = 20 })
			typewrite(headline, 60)
			pause(1.6)
		end
	end

	if not session.Skip and #payload.Superlatives > 0 then
		local s3 = newStep()
		lightRays(s3, Theme.Color.Gold)
		local c3 = column(s3, width)
		label(c3, { Text = "MOST LIKELY TO…", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H1, LayoutOrder = 1 })
		for i = 1, math.min(6, #payload.Superlatives) do
			local s = payload.Superlatives[i]
			local info = Futures.Info[s.Id]
			local line = label(c3, { Text = ("%s %s: <b>%s</b> (%d%%)"):format(info.Icon, info.Title, s.DisplayName, s.Pct), RichText = true, TextSize = Theme.TextSize.H3, LayoutOrder = 1 + i })
			Anim.Pop(line, 0.7, 0.3)
			pause(0.5)
		end
		pause(2)
	end

	endCard("Same start. Different futures.", "Keep choosing. Every one of these futures can still change.", {
		{ Name = "RevealGroupClose", Text = "Close", Icon = "👍", Result = "Close", Width = 240 },
	})
	finish()
end

function RevealController.Init()
	gui = Create("ScreenGui", {
		Name = "CYL_Reveal",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ScreenInsets = Enum.ScreenInsets.None,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 60,
		Enabled = false,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	root = Create("Frame", { Name = "Root", BackgroundTransparency = 1, Parent = gui })
	uiScale = Instance.new("UIScale")
	uiScale.Parent = root
	layout()
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
	UIController.LayoutChanged:Connect(layout)
end

function RevealController.Start() end

return RevealController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="137">
            <Properties>
              <string name="Name">SettingsController</string>
              <string name="Source"><![CDATA[--[[
	SettingsController  (StarterPlayerScripts.Client.Controllers.SettingsController)
	Holds the player's settings + privacy choices on the client, applies them
	instantly (volume, UI scale, graphics, animations) and saves them to the
	server a moment after the last change (the server validates every value).

	SettingsController.Get(key)            SettingsController.Set(key, value)
	SettingsController.GetPrivacy(key)     SettingsController.SetPrivacy(key, value)
	SettingsController.Changed:Connect(fn(key, value))
	CameraSensitivity is read by the game's own camera systems (Life Reveal
	cinematics, house viewer). Roblox doesn't let games change the default
	camera's mouse sensitivity.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)
local DataTemplate = require(Shared.Data.DataTemplate)
local Anim = require(script.Parent.Parent:WaitForChild("UILib").Anim)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local AudioController = require(script.Parent.AudioController)
local GraphicsController = require(script.Parent.GraphicsController)

local SettingsController = {}
SettingsController.Priority = 5
SettingsController.Changed = Signal.new()
SettingsController.SaveStateChanged = Signal.new() -- ("Saving" | "Saved" | "Failed")

local settings = table.clone(DataTemplate.DefaultSettings)
local privacy = table.clone(DataTemplate.DefaultPrivacy)
local pendingSettings, pendingPrivacy = {}, {}
local saveScheduled = false
local loadedFromServer = false
local scaleToken = 0

local function apply(key: string)
	if key == "MusicVolume" or key == "SfxVolume" then
		AudioController.SetVolumes(settings.MusicVolume, settings.SfxVolume)
	elseif key == "UIScale" then
		-- Applied after the slider pauses, so the screen doesn't re-layout mid-drag.
		scaleToken += 1
		local token = scaleToken
		task.delay(0.45, function()
			if token == scaleToken then
				UIController.SetUserScale(settings.UIScale)
			end
		end)
	elseif key == "Graphics" then
		GraphicsController.Apply(settings.Graphics)
	elseif key == "ReduceAnimations" then
		Anim.Reduced = settings.ReduceAnimations
	end
end

local function applyAll()
	for key in pairs(settings) do
		apply(key)
	end
end

local function scheduleSave()
	if saveScheduled then
		return
	end
	saveScheduled = true
	task.delay(0.8, function()
		saveScheduled = false
		local s, p = pendingSettings, pendingPrivacy
		pendingSettings, pendingPrivacy = {}, {}
		SettingsController.SaveStateChanged:Fire("Saving")
		local ok = true
		if next(s) then
			ok = (Net.Invoke("UpdateSettings", s)) == true and ok
		end
		if next(p) then
			ok = (Net.Invoke("UpdatePrivacy", p)) == true and ok
		end
		if not ok then
			-- Put the values back so the next change retries them.
			for key, value in pairs(s) do
				if pendingSettings[key] == nil then
					pendingSettings[key] = value
				end
			end
			for key, value in pairs(p) do
				if pendingPrivacy[key] == nil then
					pendingPrivacy[key] = value
				end
			end
		end
		SettingsController.SaveStateChanged:Fire(if ok then "Saved" else "Failed")
	end)
end

function SettingsController.Get(key: string)
	return settings[key]
end

function SettingsController.Set(key: string, value: any)
	if settings[key] == nil or settings[key] == value then
		return
	end
	settings[key] = value
	pendingSettings[key] = value
	apply(key)
	SettingsController.Changed:Fire(key, value)
	scheduleSave()
end

function SettingsController.GetPrivacy(key: string)
	return privacy[key]
end

function SettingsController.SetPrivacy(key: string, value: string)
	if privacy[key] == nil or privacy[key] == value then
		return
	end
	privacy[key] = value
	pendingPrivacy[key] = value
	SettingsController.Changed:Fire("Privacy." .. key, value)
	scheduleSave()
end

function SettingsController.Init() end

function SettingsController.Start()
	applyAll()
	DataController.Changed:Connect(function(data)
		-- Adopt saved values once; afterwards the client copy is the source of
		-- truth for display (the server already has whatever we sent).
		if loadedFromServer then
			return
		end
		loadedFromServer = true
		for key, value in pairs(data.Settings or {}) do
			if settings[key] ~= nil then
				settings[key] = value
			end
		end
		for key, value in pairs(data.Privacy or {}) do
			if privacy[key] ~= nil then
				privacy[key] = value
			end
		end
		applyAll()
		SettingsController.Changed:Fire("*", nil)
	end)
end

return SettingsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="138">
            <Properties>
              <string name="Name">SettingsMenu</string>
              <string name="Source"><![CDATA[--[[
	SettingsMenu  (StarterPlayerScripts.Client.Controllers.SettingsMenu)
	The Settings screen. Every control applies immediately and saves
	automatically (see SettingsController). Works with mouse, touch and gamepad.
]]

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Components = require(UILib.Components)
local Layout = require(UILib.Layout)

local UIController = require(script.Parent.UIController)
local SettingsController = require(script.Parent.SettingsController)

local SettingsMenu = {}
SettingsMenu.Priority = 50

local frame: CanvasGroup
local saveLabel: TextLabel? = nil
local firstControl: GuiObject? = nil

local SHARE_OPTIONS = { "Everyone", "Friends", "Nobody" }
local SHARE_LABELS = { "Everyone", "Friends only", "Nobody" }

local function section(parent, title: string, order: number)
	Create.Label({
		Text = title,
		FontFace = Theme.Font.Heavy,
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Color.Primary,
		Size = UDim2.new(1, 0, 0, 30),
		TextYAlignment = Enum.TextYAlignment.Bottom,
		LayoutOrder = order,
		Parent = parent,
	})
end

local function render()
	Create.Clear(frame, true)
	Layout.Header(frame, "Settings", function()
		UIController.Back()
	end)
	local scroll = Layout.Scroll(frame)
	local width = math.min(720, UIController.GetVirtualSize().X - 32)
	local column = Layout.Column(scroll, width)
	local order = 0
	local function nextOrder()
		order += 1
		return order
	end

	section(column, "🔊  AUDIO", nextOrder())
	local music = Components.Slider({ Label = "Music volume", Min = 0, Max = 1, Step = 0.05, Value = SettingsController.Get("MusicVolume"), LayoutOrder = nextOrder(), Parent = column, OnChanged = function(v)
		SettingsController.Set("MusicVolume", v)
	end })
	firstControl = music.Instance:FindFirstChild("Controls") and music.Instance.Controls:FindFirstChildWhichIsA("GuiButton")
	Components.Slider({ Label = "Sound effects volume", Min = 0, Max = 1, Step = 0.05, Value = SettingsController.Get("SfxVolume"), LayoutOrder = nextOrder(), Parent = column, OnChanged = function(v)
		SettingsController.Set("SfxVolume", v)
	end })

	section(column, "🖥️  DISPLAY", nextOrder())
	Components.Selector({ Label = "Graphics", Options = { "Auto", "Low", "High" }, Labels = { "Auto", "Low (faster)", "High" }, Value = SettingsController.Get("Graphics"), LayoutOrder = nextOrder(), Parent = column, OnChanged = function(v)
		SettingsController.Set("Graphics", v)
	end })
	Components.Slider({
		Label = "UI scale",
		Min = 0.75,
		Max = 1.25,
		Step = 0.05,
		Value = SettingsController.Get("UIScale"),
		LayoutOrder = nextOrder(),
		Parent = column,
		OnChanged = function(v)
			SettingsController.Set("UIScale", v)
		end,
	})
	Components.Toggle({ Label = "Reduce animations", Value = SettingsController.Get("ReduceAnimations"), LayoutOrder = nextOrder(), Parent = column, OnChanged = function(v)
		SettingsController.Set("ReduceAnimations", v)
	end })

	section(column, "🎮  CONTROLS", nextOrder())
	Components.Slider({
		Label = "Camera sensitivity",
		Min = 0.2,
		Max = 2,
		Step = 0.1,
		Value = SettingsController.Get("CameraSensitivity"),
		Format = function(v)
			return ("%.1fx"):format(v)
		end,
		LayoutOrder = nextOrder(),
		Parent = column,
		OnChanged = function(v)
			SettingsController.Set("CameraSensitivity", v)
		end,
	})

	section(column, "🔔  NOTIFICATIONS", nextOrder())
	Components.Toggle({ Label = "Show notifications", Value = SettingsController.Get("Notifications"), LayoutOrder = nextOrder(), Parent = column, OnChanged = function(v)
		SettingsController.Set("Notifications", v)
	end })

	section(column, "🔒  PRIVACY: WHAT OTHERS CAN SEE", nextOrder())
	for _, entry in ipairs({
		{ Key = "ShareStats", Label = "My life stats" },
		{ Key = "ShareReveals", Label = "My Life Reveals" },
		{ Key = "ShareHistory", Label = "My past lives" },
	}) do
		Components.Selector({ Label = entry.Label, Options = SHARE_OPTIONS, Labels = SHARE_LABELS, Value = SettingsController.GetPrivacy(entry.Key), LayoutOrder = nextOrder(), Parent = column, OnChanged = function(v)
			SettingsController.SetPrivacy(entry.Key, v)
		end })
	end

	saveLabel = Create.Label({
		Text = "✓ Changes save automatically",
		TextSize = Theme.TextSize.Small,
		TextColor3 = Theme.Color.TextFaint,
		TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = nextOrder(),
		Parent = column,
	})
end

function SettingsMenu.Init()
	frame = UIController.NewScreen("Settings", {
		Back = true,
		OnOpen = render,
		DefaultFocus = function()
			return firstControl
		end,
	})
end

function SettingsMenu.Start()
	SettingsController.SaveStateChanged:Connect(function(state)
		if not saveLabel or not saveLabel.Parent then
			return
		end
		if state == "Saving" then
			saveLabel.Text = "Saving…"
		elseif state == "Saved" then
			saveLabel.Text = "✓ Saved"
		else
			saveLabel.Text = "⚠️ Couldn't save. It will retry with your next change."
		end
	end)
	UIController.LayoutChanged:Connect(function()
		-- UI scale changes re-layout the screen; rebuild so sizes fit.
		if UIController.Current() == "Settings" then
			render()
		end
	end)
end

return SettingsMenu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="139">
            <Properties>
              <string name="Name">ShopController</string>
              <string name="Source"><![CDATA[--[[
	ShopController  (StarterPlayerScripts.Client.Controllers.ShopController)
	The 🛍️ Shop screen (main menu → Shop):
	  • search box and category tabs (All + 10 categories)
	  • item cards with icon, rarity, price / Owned / Equipped / VIP
	  • a preview of each item ON YOUR LOOK before you buy (avatar, home &
	    car scene, name tag, theme swatch, falling reveal effect...)
	  • purchase confirmation, then buy, equip or unequip
	  • 🪙 Get Coins: real Robux coin packs and passes (only shown when the
	    game has them set up; prices come from Roblox)
	Everything is cosmetic. The server validates every purchase (ShopService).
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Catalog = require(Shared.Data.Catalog)
local Format = require(Shared.Util.Format)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Anim = require(UILib.Anim)
local Components = require(UILib.Components)
local Layout = require(UILib.Layout)
local Avatar = require(UILib.Avatar)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local NotificationController = require(script.Parent.NotificationController)
local StyleController = require(script.Parent.StyleController)

local ShopController = {}
ShopController.Priority = 51

local frame: CanvasGroup
local category: string? = nil -- nil = All
local query = ""
local storeInfo = nil
local busy = false
local grid: Frame? = nil

local ERRORS = {
	NotEnoughCoins = "You don't have enough Coins yet. Play to earn more!",
	AlreadyOwned = "You already own this.",
	NeedVIP = "This is a VIP exclusive.",
	NotOwned = "You don't own this yet.",
	RateLimited = "Slow down a moment.",
}

local function data()
	return DataController.Get()
end

local function owns(item): boolean
	local d = data()
	return d ~= nil and d.Inventory.Owned[item.Id] == true
end

local function equipped(item): boolean
	local d = data()
	return d ~= nil and d.Inventory.Equipped[item.Slot] == item.Id
end

local function hasVip(): boolean
	local d = data()
	return d ~= nil and d.Passes ~= nil and d.Passes.VIP == true
end

local function priceText(item): string
	if equipped(item) then
		return "✅ Equipped"
	elseif owns(item) then
		return "Owned"
	elseif item.VipOnly then
		return "⭐ VIP"
	end
	return "🪙 " .. Format.Commas(item.Price)
end

local renderGrid
local openItem

local function act(remote: string, arg, successText: string?)
	if busy then
		return false
	end
	busy = true
	local ok, result = Net.Invoke(remote, arg)
	busy = false
	if ok then
		if successText then
			NotificationController.Notify({ Title = "🛍️ Shop", Text = successText, Kind = "Success", Duration = 2.5 })
		end
	else
		NotificationController.Notify({ Title = "🛍️ Shop", Text = ERRORS[result] or tostring(result), Kind = "Warning" })
	end
	return ok
end

-- ===== Item preview =====
local function previewBox(parent, item)
	local box = Create("Frame", { Name = "Preview", BackgroundColor3 = Theme.Color.Background, Size = UDim2.new(1, 0, 0, 190), LayoutOrder = 1, ClipsDescendants = true, Parent = parent }, { Create.Corner(Theme.RadiusSmall) })
	local style = StyleController.With(item)
	local d = data()
	local name = (d and DataController.GetActiveLife() and DataController.GetActiveLife().Name) or Players.LocalPlayer.DisplayName or "You"
	local slot = item.Slot
	if slot == "Backdrop" then
		Create.Gradient(ColorSequence.new(Color3.fromHex(item.Colors[1]), Color3.fromHex(item.Colors[2])), 120).Parent = box
		box.BackgroundColor3 = Theme.Color.White
		Create.Label({ Text = "Your menus will look like this", FontFace = Theme.Font.Bold, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = box })
	elseif slot == "House" or slot == "Apartment" or slot == "Car" or slot == "Furniture" then
		local scene = (style.House or style.Apartment or "🏠") .. "  " .. (style.Car or "") .. "  " .. (style.Furniture or "")
		Create.Label({ Text = item.Icon, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0.62, 0), Parent = box })
		Create.Label({ Text = "Your life: " .. scene, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromScale(0, 0.66), Size = UDim2.new(1, 0, 0.3, 0), Parent = box })
	elseif slot == "RevealEffect" then
		Create.Label({ Text = "LIFE REVEAL", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H2, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = box })
		local rng = Random.new()
		for i = 1, 14 do
			local g = Create.Label({ Name = "Fx" .. i, Text = item.Glyphs[(i - 1) % #item.Glyphs + 1], TextSize = 28, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(32, 32), Position = UDim2.new(rng:NextNumber(0, 0.95), 0, -0.2, 0), Parent = box })
			Anim.Tween(g, { Position = UDim2.new(g.Position.X.Scale, 0, 1.1, 0) }, rng:NextNumber(1.2, 2.4), Enum.EasingStyle.Linear)
		end
	elseif slot == "Aura" then
		Create.Label({ Text = style.Face .. item.Icon, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0.6, 0), Parent = box })
		Create.Label({ Text = "Surrounds your character in the world", TextColor3 = Theme.Color.TextDim, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromScale(0, 0.65), Size = UDim2.new(1, 0, 0.3, 0), Parent = box })
	else
		local badge = Avatar.Badge({ Style = style, Size = 120, Parent = box })
		badge.AnchorPoint = Vector2.new(0.5, 0)
		badge.Position = UDim2.new(0.5, 0, 0, 14)
		Create.Label({ Name = "PreviewName", Text = Avatar.Line(name, style), RichText = true, FontFace = Theme.Font.Bold, TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -6), Size = UDim2.new(1, 0, 0, 28), Parent = box })
	end
	return box
end

local function promptPass(key: string)
	if not storeInfo then
		return false
	end
	for _, pass in ipairs(storeInfo.Passes) do
		if pass.Key == key and not pass.Owned then
			pcall(function()
				MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, pass.Id)
			end)
			return true
		end
	end
	return false
end

function openItem(item)
	local handle = UIController.OpenPanel({ Name = "ItemModal", Title = item.Icon .. "  " .. item.Name, Width = 620 })
	handle.Subtitle.Text = ("%s · %s · %s"):format(item.Rarity, Catalog.Slots[item.Slot].Name, priceText(item))
	local scroll = handle.Scroll
	previewBox(scroll, item)
	Create.Label({ Text = item.Description, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = scroll })
	Create.Label({ Text = "✨ Cosmetic only: it never changes your life's choices, stats or money.", TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextFaint, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = scroll })
	local d = data()
	local function refresh()
		task.wait(0.25)
		if handle.IsOpen() then
			openItem(item)
		end
		if UIController.Current() == "Shop" then
			renderGrid()
		end
	end
	local buttonProps = { Size = UDim2.new(1, 0, 0, 54), LayoutOrder = 10, Parent = scroll }
	local function button(props)
		for k, v in pairs(buttonProps) do
			props[k] = props[k] or v
		end
		return Components.Button(props)
	end
	if owns(item) then
		if equipped(item) then
			button({ Name = "Unequip", Text = "Unequip", Icon = "↩️", Style = "Secondary", OnClick = function()
				if act("ShopUnequip", item.Slot) then
					refresh()
				end
			end })
		elseif item.VipOnly and not hasVip() then
			button({ Name = "NeedVip", Text = "Needs VIP to wear", Icon = "⭐", Style = "Secondary" })
		else
			button({ Name = "Equip", Text = "Equip", Icon = "✅", Style = "Primary", OnClick = function()
				if act("ShopEquip", item.Id, item.Name .. " equipped!") then
					refresh()
				end
			end })
		end
	elseif item.VipOnly then
		if hasVip() then
			button({ Name = "ClaimVip", Text = "Claim free with VIP", Icon = "⭐", Style = "Primary", OnClick = function()
				if act("ShopBuy", item.Id, item.Name .. " is yours!") then
					refresh()
				end
			end })
		else
			local available = storeInfo ~= nil and #storeInfo.Passes > 0
			local vip = button({ Name = "GetVip", Text = if available then "Get VIP" else "VIP isn't available yet", Icon = "⭐", Style = if available then "Accent" else "Secondary", OnClick = function()
				promptPass("VIP")
			end })
			if not available then
				Components.SetDisabled(vip, true)
			end
		end
	else
		local coins = d and d.Coins or 0
		local buy = button({ Name = "Buy", Text = ("Buy for %s Coins"):format(Format.Commas(item.Price)), Icon = "🪙", Style = "Primary", OnClick = function()
			local confirmed = UIController.Confirm({
				Title = "Buy " .. item.Name .. "?",
				Text = ("It costs %s Coins. You have %s."):format(Format.Commas(item.Price), Format.Commas(coins)),
				ConfirmText = "Buy",
			})
			if confirmed and act("ShopBuy", item.Id, item.Name .. " bought and equipped!") then
				refresh()
			end
		end })
		if coins < item.Price then
			Components.SetDisabled(buy, true)
			Create.Label({ Text = ("You need %s more Coins. Finish stages and lives to earn them."):format(Format.Commas(item.Price - coins)), TextColor3 = Theme.Color.Warning, TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 11, Parent = scroll })
		end
	end
end

-- ===== Get Coins (Robux) =====
local function openCoins()
	local handle = UIController.OpenPanel({ Name = "CoinsModal", Title = "🪙  Get Coins", Width = 640 })
	handle.Subtitle.Text = "Purchases are handled securely by Roblox"
	local scroll = handle.Scroll
	local info = storeInfo or { Products = {}, Passes = {} }
	local order = 0
	for _, product in ipairs(info.Products) do
		order += 1
		Components.Button({ Name = "Product_" .. product.Key, Text = ("%s %s Coins · %s  (R$ %d)"):format(product.Icon, Format.Commas(product.Coins), product.Name, product.Price), Style = "Primary", Size = UDim2.new(1, 0, 0, 56), TextSize = 18, LayoutOrder = order, Parent = scroll, OnClick = function()
			pcall(function()
				MarketplaceService:PromptProductPurchase(Players.LocalPlayer, product.Id)
			end)
		end })
	end
	for _, pass in ipairs(info.Passes) do
		order += 1
		local panel = Components.Panel({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Padding = 14, LayoutOrder = 100 + order, Parent = scroll, Color = Theme.Color.SurfaceHigh })
		Create.List(Enum.FillDirection.Vertical, 6).Parent = panel
		Create.Label({ Text = pass.Icon .. "  " .. pass.Name, FontFace = Theme.Font.Heavy, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = panel })
		Create.Label({ Text = pass.Description, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = panel })
		local passButton = Components.Button({ Name = "Pass_" .. pass.Key, Text = if pass.Owned then "Owned ✓" else ("Get it  (R$ %d)"):format(pass.Price), Style = if pass.Owned then "Secondary" else "Accent", Size = UDim2.fromOffset(220, 48), LayoutOrder = 3, Parent = panel, OnClick = function()
			if not pass.Owned then
				pcall(function()
					MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, pass.Id)
				end)
			end
		end })
		if pass.Owned then
			Components.SetDisabled(passButton, true)
		end
	end
	if order == 0 then
		Create.Label({ Text = "Coin packs and passes aren't set up for this game yet. You can earn Coins by playing: completing stages and lives, and joining group and city events.", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = scroll })
	end
	Create.Label({ Text = "Fair play: everything you can buy is cosmetic. Nothing affects your life's choices or outcomes.", TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextFaint, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 999, Parent = scroll })
end

-- ===== Grid =====
function renderGrid()
	if not grid then
		return
	end
	Create.Clear(grid)
	local narrow = UIController.IsNarrow()
	local layout = grid:FindFirstChildOfClass("UIGridLayout")
	local columns = if narrow then 2 else 5
	local available = math.min(1100, UIController.GetVirtualSize().X - 40)
	local cellWidth = math.floor((available - 12 * (columns - 1)) / columns)
	if layout then
		layout.CellSize = UDim2.fromOffset(cellWidth, 176)
	end
	local items = Catalog.Search(query, category)
	table.sort(items, function(a, b)
		local ra, rb = Catalog.Rarities[a.Rarity].Order, Catalog.Rarities[b.Rarity].Order
		if ra ~= rb then
			return ra < rb
		end
		return a.Price < b.Price
	end)
	for i, item in ipairs(items) do
		local rarity = Catalog.Rarities[item.Rarity]
		local card = Create("TextButton", {
			Name = "Item_" .. item.Id,
			Text = "",
			AutoButtonColor = false,
			Selectable = true,
			BackgroundColor3 = Theme.Color.Surface,
			LayoutOrder = i,
			Parent = grid,
		}, { Create.Corner(Theme.RadiusSmall), Create.Stroke(Color3.fromHex(rarity.Color), if equipped(item) then 3 else 1.5, if equipped(item) then 0 else 0.3), Create.Padding(10) })
		Create.Label({ Text = item.Icon, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 72), Parent = card })
		Create.Label({ Text = item.Name, FontFace = Theme.Font.Bold, TextSize = Theme.TextSize.Small, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.fromOffset(0, 76), Size = UDim2.new(1, 0, 0, 40), Parent = card })
		Create.Label({ Name = "Price", Text = priceText(item), FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.Small, TextColor3 = if owns(item) then Theme.Color.Positive else Color3.fromHex(rarity.Color), TextXAlignment = Enum.TextXAlignment.Center, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 24), Parent = card })
		card.Activated:Connect(function()
			if Components.OnClickSound then
				Components.OnClickSound()
			end
			openItem(item)
		end)
	end
	if #items == 0 then
		Create.Label({ Text = "Nothing matches that search.", TextColor3 = Theme.Color.TextDim, Size = UDim2.fromOffset(300, 40), LayoutOrder = 1, Parent = grid })
	end
end

local function render()
	Create.Clear(frame, true)
	local header = Layout.Header(frame, "Shop", function()
		UIController.Back()
	end)
	local d = data()
	local coinsChip = Components.Chip({ Text = "🪙 " .. Format.Commas(d and d.Coins or 0), Height = 44, TextSize = Theme.TextSize.Body, Parent = header })
	coinsChip.Name = "Coins"
	coinsChip.AnchorPoint = Vector2.new(1, 0.5)
	coinsChip.Position = UDim2.fromScale(1, 0.5)

	local scroll = Layout.Scroll(frame)
	local width = math.min(1100, UIController.GetVirtualSize().X - 40)
	local column = Layout.Column(scroll, width)

	-- Search + get coins
	local top = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 50), LayoutOrder = 1, Parent = column })
	local hasStore = storeInfo ~= nil and (#storeInfo.Products > 0 or #storeInfo.Passes > 0)
	local search = Create("TextBox", {
		Name = "ShopSearch",
		Text = query,
		PlaceholderText = "🔎 Search items…",
		PlaceholderColor3 = Theme.Color.TextFaint,
		ClearTextOnFocus = false,
		FontFace = Theme.Font.Medium,
		TextSize = Theme.TextSize.Body,
		TextColor3 = Theme.Color.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		BackgroundColor3 = Theme.Color.Background,
		Size = UDim2.new(1, if hasStore then -200 else 0, 1, 0),
		Parent = top,
	}, { Create.Corner(Theme.RadiusSmall), Create.Stroke(), Create.Padding(0, 14) })
	search:GetPropertyChangedSignal("Text"):Connect(function()
		if search.Text ~= query then
			query = search.Text
			renderGrid()
		end
	end)
	if hasStore then
		Components.Button({ Name = "GetCoins", Text = "Get Coins", Icon = "🪙", Style = "Accent", Size = UDim2.fromOffset(188, 50), AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), TextSize = 18, Parent = top, OnClick = openCoins })
	end

	-- Category tabs
	local tabs = Create("Frame", { Name = "Tabs", BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, Parent = column })
	local tabList = Create.List(Enum.FillDirection.Horizontal, 8)
	tabList.Wraps = true
	tabList.Parent = tabs
	local entries = { { Id = nil, Name = "All", Icon = "🛍️" } }
	for _, c in ipairs(Catalog.Categories) do
		table.insert(entries, c)
	end
	for i, c in ipairs(entries) do
		local selected = category == c.Id
		Components.Button({
			Name = "Tab_" .. (c.Id or "All"),
			Text = c.Name,
			Icon = c.Icon,
			Style = if selected then "Primary" else "Secondary",
			Size = UDim2.fromOffset(if UIController.IsNarrow() then 150 else 160, 44),
			TextSize = 16,
			LayoutOrder = i,
			Parent = tabs,
			OnClick = function()
				category = c.Id
				render()
			end,
		})
	end

	grid = Create("Frame", { Name = "Grid", BackgroundTransparency = 1, Size = UDim2.fromOffset(width, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = column })
	Create("UIGridLayout", { CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	renderGrid()
	Create.Label({ Text = "Every item is cosmetic. Earn Coins by completing stages (+15) and lives, and by joining group and city events.", TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextFaint, TextXAlignment = Enum.TextXAlignment.Center, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 9, Parent = column })
end

function ShopController.Open(categoryId: string?)
	category = categoryId
	query = ""
	UIController.Show("Shop")
end

function ShopController.Init()
	frame = UIController.NewScreen("Shop", { Back = true, OnOpen = function()
		render()
		task.spawn(function()
			local ok, info = Net.Invoke("GetStoreInfo")
			if ok then
				storeInfo = info
				if UIController.Current() == "Shop" then
					render()
				end
			end
		end)
	end })
end

function ShopController.Start()
	DataController.Changed:Connect(function()
		if UIController.Current() == "Shop" and grid then
			-- Update prices/owned state and the coin balance without losing the search box.
			renderGrid()
			local header = frame:FindFirstChild("Header")
			local chip = header and header:FindFirstChild("Coins")
			local d = data()
			if chip and d then
				chip:FindFirstChild("Label").Text = "🪙 " .. Format.Commas(d.Coins)
			end
		end
	end)
	UIController.LayoutChanged:Connect(function()
		if UIController.Current() == "Shop" then
			render()
		end
	end)
end

return ShopController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="140">
            <Properties>
              <string name="Name">ShowcaseController</string>
              <string name="Source"><![CDATA[--[[
	ShowcaseController  (StarterPlayerScripts.Client.Controllers.ShowcaseController)
	The Life Reveal's flyover: "show actual environments the player might
	eventually unlock". For a future archetype (Luxury, Career, Family…) the
	camera glides over the matching real place in Lifeville
	(World.Showcase: Hilltop Mansion, Lifeville Tower, Oak Street…), with the
	menus hidden and the sky set to a fitting time of day. Everything is
	restored afterwards (camera, menus, sky, traffic).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local World = require(ReplicatedStorage:WaitForChild("Shared").Data.World)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Anim = require(UILib.Anim)

local UIController = require(script.Parent.UIController)
local DayNightController = require(script.Parent.DayNightController)
local ExploreController = require(script.Parent.ExploreController)
local TrafficController = require(script.Parent.TrafficController)

local ShowcaseController = {}
ShowcaseController.Priority = 61
ShowcaseController.Hours = { Lonely = 19.2, Difficult = 17.4, Fame = 20.5, Content = 16.5, Adventure = 15 }
ShowcaseController.DefaultHour = 13.5

local saved = nil
local shot = nil

local function vector(t): Vector3
	return Vector3.new(t[1], t[2], t[3])
end

function ShowcaseController.Available(archetype: string): boolean
	return workspace:FindFirstChild("World") ~= nil and World.ShowcaseShot(archetype) ~= nil and workspace.CurrentCamera ~= nil
end

function ShowcaseController.IsActive(): boolean
	return saved ~= nil
end

-- Starts the shot: menus hidden, camera at the first position. Returns the shot.
function ShowcaseController.Begin(archetype: string)
	local camera = workspace.CurrentCamera
	shot = World.ShowcaseShot(archetype)
	if not shot or not camera then
		return nil
	end
	if not saved then
		saved = { Type = camera.CameraType, CFrame = camera.CFrame, Subject = camera.CameraSubject, FieldOfView = camera.FieldOfView }
	end
	UIController.SetWorldView(true)
	TrafficController.SetVisible(true)
	DayNightController.Override(ShowcaseController.Hours[archetype] or ShowcaseController.DefaultHour)
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = 60
	camera.CFrame = CFrame.lookAt(vector(shot.From), vector(shot.Focus))
	return shot
end

-- Glides the camera to the shot's end position over `duration` seconds.
function ShowcaseController.Glide(duration: number)
	local camera = workspace.CurrentCamera
	if not shot or not camera then
		return
	end
	Anim.Tween(camera, { CFrame = CFrame.lookAt(vector(shot.To), vector(shot.Focus)) }, duration, Enum.EasingStyle.Sine)
end

function ShowcaseController.End()
	if not saved then
		return
	end
	local camera = workspace.CurrentCamera
	if camera then
		camera.CameraType = saved.Type
		camera.CFrame = saved.CFrame
		camera.CameraSubject = saved.Subject
		camera.FieldOfView = saved.FieldOfView
	end
	saved = nil
	shot = nil
	UIController.SetWorldView(false)
	DayNightController.Override(nil)
	TrafficController.SetVisible(ExploreController.IsExploring())
end

function ShowcaseController.Init() end
function ShowcaseController.Start() end

return ShowcaseController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="141">
            <Properties>
              <string name="Name">StyleController</string>
              <string name="Source"><![CDATA[--[[
	StyleController  (StarterPlayerScripts.Client.Controllers.StyleController)
	Your equipped cosmetics as a Style (Shared/Util/Style), kept up to date
	from your data. Applies the menu theme (Backdrop) and lets other screens
	(HUD, menu, reveals, shop previews) show your look.
	StyleController.Get() -> style · StyleController.Changed(style)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Util.Signal)
local Style = require(Shared.Util.Style)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)

local StyleController = {}
StyleController.Priority = 7
StyleController.Changed = Signal.new()

local current = Style.Of({})
local lastKey = ""

function StyleController.Get()
	return current
end

-- A preview of your look with one item swapped in (shop previews).
function StyleController.With(item)
	local data = DataController.Get()
	local equipped = table.clone(if data then data.Inventory.Equipped else {})
	if item then
		equipped[item.Slot] = item.Id
	end
	return Style.Of(equipped)
end

local function refresh(data)
	local equipped = data and data.Inventory and data.Inventory.Equipped or {}
	local parts = {}
	for slot, id in pairs(equipped) do
		table.insert(parts, slot .. "=" .. tostring(id))
	end
	table.sort(parts)
	local key = table.concat(parts, ",")
	if key == lastKey then
		return
	end
	lastKey = key
	current = Style.Of(equipped)
	if current.Backdrop then
		UIController.SetBackdropColors(Color3.fromHex(current.Backdrop[1]), Color3.fromHex(current.Backdrop[2]))
	else
		UIController.SetBackdropColors(nil)
	end
	StyleController.Changed:Fire(current)
end

function StyleController.Init() end

function StyleController.Start()
	DataController.Changed:Connect(refresh)
	if DataController.Get() then
		refresh(DataController.Get())
	end
end

return StyleController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="142">
            <Properties>
              <string name="Name">TradeController</string>
              <string name="Source"><![CDATA[--[[
	TradeController  (StarterPlayerScripts.Client.Controllers.TradeController)
	🔄 Trading cosmetics with another player in this server.
	  • Offer a trade from the Friends screen or someone's profile; they get
	    a request card (Accept / No thanks).
	  • The trade window shows both offers, your tradable items (tap to add
	    or remove, up to 6), each side's Ready state and the countdown.
	  • Ready locks in exactly what you can see. If anyone changes their
	    offer, both of you have to press Ready again.
	  • Only items bought with Coins can be traded. The server checks
	    everything and swaps both inventories at once (TradeService).
	Closing the window cancels the trade.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Catalog = require(Shared.Data.Catalog)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Components = require(UILib.Components)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)
local NotificationController = require(script.Parent.NotificationController)
local PartyController = require(script.Parent.PartyController)

local TradeController = {}
TradeController.Priority = 66

local ERRORS = {
	NotHere = "That player isn't in this server.",
	NotLoaded = "Still loading. Try again in a moment.",
	AlreadyTrading = "You're already in a trade.",
	TheyAreTrading = "They're already trading with someone.",
	Cooldown = "Wait a few seconds before sending another request.",
	NoRequest = "That trade request has expired.",
	Expired = "That trade request has expired.",
	NotOwned = "You don't own that item any more.",
	NotTradable = "That item can't be traded.",
	TheyOwnIt = "They already own that item.",
	TooMany = "You can offer up to 6 items.",
	Changed = "The offer changed. Check it again, then press Ready.",
	RateLimited = "Slow down a moment.",
}

local state = nil -- the latest TradeUpdate for an open trade
local handle = nil
local closingFromServer = false

function TradeController.State()
	return state
end

local function errorText(reason): string
	return ERRORS[reason] or tostring(reason)
end

function TradeController.Request(userId: number)
	local ok, result = Net.Invoke("TradeRequestSend", userId)
	if ok then
		NotificationController.Notify({ Title = "🔄 Trade request sent", Text = "They have 30 seconds to accept.", Kind = "Success", Duration = 3 })
	else
		NotificationController.Notify({ Title = "🔄 Couldn't send", Text = errorText(result), Kind = "Warning" })
	end
	return ok, result
end

local function myOffer(): { string }
	local ids = {}
	for _, item in ipairs(state and state.Mine or {}) do
		table.insert(ids, item.Id)
	end
	return ids
end

local function toggle(itemId: string)
	if not state then
		return
	end
	local ids = myOffer()
	local index = table.find(ids, itemId)
	if index then
		table.remove(ids, index)
	else
		table.insert(ids, itemId)
	end
	local ok, result = Net.Invoke("TradeSetOffer", state.SessionId, ids)
	if not ok then
		NotificationController.Notify({ Title = "🔄 Trade", Text = errorText(result), Kind = "Warning" })
	end
end

local function itemChips(parent, items, order: number, empty: string)
	local holder = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order, Parent = parent })
	local list = Create.List(Enum.FillDirection.Horizontal, 6)
	list.Wraps = true
	list.Parent = holder
	if #items == 0 then
		Create.Label({ Text = empty, TextColor3 = Theme.Color.TextFaint, TextSize = Theme.TextSize.Small, AutomaticSize = Enum.AutomaticSize.XY, Parent = holder })
	end
	for i, item in ipairs(items) do
		local chip = Components.Chip({ Text = item.Icon .. " " .. item.Name, Height = 32, LayoutOrder = i, Parent = holder })
		chip.Name = "Offer_" .. item.Id
	end
	return holder
end

local function render()
	if not handle or not state then
		return
	end
	handle.Clear()
	handle.Subtitle.Text = if state.Countdown then ("Trading in %d…"):format(state.Countdown) else "Both players must press Ready"
	local scroll = handle.Scroll
	local sides = Create("Frame", { Name = "Sides", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1, Parent = scroll })
	local narrow = UIController.IsNarrow()
	local list = Create.List(if narrow then Enum.FillDirection.Vertical else Enum.FillDirection.Horizontal, 12)
	list.Parent = sides
	local width = if narrow then UDim2.new(1, 0, 0, 0) else UDim2.new(0.5, -6, 0, 0)
	for i, side in ipairs({ { "YOU GIVE", state.Mine, state.MyReady, "Mine" }, { state.With.Name:upper() .. " GIVES", state.Theirs, state.TheirReady, "Theirs" } }) do
		local panel = Components.Panel({ Name = side[4], Size = width, AutomaticSize = Enum.AutomaticSize.Y, Padding = 12, LayoutOrder = i, Parent = sides, Color = Theme.Color.SurfaceHigh })
		Create.List(Enum.FillDirection.Vertical, 8).Parent = panel
		Create.Label({ Text = side[1], TextSize = Theme.TextSize.Tiny, FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Primary, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 1, Parent = panel })
		itemChips(panel, side[2], 2, "Nothing yet")
		Create.Label({ Name = "ReadyState", Text = if side[3] then "✅ Ready" else "⏳ Not ready", TextColor3 = if side[3] then Theme.Color.Positive else Theme.Color.TextDim, FontFace = Theme.Font.Bold, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 3, Parent = panel })
	end

	-- Your tradable items
	Create.Label({ Text = "YOUR TRADABLE ITEMS · tap to add or remove", TextSize = Theme.TextSize.Tiny, FontFace = Theme.Font.Heavy, TextColor3 = Theme.Color.Primary, Size = UDim2.new(1, 0, 0, 26), TextYAlignment = Enum.TextYAlignment.Bottom, LayoutOrder = 2, Parent = scroll })
	local data = DataController.Get()
	local grid = Create("Frame", { Name = "Inventory", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, Parent = scroll })
	local gridList = Create.List(Enum.FillDirection.Horizontal, 8)
	gridList.Wraps = true
	gridList.Parent = grid
	local offered = {}
	for _, id in ipairs(myOffer()) do
		offered[id] = true
	end
	local count = 0
	for _, item in ipairs(Catalog.Items) do
		if data and data.Inventory.Owned[item.Id] and Catalog.IsTradable(item) then
			count += 1
			Components.Button({ Name = "Item_" .. item.Id, Text = item.Name, Icon = item.Icon, Style = if offered[item.Id] then "Primary" else "Secondary", Size = UDim2.fromOffset(200, 44), TextSize = 15, LayoutOrder = count, Parent = grid, OnClick = function()
				toggle(item.Id)
			end })
		end
	end
	if count == 0 then
		Create.Label({ Text = "You don't have any tradable items yet. Items bought with Coins in the shop can be traded; VIP items can't.", TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.new(1, 0, 0, 0), Parent = grid })
	end

	local row = Create("Frame", { Name = "Buttons", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 54), LayoutOrder = 4, Parent = scroll })
	Create.List(Enum.FillDirection.Horizontal, 10).Parent = row
	Components.Button({ Name = "ReadyButton", Text = if state.MyReady then "Not ready" else "Ready", Icon = if state.MyReady then "↩️" else "✅", Style = if state.MyReady then "Secondary" else "Primary", Size = UDim2.fromOffset(220, 52), Parent = row, LayoutOrder = 1, OnClick = function()
		local ok, result = Net.Invoke("TradeReady", state.SessionId, state.Version, not state.MyReady)
		if not ok then
			NotificationController.Notify({ Title = "🔄 Trade", Text = errorText(result), Kind = "Warning" })
		end
	end })
	Components.Button({ Name = "CancelTrade", Text = "Cancel", Icon = "✕", Style = "Ghost", Size = UDim2.fromOffset(160, 52), Parent = row, LayoutOrder = 2, OnClick = function()
		UIController.ClosePanel()
	end })
	Create.Label({ Text = "Check both offers carefully. Ready locks in what you see; any change means both of you press Ready again. Coins, VIP and Robux items can't be traded.", TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextFaint, AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 5, Parent = scroll })
end

local function openWindow()
	if handle and handle.IsOpen() then
		render()
		return
	end
	handle = UIController.OpenPanel({ Name = "TradeModal", Title = "🔄  Trade with " .. state.With.Name, Width = 800, Height = 660, OnClose = function()
		if not closingFromServer and state then
			Net.Invoke("TradeCancel", state.SessionId)
		end
		handle = nil
	end })
	render()
end

local function onUpdate(payload)
	if type(payload) ~= "table" then
		return
	end
	if payload.Closed then
		state = nil
		if handle and handle.IsOpen() then
			closingFromServer = true
			UIController.ClosePanel()
			closingFromServer = false
		end
		handle = nil
		if payload.Completed then
			local got = {}
			for _, item in ipairs(payload.Got or {}) do
				table.insert(got, item.Icon .. " " .. item.Name)
			end
			NotificationController.Notify({ Title = "✅ Trade complete!", Text = if #got > 0 then "You got: " .. table.concat(got, ", ") else "Your items were sent.", Kind = "Important", Duration = 5 })
		else
			NotificationController.Notify({ Title = "🔄 Trade ended", Text = payload.Reason or "The trade was cancelled.", Kind = "Info" })
		end
		return
	end
	state = payload
	openWindow()
end

local function onRequest(request)
	PartyController.PromptCard("Trade" .. request.RequestId, "🔄 " .. request.FromName .. " wants to trade", "Swap cosmetic items with them. You'll both see the offers and must press Ready before anything changes hands.", request.Seconds or 30, {
		{ Name = "AcceptTrade", Text = "Trade", OnClick = function()
			local ok, result = Net.Invoke("TradeRespond", request.RequestId, true)
			if not ok then
				NotificationController.Notify({ Title = "🔄 Couldn't start the trade", Text = errorText(result), Kind = "Warning" })
			end
		end },
		{ Name = "DeclineTrade", Text = "No thanks", OnClick = function()
			Net.Invoke("TradeRespond", request.RequestId, false)
		end },
	})
end

function TradeController.Init() end

function TradeController.Start()
	Net.OnEvent("TradeRequest", onRequest)
	Net.OnEvent("TradeUpdate", onUpdate)
	DataController.Changed:Connect(function()
		if handle and handle.IsOpen() then
			render()
		end
	end)
end

return TradeController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="143">
            <Properties>
              <string name="Name">TrafficController</string>
              <string name="Source"><![CDATA[--[[
	TrafficController  (StarterPlayerScripts.Client.Controllers.TrafficController)
	Cars driving round Lifeville's roads (World.TrafficLoops), on each client
	only: no network traffic and no collisions (walk-through), so they can
	never block or push a player. Fewer cars on Low graphics; hidden when
	you're not exploring.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local World = require(ReplicatedStorage:WaitForChild("Shared").Data.World)

local GraphicsController = require(script.Parent.GraphicsController)
local ExploreController = require(script.Parent.ExploreController)

local TrafficController = {}
TrafficController.Priority = 59
TrafficController.Speed = 26 -- studs per second
TrafficController.HighCount = 8
TrafficController.LowCount = 3

local COLOURS = { "#E63946", "#457B9D", "#F4A261", "#2A9D8F", "#E9C46A", "#6D597A", "#F8F9FA", "#1D3557" }

local folder: Folder? = nil
local cars: { { Model: Model, Loop: number, Distance: number } } = {}
local loops = {}

local function buildLoops()
	loops = {}
	for _, points in ipairs(World.TrafficLoops) do
		local list = {}
		for _, p in ipairs(points) do
			table.insert(list, Vector3.new(p[1], 0.22, p[2]))
		end
		local lengths, total = {}, 0
		for i = 1, #list do
			local a, b = list[i], list[i % #list + 1]
			lengths[i] = (b - a).Magnitude
			total += lengths[i]
		end
		table.insert(loops, { Points = list, Lengths = lengths, Total = total })
	end
end

-- Position and heading `distance` studs along loop `index`.
function TrafficController.At(index: number, distance: number): CFrame
	local loop = loops[index]
	local d = distance % loop.Total
	for i, length in ipairs(loop.Lengths) do
		if d <= length then
			local a, b = loop.Points[i], loop.Points[i % #loop.Points + 1]
			local position = a:Lerp(b, d / math.max(length, 0.001))
			return CFrame.lookAt(position, position + (b - a).Unit)
		end
		d -= length
	end
	return CFrame.new(loop.Points[1])
end

local function part(model: Model, name: string, size: Vector3, offset: CFrame, colour: Color3, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = offset
	p.Color = colour
	p.Material = material or Enum.Material.SmoothPlastic
	p.Parent = model
	return p
end

local function makeCar(i: number): Model
	local model = Instance.new("Model")
	model.Name = "Car" .. i
	local body = part(model, "Body", Vector3.new(4.6, 2, 9), CFrame.new(0, 1.9, 0), Color3.fromHex(COLOURS[(i - 1) % #COLOURS + 1]))
	part(model, "Cabin", Vector3.new(4, 1.8, 5), CFrame.new(0, 3.8, 0.5), Color3.fromHex("#BFE3F7"), Enum.Material.Glass)
	for _, w in ipairs({ { -2.3, 2.9 }, { 2.3, 2.9 }, { -2.3, -2.9 }, { 2.3, -2.9 } }) do
		local wheel = part(model, "Wheel", Vector3.new(0.8, 2, 2), CFrame.new(w[1], 1, w[2]), Color3.fromHex("#1E1E1E"))
		wheel.Shape = Enum.PartType.Cylinder
	end
	model.PrimaryPart = body
	model.Parent = folder
	return model
end

function TrafficController.Build()
	if folder then
		folder:Destroy()
	end
	local f = Instance.new("Folder")
	f.Name = "CYL_Traffic"
	f.Parent = workspace
	folder = f
	cars = {}
	buildLoops()
	local count = if GraphicsController.IsLow() then TrafficController.LowCount else TrafficController.HighCount
	for i = 1, count do
		local loopIndex = (i - 1) % #loops + 1
		local car = { Model = makeCar(i), Loop = loopIndex, Distance = (i * 137) % loops[loopIndex].Total }
		car.Model:PivotTo(TrafficController.At(car.Loop, car.Distance))
		table.insert(cars, car)
	end
	TrafficController.SetVisible(ExploreController.IsExploring())
end

function TrafficController.Cars()
	return cars
end

function TrafficController.SetVisible(visible: boolean)
	if folder then
		folder.Parent = if visible then workspace else nil
	end
end

function TrafficController.Step(dt: number)
	for _, car in ipairs(cars) do
		car.Distance += TrafficController.Speed * dt
		car.Model:PivotTo(TrafficController.At(car.Loop, car.Distance))
	end
end

function TrafficController.Init() end

function TrafficController.Start()
	TrafficController.Build()
	GraphicsController.Changed:Connect(TrafficController.Build)
	ExploreController.Changed:Connect(TrafficController.SetVisible)
	RunService.Heartbeat:Connect(function(dt)
		if ExploreController.IsExploring() then
			TrafficController.Step(dt)
		end
	end)
end

return TrafficController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="144">
            <Properties>
              <string name="Name">TutorialController</string>
              <string name="Source"><![CDATA[--[[
	TutorialController  (StarterPlayerScripts.Client.Controllers.TutorialController)
	A short tutorial for new players: friendly tips that appear at the right
	moment (not pop-ups that block the game). Each has "Got it" and "Skip
	tutorial". Progress is saved (Tutorial.Step / Completed) so tips show
	once; Help → "Replay the tutorial" starts again.
	  1 menu (no lives yet)   press Play
	  2 first decision        pick a card, confirm; arrows and locks
	  3 first outcome         stats change; Continue
	  4 later decision        your 2 actions: People, Lifestyle, Lifeville
	  5 first exploring       walk, E / tap prompts, Next decision
	  6 second life stage     Life Reveal, Achievements, Daily reward
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Util.Signal)

local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Anim = require(UILib.Anim)
local Components = require(UILib.Components)

local DataController = require(script.Parent.DataController)
local UIController = require(script.Parent.UIController)

local TutorialController = {}
TutorialController.Priority = 68
TutorialController.Shown = Signal.new() -- (step)

TutorialController.Steps = {
	{ Title = "👋 Welcome to CHOOSE YOUR LIFE!", Text = "Every choice shapes your future. Press ▶ Play to begin your first life." },
	{ Title = "Make your first choice", Text = "Tap a card, then tap it again (or Confirm). The ▲▼ arrows hint at what a choice might change, 🎲 means it's risky, and 🔒 cards hint at hidden paths." },
	{ Title = "Your stats changed!", Text = "Every choice nudges your 8 stats and can open or close future paths. Press Continue to move on through the years." },
	{ Title = "Between decisions", Text = "You get 2 actions before each decision: spend time with 👥 People, set your 🎯 Lifestyle, or press 🌆 to explore Lifeville." },
	{ Title = "Exploring Lifeville", Text = "Walk with WASD, the thumbstick or a gamepad. Press E (or tap) near glowing prompts to do things or talk to people. 📝 Next decision takes you back." },
	{ Title = "You saw your first Life Reveal", Text = "Your predicted futures change with every choice you make. Check 🏆 Achievements and 🎁 Daily Reward in the menu, too. Enjoy your life!" },
}

local bubble: CanvasGroup? = nil
local showing: number? = nil
local localStep = 0
local localDone = false

local function tutorial()
	local data = DataController.Get()
	return data and data.Tutorial or { Completed = true, Step = 0 }
end

function TutorialController.Active(): boolean
	local t = tutorial()
	return not (t.Completed or localDone)
end

function TutorialController.Showing(): number?
	return showing
end

local function hide()
	if bubble then
		local b = bubble
		bubble = nil
		Anim.Fade(b, false, 0.2)
		task.delay(0.25, function()
			b:Destroy()
		end)
	end
	showing = nil
end

local function done(step: number)
	localStep = math.max(localStep, step)
	task.spawn(Net.Invoke, "TutorialStep", step)
	if step >= #TutorialController.Steps then
		localDone = true
		task.spawn(Net.Invoke, "TutorialStep", "Done")
	end
end

function TutorialController.Skip()
	hide()
	localDone = true
	task.spawn(Net.Invoke, "TutorialStep", "Done")
end

-- Shows tip `step` if it's the next one and the tutorial is on.
function TutorialController.Show(step: number)
	if not TutorialController.Active() or showing == step then
		return false
	end
	local reached = math.max(tutorial().Step or 0, localStep)
	if step ~= reached + 1 then
		return false
	end
	hide()
	local def = TutorialController.Steps[step]
	local narrow = UIController.IsNarrow()
	local width = math.min(460, UIController.GetVirtualSize().X - 24)
	local card = Create("CanvasGroup", {
		Name = "TutorialTip",
		BackgroundColor3 = Theme.Color.SurfaceHigher,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = if narrow then UDim2.new(0.5, 0, 1, -150) else UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.fromOffset(width, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		ZIndex = 35,
		Parent = UIController.GetOverlay(),
	}, { Create.Corner(Theme.Radius), Create.Stroke(Theme.Color.Gold, 2, 0), Create.Padding(14, 16) })
	Create.List(Enum.FillDirection.Vertical, 8).Parent = card
	Create.Label({ Name = "Title", Text = def.Title, FontFace = Theme.Font.Heavy, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.fromScale(1, 0), LayoutOrder = 1, Parent = card })
	Create.Label({ Name = "Text", Text = def.Text, TextSize = Theme.TextSize.Small, TextColor3 = Theme.Color.TextDim, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.fromScale(1, 0), LayoutOrder = 2, Parent = card })
	local row = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 3, Parent = card })
	Create.List(Enum.FillDirection.Horizontal, 8).Parent = row
	Components.Button({ Name = "GotIt", Text = "Got it", Style = "Primary", Size = UDim2.fromOffset(140, 42), TextSize = 17, LayoutOrder = 1, Parent = row, OnClick = function()
		hide()
		done(step)
	end })
	Components.Button({ Name = "SkipTutorial", Text = "Skip tutorial", Style = "Ghost", Size = UDim2.fromOffset(160, 42), TextSize = 16, LayoutOrder = 2, Parent = row, OnClick = TutorialController.Skip })
	Create.Label({ Name = "Count", Text = ("Tip %d of %d"):format(step, #TutorialController.Steps), TextSize = Theme.TextSize.Tiny, TextColor3 = Theme.Color.TextFaint, Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 4, Parent = card })
	Anim.Fade(card, true, 0.25)
	bubble = card
	showing = step
	TutorialController.Shown:Fire(step)
	return true
end

function TutorialController.Restart()
	localStep = 0
	localDone = false
	task.spawn(Net.Invoke, "TutorialStep", "Reset")
	UIController.Show("Menu")
	task.delay(0.5, function()
		TutorialController.Show(1)
	end)
end

-- Offers tip `target`: earlier tips the player has moved past count as done.
function TutorialController.Offer(target: number)
	local reached = math.max(tutorial().Step or 0, localStep)
	if target <= reached or showing == target then
		return
	end
	if showing and showing < target then
		hide()
	end
	if target - 1 > reached then
		done(target - 1)
	end
	TutorialController.Show(target)
end

-- Works out which tip fits what's on screen right now.
function TutorialController.Check()
	if not TutorialController.Active() then
		hide()
		return
	end
	local data = DataController.Get()
	if not data then
		return
	end
	local screen = UIController.Current()
	local life = DataController.GetActiveLife()
	local mode = require(script.Parent.DecisionController).GetMode()
	if screen == "Menu" and (not life or life.Completed) and #data.LifeHistory == 0 then
		TutorialController.Offer(1)
	elseif screen == "Game" and life and not life.Completed then
		if life.Stage >= 2 then
			TutorialController.Offer(6)
		elseif mode == "Scenario" and #life.Decisions == 0 then
			TutorialController.Offer(2)
		elseif mode == "Outcome" then
			TutorialController.Offer(3)
		elseif mode == "Scenario" then
			TutorialController.Offer(4)
		end
	elseif screen == "Explore" then
		TutorialController.Offer(5)
	end
end

function TutorialController.Init() end

function TutorialController.Start()
	UIController.ScreenChanged:Connect(function()
		task.delay(0.6, TutorialController.Check)
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			pcall(TutorialController.Check)
		end
	end)
end

return TutorialController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="145">
            <Properties>
              <string name="Name">UIController</string>
              <string name="Source"><![CDATA[--[[
	UIController  (StarterPlayerScripts.Client.Controllers.UIController)
	Owns the ScreenGuis, responsive scaling, the screen router and modals.

	Responsive scaling: all UI is designed in "virtual pixels". We pick a design
	resolution for the device shape (landscape / phone-landscape / portrait),
	compute scale = min(screen / design) × the player's UI Scale setting, and
	apply it with a UIScale. Root frames are sized in virtual pixels, so text
	and touch targets stay readable on phones and crisp on 4K monitors.

	Screens:
	  local frame = UIController.NewScreen("Menu", { Back = nil, OnOpen = fn, OnClose = fn, Backdrop = true })
	  UIController.Show("Menu", ...)      -- fades the old screen out, new one in
	  UIController.Back()                 -- previous screen (gamepad B does this)
	  UIController.Confirm({ Title, Text, ConfirmText, CancelText, Danger }) -> boolean (yields)
	Layout:
	  UIController.GetVirtualSize() -> Vector2,  UIController.IsNarrow() -> boolean
	  UIController.LayoutChanged:Connect(fn(virtualSize, isNarrow))
]]

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Signal = require(ReplicatedStorage:WaitForChild("Shared").Util.Signal)
local UILib = script.Parent.Parent:WaitForChild("UILib")
local Theme = require(UILib.Theme)
local Create = require(UILib.Create)
local Anim = require(UILib.Anim)
local Components = require(UILib.Components)

local UIController = {}
UIController.Priority = 1

UIController.LayoutChanged = Signal.new()
UIController.ScreenChanged = Signal.new()

local mainGui: ScreenGui
local overlayGui: ScreenGui
local backdropGui: ScreenGui
local root: Frame
local overlay: Frame
local backdrop: Frame
local scales: { UIScale } = {}

local userScale = 1
local currentScale = 1
local virtualSize = Theme.DesignLandscape
local narrow = false

local screens: { [string]: any } = {}
local current: string? = nil
local history: { string } = {}
local modalOpen = false
local navigatingBack = false

-- ===== Scaling =====
local function computeLayout()
	local absolute = mainGui.AbsoluteSize
	if absolute.X < 2 or absolute.Y < 2 then
		return
	end
	local design
	if absolute.Y > absolute.X then
		design = Theme.DesignPortrait
	elseif absolute.Y < 500 then
		design = Theme.DesignCompact
	else
		design = Theme.DesignLandscape
	end
	local scale = math.min(absolute.X / design.X, absolute.Y / design.Y) * userScale
	scale = math.clamp(scale, 0.4, 3)
	currentScale = scale
	virtualSize = Vector2.new(math.floor(absolute.X / scale), math.floor(absolute.Y / scale))
	narrow = virtualSize.X < Theme.NarrowWidth

	for _, s in ipairs(scales) do
		s.Scale = scale
	end
	root.Size = UDim2.fromOffset(virtualSize.X, virtualSize.Y)
	overlay.Size = UDim2.fromOffset(virtualSize.X, virtualSize.Y)
	UIController.LayoutChanged:Fire(virtualSize, narrow)
end

function UIController.GetVirtualSize(): Vector2
	return virtualSize
end

-- The UIScale currently applied to virtual-pixel layouts.
function UIController.GetScale(): number
	return currentScale
end

function UIController.IsNarrow(): boolean
	return narrow
end

function UIController.SetUserScale(value: number)
	userScale = math.clamp(value, 0.75, 1.25)
	if mainGui then
		computeLayout()
	end
end

function UIController.GetRoot()
	return root
end

function UIController.GetOverlay()
	return overlay
end

function UIController.UsingGamepad(): boolean
	local last = UserInputService:GetLastInputType()
	return UserInputService.GamepadEnabled and (last.Name:find("Gamepad") ~= nil)
end

-- Moves gamepad selection to `target` when a gamepad is in use.
function UIController.Focus(target: GuiObject?)
	if target and UIController.UsingGamepad() then
		GuiService.SelectedObject = target
	end
end

-- ===== Screens =====
function UIController.NewScreen(name: string, options: { [string]: any }?)
	options = options or {}
	local frame = Create("CanvasGroup", {
		Name = name,
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		GroupTransparency = 1,
		Parent = root,
	})
	screens[name] = {
		Frame = frame,
		Back = options.Back,
		OnOpen = options.OnOpen,
		OnClose = options.OnClose,
		Backdrop = options.Backdrop ~= false,
		DefaultFocus = options.DefaultFocus,
	}
	return frame
end

function UIController.SetScreenOptions(name: string, options: { [string]: any })
	local screen = screens[name]
	for key, value in pairs(options) do
		screen[key] = value
	end
end

function UIController.HasScreen(name: string): boolean
	return screens[name] ~= nil
end

function UIController.Current(): string?
	return current
end

function UIController.Show(name: string, ...)
	local screen = screens[name]
	assert(screen, "UIController.Show: unknown screen " .. name)
	if current == name then
		if screen.OnOpen then
			task.spawn(screen.OnOpen, ...)
		end
		return
	end
	local previous = current and screens[current]
	if previous then
		Anim.Fade(previous.Frame, false, 0.18)
		if previous.OnClose then
			task.spawn(previous.OnClose)
		end
		if not navigatingBack then
			table.insert(history, current :: string)
			if #history > 20 then
				table.remove(history, 1)
			end
		end
	end
	current = name
	backdrop.Visible = screen.Backdrop
	Anim.Fade(screen.Frame, true, 0.28)
	if screen.OnOpen then
		task.spawn(screen.OnOpen, ...)
	end
	task.defer(function()
		if current == name and screen.DefaultFocus then
			UIController.Focus(screen.DefaultFocus())
		end
	end)
	UIController.ScreenChanged:Fire(name)
end

-- Goes to the screen's declared Back target: a screen name, or `true` for
-- "wherever I came from". History is trimmed so it always reflects the path.
function UIController.Back()
	if modalOpen or not current then
		return
	end
	local screen = screens[current]
	local target = if screen.Back == true then history[#history] else screen.Back
	if not target or not screens[target] then
		return
	end
	for i = #history, 1, -1 do
		if history[i] == target then
			for j = #history, i, -1 do
				history[j] = nil
			end
			break
		end
	end
	navigatingBack = true
	UIController.Show(target)
	navigatingBack = false
end

-- ===== Modals =====
function UIController.Confirm(options: { [string]: any }): boolean
	if modalOpen then
		return false
	end
	modalOpen = true
	local result = nil
	local previousSelection = GuiService.SelectedObject

	local dim = Create("CanvasGroup", {
		Name = "ConfirmModal",
		BackgroundColor3 = Theme.Color.Black,
		BackgroundTransparency = 0.35,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 50,
		Parent = overlay,
	})
	local width = math.min(520, virtualSize.X - 40)
	local panel = Components.Panel({
		Size = UDim2.fromOffset(width, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Color = Theme.Color.Surface,
		Padding = 24,
		Parent = dim,
	})
	Create.List(Enum.FillDirection.Vertical, 14, Enum.HorizontalAlignment.Center).Parent = panel
	Create.Label({
		Text = options.Title or "Are you sure?",
		FontFace = Theme.Font.Heavy,
		TextSize = Theme.TextSize.H2,
		TextXAlignment = Enum.TextXAlignment.Center,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 1,
		Parent = panel,
	})
	Create.Label({
		Text = options.Text or "",
		TextColor3 = Theme.Color.TextDim,
		TextXAlignment = Enum.TextXAlignment.Center,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		Parent = panel,
	})
	local row = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 56), LayoutOrder = 3, Parent = panel })
	Create.List(Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Center).Parent = row
	local buttonWidth = math.floor((width - 48 - 12) / 2)
	local cancel = Components.Button({
		Text = options.CancelText or "Cancel",
		Style = "Secondary",
		Size = UDim2.fromOffset(buttonWidth, 54),
		LayoutOrder = 1,
		Parent = row,
		OnClick = function()
			result = false
		end,
	})
	Components.Button({
		Text = options.ConfirmText or "Confirm",
		Style = if options.Danger then "Danger" else "Primary",
		Size = UDim2.fromOffset(buttonWidth, 54),
		LayoutOrder = 2,
		Parent = row,
		OnClick = function()
			result = true
		end,
	})
	Anim.Fade(dim, true, 0.2)
	Anim.Pop(panel, 0.9)
	UIController.Focus(cancel)
	UIController._modalCancel = function()
		result = false
	end

	while result == nil do
		task.wait()
	end
	UIController._modalCancel = nil
	modalOpen = false
	Anim.Fade(dim, false, 0.15)
	task.delay(0.3, function()
		dim:Destroy()
	end)
	if previousSelection and previousSelection.Parent then
		UIController.Focus(previousSelection)
	end
	return result
end

function UIController.IsModalOpen(): boolean
	return modalOpen
end

--[[
	Panel modal used by the HUD panels (People, Lifestyle, Money, Stats).
	Only one is open at a time. Returns a handle:
	  { Root, Panel, Scroll, Close(), IsOpen() }
	Closes on ✕, on tapping outside, and on gamepad B.
]]
local currentPanel = nil
function UIController.ClosePanel()
	if currentPanel then
		local handle = currentPanel
		currentPanel = nil
		ContextActionService:UnbindAction("CYL_ClosePanel")
		Anim.Fade(handle.Root, false, 0.15)
		task.delay(0.25, function()
			handle.Root:Destroy()
		end)
		if handle.OnClose then
			task.spawn(handle.OnClose)
		end
	end
end

function UIController.OpenPanel(options: { [string]: any })
	UIController.ClosePanel()
	local modalRoot = Create("CanvasGroup", { Name = options.Name or "PanelModal", BackgroundColor3 = Theme.Color.Black, BackgroundTransparency = 0.35, Size = UDim2.fromScale(1, 1), ZIndex = 30, Parent = overlay })
	local closer = Create("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Selectable = false, Parent = modalRoot })
	closer.Activated:Connect(UIController.ClosePanel)
	local width = math.min(options.Width or 820, virtualSize.X - 24)
	local height = math.min(options.Height or 660, virtualSize.Y - 24)
	local panel = Components.Panel({ Name = "Panel", Size = UDim2.fromOffset(width, height), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Padding = 20, Parent = modalRoot })
	Create.Label({ Name = "Title", Text = options.Title or "", FontFace = Theme.Font.Heavy, TextSize = Theme.TextSize.H2, Size = UDim2.new(1, -60, 0, 36), TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = panel })
	local subtitle = Create.Label({ Name = "Subtitle", Text = options.Subtitle or "", TextColor3 = Theme.Color.TextDim, TextSize = Theme.TextSize.Small, Position = UDim2.fromOffset(0, 38), Size = UDim2.new(1, -60, 0, 22), TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false, Parent = panel })
	local close = Components.Button({ Name = "Close", Text = "✕", Style = "Secondary", Size = UDim2.fromOffset(48, 48), AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Parent = panel, OnClick = UIController.ClosePanel })
	local scroll = Create("ScrollingFrame", {
		Name = "Scroll",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 72),
		Size = UDim2.new(1, 0, 1, -72),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Color.Stroke,
		Selectable = false,
		Parent = panel,
	})
	Create.List(Enum.FillDirection.Vertical, 12).Parent = scroll
	Create.Padding(4, 10, 14, 4).Parent = scroll

	local handle = { Root = modalRoot, Panel = panel, Scroll = scroll, Subtitle = subtitle, Close = UIController.ClosePanel, OnClose = options.OnClose }
	function handle.IsOpen()
		return currentPanel == handle
	end
	-- Rebuilds the scrolling contents (keeps scroll position).
	function handle.Clear()
		Create.Clear(scroll)
	end
	currentPanel = handle
	Anim.Fade(modalRoot, true, 0.2)
	Anim.Pop(panel, 0.94)
	UIController.Focus(close)
	ContextActionService:BindActionAtPriority("CYL_ClosePanel", function(_, state)
		if state == Enum.UserInputState.Begin then
			UIController.ClosePanel()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonB)
	return handle
end

function UIController.CurrentPanel()
	return currentPanel
end

-- ===== Backdrop: gradient + slowly drifting soft circles =====
local function buildBackdrop()
	backdrop = Create("Frame", {
		Name = "Backdrop",
		BackgroundColor3 = Theme.Color.White,
		Size = UDim2.fromScale(1, 1),
		BorderSizePixel = 0,
		Parent = backdropGui,
	}, { Create.Gradient(Theme.Gradient.Backdrop, 120) })
	local gradient = backdrop:FindFirstChildOfClass("UIGradient")
	if gradient then
		Anim.Loop(gradient, { Rotation = 160 }, 12)
	end
	local orbColors = { Theme.Color.Primary, Theme.Color.Accent, Theme.Color.AccentAlt, Theme.Color.PrimaryAlt }
	local rng = Random.new(7)
	for i = 1, 6 do
		local size = rng:NextInteger(180, 420)
		local orb = Create("Frame", {
			Name = "Orb" .. i,
			BackgroundColor3 = orbColors[(i - 1) % #orbColors + 1],
			BackgroundTransparency = 0.86,
			Size = UDim2.fromOffset(size, size),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(rng:NextNumber(0.05, 0.95), rng:NextNumber(0.05, 0.95)),
			Parent = backdrop,
		}, { Create.Corner(Theme.RadiusPill) })
		orb:SetAttribute("Decor", true)
		local target = orb.Position + UDim2.fromScale(rng:NextNumber(-0.08, 0.08), rng:NextNumber(-0.08, 0.08))
		Anim.Loop(orb, { Position = target }, rng:NextNumber(9, 16))
	end
end

-- Menu theme from the shop (Backdrop items). nil restores the default.
function UIController.SetBackdropColors(top: Color3?, bottom: Color3?)
	if not backdrop then
		return
	end
	local gradient = backdrop:FindFirstChildOfClass("UIGradient")
	if gradient then
		gradient.Color = if top and bottom then ColorSequence.new(top, bottom) else Theme.Gradient.Backdrop
	end
end

-- Hides the menus and their backdrop so the 3D world shows through
-- (the Life Reveal's flyover of real places in Lifeville).
function UIController.SetWorldView(on: boolean)
	if backdropGui then
		backdropGui.Enabled = not on
	end
	if mainGui then
		mainGui.Enabled = not on
	end
end

function UIController.SetDecorations(enabled: boolean)
	if not backdrop then
		return
	end
	for _, child in ipairs(backdrop:GetChildren()) do
		if child:GetAttribute("Decor") then
			(child :: GuiObject).Visible = enabled
		end
	end
end

-- ===== Lifecycle =====
function UIController.Init()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

	backdropGui = Create("ScreenGui", {
		Name = "CYL_Backdrop",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ScreenInsets = Enum.ScreenInsets.None,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 1,
		Parent = playerGui,
	})
	mainGui = Create("ScreenGui", {
		Name = "CYL_Main",
		ResetOnSpawn = false,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 5,
		Parent = playerGui,
	})
	overlayGui = Create("ScreenGui", {
		Name = "CYL_Overlay",
		ResetOnSpawn = false,
		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 20,
		Parent = playerGui,
	})

	root = Create("Frame", { Name = "Root", BackgroundTransparency = 1, Parent = mainGui })
	overlay = Create("Frame", { Name = "Root", BackgroundTransparency = 1, Parent = overlayGui })
	for _, container in ipairs({ root, overlay }) do
		local s = Instance.new("UIScale")
		s.Parent = container
		table.insert(scales, s)
	end
	buildBackdrop()

	mainGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(computeLayout)
	computeLayout()

	-- Gamepad B goes back; modals treat it as Cancel.
	ContextActionService:BindAction("CYL_Back", function(_, state)
		if state ~= Enum.UserInputState.Begin then
			return Enum.ContextActionResult.Pass
		end
		if modalOpen and UIController._modalCancel then
			UIController._modalCancel()
			return Enum.ContextActionResult.Sink
		end
		if current and screens[current].Back then
			UIController.Back()
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.ButtonB)
end

function UIController.Start() end

return UIController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="146">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[--[[
	Main  (StarterPlayerScripts.Client.Main)  — LocalScript
	Client bootstrap: same Init/Start lifecycle as the server, using the
	ModuleScripts in Client.Controllers. (Client.UILib holds shared UI
	building blocks; it is required by controllers, not auto-started.)
]]

local controllers = {}

local function collect(folder: Instance?)
	if not folder then
		return
	end
	for _, module in ipairs(folder:GetChildren()) do
		if module:IsA("ModuleScript") then
			local ok, controller = pcall(require, module)
			if ok and type(controller) == "table" then
				controller.Name = controller.Name or module.Name
				table.insert(controllers, controller)
			else
				warn("[Client] Failed to load " .. module.Name .. ": " .. tostring(controller))
			end
		end
	end
end

collect(script.Parent:WaitForChild("Controllers"))

table.sort(controllers, function(a, b)
	return (a.Priority or 100) < (b.Priority or 100)
end)

for _, controller in ipairs(controllers) do
	if controller.Init then
		local ok, err = pcall(controller.Init)
		if not ok then
			warn("[Client] " .. controller.Name .. ".Init failed: " .. tostring(err))
		end
	end
end

for _, controller in ipairs(controllers) do
	if controller.Start then
		task.spawn(function()
			local ok, err = pcall(controller.Start)
			if not ok then
				warn("[Client] " .. controller.Name .. ".Start failed: " .. tostring(err))
			end
		end)
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="147">
          <Properties>
            <string name="Name">UILib</string>
          </Properties>
          <Item class="ModuleScript" referent="148">
            <Properties>
              <string name="Name">Anim</string>
              <string name="Source"><![CDATA[--[[
	Anim  (StarterPlayerScripts.Client.UILib.Anim)
	Tween helpers that respect the "Reduce animations" setting: when reduced,
	properties are set instantly and looping/decorative motion is skipped.
]]

local TweenService = game:GetService("TweenService")

local Anim = {}
Anim.Reduced = false

local fadeTokens = setmetatable({}, { __mode = "k" })

function Anim.Tween(inst: Instance, props: { [string]: any }, time: number?, style: Enum.EasingStyle?, direction: Enum.EasingDirection?)
	if Anim.Reduced or time == 0 then
		for key, value in pairs(props) do
			(inst :: any)[key] = value
		end
		return nil
	end
	local tween = TweenService:Create(inst, TweenInfo.new(time or 0.25, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out), props)
	tween:Play()
	return tween
end

function Anim.Await(tween)
	if tween and tween.PlaybackState ~= Enum.PlaybackState.Completed then
		tween.Completed:Wait()
	end
end

-- A UIScale named "AnimScale" used for pop/press effects without touching Size.
function Anim.Scale(inst: Instance): UIScale
	local scale = inst:FindFirstChild("AnimScale")
	if not scale then
		scale = Instance.new("UIScale")
		scale.Name = "AnimScale"
		scale.Parent = inst
	end
	return scale :: UIScale
end

function Anim.Pop(inst: Instance, from: number?, time: number?)
	local scale = Anim.Scale(inst)
	if Anim.Reduced then
		scale.Scale = 1
		return nil
	end
	scale.Scale = from or 0.85
	return Anim.Tween(scale, { Scale = 1 }, time or 0.35, Enum.EasingStyle.Back)
end

-- Fades a CanvasGroup in/out and toggles Visible. Safe to call repeatedly.
function Anim.Fade(group: CanvasGroup, visible: boolean, time: number?)
	local token = (fadeTokens[group] or 0) + 1
	fadeTokens[group] = token
	if visible then
		group.Visible = true
		if not Anim.Reduced then
			group.GroupTransparency = 1
		end
		return Anim.Tween(group, { GroupTransparency = 0 }, time or 0.25)
	end
	local tween = Anim.Tween(group, { GroupTransparency = 1 }, time or 0.2)
	if tween then
		tween.Completed:Connect(function()
			if fadeTokens[group] == token then
				group.Visible = false
			end
		end)
	else
		group.Visible = false
	end
	return tween
end

-- Small wobble (rotation, so it also works inside layouts), e.g. for a locked choice.
function Anim.Shake(inst: GuiObject)
	if Anim.Reduced then
		return
	end
	task.spawn(function()
		for _, angle in ipairs({ 3, -3, 2, -2, 1, 0 }) do
			Anim.Tween(inst, { Rotation = angle }, 0.05, Enum.EasingStyle.Linear)
			task.wait(0.05)
		end
		inst.Rotation = 0
	end)
end

--[[
	Repeating back-and-forth tween for ambient motion (skipped when reduced).
	Returns a stop() function.
]]
function Anim.Loop(inst: Instance, props: { [string]: any }, time: number)
	if Anim.Reduced then
		return function() end
	end
	local tween = TweenService:Create(inst, TweenInfo.new(time, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), props)
	tween:Play()
	return function()
		tween:Cancel()
	end
end

return Anim
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="149">
            <Properties>
              <string name="Name">Avatar</string>
              <string name="Source"><![CDATA[--[[
	Avatar  (StarterPlayerScripts.Client.UILib.Avatar)
	Draws a player's look from a Style (Shared/Util/Style): a big face with
	accessory, outfit and pet badges, and a name with name colour + title.

	Avatar.Badge({ Style, Size?, Parent?, LayoutOrder?, Name? }) -> Frame
	Avatar.NameRich(name, style) -> RichText string (coloured name)
	Avatar.Line(name, style) -> "🧑‍🦱 Name" with name colour, for one-line labels
]]

local Theme = require(script.Parent.Theme)
local Create = require(script.Parent.Create)

local Avatar = {}

function Avatar.Badge(p)
	local style = p.Style or {}
	local size = p.Size or 72
	local frame = Create("Frame", {
		Name = p.Name or "Avatar",
		BackgroundColor3 = Theme.Color.SurfaceHigher,
		Size = UDim2.fromOffset(size, size),
		LayoutOrder = p.LayoutOrder or 0,
		Parent = p.Parent,
	}, { Create.Corner(Theme.RadiusPill), Create.Stroke(if style.NameColor then Color3.fromHex(style.NameColor) else Theme.Color.Stroke, 2, 0.1) })
	local function glyph(name, text, scale, anchor, position)
		if not text then
			return
		end
		Create.Label({
			Name = name,
			Text = text,
			TextScaled = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromOffset(size * scale, size * scale),
			AnchorPoint = anchor,
			Position = position,
			Parent = frame,
		})
	end
	glyph("Face", style.Face or "🧑", 0.66, Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5))
	glyph("Accessory", style.Accessory, 0.36, Vector2.new(1, 0), UDim2.fromScale(1.05, -0.05))
	glyph("Outfit", style.Outfit, 0.32, Vector2.new(1, 1), UDim2.fromScale(1.05, 1.05))
	glyph("Pet", style.Pet, 0.34, Vector2.new(0, 1), UDim2.fromScale(-0.08, 1.05))
	return frame
end

local function escape(text: string): string
	return (text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

function Avatar.NameRich(name: string, style): string
	local safe = escape(name)
	if style and style.NameColor then
		return ("<font color=\"%s\">%s</font>"):format(style.NameColor, safe)
	end
	return safe
end

function Avatar.Line(name: string, style): string
	return ((style and style.Face) or "🧑") .. " " .. Avatar.NameRich(name, style) .. (if style and style.Title then (" <font color=\"%s\">· %s</font>"):format(Theme.Hex.Gold, escape(style.Title)) else "")
end

return Avatar
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="150">
            <Properties>
              <string name="Name">Components</string>
              <string name="Source"><![CDATA[--[[
	Components  (StarterPlayerScripts.Client.UILib.Components)
	Reusable, themed widgets. Every interactive widget works with mouse,
	touch and gamepad (all are Selectable buttons; sliders also have −/+).

	Components.Button{ Text, Icon?, Style?, Size?, TextSize?, LayoutOrder?, Parent?, OnClick }
	Components.SetDisabled(button, disabled) / Components.SetText(button, text)
	Components.Panel{ Size?, Color?, Parent?, ... }
	Components.Slider{ Label, Min, Max, Step, Value, Format?, OnChanged, Parent?, LayoutOrder? } -> { Instance, Set }
	Components.Toggle{ Label, Value, OnChanged, Parent?, LayoutOrder? }                  -> { Instance, Set }
	Components.Selector{ Label, Options, Labels?, Value, OnChanged, Parent?, LayoutOrder? } -> { Instance, Set }
	Components.StatBar{ Name, Icon, Color, Value, Compact?, Parent?, LayoutOrder? }        -> { Instance, Set }
	Components.Chip{ Text, Color?, Parent?, LayoutOrder? }

	Components.OnClickSound: set by AudioController to play a click.
]]

local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Theme)
local Create = require(script.Parent.Create)
local Anim = require(script.Parent.Anim)

local Components = {}
Components.OnClickSound = nil :: (() -> ())?

local STYLES = {
	Primary = { Color = Theme.Color.White, Gradient = Theme.Gradient.Primary, Text = Theme.Color.White },
	Accent = { Color = Theme.Color.White, Gradient = Theme.Gradient.Accent, Text = Theme.Color.White },
	Positive = { Color = Theme.Color.White, Gradient = Theme.Gradient.Positive, Text = Theme.Color.White },
	Danger = { Color = Theme.Color.White, Gradient = Theme.Gradient.Danger, Text = Theme.Color.White },
	Secondary = { Color = Theme.Color.SurfaceHigh, Text = Theme.Color.Text, Stroke = true },
	Ghost = { Color = Theme.Color.Surface, Text = Theme.Color.TextDim, Stroke = true, Transparency = 0.35 },
}

-- ===== Button =====
function Components.Button(p)
	local style = STYLES[p.Style or "Primary"] or STYLES.Primary
	local button = Create("TextButton", {
		Name = p.Name or "Button",
		AutoButtonColor = false,
		Text = "",
		Size = p.Size or UDim2.fromOffset(280, 56),
		Position = p.Position or UDim2.new(),
		AnchorPoint = p.AnchorPoint or Vector2.zero,
		BackgroundColor3 = style.Color,
		BackgroundTransparency = style.Transparency or 0,
		LayoutOrder = p.LayoutOrder or 0,
		Selectable = true,
		Parent = p.Parent,
	}, {
		Create.Corner(p.Radius or Theme.RadiusSmall),
	})
	if style.Gradient then
		Create.Gradient(style.Gradient, 15).Parent = button
	end
	local stroke = Create.Stroke(if style.Stroke then Theme.Color.Stroke else Theme.Color.White, 1.5, if style.Stroke then 0.4 else 1)
	stroke.Parent = button

	local text = p.Text or ""
	Create.Label({
		Name = "Label",
		Text = if p.Icon then p.Icon .. "  " .. text else text,
		Size = UDim2.fromScale(1, 1),
		FontFace = Theme.Font.Bold,
		TextSize = p.TextSize or 22,
		TextColor3 = style.Text,
		TextXAlignment = p.TextXAlignment or Enum.TextXAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
		Parent = button,
	})
	if p.TextXAlignment == Enum.TextXAlignment.Left then
		Create.Padding(0, 18).Parent = button
	end

	local scale = Anim.Scale(button)
	local hovering = false
	button.MouseEnter:Connect(function()
		hovering = true
		if not button:GetAttribute("Disabled") then
			Anim.Tween(scale, { Scale = 1.03 }, 0.15)
		end
	end)
	button.MouseLeave:Connect(function()
		hovering = false
		Anim.Tween(scale, { Scale = 1 }, 0.15)
	end)
	button.InputBegan:Connect(function(input)
		if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and not button:GetAttribute("Disabled") then
			Anim.Tween(scale, { Scale = 0.96 }, 0.08)
		end
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			Anim.Tween(scale, { Scale = if hovering then 1.03 else 1 }, 0.12)
		end
	end)
	-- Gamepad selection highlight.
	button.SelectionGained:Connect(function()
		stroke.Color = Theme.Color.Gold
		stroke.Thickness = 3
		stroke.Transparency = 0
	end)
	button.SelectionLost:Connect(function()
		stroke.Color = if style.Stroke then Theme.Color.Stroke else Theme.Color.White
		stroke.Thickness = 1.5
		stroke.Transparency = if style.Stroke then 0.4 else 1
	end)

	button.Activated:Connect(function()
		if button:GetAttribute("Disabled") then
			return
		end
		if Components.OnClickSound then
			Components.OnClickSound()
		end
		if p.OnClick then
			p.OnClick(button)
		end
	end)
	return button
end

function Components.SetDisabled(button: GuiButton, disabled: boolean)
	button:SetAttribute("Disabled", disabled)
	button.BackgroundTransparency = if disabled then 0.6 else 0
	local label = button:FindFirstChild("Label")
	if label then
		(label :: TextLabel).TextTransparency = if disabled then 0.5 else 0
	end
end

function Components.SetText(button: GuiButton, text: string)
	local label = button:FindFirstChild("Label")
	if label then
		(label :: TextLabel).Text = text
	end
end

-- ===== Panel =====
function Components.Panel(p)
	local props = {
		Name = p.Name or "Panel",
		Size = p.Size or UDim2.fromScale(1, 1),
		Position = p.Position or UDim2.new(),
		AnchorPoint = p.AnchorPoint or Vector2.zero,
		BackgroundColor3 = p.Color or Theme.Color.Surface,
		BackgroundTransparency = p.Transparency or 0.05,
		LayoutOrder = p.LayoutOrder or 0,
		AutomaticSize = p.AutomaticSize or Enum.AutomaticSize.None,
		Parent = p.Parent,
	}
	local panel = Create("Frame", props, { Create.Corner(p.Radius), Create.Stroke() })
	if p.Padding then
		Create.Padding(p.Padding).Parent = panel
	end
	return panel
end

-- ===== Chip =====
function Components.Chip(p)
	local chip = Create("Frame", {
		Name = "Chip",
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, p.Height or 34),
		BackgroundColor3 = p.Color or Theme.Color.SurfaceHigh,
		BackgroundTransparency = p.Transparency or 0.1,
		LayoutOrder = p.LayoutOrder or 0,
		Parent = p.Parent,
	}, { Create.Corner(Theme.RadiusPill), Create.Padding(0, 14) })
	Create.Label({
		Name = "Label",
		Text = p.Text,
		RichText = true,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromScale(0, 1),
		TextWrapped = false,
		FontFace = Theme.Font.Bold,
		TextSize = p.TextSize or Theme.TextSize.Small,
		TextColor3 = p.TextColor or Theme.Color.Text,
		Parent = chip,
	})
	return chip
end

-- ===== Row helper for settings widgets =====
local function settingRow(p, height)
	local row = Create("Frame", {
		Name = p.Label or "Row",
		Size = UDim2.new(1, 0, 0, height),
		BackgroundColor3 = Theme.Color.SurfaceHigh,
		BackgroundTransparency = 0.2,
		LayoutOrder = p.LayoutOrder or 0,
		Parent = p.Parent,
	}, { Create.Corner(Theme.RadiusSmall), Create.Padding(10, 16) })
	Create.Label({
		Name = "Title",
		Text = p.Label,
		Size = UDim2.new(0.5, 0, 0, 28),
		FontFace = Theme.Font.Bold,
		TextSize = Theme.TextSize.Body,
		Parent = row,
	})
	return row
end

local function smallButton(text: string, onClick: () -> ())
	return Components.Button({ Text = text, Style = "Secondary", Size = UDim2.fromOffset(Theme.TouchTarget, Theme.TouchTarget - 8), TextSize = 22, OnClick = onClick })
end

-- ===== Slider =====
function Components.Slider(p)
	local min, max, step = p.Min, p.Max, p.Step or 0.05
	local value = p.Value
	local format = p.Format or function(v)
		return tostring(math.floor(v * 100 + 0.5)) .. "%"
	end
	local row = settingRow(p, 96)

	local valueLabel = Create.Label({
		Name = "Value",
		Size = UDim2.new(0.5, 0, 0, 28),
		Position = UDim2.fromScale(0.5, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Theme.Color.TextDim,
		FontFace = Theme.Font.Bold,
		Parent = row,
	})

	local controls = Create("Frame", {
		Name = "Controls",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, Theme.TouchTarget - 8),
		Position = UDim2.fromOffset(0, 34),
		Parent = row,
	})
	local minus = smallButton("−", function()
		Components._sliderNudge(p, -1)
	end)
	minus.Parent = controls
	local plus = smallButton("+", function()
		Components._sliderNudge(p, 1)
	end)
	plus.AnchorPoint = Vector2.new(1, 0)
	plus.Position = UDim2.fromScale(1, 0)
	plus.Parent = controls

	local track = Create("TextButton", {
		Name = "Track",
		Text = "",
		AutoButtonColor = false,
		Selectable = false,
		BackgroundColor3 = Theme.Color.Background,
		Size = UDim2.new(1, -(Theme.TouchTarget * 2 + 28), 0, 12),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Parent = controls,
	}, { Create.Corner(Theme.RadiusPill) })
	local fill = Create("Frame", {
		Name = "Fill",
		BackgroundColor3 = Theme.Color.White,
		Size = UDim2.fromScale(0, 1),
		Parent = track,
	}, { Create.Corner(Theme.RadiusPill), Create.Gradient(Theme.Gradient.Primary) })
	local knob = Create("Frame", {
		Name = "Knob",
		BackgroundColor3 = Theme.Color.White,
		Size = UDim2.fromOffset(26, 26),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Parent = track,
	}, { Create.Corner(Theme.RadiusPill) })

	local function render()
		local alpha = (value - min) / (max - min)
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.fromScale(alpha, 0.5)
		valueLabel.Text = format(value)
	end

	local function set(newValue: number, silent: boolean?)
		newValue = math.clamp(math.floor((newValue - min) / step + 0.5) * step + min, min, max)
		newValue = math.floor(newValue * 1000 + 0.5) / 1000
		if newValue == value then
			render()
			return
		end
		value = newValue
		render()
		if not silent and p.OnChanged then
			p.OnChanged(value)
		end
	end
	p._set = set
	p._get = function()
		return value
	end

	local dragging = false
	local function fromX(x: number)
		local alpha = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		set(min + alpha * (max - min))
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			fromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			fromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	render()
	return { Instance = row, Set = set, Get = p._get }
end

function Components._sliderNudge(p, direction: number)
	p._set(p._get() + direction * (p.Step or 0.05))
end

-- ===== Toggle =====
function Components.Toggle(p)
	local value = p.Value == true
	local row = settingRow(p, 60)
	local pill = Create("TextButton", {
		Name = "Switch",
		Text = "",
		AutoButtonColor = false,
		Selectable = true,
		Size = UDim2.fromOffset(72, 38),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		BackgroundColor3 = Theme.Color.Background,
		Parent = row,
	}, { Create.Corner(Theme.RadiusPill), Create.Stroke() })
	local knob = Create("Frame", {
		Name = "Knob",
		Size = UDim2.fromOffset(30, 30),
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundColor3 = Theme.Color.TextDim,
		Parent = pill,
	}, { Create.Corner(Theme.RadiusPill) })
	local stroke = pill:FindFirstChildOfClass("UIStroke")

	local function render(animate: boolean?)
		local props = { Position = if value then UDim2.new(1, -34, 0.5, 0) else UDim2.new(0, 4, 0.5, 0), BackgroundColor3 = if value then Theme.Color.White else Theme.Color.TextDim }
		if animate then
			Anim.Tween(knob, props, 0.18)
		else
			knob.Position = props.Position
			knob.BackgroundColor3 = props.BackgroundColor3
		end
		pill.BackgroundColor3 = if value then Theme.Color.Positive else Theme.Color.Background
	end
	local function set(newValue: boolean, silent: boolean?)
		value = newValue == true
		render(true)
		if not silent and p.OnChanged then
			p.OnChanged(value)
		end
	end
	pill.Activated:Connect(function()
		if Components.OnClickSound then
			Components.OnClickSound()
		end
		set(not value)
	end)
	pill.SelectionGained:Connect(function()
		if stroke then
			stroke.Color = Theme.Color.Gold
			stroke.Thickness = 3
		end
	end)
	pill.SelectionLost:Connect(function()
		if stroke then
			stroke.Color = Theme.Color.Stroke
			stroke.Thickness = 1.5
		end
	end)
	render(false)
	return { Instance = row, Set = set, Get = function()
		return value
	end }
end

-- ===== Selector (cycle through options) =====
function Components.Selector(p)
	local options = p.Options
	local labels = p.Labels or options
	local index = table.find(options, p.Value) or 1
	local row = settingRow(p, 60)
	local box = Create("Frame", {
		Name = "Box",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(250, Theme.TouchTarget - 8),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Parent = row,
	})
	local valueLabel = Create.Label({
		Name = "Value",
		Size = UDim2.new(1, -(Theme.TouchTarget * 2), 1, 0),
		Position = UDim2.fromOffset(Theme.TouchTarget, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		FontFace = Theme.Font.Bold,
		Parent = box,
	})
	local function render()
		valueLabel.Text = labels[index]
	end
	local function step(direction: number)
		index = (index - 1 + direction) % #options + 1
		render()
		if p.OnChanged then
			p.OnChanged(options[index])
		end
	end
	local left = smallButton("‹", function()
		step(-1)
	end)
	left.Parent = box
	local right = smallButton("›", function()
		step(1)
	end)
	right.AnchorPoint = Vector2.new(1, 0)
	right.Position = UDim2.fromScale(1, 0)
	right.Parent = box
	render()
	return {
		Instance = row,
		Set = function(v)
			index = table.find(options, v) or index
			render()
		end,
		Get = function()
			return options[index]
		end,
	}
end

-- ===== StatBar =====
function Components.StatBar(p)
	local compact = p.Compact == true
	local height = if compact then 34 else 58
	local frame = Create("Frame", {
		Name = p.Name,
		BackgroundTransparency = 1,
		Size = p.Size or UDim2.new(1, 0, 0, height),
		LayoutOrder = p.LayoutOrder or 0,
		Parent = p.Parent,
	})
	local title = Create.Label({
		Name = "Title",
		Text = p.Icon .. "  " .. p.DisplayName,
		Size = UDim2.new(1, -60, 0, if compact then 16 else 26),
		TextSize = if compact then Theme.TextSize.Tiny else Theme.TextSize.Body,
		FontFace = Theme.Font.Bold,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
		Parent = frame,
	})
	local valueLabel = Create.Label({
		Name = "Value",
		Size = UDim2.new(0, 60, 0, if compact then 16 else 26),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextSize = if compact then Theme.TextSize.Tiny else Theme.TextSize.Body,
		FontFace = Theme.Font.Heavy,
		TextColor3 = p.Color,
		Parent = frame,
	})
	if compact then
		title.Visible = p.ShowTitle ~= false
	end
	local track = Create("Frame", {
		Name = "Track",
		BackgroundColor3 = Theme.Color.Background,
		Size = UDim2.new(1, 0, 0, if compact then 8 else 14),
		Position = UDim2.new(0, 0, 1, if compact then -10 else -18),
		Parent = frame,
	}, { Create.Corner(Theme.RadiusPill) })
	local fill = Create("Frame", {
		Name = "Fill",
		BackgroundColor3 = p.Color,
		Size = UDim2.fromScale(0, 1),
		Parent = track,
	}, { Create.Corner(Theme.RadiusPill) })

	local current = nil
	local function set(value: number, animate: boolean?)
		value = math.clamp(value, 0, 100)
		valueLabel.Text = tostring(math.floor(value + 0.5))
		local size = UDim2.fromScale(value / 100, 1)
		if animate and current ~= nil then
			Anim.Tween(fill, { Size = size }, 0.6)
		else
			fill.Size = size
		end
		current = value
	end
	set(p.Value or 0, false)
	return { Instance = frame, Set = set }
end

-- ===== Progress bar =====
-- Components.ProgressBar({ Fraction 0..1, Color?, Text?, Size?, LayoutOrder?, Parent?, Name? })
function Components.ProgressBar(p)
	local track = Create("Frame", {
		Name = p.Name or "Progress",
		BackgroundColor3 = Theme.Color.Background,
		Size = p.Size or UDim2.new(1, 0, 0, 22),
		LayoutOrder = p.LayoutOrder or 0,
		Parent = p.Parent,
	}, { Create.Corner(Theme.RadiusPill) })
	Create("Frame", {
		Name = "Fill",
		BackgroundColor3 = p.Color or Theme.Color.Positive,
		Size = UDim2.fromScale(math.clamp(p.Fraction or 0, 0, 1), 1),
		Parent = track,
	}, { Create.Corner(Theme.RadiusPill) })
	if p.Text then
		Create.Label({
			Name = "Label",
			Text = p.Text,
			TextSize = Theme.TextSize.Tiny,
			FontFace = Theme.Font.Bold,
			TextXAlignment = Enum.TextXAlignment.Center,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 2,
			Parent = track,
		})
	end
	return track
end

return Components
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="151">
            <Properties>
              <string name="Name">Create</string>
              <string name="Source"><![CDATA[--[[
	Create  (StarterPlayerScripts.Client.UILib.Create)
	Small helpers for building UI from code.

	Create("Frame", { Size = ..., Parent = ... }, { childA, childB })
	Create.Corner(radius)   Create.Stroke(color, thickness, transparency)
	Create.Padding(all) / Create.Padding(top, right, bottom, left)
	Create.List(direction, padding, hAlign, vAlign)
	Create.Gradient(colorSequence, rotation)
	Create.Label(props)     TextLabel with the theme defaults applied
	Create.Clear(instance)  destroys all GuiObject children (keeps layouts if asked)
]]

local Theme = require(script.Parent.Theme)

local function new(className: string, props: { [string]: any }?, children: { Instance }?)
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for key, value in pairs(props) do
			if key == "Parent" then
				parent = value
			else
				(inst :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local Create = setmetatable({}, {
	__call = function(_, className, props, children)
		return new(className, props, children)
	end,
})

function Create.Corner(radius: UDim?)
	return new("UICorner", { CornerRadius = radius or Theme.Radius })
end

function Create.Stroke(color: Color3?, thickness: number?, transparency: number?)
	return new("UIStroke", {
		Color = color or Theme.Color.Stroke,
		Thickness = thickness or 1.5,
		Transparency = transparency or 0.35,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Create.Padding(top: number, right: number?, bottom: number?, left: number?)
	right = right or top
	bottom = bottom or top
	left = left or right
	return new("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingRight = UDim.new(0, right :: number),
		PaddingBottom = UDim.new(0, bottom :: number),
		PaddingLeft = UDim.new(0, left :: number),
	})
end

function Create.List(direction: Enum.FillDirection?, padding: number?, hAlign: Enum.HorizontalAlignment?, vAlign: Enum.VerticalAlignment?)
	return new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 10),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
	})
end

function Create.Gradient(sequence: ColorSequence, rotation: number?)
	return new("UIGradient", { Color = sequence, Rotation = rotation or 0 })
end

function Create.Label(props: { [string]: any })
	local defaults = {
		BackgroundTransparency = 1,
		FontFace = Theme.Font.Medium,
		TextSize = Theme.TextSize.Body,
		TextColor3 = Theme.Color.Text,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Size = UDim2.new(1, 0, 0, 28),
	}
	for key, value in pairs(props) do
		defaults[key] = value
	end
	return new("TextLabel", defaults)
end

-- Removes GuiObject children (layouts/corners/padding are kept unless `all`).
function Create.Clear(inst: Instance, all: boolean?)
	for _, child in ipairs(inst:GetChildren()) do
		if all or child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

return Create
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="152">
            <Properties>
              <string name="Name">Layout</string>
              <string name="Source"><![CDATA[--[[
	Layout  (StarterPlayerScripts.Client.UILib.Layout)
	Screen-level layout helpers shared by every menu.

	Layout.Header(parent, title, onBack?)     -> header frame (back button + title)
	Layout.Scroll(parent, props?)             -> ScrollingFrame with vertical list + auto canvas
	Layout.Column(parent, width, props?)      -> centred vertical column frame
]]

local Theme = require(script.Parent.Theme)
local Create = require(script.Parent.Create)
local Components = require(script.Parent.Components)

local Layout = {}

Layout.HeaderHeight = 72

function Layout.Header(parent: Instance, title: string, onBack: (() -> ())?)
	local header = Create("Frame", {
		Name = "Header",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 0, Layout.HeaderHeight),
		Parent = parent,
	}, { Create.Padding(12, 20) })
	local backButton
	if onBack then
		backButton = Components.Button({
			Name = "Back",
			Text = "‹  Back",
			Style = "Ghost",
			Size = UDim2.fromOffset(120, Theme.TouchTarget),
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0, 0.5),
			TextSize = 20,
			Parent = header,
			OnClick = onBack,
		})
	end
	Create.Label({
		Name = "Title",
		Text = title,
		FontFace = Theme.Font.Heavy,
		TextSize = Theme.TextSize.H1,
		TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.new(1, -280, 1, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		TextScaled = true,
		Parent = header,
	})
	local titleLabel = header:FindFirstChild("Title") :: TextLabel
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MaxTextSize = Theme.TextSize.H1
	constraint.MinTextSize = 18
	constraint.Parent = titleLabel
	return header, backButton
end

function Layout.Scroll(parent: Instance, props: { [string]: any }?)
	local defaults = {
		Name = "Scroll",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, -Layout.HeaderHeight),
		Position = UDim2.fromOffset(0, Layout.HeaderHeight),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Theme.Color.Stroke,
		Selectable = false,
		Parent = parent,
	}
	for key, value in pairs(props or {}) do
		defaults[key] = value
	end
	local scroll = Create("ScrollingFrame", defaults)
	Create.List(Enum.FillDirection.Vertical, 12, Enum.HorizontalAlignment.Center).Parent = scroll
	Create.Padding(8, 16, 24, 16).Parent = scroll
	return scroll
end

function Layout.Column(parent: Instance, width: number, props: { [string]: any }?)
	local defaults = {
		Name = "Column",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(width, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Parent = parent,
	}
	for key, value in pairs(props or {}) do
		defaults[key] = value
	end
	local column = Create("Frame", defaults)
	Create.List(Enum.FillDirection.Vertical, 12, Enum.HorizontalAlignment.Center).Parent = column
	return column
end

return Layout
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="153">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[--[[
	Theme  (StarterPlayerScripts.Client.UILib.Theme)
	One place for colours, fonts, sizes and the virtual design resolution, so
	every screen looks consistent.
]]

local Theme = {}

local FAMILY = "rbxasset://fonts/families/BuilderSans.json"
Theme.Font = {
	Regular = Font.new(FAMILY, Enum.FontWeight.Regular),
	Medium = Font.new(FAMILY, Enum.FontWeight.Medium),
	Bold = Font.new(FAMILY, Enum.FontWeight.Bold),
	Heavy = Font.new(FAMILY, Enum.FontWeight.ExtraBold),
}

Theme.Color = {
	Background = Color3.fromRGB(13, 14, 30),
	BackgroundAlt = Color3.fromRGB(34, 20, 58),
	Surface = Color3.fromRGB(27, 30, 56),
	SurfaceHigh = Color3.fromRGB(39, 43, 78),
	SurfaceHigher = Color3.fromRGB(52, 57, 100),
	Stroke = Color3.fromRGB(78, 84, 140),
	Text = Color3.fromRGB(246, 247, 255),
	TextDim = Color3.fromRGB(172, 177, 214),
	TextFaint = Color3.fromRGB(120, 126, 170),
	Primary = Color3.fromRGB(255, 90, 140),
	PrimaryAlt = Color3.fromRGB(255, 150, 90),
	Accent = Color3.fromRGB(108, 140, 255),
	AccentAlt = Color3.fromRGB(150, 100, 255),
	Positive = Color3.fromRGB(88, 220, 145),
	Negative = Color3.fromRGB(245, 90, 100),
	Warning = Color3.fromRGB(255, 196, 72),
	Gold = Color3.fromRGB(255, 212, 90),
	Black = Color3.fromRGB(0, 0, 0),
	White = Color3.fromRGB(255, 255, 255),
}

-- Hex strings for RichText <font color="">.
Theme.Hex = {
	Positive = "#58DC91",
	Negative = "#F55A64",
	Dim = "#ACB1D6",
	Gold = "#FFD45A",
}

Theme.TextSize = {
	Hero = 64,
	H1 = 40,
	H2 = 28,
	H3 = 23,
	Body = 20,
	Small = 17,
	Tiny = 14,
}

Theme.Radius = UDim.new(0, 16)
Theme.RadiusSmall = UDim.new(0, 10)
Theme.RadiusPill = UDim.new(1, 0)

Theme.Gradient = {
	Primary = ColorSequence.new(Color3.fromRGB(255, 90, 140), Color3.fromRGB(255, 150, 90)),
	Accent = ColorSequence.new(Color3.fromRGB(108, 140, 255), Color3.fromRGB(150, 100, 255)),
	Positive = ColorSequence.new(Color3.fromRGB(60, 200, 130), Color3.fromRGB(110, 230, 170)),
	Danger = ColorSequence.new(Color3.fromRGB(230, 70, 90), Color3.fromRGB(255, 120, 90)),
	Backdrop = ColorSequence.new(Color3.fromRGB(13, 14, 30), Color3.fromRGB(40, 20, 66)),
	Title = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 120, 170)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 200, 120)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(140, 170, 255)),
	}),
}

-- Virtual design resolutions. UIController picks one and scales the UI so
-- it fills the screen on every device.
Theme.DesignLandscape = Vector2.new(1280, 720)
Theme.DesignCompact = Vector2.new(960, 540) -- phones held sideways
Theme.DesignPortrait = Vector2.new(540, 960) -- phones held upright
Theme.NarrowWidth = 900 -- below this virtual width, layouts stack vertically

-- Minimum touch target in virtual pixels.
Theme.TouchTarget = 48

return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="154">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
