        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Scenarios</string>
            <string name="Source"><![CDATA[--[[
	Scenarios  (ServerScriptService.Server.Content.Scenarios)  — ModuleScript with children
	Collects every stage module in this folder into one pool, builds an Id
	index and validates all content at startup.

	Scenario fields:
	  Id (unique), Stage (1–6), Title, Description, Icon (emoji)
	  Choices    3–5 choices: { Id, Text, Description, Effects, Requires?, LockHint?, Mystery? }
	  Requires?  scenario only appears if this passes (see Lib/Conditions)
	  Once?      at most once per life
	  Priority?  highest-priority eligible scenario is always picked first
	  Weight?    base random weight (default 1)
	  Boost?     { Flags = { Flag = multiplier }, Traits = { Trait = multiplier } }

	Choice fields:
	  Requires + LockHint   choice is shown LOCKED with the hint unless Requires
	                        passes, which hints at hidden branches and encourages replays
	  Mystery = true        consequence preview hidden ("???")
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local StatDefinitions = require(Shared.Data.StatDefinitions)
local Traits = require(Shared.Data.Traits)
local Careers = require(Shared.Data.Careers)
local Assets = require(Shared.Data.Assets)
local People = require(Shared.Util.People)

local Scenarios = {}
Scenarios.All = {}
Scenarios.ById = {}
Scenarios.Issues = {}

local function issue(text)
	table.insert(Scenarios.Issues, text)
	warn("[Scenarios] " .. text)
end

local function validateEffects(where, effects, requires)
	if type(effects) ~= "table" then
		issue(where .. ": missing Effects")
		return
	end
	local function checkBlock(label, block)
		for stat, delta in pairs(block.Stats or {}) do
			if not StatDefinitions.IsValid(stat) then
				issue(label .. ": unknown stat " .. tostring(stat))
			elseif stat == "Wealth" then
				issue(label .. ": Wealth is derived from money; use Money instead")
			elseif type(delta) ~= "number" then
				issue(label .. ": non-number delta for " .. stat)
			end
		end
		for trait in pairs(block.Traits or {}) do
			if not Traits.IsValid(trait) then
				issue(label .. ": unknown trait " .. tostring(trait))
			end
		end
		if block.Career ~= nil and not Careers.IsValid(block.Career) then
			issue(label .. ": unknown career " .. tostring(block.Career))
		end
		if block.Education ~= nil and not Careers.EducationRank[block.Education] then
			issue(label .. ": unknown education " .. tostring(block.Education))
		end
		for _, list in ipairs({ block.Assets or {}, block.RemoveAssets or {} }) do
			for _, id in ipairs(list) do
				if not Assets.IsValid(id) then
					issue(label .. ": unknown asset " .. tostring(id))
				end
			end
		end
		if block.Bond then
			for role in pairs(block.Bond) do
				if role ~= "All" and not People.IsRole(role) then
					issue(label .. ": unknown Bond role " .. tostring(role))
				end
			end
		end
		if block.Meet and not ({ BestFriend = true, Friend = true, Sibling = true })[block.Meet] then
			issue(label .. ": Meet must be BestFriend, Friend or Sibling")
		end
		if block.Loan and not ({ Student = true, Mortgage = true })[block.Loan.Kind] then
			issue(label .. ": unknown Loan kind")
		end
		-- Big purchases ($10k+) must be gated by MinMoney so nothing is ever "free".
		-- Smaller costs may floor at $0 (you can always scrape together a wedding).
		if type(block.Money) == "number" and block.Money <= -10000 then
			local min = requires and requires.MinMoney or 0
			if min < -block.Money then
				issue(label .. (": spends %d but Requires.MinMoney is %d"):format(-block.Money, min))
			end
		end
	end
	checkBlock(where, effects)
	local total = 0
	for i, outcome in ipairs(effects.Outcomes or {}) do
		if type(outcome.Chance) ~= "number" or outcome.Chance <= 0 then
			issue(where .. ": outcome " .. i .. " needs a positive Chance")
		else
			total += outcome.Chance
		end
		checkBlock(where .. " outcome " .. i, outcome)
	end
	if total > 1.0001 then
		issue(where .. ": outcome chances add up to more than 1")
	end
end
Scenarios.ValidateEffects = validateEffects

local function validateRequires(where, requires)
	if not requires then
		return
	end
	for _, key in ipairs({ "Careers", "NotCareers" }) do
		for _, id in ipairs(requires[key] or {}) do
			if not Careers.IsValid(id) then
				issue(where .. ": unknown career in Requires." .. key .. ": " .. tostring(id))
			end
		end
	end
	for _, key in ipairs({ "MinEducation", "MaxEducation" }) do
		if requires[key] and not Careers.EducationRank[requires[key]] then
			issue(where .. ": unknown education in Requires." .. key)
		end
	end
	for _, key in ipairs({ "HasRole", "NotRole" }) do
		for _, role in ipairs(requires[key] or {}) do
			if not People.IsRole(role) then
				issue(where .. ": unknown role in Requires." .. key .. ": " .. tostring(role))
			end
		end
	end
	for _, key in ipairs({ "MinBond", "MaxBond" }) do
		for role in pairs(requires[key] or {}) do
			if not People.IsRole(role) then
				issue(where .. ": unknown role in Requires." .. key .. ": " .. tostring(role))
			end
		end
	end
	for _, key in ipairs({ "MinStats", "MaxStats" }) do
		for stat in pairs(requires[key] or {}) do
			if not StatDefinitions.IsValid(stat) then
				issue(where .. ": unknown stat in Requires." .. key .. ": " .. tostring(stat))
			end
		end
	end
end

function Scenarios.Register(list)
	for _, scenario in ipairs(list) do
		local id = scenario.Id
		if type(id) ~= "string" or not id:match("^[%w_]+$") then
			issue("scenario with invalid Id: " .. tostring(id))
			continue
		end
		if Scenarios.ById[id] then
			issue("duplicate scenario Id " .. id)
			continue
		end
		if scenario.Stages then
			for _, stage in ipairs(scenario.Stages) do
				if type(stage) ~= "number" or stage < 1 or stage > 6 then
					issue(id .. ": invalid entry in Stages")
				end
			end
		elseif type(scenario.Stage) ~= "number" or scenario.Stage < 1 or scenario.Stage > 6 then
			issue(id .. ": invalid Stage")
		end
		local choices = scenario.Choices or {}
		if #choices < 3 or #choices > 5 then
			issue(id .. ": should have 3–5 choices (has " .. #choices .. ")")
		end
		validateRequires(id, scenario.Requires)
		local unlocked = 0
		local seen = {}
		scenario.ChoiceById = {}
		for _, choice in ipairs(choices) do
			if type(choice.Id) ~= "string" or not choice.Id:match("^[%w_]+$") then
				issue(id .. ": choice with invalid Id")
			elseif seen[choice.Id] then
				issue(id .. ": duplicate choice " .. choice.Id)
			else
				seen[choice.Id] = true
				scenario.ChoiceById[choice.Id] = choice
			end
			if not choice.Requires then
				unlocked += 1
			end
			validateRequires(id .. "." .. tostring(choice.Id), choice.Requires)
			local scenarioMin = scenario.Requires and scenario.Requires.MinMoney or 0
			local choiceMin = choice.Requires and choice.Requires.MinMoney or 0
			validateEffects(id .. "." .. tostring(choice.Id), choice.Effects, { MinMoney = math.max(scenarioMin, choiceMin) })
		end
		if unlocked < 1 then
			issue(id .. ": needs at least 1 always-available choice")
		end
		Scenarios.ById[id] = scenario
		table.insert(Scenarios.All, scenario)
	end
end

-- Load every stage module in this folder.
local children = script:GetChildren()
table.sort(children, function(a, b)
	return a.Name < b.Name
end)
for _, module in ipairs(children) do
	if module:IsA("ModuleScript") then
		Scenarios.Register(require(module))
	end
end

-- ===== Random events =====
Scenarios.Events = {}
Scenarios.EventById = {}
local RARITIES = { Common = true, Uncommon = true, Rare = true, Legendary = true }
function Scenarios.RegisterEvents(list)
	for _, event in ipairs(list) do
		local id = event.Id
		if type(id) ~= "string" or Scenarios.EventById[id] or Scenarios.ById[id] then
			issue("invalid or duplicate event Id " .. tostring(id))
			continue
		end
		if not RARITIES[event.Rarity] then
			issue(id .. ": unknown rarity " .. tostring(event.Rarity))
		end
		if type(event.Stages) ~= "table" or #event.Stages == 0 then
			issue(id .. ": needs Stages")
		end
		validateRequires(id, event.Requires)
		validateEffects(id, event.Effects, { MinMoney = math.huge }) -- events may cost money
		Scenarios.EventById[id] = event
		table.insert(Scenarios.Events, event)
	end
end
Scenarios.RegisterEvents(require(script.Parent:WaitForChild("Events")))

-- ===== Life Reveal twists =====
local FutureIds = require(Shared.Util.Futures).Info
local TWIST_KINDS = { Setback = true, Rescue = true, Surprise = true }
Scenarios.TwistIds = {}
for _, twist in ipairs(require(script.Parent:WaitForChild("Twists"))) do
	local id = twist.Id
	if type(id) ~= "string" or Scenarios.TwistIds[id] or Scenarios.EventById[id] or Scenarios.ById[id] then
		issue("invalid or duplicate twist Id " .. tostring(id))
		continue
	end
	Scenarios.TwistIds[id] = true
	if not TWIST_KINDS[twist.Kind] then
		issue(id .. ": unknown twist Kind " .. tostring(twist.Kind))
	end
	for _, counter in ipairs(twist.Counters or {}) do
		if not FutureIds[counter] then
			issue(id .. ": unknown future in Counters: " .. tostring(counter))
		end
	end
	validateRequires(id, twist.Requires)
	validateEffects(id, twist.Effects, { MinMoney = math.huge })
end

-- ===== Group scenarios (voted on by a Life Circle) =====
Scenarios.Group = {}
Scenarios.GroupById = {}
for _, scenario in ipairs(require(script.Parent:WaitForChild("GroupScenarios"))) do
	local id = scenario.Id
	if type(id) ~= "string" or Scenarios.GroupById[id] then
		issue("invalid or duplicate group scenario Id " .. tostring(id))
		continue
	end
	local choices = scenario.Choices or {}
	if #choices < 3 or #choices > 5 then
		issue(id .. ": group scenarios need 3–5 choices")
	end
	validateRequires(id, scenario.Requires)
	scenario.ChoiceById = {}
	local open = 0
	for _, choice in ipairs(choices) do
		if scenario.ChoiceById[choice.Id] then
			issue(id .. ": duplicate choice " .. tostring(choice.Id))
		end
		scenario.ChoiceById[choice.Id] = choice
		if not choice.Requires then
			open += 1
		end
		validateRequires(id .. "." .. tostring(choice.Id), choice.Requires)
		local min = math.max(scenario.Requires and scenario.Requires.MinMoney or 0, choice.Requires and choice.Requires.MinMoney or 0)
		validateEffects(id .. "." .. tostring(choice.Id), choice.Effects, { MinMoney = min })
	end
	if open < 1 then
		issue(id .. ": needs at least 1 always-available choice")
	end
	Scenarios.GroupById[id] = scenario
	table.insert(Scenarios.Group, scenario)
end

-- ===== City events (server-wide) =====
Scenarios.City = {}
Scenarios.CityById = {}
for _, event in ipairs(require(script.Parent:WaitForChild("CityEvents"))) do
	local id = event.Id
	if type(id) ~= "string" or Scenarios.CityById[id] then
		issue("invalid or duplicate city event Id " .. tostring(id))
		continue
	end
	if type(event.JoinText) ~= "string" or type(event.SkipText) ~= "string" then
		issue(id .. ": needs JoinText and SkipText")
	end
	validateRequires(id, event.Requires)
	validateEffects(id, event.Effects, { MinMoney = event.Requires and event.Requires.MinMoney or 0 })
	Scenarios.CityById[id] = event
	table.insert(Scenarios.City, event)
end

function Scenarios.CountForStage(stage: number): number
	local n = 0
	for _, scenario in ipairs(Scenarios.All) do
		if scenario.Stage == stage or (scenario.Stages and table.find(scenario.Stages, stage)) then
			n += 1
		end
	end
	return n
end

return Scenarios
]]></string>
          </Properties>
          <Item class="ModuleScript" referent="31">
            <Properties>
              <string name="Name">Adult</string>
              <string name="Source"><![CDATA[--[[
	Adulthood scenarios (Stage 4, ages 26–40)
	Consequences of earlier choices start to show: careers, relationships,
	money and homes. Career-specific scenarios unlock for each profession.
]]

local STAR_CAREERS = { "Singer", "Actor", "Musician", "Influencer", "YouTuber", "Artist", "Athlete", "ProGamer" }

return {
	{
		Id = "A_JobHunt", Stage = 4, Icon = "🔎", Title = "Looking for Work",
		Description = "You need a job. Bills don't pay themselves. What will you go for?",
		Priority = 6, Once = false, Requires = { HasCareer = false, NotFlags = { "Retired" } },
		Choices = {
			{ Id = "Retail", Text = "Take a retail job", Description = "Something steady, fast.",
				Effects = { Career = "ShopAssistant", Stats = { Career = 3 }, Story = "{name} took a retail job to get back on their feet." } },
			{ Id = "Police", Text = "Apply to the police", Requires = { MinStats = { Health = 40 } }, LockHint = "Requires Health 40+", Description = "A career with purpose.",
				Effects = { Career = "PoliceOfficer", Stats = { Reputation = 4, Career = 4 }, Story = "{name} joined the police force." } },
			{ Id = "Chef", Text = "Train as a chef", Description = "Learn in a professional kitchen.",
				Effects = { Career = "Chef", Stats = { Career = 3, Happiness = 2 }, Story = "{name} started training in a restaurant kitchen." } },
			{ Id = "Agent", Text = "Become an estate agent", Requires = { MinStats = { Popularity = 45 } }, LockHint = "Requires Popularity 45+", Description = "Sell homes, earn commission.",
				Effects = { Career = "RealEstate", Stats = { Career = 4 }, Story = "{name} became an estate agent." } },
			{ Id = "Wait", Text = "Hold out for something better", Description = "Don't settle.",
				Effects = { Stats = { Happiness = -4, Career = -2 }, Story = "{name} kept searching for the right job." } },
		},
	},
	{
		Id = "A_Promotion", Stage = 4, Icon = "📈", Title = "Promotion on the Line",
		Description = "A senior role has opened up. Half the office wants it.",
		Once = true, Weight = 1.5, Requires = { HasCareer = true },
		Choices = {
			{ Id = "Overtime", Text = "Work late every night", Description = "Prove your commitment.",
				Effects = { Stats = { Career = 6, Health = -5, Relationships = -3 }, Traits = { Ambitious = 1 }, Story = "{name} worked late every night for months.",
					Outcomes = { { Chance = 0.6, Promote = 1, Story = "It paid off: they got the promotion!" } } } },
			{ Id = "Network", Text = "Build relationships with the bosses", Description = "It's who you know.",
				Effects = { Stats = { Popularity = 4, Career = 3 }, Story = "{name} became the boss's favourite lunch companion.",
					Outcomes = { { Chance = 0.45, Promote = 1, Story = "They got the job." } } } },
			{ Id = "Ask", Text = "Ask for it directly", Description = "Confidence wins.",
				Effects = { Traits = { Brave = 1 }, Story = "{name} marched in and asked for the role.",
					Outcomes = { { Chance = 0.4, Promote = 1, Stats = { Happiness = 5 }, Story = "Their boss said yes on the spot!" }, { Chance = 0.6, Stats = { Happiness = -4 }, Story = "Their boss said 'not yet'." } } } },
			{ Id = "Balance", Text = "Keep a healthy balance", Description = "Work isn't everything.",
				Effects = { Stats = { Happiness = 5, Health = 3, Relationships = 3 }, Story = "{name} let the promotion go and kept their evenings free." } },
			{ Id = "Switch", Text = "Get a better offer elsewhere", Description = "Loyalty doesn't pay.",
				Effects = { Stats = { Career = 2 }, Story = "{name} interviewed with a rival company.",
					Outcomes = { { Chance = 0.55, Promote = 1, Money = 3000, Story = "They were hired a level higher, with a signing bonus." }, { Chance = 0.45, Stats = { Happiness = -3 }, Story = "The offer fell through." } } } },
		},
	},
	{
		Id = "A_Proposal", Stage = 4, Icon = "💍", Title = "The Big Question",
		Description = "You've been together for years. Is it time to get married?",
		Once = true, Weight = 3, Requires = { Partner = true, Married = false },
		Choices = {
			{ Id = "Propose", Text = "Plan a perfect proposal", Description = "Down on one knee.",
				Effects = { Money = -1500, Story = "{name} planned the perfect proposal.",
					Outcomes = { { Chance = 0.85, Married = true, Money = -8000, Stats = { Happiness = 12, Relationships = 8 }, Story = "They said YES! The wedding was beautiful." }, { Chance = 0.15, Partner = false, Stats = { Happiness = -12, Relationships = -6 }, Story = "They said no, and the relationship ended." } } } },
			{ Id = "Elope", Text = "Elope on a beach", Description = "Just the two of you.",
				Effects = { Married = true, Money = -1000, Bond = { Partner = 8 }, Stats = { Happiness = 10, Relationships = 4 }, Traits = { Adventurous = 1 }, Story = "{name} and their partner eloped on a beach at sunset." } },
			{ Id = "Wait", Text = "Wait a little longer", Description = "No need to rush.",
				Effects = { Stats = { Relationships = -1 }, Bond = { Partner = -4 }, Story = "{name} decided to wait a while longer." } },
			{ Id = "Split", Text = "Admit it's not working", Description = "Better now than later.",
				Effects = { Partner = false, Stats = { Happiness = -6, Relationships = -3 }, Story = "{name} and their partner went their separate ways." } },
		},
	},
	{
		Id = "A_Dating", Stage = 4, Icon = "🌹", Title = "Love in Your Thirties",
		Description = "Lots of your friends are settling down. Are you looking for love?",
		Once = true, Requires = { Partner = false },
		Choices = {
			{ Id = "App", Text = "Try a dating app", Description = "Swipe, chat, meet.",
				Effects = { Story = "{name} signed up to a dating app.",
					Outcomes = { { Chance = 0.5, Partner = true, Stats = { Happiness = 8, Relationships = 6 }, Story = "Their third date became their partner." }, { Chance = 0.5, Stats = { Happiness = -3 }, Story = "Nothing clicked." } } } },
			{ Id = "Friends", Text = "Meet people through friends", Description = "The old-fashioned way.",
				Effects = { Stats = { Relationships = 3 }, Story = "{name} said yes to every invitation.",
					Outcomes = { { Chance = 0.55, Partner = true, Stats = { Happiness = 7 }, Story = "At a friend's birthday, they met someone wonderful." } } } },
			{ Id = "Single", Text = "Embrace the single life", Description = "Happily independent.",
				Effects = { Stats = { Happiness = 5 }, Flags = { "HappilySingle" }, Story = "{name} realised they were genuinely happy on their own." } },
			{ Id = "Career", Text = "Focus on your career", Description = "Love can find you later.",
				Effects = { Stats = { Career = 5, Happiness = -1 }, Story = "{name} threw themselves into work." } },
		},
	},
	{
		Id = "A_Family", Stage = 4, Icon = "👪", Title = "Starting a Family?",
		Description = "You and your partner have been talking about children.",
		Once = true, Weight = 3, Requires = { Partner = true, MaxChildren = 0 },
		Choices = {
			{ Id = "Baby", Text = "Have a baby", Description = "Sleepless nights, endless love.",
				Effects = { Children = 1, Money = -3000, Stats = { Happiness = 10, Health = -3, Relationships = 6 }, Story = "{name} became a parent. Nothing would ever be the same." } },
			{ Id = "Adopt", Text = "Adopt a child", Description = "Give a child a loving home.",
				Effects = { Children = 1, Money = -4000, Stats = { Happiness = 9, Reputation = 5, Relationships = 6 }, Traits = { Kind = 1 }, Story = "{name} adopted a child and gave them a loving home." } },
			{ Id = "Wait", Text = "Wait a few years", Description = "Not quite ready.",
				Effects = { Stats = { Career = 2 }, Story = "{name} decided to wait." } },
			{ Id = "None", Text = "Decide not to have children", Description = "A different kind of life.",
				Effects = { Stats = { Happiness = 3, Career = 3 }, Flags = { "ChildFree" }, Story = "{name} and their partner chose a life without children." } },
		},
	},
	{
		Id = "A_MoreKids", Stage = 4, Icon = "🧸", Title = "A Bigger Family?",
		Description = "Your child keeps asking for a little brother or sister.",
		Once = true, Requires = { Partner = true, MinChildren = 1, MaxChildren = 2 },
		Choices = {
			{ Id = "Another", Text = "Have another child", Description = "The more the merrier.",
				Effects = { Children = 1, Money = -3000, Stats = { Happiness = 7, Health = -3 }, Story = "{name}'s family grew by one." } },
			{ Id = "Pet", Text = "Get a family pet instead", Description = "A compromise with fur.",
				Effects = { Stats = { Happiness = 5 }, Flags = { "FamilyPet" }, Story = "{name} brought home a puppy. The kids screamed with joy." } },
			{ Id = "Enough", Text = "Your family is perfect as it is", Description = "Happy and complete.",
				Effects = { Stats = { Happiness = 3, Relationships = 3 }, Story = "{name} felt their family was complete." } },
		},
	},
	{
		Id = "A_Home", Stage = 4, Icon = "🏡", Title = "A Place to Call Home",
		Description = "Rent keeps going up. Is it time to buy somewhere?",
		Once = true, Weight = 1.5,
		Choices = {
			{ Id = "Rent", Text = "Keep renting", Description = "Flexible and simple.",
				Effects = { Money = 2000, Stats = { Happiness = -1 }, Story = "{name} kept renting and kept their options open." } },
			{ Id = "Apartment", Text = "Buy an apartment with a mortgage", Requires = { MinMoney = 12000, NotAssets = { "Apartment" } }, LockHint = "Requires a $12,000 deposit", Description = "$12,000 down, the rest over 25 years.",
				Effects = { Assets = { "Apartment" }, Money = -12000, Loan = { Kind = "Mortgage", Amount = 48000 }, Stats = { Happiness = 6, Reputation = 2 }, Story = "{name} got a mortgage and bought an apartment." } },
			{ Id = "House", Text = "Buy a family house with a mortgage", Requires = { MinMoney = 52000, NotAssets = { "House" } }, LockHint = "Requires a $52,000 deposit", Description = "$52,000 down, the rest over 25 years.",
				Effects = { Assets = { "House" }, Money = -52000, Loan = { Kind = "Mortgage", Amount = 208000 }, Stats = { Happiness = 9, Reputation = 4 }, Story = "{name} got a mortgage on a beautiful family house." } },
			{ Id = "Mansion", Text = "Buy a mansion", Requires = { MinMoney = 2500000 }, LockHint = "Requires $2,500,000", Description = "Pools. Plural.",
				Effects = { Assets = { "Mansion" }, Money = -2500000, Stats = { Happiness = 10, Popularity = 6 }, Story = "{name} bought a mansion with a view of the whole city." } },
			{ Id = "Cheaper", Text = "Move somewhere cheaper", Description = "Less city, more savings.",
				Effects = { Money = 5000, Stats = { Happiness = -2, Health = 2 }, Story = "{name} moved out of the city to save money." } },
		},
	},
	{
		Id = "A_Invest", Stage = 4, Icon = "💹", Title = "Growing Your Money",
		Description = "You've got some savings. A friend says leaving money in the bank is 'basically losing it'.",
		Once = true, Requires = { MinMoney = 10000 },
		Choices = {
			{ Id = "Index", Text = "Invest in an index fund", Description = "Slow and steady.",
				Effects = { Flags = { "Investor" }, Story = "{name} invested in a broad index fund.",
					Outcomes = { { Chance = 0.8, MoneyPercent = 0.25, Story = "Over the years it grew nicely." }, { Chance = 0.2, MoneyPercent = -0.05, Story = "It dipped a little." } } } },
			{ Id = "Crypto", Text = "Go all-in on crypto", Description = "To the moon?",
				Effects = { Story = "{name} put their savings into crypto.",
					Outcomes = { { Chance = 0.3, MoneyPercent = 1.5, Stats = { Happiness = 8 }, Story = "It went to the moon!" }, { Chance = 0.7, MoneyPercent = -0.6, Stats = { Happiness = -8 }, Flags = { "BurnedInvestor" }, Story = "It crashed. Badly." } } } },
			{ Id = "Startup", Text = "Back a friend's startup", Description = "Believe in your friends.",
				Effects = { Stats = { Relationships = 4 }, Story = "{name} invested in a friend's startup.",
					Outcomes = { { Chance = 0.25, MoneyPercent = 2, Stats = { Happiness = 6 }, Story = "It became a huge success!" }, { Chance = 0.75, MoneyPercent = -0.3, Story = "It folded within two years." } } } },
			{ Id = "Cash", Text = "Keep it safe in the bank", Description = "No risk, no stress.",
				Effects = { Stats = { Happiness = 2 }, Traits = { Thrifty = 1 }, Story = "{name} kept their savings safe in the bank." } },
		},
	},
	{
		Id = "A_Crossroads", Stage = 4, Icon = "🛤️", Title = "Career Crossroads",
		Description = "Monday mornings feel heavier every week. Is this really what you want to do for the rest of your life?",
