					Outcomes = { { Chance = 0.5, Promote = 1, Story = "The client settled honestly, and the firm made {name} a partner for handling it so well." } } } },
			{ Id = "Bury", Text = "Pretend you never saw it", Description = "It's not your job to judge.",
				Effects = { Money = 30000, Stats = { Happiness = -6 }, Story = "{name} won the case, and couldn't sleep for weeks.",
					Outcomes = { { Chance = 0.3, Career = "None", Stats = { Reputation = -15 }, Story = "It came out. {name} was struck off." } } } },
		},
	},

	-- ===================== RELATIONSHIPS =====================
	{
		Id = "L_TrueFriend", Stages = { 2, YOUNG, ADULT }, Icon = "🫶", Title = "A True Friend",
		Description = "One of your friends has been there for you through everything lately.",
		Once = true, Weight = 1.5, Requires = { HasRole = { "Friend" }, NotRole = { "BestFriend" } },
		Choices = {
			{ Id = "Best", Text = "Tell them they're your best friend", Description = "Say it out loud.",
				Effects = { Meet = "BestFriend", Stats = { Happiness = 5, Relationships = 5 }, Story = "{name} told their friend what they meant to them. It was the start of a lifelong friendship." } },
			{ Id = "Trip", Text = "Plan a trip together", Description = "Make memories.",
				Effects = { Money = -400, Meet = "BestFriend", Stats = { Happiness = 7 }, Story = "{name} and their friend went on an unforgettable road trip." } },
			{ Id = "Busy", Text = "You're too busy right now", Description = "Maybe later.",
				Effects = { Bond = { Friend = -8 }, Stats = { Career = 2 }, Story = "{name} kept cancelling plans." } },
		},
	},
	{
		Id = "L_GrowingApart", Stages = { YOUNG, ADULT, MID, OLD }, Icon = "🥀", Title = "Growing Apart",
		Description = "You and your partner barely talk any more. Evenings are spent on separate screens.",
		Once = false, Weight = 3, Requires = { Partner = true, MaxBond = { Partner = 40 } },
		Choices = {
			{ Id = "Date", Text = "Plan a proper date night", Description = "Remember why you fell in love.",
				Effects = { Money = -150, Bond = { Partner = 15 }, Stats = { Happiness = 5 }, Story = "{name} planned a surprise date night. They laughed like old times." } },
			{ Id = "Talk", Text = "Have an honest conversation", Description = "It might be hard.",
				Effects = { Bond = { Partner = 8 }, Story = "{name} sat their partner down for an honest talk.",
					Outcomes = { { Chance = 0.6, Bond = { Partner = 12 }, Stats = { Happiness = 4 }, Story = "It was exactly what they needed." }, { Chance = 0.4, Partner = false, Stats = { Happiness = -6 }, Story = "They agreed it was time to part." } } } },
			{ Id = "Ignore", Text = "Carry on as normal", Description = "It's just a phase.",
				Effects = { Bond = { Partner = -6 }, Stats = { Happiness = -3 }, Story = "{name} hoped things would sort themselves out." } },
			{ Id = "End", Text = "End the relationship", Description = "It's over.",
				Effects = { Partner = false, Stats = { Happiness = -4 }, Story = "{name} ended the relationship." } },
		},
	},
	{
		Id = "L_BestFriendWedding", Stages = { YOUNG, ADULT }, Icon = "💐", Title = "Best Friend's Wedding",
		Description = "Your best friend is getting married, and wants you to give a speech!",
		Once = true, Requires = { HasRole = { "BestFriend" } },
		Choices = {
			{ Id = "Speech", Text = "Give a heartfelt speech", Description = "Tears guaranteed.",
				Effects = { Bond = { BestFriend = 12 }, Stats = { Popularity = 5, Happiness = 5 }, Story = "{name}'s speech had the whole room in tears." } },
			{ Id = "Funny", Text = "Give a hilarious speech", Description = "Embarrassing stories ready.",
				Effects = { Bond = { BestFriend = 8 }, Stats = { Popularity = 7 }, Story = "{name}'s speech had everyone crying with laughter." } },
			{ Id = "Skip", Text = "Make an excuse and skip it", Description = "Weddings aren't your thing.",
				Effects = { Bond = { BestFriend = -20 }, Stats = { Relationships = -5 }, Story = "{name} skipped the wedding. Their friend was deeply hurt." } },
		},
	},
	{
		Id = "L_ChildDream", Stages = { MID, OLD }, Icon = "🌟", Title = "Your Child's Big Dream",
		Description = "Your grown-up child wants to quit a safe job to chase a risky dream. They ask what you think.",
		Once = true, Requires = { MinChildren = 1 },
		Choices = {
			{ Id = "Support", Text = "Back them all the way", Description = "Believe in them.",
				Effects = { Bond = { Child = 12 }, Stats = { Happiness = 4 }, Story = "{name} told their child to go for it.",
					Outcomes = { { Chance = 0.5, Stats = { Happiness = 6 }, Story = "And they succeeded. {name} had never been prouder." } } } },
			{ Id = "Fund", Text = "Help fund the dream", Requires = { MinMoney = 20000 }, LockHint = "Requires $20,000", Description = "Put your money where your heart is.",
				Effects = { Money = -20000, Bond = { Child = 15 }, Stats = { Happiness = 5 }, Story = "{name} gave their child the money to get started." } },
			{ Id = "Caution", Text = "Urge them to be careful", Description = "Safety first.",
				Effects = { Bond = { Child = -5 }, Stats = { Reputation = 2 }, Story = "{name} advised caution. Their child was a little disappointed." } },
		},
	},
	{
		Id = "L_Lonely", Stages = { YOUNG, ADULT, MID, OLD }, Icon = "🌧️", Title = "Quiet Evenings",
		Description = "Your evenings have become very quiet. You realise you haven't seen anyone in weeks.",
		Once = true, Weight = 2.5, Requires = { MaxFriends = 1, Partner = false },
		Choices = {
			{ Id = "Club", Text = "Join a club or class", Description = "Meet people who like what you like.",
				Effects = { Friends = 2, Stats = { Happiness = 5, Relationships = 4 }, Story = "{name} joined a local club and made two new friends." } },
			{ Id = "Volunteer", Text = "Volunteer locally", Description = "Help others, meet others.",
				Effects = { Friends = 1, Stats = { Reputation = 4, Happiness = 4 }, Story = "{name} started volunteering and found a new community." } },
			{ Id = "Pet", Text = "Adopt a pet", Description = "Unconditional love.",
				Effects = { Money = -300, Stats = { Happiness = 6, Health = 2 }, Flags = { "DogOwner" }, Story = "{name} adopted a scruffy rescue dog who changed everything." } },
			{ Id = "Alone", Text = "You like your own company", Description = "Solitude suits you.",
				Effects = { Stats = { Happiness = 1, Relationships = -3 }, Story = "{name} enjoyed the quiet." } },
		},
	},
	{
		Id = "L_ParentAdvice", Stages = { 1, 2 }, Icon = "🍪", Title = "Family Day Out",
		Description = "Your parents want a family day out this weekend. Your friends have other plans for you.",
		Once = true,
		Choices = {
			{ Id = "Family", Text = "Go with your family", Description = "Picnic, park, ice cream.",
				Effects = { Bond = { Parent = 10, Sibling = 6 }, Stats = { Happiness = 4, Relationships = 4 }, Story = "{name} spent a perfect day out with their family." } },
			{ Id = "Friends", Text = "Hang out with your friends", Description = "They're expecting you.",
				Effects = { Bond = { Friend = 6, BestFriend = 6, Parent = -4 }, Stats = { Popularity = 4 }, Story = "{name} spent the day with friends instead." } },
			{ Id = "Both", Text = "Invite your best friend along", Description = "Why not both?",
				Effects = { Bond = { Parent = 6, Friend = 5, BestFriend = 5 }, Stats = { Happiness = 5 }, Story = "{name} brought a friend on the family day out. Everyone had a great time." } },
		},
	},
	{
		Id = "L_ParentFarewell", Stages = { MID, OLD }, Icon = "🕊️", Title = "Saying Goodbye",
		Description = "Your parent is very old and very frail now. The doctors say there isn't much time left.",
		Once = true, Weight = 1.2, Requires = { HasRole = { "Parent" }, MinAge = 50 },
		Choices = {
			{ Id = "Stay", Text = "Stay by their side", Description = "Every moment counts.",
				Effects = { Farewell = "Parent", Stats = { Happiness = -6, Relationships = 4 }, Bond = { Sibling = 8, Partner = 4 }, Story = "{name} held their parent's hand in their final days. They passed peacefully, surrounded by love." } },
			{ Id = "Letters", Text = "Write down everything you want to say", Description = "Say it all.",
				Effects = { Farewell = "Parent", Stats = { Happiness = -4 }, Story = "{name} read their parent a letter full of thank-yous. They passed peacefully a week later." } },
			{ Id = "Busy", Text = "Visit when you can", Description = "Life is busy.",
				Effects = { Farewell = "Parent", Stats = { Happiness = -9 }, Flags = { "Regret" }, Story = "{name}'s parent passed away while they were at work. They wished they'd visited more." } },
		},
	},
	{
		Id = "M_Money_Debt", Stages = { YOUNG, ADULT, MID }, Icon = "🏦", Title = "Debt on Your Mind",
		Description = "Your loan repayments are eating into everything. The bank has a few suggestions.",
		Once = true, Weight = 1.5, Requires = { HasLoan = "Mortgage" },
		Choices = {
			{ Id = "Overpay", Text = "Overpay to clear it faster", Requires = { MinMoney = 10000 }, LockHint = "Requires $10,000", Description = "Less interest overall.",
				Effects = { RepayLoan = { Kind = "Mortgage", Amount = 10000 }, Stats = { Happiness = 3 }, Traits = { Thrifty = 1 }, Story = "{name} made a big overpayment on the mortgage." } },
			{ Id = "Sideline", Text = "Start a side job", Description = "Extra income, less free time.",
				Effects = { Money = 6000, Stats = { Health = -3, Happiness = -2 }, Bond = { All = -2 }, Story = "{name} took on weekend work to keep up." } },
			{ Id = "Relax", Text = "Stick to the plan", Description = "It'll be paid off eventually.",
				Effects = { Stats = { Happiness = 1 }, Story = "{name} kept calm and paid it off month by month." } },
		},
	},
}
]]></string>
