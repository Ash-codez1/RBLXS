			{ Id = "Collab", Text = "Pitch a duet with a superstar", Description = "Shoot for the moon.",
				Effects = { Story = "{name} pitched a duet to a global superstar.",
					Outcomes = { { Chance = 0.3, Promote = 2, Money = 150000, Stats = { Popularity = 14 }, Flags = { "Celebrity" }, Story = "The superstar said yes. The song went number one worldwide." }, { Chance = 0.7, Stats = { Happiness = -3 }, Story = "They never heard back." } } } },
		},
	},
	{
		Id = "W_Actor", Stages = { YOUNG, ADULT, MID }, Icon = "🎞️", Title = "The Role of a Lifetime",
		Description = "Two scripts: a huge superhero franchise, or a small, brilliant drama.",
		Once = true, Weight = 2.5, Requires = { Careers = { "Actor" } },
		Choices = {
			{ Id = "Franchise", Text = "Join the franchise", Description = "Merch, premieres, sequels.",
