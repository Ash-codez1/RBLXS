	{
		Id = "C_Playground",
		Stage = 1,
		Icon = "🛝",
		Title = "Trouble in the Playground",
		Description = "An older kid is picking on someone from your class. They look close to tears.",
		Once = true,
		Choices = {
			{
				Id = "StandUp",
