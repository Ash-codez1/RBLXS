          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">YoungAdult</string>
              <string name="Source"><![CDATA[--[[
	Young Adulthood scenarios (Stage 3, ages 19–25)
	Turns teenage plans into a path (university, apprenticeship, work, travel)
	and offers the big career choices. Career scenarios are tried in priority
	order (professional → creative → business → service); "keep exploring"
	moves on to the next one. Choosing a career sets CareerChosen.
]]

return {
	{
		Id = "Y_FirstStep", Stage = 3, Icon = "🚪", Title = "Your First Big Step",
		Description = "School is behind you. Today your adult life actually begins.",
		Priority = 10, Once = true,
		Choices = {
			{ Id = "Uni", Text = "Start university", Description = "Lectures, halls, freedom.", Requires = { Flags = { "PlanUni" } }, LockHint = "Requires a university place",
				Effects = { Stats = { Intelligence = 5, Happiness = 4, Relationships = 3 }, Flags = { "AtUni", "StudentLoan" }, Loan = { Kind = "Student", Amount = 27000 }, Friends = 1, Story = "{name} moved into student halls and started university." } },
			{ Id = "Apprentice", Text = "Begin your apprenticeship", Description = "Learn a trade from the pros.", Requires = { Flags = { "PlanApprentice" } }, LockHint = "Requires an apprenticeship place",
				Effects = { Career = "Tradesperson", Stats = { Career = 5, Health = 2 }, Story = "{name} started an electrical apprenticeship and loved working with their hands." } },
			{ Id = "Job", Text = "Start your first full-time job", Description = "A steady wage at last.", Requires = { Flags = { "PlanWork" } }, LockHint = "Requires a plan to start working",
				Effects = { Career = "ShopAssistant", Money = 800, Stats = { Career = 4 }, Story = "{name} started full-time at a busy department store." } },
			{ Id = "Travel", Text = "Set off travelling", Description = "Backpack, passport, no plan.", Requires = { Flags = { "PlanGap" } }, LockHint = "Requires a gap-year plan",
				Effects = { Money = -1500, Stats = { Happiness = 8, Intelligence = 2, Relationships = 2 }, Traits = { Adventurous = 1 }, Flags = { "Traveller" }, Story = "{name} flew off with a backpack and a one-way ticket." } },
			{ Id = "Change", Text = "Change of plan: just get a job", Description = "Plans change.",
				Effects = { Career = "ShopAssistant", Stats = { Career = 2, Happiness = -1 }, Story = "{name} changed their mind and took the first job they were offered." } },
		},
	},
	{
		Id = "Y_BackHome", Stage = 3, Icon = "🧳", Title = "Back From Your Travels",
		Description = "A year of adventures later, you're back home with a tan and a hundred stories. Now what?",
		Priority = 8, Once = true, Requires = { Flags = { "Traveller" }, NotFlags = { "AtUni" }, HasCareer = false },
		Choices = {
			{ Id = "Uni", Text = "Go to university after all", Requires = { MinStats = { Intelligence = 42 } }, LockHint = "Requires Intelligence 42+", Description = "Ready to study now.",
				Effects = { Stats = { Intelligence = 4 }, Flags = { "AtUni", "StudentLoan" }, Loan = { Kind = "Student", Amount = 27000 }, Story = "{name} came home and enrolled at university." } },
			{ Id = "Work", Text = "Get a job", Description = "Time to earn.",
				Effects = { Career = "ShopAssistant", Stats = { Career = 3 }, Story = "{name} got a job and started saving." } },
			{ Id = "Trade", Text = "Learn a trade", Description = "Practical skills, good pay.",
				Effects = { Career = "Tradesperson", Stats = { Career = 4 }, Story = "{name} started an apprenticeship." } },
			{ Id = "More", Text = "Keep travelling", Description = "The world is big.",
				Effects = { Money = -1000, Stats = { Happiness = 6, Career = -4 }, Flags = { "Nomad" }, Story = "{name} bought another ticket and kept going." } },
		},
	},
	{
		Id = "Y_UniLife", Stage = 3, Icon = "🎒", Title = "University Life",
		Description = "Lectures, societies, parties, deadlines. There's never enough time for everything.",
		Once = true, Weight = 3, Requires = { Flags = { "AtUni" } },
		Choices = {
			{ Id = "Study", Text = "Aim for top marks", Description = "Library till closing.",
				Effects = { Stats = { Intelligence = 8, Happiness = -2 }, Traits = { Studious = 1 }, Flags = { "FirstClass" }, Story = "{name} practically lived in the library." } },
			{ Id = "Societies", Text = "Join every society", Description = "Debate, drama, climbing…",
				Effects = { Stats = { Popularity = 6, Relationships = 6, Intelligence = 2 }, Traits = { Social = 1 }, Flags = { "Leader" }, Story = "{name} joined six societies and ended up running two." } },
			{ Id = "Party", Text = "Live the student party life", Description = "Sleep is for graduates.",
				Effects = { Stats = { Happiness = 6, Popularity = 5, Intelligence = -4, Health = -3 }, Story = "{name} became famous for their parties." } },
			{ Id = "Work", Text = "Work part-time to avoid debt", Description = "Tired, but debt-free.",
				Effects = { Money = 3000, Stats = { Happiness = -2, Career = 3 }, Traits = { Thrifty = 1 }, Story = "{name} worked nights to pay their way through university." } },
			{ Id = "Drop", Text = "Drop out", Description = "University isn't for you.",
				Effects = { Stats = { Happiness = 2, Reputation = -3 }, ClearFlags = { "AtUni" }, Flags = { "DropOut" }, Story = "{name} dropped out of university." } },
		},
	},
	{
		Id = "Y_Graduation", Stage = 3, Icon = "🎓", Title = "Graduation Day",
